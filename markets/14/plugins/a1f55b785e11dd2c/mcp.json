{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "luftsocial": {
      "type": "streamable-http",
      "url": "https://mcp.luftsocial.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "authorizationServerBase": "https://api.luftsocial.com",
            "resource": "https://mcp.luftsocial.com/mcp",
            "baseScopes": [
              "accounts:read",
              "rules:read",
              "media:read",
              "posts:read"
            ]
          }
        }
      }
    }
  }
}
