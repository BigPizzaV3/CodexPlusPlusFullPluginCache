{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "layerpx": {
      "type": "streamable-http",
      "url": "https://mcp.layerpx.com/connect-ai/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "defaultScopes": [
              "board:read",
              "board:write"
            ]
          }
        }
      }
    }
  }
}
