{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "marvis": {
      "type": "streamable-http",
      "url": "https://mcp.mymarvis.co.uk/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "cimd"
            },
            "resource": "https://mcp.mymarvis.co.uk/mcp",
            "baseScopes": [
              "marvis:read",
              "marvis:write",
              "offline_access"
            ],
            "oidcEnabled": false,
            "defaultScopes": [
              "marvis:read",
              "marvis:write",
              "offline_access"
            ]
          }
        }
      }
    }
  }
}
