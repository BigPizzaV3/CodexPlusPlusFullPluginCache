{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "mason": {
      "type": "streamable-http",
      "url": "https://mason.enduring-labs.com/api/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "cimd"
            },
            "baseScopes": ["mason.read"],
            "defaultScopes": ["mason.write"]
          }
        }
      }
    }
  }
}
