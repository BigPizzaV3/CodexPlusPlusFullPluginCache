{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "curvemora": {
      "type": "streamable-http",
      "url": "https://mcp.curvemora.com/",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "authorizationServerBase": "https://curvemora.com",
            "authorizationUrl": "https://curvemora.com/oauth/authorize",
            "tokenUrl": "https://curvemora.com/oauth/token",
            "registrationUrl": "https://curvemora.com/oauth/register",
            "resource": "https://mcp.curvemora.com/",
            "baseScopes": [
              "agenda.read",
              "items.read",
              "calendar.read",
              "metrics.read",
              "planning.read"
            ]
          }
        }
      }
    }
  }
}
