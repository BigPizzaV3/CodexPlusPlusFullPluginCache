{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "vocabulum": {
      "type": "streamable-http",
      "url": "https://www.vocabulum.app/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": { "mode": "cimd" },
            "baseScopes": ["words:read", "words:write"]
          }
        }
      }
    }
  }
}
