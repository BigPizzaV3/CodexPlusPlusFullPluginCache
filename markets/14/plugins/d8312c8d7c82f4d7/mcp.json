{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "rendley": {
      "type": "streamable-http",
      "url": "https://mcp.rendley.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {"mode": "dcr"},
            "resource": "https://mcp.rendley.com/mcp",
            "defaultScopes": ["offline_access"],
            "oidcEnabled": false
          }
        }
      }
    }
  }
}
