{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "astromaster": {
      "type": "streamable-http",
      "url": "https://api.xingpantong.com/mcp/astromaster",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": [
              "astromaster:natal",
              "astromaster:transits",
              "astromaster:charts"
            ]
          }
        }
      }
    }
  }
}
