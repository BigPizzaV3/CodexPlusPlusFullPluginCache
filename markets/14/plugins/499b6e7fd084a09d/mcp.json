{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "ah-recipes": {
      "type": "streamable-http",
      "url": "https://api.ah.nl/ah-in-chat-gpt/v1/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "chatgpt",
              "tokenEndpointAuthMethod": "client_secret_post"
            },
            "oidcEnabled": true
          }
        }
      }
    }
  }
}
