{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "alta": {
      "type": "streamable-http",
      "url": "https://api.altahq.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "oidcEnabled": true,
            "oidcUserinfoEndpoint": "https://api.altahq.com/userinfo"
          }
        }
      }
    }
  }
}
