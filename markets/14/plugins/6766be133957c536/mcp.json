{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "workshop-eu": {
      "type": "streamable-http",
      "url": "https://mcp-eu.useworkshop.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "cimd"
            },
            "baseScopes": [
              "workshop.read",
              "workshop.write"
            ],
            "defaultScopes": [
              "workshop.read",
              "workshop.write"
            ],
            "oidcEnabled": false
          }
        }
      }
    }
  }
}
