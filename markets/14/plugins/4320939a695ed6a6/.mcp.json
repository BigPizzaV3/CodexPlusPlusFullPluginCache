{
  "mcpServers": {
    "wile": {
      "type": "http",
      "url": "https://api.wile.ai/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": [
              "context:write",
              "feedback:read"
            ]
          }
        }
      }
    }
  }
}
