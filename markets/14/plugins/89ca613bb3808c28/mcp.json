{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "tictoon": {
      "type": "streamable-http",
      "url": "https://tictoon.app/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "tictoon-chatgpt-app",
              "tokenEndpointAuthMethod": "none"
            },
            "authorizationUrl": "https://tictoon.app/ko/connect/mcp/",
            "tokenUrl": "https://tictoon.app/api/oauth/token",
            "resource": "https://tictoon.app/mcp",
            "baseScopes": ["channels:read", "threads:read", "threads:write", "media:write"]
          }
        }
      }
    }
  }
}
