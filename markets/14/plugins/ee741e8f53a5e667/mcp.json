{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "wishlistme": {
      "type": "streamable-http",
      "url": "https://wishlistme.app/api/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": { "mode": "dcr" },
            "baseScopes": ["wishlists:read"],
            "defaultScopes": ["wishlists:read", "wishlists:write", "gifts:reserve", "santa"]
          }
        }
      }
    }
  }
}
