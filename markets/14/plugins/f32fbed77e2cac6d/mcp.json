{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "olatti": {
      "type": "streamable-http",
      "url": "https://mcp.olatti.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "chatgpt",
              "tokenEndpointAuthMethod": "none"
            },
            "defaultScopes": [
              "devices:read",
              "calls:read",
              "calls:write",
              "transcripts:read",
              "contacts:read",
              "messages:read",
              "messages:write"
            ]
          }
        }
      }
    }
  }
}
