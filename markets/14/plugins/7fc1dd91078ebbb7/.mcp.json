{
  "mcpServers": {
    "Sonar Connections": {
      "url": "https://mcp.sonarconnections.com/public/openai",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "mixed",
            "client": {
              "mode": "cimd"
            },
            "authorizationServerBase": "https://sonarconnections.com",
            "authorizationUrl": "https://sonarconnections.com/oauth/authorize",
            "tokenUrl": "https://sonarconnections.com/oauth/token",
            "registrationUrl": "https://sonarconnections.com/oauth/register",
            "resource": "https://mcp.sonarconnections.com",
            "baseScopes": [
              "sonar:connector"
            ]
          }
        }
      }
    }
  }
}
