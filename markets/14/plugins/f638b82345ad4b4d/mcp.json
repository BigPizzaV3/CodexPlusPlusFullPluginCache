{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "topicflow": {
      "extensions": {
        "com.openai": {
          "auth": {
            "baseScopes": [
              "mcp",
              "offline_access",
              "profile:read",
              "external-events:read",
              "feedback:read",
              "feedback:write",
              "goals:read:self",
              "goals:write:self",
              "meetings:read:self",
              "meetings:write:self",
              "private-notes:read",
              "private-notes:write",
              "recognitions:read",
              "recognitions:write",
              "reviews:read",
              "reviews:write",
              "career:read",
              "career:write"
            ],
            "client": {
              "mode": "dcr"
            },
            "type": "oauth"
          }
        }
      },
      "type": "streamable-http",
      "url": "https://app.topicflow.com/mcp"
    }
  }
}
