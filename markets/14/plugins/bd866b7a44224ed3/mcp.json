{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "kairobot": {
      "type": "streamable-http",
      "url": "https://kairobot.io/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": { "mode": "cimd" },
            "baseScopes": ["kairobot.read", "kairobot.write", "kairobot.send"]
          }
        }
      }
    }
  }
}
