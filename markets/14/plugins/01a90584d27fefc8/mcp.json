{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "torly": {
      "type": "streamable-http",
      "url": "https://mcp.torly.cc/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "cimd"
            },
            "defaultScopes": [
              "booking:read",
              "booking:write"
            ]
          }
        }
      }
    }
  }
}
