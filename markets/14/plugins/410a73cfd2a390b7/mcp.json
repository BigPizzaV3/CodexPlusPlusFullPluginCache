{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "fantasypros": {
      "type": "streamable-http",
      "url": "https://api.fantasypros.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": { "mode": "cimd" },
            "baseScopes": ["user:read"],
            "defaultScopes": ["user:read"]
          }
        }
      }
    }
  }
}