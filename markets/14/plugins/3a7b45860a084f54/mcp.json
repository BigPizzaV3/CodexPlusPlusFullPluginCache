{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "smarty-pance": {
      "type": "streamable-http",
      "url": "https://smartypance.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "authorizationUrl": "https://smartypance.com/ai-oauth/authorize",
            "tokenUrl": "https://smartypance.com/ai-oauth/token",
            "registrationUrl": "https://smartypance.com/ai-oauth/register",
            "baseScopes": [
              "smarty:study"
            ]
          }
        }
      }
    }
  }
}
