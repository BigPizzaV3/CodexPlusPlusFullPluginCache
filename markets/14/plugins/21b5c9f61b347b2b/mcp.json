{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "talktool": {
      "type": "streamable-http",
      "url": "https://www.usetalktool.com/api/chatgpt/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "authorizationServerBase": "https://clerk.usetalktool.com",
            "resource": "https://www.usetalktool.com/api/chatgpt/mcp",
            "baseScopes": [
              "user:org:read",
              "talktool:calls:read",
              "talktool:calls:prepare",
              "offline_access"
            ],
            "oidcEnabled": false,
            "client": {
              "mode": "provided",
              "clientId": "yUCw3S5ZIDDrAxqQ",
              "tokenEndpointAuthMethod": "none"
            },
            "defaultScopes": []
          }
        }
      }
    }
  }
}
