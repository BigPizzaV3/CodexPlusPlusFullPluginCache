{
  "mcpServers": {
    "dial": {
      "url": "https://dial.macromatic.space/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "dial-chatgpt-public",
              "tokenEndpointAuthMethod": "none"
            },
            "authorizationUrl": "https://dial.macromatic.space/oauth/authorize",
            "tokenUrl": "https://dial.macromatic.space/oauth/token",
            "resource": "https://dial.macromatic.space/mcp",
            "baseScopes": [
              "dial:read",
              "dial:write"
            ],
            "defaultScopes": [
              "dial:read",
              "dial:write"
            ]
          }
        }
      }
    }
  }
}
