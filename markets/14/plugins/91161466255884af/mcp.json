{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "marketcheck": {
      "type": "streamable-http",
      "url": "https://developers.marketcheck.com/api/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "cimd"
            },
            "authorizationUrl": "https://developers.marketcheck.com/oauth/authorize",
            "tokenUrl": "https://developers.marketcheck.com/oauth/token",
            "baseScopes": [
              "mcp:access"
            ]
          }
        }
      }
    }
  }
}