{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "wildcards": {
      "type": "streamable-http",
      "url": "https://wildcards.arkheos.ai/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "zZ0ERJMWMDTTGF4WT4dJFNdVgY6V2let",
              "tokenEndpointAuthMethod": "none"
            },
            "defaultScopes": [
              "wildcards:use"
            ],
            "baseScopes": [
              "openid"
            ],
            "resource": "https://wildcards.arkheos.ai",
            "oidcEnabled": true
          }
        }
      }
    }
  }
}
