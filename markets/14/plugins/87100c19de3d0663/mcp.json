{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "alimki": {
      "type": "streamable-http",
      "url": "https://alimki.ru/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "alimki-chatgpt",
              "tokenEndpointAuthMethod": "none"
            },
            "resource": "https://alimki.ru/mcp",
            "baseScopes": ["decks:read", "note-types:read", "notes:read", "notes:write"]
          }
        }
      }
    }
  }
}
