{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "insmart": {
      "type": "streamable-http",
      "url": "https://mcp.insmart.ro/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": { "mode": "dcr" },
            "registrationUrl": "https://mcp.insmart.ro/oauth/register",
            "baseScopes": ["insmart", "offline_access"]
          }
        }
      }
    }
  }
}
