{
  "mcpServers": {
    "portfelio": {
      "type": "streamable-http",
      "url": "https://mcp.portfelio.me/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "authorizationUrl": "https://portfelio.me/wp-json/portfelio/v1/oauth/authorize",
            "tokenUrl": "https://portfelio.me/wp-json/portfelio/v1/oauth/token",
            "registrationUrl": "https://portfelio.me/wp-json/portfelio/v1/oauth/register",
            "resource": "https://mcp.portfelio.me/mcp",
            "defaultScopes": [
              "read:projects",
              "read:financial",
              "write:projects",
              "write:emails",
              "offline_access"
            ]
          }
        }
      }
    }
  }
}
