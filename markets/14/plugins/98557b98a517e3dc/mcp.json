{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "futapp": {
      "type": "streamable-http",
      "url": "https://mcp.ligasfutapp.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "futapp-chatgpt-admin",
              "tokenEndpointAuthMethod": "none"
            },
            "baseScopes": [
              "ligas:read"
            ],
            "defaultScopes": [
              "ligas:read"
            ]
          }
        }
      }
    }
  }
}
