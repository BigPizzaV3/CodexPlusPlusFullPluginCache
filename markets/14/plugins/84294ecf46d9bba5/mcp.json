{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "vibe-coding-plan": {
      "type": "streamable-http",
      "url": "https://vibecoderplanner.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "01a17cc8-a337-7364-8bfc-1edca6eabbf7",
              "tokenEndpointAuthMethod": "none"
            },
            "authorizationUrl": "https://vibecoderplanner.com/oauth/authorize",
            "tokenUrl": "https://vibecoderplanner.com/oauth/token",
            "baseScopes": [
              "projects:read",
              "projects:write",
              "tasks:read",
              "tasks:write",
              "plan:generate"
            ]
          }
        }
      }
    }
  }
}
