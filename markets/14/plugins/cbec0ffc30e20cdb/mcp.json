{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "averygpt": {
      "type": "streamable-http",
      "url": "https://mcp.averygpt.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "fNqQPRWgvOqH1i23FReYn1tlrk6hFUJh",
              "tokenEndpointAuthMethod": "client_secret_post"
            },
            "authorizationServerBase": "https://sso.averygpt.com/",
            "authorizationUrl": "https://mcp.averygpt.com/authorize",
            "tokenUrl": "https://mcp.averygpt.com/oauth/token",
            "oidcEnabled": true,
            "oidcConfigurationUrl": "https://sso.averygpt.com/.well-known/openid-configuration",
            "oidcUserinfoEndpoint": "https://sso.averygpt.com/userinfo",
            "baseScopes": ["openid", "profile", "email"],
            "defaultScopes": ["openid", "profile", "email"]
          }
        }
      }
    }
  }
}
