{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "impactlake": {
      "type": "streamable-http",
      "url": "https://entry.mcp.app.impactlake.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "mixed",
            "client": {
              "mode": "provided",
              "clientId": "impactlake-admin-chatgpt-4a210ea3e45c",
              "tokenEndpointAuthMethod": "none"
            },
            "authorizationUrl": "https://entry.app.impactlake.com/oidc/auth",
            "tokenUrl": "https://entry.app.impactlake.com/oidc/token",
            "authorizationServerBase": "https://entry.app.impactlake.com",
            "resource": "https://entry.mcp.app.impactlake.com/mcp",
            "defaultScopes": [
              "openid",
              "profile",
              "email",
              "offline_access",
              "workflow:read",
              "workflow:draft_write",
              "workflow:content_write",
              "workflow:write",
              "workflow:approve",
              "workflow:admin_write",
              "portfolio:read",
              "portfolio:write",
              "impact_model:read",
              "impact_model:write",
              "kpi:read",
              "kpi:write",
              "evidence:read",
              "evidence:write",
              "impact_data:read",
              "meeting_minutes:read",
              "meeting_minutes:write",
              "open_data:read",
              "open_data:import",
              "external_url:fetch",
              "integration:read",
              "integration:sync",
              "integration:write"
            ],
            "oidcEnabled": true,
            "oidcConfigurationUrl": "https://entry.app.impactlake.com/.well-known/openid-configuration",
            "oidcUserinfoEndpoint": "https://entry.app.impactlake.com/oidc/userinfo"
          }
        }
      }
    }
  }
}
