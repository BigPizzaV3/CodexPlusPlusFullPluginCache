{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "fatmasuha-beauty": {
      "type": "streamable-http",
      "url": "https://app.fatmasuha.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "mixed",
            "client": {
              "mode": "provided",
              "clientId": "fatmasuha-chatgpt-private-v1",
              "tokenEndpointAuthMethod": "none"
            },
            "defaultScopes": [
              "appointments:read",
              "appointments:write",
              "user-profile:read"
            ]
          }
        }
      }
    }
  }
}
