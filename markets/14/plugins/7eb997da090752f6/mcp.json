{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "justicelibre-test": {
      "type": "streamable-http",
      "url": "https://justicelibre.org/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "mixed",
            "client": {
              "mode": "dcr"
            },
            "authorizationUrl": "https://justicelibre.org/oauth/authorize",
            "tokenUrl": "https://justicelibre.org/oauth/token",
            "registrationUrl": "https://justicelibre.org/oauth/register"
          }
        }
      }
    }
  }
}
