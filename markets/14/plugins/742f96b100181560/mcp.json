{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "evidoclip": {
      "type": "streamable-http",
      "url": "https://evidoclip.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": { "mode": "dcr" },
            "resource": "https://evidoclip.com/mcp",
            "baseScopes": ["jobs:read", "jobs:write"]
          }
        }
      }
    }
  }
}
