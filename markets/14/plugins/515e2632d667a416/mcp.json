{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "bing-webmaster": {
      "type": "streamable-http",
      "url": "https://talktodata.navines.com/mcp/bing",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": { "mode": "cimd" },
            "baseScopes": ["bing.manage"],
            "defaultScopes": ["bing.manage"],
            "oidcEnabled": false
          }
        }
      }
    }
  }
}
