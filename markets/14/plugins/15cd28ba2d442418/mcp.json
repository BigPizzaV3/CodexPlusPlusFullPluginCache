{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "bazaart-photoshoot": {
      "type": "streamable-http",
      "url": "https://mcp.bazaart.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "bazaart-chatgpt-account-test",
              "tokenEndpointAuthMethod": "none"
            },
            "baseScopes": ["account:read", "images:generate"],
            "defaultScopes": ["account:read", "images:generate"],
            "oidcEnabled": false
          }
        }
      }
    }
  }
}
