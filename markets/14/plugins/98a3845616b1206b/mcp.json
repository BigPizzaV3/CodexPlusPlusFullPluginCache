{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "workhunt": {
      "type": "streamable-http",
      "url": "https://api.workhunt.ai/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": { "mode": "dcr" },
            "authorizationUrl": "https://api.workhunt.ai/oauth/authorize",
            "tokenUrl": "https://api.workhunt.ai/oauth/token",
            "baseScopes": ["workhunt", "offline_access"]
          }
        }
      }
    }
  }
}
