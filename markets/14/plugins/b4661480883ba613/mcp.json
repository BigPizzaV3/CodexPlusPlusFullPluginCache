{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "farms": {
      "type": "streamable-http",
      "url": "https://mcp.farmsapp.co/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "farms-chatgpt",
              "tokenEndpointAuthMethod": "client_secret_post"
            },
            "resource": "https://mcp.farmsapp.co/mcp",
            "baseScopes": [
              "farms:read",
              "openid",
              "offline_access"
            ],
            "oidcEnabled": true
          }
        }
      }
    }
  }
}
