{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "the-swarm": {
      "type": "streamable-http",
      "url": "https://bee.theswarm.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "open-ai-app",
              "tokenEndpointAuthMethod": "none"
            },
            "baseScopes": [
              "openid",
              "offline_access",
              "profile"
            ],
            "defaultScopes": [
              "openid",
              "offline_access",
              "profile"
            ],
            "oidcEnabled": true,
            "oidcScopesSupported": [
              "openid",
              "offline_access",
              "profile"
            ]
          }
        }
      }
    }
  }
}
