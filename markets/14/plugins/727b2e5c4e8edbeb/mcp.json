{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "sams-list": {
      "type": "streamable-http",
      "url": "https://sam-s-list-production.up.railway.app/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "baseScopes": [
              "tasks:read",
              "tasks:write",
              "spending:read",
              "spending:write",
              "offline_access"
            ]
          }
        }
      }
    }
  }
}
