{
  "mcpServers": {
    "tabstickers": {
      "url": "https://tabstickers.com/api/chatgpt/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "tabstickers-chatgpt-owner",
              "tokenEndpointAuthMethod": "none"
            },
            "authorizationUrl": "https://tabstickers.com/api/chatgpt/oauth/authorize",
            "tokenUrl": "https://tabstickers.com/api/chatgpt/oauth/token",
            "baseScopes": [
              "crm:read",
              "crm:write",
              "calendar:read",
              "calendar:write",
              "offline_access"
            ]
          }
        }
      }
    }
  }
}
