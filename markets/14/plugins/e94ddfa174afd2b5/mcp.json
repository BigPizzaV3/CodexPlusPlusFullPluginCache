{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "cockroachdb-cloud": {
      "type": "streamable-http",
      "url": "https://cockroachlabs.cloud/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "oidcEnabled": false,
            "baseScopes": [
              "mcp:read",
              "mcp:write"
            ],
            "defaultScopes": [],
            "oidcScopesSupported": []
          }
        }
      }
    }
  }
}
