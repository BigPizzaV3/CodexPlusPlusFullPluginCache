{
	"$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
	"mcpServers": {
		"proweblook": {
			"type": "streamable-http",
			"url": "https://mcp.proweblook.com/chatgpt/mcp",
			"extensions": {
				"com.openai": {
					"auth": {
						"type": "oauth",
						"client": { "mode": "cimd" },
						"resource": "https://mcp.proweblook.com/chatgpt/mcp",
						"baseScopes": ["proweblook:read", "proweblook:run", "offline_access"]
					}
				}
			}
		}
	}
}
