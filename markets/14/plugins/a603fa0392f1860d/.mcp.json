{
  "mcpServers": {
    "words-into-music": {
      "url": "https://mcp.wordsintomusic.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": [
              "account:read",
              "songs:create",
              "songs:read"
            ]
          }
        }
      }
    }
  }
}
