{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "subtie": {
      "type": "streamable-http",
      "url": "https://www.subtie.com/api/integrations/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "client_065c0f0771fe4a5180fe4aa972d92f54",
              "tokenEndpointAuthMethod": "client_secret_post"
            },
            "authorizationUrl": "https://www.subtie.com/api/oauth/authorize",
            "tokenUrl": "https://www.subtie.com/api/oauth/token",
            "resource": "https://www.subtie.com/api/integrations/mcp",
            "baseScopes": [
              "user:settings:read",
              "user:settings:write",
              "user:cards:read",
              "user:cards:write",
              "user:books:read",
              "user:exercises:read",
              "user:exercises:write"
            ]
          }
        }
      }
    }
  }
}
