{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "metronhr": {
      "type": "streamable-http",
      "url": "https://app.metronhr.de/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "defaultScopes": [
              "employees:read",
              "employees:write",
              "departments:read",
              "departments:write",
              "customers:read",
              "customers:write",
              "services:read",
              "services:write",
              "projects:read",
              "projects:write",
              "time-entries:read",
              "time-entries:write",
              "absences:read",
              "absences:write",
              "absences:manage",
              "shifts:read",
              "shifts:write",
              "work-time-models:read",
              "employee-contracts:read",
              "vacation-balances:read",
              "shift-areas:read",
              "shift-definitions:read",
              "customer-contingents:read",
              "customer-contingents:write",
              "service-proofs:read",
              "support-tickets:read",
              "support-tickets:write",
              "time-entry-change-requests:read",
              "time-entry-change-requests:write",
              "time-accounts:read",
              "absence-closures:read",
              "absence-closures:write",
              "absence-closures:manage",
              "shift-swap-requests:read",
              "shift-swap-requests:write",
              "shift-applications:read",
              "shift-applications:write"
            ]
          }
        }
      }
    }
  }
}
