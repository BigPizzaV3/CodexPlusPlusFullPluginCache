{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "predmar": {
      "type": "streamable-http",
      "url": "https://predmar.mcp.lukka.tech",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "authorizationUrl": "https://auth0.lukka.tech/authorize",
            "tokenUrl": "https://auth0.lukka.tech/oauth/token",
            "registrationUrl": "https://auth0.lukka.tech/oidc/register",
            "authorizationServerBase": "https://auth0.lukka.tech",
            "resource": "https://predmar.mcp.lukka.tech",
            "baseScopes": [
              "openid",
              "email",
              "offline_access"
            ],
            "defaultScopes": [
              "mcp"
            ],
            "oidcEnabled": true,
            "oidcConfigurationUrl": "https://auth0.lukka.tech/.well-known/openid-configuration",
            "oidcUserinfoEndpoint": "https://auth0.lukka.tech/userinfo"
          }
        }
      }
    }
  }
}
