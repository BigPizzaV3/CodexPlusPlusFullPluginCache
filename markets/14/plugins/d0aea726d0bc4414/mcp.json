{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "waypoint-log": {
      "type": "streamable-http",
      "url": "https://mcp.waypointlog.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "defaultScopes": [
              "logbook:read",
              "logbook:write",
              "offline_access"
            ]
          }
        }
      }
    }
  }
}
