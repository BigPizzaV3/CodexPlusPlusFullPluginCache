{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "prosodyai": {
      "type": "streamable-http",
      "url": "https://api.prosodyai.ai/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "registrationUrl": "https://api.prosodyai.ai/oauth/register",
            "baseScopes": ["prosodyai"]
          }
        }
      }
    }
  }
}
