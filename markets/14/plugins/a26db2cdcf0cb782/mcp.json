{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "clientika": {
      "type": "streamable-http",
      "url": "https://mcp.clientika.ru/",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "defaultScopes": [
              "shop:read",
              "shop:write",
              "pages:read",
              "pages:write",
              "products:read",
              "products:write",
              "categories:read",
              "categories:write",
              "services:read",
              "services:write",
              "orders:read",
              "orders:write",
              "bookings:read",
              "bookings:write",
              "media:read",
              "media:write",
              "analytics:read",
              "feature_requests:create",
              "feature_requests:read"
            ]
          }
        }
      }
    }
  }
}
