{
  "mcpServers": {
    "niestawiaj": {
      "url": "https://niestawiaj.pl/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "cimd"
            },
            "authorizationUrl": "https://niestawiaj.pl/oauth/authorize",
            "tokenUrl": "https://niestawiaj.pl/oauth/token",
            "resource": "https://niestawiaj.pl/mcp",
            "baseScopes": [
              "balance:read",
              "matches:read",
              "bets:read"
            ],
            "defaultScopes": [
              "balance:read",
              "matches:read",
              "bets:read",
              "bets:prepare",
              "bets:place"
            ],
            "oidcEnabled": false
          }
        }
      }
    }
  }
}
