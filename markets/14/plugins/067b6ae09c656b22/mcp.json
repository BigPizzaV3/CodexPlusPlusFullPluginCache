{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "cobuild": {
      "type": "streamable-http",
      "url": "https://co.build/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "mixed",
            "client": {
              "mode": "dcr"
            },
            "resource": "https://co.build/mcp",
            "defaultScopes": [
              "reports:read",
              "reports:write",
              "followups:write",
              "offline_access"
            ]
          }
        }
      }
    }
  }
}
