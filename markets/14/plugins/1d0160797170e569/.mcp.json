{
  "mcpServers": {
    "Nazim": {
      "type": "streamable-http",
      "url": "https://app.nazim-app.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": { "mode": "dcr" },
            "registrationUrl": "https://app.nazim-app.com/oauth/register",
            "authorizationUrl": "https://app.nazim-app.com/oauth/authorize",
            "tokenUrl": "https://app.nazim-app.com/oauth/token",
            "baseScopes": ["nazim.read", "nazim.write", "offline_access"]
          }
        }
      }
    }
  }
}
