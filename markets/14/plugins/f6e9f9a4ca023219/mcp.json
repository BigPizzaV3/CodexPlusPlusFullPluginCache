{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "bruce": {
      "type": "streamable-http",
      "url": "https://bruce-mcp.bruce-tools.workers.dev/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": [
              "bruce:use"
            ],
            "defaultScopes": [
              "bruce:use"
            ]
          }
        }
      }
    }
  }
}
