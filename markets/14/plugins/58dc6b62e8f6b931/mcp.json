{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "artifact-site": {
      "type": "streamable-http",
      "url": "https://yours.lexmount.com/artifact-site/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": { "mode": "dcr" },
            "defaultScopes": ["artifacts:read", "artifacts:write", "openid", "email"]
          }
        }
      }
    }
  }
}
