{
  "mcpServers": {
    "goodsend": {
      "url": "https://goodsend.it/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "registrationUrl": "https://goodsend.it/oauth/register",
            "authorizationUrl": "https://goodsend.it/oauth/authorize",
            "tokenUrl": "https://goodsend.it/oauth/token",
            "resource": "https://goodsend.it/mcp",
            "baseScopes": [
              "goodsend.read",
              "goodsend.write"
            ]
          }
        }
      }
    }
  }
}
