{
  "mcpServers": {
    "eva": {
      "url": "https://app.evamedia.fi/api/chatgpt/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "eva-studio-chatgpt-production",
              "tokenEndpointAuthMethod": "client_secret_basic"
            },
            "authorizationUrl": "https://app.evamedia.fi/chatgpt/authorize",
            "tokenUrl": "https://app.evamedia.fi/api/chatgpt/oauth/token",
            "resource": "https://app.evamedia.fi/api/chatgpt/mcp",
            "baseScopes": ["eva:read"],
            "defaultScopes": ["eva:read", "eva:write", "eva:publish"]
          }
        }
      }
    }
  }
}



