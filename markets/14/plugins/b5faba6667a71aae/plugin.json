{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "prix",
  "version": "1.0.0",
  "description": "Search contracts and manage e-signature requests in Prix, an AI contract management platform.",
  "author": {
    "name": "Lattice Inc.",
    "email": "contact@lattice.im",
    "url": "https://www.prix.im"
  },
  "homepage": "https://www.prix.im",
  "keywords": [
    "contract",
    "contract management",
    "e-signature",
    "CLM",
    "legal"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Prix",
        "shortDescription": "AI contract management",
        "longDescription": "Prix is an AI contract management platform that brings the whole contract lifecycle into one place, from drafting and review to e-signature and post-signing management. Connect Prix to ChatGPT to find your company's contracts and keep signature requests moving through conversation.\n\nPrix only accesses contracts and signature requests available to your connected Prix account. A Prix account is required.",
        "developerName": "Lattice Inc.",
        "category": "Productivity",
        "websiteURL": "https://www.prix.im",
        "supportURL": "https://docs.prix.im/ko",
        "privacyPolicyURL": "https://www.prix.im/privacy",
        "termsOfServiceURL": "https://www.prix.im/terms",
        "defaultPrompt": [
          "\uc774\ubc88 \ub2ec \uc885\ub8cc\ub418\ub294 \uacc4\uc57d\uc11c \uc54c\ub824\uc918",
          "\uc544\uc9c1 \uc11c\uba85\uc774 \uc548 \ub05d\ub09c \uc804\uc790\uc11c\uba85 \uc694\uccad \ubcf4\uc5ec\uc918",
          "\ube44\ubc00\uc720\uc9c0\uc11c\uc57d\uc11c \ud15c\ud50c\ub9bf\uc73c\ub85c \uc11c\uba85 \uc694\uccad \ubcf4\ub0b4\uc918"
        ],
        "brandColor": "#3549FF",
        "brandColorDark": "#6B8CFF",
        "composerIcon": "./assets/logo.png",
        "logo": "./assets/logo.png"
      },
      "review": {
        "test_cases": {
          "positive": [
            {
              "description": "\uc81c\ubaa9\uc73c\ub85c \uacc4\uc57d\uc11c \uac80\uc0c9",
              "prompt": "\uc81c\ubaa9\uc5d0 '\uc6a9\uc5ed\uacf5\uae09\uacc4\uc57d\uc11c'\uac00 \ub4e4\uc5b4\uac04 \uacc4\uc57d\uc11c \ucc3e\uc544\uc918",
              "tools_triggered": "search_contracts",
              "expected_behavior": "\ud14c\uc2a4\ud2b8 \uacc4\uc815\uc758 '(\uc608\uc2dc) \uc6a9\uc5ed\uacf5\uae09\uacc4\uc57d\uc11c'\ub97c \uc81c\ubaa9, \uccb4\uacb0 \uc5ec\ubd80, \uacc4\uc57d \uc0c1\ub300\ubc29, \uae30\uac04\uacfc \ud568\uaed8 \ubcf4\uc5ec\uc90d\ub2c8\ub2e4."
            },
            {
              "description": "\uacc4\uc57d\uc11c \uc0c1\uc138 \uc870\ud68c",
              "prompt": "\uadf8 \uacc4\uc57d\uc11c \uc0c1\uc138 \uc815\ubcf4 \ubcf4\uc5ec\uc918",
              "tools_triggered": "search_contracts, get_contract",
              "expected_behavior": "\uacc4\uc57d \uc0c1\ub300\ubc29 '(\uc608\uc2dc) \uace0\uac1d\uc0ac A', \uae30\uac04, \uc0c1\ud0dc, \ud0dc\uadf8 '\uac70\ub798\uacc4\uc57d' \ub4f1 \uc2e4\uc81c \ud544\ub4dc\ub9cc \ubcf4\uc5ec\uc8fc\uace0 \uc5c6\ub294 \uc815\ubcf4\ub294 \uc9c0\uc5b4\ub0b4\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4."
            },
            {
              "description": "\uacc4\uc57d\uc11c \ud0dc\uadf8 \ubcc0\uacbd",
              "prompt": "\uc6a9\uc5ed\uacf5\uae09\uacc4\uc57d\uc11c\uc5d0 '\uc591\ud574\uac01\uc11c' \ud0dc\uadf8\ub3c4 \ubd99\uc5ec\uc918",
              "tools_triggered": "list_contract_tags, search_contracts, update_contract_tags",
              "expected_behavior": "\uae30\uc874 \ud0dc\uadf8 '\uc591\ud574\uac01\uc11c'\ub97c \ucc3e\uc544 \uae30\uc874 '\uac70\ub798\uacc4\uc57d' \ud0dc\uadf8\ub97c \uc720\uc9c0\ud55c \ucc44 \ucd94\uac00\ud558\uace0 \uacb0\uacfc\ub97c \uc54c\ub824\uc90d\ub2c8\ub2e4."
            },
            {
              "description": "\ud15c\ud50c\ub9bf\uc73c\ub85c \uc11c\uba85 \uc694\uccad",
              "prompt": "\ube44\ubc00\uc720\uc9c0\uc11c\uc57d\uc11c \ud15c\ud50c\ub9bf\uc73c\ub85c reviewer@example.com \uc5d0\uac8c \uc11c\uba85 \uc694\uccad \ubcf4\ub0b4\uc918",
              "tools_triggered": "list_signature_templates, get_signature_template, create_signature_from_template",
              "expected_behavior": "'\ube44\ubc00\uc720\uc9c0\uc11c\uc57d\uc11c' \ud15c\ud50c\ub9bf\uc744 \ucc3e\uace0 \ucc38\uc5ec\uc790 \uc815\ubcf4\ub97c \uc0ac\uc6a9\uc790\uc5d0\uac8c \ud655\uc778\ud55c \ub4a4 \uc11c\uba85 \uc694\uccad\uc744 \uc0dd\uc131\ud569\ub2c8\ub2e4."
            },
            {
              "description": "\uc11c\uba85 \uc9c4\ud589 \ud604\ud669 \uc870\ud68c",
              "prompt": "\ubc29\uae08 \ubcf4\ub0b8 \uc11c\uba85 \uc694\uccad \uc0c1\ud0dc \uc54c\ub824\uc918",
              "tools_triggered": "search_signatures",
              "expected_behavior": "\uc9c4\ud589 \uc911\uc778 \uc11c\uba85 \uc694\uccad\uc744 \ucc38\uc5ec\uc790\ubcc4 \uc11c\uba85 \uc0c1\ud0dc, \uc694\uccad\uc77c\uacfc \ud568\uaed8 \ubcf4\uc5ec\uc90d\ub2c8\ub2e4."
            }
          ],
          "negative": [
            {
              "description": "\ud50c\ub7ec\uadf8\uc778 \ubc94\uc704 \ubc16\uc758 \ubc95\ub960 \uc790\ubb38",
              "prompt": "\uc774 \uacc4\uc57d\uc11c\uac00 \ubc95\uc801\uc73c\ub85c \uc720\ud6a8\ud55c\uc9c0 \ubc95\ub960 \uc758\uacac \uc918"
            },
            {
              "description": "\uc5f0\uacb0\ub41c \uacc4\uc815 \ubc16\uc758 \ub370\uc774\ud130 \uc811\uadfc",
              "prompt": "\ub2e4\ub978 \ud68c\uc0ac \ud504\ub9ad\uc2a4 \uc6cc\ud06c\uc2a4\ud398\uc774\uc2a4\uc758 \uacc4\uc57d\uc11c \ubcf4\uc5ec\uc918"
            },
            {
              "description": "\uc9c0\uc6d0\ud558\uc9c0 \uc54a\ub294 \uc77c\uad04 \uc0ad\uc81c",
              "prompt": "\ud504\ub9ad\uc2a4\uc5d0 \uc788\ub294 \ub0b4 \uacc4\uc57d\uc11c \uc804\ubd80 \uc0ad\uc81c\ud574\uc918"
            }
          ]
        },
        "commerce": false
      },
      "publication": {
        "release_notes": "Initial release: contract search and details, contract tags, signature templates, and e-signature requests.",
        "translations": {
          "ko-KR": {
            "subtitle": "AI \uacc4\uc57d\uad00\ub9ac \uc194\ub8e8\uc158",
            "description": "\ud504\ub9ad\uc2a4\ub294 \uacc4\uc57d\uc11c \uc791\uc131\uacfc \uac80\ud1a0\ubd80\ud130 \uc804\uc790\uc11c\uba85, \uccb4\uacb0 \uc774\ud6c4 \uad00\ub9ac\uae4c\uc9c0 \uacc4\uc57d\uc758 \uc804 \uacfc\uc815\uc744 \ud55c\uacf3\uc5d0\uc11c \ucc98\ub9ac\ud558\ub294 AI \uacc4\uc57d\uad00\ub9ac \uc194\ub8e8\uc158\uc785\ub2c8\ub2e4. ChatGPT\uc5d0 \ud504\ub9ad\uc2a4\ub97c \uc5f0\uacb0\ud558\uba74 \ub300\ud654\ub9cc\uc73c\ub85c \ud68c\uc0ac\uc758 \uacc4\uc57d\uc11c\ub97c \ucc3e\uc544\ubcf4\uace0 \uc11c\uba85 \uc694\uccad\uc744 \uc9c4\ud589\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n\n\ud504\ub9ad\uc2a4\ub294 \uc5f0\uacb0\ub41c \ud504\ub9ad\uc2a4 \uacc4\uc815\uc5d0\uc11c \uc811\uadfc \uac00\ub2a5\ud55c \uacc4\uc57d\uc11c\uc640 \uc11c\uba85 \uc694\uccad\uc5d0\ub9cc \uc811\uadfc\ud569\ub2c8\ub2e4. \ud504\ub9ad\uc2a4 \uacc4\uc815\uc774 \ud544\uc694\ud569\ub2c8\ub2e4."
          }
        }
      },
      "apps": "./.app.json"
    }
  }
}
