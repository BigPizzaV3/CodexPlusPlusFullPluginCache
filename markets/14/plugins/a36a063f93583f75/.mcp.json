{
  "mcpServers": {
    "frankox": {
      "url": "https://frankox.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "mixed",
            "client": {
              "mode": "dcr"
            },
            "resource": "https://frankox.com/mcp",
            "registrationUrl": "https://frankox.com/agent-register",
            "defaultScopes": [
              "catalog:read",
              "manufacturer:write",
              "match:request",
              "agent:communicate"
            ],
            "authorizationUrl": "https://frankox.com/agent-authorize",
            "tokenUrl": "https://frankox.com/agent-token"
          }
        }
      }
    }
  }
}