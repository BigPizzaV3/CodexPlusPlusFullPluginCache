{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "platoon-notes": {
      "type": "streamable-http",
      "url": "https://api.pltn.ai/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "5xHGzuagrgTt0FVi",
              "tokenEndpointAuthMethod": "client_secret_post"
            },
            "authorizationServerBase": "https://clerk.pltn.ai",
            "resource": "https://api.pltn.ai/mcp",
            "defaultScopes": ["profile", "email", "offline_access", "user:org:read"],
            "oidcEnabled": false
          }
        }
      }
    }
  }
}
