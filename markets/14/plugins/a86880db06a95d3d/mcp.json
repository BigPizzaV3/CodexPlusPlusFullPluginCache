{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "torr": {
      "type": "streamable-http",
      "url": "https://torr-mcp.web.app/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": { "mode": "dcr" },
            "registrationUrl": "https://torr-mcp.web.app/oauth/register",
            "authorizationUrl": "https://torr-mcp.web.app/oauth/authorize",
            "tokenUrl": "https://torr-mcp.web.app/oauth/token",
            "baseScopes": ["profile:read", "catalog:read", "history:read", "workouts:write"]
          }
        }
      }
    }
  }
}
