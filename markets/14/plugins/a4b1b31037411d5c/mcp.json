{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "dialeve": {
      "type": "streamable-http",
      "url": "https://api.meudialeve.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "deficit10-chatgpt",
              "tokenEndpointAuthMethod": "none"
            },
            "authorizationUrl": "https://api.meudialeve.com/oauth/authorize",
            "tokenUrl": "https://api.meudialeve.com/oauth/token",
            "authorizationServerBase": "https://api.meudialeve.com",
            "resource": "https://api.meudialeve.com/mcp",
            "baseScopes": [
              "offline_access"
            ],
            "defaultScopes": [
              "nutrition:read",
              "nutrition:write",
              "offline_access"
            ],
            "oidcEnabled": false
          }
        }
      }
    }
  }
}
