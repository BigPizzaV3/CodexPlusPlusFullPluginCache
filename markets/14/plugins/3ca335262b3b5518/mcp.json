{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "epictime": {
      "type": "streamable-http",
      "url": "https://epictime.io/chatgpt/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "epictime-chatgpt",
              "tokenEndpointAuthMethod": "none"
            },
            "authorizationUrl": "https://epictime.io/chatgpt/oauth/authorize",
            "tokenUrl": "https://epictime.io/chatgpt/oauth/token",
            "resource": "https://epictime.io/chatgpt/mcp",
            "baseScopes": [
              "story:free"
            ]
          }
        }
      }
    }
  }
}
