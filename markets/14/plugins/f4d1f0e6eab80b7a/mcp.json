{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "cwm": {
      "type": "streamable-http",
      "url": "https://cwm-openai-mcp.onrender.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "cwm-openai-chatgpt",
              "tokenEndpointAuthMethod": "none"
            },
            "baseScopes": [
              "cwm:insights:read"
            ]
          }
        }
      }
    }
  }
}
