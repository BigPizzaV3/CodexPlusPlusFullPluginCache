{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "prepsim": {
      "type": "streamable-http",
      "url": "https://aynadhillon.com/api/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "mixed",
            "client": {
              "mode": "cimd"
            },
            "authorizationServerBase": "https://aynadhillon.com",
            "resource": "https://aynadhillon.com/api/mcp",
            "baseScopes": [
              "prepsim:review",
              "offline_access"
            ],
            "defaultScopes": [
              "prepsim:review",
              "prepsim:bookmark",
              "offline_access"
            ],
            "authorizationUrl": "https://aynadhillon.com/api/mcp/oauth/authorize",
            "tokenUrl": "https://aynadhillon.com/api/mcp/oauth/token"
          }
        }
      }
    }
  }
}
