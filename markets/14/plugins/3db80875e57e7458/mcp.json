{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "itoldyou": {
      "type": "streamable-http",
      "url": "https://ity-mcp.lavs.info/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "ity-chatgpt-production",
              "tokenEndpointAuthMethod": "client_secret_post"
            },
            "baseScopes": [
              "openid",
              "offline_access",
              "home.read",
              "tasks.write",
              "shopping.write"
            ]
          }
        }
      }
    }
  }
}
