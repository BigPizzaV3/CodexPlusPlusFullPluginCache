{
  "tools": [
    {
      "name": "create_credit_application_link",
      "description": "Use this mcp tool when the user wants to apply for a credit. Returns a link to apply for a credit application prefilled with the amount and term. Call simulate_credit_application first to confirm conditions.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "amount": {
            "type": "integer",
            "minimum": 1,
            "description": "Credit application amount in UAH"
          },
          "repayment_plan": {
            "type": "object",
            "description": "Repayment plan details",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "FLEX",
                  "SCHEDULED"
                ]
              },
              "payment_every_days": {
                "type": "integer",
                "minimum": 2,
                "maximum": 30,
                "description": "Number of days between payments, required if type = FLEX"
              },
              "frequency": {
                "type": "string",
                "enum": [
                  "BIWEEKLY",
                  "MONTHLY"
                ],
                "description": "Required if type = SCHEDULED"
              }
            },
            "required": [
              "type"
            ]
          }
        },
        "required": [
          "amount",
          "repayment_plan"
        ]
      }
    },
    {
      "name": "simulate_credit_application",
      "description": "Use this mcp tool when the user wants to calculate credit application conditions (payments, fees, total amount) for a given amount in UAH and repayment plan.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "amount": {
            "type": "integer",
            "minimum": 1,
            "description": "Credit application amount in UAH"
          },
          "repayment_plan": {
            "type": "object",
            "description": "Repayment plan details",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "FLEX",
                  "SCHEDULED"
                ]
              },
              "payment_every_days": {
                "type": "integer",
                "minimum": 2,
                "maximum": 30,
                "description": "Number of days between payments, required if type = FLEX"
              },
              "frequency": {
                "type": "string",
                "enum": [
                  "BIWEEKLY",
                  "MONTHLY"
                ],
                "description": "Required if type = SCHEDULED"
              }
            },
            "required": [
              "type"
            ]
          }
        },
        "required": [
          "amount",
          "repayment_plan"
        ]
      }
    }
  ]
}
