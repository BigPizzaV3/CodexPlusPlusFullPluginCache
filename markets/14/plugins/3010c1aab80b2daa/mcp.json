{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "skulk": {
      "type": "streamable-http",
      "url": "https://skulk.tools/api/processes/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "skulk-processes-chatgpt",
              "tokenEndpointAuthMethod": "none"
            },
            "authorizationUrl": "https://skulk.tools/api/processes/oauth/authorize",
            "tokenUrl": "https://skulk.tools/api/processes/oauth/token",
            "resource": "https://skulk.tools/api/processes/mcp",
            "baseScopes": [
              "processes:read"
            ],
            "defaultScopes": [
              "openid",
              "email",
              "processes:read",
              "processes:requests:write",
              "agent-drafts:write",
              "processes:export"
            ]
          }
        }
      }
    }
  }
}