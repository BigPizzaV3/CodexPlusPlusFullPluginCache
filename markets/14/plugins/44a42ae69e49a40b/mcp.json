{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "frontpage": {
      "type": "streamable-http",
      "url": "https://app.frontpage.host/api/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": { "mode": "cimd" },
            "oidcEnabled": true,
            "oidcConfigurationUrl": "https://app.frontpage.host/.well-known/openid-configuration",
            "oidcUserinfoEndpoint": "https://app.frontpage.host/api/oauth/userinfo",
            "oidcScopesSupported": ["openid", "email"],
            "baseScopes": ["openid", "email", "sites:read"],
            "defaultScopes": ["openid", "email", "offline_access", "sites:read", "sites:write", "sites:operate", "sites:manage", "crm:read", "crm:write", "business:read", "business:write", "agents:use"]
          }
        }
      }
    }
  }
}
