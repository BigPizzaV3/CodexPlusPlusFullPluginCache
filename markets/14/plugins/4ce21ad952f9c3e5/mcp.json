{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "anywhere": {
      "type": "streamable-http",
      "url": "https://anywhere.fenn.chat/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "chatgpt",
              "tokenEndpointAuthMethod": "none"
            },
            "authorizationUrl": "https://anywhere.fenn.chat/oauth/authorize",
            "tokenUrl": "https://anywhere.fenn.chat/oauth/token"
          }
        }
      }
    }
  }
}
