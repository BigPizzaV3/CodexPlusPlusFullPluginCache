{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "apply-tracker": {
      "type": "streamable-http",
      "url": "https://chatgpt.apply-tracker.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "mixed",
            "client": {
              "mode": "provided",
              "clientId": "apply-tracker-chatgpt",
              "tokenEndpointAuthMethod": "none"
            },
            "authorizationUrl": "https://www.apply-tracker.com/api/chatgpt/oauth/authorize",
            "tokenUrl": "https://www.apply-tracker.com/api/chatgpt/oauth/token",
            "baseScopes": ["cvs:read", "cvs:write"]
          }
        }
      }
    }
  }
}
