{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "forkee": {
      "type": "streamable-http",
      "url": "https://api.getforkee.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "resource": "https://api.getforkee.com/mcp",
            "baseScopes": [
              "forkee:read",
              "forkee:write"
            ],
            "defaultScopes": []
          }
        }
      }
    }
  }
}
