{
  "mcpServers": {
    "praxis-veterinary-insights": {
      "url": "https://praxisvets.com/mcp/insights",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "resource": "https://praxisvets.com/mcp/insights",
            "baseScopes": [
              "insights:read"
            ],
            "defaultScopes": [
              "insights:read"
            ],
            "oidcEnabled": false
          }
        }
      }
    }
  }
}
