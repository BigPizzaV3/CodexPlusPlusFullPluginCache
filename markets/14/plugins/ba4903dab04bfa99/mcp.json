{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "linetrack": {
      "type": "streamable-http",
      "url": "https://app.linetrack.de/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "baseScopes": [
              "mcp:read"
            ],
            "defaultScopes": [
              "mcp:read"
            ],
            "client": {
              "mode": "provided",
              "clientId": "chatgpt-web",
              "tokenEndpointAuthMethod": "none"
            }
          }
        }
      }
    }
  }
}
