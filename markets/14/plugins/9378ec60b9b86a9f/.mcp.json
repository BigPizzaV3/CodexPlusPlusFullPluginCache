{
  "mcpServers": {
    "tickertiles": {
      "url": "https://mcp.tickertiles.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "authorizationUrl": "https://mcp.tickertiles.com/authorize",
            "tokenUrl": "https://mcp.tickertiles.com/token",
            "baseScopes": [
              "library:read",
              "library:write"
            ],
            "registrationUrl": "https://mcp.tickertiles.com/register"
          }
        }
      }
    }
  }
}
