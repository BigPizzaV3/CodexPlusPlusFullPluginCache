{
    "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
    "mcpServers": {
        "icanpreneur": {
            "type": "streamable-http",
            "url": "https://platform.icanpreneur.com/api/mcp",
            "extensions": {
                "com.openai": {
                    "auth": {
                        "type": "oauth",
                        "client": {
                            "mode": "dcr"
                        },
                        "baseScopes": [
                            "api:access"
                        ]
                    }
                }
            }
        }
    }
}
