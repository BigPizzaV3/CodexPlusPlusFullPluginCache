{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "tmailor": {
      "type": "streamable-http",
      "url": "https://mcp.tmailor.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "cimd"
            },
            "baseScopes": ["mailbox:read", "mailbox:write"],
            "oidcEnabled": false
          }
        }
      }
    }
  }
}
