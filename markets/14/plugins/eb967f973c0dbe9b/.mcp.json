{
  "mcpServers": {
    "invoicing": {
      "url": "https://app.invoicing.plus/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "authorizationServerBase": "https://app.invoicing.plus",
            "authorizationUrl": "https://app.invoicing.plus/mcp/oauth/authorize",
            "tokenUrl": "https://app.invoicing.plus/mcp/oauth/token",
            "registrationUrl": "https://app.invoicing.plus/mcp/oauth/register",
            "resource": "https://app.invoicing.plus/mcp",
            "baseScopes": ["invoicing:read", "invoicing:purchases"],
            "oidcEnabled": false
          }
        }
      }
    }
  }
}
