{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "aeroplan-iq": {
      "type": "streamable-http",
      "url": "https://app.drone-perspective.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "mixed",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": [
              "openid",
              "email"
            ]
          }
        }
      }
    }
  }
}
