{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "taxi-wien": {
      "type": "streamable-http",
      "url": "https://mcp.taxiwien.app/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "mixed",
            "client": {
              "mode": "cimd"
            },
            "defaultScopes": [
              "rides"
            ]
          }
        }
      }
    }
  }
}
