{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "mimic": {
      "type": "streamable-http",
      "url": "https://mcp.arukas.black/mimic/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": [
              "memory"
            ],
            "authorizationServerBase": "https://mcp.arukas.black/memory-private/oauth",
            "authorizationUrl": "https://mcp.arukas.black/memory-private/oauth/authorize",
            "tokenUrl": "https://mcp.arukas.black/memory-private/oauth/token",
            "registrationUrl": "https://mcp.arukas.black/memory-private/oauth/register",
            "resource": "https://mcp.arukas.black/mimic/mcp",
            "defaultScopes": [
              "memory"
            ],
            "oidcEnabled": false
          }
        }
      }
    }
  }
}
