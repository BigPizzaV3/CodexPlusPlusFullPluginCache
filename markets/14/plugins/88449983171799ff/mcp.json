{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "fintrack": {
      "type": "streamable-http",
      "url": "https://finanzasapi.customsystem.com.ar/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "fintrack-chatgpt",
              "tokenEndpointAuthMethod": "client_secret_post"
            },
            "baseScopes": ["finanzas:read"],
            "resource": "https://finanzasapi.customsystem.com.ar/mcp"
          }
        }
      }
    }
  }
}
