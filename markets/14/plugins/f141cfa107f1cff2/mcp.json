{
	"$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
	"mcpServers": {
		"tunecraft": {
			"type": "streamable-http",
			"url": "https://mcp.tunecraft.ai/mcp",
			"extensions": {
				"com.openai": {
					"auth": {
						"type": "oauth",
						"client": {
							"mode": "cimd"
						},
						"baseScopes": ["openid", "profile", "offline_access"]
					}
				}
			}
		}
	}
}
