{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "gc-airport-transfers": {
      "type": "streamable-http",
      "url": "https://gc-airporttransfers.com/wp-json/atb-gateway/v1/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "cimd"
            },
            "registrationUrl": "https://gc-airporttransfers.com/wp-json/atb-gateway/v1/oauth/register",
            "authorizationUrl": "https://gc-airporttransfers.com/wp-json/atb-gateway/v1/oauth/authorize",
            "tokenUrl": "https://gc-airporttransfers.com/wp-json/atb-gateway/v1/oauth/token",
            "baseScopes": ["transfers"]
          }
        }
      }
    }
  }
}
