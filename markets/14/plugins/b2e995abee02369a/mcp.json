{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "minasight": {
      "type": "streamable-http",
      "url": "https://api.minasight.ai/api/v1/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "minasight-chatgpt",
              "tokenEndpointAuthMethod": "client_secret_basic"
            },
            "baseScopes": ["mcp.read"]
          }
        }
      }
    }
  }
}
