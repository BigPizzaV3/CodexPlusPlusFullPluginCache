{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "umovi": {
      "type": "streamable-http",
      "url": "https://agent.umovi.app/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "mixed",
            "client": {
              "mode": "dcr"
            },
            "authorizationServerBase": "https://api.umovi.app",
            "resource": "https://agent.umovi.app",
            "defaultScopes": [
              "bookings:read",
              "bookings:write",
              "places:read",
              "places:write"
            ]
          }
        }
      }
    }
  }
}
