{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "studyquest": {
      "type": "streamable-http",
      "url": "https://www.studyquest.app/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": [
              "study:read",
              "study:write"
            ]
          }
        }
      }
    }
  }
}
