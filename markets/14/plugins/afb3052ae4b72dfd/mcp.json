{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "relay": {
      "type": "streamable-http",
      "url": "https://mcp.relayfi.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "cimd"
            },
            "resource": "https://mcp.relayfi.com/mcp",
            "baseScopes": [
              "organizations.read",
              "accounts.read",
              "transactions.read",
              "cards.read",
              "statements.read",
              "contacts.read",
              "catalog-items.read",
              "invoices.read",
              "offline_access"
            ],
            "defaultScopes": []
          }
        }
      }
    }
  }
}
