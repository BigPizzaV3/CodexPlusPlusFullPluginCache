{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "muvi": {
      "type": "streamable-http",
      "url": "https://mcp.muvi.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "muvi-chatgpt",
              "tokenEndpointAuthMethod": "none"
            },
            "authorizationUrl": "https://apigateway.muvi.com/mcp/oauth/authorize",
            "tokenUrl": "https://apigateway.muvi.com/mcp/oauth/token",
            "authorizationServerBase": "https://apigateway.muvi.com",
            "resource": "https://mcp.muvi.com/mcp",
            "baseScopes": [
              "mcp.read"
            ],
            "defaultScopes": [
              "mcp.read",
              "mcp.write",
              "mcp.delete"
            ],
            "oidcEnabled": false
          }
        }
      }
    }
  }
}
