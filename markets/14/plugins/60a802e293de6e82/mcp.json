{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "domi-ops": {
      "type": "streamable-http",
      "url": "https://app.domi-ops.com/api/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "cimd"
            },
            "resource": "https://app.domi-ops.com/api/mcp",
            "baseScopes": [
              "shopping:read",
              "chores:read",
              "shopping:write",
              "health:read",
              "health:write",
              "calendar:read",
              "offline_access"
            ],
            "defaultScopes": [
              "shopping:read",
              "chores:read",
              "shopping:write",
              "health:read",
              "health:write",
              "calendar:read",
              "offline_access"
            ]
          }
        }
      }
    }
  }
}
