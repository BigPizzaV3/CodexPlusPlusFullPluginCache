{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "sammy": {
      "type": "streamable-http",
      "url": "https://sammy.codific.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "defaultScopes": ["mcp:read"]
          }
        }
      }
    }
  }
}
