{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "kosmico": {
      "type": "streamable-http",
      "url": "https://api.kosmico.ai/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "kosmico-openai",
              "tokenEndpointAuthMethod": "client_secret_basic"
            },
            "baseScopes": [
              "files:read",
              "files:write",
              "projects:tools",
              "computer:request"
            ]
          }
        }
      }
    }
  }
}
