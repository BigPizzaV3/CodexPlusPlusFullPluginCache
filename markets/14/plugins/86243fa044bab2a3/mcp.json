{
    "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
    "mcpServers": {
        "raisemore": {
            "type": "streamable-http",
            "url": "https://www.raisemore.app/mcp",
            "extensions": {
                "com.openai": {
                    "auth": {
                        "type": "oauth",
                        "client": { "mode": "cimd" },
                        "baseScopes": ["profile", "offline_access"]
                    }
                }
            }
        }
    }
}
