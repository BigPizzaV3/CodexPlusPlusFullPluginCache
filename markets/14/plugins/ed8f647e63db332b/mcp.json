{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "donkey-cut": {
      "type": "streamable-http",
      "url": "https://donkeycut.com/api/chatgpt/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "donkey-chatgpt",
              "tokenEndpointAuthMethod": "none"
            },
            "defaultScopes": [
              "projects:read",
              "previews:render",
              "projects:write",
              "openid",
              "email"
            ]
          }
        }
      }
    }
  }
}
