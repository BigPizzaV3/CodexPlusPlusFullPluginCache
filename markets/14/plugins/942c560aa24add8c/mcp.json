{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "attenty": {
      "type": "streamable-http",
      "url": "https://attenty.app/api/bot/directory-canvas-mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "resource": "https://attenty.app/api/bot/directory-canvas-mcp",
            "client": {
              "mode": "dcr"
            },
            "defaultScopes": [],
            "baseScopes": [
              "directory:canvas"
            ]
          }
        }
      }
    }
  }
}
