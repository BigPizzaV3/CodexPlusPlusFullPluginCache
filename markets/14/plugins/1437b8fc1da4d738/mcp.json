{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "encryptssl": {
      "type": "streamable-http",
      "url": "https://api.encryptssl.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "cimd"
            },
            "defaultScopes": ["certificates:read", "certificates:write", "integrations:read"]
          }
        }
      }
    }
  }
}
