{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "qiubo-business": {
      "type": "streamable-http",
      "url": "https://api.qiubo.app/mcp/business",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": [
              "offline_access"
            ],
            "defaultScopes": [
              "store:read",
              "orders:read",
              "products:read",
              "balance:read",
              "offline_access"
            ]
          }
        }
      }
    }
  }
}
