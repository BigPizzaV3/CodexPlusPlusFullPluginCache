{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "voixcall": {
      "type": "streamable-http",
      "url": "https://api.voixcall.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "cimd"
            },
            "resource": "https://api.voixcall.com/mcp",
            "baseScopes": [
              "rates:read",
              "credits:read",
              "voice:manage",
              "numbers:read",
              "numbers:manage"
            ],
            "defaultScopes": [
              "rates:read",
              "credits:read",
              "voice:manage",
              "numbers:read",
              "numbers:manage"
            ]
          }
        }
      }
    }
  }
}
