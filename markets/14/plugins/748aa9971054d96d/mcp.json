{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "cove": {
      "type": "streamable-http",
      "url": "https://cove.lifeplainly.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "cimd"
            },
            "baseScopes": [
              "work:read",
              "work:write",
              "journal:read",
              "journal:write",
              "calendar:read",
              "calendar:write",
              "profile:read",
              "profile:write"
            ]
          }
        }
      }
    }
  }
}
