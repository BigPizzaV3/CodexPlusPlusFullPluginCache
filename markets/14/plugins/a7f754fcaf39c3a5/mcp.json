{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "leap-english-pathways": {
      "type": "streamable-http",
      "url": "https://api.leapenglishpathways.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "mixed",
            "client": {
              "mode": "cimd"
            },
            "defaultScopes": ["openid"]
          }
        }
      }
    }
  }
}
