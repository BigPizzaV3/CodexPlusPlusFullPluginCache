{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "hyperbound": {
      "type": "streamable-http",
      "url": "https://api.hyperbound.ai/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": [
              "mcp:org.data.read",
              "mcp:org.asset.manage",
              "mcp:org.context.manage"
            ],
            "defaultScopes": []
          }
        }
      }
    }
  }
}
