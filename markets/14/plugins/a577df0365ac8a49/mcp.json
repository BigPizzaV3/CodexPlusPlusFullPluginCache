{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "gconnect": {
      "type": "streamable-http",
      "url": "https://gconnect.able2code.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "gconnect-chatgpt",
              "tokenEndpointAuthMethod": "none"
            },
            "authorizationUrl": "https://gconnect.able2code.com/auth/realms/gconnect/protocol/openid-connect/auth",
            "tokenUrl": "https://gconnect.able2code.com/auth/realms/gconnect/protocol/openid-connect/token",
            "baseScopes": [
              "openid",
              "offline_access"
            ],
            "defaultScopes": [
              "openid",
              "offline_access"
            ],
            "oidcEnabled": false
          }
        }
      }
    }
  }
}
