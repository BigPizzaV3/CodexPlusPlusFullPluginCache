{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "finikos": {
      "type": "streamable-http",
      "url": "https://mcp.finikos.it/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "brevita-mcp",
              "tokenEndpointAuthMethod": "none"
            },
            "authorizationUrl": "https://api.finikos.it/oauth2/authorize",
            "tokenUrl": "https://api.finikos.it/oauth2/token",
            "baseScopes": ["openid", "profile", "email", "mcp.read"]
          }
        }
      }
    }
  }
}
