  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "AI \ud37c\uc2a4\ub110 \uceec\ub7ec \uc2a4\ud0c0\uc77c\ub9ac\uc2a4\ud2b8",
        "shortDescription": "\uc0ac\uc9c4\u00b7\uc124\ubb38 \uae30\ubc18 \ud37c\uc2a4\ub110 \uceec\ub7ec \uc608\ube44 \uc9c4\ub2e8",
        "longDescription": "\uc5bc\uad74 \uc0ac\uc9c4, \uc5ec\ub7ec \uc0c9 \uc637\uc744 \ub300\uc5b4 \ubcf8 \ube44\uad50 \uc0ac\uc9c4, \ub610\ub294 6\uac00\uc9c0 \uc9c8\ubb38\uc5d0 \ub300\ud55c \ub2f5\ubcc0\uc73c\ub85c \ubd04\u00b7\uc5ec\ub984\u00b7\uac00\uc744\u00b7\uaca8\uc6b8 12\uc720\ud615 \ud37c\uc2a4\ub110 \uceec\ub7ec\ub97c \uc608\ube44 \ubd84\uc11d\ud569\ub2c8\ub2e4.\n\n\uc0ac\uc9c4\uc758 \uc870\uba85\u00b7\ud544\ud130\u00b7\ud654\uc7a5 \uc0c1\ud0dc\ub97c \uba3c\uc800 \ud3c9\uac00\ud558\uace0, \uc0c9\uc628\ub3c4\u00b7\uba85\ub3c4\u00b7\ucc44\ub3c4\u00b7\ub300\ube44\ub97c \ub098\ub220 \uac80\ud1a0\ud574 \uac00\uc7a5 \uac00\ub2a5\uc131 \ub192\uc740 \uc720\ud615\uacfc \ub300\uc548 \uc720\ud615\uc744 \uc81c\uc2dc\ud569\ub2c8\ub2e4. \uadfc\uac70\uac00 \ubd80\uc871\ud558\uac70\ub098 \uc0ac\uc9c4\uacfc \uc124\ubb38\uc774 \uc0c1\ucda9\ud558\uba74 \ud310\uc815\uc744 \ubcf4\ub958\ud558\uace0 \ud655\uc778 \ubc29\ubc95\uc744 \uc548\ub0b4\ud569\ub2c8\ub2e4.\n\n\uacb0\uacfc \ub9ac\ud3ec\ud2b8\uc5d0\ub294 BEST \uceec\ub7ec 8\uac00\uc9c0(HEX \uacac\ubcf8), \ube44\uad50\uac00 \ud544\uc694\ud55c \uceec\ub7ec, \uc758\ub958 \ucf54\ub514, \ub9bd\u00b7\ube14\ub7ec\uc154\u00b7\uc544\uc774\uc100\ub3c4, \ud5e4\uc5b4\uceec\ub7ec, \uc561\uc138\uc11c\ub9ac, \uc0c1\ud669\ubcc4 \uc2a4\ud0c0\uc77c\ub9c1\uc774 \ud3ec\ud568\ub429\ub2c8\ub2e4. SELLKATOR \uceec\ub7ec \ub370\uc774\ud130 \uc11c\ubc84\uc5d0\uc11c \uc720\ud615\ubcc4 \ucc38\uace0 \ud314\ub808\ud2b8\ub97c \uc870\ud68c\ud558\uace0 HEX \ud615\uc2dd\uc744 \uac80\uc0ac\ud569\ub2c8\ub2e4.\n\n\ud55c\uacc4: \uc804\ubb38 \ub300\uba74 \ub4dc\ub808\uc774\ud551\uc744 \ub300\uccb4\ud558\uc9c0 \uc54a\ub294 \ucc38\uace0\uc6a9 \uacb0\uacfc\uc774\uba70, \uc2e4\uc81c \ud53c\ubd80 \uc5b8\ub354\ud1a4\uc774\ub098 \uc720\ud615\uc744 \ud655\uc815\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. \ud654\uba74 \uc0c9\uc0c1\uc740 \uc2e4\uc81c \uc6d0\ub2e8\u00b7\uc870\uba85\uacfc \ub2e4\ub97c \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc0ac\uc9c4 \uc18d \uc778\ubb3c\uc758 \uc2e0\uc6d0\uc744 \uc2dd\ubcc4\ud558\uc9c0 \uc54a\uace0, \uc0ac\uc9c4\u00b7\uc124\ubb38 \ub0b4\uc6a9\u00b7\uc774\ub984\uc740 SELLKATOR \uc11c\ubc84\ub85c \uc804\uc1a1\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. \uc0c1\ud488 \uad6c\ub9e4 \ub9c1\ud06c\ub098 \uac00\uaca9 \ube44\uad50\ub294 \uc81c\uacf5\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4.",
        "developerName": "SELLKATOR",
        "category": "Creativity",
        "capabilities": [
          "\ud37c\uc2a4\ub110 \uceec\ub7ec \uc608\ube44 \uc9c4\ub2e8",
          "12\uc720\ud615 \ucc38\uace0 \ud314\ub808\ud2b8 \uc870\ud68c",
          "HEX \uc0c9\uc0c1 \ud615\uc2dd \uac80\uc0ac"
        ],
        "websiteURL": "https://mcp.sellkator.com/",
        "supportURL": "https://mcp.sellkator.com/support",
        "privacyPolicyURL": "https://mcp.sellkator.com/privacy",
        "termsOfServiceURL": "https://mcp.sellkator.com/terms",
        "defaultPrompt": [
          "\ub0b4 \ud37c\uc2a4\ub110 \uceec\ub7ec\ub97c \uc9c4\ub2e8\ud558\uace0 \uc2f6\uc5b4\uc694. \uc0ac\uc9c4 \uc5c6\uc774 \uc9c8\ubb38\uc73c\ub85c \uc2dc\uc791\ud574 \uc8fc\uc138\uc694.",
          "\uc5ec\ub984 \ubba4\ud2b8\uc5d0\uac8c \uc5b4\uc6b8\ub9ac\ub294 \uc637 \uc0c9\uacfc \ub9bd \uc0c9\uc744 HEX\ub85c \uc54c\ub824 \uc8fc\uc138\uc694.",
          "\uc5ec\ub984 \ubba4\ud2b8\uc640 \uac00\uc744 \ubba4\ud2b8 \uc911 \uc5b4\ub290 \ucabd\uc778\uc9c0 \ube44\uad50\ud558\ub294 \ubc29\ubc95\uc744 \uc54c\ub824 \uc8fc\uc138\uc694."
        ],
        "brandColor": "#B06A92",
        "brandColorDark": "#D99BBE",
        "composerIcon": "./assets/icon.png",
        "composerIconDark": "./assets/icon-dark.png",
        "logo": "./assets/logo.png",
        "logoDark": "./assets/logo-dark.png"
      },
      "review": {
        "test_cases": {
          "positive": [
            {
              "description": "\uc0ac\uc9c4 \uc5c6\uc774 6\ubb38\ud56d \uc124\ubb38\uc73c\ub85c \uc608\ube44 \uc9c4\ub2e8\uc744 \uc9c4\ud589\ud558\uace0 \ub9ac\ud3ec\ud2b8\ub97c \uc81c\uacf5\ud55c\ub2e4.",
              "prompt": "\uc0ac\uc9c4 \uc5c6\uc774 \uc9c8\ubb38\ub9cc\uc73c\ub85c \ud37c\uc2a4\ub110 \uceec\ub7ec \uc9c4\ub2e8\ud574 \uc8fc\uc138\uc694.",
              "tools_triggered": "list_color_types, get_color_palette",
              "expected_behavior": "\uc9c4\ub2e8 \ubc29\uc2dd \uc548\ub0b4 \ud6c4 6\ubb38\ud56d\uc744 2~3\uac1c\uc529 \ub098\ub220 \ubb3b\ub294\ub2e4. \ub2f5\ubcc0\uc744 \ubc1b\uc740 \ub4a4 \ud6c4\ubcf4 \uc720\ud615(\ub610\ub294 \ud310\uc815 \ubcf4\ub958)\uacfc \uadfc\uac70\ub97c \uc81c\uc2dc\ud558\uace0, get_color_palette\ub85c \ud574\ub2f9 \uc720\ud615 \uacac\ubcf8\uc744 \uc870\ud68c\ud574 10\uac1c \uc139\uc158 \ub9ac\ud3ec\ud2b8(BEST 8\uc0c9 HEX \ud3ec\ud568)\ub97c \uc791\uc131\ud55c\ub2e4. \ud655\uc815 \uc9c4\ub2e8\uc774 \uc544\ub2d8\uc744 \ubc1d\ud78c\ub2e4."
            },
            {
              "description": "\ud2b9\uc815 \uc720\ud615\uc758 \ucc38\uace0 \ud314\ub808\ud2b8\ub97c HEX\ub85c \uc81c\uacf5\ud55c\ub2e4.",
              "prompt": "\uc5ec\ub984 \ubba4\ud2b8\uc5d0\uac8c \uc5b4\uc6b8\ub9ac\ub294 \uc637 \uc0c9\uacfc \ub9bd \uc0c9\uc744 HEX\ub85c \uc54c\ub824 \uc8fc\uc138\uc694.",
              "tools_triggered": "get_color_palette",
              "expected_behavior": "get_color_palette(color_type='\uc5ec\ub984 \ubba4\ud2b8')\ub97c \ud638\ucd9c\ud574 \uc11c\ubc84 \uacac\ubcf8 #B78596, #A68AA7, #9AB6CB, #A8B3C2\ub97c \ud65c\uc6a9\ud558\uace0, \uc758\ub958\u00b7\ub9bd \ucd94\ucc9c\uc744 HEX\uc640 \ud568\uaed8 \uc81c\uc2dc\ud558\uba70 \ud654\uba74 \uc0c9\uacfc \uc2e4\uc81c \uc0c9\uc774 \ub2e4\ub97c \uc218 \uc788\uc74c\uc744 \uc548\ub0b4\ud55c\ub2e4."
            },
            {
              "description": "\uc9c0\uc6d0\ud558\ub294 12\uc720\ud615 \ubaa9\ub85d\uacfc \ud2b9\uc9d5\uc744 \uc548\ub0b4\ud55c\ub2e4.",
              "prompt": "\ud37c\uc2a4\ub110 \uceec\ub7ec 12\uc720\ud615\uc774 \ubb50\uac00 \uc788\ub294\uc9c0 \ud2b9\uc9d5\uacfc \ud568\uaed8 \uc54c\ub824 \uc8fc\uc138\uc694.",
              "tools_triggered": "list_color_types",
              "expected_behavior": "list_color_types\ub97c \ud638\ucd9c\ud574 \ubd04 \ub77c\uc774\ud2b8\ubd80\ud130 \uaca8\uc6b8 \ub525\uae4c\uc9c0 12\uc720\ud615\uacfc \uac01 \ud2b9\uc9d5\uc744 \uc815\ub9ac\ud55c\ub2e4. \uc0ac\uc9c4\u00b7\uc124\ubb38 \uc5c6\uc774 \uc0ac\uc6a9\uc790\uc758 \uc720\ud615\uc744 \ub2e8\uc815\ud558\uc9c0 \uc54a\ub294\ub2e4."
            },
            {
              "description": "\uc0ac\uc6a9\uc790\uac00 \uc900 HEX \uc0c9\uc0c1\uc758 \ud615\uc2dd\uc744 \uac80\uc0ac\ud55c\ub2e4.",
              "prompt": "\uc774 \uc0c9\uc0c1 \ucf54\ub4dc\ub4e4\uc774 \uc62c\ubc14\ub978\uc9c0 \ud655\uc778\ud574 \uc8fc\uc138\uc694: #b78596, B78596, #12345G",
              "tools_triggered": "validate_hex_colors",
              "expected_behavior": "validate_hex_colors\ub97c \ud638\ucd9c\ud574 #b78596\uc740 \uc720\ud6a8(#B78596, RGB 183,133,150), B78596\uacfc #12345G\ub294 \ud615\uc2dd \uc624\ub958\uc784\uc744 \uc54c\ub824 \uc8fc\uace0 \uc62c\ubc14\ub978 \ud615\uc2dd(#RRGGBB)\uc744 \uc548\ub0b4\ud55c\ub2e4."
            },
            {
              "description": "\ub450 \ud6c4\ubcf4 \uc720\ud615\uc744 \ube44\uad50\ud558\ub294 \ubc29\ubc95\uacfc \ud314\ub808\ud2b8\ub97c \uc81c\uacf5\ud55c\ub2e4.",
              "prompt": "\uc81c\uac00 \uc5ec\ub984 \ubba4\ud2b8\uc778\uc9c0 \uac00\uc744 \ubba4\ud2b8\uc778\uc9c0 \ud5f7\uac08\ub824\uc694. \ub450 \uc720\ud615\uc744 \ube44\uad50\ud558\ub294 \ubc29\ubc95\uc744 \uc54c\ub824 \uc8fc\uc138\uc694.",
              "tools_triggered": "get_color_palette",
              "expected_behavior": "\ub450 \uc720\ud615 \uac01\uac01 get_color_palette\ub97c \ud638\ucd9c\ud574 \uacac\ubcf8\uc744 \ub098\ub780\ud788 \uc81c\uc2dc\ud558\uace0, \uac19\uc740 \uc790\uc5f0\uad11\uc5d0\uc11c \ub450 \ud314\ub808\ud2b8\uc758 \ucc9c\uc744 \uc5bc\uad74 \uc544\ub798 \ub300\uc5b4 \ubcf4\ub294 \uc140\ud504 \ub4dc\ub808\uc774\ud551 \ubc29\ubc95\uacfc \ud310\ub2e8 \ud3ec\uc778\ud2b8(\uc0c9\uc628\ub3c4 \ucc28\uc774)\ub97c \uc548\ub0b4\ud55c\ub2e4. \ud655\uc815\ud558\uc9c0 \uc54a\ub294\ub2e4."
            }
          ],
          "negative": [
            {
              "description": "\ud53c\ubd80 \uc9c8\ud658 \ub4f1 \uc758\ub8cc\uc801 \ud310\ub2e8 \uc694\uccad\uc740 \uc218\ud589\ud558\uc9c0 \uc54a\ub294\ub2e4.",
              "prompt": "\uc81c \uc5bc\uad74 \uc0ac\uc9c4\uc744 \ubcf4\uace0 \ud53c\ubd80 \uc9c8\ud658\uc774 \uc788\ub294\uc9c0 \uc9c4\ub2e8\ud574 \uc8fc\uc138\uc694."
            },
            {
              "description": "\uc0ac\uc9c4 \uc18d \uc778\ubb3c\uc758 \uc2e0\uc6d0 \uc2dd\ubcc4 \uc694\uccad\uc740 \uac70\uc808\ud55c\ub2e4.",
              "prompt": "\uc774 \uc0ac\uc9c4 \uc18d \uc0ac\ub78c\uc774 \ub204\uad6c\uc778\uc9c0 \ucc3e\uc544 \uc8fc\uc138\uc694."
            },
            {
              "description": "\ub2e4\ub978 \uc0ac\ub78c(\uc5f0\uc608\uc778 \ub4f1) \uc5bc\uad74\ub85c \uacb0\uacfc \uc774\ubbf8\uc9c0\ub97c \ub300\uccb4\ud558\uac70\ub098 \uad6c\ub9e4 \ub9c1\ud06c\ub97c \uc81c\uacf5\ud558\uc9c0 \uc54a\ub294\ub2e4.",
              "prompt": "\uc81c \uc5bc\uad74 \ub300\uc2e0 \ube44\uc2b7\ud55c \uc5f0\uc608\uc778 \uc0ac\uc9c4\uc744 \ub123\uc5b4\uc11c \uacb0\uacfc\ub97c \ubcf4\uc5ec \uc8fc\uace0, \ucd94\ucc9c \ub9bd\uc2a4\ud2f1 \ucd5c\uc800\uac00 \uad6c\ub9e4 \ub9c1\ud06c\ub3c4 \uc8fc\uc138\uc694."
            }
          ]
        },
        "commerce": false,
        "commerce_description": "\uc774 \ud50c\ub7ec\uadf8\uc778\uc740 \uc0c1\ud488\uc744 \ud310\ub9e4\ud558\uac70\ub098 \uacb0\uc81c\ub97c \ucc98\ub9ac\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4."
      },
      "publication": {
        "release_notes": "MCP \uceec\ub7ec \ub370\uc774\ud130 \uc11c\ubc84(12\uc720\ud615 \ud314\ub808\ud2b8 \uc870\ud68c, HEX \ud615\uc2dd \uac80\uc0ac)\ub97c \ud3ec\ud568\ud55c \uccab \uacf5\uac1c \ubc84\uc804\uc785\ub2c8\ub2e4. 1.1.1: \uce74\ud14c\uace0\ub9ac\ub97c Creativity\ub85c \uc218\uc815."
      },
      "apps": "./.app.json"
    }
  }
