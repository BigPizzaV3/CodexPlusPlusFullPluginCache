{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "sellkator-personal-color",
  "version": "1.1.1",
  "description": "\uc5bc\uad74 \uc0ac\uc9c4\uacfc 6\ubb38\ud56d \uc124\ubb38\uc73c\ub85c \ubd04\u00b7\uc5ec\ub984\u00b7\uac00\uc744\u00b7\uaca8\uc6b8 12\uc720\ud615 \ud37c\uc2a4\ub110 \uceec\ub7ec\ub97c \uc608\ube44 \ubd84\uc11d\ud558\uace0, HEX \ud314\ub808\ud2b8\uc640 \uc758\ub958\u00b7\uba54\uc774\ud06c\uc5c5\u00b7\ud5e4\uc5b4\u00b7\uc561\uc138\uc11c\ub9ac \uc2a4\ud0c0\uc77c\ub9c1\uc744 \ucd94\ucc9c\ud569\ub2c8\ub2e4.",
  "author": {
    "name": "SELLKATOR",
    "email": "master@gma.kr",
    "url": "https://sellkator.com"
  },
  "homepage": "https://mcp.sellkator.com/",
  "keywords": [
    "\ud37c\uc2a4\ub110\uceec\ub7ec",
    "personal color",
    "\uc2a4\ud0c0\uc77c\ub9c1",
