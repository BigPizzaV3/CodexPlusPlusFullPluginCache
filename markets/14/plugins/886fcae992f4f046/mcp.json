{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "visibilitycheck": {
      "type": "streamable-http",
      "url": "https://visibilitycheck.ai/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "mixed",
            "client": {
              "mode": "cimd"
            },
            "authorizationServerBase": "https://visibilitycheck.ai",
            "authorizationUrl": "https://visibilitycheck.ai/oauth/authorize",
            "tokenUrl": "https://visibilitycheck.ai/oauth/token",
            "registrationUrl": "https://visibilitycheck.ai/oauth/register",
            "resource": "https://visibilitycheck.ai/mcp",
            "baseScopes": ["scans.run", "reports.read"],
            "oidcEnabled": false
          }
        }
      }
    }
  }
}
