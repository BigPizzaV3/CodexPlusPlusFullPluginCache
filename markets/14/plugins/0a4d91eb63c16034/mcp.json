{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "datashake": {
      "type": "streamable-http",
      "url": "https://mcp.datashake.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "registrationUrl": "https://id-mgmt-svc.datashake.com/api/v1/oauth/register",
            "authorizationServerBase": "https://id-mgmt-svc.datashake.com",
            "baseScopes": [
              "datashake:mcp"
            ]
          }
        }
      }
    }
  }
}
