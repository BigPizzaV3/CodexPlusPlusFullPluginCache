{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "str-loophole": {
      "type": "streamable-http",
      "url": "https://str-loophole.web.app/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "authorizationUrl": "https://str-loophole.web.app/authorize",
            "tokenUrl": "https://str-loophole.web.app/token",
            "registrationUrl": "https://str-loophole.web.app/register"
          }
        }
      }
    }
  }
}
