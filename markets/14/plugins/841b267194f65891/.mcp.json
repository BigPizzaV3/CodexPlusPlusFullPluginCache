{
  "mcpServers": {
    "gumroad": {
      "url": "https://gumroad.com/chatgpt/v1/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "defaultScopes": [
              "view_profile",
              "view_sales",
              "edit_products",
              "view_payouts"
            ]
          }
        }
      }
    }
  }
}
