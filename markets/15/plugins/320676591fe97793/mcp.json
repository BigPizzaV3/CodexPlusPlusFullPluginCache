{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "0xcal": {
      "type": "streamable-http",
      "url": "https://0xcal.app/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "cimd"
            },
            "defaultScopes": [
              "meals:read",
              "summary:read",
              "meals:write",
              "goals:write"
            ]
          }
        }
      }
    }
  }
}
