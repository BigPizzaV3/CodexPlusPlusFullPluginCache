{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "weavers": {
      "type": "streamable-http",
      "url": "https://www.weavers.app/api/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "weavers-chatgpt",
              "tokenEndpointAuthMethod": "client_secret_post"
            },
            "defaultScopes": [
              "weavers.profile.read",
              "weavers.notebooks.read",
              "weavers.experiments.read"
            ]
          }
        }
      }
    }
  }
}
