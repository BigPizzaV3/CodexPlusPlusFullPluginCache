{
    "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
    "mcpServers": {
        "baseline": {
            "type": "streamable-http",
            "url": "https://baseline.a5labs.com/mcp",
            "extensions": {
                "com.openai": {
                    "auth": {
                        "type": "oauth",
                        "client": {
                            "mode": "dcr"
                        },
                        "baseScopes": ["baseline:read", "baseline:watchlists"]
                    }
                }
            }
        }
    }
}
