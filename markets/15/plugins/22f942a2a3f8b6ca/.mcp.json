{
  "mcpServers": {
    "memoryrouter": {
      "type": "http",
      "url": "https://mcp.memoryrouter.ai/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": [
              "memories:read",
              "memories:write"
            ],
            "defaultScopes": [
              "memories:read",
              "memories:write"
            ]
          }
        }
      }
    }
  }
}
