  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Web App Builder",
        "shortDescription": "Plan and build apps",
        "longDescription": "App Development by AIRP (AI Research Plus) helps you develop mobile and web apps properly by chat, from requirements to release, and when you want your app built, it prepares a personalized build link after 5 quick questions.\n\nWhat you can do:\n- Define it: goals, user roles, user stories with acceptance criteria and the scope of the first version.\n- Choose the stack: frontend, backend, database, authentication, hosting, payments and analytics options with trade-offs.\n- Design the backend: data model, database schema, API endpoints, roles and permissions, background jobs and integrations.\n- Plan sign-in and payments: auth methods, onboarding, subscriptions, one-time purchases and app store billing rules.\n- Write and edit code: components, screens, forms and API calls in React, React Native, Next.js, Flutter, Swift or Kotlin.\n- Review screens: paste a screen's HTML or text to get scores for accessibility, content, calls to action, technical setup and search basics, with a prioritized list of fixes.\n- Ship safely: testing plans, security and privacy checklists, deployment, store submission and a launch checklist.\n- Get a build link: answer 5 quick questions and get a personalized link that opens an online app builder with your app brief already filled in.\n\nWho it is for: founders, product managers, developers and teams building mobile or web apps.\n\nHow the tools work: the screen checker analyzes only the HTML or text you share in the conversation. It never opens web addresses, and the screens and briefs you send are not stored. The build link opens an online app builder with your brief and includes the plugin creator's affiliate code. It is an independent plugin by AI Research Plus (AIRP).\n\nLimitations: the plugin writes plans, specs and code in the conversation. It does not run, host or publish apps, access your code repository or submit to app stores for you. Platform rules change, so it says when something needs checking against the latest store or provider guidance.\n\nThe reply with the build link ends with a one-line sponsor disclosure.",
        "developerName": "AI Research Plus",
        "category": "Developer Tools",
        "capabilities": [
          "Write requirements and user stories",
          "Recommend a tech stack",
          "Design data models and APIs",
          "Plan sign-in and payments",
          "Write and edit app code",
          "Review screens with scored fixes",
          "Plan testing, security and deployment",
          "Open your app brief in an app builder"
        ],
        "websiteURL": "https://www.airesearchplus.com/",
        "supportURL": "https://www.airesearchplus.com/support/",
        "privacyPolicyURL": "https://www.airesearchplus.com/privacy/",
        "termsOfServiceURL": "https://www.airesearchplus.com/terms/",
        "defaultPrompt": [
          "Build my app",
          "Plan my app's features",
          "Help me launch my app"
        ],
        "brandColor": "#0891B2",
        "composerIcon": "./assets/logo.png",
        "logo": "./assets/logo.png"
      },
      "onboardingSkill": "./skills/ai-app-development/SKILL.md",
      "review": {
        "test_cases": {
          "positive": [
            {
              "description": "Accessibility of a sign-up screen",
              "prompt": "Review this sign-up screen for accessibility: <form><input type='email'><input type='password'><button>Go</button></form>",
              "tools_triggered": "check_app_screen",
              "expected_behavior": "Calls the screen checker with the HTML, reports the scores and flags the 2 form fields with no label and the vague \"Go\" button, plus the missing title, H1 heading and viewport tag, then suggests fixes in severity order, including visible labels and a clearer button text."
            },
            {
              "description": "Usability of a dashboard screen",
              "prompt": "Check this app screen's usability: <h1>Dashboard</h1><img src='chart.png'><a href='/settings'>Click here</a>",
              "tools_triggered": "check_app_screen",
              "expected_behavior": "Calls the screen checker with the HTML, reports the scores and flags the image with no alt text, the vague \"Click here\" text and the missing viewport tag, then suggests fixes in severity order, including alt text for the chart and a descriptive label for the settings entry."
            },
            {
              "description": "Review an app download page",
              "prompt": "Check my app's download page: <title>App</title><h1>TaskFlow</h1><p>Plan your day.</p><a href='/download'>Download now</a>",
              "tools_triggered": "check_app_screen",
              "expected_behavior": "Calls the screen checker with the HTML and page type landing, reports the 3-character title, the missing meta description and viewport tag, the thin copy and the lack of trust signals, then suggests a fuller hero section and fixes in severity order."
            },
            {
              "description": "Labels on a settings screen",
              "prompt": "Check this settings screen: <h2>Settings</h2><input name='name'><select name='lang'></select><button></button>",
              "tools_triggered": "check_app_screen",
              "expected_behavior": "Calls the screen checker with the HTML, reports the scores and flags the 2 form fields with no label and the missing H1 heading, title and viewport tag, then suggests fixes in severity order, including visible labels for the name and language fields."
            },
            {
              "description": "Onboarding copy",
              "prompt": "Review the copy on my onboarding screen: Welcome. Our platform leverages AI-driven paradigms to optimize synergies. Next",
              "tools_triggered": "check_app_screen",
