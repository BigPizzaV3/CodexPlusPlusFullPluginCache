{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "dreamtrip": {
      "type": "streamable-http",
      "url": "https://www.thedreamtrip.app/chatgpt/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "authorizationServerBase": "https://www.thedreamtrip.app/oauth/chatgpt",
            "defaultScopes": [],
            "oidcEnabled": false
          }
        }
      }
    }
  }
}
