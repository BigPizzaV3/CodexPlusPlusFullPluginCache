{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "fcc-office": {
      "type": "streamable-http",
      "url": "https://forevercard.club/fcc-office/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "fcc-chatgpt",
              "tokenEndpointAuthMethod": "none"
            },
            "authorizationUrl": "https://forevercard.club/fcc-office-authorize",
            "tokenUrl": "https://forevercard.club/fcc-office/token",
            "resource": "https://forevercard.club/fcc-office/mcp",
            "baseScopes": [
              "office:read",
              "office:write"
            ],
            "defaultScopes": []
          }
        }
      }
    }
  }
}