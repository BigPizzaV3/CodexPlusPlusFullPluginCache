{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "merchuno": {
      "type": "streamable-http",
      "url": "https://merchuno.co/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "mixed",
            "client": {
              "mode": "dcr"
            },
            "resource": "https://merchuno.co/mcp",
            "baseScopes": [
              "sites:read"
            ],
            "defaultScopes": [
              "sites:read",
              "sites:write",
              "sites:publish",
              "domains:write"
            ],
            "authorizationUrl": "https://merchuno.co/oauth/authorize",
            "tokenUrl": "https://merchuno.co/oauth/token",
            "registrationUrl": "https://merchuno.co/oauth/register",
            "oidcEnabled": false
          }
        }
      }
    }
  }
}
