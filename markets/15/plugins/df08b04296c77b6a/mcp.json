{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "nuru": {
      "type": "streamable-http",
      "url": "https://connect.nuru.tz/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "resource": "https://connect.nuru.tz/mcp",
            "baseScopes": [
              "nuru:read"
            ],
            "defaultScopes": [
              "nuru:read",
              "nuru:guests.write",
              "nuru:events.write",
              "offline_access"
            ]
          }
        }
      }
    }
  }
}
