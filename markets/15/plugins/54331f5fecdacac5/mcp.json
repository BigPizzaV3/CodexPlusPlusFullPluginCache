{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "simple-house-planner": {
      "type": "streamable-http",
      "url": "https://simplehouseplanner.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "mixed",
            "client": { "mode": "cimd" },
            "authorizationUrl": "https://simplehouseplanner.com/api/auth/oauth2/authorize",
            "tokenUrl": "https://simplehouseplanner.com/api/auth/oauth2/token",
            "baseScopes": ["offline_access", "projects:read", "projects:write"]
          }
        }
      }
    }
  }
}
