{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "site-nu-crm-copilot": {
      "type": "streamable-http",
      "url": "https://app.site.nu/mcp/apps",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": ["sitenu.crm.read", "sitenu.crm.write", "sitenu.crm.destructive"]
          }
        }
      }
    }
  }
}
