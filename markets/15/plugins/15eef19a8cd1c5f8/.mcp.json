{
  "mcpServers": {
    "trooprally": {
      "type": "http",
      "url": "https://mcp.trooprally.com/mcp",
      "headers": {},
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "cimd"
            },
            "baseScopes": [
              "rallies.read"
            ],
            "defaultScopes": [
              "rallies.read",
              "rallies.write",
              "offline_access"
            ]
          }
        }
      }
    }
  }
}
