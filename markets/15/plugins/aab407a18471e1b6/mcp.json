{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "chowdeck": {
      "type": "streamable-http",
      "url": "https://api.chowdeck.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "cimd"
            },
            "defaultScopes": [
              "addresses:read",
              "catalog:read",
              "cart:write",
              "checkout:write",
              "orders:read"
            ]
          }
        }
      }
    }
  }
}
