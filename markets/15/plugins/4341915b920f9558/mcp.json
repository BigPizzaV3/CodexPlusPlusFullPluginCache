{
    "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
    "mcpServers": {
        "uptale": {
            "type": "streamable-http",
            "url": "https://mcp.uptale.io/mcp",
            "extensions": {
                "com.openai": {
                    "auth": {
                        "type": "oauth",
                        "client": {
                            "mode": "provided",
                            "clientId": "uptale_chatgpt",
                            "tokenEndpointAuthMethod": "client_secret_basic"
                        },
                        "baseScopes": ["offline_access", "uptale.mcp"]
                    }
                }
            }
        }
    }
}
