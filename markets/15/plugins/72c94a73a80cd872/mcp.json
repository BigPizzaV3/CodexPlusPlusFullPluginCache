{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "phrase": {
      "type": "streamable-http",
      "url": "https://mcp.eu.phrase.com",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "cimd"
            },
            "baseScopes": ["phrase-mcp:read", "phrase-mcp:write", "phrase-mcp:destructive"]
          }
        }
      }
    }
  }
}
