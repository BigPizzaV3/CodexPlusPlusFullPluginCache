{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "exam-now": {
      "type": "streamable-http",
      "url": "https://exam.now/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "mixed",
            "client": { "mode": "cimd" },
            "baseScopes": ["papers", "marking", "progress"]
          }
        }
      }
    }
  }
}
