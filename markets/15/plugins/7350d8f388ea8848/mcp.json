{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "vaultfy": {
      "type": "streamable-http",
      "url": "https://chatbot-mcp-server.vaultfy.ai/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": ["vaultfy.read"]
          }
        }
      }
    }
  }
}
