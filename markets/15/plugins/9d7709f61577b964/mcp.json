{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "sken": {
      "type": "streamable-http",
      "url": "https://sken.io/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": [
              "user:read",
              "jobs:read",
              "jobs:write",
              "checks:read",
              "groups:read",
              "groups:write",
              "job-settings:read",
              "job-settings:write",
              "integrations:read",
              "integrations:write",
              "exports:read",
              "exports:write",
              "imports:read",
              "imports:write",
              "stats:read",
              "proxies:read",
              "proxies:write",
              "scan:write"
            ]
          }
        }
      }
    }
  }
}
