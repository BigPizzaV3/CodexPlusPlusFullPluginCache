{
    "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
    "mcpServers": {
        "biano": {
            "type": "streamable-http",
            "url": "https://mcp.biano.com/mcp",
            "extensions": {
                "com.openai": {
                    "auth": {
                        "type": "oauth",
                        "client": {
                            "mode": "provided",
                            "clientId": "chatgpt",
                            "tokenEndpointAuthMethod": "none"
                        },
                        "baseScopes": ["designs", "favorites"]
                    }
                }
            }
        }
    }
}
