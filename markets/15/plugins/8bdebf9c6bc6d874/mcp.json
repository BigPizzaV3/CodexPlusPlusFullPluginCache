{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "contextnest": {
      "type": "streamable-http",
      "url": "https://nest.promptowl.ai/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "resource": "https://nest.promptowl.ai/mcp",
            "authorizationServerBase": "https://nest.promptowl.ai",
            "authorizationUrl": "https://nest.promptowl.ai/oauth/authorize",
            "tokenUrl": "https://nest.promptowl.ai/oauth/token",
            "registrationUrl": "https://nest.promptowl.ai/oauth/register",
            "baseScopes": [
              "nests:read",
              "nests:write",
              "offline_access"
            ],
            "oidcEnabled": false
          }
        }
      }
    }
  }
}
