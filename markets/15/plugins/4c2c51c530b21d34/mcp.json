{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "saloonpratik": {
      "type": "streamable-http",
      "url": "https://www.terasistem.com/epimaster81/yz_ap_mcp.php",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "authorizationUrl": "https://www.terasistem.com/epimaster81/yz_ap_mcp_oauth.php",
            "tokenUrl": "https://www.terasistem.com/epimaster81/yz_ap_mcp_oauth.php?action=token",
            "registrationUrl": "https://www.terasistem.com/epimaster81/yz_ap_mcp_oauth.php?action=register",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": [
              "read"
            ],
            "defaultScopes": [
              "read",
              "write",
              "offline_access"
            ]
          }
        }
      }
    }
  }
}
