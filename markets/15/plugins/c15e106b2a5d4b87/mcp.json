{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "dividee": {
      "type": "streamable-http",
      "url": "https://dividee.ai/api/mcp/directory",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": ["dividee:ledger"],
            "defaultScopes": ["dividee:ledger", "offline_access"]
          }
        }
      }
    }
  }
}
