{
  "mcpServers": {
    "browserless": {
      "url": "https://mcp.browserless.io/mcp/connector",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": { "mode": "dcr" },
            "registrationUrl": "https://mcp.browserless.io/oauth/register",
            "authorizationUrl": "https://mcp.browserless.io/oauth/authorize",
            "tokenUrl": "https://mcp.browserless.io/oauth/token",
            "authorizationServerBase": "https://mcp.browserless.io",
            "resource": "https://mcp.browserless.io",
            "defaultScopes": ["email"],
            "oidcEnabled": false
          }
        }
      }
    }
  }
}
