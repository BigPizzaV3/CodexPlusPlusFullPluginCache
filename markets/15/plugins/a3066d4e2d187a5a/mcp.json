{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "futoroku": {
      "type": "streamable-http",
      "url": "https://futoroku.app/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": { "mode": "dcr" },
            "baseScopes": ["finance:read"],
            "defaultScopes": ["finance:read", "finance:write"]
          }
        }
      }
    }
  }
}
