{
  "mcpServers": {
    "futoroku": {
      "type": "streamable-http",
      "url": "https://futoroku.app/mcp",
      "headers": {},
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": [
              "finance:read"
            ],
            "defaultScopes": [
              "finance:read",
              "finance:write"
            ]
          }
        }
      }
    }
  }
}
