{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "upsc-grade": {
      "type": "streamable-http",
      "url": "https://api.upscgrade.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "cimd"
            },
            "authorizationUrl": "https://api.upscgrade.com/authorize",
            "tokenUrl": "https://api.upscgrade.com/token",
            "baseScopes": [
              "copies:read",
              "corpus:read",
              "judge",
              "saved:write",
              "practice:write",
              "account:read"
            ]
          }
        }
      }
    }
  }
}
