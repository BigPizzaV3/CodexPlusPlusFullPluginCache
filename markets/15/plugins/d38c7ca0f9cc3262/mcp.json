{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "ivp": {
      "type": "streamable-http",
      "url": "https://api.ivp.ai/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "authorizationUrl": "https://api.ivp.ai/oauth/authorize",
            "tokenUrl": "https://api.ivp.ai/oauth/token",
            "client": {
              "mode": "cimd"
            }
          }
        }
      }
    }
  }
}
