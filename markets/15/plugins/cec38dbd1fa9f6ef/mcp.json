{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "pixoary": {
      "type": "streamable-http",
      "url": "https://pixoary.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": [
              "catalog:read",
              "account:read",
              "assets:read",
              "generation:write"
            ],
            "resource": "https://pixoary.com/mcp"
          }
        }
      }
    }
  }
}
