{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "faircado": {
      "type": "streamable-http",
      "url": "https://agents.faircado.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "faircado-chatgpt-production",
              "tokenEndpointAuthMethod": "none"
            },
            "resource": "https://agents.faircado.com/mcp",
            "baseScopes": [
              "offline_access",
              "account:read",
              "account:write",
              "shopping:write",
              "favorites:read",
              "favorites:write"
            ],
            "defaultScopes": []
          }
        }
      }
    }
  }
}
