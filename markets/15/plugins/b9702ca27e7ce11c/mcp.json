{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "tinyhat-chores": {
      "type": "streamable-http",
      "url": "https://tinyhat.ai/chore/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "mixed",
            "client": {
              "mode": "provided",
              "clientId": "tinyhat-chores-chatgpt-public",
              "tokenEndpointAuthMethod": "none"
            },
            "authorizationServerBase": "https://tinyhat.ai/tinyhat-chores-oauth",
            "resource": "https://tinyhat.ai/chore/mcp",
            "baseScopes": [
              "chores:submit",
              "chores:status"
            ]
          }
        }
      }
    }
  }
}
