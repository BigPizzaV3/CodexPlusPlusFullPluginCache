{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "qrrx-clinic-assistant": {
      "type": "streamable-http",
      "url": "https://assistant.qrrx.io/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "qrrx-chatgpt",
              "tokenEndpointAuthMethod": "none"
            },
            "baseScopes": [
              "connect:status:read",
              "templates:read"
            ]
          }
        }
      }
    }
  }
}
