{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "nutriely": {
      "type": "streamable-http",
      "url": "https://nutriely.com/mcp/nutriely",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "registrationUrl": "https://nutriely.com/oauth/register",
            "authorizationUrl": "https://nutriely.com/oauth/authorize",
            "tokenUrl": "https://nutriely.com/oauth/token",
            "baseScopes": [
              "mcp:use"
            ],
            "defaultScopes": [
              "mcp:use"
            ]
          }
        }
      }
    }
  }
}
