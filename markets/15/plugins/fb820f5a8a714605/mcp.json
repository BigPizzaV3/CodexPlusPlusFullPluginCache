{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "voxlingo": {
      "type": "streamable-http",
      "url": "https://voxlingo.quicksolverhq.com/voxlingo/web/chatgpt/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": { "mode": "cimd" },
            "authorizationServerBase": "https://voxlingo.quicksolverhq.com/voxlingo/web/chatgpt/oauth",
            "authorizationUrl": "https://voxlingo.quicksolverhq.com/voxlingo/web/chatgpt/oauth/authorize",
            "tokenUrl": "https://voxlingo.quicksolverhq.com/voxlingo/web/chatgpt/oauth/token",
            "resource": "https://voxlingo.quicksolverhq.com/voxlingo/web/chatgpt/mcp",
            "baseScopes": ["transcription"]
          }
        }
      }
    }
  }
}
