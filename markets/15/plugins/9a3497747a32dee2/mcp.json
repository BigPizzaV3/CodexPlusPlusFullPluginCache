{
  "mcpServers": {
    "knavigator": {
      "type": "streamable-http",
      "url": "https://knav.avvera.ca/api/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": [
              "knav:query",
              "offline_access"
            ]
          }
        }
      }
    }
  },
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json"
}
