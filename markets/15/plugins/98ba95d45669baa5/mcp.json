{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "landit-production": {
      "type": "streamable-http",
      "url": "https://mcp.justlandit.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": [
              "mcp:connect"
            ],
            "authorizationUrl": "https://www.justlandit.com/oauth/authorize",
            "tokenUrl": "https://www.justlandit.com/oauth/token",
            "authorizationServerBase": "https://www.justlandit.com",
            "registrationUrl": "https://www.justlandit.com/oauth/register",
            "resource": "https://mcp.justlandit.com/mcp"
          }
        }
      }
    }
  }
}
