{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "on-model": {
      "type": "streamable-http",
      "url": "https://mcp.on-model.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "authorizationUrl": "https://mcp.on-model.com/authorize",
            "tokenUrl": "https://mcp.on-model.com/token",
            "registrationUrl": "https://mcp.on-model.com/register"
          }
        }
      }
    }
  }
}
