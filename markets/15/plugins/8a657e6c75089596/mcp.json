{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "nrl-hunter": {
      "type": "streamable-http",
      "url": "https://www.nrlhunter.org/api/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": { "mode": "cimd" },
            "resource": "https://www.nrlhunter.org/api/mcp",
            "baseScopes": ["openid", "offline_access"],
            "defaultScopes": [
              "nrl:member.read",
              "nrl:md.read",
              "nrl:md.finance.read"
            ]
          }
        }
      }
    }
  }
}
