{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "actualset": {
      "type": "streamable-http",
      "url": "https://app.actualset.app/api/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "actualset-chatgpt-private-v1",
              "tokenEndpointAuthMethod": "none"
            },
            "baseScopes": [
              "training:read",
              "workouts:draft"
            ],
            "defaultScopes": [
              "training:read",
              "workouts:draft",
              "workouts:create",
              "workouts:edit",
              "training:notes"
            ]
          }
        }
      }
    }
  }
}
