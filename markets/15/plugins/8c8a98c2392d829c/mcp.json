{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "outside-chair-knowledge": {
      "type": "streamable-http",
      "url": "https://app.outsidechair.com/mcp/know",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "resource": "https://app.outsidechair.com/mcp/know",
            "client": {
              "mode": "cimd"
            },
            "baseScopes": [
              "know:read",
              "know:write"
            ]
          }
        }
      }
    }
  }
}
