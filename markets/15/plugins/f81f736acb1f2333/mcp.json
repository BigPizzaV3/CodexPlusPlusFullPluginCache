{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "chatgpt-plugin": {
      "type": "streamable-http",
      "url": "https://wellnessproject.ai/api/mcp/chatgpt-plugin",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": { "mode": "dcr" },
            "baseScopes": ["mcp"],
            "defaultScopes": ["mcp", "offline_access"]
          }
        }
      }
    }
  }
}
