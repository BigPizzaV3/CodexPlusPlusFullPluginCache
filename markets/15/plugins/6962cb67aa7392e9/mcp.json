{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "clarity4d": {
      "type": "streamable-http",
      "url": "https://mcp2.clarity4d.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "clarity4d-chatgpt",
              "tokenEndpointAuthMethod": "client_secret_basic"
            },
            "authorizationUrl": "https://auth2.clarity4d.com/realms/clarity4d/protocol/openid-connect/auth",
            "tokenUrl": "https://auth2.clarity4d.com/realms/clarity4d/protocol/openid-connect/token",
            "baseScopes": [
              "clarity4d:use"
            ],
            "defaultScopes": [
              "openid",
              "email",
              "offline_access"
            ]
          }
        }
      }
    }
  }
}
