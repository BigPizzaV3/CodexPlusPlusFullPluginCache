{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "qiubo-market": {
      "type": "streamable-http",
      "url": "https://api.qiubo.app/mcp/market",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "mixed",
            "client": {
              "mode": "dcr"
            },
            "defaultScopes": [
              "purchases:read",
              "cart:read",
              "cart:write",
              "favorites:read",
              "favorites:write",
              "addresses:read",
              "offline_access"
            ]
          }
        }
      }
    }
  }
}
