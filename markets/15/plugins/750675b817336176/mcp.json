{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "formstep": {
      "type": "streamable-http",
      "url": "https://api.formstep.io/api/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "cimd"
            },
            "oidcEnabled": false,
            "defaultScopes": ["mcp:read", "mcp:write", "offline_access"]
          }
        }
      }
    }
  }
}
