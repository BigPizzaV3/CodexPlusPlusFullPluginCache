{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "faxend": {
      "type": "streamable-http",
      "url": "https://faxend.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": { "mode": "cimd" },
            "baseScopes": ["fax:read"],
            "defaultScopes": ["fax:read", "fax:send"]
          }
        }
      }
    }
  }
}
