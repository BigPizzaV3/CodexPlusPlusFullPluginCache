{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "aywa": {
      "type": "streamable-http",
      "url": "https://api.aywa.ai/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "cimd"
            },
            "defaultScopes": [
              "agents:read",
              "agents:write",
              "calls:read",
              "connectors:read",
              "campaigns:read",
              "campaigns:write",
              "deployments:write",
              "account:read"
            ]
          }
        }
      }
    }
  }
}
