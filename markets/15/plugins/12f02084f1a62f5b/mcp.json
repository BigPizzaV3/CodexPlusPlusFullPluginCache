{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "louvain": {
      "type": "streamable-http",
      "url": "https://louvain.ai/api/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "defaultScopes": [
              "answer",
              "sources",
              "graph",
              "write",
              "openid",
              "email"
            ]
          }
        }
      }
    }
  }
}