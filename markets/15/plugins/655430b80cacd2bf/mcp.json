{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "koloplus": {
      "type": "streamable-http",
      "url": "https://kolo.plus/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "cimd"
            },
            "baseScopes": [
              "profile:read",
              "posts:read",
              "comments:read",
              "drafts:read",
              "drafts:write",
              "profile:write"
            ]
          }
        }
      }
    }
  }
}
