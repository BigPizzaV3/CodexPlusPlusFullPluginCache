{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "staycurrent": {
      "type": "streamable-http",
      "url": "https://staycurrent.rentals/api/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "cimd"
            },
            "resource": "https://staycurrent.rentals/api/mcp",
            "baseScopes": [
              "openid",
              "email",
              "profile",
              "offline_access",
              "staycurrent:read",
              "staycurrent:write"
            ]
          }
        }
      }
    }
  }
}
