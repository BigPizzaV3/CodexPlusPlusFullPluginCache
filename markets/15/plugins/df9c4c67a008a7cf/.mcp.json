{
  "mcpServers": {
    "donethat": {
      "url": "https://mcp.donethat.ai/",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "defaultScopes": [
              "reports:read",
              "search:read",
              "projects:read"
            ]
          }
        }
      }
    }
  }
}