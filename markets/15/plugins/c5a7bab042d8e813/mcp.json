{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "icepanel": {
      "type": "streamable-http",
      "url": "https://mcp.icepanel.io/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "authorizationUrl": "https://api.icepanel.io/v1/oauth/authorize",
            "tokenUrl": "https://api.icepanel.io/v1/oauth/token",
            "registrationUrl": "https://api.icepanel.io/v1/oauth/register"
          }
        }
      }
    }
  }
}
