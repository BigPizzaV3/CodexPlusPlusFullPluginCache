{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "emblemry": {
      "type": "streamable-http",
      "url": "https://emblemry.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "emblemry-chatgpt-production",
              "tokenEndpointAuthMethod": "client_secret_post"
            },
            "authorizationUrl": "https://emblemry.com/oauth/authorize",
            "tokenUrl": "https://emblemry.com/oauth/token",
            "baseScopes": [
              "profile:read",
              "sets:read",
              "artwork:read",
              "drafts:write",
              "sets:write"
            ]
          }
        }
      }
    }
  }
}
