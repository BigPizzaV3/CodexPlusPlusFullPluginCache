{
	"$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
	"mcpServers": {
		"trimcarbon": {
			"type": "streamable-http",
			"url": "https://mcp.trimcarbon.com/chatgpt",
			"extensions": {
				"com.openai": {
					"auth": {
						"type": "mixed",
						"client": { "mode": "cimd" },
						"authorizationServerBase": "https://trimcarbon.com/api/auth",
						"authorizationUrl": "https://trimcarbon.com/api/auth/oauth2/authorize",
						"tokenUrl": "https://trimcarbon.com/api/auth/oauth2/token",
						"resource": "https://mcp.trimcarbon.com/chatgpt",
						"baseScopes": [
							"offline_access",
							"account:read",
							"offsets:read",
							"api:read"
						]
					}
				}
			}
		}
	}
}
