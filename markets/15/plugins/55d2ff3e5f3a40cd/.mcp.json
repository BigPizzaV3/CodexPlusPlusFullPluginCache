{
  "mcpServers": {
    "postnilo": {
      "type": "streamable-http",
      "url": "https://api.postnilo.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "postnilo-chatgpt-youtube",
              "tokenEndpointAuthMethod": "none"
            },
            "baseScopes": [
              "postnilo:read",
              "postnilo:manage",
              "postnilo:upload",
              "offline_access"
            ]
          }
        }
      }
    }
  }
}
