{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "general-translation": {
      "type": "streamable-http",
      "url": "https://api.gtx.dev/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": [
              "offline_access",
              "org:projects:create",
              "org:context:read",
              "org:context:write",
              "org:assets:write",
              "project:write",
              "project:context:read",
              "project:context:write",
              "project:files:read",
              "project:files:write",
              "project:translations:generate",
              "project:translations:enqueue"
            ]
          }
        }
      }
    }
  }
}
