{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "clou_connect": {
      "type": "streamable-http",
      "url": "https://connect.clou.agency/mcp.php",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": [
              "reports:read"
            ]
          }
        }
      }
    }
  }
}