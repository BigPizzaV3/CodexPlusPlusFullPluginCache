{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "beebyte": {
      "type": "streamable-http",
      "url": "https://mcp.beebyte.se/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": [
              "portal"
            ],
            "defaultScopes": [
              "portal"
            ],
            "authorizationUrl": "https://mcp.beebyte.se/authorize",
            "tokenUrl": "https://mcp.beebyte.se/token",
            "registrationUrl": "https://mcp.beebyte.se/register"
          }
        }
      }
    }
  }
}
