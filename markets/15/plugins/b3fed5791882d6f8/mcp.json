{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "oneiq": {
      "type": "streamable-http",
      "url": "https://mcp.oneiq.com",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "resource": "https://mcp.oneiq.com",
            "baseScopes": [
              "mcp_user",
              "offline_access"
            ],
            "defaultScopes": [
              "mcp_user",
              "offline_access"
            ],
            "client": {
              "mode": "cimd"
            },
            "authorizationUrl": "https://id.oneiq.com/authorize",
            "tokenUrl": "https://id.oneiq.com/token",
            "registrationUrl": "https://id.oneiq.com/register",
            "authorizationServerBase": "https://id.oneiq.com"
          }
        }
      }
    }
  }
}
