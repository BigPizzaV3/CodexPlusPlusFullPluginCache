{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "quiki": {
      "type": "streamable-http",
      "url": "https://mcp.quiki.io/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "cimd"
            },
            "resource": "https://mcp.quiki.io/mcp",
            "baseScopes": ["library.read", "scans.write"]
          }
        }
      }
    }
  }
}
