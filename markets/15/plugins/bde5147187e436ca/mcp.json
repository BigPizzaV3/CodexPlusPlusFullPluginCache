{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "gaia": {
      "type": "streamable-http",
      "url": "https://mcp.gaiasuite.com",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "authorizationUrl": "https://connect.strapi.gaiasuite.com/oauth/authorize",
            "tokenUrl": "https://connect.strapi.gaiasuite.com/oauth/token",
            "registrationUrl": "https://mcp.gaiasuite.com/register",
            "baseScopes": [
              "products",
              "orders"
            ]
          }
        }
      }
    }
  }
}
