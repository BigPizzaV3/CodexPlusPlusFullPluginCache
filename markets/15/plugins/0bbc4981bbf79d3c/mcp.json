{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "przeprogramowani": {
      "type": "streamable-http",
      "url": "https://platforma.przeprogramowani.pl/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "mixed",
            "client": {
              "mode": "dcr"
            },
            "defaultScopes": [
              "progress"
            ]
          }
        }
      }
    }
  }
}
