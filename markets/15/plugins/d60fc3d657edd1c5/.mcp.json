{
  "mcpServers": {
    "zappush": {
      "url": "https://api-dash.zappush.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": [
              "mcp:read",
              "mcp:read_write"
            ]
          }
        }
      }
    }
  }
}