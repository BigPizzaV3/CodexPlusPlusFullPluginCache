{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "dog-trainer": {
      "type": "streamable-http",
      "url": "https://plugins.lilypad.so/plugins/dog-trainer/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "defaultScopes": ["dog-trainer:manage"]
          }
        }
      }
    }
  }
}
