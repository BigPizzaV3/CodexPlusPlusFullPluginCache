{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "ticket-brew": {
      "type": "streamable-http",
      "url": "https://ticketbrew.co.za/api/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "authorizationUrl": "https://ticketbrew.co.za/api/auth/oauth2/authorize",
            "tokenUrl": "https://ticketbrew.co.za/api/auth/oauth2/token",
            "registrationUrl": "https://ticketbrew.co.za/api/auth/oauth2/register",
            "resource": "https://ticketbrew.co.za/api/mcp"
          }
        }
      }
    }
  }
}
