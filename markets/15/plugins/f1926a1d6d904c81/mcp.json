{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "norm": {
      "type": "streamable-http",
      "url": "https://app.norm.place/api/mcp/v2",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "mixed",
            "client": {
              "mode": "dcr"
            },
            "authorizationUrl": "https://app.norm.place/oauth/authorize",
            "tokenUrl": "https://app.norm.place/api/oauth/token",
            "registrationUrl": "https://app.norm.place/api/oauth/register",
            "defaultScopes": [
              "booking"
            ],
            "resource": "https://app.norm.place/api/mcp/v2"
          }
        }
      }
    }
  }
}
