{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "fastcac": {
      "type": "streamable-http",
      "url": "https://api.fastcac.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "mixed",
            "client": { "mode": "dcr" },
            "authorizationServerBase": "https://api.fastcac.com",
            "authorizationUrl": "https://api.fastcac.com/oauth/authorize",
            "tokenUrl": "https://api.fastcac.com/oauth/token",
            "registrationUrl": "https://api.fastcac.com/oauth/register",
            "resource": "https://api.fastcac.com/mcp"
          }
        }
      }
    }
  }
}
