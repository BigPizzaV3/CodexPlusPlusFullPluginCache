{
  "mcpServers": {
    "doany": {
      "url": "https://api.doany.ai/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "resource": "https://api.doany.ai/mcp",
            "baseScopes": [
              "projects:read",
              "projects:create",
              "annie:read",
              "annie:write",
              "apps:read",
              "apps:publish",
              "social:read"
            ],
            "authorizationUrl": "https://api.doany.ai/oauth/authorize",
            "tokenUrl": "https://api.doany.ai/oauth/token",
            "registrationUrl": "https://api.doany.ai/oauth/register"
          }
        }
      }
    }
  }
}
