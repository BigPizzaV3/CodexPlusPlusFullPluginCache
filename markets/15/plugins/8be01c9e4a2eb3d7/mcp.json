{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "patina": {
      "type": "streamable-http",
      "url": "https://api.usepatina.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "resource": "https://api.usepatina.com/mcp",
            "defaultScopes": [
              "market:read",
              "inventory:read",
              "listings:read",
              "sales:read",
              "reports:read",
              "alerts:read",
              "inventory:write",
              "listings:write",
              "sales:write",
              "profile:read",
              "profile:write"
            ]
          }
        }
      }
    }
  }
}
