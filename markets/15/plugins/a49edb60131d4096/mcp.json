{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "spaceos": {
      "type": "streamable-http",
      "url": "https://spaceosapp.com/api/ai/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": [
              "mcp:read"
            ],
            "authorizationUrl": "https://spaceosapp.com/api/ai/oauth/authorize",
            "tokenUrl": "https://spaceosapp.com/api/ai/oauth/token",
            "registrationUrl": "https://spaceosapp.com/api/ai/oauth/register",
            "resource": "https://spaceosapp.com/api/ai/mcp"
          }
        }
      }
    }
  }
}