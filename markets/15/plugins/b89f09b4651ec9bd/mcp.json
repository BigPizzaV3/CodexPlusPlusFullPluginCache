{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "carrell": {
      "type": "streamable-http",
      "url": "https://app.carrell.ai/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": { "mode": "cimd" },
            "baseScopes": ["profile", "email", "offline_access"]
          }
        }
      }
    }
  }
}
