{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "melyx-ai": {
      "type": "streamable-http",
      "url": "https://melyx.ai/api/chatgpt/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "melyx-chatgpt-production",
              "tokenEndpointAuthMethod": "client_secret_post"
            },
            "authorizationUrl": "https://melyx.ai/api/chatgpt/oauth/authorize",
            "tokenUrl": "https://melyx.ai/api/chatgpt/oauth/token",
            "baseScopes": [
              "music:read",
              "music:generate"
            ],
            "defaultScopes": [
              "music:read",
              "music:generate"
            ]
          }
        }
      }
    }
  }
}
