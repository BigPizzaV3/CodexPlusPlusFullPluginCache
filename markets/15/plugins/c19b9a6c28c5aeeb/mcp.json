{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "visalaw-ai": {
      "type": "streamable-http",
      "url": "https://mcp.visalaw.ai/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "visalaw-chatgpt",
              "tokenEndpointAuthMethod": "none"
            },
            "baseScopes": [
              "mcp:law-library:read"
            ]
          }
        }
      }
    }
  }
}