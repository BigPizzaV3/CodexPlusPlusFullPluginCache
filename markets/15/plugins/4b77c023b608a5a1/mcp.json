{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "dataddo": {
      "type": "streamable-http",
      "url": "https://headless.dataddo.com/mcp-data",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "registrationUrl": "https://identity.dataddo.com/v1/oauth/register",
            "authorizationUrl": "https://identity.dataddo.com/v1/oauth/authorize",
            "tokenUrl": "https://identity.dataddo.com/v1/oauth/token",
            "baseScopes": [
              "mcp:read"
            ]
          }
        }
      }
    }
  }
}
