{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "courierapp": {
      "type": "streamable-http",
      "url": "https://app.courierapp.gr/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "mixed",
            "client": {
              "mode": "dcr"
            },
            "resource": "https://app.courierapp.gr/mcp",
            "baseScopes": [
              "shipments:read",
              "booking:prepare"
            ]
          }
        }
      }
    }
  }
}
