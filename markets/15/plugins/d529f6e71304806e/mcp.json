{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "falowen": {
      "type": "streamable-http",
      "url": "https://www.falowen.app/api/chatgpt/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "cimd"
            },
            "authorizationUrl": "https://www.falowen.app/api/chatgpt/authorize",
            "tokenUrl": "https://www.falowen.app/api/chatgpt/token",
            "resource": "https://www.falowen.app/api/chatgpt/mcp",
            "baseScopes": [
              "falowen:read"
            ]
          }
        }
      }
    }
  }
}
