{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "paivauniceo-couture": {
      "type": "streamable-http",
      "url": "https://tools.paivauniceo.workers.dev/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "https://chatgpt.com/oauth/client.json",
              "tokenEndpointAuthMethod": "none"
            },
            "baseScopes": [
              "couture:read"
            ],
            "defaultScopes": [
              "couture:read"
            ]
          }
        }
      }
    }
  }
}
