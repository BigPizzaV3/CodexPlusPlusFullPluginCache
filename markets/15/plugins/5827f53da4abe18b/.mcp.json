{
  "mcpServers": {
    "evertune": {
      "url": "https://mcp.evertune.ai/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "cimd"
            },
            "authorizationUrl": "https://auth.evertune.ai/authorize",
            "tokenUrl": "https://auth.evertune.ai/oauth/token",
            "resource": "https://mcp.evertune.ai/mcp",
            "baseScopes": ["offline_access"],
            "defaultScopes": ["offline_access"],
            "oidcEnabled": false
          }
        }
      }
    }
  }
}
