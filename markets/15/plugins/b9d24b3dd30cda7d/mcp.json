{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "preplab-teacher": {
      "type": "streamable-http",
      "url": "https://api.thepreplab.in/preplab/teacher-mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "preplab-teacher",
              "tokenEndpointAuthMethod": "none"
            },
            "baseScopes": [
              "teacher:read",
              "teacher:write"
            ]
          }
        }
      }
    }
  }
}
