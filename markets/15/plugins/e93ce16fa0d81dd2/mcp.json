{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "eqcheck": {
      "type": "streamable-http",
      "url": "https://eqcheck.app/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": { "mode": "dcr" },
            "authorizationUrl": "https://eqcheck.app/api/mcp/authorize",
            "tokenUrl": "https://eqcheck.app/api/mcp/token",
            "registrationUrl": "https://eqcheck.app/api/mcp/register",
            "resource": "https://eqcheck.app/mcp",
            "baseScopes": ["mcp.full"]
          }
        }
      }
    }
  }
}
