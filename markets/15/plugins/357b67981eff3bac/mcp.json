{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "flow-ai-video": {
      "type": "streamable-http",
      "url": "https://www.flowaivideo.org/api/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": [
              "media:read",
              "media:generate"
            ]
          }
        }
      }
    }
  }
}
