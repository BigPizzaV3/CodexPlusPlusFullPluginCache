{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "hcapp": {
      "type": "streamable-http",
      "url": "https://api.hcapp.ee/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "hcapp-chatgpt",
              "tokenEndpointAuthMethod": "client_secret_basic"
            },
            "authorizationUrl": "https://api.hcapp.ee/mcp/oauth/authorize",
            "tokenUrl": "https://api.hcapp.ee/mcp/oauth/token",
            "baseScopes": [
              "hcapp.read",
              "hcapp.write"
            ]
          }
        }
      }
    }
  }
}
