{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "requstory": {
      "type": "streamable-http",
      "url": "https://requstory.com/mcp/openai",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "mixed",
            "client": {
              "mode": "dcr"
            },
            "registrationUrl": "https://requstory.com/oauth/register",
            "authorizationUrl": "https://requstory.com/oauth/authorize",
            "tokenUrl": "https://requstory.com/oauth/token",
            "authorizationServerBase": "https://requstory.com",
            "resource": "https://requstory.com/mcp/openai",
            "baseScopes": ["mcp"]
          }
        }
      }
    }
  }
}
