{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "wrenreads": {
      "type": "streamable-http",
      "url": "https://mcp.wrenreads.com",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "cimd"
            },
            "authorizationUrl": "https://mcp.wrenreads.com/authorize",
            "tokenUrl": "https://mcp.wrenreads.com/token"
          }
        }
      }
    }
  }
}
