{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "postbert": {
      "type": "streamable-http",
      "url": "https://postbert.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": { "mode": "cimd" },
            "resource": "https://postbert.com/mcp",
            "baseScopes": ["postbert:read", "postbert:write", "offline_access"]
          }
        }
      }
    }
  }
}
