{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "raetos": {
      "type": "streamable-http",
      "url": "https://raetos.com/api/mcp/rv1",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "raetos-chatgpt",
              "tokenEndpointAuthMethod": "client_secret_post"
            },
            "authorizationUrl": "https://raetos.com/api/mcp/oauth/authorize",
            "tokenUrl": "https://raetos.com/api/mcp/oauth/token",
            "baseScopes": ["career:read"]
          }
        }
      }
    }
  }
}
