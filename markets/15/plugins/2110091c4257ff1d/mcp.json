{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "noter-ai": {
      "type": "streamable-http",
      "url": "https://app.noterai.net/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "cimd"
            },
            "defaultScopes": ["notes:read"],
            "resource": "https://app.noterai.net/mcp"
          }
        }
      }
    }
  }
}
