{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "vulkill": {
      "type": "streamable-http",
      "url": "https://app.vulkill.com/api/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "resource": "https://app.vulkill.com/api/mcp",
            "baseScopes": [
              "mcp:read"
            ],
            "defaultScopes": [
              "mcp:read",
              "mcp:scan",
              "offline_access"
            ]
          }
        }
      }
    }
  }
}
