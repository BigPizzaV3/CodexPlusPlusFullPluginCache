{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "script-it": {
      "type": "streamable-http",
      "url": "https://api.script.it/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "cimd"
            },
            "defaultScopes": [
              "account:read",
              "sandbox:run",
              "terminal:connect"
            ]
          }
        }
      }
    }
  }
}
