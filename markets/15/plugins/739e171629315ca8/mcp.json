{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "propbot": {
      "type": "streamable-http",
      "url": "https://www.propbot.com/api/v1/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "cimd"
            },
            "baseScopes": [
              "openid",
              "email",
              "propbot.workspace.read",
              "propbot.properties.read",
              "propbot.properties.write",
              "propbot.properties.publish",
              "propbot.projects.read",
              "propbot.projects.write",
              "propbot.projects.publish",
              "propbot.companies.read",
              "propbot.groups.read",
              "propbot.posts.read",
              "propbot.posts.write",
              "propbot.invoices.read",
              "propbot.invoices.stage",
              "propbot.favorites.read",
              "propbot.notifications.read",
              "propbot.agreements.read"
            ]
          }
        }
      }
    }
  }
}
