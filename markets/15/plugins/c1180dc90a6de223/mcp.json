{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "clerx": {
      "type": "streamable-http",
      "url": "https://mcp.clerx.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "cimd"
            },
            "authorizationUrl": "https://clerk.clerx.ai/oauth/authorize",
            "tokenUrl": "https://clerk.clerx.ai/oauth/token",
            "authorizationServerBase": "https://clerk.clerx.ai",
            "resource": "https://mcp.clerx.com/mcp",
            "baseScopes": [
              "clerx.calls:read",
              "clerx.chats:read",
              "email",
              "offline_access"
            ]
          }
        }
      }
    }
  }
}
