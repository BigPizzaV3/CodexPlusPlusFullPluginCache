{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "rados": {
      "type": "streamable-http",
      "url": "https://www.rados.app/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "cimd"
            },
            "baseScopes": [
              "altura.study:read",
              "altura.curriculum:read"
            ]
          }
        }
      }
    }
  }
}
