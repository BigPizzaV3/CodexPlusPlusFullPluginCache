{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "releventful": {
      "type": "streamable-http",
      "url": "https://app.releventful.com/api/p/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "resource": "https://app.releventful.com/api/p/mcp",
            "baseScopes": [
              "leads:read"
            ],
            "defaultScopes": [
              "leads:read",
              "leads:write",
              "messages:read",
              "messages:write",
              "tasks:write",
              "documents:write"
            ]
          }
        }
      }
    }
  }
}
