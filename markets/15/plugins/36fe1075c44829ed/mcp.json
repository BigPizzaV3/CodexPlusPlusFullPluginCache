{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "goodset": {
      "type": "streamable-http",
      "url": "https://mcp.goodset.app/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": [
              "openid",
              "email",
              "workouts:read",
              "workouts:write",
              "nutrition:read",
              "nutrition:write"
            ],
            "oidcEnabled": true
          }
        }
      }
    }
  }
}
