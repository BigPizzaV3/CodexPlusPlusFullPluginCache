{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "housemaster": {
      "type": "streamable-http",
      "url": "https://api.housemaster.gr/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "mixed",
            "client": { "mode": "dcr" },
            "defaultScopes": ["openid", "email", "profile"]
          }
        }
      }
    }
  }
}
