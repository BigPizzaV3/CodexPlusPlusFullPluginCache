{
  "components": [
    {
      "type": "Lib_shadcn_ToggleGroup",
      "name": "Lib_shadcn_ToggleGroup",
      "description": "Toggle Group from the shadcn UI component library. Sizes to its content in the app (Dynamic height on).",
      "defaultSize": {
        "width": 12,
        "height": 40
      },
      "properties": [
        {
          "key": "options",
          "label": "Options",
          "valueType": "array",
          "default": "{{[{\"label\":\"Day\",\"value\":\"day\"},{\"label\":\"Week\",\"value\":\"week\"},{\"label\":\"Month\",\"value\":\"month\"},{\"label\":\"Year\",\"value\":\"year\"}]}}",
          "description": "Array of { label, value } objects, or plain strings."
        },
        {
          "key": "value",
          "label": "Default value",
          "valueType": "string",
          "default": "week",
          "description": "Selected value when \"Allow multiple\" is off."
        },
        {
          "key": "multiple",
          "label": "Allow multiple",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "values",
          "label": "Default values",
          "valueType": "array",
          "default": "{{[]}}",
          "description": "Selected values when \"Allow multiple\" is on."
        },
        {
          "key": "variant",
          "label": "Variant",
          "valueType": "string",
          "default": "outline",
          "allowedValues": [
            "outline",
            "default"
          ]
        },
        {
          "key": "disabled",
          "label": "Disable",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "visibility",
          "label": "Visibility",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "loadingState",
          "label": "Loading state",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "disabledState",
          "label": "Disable",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "dynamicHeight",
          "label": "Dynamic height",
          "valueType": "boolean",
          "default": "{{true}}"
        }
      ],
      "styles": [
        {
          "key": "backgroundColor",
          "label": "Background",
          "valueType": "string"
        },
        {
          "key": "selectedColor",
          "label": "Selected",
          "valueType": "string"
        },
        {
          "key": "textColor",
          "label": "Text",
          "valueType": "string"
        },
        {
          "key": "borderColor",
          "label": "Border",
          "valueType": "string"
        },
        {
          "key": "borderRadius",
          "label": "Border radius",
          "valueType": "number"
        },
        {
          "key": "boxShadow",
          "label": "Box shadow",
          "valueType": "string"
        }
      ],
      "events": [
        {
          "id": "onChange",
          "label": "On change"
        }
      ],
      "actions": [
        {
          "handle": "setValue",
          "displayName": "Select option",
          "params": [
            {
              "handle": "value",
              "displayName": "Value"
            }
          ]
        },
        {
          "handle": "setVisibility",
          "displayName": "Set visibility",
          "params": [
            {
              "handle": "visibility",
              "displayName": "Value",
              "defaultValue": "{{false}}"
            }
          ]
        },
        {
          "handle": "setLoading",
          "displayName": "Set loading",
          "params": [
            {
              "handle": "loading",
              "displayName": "Value",
              "defaultValue": "{{false}}"
            }
          ]
        },
        {
          "handle": "setDisable",
          "displayName": "Set disable",
          "params": [
            {
              "handle": "disable",
              "displayName": "Value",
              "defaultValue": "{{false}}"
            }
          ]
        }
      ],
      "exposedVariables": [
        {
          "name": "options",
          "default": [
            {
              "label": "Day",
              "value": "day"
            },
            {
              "label": "Week",
              "value": "week"
            },
            {
              "label": "Month",
              "value": "month"
            },
            {
              "label": "Year",
              "value": "year"
            }
          ]
        },
        {
          "name": "value",
          "default": "week"
        },
        {
          "name": "multiple",
          "default": false
        },
        {
          "name": "values",
          "default": []
        },
        {
          "name": "variant",
          "default": "outline"
        },
        {
          "name": "disabled",
          "default": false
        },
        {
          "name": "isVisible",
          "default": true
        },
        {
          "name": "isLoading",
          "default": false
        },
        {
          "name": "isDisabled",
          "default": false
        }
      ]
    }
  ],
  "unknown_types": []
}
