{
  "components": [
    {
      "type": "ShadFileUpload",
      "name": "ShadFileUpload",
      "description": "File upload: a dashed dropzone (drag and drop or click to browse) with a file list. accept is a MIME or extension list like 'image/*,.pdf'; maxSize and minSize in bytes. Exposes file [{ name, type, size, content (text), base64Data, dataURL, parsedData, parseError }] like the native File picker, with parseError naming why parsing failed ('' when it did not). Height: about 160px for the dropzone, 180px with a label; the list adds about 66px per file (dynamic height)",
      "defaultSize": {
        "width": 12,
        "height": 180
      },
      "properties": [
        {
          "key": "label",
          "label": "Label",
          "valueType": "string",
          "default": "Attachments"
        },
        {
          "key": "description",
          "label": "Help text",
          "valueType": "string",
          "default": ""
        },
        {
          "key": "title",
          "label": "Title",
          "valueType": "string",
          "default": "Drag & drop files here"
        },
        {
          "key": "hint",
          "label": "Hint (empty: accepted types and size)",
          "valueType": "string",
          "default": ""
        },
        {
          "key": "accept",
          "label": "Accept file types",
          "valueType": "string",
          "default": "image/*,application/pdf"
        },
        {
          "key": "multiple",
          "label": "Allow multiple files",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "maxFiles",
          "label": "Max files",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ],
          "default": "{{5}}"
        },
        {
          "key": "maxSize",
          "label": "Max size (bytes, 0 for no limit)",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ],
          "default": "{{5242880}}"
        },
        {
          "key": "minSize",
          "label": "Min size (bytes)",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ],
          "default": "{{0}}"
        },
        {
          "key": "showPreview",
          "label": "Show image thumbnails",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "parseContent",
          "label": "Parse content (CSV, TSV, Excel, JSON)",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "parseFileType",
          "label": "Parse as",
          "valueType": "string",
          "default": "auto-detect",
          "allowedValues": [
            "auto-detect",
            "csv",
            "tsv",
            "vnd.ms-excel",
            "vnd.openxmlformats-officedocument.spreadsheetml.sheet",
            "json"
          ]
        },
        {
          "key": "delimiter",
          "label": "CSV delimiter",
          "valueType": "string",
          "default": ","
        },
        {
          "key": "dynamicHeight",
          "label": "Dynamic height",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "loadingState",
          "label": "Loading state",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "visibility",
          "label": "Visibility",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "collapseWhenHidden",
          "label": "Collapse when hidden",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "disabledState",
          "label": "Disable",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "tooltipFormat",
          "label": "Tooltip",
          "default": "plainText",
          "allowedValues": [
            "plainText",
            "markdown",
            "html"
          ]
        },
        {
          "key": "tooltip",
          "label": "Tooltip",
          "valueType": "string",
          "default": ""
        }
      ],
      "styles": [
        {
          "key": "boxShadow",
          "label": "Box shadow",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ],
          "default": "0px 0px 0px 0px #00000040"
        },
        {
          "key": "labelColor",
          "label": "Label color",
          "valueType": "string"
        },
        {
          "key": "helpTextColor",
          "label": "Help text color",
          "valueType": "string"
        },
        {
          "key": "dropzoneBackgroundColor",
          "label": "Dropzone background",
          "valueType": "string"
        },
        {
          "key": "dropzoneBorderColor",
          "label": "Dropzone border color",
          "valueType": "string"
        },
        {
          "key": "iconColor",
          "label": "Upload icon color",
          "valueType": "string"
        },
        {
          "key": "iconBackgroundColor",
          "label": "Upload icon background",
          "valueType": "string"
        },
        {
          "key": "titleColor",
          "label": "Title color",
          "valueType": "string"
        },
        {
          "key": "hintColor",
          "label": "Hint color",
          "valueType": "string"
        },
        {
          "key": "accentColor",
          "label": "Accent (drag over, browse link)",
          "valueType": "string"
        },
        {
          "key": "fileItemBackgroundColor",
          "label": "File row background",
          "valueType": "string"
        },
        {
          "key": "fileItemBorderColor",
          "label": "File row border color",
          "valueType": "string"
        },
        {
          "key": "errorColor",
          "label": "Error color",
          "valueType": "string"
        },
        {
          "key": "borderRadius",
          "label": "Radius",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ]
        },
        {
          "key": "cssClass",
          "label": "CSS class",
          "default": ""
        }
      ],
      "events": [
        {
          "id": "onFileSelected",
          "label": "On file selected"
        },
        {
          "id": "onFileDeselected",
          "label": "On file deselected"
        },
        {
          "id": "onFileLoaded",
          "label": "On file loaded"
        }
      ],
      "actions": [
        {
          "handle": "clearFiles",
          "displayName": "Clear files"
        },
        {
          "handle": "setFileName",
          "displayName": "Set file name",
          "params": [
            {
              "handle": "indexOrUpdates",
              "displayName": "File index (or [{ index, newFileName }])",
              "defaultValue": "{{0}}"
            },
            {
              "handle": "newNameIfSingle",
              "displayName": "New name",
              "defaultValue": ""
            }
          ]
        },
        {
          "handle": "setVisibility",
          "displayName": "Set visibility",
          "params": [
            {
              "handle": "value",
              "displayName": "Value",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setDisable",
          "displayName": "Set disable",
          "params": [
            {
              "handle": "value",
              "displayName": "Value",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setLoading",
          "displayName": "Set loading",
          "params": [
            {
              "handle": "value",
              "displayName": "Value",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        }
      ],
      "exposedVariables": [
        {
          "name": "isVisible",
          "default": true
        },
        {
          "name": "isLoading",
          "default": false
        },
        {
          "name": "isDisabled",
          "default": false
        },
        {
          "name": "isValid",
          "default": true
        },
        {
          "name": "isMandatory",
          "default": false
        },
        {
          "name": "file",
          "default": []
        },
        {
          "name": "fileSize",
          "default": 0
        },
        {
          "name": "isParsing",
          "default": false
        },
        {
          "name": "label",
          "default": ""
        }
      ],
      "authoringHints": {
        "styles": "Every style falls back to the app theme, so set only what the design needs to blend in (its accent, surfaces, borders and text colours), taking colours from the app theme or brand, never the defaults of another product. Radii and sizes are px. Styles are the way to restyle a pack widget: a cssClass only takes effect with workspace Custom styles, and Tailwind class names the pack does not already use are not compiled, so do not rely on either; for a one-off visual a style cannot express, use an Html component. Bind loadingState to the query's isLoading (each widget draws a skeleton or spinner in its own shape); tooltip shows on hover.",
        "usage": "file [{ name, type, size, content (text), base64Data, dataURL, parsedData? }]: upload base64Data. About 160px tall (180 with a label) plus about 66px per listed file."
      }
    }
  ],
  "unknown_types": []
}
