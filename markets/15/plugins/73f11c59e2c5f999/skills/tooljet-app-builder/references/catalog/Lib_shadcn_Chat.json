{
  "components": [
    {
      "type": "Lib_shadcn_Chat",
      "name": "Lib_shadcn_Chat",
      "description": "Chat from the shadcn UI component library. Drawn at the height you give it.",
      "defaultSize": {
        "width": 15,
        "height": 480
      },
      "properties": [
        {
          "key": "chatTitle",
          "label": "Title",
          "valueType": "string",
          "default": "Assistant"
        },
        {
          "key": "history",
          "label": "Initial history",
          "valueType": "array",
          "default": "{{[{\"role\":\"assistant\",\"message\":\"Hi! How can I help you today?\",\"timestamp\":\"2026-10-22T09:00:00.000Z\"}]}}",
          "description": "Array of { role: \"user\" | \"assistant\", message, timestamp }."
        },
        {
          "key": "userName",
          "label": "User name",
          "valueType": "string",
          "default": "You"
        },
        {
          "key": "respondentName",
          "label": "Assistant name",
          "valueType": "string",
          "default": "Assistant"
        },
        {
          "key": "placeholder",
          "label": "Placeholder",
          "valueType": "string",
          "default": "Ask me anything!"
        },
        {
          "key": "emptyText",
          "label": "Empty text",
          "valueType": "string",
          "default": "Start the conversation"
        },
        {
          "key": "isInputDisabled",
          "label": "Disable input",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "isResponseLoading",
          "label": "Response loading",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "enableClearHistoryButton",
          "label": "Clear button",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "enableDownloadHistoryButton",
          "label": "Download button",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "showAvatars",
          "label": "Avatars",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "showTimestamps",
          "label": "Timestamps",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "lastMessage",
          "label": "Last Message",
          "valueType": "string",
          "default": ""
        },
        {
          "key": "lastResponse",
          "label": "Last Response",
          "valueType": "string",
          "default": ""
        },
        {
          "key": "visibility",
          "label": "Visibility",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "loadingState",
          "label": "Loading state",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "disabledState",
          "label": "Disable",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "dynamicHeight",
          "label": "Dynamic height",
          "valueType": "boolean",
          "default": "{{false}}"
        }
      ],
      "styles": [
        {
          "key": "accentColor",
          "label": "Your messages",
          "valueType": "string"
        },
        {
          "key": "responseBubbleColor",
          "label": "Assistant messages",
          "valueType": "string"
        },
        {
          "key": "containerBackgroundColor",
          "label": "Background",
          "valueType": "string"
        },
        {
          "key": "borderRadius",
          "label": "Border radius",
          "valueType": "number"
        },
        {
          "key": "boxShadow",
          "label": "Box shadow",
          "valueType": "string"
        }
      ],
      "events": [
        {
          "id": "onMessageSent",
          "label": "On message sent"
        },
        {
          "id": "onClearHistory",
          "label": "On clear history"
        }
      ],
      "actions": [
        {
          "handle": "sendMessage",
          "displayName": "Send message",
          "params": [
            {
              "handle": "message",
              "displayName": "Message"
            }
          ]
        },
        {
          "handle": "appendHistory",
          "displayName": "Append reply",
          "params": [
            {
              "handle": "message",
              "displayName": "Message"
            },
            {
              "handle": "role",
              "displayName": "Role (assistant/user)"
            }
          ]
        },
        {
          "handle": "setHistory",
          "displayName": "Set history",
          "params": [
            {
              "handle": "history",
              "displayName": "History (array)"
            }
          ]
        },
        {
          "handle": "clearHistory",
          "displayName": "Clear history"
        },
        {
          "handle": "setResponseLoading",
          "displayName": "Set response loading",
          "params": [
            {
              "handle": "loading",
              "displayName": "Loading"
            }
          ]
        },
        {
          "handle": "setInputDisable",
          "displayName": "Disable input",
          "params": [
            {
              "handle": "disabled",
              "displayName": "Disabled"
            }
          ]
        },
        {
          "handle": "setError",
          "displayName": "Show error",
          "params": [
            {
              "handle": "error",
              "displayName": "Message"
            }
          ]
        },
        {
          "handle": "downloadChat",
          "displayName": "Download chat"
        },
        {
          "handle": "setVisibility",
          "displayName": "Set visibility",
          "params": [
            {
              "handle": "visibility",
              "displayName": "Value",
              "defaultValue": "{{false}}"
            }
          ]
        },
        {
          "handle": "setLoading",
          "displayName": "Set loading",
          "params": [
            {
              "handle": "loading",
              "displayName": "Value",
              "defaultValue": "{{false}}"
            }
          ]
        },
        {
          "handle": "setDisable",
          "displayName": "Set disable",
          "params": [
            {
              "handle": "disable",
              "displayName": "Value",
              "defaultValue": "{{false}}"
            }
          ]
        }
      ],
      "exposedVariables": [
        {
          "name": "chatTitle",
          "default": "Assistant"
        },
        {
          "name": "history",
          "default": [
            {
              "role": "assistant",
              "message": "Hi! How can I help you today?",
              "timestamp": "2026-10-22T09:00:00.000Z"
            }
          ]
        },
        {
          "name": "userName",
          "default": "You"
        },
        {
          "name": "respondentName",
          "default": "Assistant"
        },
        {
          "name": "placeholder",
          "default": "Ask me anything!"
        },
        {
          "name": "emptyText",
          "default": "Start the conversation"
        },
        {
          "name": "isInputDisabled",
          "default": false
        },
        {
          "name": "isResponseLoading",
          "default": false
        },
        {
          "name": "enableClearHistoryButton",
          "default": true
        },
        {
          "name": "enableDownloadHistoryButton",
          "default": true
        },
        {
          "name": "showAvatars",
          "default": true
        },
        {
          "name": "showTimestamps",
          "default": true
        },
        {
          "name": "lastMessage",
          "default": ""
        },
        {
          "name": "lastResponse",
          "default": ""
        },
        {
          "name": "isVisible",
          "default": true
        },
        {
          "name": "isLoading",
          "default": false
        },
        {
          "name": "isDisabled",
          "default": false
        }
      ]
    }
  ],
  "unknown_types": []
}
