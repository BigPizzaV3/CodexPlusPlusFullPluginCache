{
  "components": [
    {
      "type": "Lib_shadcn_Icon",
      "name": "Lib_shadcn_Icon",
      "description": "Icon from the shadcn UI component library. Drawn at the height you give it.",
      "defaultSize": {
        "width": 3,
        "height": 40
      },
      "properties": [
        {
          "key": "icon",
          "label": "Icon",
          "valueType": "string",
          "default": "trending-up",
          "description": "lucide name, e.g. trending-up, bell, users."
        },
        {
          "key": "size",
          "label": "Size",
          "valueType": "number",
          "default": "{{20}}"
        },
        {
          "key": "strokeWidth",
          "label": "Stroke width",
          "valueType": "number",
          "default": "{{2}}"
        },
        {
          "key": "tone",
          "label": "Tone",
          "valueType": "string",
          "default": "primary",
          "allowedValues": [
            "primary",
            "success",
            "warning",
            "danger",
            "muted"
          ]
        },
        {
          "key": "chip",
          "label": "Background",
          "valueType": "string",
          "default": "square",
          "allowedValues": [
            "none",
            "square",
            "circle"
          ]
        },
        {
          "key": "visibility",
          "label": "Visibility",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "loadingState",
          "label": "Loading state",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "disabledState",
          "label": "Disable",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "dynamicHeight",
          "label": "Dynamic height",
          "valueType": "boolean",
          "default": "{{false}}"
        }
      ],
      "styles": [
        {
          "key": "iconColor",
          "label": "Icon color",
          "valueType": "string"
        },
        {
          "key": "alignment",
          "label": "Alignment",
          "valueType": "string"
        },
        {
          "key": "boxShadow",
          "label": "Box shadow",
          "valueType": "string"
        }
      ],
      "events": [
        {
          "id": "onClick",
          "label": "On click"
        },
        {
          "id": "onHover",
          "label": "On hover"
        }
      ],
      "actions": [
        {
          "handle": "click",
          "displayName": "Click"
        },
        {
          "handle": "setVisibility",
          "displayName": "Set visibility",
          "params": [
            {
              "handle": "visibility",
              "displayName": "Value",
              "defaultValue": "{{false}}"
            }
          ]
        },
        {
          "handle": "setLoading",
          "displayName": "Set loading",
          "params": [
            {
              "handle": "loading",
              "displayName": "Value",
              "defaultValue": "{{false}}"
            }
          ]
        },
        {
          "handle": "setDisable",
          "displayName": "Set disable",
          "params": [
            {
              "handle": "disable",
              "displayName": "Value",
              "defaultValue": "{{false}}"
            }
          ]
        }
      ],
      "exposedVariables": [
        {
          "name": "icon",
          "default": "trending-up"
        },
        {
          "name": "size",
          "default": 20
        },
        {
          "name": "strokeWidth",
          "default": 2
        },
        {
          "name": "tone",
          "default": "primary"
        },
        {
          "name": "chip",
          "default": "square"
        },
        {
          "name": "isVisible",
          "default": true
        },
        {
          "name": "isLoading",
          "default": false
        },
        {
          "name": "isDisabled",
          "default": false
        }
      ]
    }
  ],
  "unknown_types": []
}
