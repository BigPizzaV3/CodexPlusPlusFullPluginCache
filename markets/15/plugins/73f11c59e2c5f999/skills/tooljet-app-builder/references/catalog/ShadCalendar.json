{
  "components": [
    {
      "type": "ShadCalendar",
      "name": "ShadCalendar",
      "description": "Inline month calendar. mode single, multiple or range; defaultValue 'YYYY-MM-DD' (a list for multiple, [start, end] for range); markers [{ date, label?, color? }] draw dots under days (label on hover); minDate, maxDate, disabledDates, disabledDays ([0, 6] = weekends). Exposed value, selectedDate, selectedDates, startDate, endDate, visibleMonth ('YYYY-MM'), visibleStart, visibleEnd; events onSelect, onMonthChanged. One month is about 300px tall and 250px wide (fullWidth stretches the days)",
      "defaultSize": {
        "width": 10,
        "height": 300
      },
      "properties": [
        {
          "key": "mode",
          "label": "Selection mode",
          "valueType": "string",
          "default": "single",
          "allowedValues": [
            "single",
            "multiple",
            "range"
          ]
        },
        {
          "key": "defaultValue",
          "label": "Default value (YYYY-MM-DD, a list, or [start, end])",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number",
            "boolean",
            "array",
            "object"
          ],
          "default": ""
        },
        {
          "key": "defaultMonth",
          "label": "Month to show (date; default: the selection or today)",
          "valueType": "string",
          "default": ""
        },
        {
          "key": "markers",
          "label": "Markers",
          "valueType": "array",
          "default": "{{[{ date: moment().format('YYYY-MM-DD'), label: 'Stand-up' }, { date: moment().add(3, 'days').format('YYYY-MM-DD'), label: 'Release', color: '#16a34a' }, {…"
        },
        {
          "key": "minDate",
          "label": "Min date",
          "valueType": "string",
          "default": ""
        },
        {
          "key": "maxDate",
          "label": "Max date",
          "valueType": "string",
          "default": ""
        },
        {
          "key": "disabledDates",
          "label": "Disabled dates",
          "valueType": "array",
          "default": "{{[]}}"
        },
        {
          "key": "disabledDays",
          "label": "Disabled weekdays (0 = Sunday)",
          "valueType": "array",
          "default": "{{[]}}"
        },
        {
          "key": "weekStartsOn",
          "label": "Week starts on",
          "valueType": "string",
          "default": "sunday",
          "allowedValues": [
            "sunday",
            "monday"
          ]
        },
        {
          "key": "numberOfMonths",
          "label": "Number of months",
          "valueType": "number",
          "default": "{{1}}"
        },
        {
          "key": "showOutsideDays",
          "label": "Show outside days",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "fixedWeeks",
          "label": "Always six weeks",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "fullWidth",
          "label": "Full width",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "showBorder",
          "label": "Show border",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "dynamicHeight",
          "label": "Dynamic height",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "loadingState",
          "label": "Loading state",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "loadingIndicator",
          "label": "Loading look",
          "valueType": "string",
          "default": "spinner",
          "allowedValues": [
            "spinner",
            "skeleton"
          ]
        },
        {
          "key": "visibility",
          "label": "Visibility",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "collapseWhenHidden",
          "label": "Collapse when hidden",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "disabledState",
          "label": "Disable",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "tooltipFormat",
          "label": "Tooltip",
          "default": "plainText",
          "allowedValues": [
            "plainText",
            "markdown",
            "html"
          ]
        },
        {
          "key": "tooltip",
          "label": "Tooltip",
          "valueType": "string",
          "default": ""
        }
      ],
      "styles": [
        {
          "key": "boxShadow",
          "label": "Box shadow",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ],
          "default": "0px 0px 0px 0px #00000040"
        },
        {
          "key": "backgroundColor",
          "label": "Background",
          "valueType": "string"
        },
        {
          "key": "borderColor",
          "label": "Border color",
          "valueType": "string"
        },
        {
          "key": "textColor",
          "label": "Day text color",
          "valueType": "string"
        },
        {
          "key": "headerTextColor",
          "label": "Month title color",
          "valueType": "string"
        },
        {
          "key": "mutedTextColor",
          "label": "Weekday and outside day color",
          "valueType": "string"
        },
        {
          "key": "accentColor",
          "label": "Selected day background",
          "valueType": "string"
        },
        {
          "key": "selectedTextColor",
          "label": "Selected day text color",
          "valueType": "string"
        },
        {
          "key": "rangeBackgroundColor",
          "label": "Range background",
          "valueType": "string"
        },
        {
          "key": "todayBackgroundColor",
          "label": "Today background",
          "valueType": "string"
        },
        {
          "key": "hoverBackgroundColor",
          "label": "Day hover background",
          "valueType": "string"
        },
        {
          "key": "markerColor",
          "label": "Marker dot color",
          "valueType": "string"
        },
        {
          "key": "borderRadius",
          "label": "Calendar radius",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ]
        },
        {
          "key": "cellSize",
          "label": "Day size (px)",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ]
        },
        {
          "key": "cssClass",
          "label": "CSS class",
          "default": ""
        }
      ],
      "events": [
        {
          "id": "onSelect",
          "label": "On select"
        },
        {
          "id": "onMonthChanged",
          "label": "On month changed"
        }
      ],
      "actions": [
        {
          "handle": "selectDate",
          "displayName": "Select date",
          "params": [
            {
              "handle": "date",
              "displayName": "Date (YYYY-MM-DD)",
              "defaultValue": ""
            },
            {
              "handle": "endDate",
              "displayName": "End date (range)",
              "defaultValue": ""
            }
          ]
        },
        {
          "handle": "clear",
          "displayName": "Clear"
        },
        {
          "handle": "setMonth",
          "displayName": "Show month",
          "params": [
            {
              "handle": "date",
              "displayName": "Date in the month",
              "defaultValue": ""
            }
          ]
        },
        {
          "handle": "setVisibility",
          "displayName": "Set visibility",
          "params": [
            {
              "handle": "value",
              "displayName": "Value",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setDisable",
          "displayName": "Set disable",
          "params": [
            {
              "handle": "value",
              "displayName": "Value",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setLoading",
          "displayName": "Set loading",
          "params": [
            {
              "handle": "value",
              "displayName": "Value",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        }
      ],
      "exposedVariables": [
        {
          "name": "isVisible",
          "default": true
        },
        {
          "name": "isLoading",
          "default": false
        },
        {
          "name": "isDisabled",
          "default": false
        },
        {
          "name": "value",
          "default": ""
        },
        {
          "name": "selectedDate",
          "default": ""
        },
        {
          "name": "selectedDates",
          "default": []
        },
        {
          "name": "startDate",
          "default": ""
        },
        {
          "name": "endDate",
          "default": ""
        },
        {
          "name": "visibleMonth",
          "default": ""
        },
        {
          "name": "visibleStart",
          "default": ""
        },
        {
          "name": "visibleEnd",
          "default": ""
        }
      ],
      "authoringHints": {
        "styles": "Every style falls back to the app theme, so set only what the design needs to blend in (its accent, surfaces, borders and text colours), taking colours from the app theme or brand, never the defaults of another product. Radii and sizes are px. Styles are the way to restyle a pack widget: a cssClass only takes effect with workspace Custom styles, and Tailwind class names the pack does not already use are not compiled, so do not rely on either; for a one-off visual a style cannot express, use an Html component. Bind loadingState to the query's isLoading (each widget draws a skeleton or spinner in its own shape); tooltip shows on hover.",
        "usage": "An inline month (about 300x250 per month); markers [{ date: 'YYYY-MM-DD', label, color }]; query the visible month with visibleStart/visibleEnd."
      }
    }
  ],
  "unknown_types": []
}
