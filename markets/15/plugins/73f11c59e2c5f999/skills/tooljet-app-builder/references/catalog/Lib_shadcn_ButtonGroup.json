{
  "components": [
    {
      "type": "Lib_shadcn_ButtonGroup",
      "name": "Lib_shadcn_ButtonGroup",
      "description": "Button Group from the shadcn UI component library. Sizes to its content in the app (Dynamic height on).",
      "defaultSize": {
        "width": 10,
        "height": 40
      },
      "properties": [
        {
          "key": "label",
          "label": "Label",
          "valueType": "string",
          "default": ""
        },
        {
          "key": "description",
          "label": "Help text",
          "valueType": "string",
          "default": ""
        },
        {
          "key": "buttons",
          "label": "Buttons",
          "valueType": "array",
          "default": "{{[{\"label\":\"Day\",\"value\":\"day\"},{\"label\":\"Week\",\"value\":\"week\"},{\"label\":\"Month\",\"value\":\"month\"}]}}",
          "description": "Array of { label, value } objects, or plain strings."
        },
        {
          "key": "mode",
          "label": "Selection",
          "valueType": "string",
          "default": "single",
          "allowedValues": [
            "single",
            "multiple",
            "none"
          ]
        },
        {
          "key": "value",
          "label": "Default value (single)",
          "valueType": "string",
          "default": "week"
        },
        {
          "key": "selected",
          "label": "Default values (multiple)",
          "valueType": "array",
          "default": "{{[]}}"
        },
        {
          "key": "allowDeselect",
          "label": "Allow deselect",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "variant",
          "label": "Variant",
          "valueType": "string",
          "default": "outline",
          "allowedValues": [
            "outline",
            "default",
            "secondary",
            "ghost"
          ]
        },
        {
          "key": "size",
          "label": "Size",
          "valueType": "string",
          "default": "default",
          "allowedValues": [
            "sm",
            "default",
            "lg"
          ]
        },
        {
          "key": "orientation",
          "label": "Orientation",
          "valueType": "string",
          "default": "horizontal",
          "allowedValues": [
            "horizontal",
            "vertical"
          ]
        },
        {
          "key": "fullWidth",
          "label": "Full width",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "disabled",
          "label": "Disable",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "lastClicked",
          "label": "Last Clicked",
          "valueType": "string",
          "default": ""
        },
        {
          "key": "visibility",
          "label": "Visibility",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "loadingState",
          "label": "Loading state",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "disabledState",
          "label": "Disable",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "dynamicHeight",
          "label": "Dynamic height",
          "valueType": "boolean",
          "default": "{{true}}"
        }
      ],
      "styles": [
        {
          "key": "selectedBackgroundColor",
          "label": "Selected background",
          "valueType": "string"
        },
        {
          "key": "selectedTextColor",
          "label": "Selected text",
          "valueType": "string"
        },
        {
          "key": "borderColor",
          "label": "Border",
          "valueType": "string"
        },
        {
          "key": "borderRadius",
          "label": "Border radius",
          "valueType": "number"
        },
        {
          "key": "boxShadow",
          "label": "Box shadow",
          "valueType": "string"
        }
      ],
      "events": [
        {
          "id": "onClick",
          "label": "On click"
        },
        {
          "id": "onChange",
          "label": "On change"
        }
      ],
      "actions": [
        {
          "handle": "setSelected",
          "displayName": "Select",
          "params": [
            {
              "handle": "value",
              "displayName": "Value (or array)"
            }
          ]
        },
        {
          "handle": "clear",
          "displayName": "Clear"
        },
        {
          "handle": "setVisibility",
          "displayName": "Set visibility",
          "params": [
            {
              "handle": "visibility",
              "displayName": "Value",
              "defaultValue": "{{false}}"
            }
          ]
        },
        {
          "handle": "setLoading",
          "displayName": "Set loading",
          "params": [
            {
              "handle": "loading",
              "displayName": "Value",
              "defaultValue": "{{false}}"
            }
          ]
        },
        {
          "handle": "setDisable",
          "displayName": "Set disable",
          "params": [
            {
              "handle": "disable",
              "displayName": "Value",
              "defaultValue": "{{false}}"
            }
          ]
        }
      ],
      "exposedVariables": [
        {
          "name": "label",
          "default": ""
        },
        {
          "name": "description",
          "default": ""
        },
        {
          "name": "buttons",
          "default": [
            {
              "label": "Day",
              "value": "day"
            },
            {
              "label": "Week",
              "value": "week"
            },
            {
              "label": "Month",
              "value": "month"
            }
          ]
        },
        {
          "name": "mode",
          "default": "single"
        },
        {
          "name": "value",
          "default": "week"
        },
        {
          "name": "selected",
          "default": []
        },
        {
          "name": "allowDeselect",
          "default": false
        },
        {
          "name": "variant",
          "default": "outline"
        },
        {
          "name": "size",
          "default": "default"
        },
        {
          "name": "orientation",
          "default": "horizontal"
        },
        {
          "name": "fullWidth",
          "default": false
        },
        {
          "name": "disabled",
          "default": false
        },
        {
          "name": "lastClicked",
          "default": ""
        },
        {
          "name": "isVisible",
          "default": true
        },
        {
          "name": "isLoading",
          "default": false
        },
        {
          "name": "isDisabled",
          "default": false
        }
      ]
    }
  ],
  "unknown_types": []
}
