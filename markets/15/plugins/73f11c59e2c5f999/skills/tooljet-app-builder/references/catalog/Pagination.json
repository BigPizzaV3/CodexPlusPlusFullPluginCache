{
  "components": [
    {
      "type": "Pagination",
      "name": "Pagination",
      "description": "Navigate pages",
      "defaultSize": {
        "width": 10,
        "height": 30
      },
      "properties": [
        {
          "key": "numberOfPages",
          "label": "Number of pages",
          "valueType": "number",
          "default": "{{5}}"
        },
        {
          "key": "defaultPageIndex",
          "label": "Default page index",
          "valueType": "number",
          "default": "{{1}}"
        },
        {
          "key": "loadingState",
          "label": "Loading state",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "visibility",
          "label": "Visibility",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "disabledState",
          "label": "Disable",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "tooltip",
          "label": "Tooltip",
          "valueType": "string"
        }
      ],
      "styles": [
        {
          "key": "alignment",
          "label": "Alignment",
          "valueType": "string",
          "default": "left"
        },
        {
          "key": "boxShadow",
          "label": "Box shadow",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ],
          "default": "0px 0px 0px 0px #00000040"
        },
        {
          "key": "cssClass",
          "label": "CSS class",
          "default": ""
        }
      ],
      "events": [
        {
          "id": "onPageChange",
          "label": "On Page Change"
        }
      ],
      "actions": [
        {
          "handle": "setPage",
          "displayName": "Set page",
          "params": [
            {
              "handle": "page",
              "displayName": "Page",
              "defaultValue": "{{1}}"
            }
          ]
        },
        {
          "handle": "setVisibility",
          "displayName": "Set visibility",
          "params": [
            {
              "handle": "visible",
              "displayName": "Value",
              "defaultValue": "{{false}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setDisable",
          "displayName": "Set disable",
          "params": [
            {
              "handle": "disable",
              "displayName": "Value",
              "defaultValue": "{{false}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setLoading",
          "displayName": "Set loading",
          "params": [
            {
              "handle": "loading",
              "displayName": "Value",
              "defaultValue": "{{false}}",
              "type": "toggle"
            }
          ]
        }
      ],
      "exposedVariables": [
        {
          "name": "totalPages",
          "default": null
        },
        {
          "name": "currentPageIndex",
          "default": null
        },
        {
          "name": "isVisible",
          "default": true
        },
        {
          "name": "isDisabled",
          "default": false
        },
        {
          "name": "isLoading",
          "default": false
        }
      ]
    }
  ],
  "unknown_types": []
}
