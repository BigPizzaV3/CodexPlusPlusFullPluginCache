{
  "components": [
    {
      "type": "JSONEditor",
      "name": "JSONEditor",
      "description": "Edit JSON data",
      "defaultSize": {
        "width": 15,
        "height": 120
      },
      "properties": [
        {
          "key": "value",
          "label": "Json",
          "valueType": "union",
          "valueTypes": [
            "array",
            "object"
          ],
          "default": "{{{ text : \"Hello World\", number : 64, boolean : true, nullValue : null, fruits : [ \"banana\", \"mango\", \"grape\" ], objectA : { value : \"…"
        },
        {
          "key": "theme",
          "label": "Theme",
          "valueType": "string",
          "default": "solarized",
          "allowedValues": [
            "monokai",
            "solarized",
            "tomorrow",
            "bespin"
          ]
        },
        {
          "key": "shouldExpandEntireJSON",
          "label": "Expand entire JSON",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "dynamicHeight",
          "label": "Dynamic height",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "loadingState",
          "label": "Loading state",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "visibility",
          "label": "Visibility",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "collapseWhenHidden",
          "label": "Collapse when hidden",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "disabledState",
          "label": "Disable",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "tooltipFormat",
          "label": "Tooltip",
          "default": "plainText",
          "allowedValues": [
            "plainText",
            "markdown",
            "html"
          ]
        },
        {
          "key": "tooltip",
          "label": "Tooltip",
          "valueType": "string",
          "default": ""
        }
      ],
      "styles": [
        {
          "key": "backgroundColor",
          "label": "Background",
          "valueType": "string",
          "default": "var(--cc-surface1-surface)"
        },
        {
          "key": "borderColor",
          "label": "Border color",
          "valueType": "string",
          "default": "var(--cc-weak-border)"
        },
        {
          "key": "borderRadius",
          "label": "Border radius",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ],
          "default": "{{6}}"
        },
        {
          "key": "boxShadow",
          "label": "Box shadow",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ],
          "default": "0px 0px 0px 0px #00000040"
        },
        {
          "key": "cssClass",
          "label": "CSS class",
          "default": ""
        }
      ],
      "events": [],
      "actions": [
        {
          "handle": "setVisibility",
          "displayName": "Set visibility",
          "params": [
            {
              "handle": "visibility",
              "displayName": "Value",
              "defaultValue": "{{false}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setLoading",
          "displayName": "Set loading",
          "params": [
            {
              "handle": "loading",
              "displayName": "Value",
              "defaultValue": "{{false}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setDisable",
          "displayName": "Set disable",
          "params": [
            {
              "handle": "disable",
              "displayName": "Value",
              "defaultValue": "{{false}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setValue",
          "displayName": "Set value",
          "params": [
            {
              "handle": "value",
              "displayName": "Value",
              "defaultValue": "{{{}}}"
            }
          ]
        }
      ],
      "exposedVariables": [
        {
          "name": "value",
          "default": {
            "text": "Hello World",
            "number": 64,
            "boolean": true,
            "nullValue": null,
            "fruits": [
              "banana",
              "mango",
              "grape"
            ],
            "objectA": {
              "value": "testing",
              "enabled": false
            },
            "items": []
          }
        },
        {
          "name": "isValid",
          "default": true
        },
        {
          "name": "isVisible",
          "default": true
        },
        {
          "name": "isLoading",
          "default": false
        },
        {
          "name": "isDisabled",
          "default": false
        }
      ]
    }
  ],
  "unknown_types": []
}
