{
  "components": [
    {
      "type": "ShadLink",
      "name": "ShadLink",
      "description": "Text link (native Link names): linkText, linkTarget (URL; empty makes it act as a button), targetType ('new' or 'same' tab), underline ('underline', 'on-hover', 'no-underline'), showIcon (external-link icon), fontSize (px), fontWeight (normal, medium, semibold, bold); textColor and hoverColor styles (default: the primary). onClick fires as well as navigating; onHover. Height: 24px at 14px",
      "defaultSize": {
        "width": 6,
        "height": 30
      },
      "properties": [
        {
          "key": "linkText",
          "label": "Link text",
          "valueType": "string",
          "default": "View details"
        },
        {
          "key": "linkTarget",
          "label": "Link target (URL)",
          "valueType": "string",
          "default": "https://tooljet.com"
        },
        {
          "key": "targetType",
          "label": "Open in",
          "valueType": "string",
          "default": "new",
          "allowedValues": [
            "new",
            "same"
          ]
        },
        {
          "key": "underline",
          "label": "Underline",
          "valueType": "string",
          "default": "on-hover",
          "allowedValues": [
            "underline",
            "on-hover",
            "no-underline"
          ]
        },
        {
          "key": "showIcon",
          "label": "External-link icon",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "fontSize",
          "label": "Font size (px)",
          "valueType": "number",
          "default": "{{14}}"
        },
        {
          "key": "fontWeight",
          "label": "Weight",
          "valueType": "string",
          "default": "medium",
          "allowedValues": [
            "normal",
            "medium",
            "semibold",
            "bold"
          ]
        },
        {
          "key": "loadingState",
          "label": "Loading state",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "loadingIndicator",
          "label": "Loading look",
          "valueType": "string",
          "default": "spinner",
          "allowedValues": [
            "spinner",
            "skeleton"
          ]
        },
        {
          "key": "visibility",
          "label": "Visibility",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "collapseWhenHidden",
          "label": "Collapse when hidden",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "disabledState",
          "label": "Disable",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "tooltipFormat",
          "label": "Tooltip",
          "default": "plainText",
          "allowedValues": [
            "plainText",
            "markdown",
            "html"
          ]
        },
        {
          "key": "tooltip",
          "label": "Tooltip",
          "valueType": "string",
          "default": ""
        }
      ],
      "styles": [
        {
          "key": "boxShadow",
          "label": "Box shadow",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ],
          "default": "0px 0px 0px 0px #00000040"
        },
        {
          "key": "textColor",
          "label": "Link color",
          "valueType": "string"
        },
        {
          "key": "hoverColor",
          "label": "Link hover color",
          "valueType": "string"
        },
        {
          "key": "alignment",
          "label": "Alignment",
          "valueType": "string",
          "default": "left"
        },
        {
          "key": "cssClass",
          "label": "CSS class",
          "default": ""
        }
      ],
      "events": [
        {
          "id": "onClick",
          "label": "On click"
        },
        {
          "id": "onHover",
          "label": "On hover"
        }
      ],
      "actions": [
        {
          "handle": "click",
          "displayName": "Click"
        },
        {
          "handle": "setLinkTarget",
          "displayName": "Set link target",
          "params": [
            {
              "handle": "linkTarget",
              "displayName": "URL",
              "defaultValue": ""
            }
          ]
        },
        {
          "handle": "setLinkText",
          "displayName": "Set link text",
          "params": [
            {
              "handle": "linkText",
              "displayName": "Text",
              "defaultValue": ""
            }
          ]
        },
        {
          "handle": "setVisibility",
          "displayName": "Set visibility",
          "params": [
            {
              "handle": "value",
              "displayName": "Value",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setDisable",
          "displayName": "Set disable",
          "params": [
            {
              "handle": "value",
              "displayName": "Value",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setLoading",
          "displayName": "Set loading",
          "params": [
            {
              "handle": "value",
              "displayName": "Value",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        }
      ],
      "exposedVariables": [
        {
          "name": "isVisible",
          "default": true
        },
        {
          "name": "isLoading",
          "default": false
        },
        {
          "name": "isDisabled",
          "default": false
        },
        {
          "name": "linkTarget",
          "default": ""
        },
        {
          "name": "linkText",
          "default": ""
        }
      ],
      "authoringHints": {
        "styles": "Every style falls back to the app theme, so set only what the design needs to blend in (its accent, surfaces, borders and text colours), taking colours from the app theme or brand, never the defaults of another product. Radii and sizes are px. Styles are the way to restyle a pack widget: a cssClass only takes effect with workspace Custom styles, and Tailwind class names the pack does not already use are not compiled, so do not rely on either; for a one-off visual a style cannot express, use an Html component. Bind loadingState to the query's isLoading (each widget draws a skeleton or spinner in its own shape); tooltip shows on hover.",
        "usage": "linkTarget opens in targetType new or same tab; with no target it acts as a button (onClick). 24px tall."
      }
    }
  ],
  "unknown_types": []
}
