{
  "components": [
    {
      "type": "Button",
      "name": "Button",
      "description": "Trigger actions: queries, alerts, set variables etc.",
      "defaultSize": {
        "width": 4,
        "height": 40
      },
      "properties": [
        {
          "key": "text",
          "label": "Label",
          "valueType": "string",
          "default": "Button"
        },
        {
          "key": "loadingState",
          "label": "Loading state",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "visibility",
          "label": "Visibility",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "collapseWhenHidden",
          "label": "Collapse when hidden",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "disabledState",
          "label": "Disable",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "tooltipFormat",
          "label": "Tooltip",
          "default": "plainText",
          "allowedValues": [
            "plainText",
            "markdown",
            "html"
          ]
        },
        {
          "key": "tooltip",
          "label": "Tooltip",
          "valueType": "string",
          "default": ""
        }
      ],
      "styles": [
        {
          "key": "type",
          "label": "Type",
          "valueType": "string",
          "default": "primary",
          "allowedValues": [
            "primary",
            "outline"
          ]
        },
        {
          "key": "backgroundColor",
          "label": "Background",
          "valueType": "string",
          "default": "var(--cc-primary-brand)"
        },
        {
          "key": "hoverBackgroundMode",
          "label": "Hover background",
          "valueType": "string",
          "default": "auto",
          "allowedValues": [
            "auto",
            "manual"
          ]
        },
        {
          "key": "textColor",
          "label": "Text color",
          "valueType": "string",
          "default": "var(--cc-surface1-surface)"
        },
        {
          "key": "textSize",
          "label": "Font size",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ],
          "default": "{{14}}"
        },
        {
          "key": "fontWeight",
          "label": "Font Weight",
          "default": "normal",
          "allowedValues": [
            "normal",
            "medium",
            "bold",
            "lighter",
            "bolder"
          ]
        },
        {
          "key": "borderColor",
          "label": "Border color",
          "valueType": "string",
          "default": "var(--cc-primary-brand)"
        },
        {
          "key": "loaderColor",
          "label": "Loader color",
          "valueType": "string",
          "default": "var(--cc-surface1-surface)"
        },
        {
          "key": "contentAlignment",
          "label": "Content alignment",
          "valueType": "string",
          "default": "center"
        },
        {
          "key": "icon",
          "label": "Icon",
          "valueType": "string",
          "default": "IconAlignBoxBottomLeft"
        },
        {
          "key": "iconColor",
          "label": "Icon color",
          "valueType": "string",
          "default": "var(--cc-surface1-surface)"
        },
        {
          "key": "borderRadius",
          "label": "Border radius",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ],
          "default": "{{6}}"
        },
        {
          "key": "boxShadow",
          "label": "Box shadow",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ],
          "default": "0px 0px 0px 0px #00000090"
        },
        {
          "key": "padding",
          "label": "Padding",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ],
          "default": "default",
          "allowedValues": [
            "default",
            "none"
          ]
        },
        {
          "key": "hoverBackgroundColor",
          "default": "var(--cc-primary-brand)"
        },
        {
          "key": "direction",
          "default": "left"
        },
        {
          "key": "iconVisibility",
          "default": false
        },
        {
          "key": "cssClass",
          "label": "CSS class",
          "default": ""
        }
      ],
      "events": [
        {
          "id": "onClick",
          "label": "On click"
        },
        {
          "id": "onHover",
          "label": "On hover"
        }
      ],
      "actions": [
        {
          "handle": "click",
          "displayName": "Click"
        },
        {
          "handle": "setText",
          "displayName": "Set text",
          "params": [
            {
              "handle": "text",
              "displayName": "Text",
              "defaultValue": "New Text"
            }
          ]
        },
        {
          "handle": "setVisibility",
          "displayName": "Set visibility",
          "params": [
            {
              "handle": "disable",
              "displayName": "Value",
              "defaultValue": "{{false}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setDisable",
          "displayName": "Set disable",
          "params": [
            {
              "handle": "disable",
              "displayName": "Value",
              "defaultValue": "{{false}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setLoading",
          "displayName": "Set loading",
          "params": [
            {
              "handle": "loading",
              "displayName": "Value",
              "defaultValue": "{{false}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "disable",
          "displayName": "Disable(deprecated)",
          "params": [
            {
              "handle": "disable",
              "displayName": "Value",
              "defaultValue": "{{false}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "visibility",
          "displayName": "Visibility(deprecated)",
          "params": [
            {
              "handle": "visible",
              "displayName": "Value",
              "defaultValue": "{{false}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "loading",
          "displayName": "Loading(deprecated)",
          "params": [
            {
              "handle": "loading",
              "displayName": "Value",
              "defaultValue": "{{false}}",
              "type": "toggle"
            }
          ]
        }
      ],
      "exposedVariables": [
        {
          "name": "buttonText",
          "default": "Button"
        },
        {
          "name": "isVisible",
          "default": true
        },
        {
          "name": "isDisabled",
          "default": false
        },
        {
          "name": "isLoading",
          "default": false
        }
      ],
      "authoringHints": {
        "outlineContrast": "styles.type=outline renders a transparent background, ignoring backgroundColor. Set textColor, visible iconColor and loaderColor for contrast against the actual page/card; var(--cc-primary-text) is appropriate on a normal light surface. The primary-button default var(--cc-surface1-surface) can disappear there. Preserve intentional contrasting colors on dark parents; do not assume changing type remaps semantic color tokens."
      }
    }
  ],
  "unknown_types": []
}
