{
  "components": [
    {
      "type": "Camera",
      "name": "Camera",
      "description": "Captures video & photos from camera",
      "defaultSize": {
        "width": 15,
        "height": 500
      },
      "properties": [
        {
          "key": "content",
          "label": "Content",
          "valueType": "string",
          "default": "image",
          "allowedValues": [
            "image",
            "video"
          ]
        },
        {
          "key": "visibility",
          "label": "Visibility",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "disabledState",
          "label": "Disable",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "tooltipFormat",
          "label": "Tooltip",
          "default": "plainText",
          "allowedValues": [
            "plainText",
            "markdown",
            "html"
          ]
        },
        {
          "key": "tooltip",
          "label": "Tooltip",
          "valueType": "string",
          "default": ""
        }
      ],
      "styles": [
        {
          "key": "textColor",
          "label": "Text color",
          "valueType": "string",
          "default": "var(--cc-primary-text)"
        },
        {
          "key": "accentColor",
          "label": "Accent color",
          "valueType": "string",
          "default": "var(--cc-primary-brand)"
        },
        {
          "key": "backgroundColor",
          "label": "Background",
          "valueType": "string",
          "default": "var(--cc-surface1-surface)"
        },
        {
          "key": "borderColor",
          "label": "Border",
          "valueType": "string",
          "default": "var(--cc-default-border)"
        },
        {
          "key": "borderRadius",
          "label": "Border radius",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ],
          "default": "{{6}}"
        },
        {
          "key": "boxShadow",
          "label": "Box shadow",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ],
          "default": "0px 0px 0px 0px #00000040"
        },
        {
          "key": "cssClass",
          "label": "CSS class",
          "default": ""
        }
      ],
      "events": [
        {
          "id": "onRecordingStart",
          "label": "On recording start"
        },
        {
          "id": "onRecordingSave",
          "label": "On recording save"
        },
        {
          "id": "onImageSave",
          "label": "On image save"
        }
      ],
      "actions": [
        {
          "handle": "setVisibility",
          "displayName": "Set visibility",
          "params": [
            {
              "handle": "disable",
              "displayName": "Value",
              "defaultValue": "{{false}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setDisable",
          "displayName": "Set disable",
          "params": [
            {
              "handle": "disable",
              "displayName": "Value",
              "defaultValue": "{{false}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "resetVideo",
          "displayName": "Reset video"
        },
        {
          "handle": "resetImage",
          "displayName": "Reset image"
        }
      ],
      "exposedVariables": [
        {
          "name": "isVisible",
          "default": true
        },
        {
          "name": "isDisabled",
          "default": false
        },
        {
          "name": "imageDataURL",
          "default": null
        },
        {
          "name": "videoDataURL",
          "default": null
        }
      ]
    }
  ],
  "unknown_types": []
}
