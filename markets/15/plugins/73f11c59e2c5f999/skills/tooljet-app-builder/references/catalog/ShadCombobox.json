{
  "components": [
    {
      "type": "ShadCombobox",
      "name": "ShadCombobox",
      "description": "Combobox: a searchable single select (popover with a search box). options: plain values or [{ label, value, description?, icon? (Tabler name like IconUser, image URL or emoji), group?, disabled? }]; exposes value, selectedOption, searchText. Height: 64px with a label, 36px without; add 24px for help text",
      "defaultSize": {
        "width": 10,
        "height": 70
      },
      "properties": [
        {
          "key": "label",
          "label": "Label",
          "valueType": "string",
          "default": "Country"
        },
        {
          "key": "description",
          "label": "Help text",
          "valueType": "string",
          "default": ""
        },
        {
          "key": "options",
          "label": "Options",
          "valueType": "array",
          "default": "{{[{ label: 'United States', value: 'us', group: 'Americas' }, { label: 'Canada', value: 'ca', group: 'Americas' }, { label: 'United Kingdom', value: 'uk', g…"
        },
        {
          "key": "placeholder",
          "label": "Placeholder",
          "valueType": "string",
          "default": "Select a country..."
        },
        {
          "key": "searchPlaceholder",
          "label": "Search placeholder",
          "valueType": "string",
          "default": "Search countries..."
        },
        {
          "key": "emptyText",
          "label": "No results text",
          "valueType": "string",
          "default": "No country found."
        },
        {
          "key": "showSearch",
          "label": "Show search",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "serverSideSearch",
          "label": "Server-side search (options already filtered by searchText)",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "showClearBtn",
          "label": "Show clear button",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "optionsLoadingState",
          "label": "Options loading state",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "defaultValue",
          "label": "Default value",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number",
            "boolean",
            "array",
            "object"
          ],
          "default": ""
        },
        {
          "key": "dynamicHeight",
          "label": "Dynamic height",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "loadingState",
          "label": "Loading state",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "visibility",
          "label": "Visibility",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "collapseWhenHidden",
          "label": "Collapse when hidden",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "disabledState",
          "label": "Disable",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "tooltipFormat",
          "label": "Tooltip",
          "default": "plainText",
          "allowedValues": [
            "plainText",
            "markdown",
            "html"
          ]
        },
        {
          "key": "tooltip",
          "label": "Tooltip",
          "valueType": "string",
          "default": ""
        }
      ],
      "styles": [
        {
          "key": "boxShadow",
          "label": "Box shadow",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ],
          "default": "0px 0px 0px 0px #00000040"
        },
        {
          "key": "labelColor",
          "label": "Label color",
          "valueType": "string"
        },
        {
          "key": "helpTextColor",
          "label": "Help text color",
          "valueType": "string"
        },
        {
          "key": "backgroundColor",
          "label": "Field background",
          "valueType": "string"
        },
        {
          "key": "textColor",
          "label": "Field text color",
          "valueType": "string"
        },
        {
          "key": "placeholderColor",
          "label": "Placeholder color",
          "valueType": "string"
        },
        {
          "key": "borderColor",
          "label": "Field border color",
          "valueType": "string"
        },
        {
          "key": "accentColor",
          "label": "Accent (focus ring, checks)",
          "valueType": "string"
        },
        {
          "key": "errorColor",
          "label": "Error color (message and border)",
          "valueType": "string"
        },
        {
          "key": "borderRadius",
          "label": "Field radius",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ]
        },
        {
          "key": "menuBackgroundColor",
          "label": "Menu background",
          "valueType": "string"
        },
        {
          "key": "menuTextColor",
          "label": "Menu text color",
          "valueType": "string"
        },
        {
          "key": "optionHoverColor",
          "label": "Highlighted option background",
          "valueType": "string"
        },
        {
          "key": "cssClass",
          "label": "CSS class",
          "default": ""
        }
      ],
      "events": [
        {
          "id": "onSelect",
          "label": "On select"
        },
        {
          "id": "onSearchTextChanged",
          "label": "On search text changed"
        },
        {
          "id": "onFocus",
          "label": "On focus"
        },
        {
          "id": "onBlur",
          "label": "On blur"
        }
      ],
      "actions": [
        {
          "handle": "selectOption",
          "displayName": "Select option",
          "params": [
            {
              "handle": "value",
              "displayName": "Value",
              "defaultValue": ""
            }
          ]
        },
        {
          "handle": "clear",
          "displayName": "Clear"
        },
        {
          "handle": "setFocus",
          "displayName": "Set focus"
        },
        {
          "handle": "setBlur",
          "displayName": "Set blur"
        },
        {
          "handle": "setVisibility",
          "displayName": "Set visibility",
          "params": [
            {
              "handle": "value",
              "displayName": "Value",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setDisable",
          "displayName": "Set disable",
          "params": [
            {
              "handle": "value",
              "displayName": "Value",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setLoading",
          "displayName": "Set loading",
          "params": [
            {
              "handle": "value",
              "displayName": "Value",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        }
      ],
      "exposedVariables": [
        {
          "name": "isVisible",
          "default": true
        },
        {
          "name": "isLoading",
          "default": false
        },
        {
          "name": "isDisabled",
          "default": false
        },
        {
          "name": "isValid",
          "default": true
        },
        {
          "name": "isMandatory",
          "default": false
        },
        {
          "name": "value",
          "default": ""
        },
        {
          "name": "selectedOption",
          "default": {}
        },
        {
          "name": "searchText",
          "default": ""
        },
        {
          "name": "options",
          "default": []
        },
        {
          "name": "label",
          "default": ""
        }
      ],
      "authoringHints": {
        "styles": "Every style falls back to the app theme, so set only what the design needs to blend in (its accent, surfaces, borders and text colours), taking colours from the app theme or brand, never the defaults of another product. Radii and sizes are px. Styles are the way to restyle a pack widget: a cssClass only takes effect with workspace Custom styles, and Tailwind class names the pack does not already use are not compiled, so do not rely on either; for a one-off visual a style cannot express, use an Html component. Bind loadingState to the query's isLoading (each widget draws a skeleton or spinner in its own shape); tooltip shows on hover.",
        "usage": "options [{ label, value, description?, icon?, group?, disabled? }]; read components.<name>.value or selectedOption. Server-side search: bind the query to searchText and turn serverSideSearch on. Height 64 with a label, 36 without."
      }
    }
  ],
  "unknown_types": []
}
