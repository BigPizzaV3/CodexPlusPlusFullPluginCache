{
  "components": [
    {
      "type": "RadioButtonV2",
      "name": "RadioButton",
      "description": "Select one from multiple choices",
      "defaultSize": {
        "width": 12,
        "height": 43
      },
      "properties": [
        {
          "key": "label",
          "label": "Label",
          "valueType": "string",
          "default": "Select"
        },
        {
          "key": "advanced",
          "label": "Dynamic options",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "schema",
          "label": "Schema",
          "default": "{{[ {label: 'option1',value: '1',disable: false,visible: true,default: true},{label: 'option2',value: '2',disable: false,visible: true},{label: 'option3',val…"
        },
        {
          "key": "optionsLoadingState",
          "label": "Options loading state",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "layout",
          "label": "Layout",
          "valueType": "string",
          "default": "row",
          "allowedValues": [
            "row",
            "column",
            "wrap"
          ]
        },
        {
          "key": "dynamicHeight",
          "label": "Dynamic height",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "loadingState",
          "label": "Loading state",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "visibility",
          "label": "Visibility",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "collapseWhenHidden",
          "label": "Collapse when hidden",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "disabledState",
          "label": "Disable",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "tooltipFormat",
          "label": "Tooltip",
          "default": "plainText",
          "allowedValues": [
            "plainText",
            "markdown",
            "html"
          ]
        },
        {
          "key": "tooltip",
          "label": "Tooltip",
          "valueType": "string",
          "default": ""
        },
        {
          "key": "value",
          "default": "{{\"2\"}}"
        },
        {
          "key": "options",
          "default": [
            {
              "label": "option1",
              "value": "1",
              "disable": {
                "value": false
              },
              "visible": {
                "value": true
              },
              "default": {
                "value": false
              }
            },
            {
              "label": "option2",
              "value": "2",
              "disable": {
                "value": false
              },
              "visible": {
                "value": true
              },
              "default": {
                "value": true
              }
            },
            {
              "label": "option3",
              "value": "3",
              "disable": {
                "value": false
              },
              "visible": {
                "value": true
              },
              "default": {
                "value": false
              }
            }
          ]
        },
        {
          "key": "optionVisibility",
          "default": "{{[true, true, true]}}"
        },
        {
          "key": "optionDisable",
          "default": "{{[false, false, false]}}"
        }
      ],
      "styles": [
        {
          "key": "labelColor",
          "label": "Color",
          "valueType": "string",
          "default": "var(--cc-primary-text)"
        },
        {
          "key": "labelFontSize",
          "label": "Size",
          "valueType": "number",
          "default": "{{12}}"
        },
        {
          "key": "alignment",
          "label": "Alignment",
          "valueType": "string",
          "default": "side",
          "allowedValues": [
            "side",
            "top"
          ]
        },
        {
          "key": "direction",
          "label": "Direction",
          "valueType": "string",
          "default": "left",
          "allowedValues": [
            "left",
            "right"
          ]
        },
        {
          "key": "auto",
          "label": "Width",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "borderColor",
          "label": "Border",
          "valueType": "string",
          "default": "var(--cc-default-border)"
        },
        {
          "key": "switchOnBackgroundColor",
          "label": "Checked background",
          "valueType": "string",
          "default": "var(--cc-primary-brand)"
        },
        {
          "key": "switchOffBackgroundColor",
          "label": "Unchecked background",
          "valueType": "string",
          "default": "var(--cc-surface1-surface)"
        },
        {
          "key": "handleColor",
          "label": "Handle color",
          "valueType": "string",
          "default": "var(--cc-surface1-surface)"
        },
        {
          "key": "optionsTextColor",
          "label": "Text",
          "valueType": "string",
          "default": "var(--cc-primary-text)"
        },
        {
          "key": "padding",
          "label": "Padding",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ],
          "default": "default",
          "allowedValues": [
            "default",
            "none"
          ]
        },
        {
          "key": "labelWidth",
          "default": "33"
        },
        {
          "key": "widthType",
          "default": "ofComponent"
        },
        {
          "key": "cssClass",
          "label": "CSS class",
          "default": ""
        }
      ],
      "events": [
        {
          "id": "onSelectionChange",
          "label": "On select"
        }
      ],
      "actions": [
        {
          "handle": "selectOption",
          "displayName": "Select option",
          "params": [
            {
              "handle": "option",
              "displayName": "Option"
            }
          ]
        },
        {
          "handle": "deselectOption",
          "displayName": "Deselect option",
          "params": [
            {
              "handle": "option",
              "displayName": "Option"
            }
          ]
        },
        {
          "handle": "setVisibility",
          "displayName": "Set visibility",
          "params": [
            {
              "handle": "setVisibility",
              "displayName": "Value",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setLoading",
          "displayName": "Set loading",
          "params": [
            {
              "handle": "setLoading",
              "displayName": "Value",
              "defaultValue": "{{false}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setDisable",
          "displayName": "Set disable",
          "params": [
            {
              "handle": "setDisable",
              "displayName": "Value",
              "defaultValue": "{{false}}",
              "type": "toggle"
            }
          ]
        }
      ],
      "exposedVariables": [
        {
          "name": "label",
          "default": "Select",
          "semantics": "The field's caption text, not the selected option: use value for the selection."
        },
        {
          "name": "value",
          "default": null,
          "semantics": "The value of the selected option (null until one is chosen). Filter and write with this."
        },
        {
          "name": "options",
          "default": [],
          "semantics": "The options as rendered: [{ label, value }]."
        },
        {
          "name": "isValid",
          "default": true,
          "valueType": "boolean"
        }
      ]
    }
  ],
  "unknown_types": []
}
