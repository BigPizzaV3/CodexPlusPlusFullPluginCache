{
  "components": [
    {
      "type": "AudioRecorder",
      "name": "AudioRecorder",
      "description": "Records audio",
      "defaultSize": {
        "width": 10,
        "height": 70
      },
      "properties": [
        {
          "key": "label",
          "label": "Label",
          "valueType": "string",
          "default": "Click to start recording"
        },
        {
          "key": "loadingState",
          "label": "Loading state",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "visibility",
          "label": "Visibility",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "disabledState",
          "label": "Disable",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "tooltipFormat",
          "label": "Tooltip",
          "default": "plainText",
          "allowedValues": [
            "plainText",
            "markdown",
            "html"
          ]
        },
        {
          "key": "tooltip",
          "label": "Tooltip",
          "valueType": "string",
          "default": ""
        }
      ],
      "styles": [
        {
          "key": "recorderIcon",
          "label": "Icon",
          "valueType": "string",
          "default": "IconMicrophone"
        },
        {
          "key": "recorderIconColor",
          "label": "Icon color",
          "valueType": "string",
          "default": "#F6430D"
        },
        {
          "key": "labelColor",
          "label": "Label text",
          "valueType": "string",
          "default": "var(--cc-primary-text)"
        },
        {
          "key": "accentColor",
          "label": "Accent color",
          "valueType": "string",
          "default": "var(--cc-primary-brand)"
        },
        {
          "key": "backgroundColor",
          "label": "Background",
          "valueType": "string",
          "default": "var(--cc-surface1-surface)"
        },
        {
          "key": "borderColor",
          "label": "Border",
          "valueType": "string",
          "default": "var(--cc-default-border)"
        },
        {
          "key": "borderRadius",
          "label": "Border radius",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ],
          "default": "{{6}}"
        },
        {
          "key": "boxShadow",
          "label": "Box shadow",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ],
          "default": "0px 0px 0px 0px #00000040"
        },
        {
          "key": "iconVisibility",
          "default": true
        },
        {
          "key": "cssClass",
          "label": "CSS class",
          "default": ""
        }
      ],
      "events": [
        {
          "id": "onRecordingStart",
          "label": "On recording start"
        },
        {
          "id": "onRecordingSave",
          "label": "On recording save"
        }
      ],
      "actions": [
        {
          "handle": "setVisibility",
          "displayName": "Set visibility",
          "params": [
            {
              "handle": "disable",
              "displayName": "Value",
              "defaultValue": "{{false}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setDisable",
          "displayName": "Set disable",
          "params": [
            {
              "handle": "disable",
              "displayName": "Value",
              "defaultValue": "{{false}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setLoading",
          "displayName": "Set loading",
          "params": [
            {
              "handle": "loading",
              "displayName": "Value",
              "defaultValue": "{{false}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "resetAudio",
          "displayName": "Reset audio"
        }
      ],
      "exposedVariables": [
        {
          "name": "isVisible",
          "default": true
        },
        {
          "name": "isDisabled",
          "default": false
        },
        {
          "name": "isLoading",
          "default": false
        },
        {
          "name": "dataURL",
          "default": null
        }
      ]
    }
  ],
  "unknown_types": []
}
