{
  "components": [
    {
      "type": "ShadPagination",
      "name": "ShadPagination",
      "description": "Pagination (native Pagination names): numberOfPages, or totalRecords with pageSize; defaultPageIndex (1-based); Previous / page numbers with ellipsis / Next (showLabels), optional first and last buttons (showFirstLast), siblingCount, size 'sm' or 'default'. onPageChange; action setPage(page); exposed currentPageIndex (1-based) and totalPages. Bind a query offset to (currentPageIndex - 1) * pageSize. Height: 36px (32px small)",
      "defaultSize": {
        "width": 16,
        "height": 40
      },
      "properties": [
        {
          "key": "numberOfPages",
          "label": "Number of pages",
          "valueType": "number",
          "default": "{{10}}"
        },
        {
          "key": "totalRecords",
          "label": "Total records (instead of pages)",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ],
          "default": ""
        },
        {
          "key": "pageSize",
          "label": "Page size (with total records)",
          "valueType": "number",
          "default": "{{10}}"
        },
        {
          "key": "defaultPageIndex",
          "label": "Default page index",
          "valueType": "number",
          "default": "{{1}}"
        },
        {
          "key": "siblingCount",
          "label": "Pages beside the current one",
          "valueType": "number",
          "default": "{{1}}"
        },
        {
          "key": "showFirstLast",
          "label": "First and last buttons",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "showLabels",
          "label": "Previous / Next labels",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "size",
          "label": "Size",
          "valueType": "string",
          "default": "default",
          "allowedValues": [
            "sm",
            "default"
          ]
        },
        {
          "key": "loadingState",
          "label": "Loading state",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "visibility",
          "label": "Visibility",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "collapseWhenHidden",
          "label": "Collapse when hidden",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "disabledState",
          "label": "Disable",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "tooltipFormat",
          "label": "Tooltip",
          "default": "plainText",
          "allowedValues": [
            "plainText",
            "markdown",
            "html"
          ]
        },
        {
          "key": "tooltip",
          "label": "Tooltip",
          "valueType": "string",
          "default": ""
        }
      ],
      "styles": [
        {
          "key": "boxShadow",
          "label": "Box shadow",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ],
          "default": "0px 0px 0px 0px #00000040"
        },
        {
          "key": "textColor",
          "label": "Page text color",
          "valueType": "string"
        },
        {
          "key": "hoverBackgroundColor",
          "label": "Hover background",
          "valueType": "string"
        },
        {
          "key": "activeBackgroundColor",
          "label": "Current page background",
          "valueType": "string"
        },
        {
          "key": "activeTextColor",
          "label": "Current page text color",
          "valueType": "string"
        },
        {
          "key": "activeBorderColor",
          "label": "Current page border color",
          "valueType": "string"
        },
        {
          "key": "borderRadius",
          "label": "Button radius",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ]
        },
        {
          "key": "alignment",
          "label": "Alignment",
          "valueType": "string",
          "default": "left"
        },
        {
          "key": "cssClass",
          "label": "CSS class",
          "default": ""
        }
      ],
      "events": [
        {
          "id": "onPageChange",
          "label": "On page change"
        }
      ],
      "actions": [
        {
          "handle": "setPage",
          "displayName": "Set page",
          "params": [
            {
              "handle": "page",
              "displayName": "Page",
              "defaultValue": "{{1}}"
            }
          ]
        },
        {
          "handle": "setVisibility",
          "displayName": "Set visibility",
          "params": [
            {
              "handle": "value",
              "displayName": "Value",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setDisable",
          "displayName": "Set disable",
          "params": [
            {
              "handle": "value",
              "displayName": "Value",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setLoading",
          "displayName": "Set loading",
          "params": [
            {
              "handle": "value",
              "displayName": "Value",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        }
      ],
      "exposedVariables": [
        {
          "name": "isVisible",
          "default": true
        },
        {
          "name": "isLoading",
          "default": false
        },
        {
          "name": "isDisabled",
          "default": false
        },
        {
          "name": "totalPages",
          "default": 10
        },
        {
          "name": "currentPageIndex",
          "default": 1
        }
      ],
      "authoringHints": {
        "styles": "Every style falls back to the app theme, so set only what the design needs to blend in (its accent, surfaces, borders and text colours), taking colours from the app theme or brand, never the defaults of another product. Radii and sizes are px. Styles are the way to restyle a pack widget: a cssClass only takes effect with workspace Custom styles, and Tailwind class names the pack does not already use are not compiled, so do not rely on either; for a one-off visual a style cannot express, use an Html component. Bind loadingState to the query's isLoading (each widget draws a skeleton or spinner in its own shape); tooltip shows on hover.",
        "usage": "numberOfPages, or totalRecords with pageSize; onPageChange; offset = (components.<name>.currentPageIndex - 1) * pageSize. 36px tall."
      }
    }
  ],
  "unknown_types": []
}
