{
  "components": [
    {
      "type": "ShadToggleGroup",
      "name": "ShadToggleGroup",
      "description": "Segmented toggle (filters, views), like a tabs list",
      "defaultSize": {
        "width": 14,
        "height": 40
      },
      "properties": [
        {
          "key": "options",
          "label": "Options",
          "valueType": "array",
          "default": "{{['All', 'Open', 'Closed']}}"
        },
        {
          "key": "defaultValue",
          "label": "Default value",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number",
            "boolean",
            "array",
            "object"
          ],
          "default": "All"
        },
        {
          "key": "fullWidth",
          "label": "Full width",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "loadingState",
          "label": "Loading state",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "visibility",
          "label": "Visibility",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "collapseWhenHidden",
          "label": "Collapse when hidden",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "disabledState",
          "label": "Disable",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "tooltipFormat",
          "label": "Tooltip",
          "default": "plainText",
          "allowedValues": [
            "plainText",
            "markdown",
            "html"
          ]
        },
        {
          "key": "tooltip",
          "label": "Tooltip",
          "valueType": "string",
          "default": ""
        }
      ],
      "styles": [
        {
          "key": "boxShadow",
          "label": "Box shadow",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ],
          "default": "0px 0px 0px 0px #00000040"
        },
        {
          "key": "backgroundColor",
          "label": "Group background",
          "valueType": "string"
        },
        {
          "key": "textColor",
          "label": "Option text color",
          "valueType": "string"
        },
        {
          "key": "selectedBackgroundColor",
          "label": "Selected option background",
          "valueType": "string"
        },
        {
          "key": "selectedTextColor",
          "label": "Selected option text color",
          "valueType": "string"
        },
        {
          "key": "borderRadius",
          "label": "Group radius",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ]
        },
        {
          "key": "cssClass",
          "label": "CSS class",
          "default": ""
        }
      ],
      "events": [
        {
          "id": "onChange",
          "label": "On change"
        }
      ],
      "actions": [
        {
          "handle": "setSelected",
          "displayName": "Set selected",
          "params": [
            {
              "handle": "selected",
              "displayName": "Value",
              "defaultValue": ""
            }
          ]
        },
        {
          "handle": "clear",
          "displayName": "Clear"
        },
        {
          "handle": "setVisibility",
          "displayName": "Set visibility",
          "params": [
            {
              "handle": "value",
              "displayName": "Value",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setDisable",
          "displayName": "Set disable",
          "params": [
            {
              "handle": "value",
              "displayName": "Value",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setLoading",
          "displayName": "Set loading",
          "params": [
            {
              "handle": "value",
              "displayName": "Value",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        }
      ],
      "exposedVariables": [
        {
          "name": "isVisible",
          "default": true
        },
        {
          "name": "isLoading",
          "default": false
        },
        {
          "name": "isDisabled",
          "default": false
        },
        {
          "name": "value",
          "default": ""
        }
      ],
      "authoringHints": {
        "styles": "Every style falls back to the app theme, so set only what the design needs to blend in (its accent, surfaces, borders and text colours), taking colours from the app theme or brand, never the defaults of another product. Radii and sizes are px. Styles are the way to restyle a pack widget: a cssClass only takes effect with workspace Custom styles, and Tailwind class names the pack does not already use are not compiled, so do not rely on either; for a one-off visual a style cannot express, use an Html component. Bind loadingState to the query's isLoading (each widget draws a skeleton or spinner in its own shape); tooltip shows on hover."
      }
    }
  ],
  "unknown_types": []
}
