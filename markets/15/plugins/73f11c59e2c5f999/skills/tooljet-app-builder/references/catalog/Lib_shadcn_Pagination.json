{
  "components": [
    {
      "type": "Lib_shadcn_Pagination",
      "name": "Lib_shadcn_Pagination",
      "description": "Pagination from the shadcn UI component library. Drawn at the height you give it.",
      "defaultSize": {
        "width": 16,
        "height": 40
      },
      "properties": [
        {
          "key": "numberOfPages",
          "label": "Pages",
          "valueType": "number",
          "default": "{{10}}",
          "description": "Ignored when total records is set."
        },
        {
          "key": "totalRecords",
          "label": "Total records",
          "valueType": "string",
          "default": ""
        },
        {
          "key": "pageSize",
          "label": "Page size",
          "valueType": "number",
          "default": "{{10}}"
        },
        {
          "key": "currentPageIndex",
          "label": "Default page",
          "valueType": "number",
          "default": "{{1}}"
        },
        {
          "key": "siblingCount",
          "label": "Pages around current",
          "valueType": "number",
          "default": "{{1}}"
        },
        {
          "key": "showFirstLast",
          "label": "First / last buttons",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "showLabels",
          "label": "Previous / next labels",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "totalPages",
          "label": "Total Pages",
          "valueType": "number",
          "default": "{{10}}"
        },
        {
          "key": "visibility",
          "label": "Visibility",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "loadingState",
          "label": "Loading state",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "disabledState",
          "label": "Disable",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "dynamicHeight",
          "label": "Dynamic height",
          "valueType": "boolean",
          "default": "{{false}}"
        }
      ],
      "styles": [
        {
          "key": "activeBackgroundColor",
          "label": "Active page",
          "valueType": "string"
        },
        {
          "key": "borderRadius",
          "label": "Border radius",
          "valueType": "number"
        },
        {
          "key": "alignment",
          "label": "Alignment",
          "valueType": "string"
        },
        {
          "key": "boxShadow",
          "label": "Box shadow",
          "valueType": "string"
        }
      ],
      "events": [
        {
          "id": "onPageChange",
          "label": "On page change"
        }
      ],
      "actions": [
        {
          "handle": "setPage",
          "displayName": "Go to page",
          "params": [
            {
              "handle": "page",
              "displayName": "Page"
            }
          ]
        },
        {
          "handle": "setVisibility",
          "displayName": "Set visibility",
          "params": [
            {
              "handle": "visibility",
              "displayName": "Value",
              "defaultValue": "{{false}}"
            }
          ]
        },
        {
          "handle": "setLoading",
          "displayName": "Set loading",
          "params": [
            {
              "handle": "loading",
              "displayName": "Value",
              "defaultValue": "{{false}}"
            }
          ]
        },
        {
          "handle": "setDisable",
          "displayName": "Set disable",
          "params": [
            {
              "handle": "disable",
              "displayName": "Value",
              "defaultValue": "{{false}}"
            }
          ]
        }
      ],
      "exposedVariables": [
        {
          "name": "numberOfPages",
          "default": 10
        },
        {
          "name": "totalRecords",
          "default": ""
        },
        {
          "name": "pageSize",
          "default": 10
        },
        {
          "name": "currentPageIndex",
          "default": 1
        },
        {
          "name": "siblingCount",
          "default": 1
        },
        {
          "name": "showFirstLast",
          "default": false
        },
        {
          "name": "showLabels",
          "default": true
        },
        {
          "name": "totalPages",
          "default": 10
        },
        {
          "name": "isVisible",
          "default": true
        },
        {
          "name": "isLoading",
          "default": false
        },
        {
          "name": "isDisabled",
          "default": false
        }
      ]
    }
  ],
  "unknown_types": []
}
