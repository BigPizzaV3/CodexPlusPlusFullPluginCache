{
  "components": [
    {
      "type": "ShadButtonGroup",
      "name": "ShadButtonGroup",
      "description": "Button group (attached buttons) from buttons [{ label, value, icon?: 'IconBolt', disabled?, variant? }] (label '' with an icon = icon-only). mode: 'actions' (each click fires onClick, exposed lastClicked), 'single' or 'multiple' (a segmented selection: exposed value, selected; onChange). Height 36px (sm 32px, lg 40px); add 22px for a label",
      "defaultSize": {
        "width": 10,
        "height": 70
      },
      "properties": [
        {
          "key": "label",
          "label": "Label",
          "valueType": "string",
          "default": "Label"
        },
        {
          "key": "description",
          "label": "Help text",
          "valueType": "string",
          "default": ""
        },
        {
          "key": "buttons",
          "label": "Buttons",
          "valueType": "array",
          "default": "{{[{ label: 'Day', value: 'day' }, { label: 'Week', value: 'week' }, { label: 'Month', value: 'month' }]}}"
        },
        {
          "key": "mode",
          "label": "Mode",
          "valueType": "string",
          "default": "single",
          "allowedValues": [
            "actions",
            "single",
            "multiple"
          ]
        },
        {
          "key": "defaultValue",
          "label": "Default selected (value, or a list when multiple)",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number",
            "boolean",
            "array",
            "object"
          ],
          "default": "week"
        },
        {
          "key": "allowDeselect",
          "label": "Allow deselecting (single)",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "variant",
          "label": "Variant",
          "valueType": "string",
          "default": "outline",
          "allowedValues": [
            "outline",
            "secondary",
            "default",
            "ghost"
          ]
        },
        {
          "key": "size",
          "label": "Size",
          "valueType": "string",
          "default": "default",
          "allowedValues": [
            "sm",
            "default",
            "lg"
          ]
        },
        {
          "key": "orientation",
          "label": "Orientation",
          "valueType": "string",
          "default": "horizontal",
          "allowedValues": [
            "horizontal",
            "vertical"
          ]
        },
        {
          "key": "fullWidth",
          "label": "Full width",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "dynamicHeight",
          "label": "Dynamic height",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "loadingState",
          "label": "Loading state",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "visibility",
          "label": "Visibility",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "collapseWhenHidden",
          "label": "Collapse when hidden",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "disabledState",
          "label": "Disable",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "tooltipFormat",
          "label": "Tooltip",
          "default": "plainText",
          "allowedValues": [
            "plainText",
            "markdown",
            "html"
          ]
        },
        {
          "key": "tooltip",
          "label": "Tooltip",
          "valueType": "string",
          "default": ""
        }
      ],
      "styles": [
        {
          "key": "boxShadow",
          "label": "Box shadow",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ],
          "default": "0px 0px 0px 0px #00000040"
        },
        {
          "key": "backgroundColor",
          "label": "Button background",
          "valueType": "string"
        },
        {
          "key": "hoverBackgroundColor",
          "label": "Button hover background",
          "valueType": "string"
        },
        {
          "key": "textColor",
          "label": "Button text color",
          "valueType": "string"
        },
        {
          "key": "borderColor",
          "label": "Border and divider color",
          "valueType": "string"
        },
        {
          "key": "selectedBackgroundColor",
          "label": "Selected background",
          "valueType": "string"
        },
        {
          "key": "selectedTextColor",
          "label": "Selected text color",
          "valueType": "string"
        },
        {
          "key": "iconColor",
          "label": "Icon color",
          "valueType": "string"
        },
        {
          "key": "labelColor",
          "label": "Label color",
          "valueType": "string"
        },
        {
          "key": "borderRadius",
          "label": "Group radius",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ]
        },
        {
          "key": "cssClass",
          "label": "CSS class",
          "default": ""
        }
      ],
      "events": [
        {
          "id": "onClick",
          "label": "On click"
        },
        {
          "id": "onChange",
          "label": "On change"
        }
      ],
      "actions": [
        {
          "handle": "setSelected",
          "displayName": "Set selected",
          "params": [
            {
              "handle": "selected",
              "displayName": "Value (or list)",
              "defaultValue": ""
            }
          ]
        },
        {
          "handle": "clear",
          "displayName": "Clear selected"
        },
        {
          "handle": "setVisibility",
          "displayName": "Set visibility",
          "params": [
            {
              "handle": "value",
              "displayName": "Value",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setDisable",
          "displayName": "Set disable",
          "params": [
            {
              "handle": "value",
              "displayName": "Value",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setLoading",
          "displayName": "Set loading",
          "params": [
            {
              "handle": "value",
              "displayName": "Value",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        }
      ],
      "exposedVariables": [
        {
          "name": "isVisible",
          "default": true
        },
        {
          "name": "isLoading",
          "default": false
        },
        {
          "name": "isDisabled",
          "default": false
        },
        {
          "name": "value",
          "default": ""
        },
        {
          "name": "selected",
          "default": []
        },
        {
          "name": "lastClicked",
          "default": null
        },
        {
          "name": "isValid",
          "default": true
        },
        {
          "name": "isMandatory",
          "default": false
        }
      ],
      "authoringHints": {
        "styles": "Every style falls back to the app theme, so set only what the design needs to blend in (its accent, surfaces, borders and text colours), taking colours from the app theme or brand, never the defaults of another product. Radii and sizes are px. Styles are the way to restyle a pack widget: a cssClass only takes effect with workspace Custom styles, and Tailwind class names the pack does not already use are not compiled, so do not rely on either; for a one-off visual a style cannot express, use an Html component. Bind loadingState to the query's isLoading (each widget draws a skeleton or spinner in its own shape); tooltip shows on hover.",
        "usage": "mode 'single' with defaultValue is a view switcher: bind components.<name>.value. 'actions' fires onClick with lastClicked. 36px tall, +22 with a label."
      }
    }
  ],
  "unknown_types": []
}
