{
  "components": [
    {
      "type": "ShadButton",
      "name": "ShadButton",
      "description": "Button",
      "defaultSize": {
        "width": 6,
        "height": 40
      },
      "properties": [
        {
          "key": "text",
          "label": "Label",
          "valueType": "string",
          "default": "Button"
        },
        {
          "key": "variant",
          "label": "Variant",
          "valueType": "string",
          "default": "default",
          "allowedValues": [
            "default",
            "secondary",
            "outline",
            "ghost",
            "destructive",
            "link"
          ]
        },
        {
          "key": "size",
          "label": "Size",
          "valueType": "string",
          "default": "default",
          "allowedValues": [
            "sm",
            "default",
            "lg"
          ]
        },
        {
          "key": "fullWidth",
          "label": "Stretch in flex container",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "loadingState",
          "label": "Loading state",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "visibility",
          "label": "Visibility",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "collapseWhenHidden",
          "label": "Collapse when hidden",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "disabledState",
          "label": "Disable",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "tooltipFormat",
          "label": "Tooltip",
          "default": "plainText",
          "allowedValues": [
            "plainText",
            "markdown",
            "html"
          ]
        },
        {
          "key": "tooltip",
          "label": "Tooltip",
          "valueType": "string",
          "default": ""
        }
      ],
      "styles": [
        {
          "key": "boxShadow",
          "label": "Box shadow",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ],
          "default": "0px 0px 0px 0px #00000040"
        },
        {
          "key": "backgroundColor",
          "label": "Button background",
          "valueType": "string"
        },
        {
          "key": "hoverBackgroundColor",
          "label": "Button hover background",
          "valueType": "string"
        },
        {
          "key": "textColor",
          "label": "Button text color",
          "valueType": "string"
        },
        {
          "key": "borderColor",
          "label": "Button border color",
          "valueType": "string"
        },
        {
          "key": "borderRadius",
          "label": "Button radius",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ]
        },
        {
          "key": "cssClass",
          "label": "CSS class",
          "default": ""
        }
      ],
      "events": [
        {
          "id": "onClick",
          "label": "On click"
        },
        {
          "id": "onHover",
          "label": "On hover"
        }
      ],
      "actions": [
        {
          "handle": "click",
          "displayName": "Click"
        },
        {
          "handle": "setText",
          "displayName": "Set text",
          "params": [
            {
              "handle": "text",
              "displayName": "Text",
              "defaultValue": "New text"
            }
          ]
        },
        {
          "handle": "setVisibility",
          "displayName": "Set visibility",
          "params": [
            {
              "handle": "value",
              "displayName": "Value",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setDisable",
          "displayName": "Set disable",
          "params": [
            {
              "handle": "value",
              "displayName": "Value",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setLoading",
          "displayName": "Set loading",
          "params": [
            {
              "handle": "value",
              "displayName": "Value",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        }
      ],
      "exposedVariables": [
        {
          "name": "isVisible",
          "default": true
        },
        {
          "name": "isLoading",
          "default": false
        },
        {
          "name": "isDisabled",
          "default": false
        },
        {
          "name": "buttonText",
          "default": "Button"
        }
      ],
      "authoringHints": {
        "styles": "Every style falls back to the app theme, so set only what the design needs to blend in (its accent, surfaces, borders and text colours), taking colours from the app theme or brand, never the defaults of another product. Radii and sizes are px. Styles are the way to restyle a pack widget: a cssClass only takes effect with workspace Custom styles, and Tailwind class names the pack does not already use are not compiled, so do not rely on either; for a one-off visual a style cannot express, use an Html component. Bind loadingState to the query's isLoading (each widget draws a skeleton or spinner in its own shape); tooltip shows on hover. Each variant keeps its own colours unless set: a set backgroundColor darkens slightly on hover unless hoverBackgroundColor is set; set textColor with it."
      }
    }
  ],
  "unknown_types": []
}
