{
  "components": [
    {
      "type": "ShadTimePicker",
      "name": "ShadTimePicker",
      "description": "Time picker: a field opening hour, minute and AM/PM columns, or (pickerStyle list) one list of times; both offer a time every minuteStep minutes from midnight (with 45: 09:00, 09:45, 10:30). Exposes value as 'HH:mm' in 24-hour time ('' when empty) and formattedValue as shown ('2:30 PM' or '14:30'); defaultValue, minTime and maxTime take '14:30' or '2:30 PM'. Height: 64px with a label (label above the control), 36px without; add 24px for help text or a validation message",
      "defaultSize": {
        "width": 10,
        "height": 70
      },
      "properties": [
        {
          "key": "label",
          "label": "Label",
          "valueType": "string",
          "default": "Time"
        },
        {
          "key": "description",
          "label": "Help text",
          "valueType": "string",
          "default": ""
        },
        {
          "key": "placeholder",
          "label": "Placeholder",
          "valueType": "string",
          "default": "Pick a time"
        },
        {
          "key": "defaultValue",
          "label": "Default value (HH:mm)",
          "valueType": "string",
          "default": ""
        },
        {
          "key": "timeFormat",
          "label": "Time format",
          "valueType": "string",
          "default": "12h",
          "allowedValues": [
            "12h",
            "24h"
          ]
        },
        {
          "key": "pickerStyle",
          "label": "Picker",
          "valueType": "string",
          "default": "columns",
          "allowedValues": [
            "columns",
            "list"
          ]
        },
        {
          "key": "minuteStep",
          "label": "Minute step",
          "valueType": "number",
          "default": "{{15}}"
        },
        {
          "key": "minTime",
          "label": "Earliest time (HH:mm)",
          "valueType": "string",
          "default": ""
        },
        {
          "key": "maxTime",
          "label": "Latest time (HH:mm)",
          "valueType": "string",
          "default": ""
        },
        {
          "key": "showClearBtn",
          "label": "Show clear button",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "loadingState",
          "label": "Loading state",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "visibility",
          "label": "Visibility",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "collapseWhenHidden",
          "label": "Collapse when hidden",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "disabledState",
          "label": "Disable",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "tooltipFormat",
          "label": "Tooltip",
          "default": "plainText",
          "allowedValues": [
            "plainText",
            "markdown",
            "html"
          ]
        },
        {
          "key": "tooltip",
          "label": "Tooltip",
          "valueType": "string",
          "default": ""
        }
      ],
      "styles": [
        {
          "key": "boxShadow",
          "label": "Box shadow",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
