{
  "components": [
    {
      "type": "Chat",
      "name": "Chat",
      "description": "Chat interface with message history",
      "defaultSize": {
        "width": 15,
        "height": 400
      },
      "properties": [
        {
          "key": "chatTitle",
          "label": "Chat title",
          "valueType": "string",
          "default": "Chat"
        },
        {
          "key": "initialChat",
          "label": "Initial chat",
          "valueType": "array",
          "default": "{{[{ message: 'Ask me anything!', messageId: 'e3dd6f60-d5e8-46c5-b73b-006f2f4a34f2', timestamp: 'new Date().t…"
        },
        {
          "key": "userName",
          "label": "User name",
          "valueType": "string",
          "default": "{{globals.currentUser.firstName}}"
        },
        {
          "key": "userAvatar",
          "label": "User avatar",
          "valueType": "string",
          "default": ""
        },
        {
          "key": "respondentName",
          "label": "Respondent name",
          "valueType": "string",
          "default": "Assistant"
        },
        {
          "key": "respondentAvatar",
          "label": "Respondent avatar",
          "valueType": "string",
          "default": ""
        },
        {
          "key": "visibility",
          "label": "Visibility",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "disableInput",
          "label": "Disable input state",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "loadingHistory",
          "label": "History loading state",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "loadingResponse",
          "label": "Response loading state",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "enableClearHistoryButton",
          "label": "Enable clear history icon",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "enableDownloadHistoryButton",
          "label": "Enable download history icon",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "placeholder",
          "label": "Placeholder for input field",
          "valueType": "string",
          "default": "Ask me anything!"
        }
      ],
      "styles": [
        {
          "key": "name",
          "label": "Name",
          "valueType": "string",
          "default": "var(--cc-primary-text)"
        },
        {
          "key": "message",
          "label": "Message",
          "valueType": "string",
          "default": "var(--cc-primary-text)"
        },
        {
          "key": "timestamp",
          "label": "Timestamp",
          "valueType": "string",
          "default": "var(--cc-placeholder-text)"
        },
        {
          "key": "backgroundColorField",
          "label": "Background",
          "valueType": "string",
          "default": "var(--cc-surface1-surface)"
        },
        {
          "key": "borderColorField",
          "label": "Border",
          "valueType": "string",
          "default": "var(--cc-default-border)"
        },
        {
          "key": "accentColorField",
          "label": "Accent",
          "valueType": "string",
          "default": "var(--cc-primary-brand)"
        },
        {
          "key": "textColorField",
          "label": "Text",
          "valueType": "string",
          "default": "var(--cc-primary-text)"
        },
        {
          "key": "sendIconColorField",
          "label": "Send icon",
          "valueType": "string",
          "default": "var(--cc-primary-brand)"
        },
        {
          "key": "containerBackgroundColor",
          "label": "Background",
          "valueType": "string",
          "default": "var(--cc-surface1-surface)"
        },
        {
          "key": "borderColorContainer",
          "label": "Border",
          "valueType": "string",
          "default": "var(--cc-weak-border)"
        },
        {
          "key": "boxShadowContainer",
          "label": "Box shadow",
          "valueType": "string",
          "default": "#121212"
        },
        {
          "key": "borderRadius",
          "label": "Border radius",
          "valueType": "number",
          "default": "{{6}}"
        },
        {
          "key": "cssClass",
          "label": "CSS class",
          "default": ""
        }
      ],
      "events": [
        {
          "id": "onMessageSent",
          "label": "On message sent"
        },
        {
          "id": "onClearHistory",
          "label": "On history cleared"
        }
      ],
      "actions": [
        {
          "handle": "appendHistory",
          "displayName": "Append history",
          "params": [
            {
              "handle": "message",
              "displayName": "Message",
              "defaultValue": "{{{}}}",
              "type": "code"
            }
          ]
        },
        {
          "handle": "clearHistory",
          "displayName": "Clear history",
          "params": []
        },
        {
          "handle": "downloadChat",
          "displayName": "Download chat",
          "params": []
        },
        {
          "handle": "sendMessage",
          "displayName": "Send message",
          "params": [
            {
              "handle": "message",
              "displayName": "Message",
              "defaultValue": "{{{}}}",
              "type": "code"
            }
          ]
        },
        {
          "handle": "setError",
          "displayName": "Set error",
          "params": [
            {
              "handle": "error",
              "displayName": "Error",
              "defaultValue": "",
              "type": "code"
            }
          ]
        },
        {
          "handle": "setHistory",
          "displayName": "Set history",
          "params": [
            {
              "handle": "history",
              "displayName": "History",
              "defaultValue": "{{[]}}",
              "type": "code"
            }
          ]
        },
        {
          "handle": "setHistoryLoading",
          "displayName": "Set history loading",
          "params": [
            {
              "handle": "loading",
              "displayName": "Loading",
              "defaultValue": "{{false}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setInputDisable",
          "displayName": "Set input disable",
          "params": [
            {
              "handle": "disabled",
              "displayName": "Disabled",
              "defaultValue": "{{false}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setResponderAvatar",
          "displayName": "Set respondent avatar",
          "params": [
            {
              "handle": "avatar",
              "displayName": "Avatar",
              "defaultValue": "",
              "type": "code"
            }
          ]
        },
        {
          "handle": "setResponseLoading",
          "displayName": "Set response loading",
          "params": [
            {
              "handle": "loading",
              "displayName": "Loading",
              "defaultValue": "{{false}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setUserAvatar",
          "displayName": "Set user avatar",
          "params": [
            {
              "handle": "avatar",
              "displayName": "Avatar",
              "defaultValue": "",
              "type": "code"
            }
          ]
        },
        {
          "handle": "setVisibility",
          "displayName": "Set visibility",
          "params": [
            {
              "handle": "visible",
              "displayName": "Visible",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        }
      ],
      "exposedVariables": [
        {
          "name": "history",
          "default": []
        },
        {
          "name": "isHistoryLoading",
          "default": false
        },
        {
          "name": "isInputDisabled",
          "default": false
        },
        {
          "name": "isResponseLoading",
          "default": false
        },
        {
          "name": "isVisible",
          "default": true
        },
        {
          "name": "lastMessage",
          "default": {}
        },
        {
          "name": "lastResponse",
          "default": {}
        }
      ]
    }
  ],
  "unknown_types": []
}
