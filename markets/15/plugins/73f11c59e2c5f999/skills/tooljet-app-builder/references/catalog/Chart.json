{
  "components": [
    {
      "type": "Chart",
      "name": "Chart",
      "description": "Visualize data",
      "defaultSize": {
        "width": 20,
        "height": 400
      },
      "properties": [
        {
          "key": "title",
          "label": "Title",
          "valueType": "string",
          "default": "This title can be changed"
        },
        {
          "key": "data",
          "label": "Data",
          "valueType": "union",
          "valueTypes": [
            "string",
            "array"
          ],
          "default": "[\n    { \"x\": \"Jan\", \"y\": 100},\n    { \"x\": \"Feb\", \"y\": 80},\n    { \"x\": \"Mar\", \"y\": 40}\n  ]"
        },
        {
          "key": "loadingState",
          "label": "Loading state",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "markerColor",
          "label": "Marker color",
          "valueType": "string",
          "default": "var(--cc-primary-brand)"
        },
        {
          "key": "showAxes",
          "label": "Show axes",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "showGridLines",
          "label": "Show grid lines",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "type",
          "label": "Chart type",
          "valueType": "union",
          "valueTypes": [
            "string",
            "boolean",
            "number"
          ],
          "default": "line",
          "allowedValues": [
            "line",
            "bar",
            "pie"
          ]
        },
        {
          "key": "jsonDescription",
          "label": "Json Description",
          "valueType": "union",
          "valueTypes": [
            "string",
            "object"
          ],
          "default": "{ \"data\": [ { \"x\": [ \"Jan\", \"Feb\",…"
        },
        {
          "key": "plotFromJson",
          "label": "Use Plotly JSON schema",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "barmode",
          "label": "Bar mode",
          "default": "group",
          "allowedValues": [
            "stack",
            "group",
            "overlay",
            "relative"
          ]
        }
      ],
      "styles": [
        {
          "key": "backgroundColor",
          "label": "Background color",
          "valueType": "string",
          "default": "var(--cc-surface1-surface)"
        },
        {
          "key": "borderColor",
          "label": "Border color",
          "valueType": "string",
          "default": "var(--cc-default-border)"
        },
        {
          "key": "padding",
          "label": "Padding",
          "valueType": "union",
          "valueTypes": [
            "number",
            "string"
          ],
          "default": "50"
        },
        {
          "key": "borderRadius",
          "label": "Border radius",
          "valueType": "number",
          "default": "{{6}}"
        },
        {
          "key": "visibility",
          "label": "Visibility",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "disabledState",
          "label": "Disable",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "cssClass",
          "label": "CSS class",
          "default": ""
        }
      ],
      "events": [
        {
          "id": "onClick",
          "label": "On data point click"
        },
        {
          "id": "onDoubleClick",
          "label": "On double click"
        }
      ],
      "actions": [
        {
          "handle": "clearClickedPoint",
          "displayName": "Clear clicked point"
        }
      ],
      "exposedVariables": [
        {
          "name": "show",
          "default": null
        },
        {
          "name": "chartTitle",
          "default": null
        },
        {
          "name": "xAxisTitle",
          "default": null
        },
        {
          "name": "yAxisTitle",
          "default": null
        },
        {
          "name": "clickedDataPoint",
          "default": {}
        }
      ],
      "renderingHints": {
        "recommendedWidthCols": "≈13–15 for a compact few-category pie/donut; ≈20–24 for a categorical bar with longer labels",
        "maxPerContentRow": 2,
        "note": "Native title clips at common dashboard sizes — set title.value=\"\" and put a separate Text heading above the chart; enable a native title only after visual verification."
      }
    }
  ],
  "unknown_types": []
}
