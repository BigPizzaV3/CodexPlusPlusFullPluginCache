{
  "components": [
    {
      "type": "Navigation",
      "name": "Navigation",
      "description": "Create custom navigation menus",
      "defaultSize": {
        "width": 20,
        "height": 60
      },
      "properties": [
        {
          "key": "loadingState",
          "label": "Loading state",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "visibility",
          "label": "Visibility",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "dynamicHeight",
          "label": "Dynamic height",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "collapseWhenHidden",
          "label": "Collapse when hidden",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "disabledState",
          "label": "Disable",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "menuItems",
          "default": [
            {
              "id": "item1",
              "label": "Option 1",
              "icon": {
                "value": "IconArchive"
              },
              "iconVisibility": true,
              "visible": {
                "value": "{{false}}"
              },
              "disable": {
                "value": "{{false}}"
              },
              "isGroup": false
            },
            {
              "id": "item2",
              "label": "Option 2",
              "icon": {
                "value": "IconListDetails"
              },
              "iconVisibility": true,
              "visible": {
                "value": "{{false}}"
              },
              "disable": {
                "value": "{{false}}"
              },
              "isGroup": false
            },
            {
              "id": "group1",
              "label": "Group 1",
              "icon": {
                "value": "IconFolder"
              },
              "iconVisibility": true,
              "visible": {
                "value": "{{false}}"
              },
              "disable": {
                "value": "{{false}}"
              },
              "isGroup": true,
              "children": [
                {
                  "id": "item3",
                  "label": "Option 3",
                  "icon": {
                    "value": "IconFileCode"
                  },
                  "iconVisibility": true,
                  "visible": {
                    "value": "{{false}}"
                  },
                  "disable": {
                    "value": "{{false}}"
                  },
                  "isGroup": false
                },
                {
                  "id": "item4",
                  "label": "Option 4",
                  "icon": {
                    "value": "IconBulb"
                  },
                  "iconVisibility": true,
                  "visible": {
                    "value": "{{false}}"
                  },
                  "disable": {
                    "value": "{{false}}"
                  },
                  "isGroup": false
                }
              ]
            }
          ]
        }
      ],
      "styles": [
        {
          "key": "unselectedTextColor",
          "label": "Text",
          "valueType": "string",
          "default": "var(--cc-primary-text)"
        },
        {
          "key": "unselectedIconColor",
          "label": "Icon",
          "valueType": "string",
          "default": "var(--cc-default-icon)"
        },
        {
          "key": "hoverPillBackgroundColor",
          "label": "Hover pill background",
          "valueType": "string",
          "default": "var(--cc-surface3-surface)"
        },
        {
          "key": "selectedTextColor",
          "label": "Selected text",
          "valueType": "string",
          "default": "var(--cc-primary-brand)"
        },
        {
          "key": "selectedIconColor",
          "label": "Selected icon",
          "valueType": "string",
          "default": "var(--cc-primary-brand)"
        },
        {
          "key": "selectedPillBackgroundColor",
          "label": "Selected pill background",
          "valueType": "string",
          "default": "var(--cc-surface2-surface)"
        },
        {
          "key": "pillBorderRadius",
          "label": "Pill border radius",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ],
          "default": "6"
        },
        {
          "key": "orientation",
          "label": "Orientation",
          "valueType": "string",
          "default": "horizontal",
          "allowedValues": [
            "horizontal",
            "vertical"
          ]
        },
        {
          "key": "displayStyle",
          "label": "Style",
          "valueType": "string",
          "default": "textAndIcon",
          "allowedValues": [
            "textAndIcon",
            "textOnly",
            "iconOnly"
          ]
        },
        {
          "key": "navItemSize",
          "label": "Nav item size",
          "valueType": "string",
          "default": "equalWidth",
          "allowedValues": [
            "auto",
            "equalWidth"
          ]
        },
        {
          "key": "horizontalAlignment",
          "label": "Alignment",
          "valueType": "string",
          "default": "left",
          "allowedValues": [
            "left",
            "center",
            "right"
          ]
        },
        {
          "key": "subMenuAlignment",
          "label": "Sub menu alignment",
          "valueType": "string",
          "default": "left",
          "allowedValues": [
            "left",
            "center",
            "right"
          ]
        },
        {
          "key": "backgroundColor",
          "label": "Background",
          "valueType": "string",
          "default": "var(--cc-surface1-surface)"
        },
        {
          "key": "borderColor",
          "label": "Border",
          "valueType": "string",
          "default": "var(--cc-weak-border)"
        },
        {
          "key": "borderRadius",
          "label": "Border radius",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ],
          "default": "8"
        },
        {
          "key": "padding",
          "label": "Padding",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ],
          "default": "2"
        },
        {
          "key": "verticalAlignment",
          "default": "center"
        },
        {
          "key": "cssClass",
          "label": "CSS class",
          "default": ""
        }
      ],
      "events": [
        {
          "id": "onClick",
          "label": "On click"
        }
      ],
      "actions": [
        {
          "handle": "setVisibility",
          "displayName": "Set visibility",
          "params": [
            {
              "handle": "visibility",
              "displayName": "Value",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setDisable",
          "displayName": "Set disable",
          "params": [
            {
              "handle": "disable",
              "displayName": "Value",
              "defaultValue": "{{false}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setLoading",
          "displayName": "Set loading",
          "params": [
            {
              "handle": "loading",
              "displayName": "Value",
              "defaultValue": "{{false}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "selectItem",
          "displayName": "Select item",
          "params": [
            {
              "handle": "id",
              "displayName": "Item ID",
              "defaultValue": "",
              "type": "code"
            }
          ]
        },
        {
          "handle": "setItemVisibility",
          "displayName": "Set item visibility",
          "params": [
            {
              "handle": "id",
              "displayName": "Item ID",
              "defaultValue": "",
              "type": "code"
            },
            {
              "handle": "value",
              "displayName": "Value",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setItemDisable",
          "displayName": "Set item disable",
          "params": [
            {
              "handle": "id",
              "displayName": "Item ID",
              "defaultValue": "",
              "type": "code"
            },
            {
              "handle": "value",
              "displayName": "Value",
              "defaultValue": "{{false}}",
              "type": "toggle"
            }
          ]
        }
      ],
      "exposedVariables": [
        {
          "name": "selectedItem",
          "default": null
        },
        {
          "name": "previousSelectedItem",
          "default": null
        },
        {
          "name": "isVisible",
          "default": true
        },
        {
          "name": "isDisabled",
          "default": false
        },
        {
          "name": "isLoading",
          "default": false
        }
      ]
    }
  ],
  "unknown_types": []
}
