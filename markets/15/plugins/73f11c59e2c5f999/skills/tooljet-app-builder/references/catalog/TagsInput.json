{
  "components": [
    {
      "type": "TagsInput",
      "name": "TagsInput",
      "description": "Tag input with create, select, and delete functionality",
      "defaultSize": {
        "width": 10,
        "height": 40
      },
      "properties": [
        {
          "key": "label",
          "label": "Label",
          "valueType": "string",
          "default": "Tags"
        },
        {
          "key": "placeholder",
          "label": "Placeholder",
          "valueType": "string",
          "default": "Add or select a tag"
        },
        {
          "key": "advanced",
          "label": "Dynamic tags",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "value",
          "label": "Default value",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number",
            "boolean"
          ]
        },
        {
          "key": "schema",
          "label": "Schema",
          "default": "{{[ {label: 'Newport',value: 'newport',visible: true,default: false, disable:false},{label: 'New York',value: 'new_york',visible: true,default: false, disabl…"
        },
        {
          "key": "sort",
          "label": "Sort tags",
          "valueType": "string",
          "default": "none",
          "allowedValues": [
            "none",
            "asc",
            "desc"
          ]
        },
        {
          "key": "allowNewTags",
          "label": "Allow new tags",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "optionsLoadingState",
          "label": "Tags loading state",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "dynamicHeight",
          "label": "Dynamic height",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "enableSearch",
          "label": "Turn on search",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "serverSideSearch",
          "label": "Search type",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "loadingState",
          "label": "Loading state",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "visibility",
          "label": "Visibility",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "collapseWhenHidden",
          "label": "Collapse when hidden",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "disabledState",
          "label": "Disable",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "tooltipFormat",
          "label": "Tooltip",
          "default": "plainText",
          "allowedValues": [
            "plainText",
            "markdown",
            "html"
          ]
        },
        {
          "key": "tooltip",
          "label": "Tooltip",
          "valueType": "string",
          "default": ""
        },
        {
          "key": "values",
          "default": []
        },
        {
          "key": "options",
          "default": [
            {
              "label": "Newport",
              "value": "newport",
              "visible": {
                "value": true
              },
              "default": {
                "value": false
              }
            },
            {
              "label": "New York",
              "value": "new_york",
              "visible": {
                "value": true
              },
              "default": {
                "value": false
              }
            },
            {
              "label": "San Clemente",
              "value": "san_clemente",
              "visible": {
                "value": true
              },
              "default": {
                "value": false
              }
            }
          ]
        }
      ],
      "styles": [
        {
          "key": "labelColor",
          "label": "Color",
          "valueType": "string",
          "default": "var(--cc-primary-text)"
        },
        {
          "key": "labelFontSize",
          "label": "Size",
          "valueType": "number",
          "default": "{{12}}"
        },
        {
          "key": "alignment",
          "label": "Alignment",
          "valueType": "string",
          "default": "side",
          "allowedValues": [
            "side",
            "top"
          ]
        },
        {
          "key": "direction",
          "label": "Direction",
          "valueType": "string",
          "default": "left",
          "allowedValues": [
            "left",
            "right"
          ]
        },
        {
          "key": "auto",
          "label": "Width",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "fieldBackgroundColor",
          "label": "Background",
          "valueType": "string",
          "default": "var(--cc-surface1-surface)"
        },
        {
          "key": "fieldBorderColor",
          "label": "Border",
          "valueType": "string",
          "default": "var(--cc-default-border)"
        },
        {
          "key": "accentColor",
          "label": "Accent",
          "valueType": "string",
          "default": "var(--cc-primary-brand)"
        },
        {
          "key": "autoPickChipColor",
          "label": "Auto pick chip color",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "tagBackgroundColor",
          "label": "Chip color",
          "valueType": "string",
          "default": "var(--cc-surface3-surface)"
        },
        {
          "key": "selectedTextColor",
          "label": "Text color",
          "valueType": "string",
          "default": "var(--cc-primary-text)"
        },
        {
          "key": "errTextColor",
          "label": "Error text",
          "valueType": "string",
          "default": "var(--cc-error-systemStatus)"
        },
        {
          "key": "fieldBorderRadius",
          "label": "Border radius",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ],
          "default": "6"
        },
        {
          "key": "boxShadow",
          "label": "Box Shadow",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ],
          "default": "0px 0px 0px 0px #00000040"
        },
        {
          "key": "padding",
          "label": "Padding",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ],
          "default": "default",
          "allowedValues": [
            "default",
            "none"
          ]
        },
        {
          "key": "labelWidth",
          "default": "33"
        },
        {
          "key": "widthType",
          "default": "ofComponent"
        },
        {
          "key": "cssClass",
          "label": "CSS class",
          "default": ""
        }
      ],
      "events": [
        {
          "id": "onTagAdded",
          "label": "On tag added"
        },
        {
          "id": "onTagDeleted",
          "label": "On tag deleted"
        },
        {
          "id": "onFocus",
          "label": "On focus"
        },
        {
          "id": "onBlur",
          "label": "On blur"
        }
      ],
      "actions": [
        {
          "handle": "selectTags",
          "displayName": "Select Tags",
          "params": [
            {
              "handle": "tags",
              "displayName": "Tags"
            }
          ]
        },
        {
          "handle": "deselectTags",
          "displayName": "Deselect Tags",
          "params": [
            {
              "handle": "tags",
              "displayName": "Tags"
            }
          ]
        },
        {
          "handle": "clear",
          "displayName": "Clear"
        },
        {
          "handle": "setVisibility",
          "displayName": "Set visibility",
          "params": [
            {
              "handle": "setVisibility",
              "displayName": "Value",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setLoading",
          "displayName": "Set loading",
          "params": [
            {
              "handle": "setLoading",
              "displayName": "Value",
              "defaultValue": "{{false}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setDisable",
          "displayName": "Set disable",
          "params": [
            {
              "handle": "setDisable",
              "displayName": "Value",
              "defaultValue": "{{false}}",
              "type": "toggle"
            }
          ]
        }
      ],
      "exposedVariables": [
        {
          "name": "values",
          "default": []
        },
        {
          "name": "tags",
          "default": []
        },
        {
          "name": "newTagsAdded",
          "default": []
        },
        {
          "name": "selectedTags",
          "default": []
        }
      ]
