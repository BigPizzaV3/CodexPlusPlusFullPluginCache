{
  "components": [
    {
      "type": "ShadAccordion",
      "name": "ShadAccordion",
      "description": "Accordion (FAQ, grouped detail)",
      "defaultSize": {
        "width": 20,
        "height": 160
      },
      "properties": [
        {
          "key": "items",
          "label": "Items",
          "valueType": "array",
          "default": "{{[{ title: 'Inclusions', content: 'Crew, fuel and linen' }, { title: 'Cancellation', content: 'Free until 30 days before departure' }]}}"
        },
        {
          "key": "multiple",
          "label": "Several open at once",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "defaultOpen",
          "label": "Open by default (indexes)",
          "valueType": "array",
          "default": "{{[]}}"
        },
        {
          "key": "dynamicHeight",
          "label": "Dynamic height",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "loadingState",
          "label": "Loading state",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "loadingIndicator",
          "label": "Loading look",
          "valueType": "string",
          "default": "spinner",
          "allowedValues": [
            "spinner",
            "skeleton"
          ]
        },
        {
          "key": "visibility",
          "label": "Visibility",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "collapseWhenHidden",
          "label": "Collapse when hidden",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "disabledState",
          "label": "Disable",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "tooltipFormat",
          "label": "Tooltip",
          "default": "plainText",
          "allowedValues": [
            "plainText",
            "markdown",
            "html"
          ]
        },
        {
          "key": "tooltip",
          "label": "Tooltip",
          "valueType": "string",
          "default": ""
        }
      ],
      "styles": [
        {
          "key": "boxShadow",
          "label": "Box shadow",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ],
          "default": "0px 0px 0px 0px #00000040"
        },
        {
          "key": "titleColor",
          "label": "Item title color",
          "valueType": "string"
        },
        {
          "key": "textColor",
          "label": "Item content color",
          "valueType": "string"
        },
        {
          "key": "dividerColor",
          "label": "Divider color",
          "valueType": "string"
        },
        {
          "key": "iconColor",
          "label": "Chevron color",
          "valueType": "string"
        },
        {
          "key": "cssClass",
          "label": "CSS class",
          "default": ""
        }
      ],
      "events": [
        {
          "id": "onChange",
          "label": "On change"
        },
        {
          "id": "onExpand",
          "label": "On expand"
        },
        {
          "id": "onCollapse",
          "label": "On collapse"
        }
      ],
      "actions": [
        {
          "handle": "expand",
          "displayName": "Expand",
          "params": [
            {
              "handle": "index",
              "displayName": "Section index (empty for all)",
              "defaultValue": ""
            }
          ]
        },
        {
          "handle": "collapse",
          "displayName": "Collapse",
          "params": [
            {
              "handle": "index",
              "displayName": "Section index (empty for all)",
              "defaultValue": ""
            }
          ]
        },
        {
          "handle": "setVisibility",
          "displayName": "Set visibility",
          "params": [
            {
              "handle": "value",
              "displayName": "Value",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setDisable",
          "displayName": "Set disable",
          "params": [
            {
              "handle": "value",
              "displayName": "Value",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setLoading",
          "displayName": "Set loading",
          "params": [
            {
              "handle": "value",
              "displayName": "Value",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        }
      ],
      "exposedVariables": [
        {
          "name": "isVisible",
          "default": true
        },
        {
          "name": "isLoading",
          "default": false
        },
        {
          "name": "isDisabled",
          "default": false
        },
        {
          "name": "openIndexes",
          "default": []
        },
        {
          "name": "isExpanded",
          "default": false
        }
      ],
      "authoringHints": {
        "styles": "Every style falls back to the app theme, so set only what the design needs to blend in (its accent, surfaces, borders and text colours), taking colours from the app theme or brand, never the defaults of another product. Radii and sizes are px. Styles are the way to restyle a pack widget: a cssClass only takes effect with workspace Custom styles, and Tailwind class names the pack does not already use are not compiled, so do not rely on either; for a one-off visual a style cannot express, use an Html component. Bind loadingState to the query's isLoading (each widget draws a skeleton or spinner in its own shape); tooltip shows on hover."
      }
    }
  ],
  "unknown_types": []
}
