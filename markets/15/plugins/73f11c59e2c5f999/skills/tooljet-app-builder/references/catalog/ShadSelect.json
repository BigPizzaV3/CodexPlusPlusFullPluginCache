{
  "components": [
    {
      "type": "ShadSelect",
      "name": "ShadSelect",
      "description": "Select. Height: 64px with a label (label above the control), 36px without; add 24px for help text",
      "defaultSize": {
        "width": 10,
        "height": 70
      },
      "properties": [
        {
          "key": "label",
          "label": "Label",
          "valueType": "string",
          "default": "Label"
        },
        {
          "key": "description",
          "label": "Help text",
          "valueType": "string",
          "default": ""
        },
        {
          "key": "options",
          "label": "Options",
          "valueType": "array",
          "default": "{{[{ label: 'One', value: 1 }, { label: 'Two', value: 2 }]}}"
        },
        {
          "key": "allowClear",
          "label": "Allow clear",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "placeholder",
          "label": "Placeholder",
          "valueType": "string",
          "default": "Select an option"
        },
        {
          "key": "defaultValue",
          "label": "Default value",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number",
            "boolean",
            "array",
            "object"
          ],
          "default": ""
        },
        {
          "key": "loadingState",
          "label": "Loading state",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "visibility",
          "label": "Visibility",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "collapseWhenHidden",
          "label": "Collapse when hidden",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "disabledState",
          "label": "Disable",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "tooltipFormat",
          "label": "Tooltip",
          "default": "plainText",
          "allowedValues": [
            "plainText",
            "markdown",
            "html"
          ]
        },
        {
          "key": "tooltip",
          "label": "Tooltip",
          "valueType": "string",
          "default": ""
        }
      ],
      "styles": [
        {
          "key": "boxShadow",
          "label": "Box shadow",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ],
          "default": "0px 0px 0px 0px #00000040"
        },
        {
          "key": "labelColor",
          "label": "Label color",
          "valueType": "string"
        },
        {
          "key": "helpTextColor",
          "label": "Help text color",
          "valueType": "string"
        },
        {
          "key": "backgroundColor",
          "label": "Field background",
          "valueType": "string"
        },
        {
          "key": "textColor",
          "label": "Field text color",
          "valueType": "string"
        },
        {
          "key": "placeholderColor",
          "label": "Placeholder color",
          "valueType": "string"
        },
        {
          "key": "borderColor",
          "label": "Field border color",
          "valueType": "string"
        },
        {
          "key": "accentColor",
          "label": "Accent (focus ring, selection)",
          "valueType": "string"
        },
        {
          "key": "errorColor",
          "label": "Error color (message and border)",
          "valueType": "string"
        },
        {
          "key": "borderRadius",
          "label": "Field radius",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ]
        },
        {
          "key": "cssClass",
          "label": "CSS class",
          "default": ""
        }
      ],
      "events": [
        {
          "id": "onSelect",
          "label": "On select"
        },
        {
          "id": "onFocus",
          "label": "On focus"
        },
        {
          "id": "onBlur",
          "label": "On blur"
        }
      ],
      "actions": [
        {
          "handle": "selectOption",
          "displayName": "Select option",
          "params": [
            {
              "handle": "value",
              "displayName": "Value",
              "defaultValue": ""
            }
          ]
        },
        {
          "handle": "clear",
          "displayName": "Clear"
        },
        {
          "handle": "setFocus",
          "displayName": "Set focus"
        },
        {
          "handle": "setBlur",
          "displayName": "Set blur"
        },
        {
          "handle": "setVisibility",
          "displayName": "Set visibility",
          "params": [
            {
              "handle": "value",
              "displayName": "Value",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setDisable",
          "displayName": "Set disable",
          "params": [
            {
              "handle": "value",
              "displayName": "Value",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setLoading",
          "displayName": "Set loading",
          "params": [
            {
              "handle": "value",
              "displayName": "Value",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        }
      ],
      "exposedVariables": [
        {
          "name": "isVisible",
          "default": true
        },
        {
          "name": "isLoading",
          "default": false
        },
        {
          "name": "isDisabled",
          "default": false
        },
        {
          "name": "isValid",
          "default": true
        },
        {
          "name": "isMandatory",
          "default": false
        },
        {
          "name": "value",
          "default": ""
        },
        {
          "name": "selectedOption",
          "default": {}
        },
        {
          "name": "options",
          "default": []
        },
        {
          "name": "label",
          "default": ""
        }
      ],
      "authoringHints": {
        "styles": "Every style falls back to the app theme, so set only what the design needs to blend in (its accent, surfaces, borders and text colours), taking colours from the app theme or brand, never the defaults of another product. Radii and sizes are px. Styles are the way to restyle a pack widget: a cssClass only takes effect with workspace Custom styles, and Tailwind class names the pack does not already use are not compiled, so do not rely on either; for a one-off visual a style cannot express, use an Html component. Bind loadingState to the query's isLoading (each widget draws a skeleton or spinner in its own shape); tooltip shows on hover. accentColor colours the focus ring.",
        "validation": "Top-level validation (not properties), each key as {value}: mandatory (\"{{true}}\": a value must be picked, or the checkbox checked) and customRule. customRule fails when it resolves to a non-empty string, which becomes the message: {{components.<name>.value.includes(\"@\") ? \"\" : \"Enter an email\"}}. The message shows under the control after the user leaves it or a surrounding Form tries to submit; components.<name>.isValid and isMandatory are exposed, so gate a submit button with disabledState on them."
      }
    }
  ],
  "unknown_types": []
}
