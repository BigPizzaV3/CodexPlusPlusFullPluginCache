{
  "components": [
    {
      "type": "Lib_shadcn_Calendar",
      "name": "Lib_shadcn_Calendar",
      "description": "Calendar from the shadcn UI component library. Drawn at the height you give it.",
      "defaultSize": {
        "width": 10,
        "height": 320
      },
      "properties": [
        {
          "key": "mode",
          "label": "Selection",
          "valueType": "string",
          "default": "single",
          "allowedValues": [
            "single",
            "multiple",
            "range"
          ]
        },
        {
          "key": "selectedDate",
          "label": "Default date",
          "valueType": "string",
          "default": "",
          "description": "YYYY-MM-DD"
        },
        {
          "key": "selectedDates",
          "label": "Default dates (multiple)",
          "valueType": "array",
          "default": "{{[]}}"
        },
        {
          "key": "startDate",
          "label": "Range start",
          "valueType": "string",
          "default": ""
        },
        {
          "key": "endDate",
          "label": "Range end",
          "valueType": "string",
          "default": ""
        },
        {
          "key": "markers",
          "label": "Marked dates",
          "valueType": "array",
          "default": "{{[]}}",
          "description": "Dates to mark with a dot, e.g. ['2026-10-24']."
        },
        {
          "key": "minDate",
          "label": "Min date",
          "valueType": "string",
          "default": ""
        },
        {
          "key": "maxDate",
          "label": "Max date",
          "valueType": "string",
          "default": ""
        },
        {
          "key": "disabledDates",
          "label": "Disabled dates",
          "valueType": "array",
          "default": "{{[]}}"
        },
        {
          "key": "disabledDays",
          "label": "Disabled weekdays",
          "valueType": "array",
          "default": "{{[]}}",
          "description": "0 = Sunday … 6 = Saturday"
        },
        {
          "key": "weekStartsOn",
          "label": "Week starts on",
          "valueType": "string",
          "default": "sunday",
          "allowedValues": [
            "sunday",
            "monday",
            "saturday"
          ]
        },
        {
          "key": "numberOfMonths",
          "label": "Months shown",
          "valueType": "number",
          "default": "{{1}}"
        },
        {
          "key": "showOutsideDays",
          "label": "Show outside days",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "showBorder",
          "label": "Show border",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "visibleMonth",
          "label": "Visible Month",
          "valueType": "string",
          "default": ""
        },
        {
          "key": "visibility",
          "label": "Visibility",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "loadingState",
          "label": "Loading state",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "disabledState",
          "label": "Disable",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "dynamicHeight",
          "label": "Dynamic height",
          "valueType": "boolean",
          "default": "{{false}}"
        }
      ],
      "styles": [
        {
          "key": "accentColor",
          "label": "Selected",
          "valueType": "string"
        },
        {
          "key": "backgroundColor",
          "label": "Background",
          "valueType": "string"
        },
        {
          "key": "textColor",
          "label": "Text",
          "valueType": "string"
        },
        {
          "key": "markerColor",
          "label": "Marker",
          "valueType": "string"
        },
        {
          "key": "boxShadow",
          "label": "Box shadow",
          "valueType": "string"
        }
      ],
      "events": [
        {
          "id": "onSelect",
          "label": "On select"
        },
        {
          "id": "onMonthChanged",
          "label": "On month changed"
        }
      ],
      "actions": [
        {
          "handle": "selectDate",
          "displayName": "Select date",
          "params": [
            {
              "handle": "date",
              "displayName": "Date (YYYY-MM-DD)"
            }
          ]
        },
        {
          "handle": "clear",
          "displayName": "Clear"
        },
        {
          "handle": "setMonth",
          "displayName": "Show month",
          "params": [
            {
              "handle": "month",
              "displayName": "Month (YYYY-MM)"
            }
          ]
        },
        {
          "handle": "setVisibility",
          "displayName": "Set visibility",
          "params": [
            {
              "handle": "visibility",
              "displayName": "Value",
              "defaultValue": "{{false}}"
            }
          ]
        },
        {
          "handle": "setLoading",
          "displayName": "Set loading",
          "params": [
            {
              "handle": "loading",
              "displayName": "Value",
              "defaultValue": "{{false}}"
            }
          ]
        },
        {
          "handle": "setDisable",
          "displayName": "Set disable",
          "params": [
            {
              "handle": "disable",
              "displayName": "Value",
              "defaultValue": "{{false}}"
            }
          ]
        }
      ],
      "exposedVariables": [
        {
          "name": "mode",
          "default": "single"
        },
        {
          "name": "selectedDate",
          "default": ""
        },
        {
          "name": "selectedDates",
          "default": []
        },
        {
          "name": "startDate",
          "default": ""
        },
        {
          "name": "endDate",
          "default": ""
        },
        {
          "name": "markers",
          "default": []
        },
        {
          "name": "minDate",
          "default": ""
        },
        {
          "name": "maxDate",
          "default": ""
        },
        {
          "name": "disabledDates",
          "default": []
        },
        {
          "name": "disabledDays",
          "default": []
        },
        {
          "name": "weekStartsOn",
          "default": "sunday"
        },
        {
          "name": "numberOfMonths",
          "default": 1
        },
        {
          "name": "showOutsideDays",
          "default": true
        },
        {
          "name": "showBorder",
          "default": true
        },
        {
          "name": "visibleMonth",
          "default": ""
        },
        {
          "name": "isVisible",
          "default": true
        },
        {
          "name": "isLoading",
          "default": false
        },
        {
          "name": "isDisabled",
          "default": false
        }
      ]
    }
  ],
  "unknown_types": []
}
