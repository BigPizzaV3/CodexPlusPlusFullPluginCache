        {
          "name": "showIcon",
          "default": true
        },
        {
          "name": "dismissible",
          "default": false
        },
        {
          "name": "dismissed",
          "default": false
        },
        {
          "name": "isVisible",
          "default": true
        },
        {
          "name": "isLoading",
          "default": false
        },
        {
          "name": "isDisabled",
          "default": false
        }
      ]
