{
  "components": [
    {
      "type": "Lib_shadcn_Alert",
      "name": "Lib_shadcn_Alert",
      "description": "Alert from the shadcn UI component library. Sizes to its content in the app (Dynamic height on).",
      "defaultSize": {
        "width": 16,
        "height": 80
      },
      "properties": [
        {
          "key": "title",
          "label": "Title",
          "valueType": "string",
          "default": "Heads up!"
        },
        {
          "key": "description",
          "label": "Description",
          "valueType": "string",
          "default": "Something here needs your attention."
        },
        {
          "key": "variant",
          "label": "Variant",
          "valueType": "string",
          "default": "default",
          "allowedValues": [
            "default",
            "info",
            "success",
            "warning",
            "destructive"
          ]
        },
        {
          "key": "showIcon",
          "label": "Show icon",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "dismissible",
          "label": "Dismissible",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "dismissed",
          "label": "Dismissed",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "visibility",
          "label": "Visibility",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "loadingState",
          "label": "Loading state",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "disabledState",
          "label": "Disable",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "dynamicHeight",
          "label": "Dynamic height",
          "valueType": "boolean",
          "default": "{{true}}"
        }
      ],
      "styles": [
        {
          "key": "backgroundColor",
          "label": "Background",
          "valueType": "string"
        },
        {
          "key": "textColor",
          "label": "Text",
          "valueType": "string"
        },
        {
          "key": "borderColor",
          "label": "Border",
          "valueType": "string"
        },
        {
          "key": "boxShadow",
          "label": "Box shadow",
          "valueType": "string"
        }
      ],
      "events": [
        {
          "id": "onDismiss",
          "label": "On dismiss"
        }
      ],
      "actions": [
        {
          "handle": "show",
          "displayName": "Show"
        },
        {
          "handle": "setTitle",
          "displayName": "Set title",
          "params": [
            {
              "handle": "title",
              "displayName": "Title"
            }
          ]
        },
        {
          "handle": "setDescription",
          "displayName": "Set description",
          "params": [
            {
              "handle": "description",
              "displayName": "Description"
            }
          ]
        },
        {
          "handle": "setVariant",
          "displayName": "Set variant",
          "params": [
            {
              "handle": "variant",
              "displayName": "Variant"
            }
          ]
        },
        {
          "handle": "dismiss",
          "displayName": "Dismiss"
        },
        {
          "handle": "setVisibility",
          "displayName": "Set visibility",
          "params": [
            {
              "handle": "visibility",
              "displayName": "Value",
              "defaultValue": "{{false}}"
            }
          ]
        },
        {
          "handle": "setLoading",
          "displayName": "Set loading",
          "params": [
            {
              "handle": "loading",
              "displayName": "Value",
              "defaultValue": "{{false}}"
            }
          ]
        },
        {
          "handle": "setDisable",
