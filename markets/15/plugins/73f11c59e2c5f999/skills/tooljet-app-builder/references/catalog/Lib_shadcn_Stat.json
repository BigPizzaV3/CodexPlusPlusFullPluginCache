{
  "components": [
    {
      "type": "Lib_shadcn_Stat",
      "name": "Lib_shadcn_Stat",
      "description": "Stat from the shadcn UI component library. A KPI card: label, value (a number; valueFormat auto/number/currency/percent, currency), change with trend up/down/neutral and changeLabel. Sizes to its content in the app (Dynamic height on).",
      "defaultSize": {
        "width": 10,
        "height": 120
      },
      "properties": [
        {
          "key": "label",
          "label": "Label",
          "valueType": "string",
          "default": "Total revenue"
        },
        {
          "key": "value",
          "label": "Value",
          "valueType": "string",
          "default": "$45,231.89"
        },
        {
          "key": "change",
          "label": "Change",
          "valueType": "string",
          "default": ""
        },
        {
          "key": "valueFormat",
          "label": "Value format",
          "valueType": "string",
          "default": "auto",
          "allowedValues": [
            "auto",
            "number",
            "currency",
            "percent",
            "text"
          ]
        },
        {
          "key": "currency",
          "label": "Currency",
          "valueType": "string",
          "default": "USD"
        },
        {
          "key": "trend",
          "label": "Trend",
          "valueType": "string",
          "default": "up",
