            "up",
            "down",
            "neutral"
          ]
        },
        {
          "key": "changeLabel",
          "label": "Change context",
          "valueType": "string",
          "default": ""
        },
        {
          "key": "icon",
          "label": "Icon",
          "valueType": "string",
          "default": "none",
          "allowedValues": [
            "dollar",
            "users",
            "activity",
            "card",
            "none"
          ]
        },
        {
          "key": "visibility",
          "label": "Visibility",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "loadingState",
          "label": "Loading state",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "disabledState",
          "label": "Disable",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "dynamicHeight",
          "label": "Dynamic height",
          "valueType": "boolean",
          "default": "{{true}}"
