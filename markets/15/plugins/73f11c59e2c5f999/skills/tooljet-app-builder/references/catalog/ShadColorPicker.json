          "default": "{{false}}"
        },
        {
          "key": "triggerStyle",
          "label": "Trigger",
          "valueType": "string",
          "default": "field",
          "allowedValues": [
            "field",
            "swatch"
          ]
        },
        {
          "key": "dynamicHeight",
