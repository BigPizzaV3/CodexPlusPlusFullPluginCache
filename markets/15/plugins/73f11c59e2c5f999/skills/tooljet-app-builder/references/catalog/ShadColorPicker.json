{
  "components": [
    {
      "type": "ShadColorPicker",
      "name": "ShadColorPicker",
      "description": "Color picker: a swatch-and-hex field opening a popover with a saturation/hue picker, a hex input and preset swatches (array of hex). Exposes value (#rrggbb, or #rrggbbaa with allowAlpha), selectedColorRGB and selectedColorRGBA. Height: 64px with a label, 36px without",
      "defaultSize": {
        "width": 8,
        "height": 70
      },
      "properties": [
        {
          "key": "label",
          "label": "Label",
          "valueType": "string",
          "default": "Brand color"
        },
        {
          "key": "description",
          "label": "Help text",
          "valueType": "string",
          "default": ""
        },
        {
          "key": "defaultValue",
          "label": "Default color",
          "valueType": "string",
          "default": "#6366f1"
        },
        {
          "key": "placeholder",
          "label": "Placeholder",
          "valueType": "string",
          "default": "Pick a color"
        },
        {
          "key": "swatches",
          "label": "Preset swatches",
          "valueType": "array",
          "default": "{{['#0f172a', '#64748b', '#ef4444', '#f97316', '#f59e0b', '#eab308', '#84cc16', '#22c55e', '#10b981', '#14b8a6', '#06b6d4', '#3b82f6', '#6366f1', '#8b5cf6',…"
        },
        {
          "key": "showSwatches",
          "label": "Show swatches",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "showPicker",
          "label": "Show saturation and hue picker",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "allowAlpha",
          "label": "Allow transparency (alpha)",
