{
  "components": [
    {
      "type": "Lib_shadcn_Tags",
      "name": "Lib_shadcn_Tags",
      "description": "Tags from the shadcn UI component library. Sizes to its content in the app (Dynamic height on).",
      "defaultSize": {
        "width": 12,
        "height": 30
      },
      "properties": [
        {
          "key": "tags",
          "label": "Tags",
          "valueType": "array",
          "default": "{{[\"Design\",\"Engineering\",\"Q4\"]}}",
          "description": "Strings or { label, color } objects."
        },
        {
          "key": "tagColors",
          "label": "Tag colors",
          "valueType": "object",
          "default": "{{{}}}",
          "description": "Map of tag → color."
        },
        {
          "key": "variant",
          "label": "Variant",
          "valueType": "string",
          "default": "soft",
          "allowedValues": [
            "soft",
            "solid",
            "outline"
          ]
        },
        {
          "key": "size",
          "label": "Size",
          "valueType": "string",
          "default": "default",
          "allowedValues": [
            "sm",
            "default"
          ]
        },
        {
          "key": "overflow",
          "label": "Overflow",
          "valueType": "string",
          "default": "wrap",
          "allowedValues": [
            "wrap",
            "scroll"
          ]
        },
        {
          "key": "pill",
          "label": "Pill shape",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "lastClickedTag",
          "label": "Last Clicked Tag",
          "valueType": "string",
          "default": ""
        },
        {
          "key": "visibility",
          "label": "Visibility",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "loadingState",
          "label": "Loading state",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "disabledState",
          "label": "Disable",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "dynamicHeight",
          "label": "Dynamic height",
          "valueType": "boolean",
          "default": "{{true}}"
        }
      ],
      "styles": [
        {
          "key": "backgroundColor",
          "label": "Default color",
          "valueType": "string"
        },
        {
          "key": "boxShadow",
          "label": "Box shadow",
          "valueType": "string"
        }
      ],
      "events": [
        {
          "id": "onTagClicked",
          "label": "On tag clicked"
        }
      ],
      "actions": [
        {
          "handle": "setVisibility",
          "displayName": "Set visibility",
          "params": [
            {
              "handle": "visibility",
              "displayName": "Value",
              "defaultValue": "{{false}}"
            }
          ]
        },
        {
          "handle": "setLoading",
          "displayName": "Set loading",
          "params": [
            {
              "handle": "loading",
              "displayName": "Value",
              "defaultValue": "{{false}}"
            }
          ]
        },
        {
          "handle": "setDisable",
          "displayName": "Set disable",
          "params": [
            {
              "handle": "disable",
              "displayName": "Value",
              "defaultValue": "{{false}}"
            }
          ]
        }
      ],
      "exposedVariables": [
        {
          "name": "tags",
          "default": [
            "Design",
            "Engineering",
            "Q4"
          ]
        },
        {
          "name": "tagColors",
          "default": {}
        },
        {
          "name": "variant",
          "default": "soft"
        },
        {
          "name": "size",
          "default": "default"
        },
        {
          "name": "overflow",
          "default": "wrap"
        },
        {
          "name": "pill",
          "default": false
        },
        {
          "name": "lastClickedTag",
          "default": ""
        },
        {
          "name": "isVisible",
          "default": true
        },
        {
          "name": "isLoading",
          "default": false
        },
        {
          "name": "isDisabled",
          "default": false
        }
      ]
    }
  ],
  "unknown_types": []
}
