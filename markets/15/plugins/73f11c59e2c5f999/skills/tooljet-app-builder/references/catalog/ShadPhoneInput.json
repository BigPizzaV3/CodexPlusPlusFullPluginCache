{
  "components": [
    {
      "type": "ShadPhoneInput",
      "name": "ShadPhoneInput",
      "description": "Phone number input: a country picker (flag and calling code; searchable list) attached to the number box, which formats as you type. Exposes value (E.164, e.g. '+14155550123', '' when empty), country ('US'), countryCode ('+1'), formattedValue ('+1 415 555 0123') and isValidNumber; isValid is false for an invalid number. defaultCountry is an ISO code; onlyCountries limits the list (['US', 'CA']). Height: 64px with a label (label above the control), 36px without; add 24px for help text or a validation message",
      "defaultSize": {
        "width": 10,
        "height": 70
      },
      "properties": [
        {
          "key": "label",
          "label": "Label",
          "valueType": "string",
          "default": "Phone number"
        },
        {
          "key": "description",
          "label": "Help text",
          "valueType": "string",
          "default": ""
        },
        {
          "key": "placeholder",
          "label": "Placeholder",
          "valueType": "string",
          "default": "Enter phone number"
        },
        {
          "key": "defaultValue",
          "label": "Default value (E.164 or a national number)",
          "valueType": "string",
          "default": ""
        },
        {
          "key": "defaultCountry",
          "label": "Default country (ISO code)",
          "valueType": "string",
          "default": "US"
        },
        {
          "key": "onlyCountries",
          "label": "Countries offered (ISO codes; empty: all)",
          "valueType": "array",
          "default": "{{[]}}"
        },
        {
          "key": "isCountryChangeEnabled",
          "label": "Enable country change",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "showFlag",
          "label": "Show country flag",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "showClearBtn",
          "label": "Show clear button",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "loadingState",
          "label": "Loading state",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "visibility",
          "label": "Visibility",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "collapseWhenHidden",
          "label": "Collapse when hidden",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "disabledState",
          "label": "Disable",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "tooltipFormat",
          "label": "Tooltip",
          "default": "plainText",
          "allowedValues": [
            "plainText",
            "markdown",
            "html"
          ]
        },
        {
          "key": "tooltip",
          "label": "Tooltip",
          "valueType": "string",
          "default": ""
        }
      ],
      "styles": [
        {
          "key": "boxShadow",
          "label": "Box shadow",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ],
          "default": "0px 0px 0px 0px #00000040"
        },
        {
          "key": "labelColor",
          "label": "Label color",
          "valueType": "string"
        },
        {
          "key": "helpTextColor",
          "label": "Help text color",
          "valueType": "string"
        },
        {
          "key": "backgroundColor",
          "label": "Field background",
          "valueType": "string"
        },
        {
          "key": "textColor",
          "label": "Field text color",
          "valueType": "string"
        },
        {
          "key": "placeholderColor",
          "label": "Placeholder color",
          "valueType": "string"
        },
        {
          "key": "borderColor",
          "label": "Field border color",
          "valueType": "string"
        },
        {
          "key": "accentColor",
          "label": "Accent (focus ring, selection)",
          "valueType": "string"
        },
        {
          "key": "errorColor",
          "label": "Error color (message and border)",
          "valueType": "string"
        },
        {
          "key": "borderRadius",
          "label": "Field radius",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ]
        },
        {
          "key": "countryBackgroundColor",
          "label": "Country button background",
          "valueType": "string"
        },
        {
          "key": "countryTextColor",
          "label": "Country button text color",
          "valueType": "string"
        },
        {
          "key": "popoverBackgroundColor",
          "label": "Popover background",
          "valueType": "string"
        },
        {
          "key": "popoverTextColor",
          "label": "Popover text color",
          "valueType": "string"
        },
        {
          "key": "hoverColor",
          "label": "Popover item hover background",
          "valueType": "string"
        },
        {
          "key": "selectedTextColor",
          "label": "Selected item text color (on the accent)",
          "valueType": "string"
        },
        {
          "key": "cssClass",
          "label": "CSS class",
          "default": ""
        }
      ],
      "events": [
        {
          "id": "onChange",
          "label": "On change"
        },
        {
          "id": "onEnterPressed",
          "label": "On enter pressed"
        },
        {
          "id": "onFocus",
          "label": "On focus"
        },
        {
          "id": "onBlur",
          "label": "On blur"
        }
      ],
      "actions": [
        {
          "handle": "setValue",
          "displayName": "Set value",
          "params": [
            {
              "handle": "value",
              "displayName": "Number (E.164 or national)",
              "defaultValue": ""
            },
            {
              "handle": "country",
              "displayName": "Country (optional ISO code)",
              "defaultValue": ""
            }
          ]
        },
        {
          "handle": "setCountryCode",
          "displayName": "Set country code",
          "params": [
            {
              "handle": "countryCode",
              "displayName": "Country (ISO code or +calling code)",
              "defaultValue": "US"
            }
          ]
        },
        {
          "handle": "clear",
          "displayName": "Clear"
        },
        {
          "handle": "setFocus",
          "displayName": "Set focus"
        },
        {
          "handle": "setBlur",
          "displayName": "Set blur"
        },
        {
          "handle": "setVisibility",
          "displayName": "Set visibility",
          "params": [
            {
              "handle": "value",
              "displayName": "Value",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setDisable",
          "displayName": "Set disable",
          "params": [
            {
              "handle": "value",
              "displayName": "Value",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setLoading",
          "displayName": "Set loading",
          "params": [
            {
              "handle": "value",
              "displayName": "Value",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        }
      ],
      "exposedVariables": [
        {
          "name": "isVisible",
          "default": true
        },
        {
          "name": "isLoading",
          "default": false
        },
        {
          "name": "isDisabled",
          "default": false
        },
        {
          "name": "isValid",
          "default": true
        },
        {
          "name": "isMandatory",
          "default": false
        },
        {
          "name": "value",
          "default": ""
        },
        {
          "name": "country",
          "default": "US"
        },
        {
          "name": "countryCode",
          "default": "+1"
        },
        {
          "name": "formattedValue",
          "default": ""
        },
        {
          "name": "isValidNumber",
          "default": false
        },
        {
          "name": "label",
          "default": ""
        }
      ],
      "authoringHints": {
        "styles": "Every style falls back to the app theme, so set only what the design needs to blend in (its accent, surfaces, borders and text colours), taking colours from the app theme or brand, never the defaults of another product. Radii and sizes are px. Styles are the way to restyle a pack widget: a cssClass only takes effect with workspace Custom styles, and Tailwind class names the pack does not already use are not compiled, so do not rely on either; for a one-off visual a style cannot express, use an Html component. Bind loadingState to the query's isLoading (each widget draws a skeleton or spinner in its own shape); tooltip shows on hover.",
        "usage": "Save value (E.164, e.g. +442071234567); isValid is false for an invalid number, so gate the submit button on it. defaultCountry is an ISO code. Height 64 with a label."
      }
    }
  ],
  "unknown_types": []
}
