{
  "components": [
    {
      "type": "ShadMultiselect",
      "name": "ShadMultiselect",
      "description": "Multi-select combobox: picked options show as removable chips in the field (+N past maxVisibleChips), with search and select all. options like the Combobox; defaultValue is an array of values; exposes values (array) and selectedOptions. Height: 64px with a label, 36px without (one row of chips; grows with dynamic height)",
      "defaultSize": {
        "width": 10,
        "height": 70
      },
      "properties": [
        {
          "key": "label",
          "label": "Label",
          "valueType": "string",
          "default": "Teams"
        },
        {
          "key": "description",
          "label": "Help text",
          "valueType": "string",
          "default": ""
        },
        {
          "key": "options",
          "label": "Options",
          "valueType": "array",
          "default": "{{[{ label: 'Design', value: 'design' }, { label: 'Engineering', value: 'engineering' }, { label: 'Marketing', value: 'marketing' }, { label: 'Sales', value:…"
        },
        {
          "key": "placeholder",
          "label": "Placeholder",
          "valueType": "string",
          "default": "Select teams..."
        },
        {
          "key": "searchPlaceholder",
          "label": "Search placeholder",
          "valueType": "string",
          "default": "Search teams..."
        },
        {
          "key": "emptyText",
          "label": "No results text",
          "valueType": "string",
          "default": "No team found."
        },
        {
          "key": "showSearch",
          "label": "Show search",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "serverSideSearch",
          "label": "Server-side search (options already filtered by searchText)",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "showClearBtn",
          "label": "Show clear button",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "optionsLoadingState",
          "label": "Options loading state",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "defaultValue",
          "label": "Default values",
          "valueType": "array",
          "default": "{{['design', 'engineering']}}"
        },
        {
          "key": "showSelectAll",
          "label": "Show select all",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "maxVisibleChips",
          "label": "Max visible chips (0 shows all)",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ],
          "default": "{{3}}"
        },
        {
          "key": "maxSelections",
          "label": "Max selections (0 for no limit)",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ],
          "default": "{{0}}"
        },
        {
          "key": "dynamicHeight",
          "label": "Dynamic height",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "loadingState",
          "label": "Loading state",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "visibility",
          "label": "Visibility",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "collapseWhenHidden",
          "label": "Collapse when hidden",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "disabledState",
          "label": "Disable",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "tooltipFormat",
          "label": "Tooltip",
          "default": "plainText",
          "allowedValues": [
            "plainText",
            "markdown",
            "html"
          ]
        },
        {
          "key": "tooltip",
          "label": "Tooltip",
          "valueType": "string",
          "default": ""
        }
      ],
      "styles": [
        {
          "key": "boxShadow",
          "label": "Box shadow",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ],
          "default": "0px 0px 0px 0px #00000040"
        },
        {
          "key": "labelColor",
          "label": "Label color",
          "valueType": "string"
        },
        {
          "key": "helpTextColor",
          "label": "Help text color",
          "valueType": "string"
        },
        {
          "key": "backgroundColor",
          "label": "Field background",
          "valueType": "string"
        },
        {
          "key": "textColor",
          "label": "Field text color",
          "valueType": "string"
        },
        {
          "key": "placeholderColor",
          "label": "Placeholder color",
          "valueType": "string"
        },
        {
          "key": "borderColor",
          "label": "Field border color",
          "valueType": "string"
        },
        {
          "key": "accentColor",
          "label": "Accent (focus ring, checks)",
          "valueType": "string"
        },
        {
          "key": "errorColor",
          "label": "Error color (message and border)",
          "valueType": "string"
        },
        {
          "key": "borderRadius",
          "label": "Field radius",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ]
        },
        {
          "key": "chipBackgroundColor",
          "label": "Chip background",
          "valueType": "string"
        },
        {
          "key": "chipTextColor",
          "label": "Chip text color",
          "valueType": "string"
        },
        {
          "key": "menuBackgroundColor",
          "label": "Menu background",
          "valueType": "string"
        },
        {
          "key": "menuTextColor",
          "label": "Menu text color",
          "valueType": "string"
        },
        {
          "key": "optionHoverColor",
          "label": "Highlighted option background",
          "valueType": "string"
        },
        {
          "key": "cssClass",
          "label": "CSS class",
          "default": ""
        }
      ],
      "events": [
        {
          "id": "onSelect",
          "label": "On select"
        },
        {
          "id": "onSearchTextChanged",
          "label": "On search text changed"
        },
        {
          "id": "onFocus",
          "label": "On focus"
        },
        {
          "id": "onBlur",
          "label": "On blur"
        }
      ],
      "actions": [
        {
          "handle": "selectOptions",
          "displayName": "Select options",
          "params": [
            {
              "handle": "values",
              "displayName": "Values",
              "defaultValue": "{{[]}}"
            }
          ]
        },
        {
          "handle": "deselectOptions",
          "displayName": "Deselect options",
          "params": [
            {
              "handle": "values",
              "displayName": "Values",
              "defaultValue": "{{[]}}"
            }
          ]
        },
        {
          "handle": "clear",
          "displayName": "Clear"
        },
        {
          "handle": "setFocus",
          "displayName": "Set focus"
        },
        {
          "handle": "setBlur",
          "displayName": "Set blur"
        },
        {
          "handle": "setVisibility",
          "displayName": "Set visibility",
          "params": [
            {
              "handle": "value",
              "displayName": "Value",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setDisable",
          "displayName": "Set disable",
          "params": [
            {
              "handle": "value",
              "displayName": "Value",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setLoading",
          "displayName": "Set loading",
          "params": [
            {
              "handle": "value",
              "displayName": "Value",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        }
      ],
      "exposedVariables": [
        {
          "name": "isVisible",
          "default": true
        },
        {
          "name": "isLoading",
          "default": false
        },
        {
          "name": "isDisabled",
          "default": false
        },
        {
          "name": "isValid",
          "default": true
        },
        {
          "name": "isMandatory",
          "default": false
        },
        {
          "name": "values",
          "default": []
        },
        {
          "name": "selectedOptions",
          "default": []
        },
        {
          "name": "searchText",
          "default": ""
        },
        {
          "name": "options",
          "default": []
        },
        {
          "name": "label",
          "default": ""
        }
      ],
      "authoringHints": {
        "styles": "Every style falls back to the app theme, so set only what the design needs to blend in (its accent, surfaces, borders and text colours), taking colours from the app theme or brand, never the defaults of another product. Radii and sizes are px. Styles are the way to restyle a pack widget: a cssClass only takes effect with workspace Custom styles, and Tailwind class names the pack does not already use are not compiled, so do not rely on either; for a one-off visual a style cannot express, use an Html component. Bind loadingState to the query's isLoading (each widget draws a skeleton or spinner in its own shape); tooltip shows on hover.",
        "usage": "options as for ShadCombobox; read components.<name>.values (an array) or selectedOptions. Height 64 with a label."
      }
    }
  ],
  "unknown_types": []
}
