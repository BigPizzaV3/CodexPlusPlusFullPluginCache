{
  "components": [
    {
      "type": "ShadCarousel",
      "name": "ShadCarousel",
      "description": "Carousel of slides [{ image, title?, description?, link? }] (or image URLs) with arrows and dots, loop, autoplay (interval ms, pauses on hover), slidesPerView 1 to 4, aspectRatio ('16/9', '4/3', '1/1', '21/9' or 'fill' to fill the widget's height), imageFit cover or contain, captions as an overlay or below. Exposed currentIndex, currentSlide and clickedSlide (with its index); events onSlideChanged, onSlideClicked (a slide's link also opens in a new tab); actions next, previous, goTo(index). Height follows the width and ratio (+28px for dots, +52px for captions below)",
      "defaultSize": {
        "width": 20,
        "height": 410
      },
      "properties": [
        {
          "key": "slides",
          "label": "Slides",
          "valueType": "array",
          "default": "{{[{ image: 'https://picsum.photos/seed/tj-coast/1200/675', title: 'Coastal routes', description: 'Plan deliveries along the shoreline' }, { image: 'https://…"
        },
        {
          "key": "defaultIndex",
          "label": "Start at slide (0-based)",
          "valueType": "number",
          "default": "{{0}}"
        },
        {
          "key": "aspectRatio",
          "label": "Aspect ratio",
          "valueType": "string",
          "default": "16/9",
          "allowedValues": [
            "16/9",
            "4/3",
            "3/2",
            "1/1",
            "21/9",
            "3/4",
            "fill"
          ]
        },
        {
          "key": "imageFit",
          "label": "Image fit",
          "valueType": "string",
          "default": "cover",
          "allowedValues": [
            "cover",
            "contain"
          ]
        },
        {
          "key": "captionPosition",
          "label": "Caption",
          "valueType": "string",
          "default": "overlay",
          "allowedValues": [
            "overlay",
            "below",
            "none"
          ]
        },
        {
          "key": "slidesPerView",
          "label": "Slides per view (1 to 4)",
          "valueType": "number",
          "default": "{{1}}"
        },
        {
          "key": "showArrows",
          "label": "Show arrows",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "showDots",
          "label": "Show dots",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "loop",
          "label": "Loop",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "autoplay",
          "label": "Autoplay",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "interval",
          "label": "Autoplay interval (ms)",
          "valueType": "number",
          "default": "{{5000}}"
        },
        {
          "key": "pauseOnHover",
          "label": "Pause on hover",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "dynamicHeight",
          "label": "Dynamic height",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "loadingState",
          "label": "Loading state",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "loadingIndicator",
          "label": "Loading look",
          "valueType": "string",
          "default": "spinner",
          "allowedValues": [
            "spinner",
            "skeleton"
          ]
        },
        {
          "key": "visibility",
          "label": "Visibility",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "collapseWhenHidden",
          "label": "Collapse when hidden",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "disabledState",
          "label": "Disable",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "tooltipFormat",
          "label": "Tooltip",
          "default": "plainText",
          "allowedValues": [
            "plainText",
            "markdown",
            "html"
          ]
        },
        {
          "key": "tooltip",
          "label": "Tooltip",
          "valueType": "string",
          "default": ""
        }
      ],
      "styles": [
        {
          "key": "boxShadow",
          "label": "Box shadow",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ],
          "default": "0px 0px 0px 0px #00000040"
        },
        {
          "key": "slideBackgroundColor",
          "label": "Slide background",
          "valueType": "string"
        },
        {
          "key": "arrowBackgroundColor",
          "label": "Arrow background",
          "valueType": "string"
        },
        {
          "key": "arrowColor",
          "label": "Arrow icon color",
          "valueType": "string"
        },
        {
          "key": "dotColor",
          "label": "Dot color",
          "valueType": "string"
        },
        {
          "key": "activeDotColor",
          "label": "Active dot color",
          "valueType": "string"
        },
        {
          "key": "captionBackgroundColor",
          "label": "Caption overlay background",
          "valueType": "string"
        },
        {
          "key": "captionTextColor",
          "label": "Caption overlay text color",
          "valueType": "string"
        },
        {
          "key": "titleColor",
          "label": "Caption title color (below)",
          "valueType": "string"
        },
        {
          "key": "descriptionColor",
          "label": "Caption description color (below)",
          "valueType": "string"
        },
        {
          "key": "borderRadius",
          "label": "Slide radius",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ]
        },
        {
          "key": "gap",
          "label": "Gap between slides (px)",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ]
        },
        {
          "key": "cssClass",
          "label": "CSS class",
          "default": ""
        }
      ],
      "events": [
        {
          "id": "onSlideChanged",
          "label": "On slide changed"
        },
        {
          "id": "onSlideClicked",
          "label": "On slide clicked"
        }
      ],
      "actions": [
        {
          "handle": "next",
          "displayName": "Next slide"
        },
        {
          "handle": "previous",
          "displayName": "Previous slide"
        },
        {
          "handle": "goTo",
          "displayName": "Go to slide",
          "params": [
            {
              "handle": "index",
              "displayName": "Index (0-based)",
              "defaultValue": "{{0}}"
            }
          ]
        },
        {
          "handle": "setVisibility",
          "displayName": "Set visibility",
          "params": [
            {
              "handle": "value",
              "displayName": "Value",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setDisable",
          "displayName": "Set disable",
          "params": [
            {
              "handle": "value",
              "displayName": "Value",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setLoading",
          "displayName": "Set loading",
          "params": [
            {
              "handle": "value",
              "displayName": "Value",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        }
      ],
      "exposedVariables": [
        {
          "name": "isVisible",
          "default": true
        },
        {
          "name": "isLoading",
          "default": false
        },
        {
          "name": "isDisabled",
          "default": false
        },
        {
          "name": "currentIndex",
          "default": 0
        },
        {
          "name": "currentSlide",
          "default": {}
        },
        {
          "name": "clickedSlide",
          "default": {}
        }
      ],
      "authoringHints": {
        "styles": "Every style falls back to the app theme, so set only what the design needs to blend in (its accent, surfaces, borders and text colours), taking colours from the app theme or brand, never the defaults of another product. Radii and sizes are px. Styles are the way to restyle a pack widget: a cssClass only takes effect with workspace Custom styles, and Tailwind class names the pack does not already use are not compiled, so do not rely on either; for a one-off visual a style cannot express, use an Html component. Bind loadingState to the query's isLoading (each widget draws a skeleton or spinner in its own shape); tooltip shows on hover.",
        "usage": "slides [{ image, title?, description?, link? }]; height follows width and aspectRatio (+28 for dots, +52 for captions below); aspectRatio 'fill' fills a fixed height."
      }
    }
  ],
  "unknown_types": []
}
