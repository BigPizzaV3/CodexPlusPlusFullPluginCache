{
  "components": [
    {
      "type": "ShadText",
      "name": "ShadText",
      "description": "Paragraph, lead, muted or small text. Typeface styles: fontFamily ('theme', 'sans', 'serif', 'display' or 'mono'), fontWeight, fontSize (px), letterSpacing (px or em) and textTransform (a small uppercase eyebrow: tone small, textTransform 'uppercase', letterSpacing '0.12em')",
      "defaultSize": {
        "width": 16,
        "height": 40
      },
      "properties": [
        {
          "key": "text",
          "label": "Text",
          "valueType": "string",
          "default": "Text"
        },
        {
          "key": "tone",
          "label": "Style",
          "valueType": "string",
          "default": "paragraph",
          "allowedValues": [
            "paragraph",
            "lead",
            "muted",
            "small",
            "large"
          ]
        },
        {
          "key": "dynamicHeight",
          "label": "Dynamic height",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "loadingState",
          "label": "Loading state",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "loadingIndicator",
          "label": "Loading look",
          "valueType": "string",
          "default": "spinner",
          "allowedValues": [
            "spinner",
            "skeleton"
          ]
        },
        {
          "key": "visibility",
          "label": "Visibility",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "collapseWhenHidden",
          "label": "Collapse when hidden",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "disabledState",
          "label": "Disable",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "tooltipFormat",
          "label": "Tooltip",
          "default": "plainText",
          "allowedValues": [
            "plainText",
            "markdown",
            "html"
          ]
        },
        {
          "key": "tooltip",
          "label": "Tooltip",
          "valueType": "string",
          "default": ""
        }
      ],
      "styles": [
        {
          "key": "boxShadow",
          "label": "Box shadow",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ],
          "default": "0px 0px 0px 0px #00000040"
        },
        {
          "key": "textColor",
          "label": "Text color",
          "valueType": "string"
        },
        {
          "key": "textAlign",
          "label": "Text alignment (left, center, right)",
          "valueType": "string",
          "default": "left"
        },
        {
          "key": "fontFamily",
          "label": "Typeface",
          "valueType": "string",
          "default": "theme",
          "allowedValues": [
            "theme",
            "sans",
            "serif",
            "display",
            "mono"
          ]
        },
        {
          "key": "fontWeight",
          "label": "Weight",
          "valueType": "string",
          "default": "",
          "allowedValues": [
            "",
            "400",
            "500",
            "600",
            "700",
            "800"
          ]
        },
        {
          "key": "letterSpacing",
          "label": "Letter spacing (px, or em like 0.12em)",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ]
        },
        {
          "key": "textTransform",
          "label": "Casing",
          "valueType": "string",
          "default": "none",
          "allowedValues": [
            "none",
            "uppercase",
            "lowercase",
            "capitalize"
          ]
        },
        {
          "key": "fontSize",
          "label": "Font size (px)",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ]
        },
        {
          "key": "cssClass",
          "label": "CSS class",
          "default": ""
        }
      ],
      "events": [
        {
          "id": "onClick",
          "label": "On click"
        },
        {
          "id": "onHover",
          "label": "On hover"
        }
      ],
      "actions": [
        {
          "handle": "setText",
          "displayName": "Set text",
          "params": [
            {
              "handle": "text",
              "displayName": "Text",
              "defaultValue": "New text"
            }
          ]
        },
        {
          "handle": "clear",
          "displayName": "Clear"
        },
        {
          "handle": "setVisibility",
          "displayName": "Set visibility",
          "params": [
            {
              "handle": "value",
              "displayName": "Value",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setDisable",
          "displayName": "Set disable",
          "params": [
            {
              "handle": "value",
              "displayName": "Value",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setLoading",
          "displayName": "Set loading",
          "params": [
            {
              "handle": "value",
              "displayName": "Value",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        }
      ],
      "exposedVariables": [
        {
          "name": "isVisible",
          "default": true
        },
        {
          "name": "isLoading",
          "default": false
        },
        {
          "name": "isDisabled",
          "default": false
        },
        {
          "name": "text",
          "default": "Text"
        }
      ],
      "authoringHints": {
        "styles": "Every style falls back to the app theme, so set only what the design needs to blend in (its accent, surfaces, borders and text colours), taking colours from the app theme or brand, never the defaults of another product. Radii and sizes are px. Styles are the way to restyle a pack widget: a cssClass only takes effect with workspace Custom styles, and Tailwind class names the pack does not already use are not compiled, so do not rely on either; for a one-off visual a style cannot express, use an Html component. Bind loadingState to the query's isLoading (each widget draws a skeleton or spinner in its own shape); tooltip shows on hover."
      }
    }
  ],
  "unknown_types": []
}
