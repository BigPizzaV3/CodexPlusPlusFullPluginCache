{
  "components": [
    {
      "type": "ShadScatterChart",
      "name": "ShadScatterChart",
      "description": "Scatter or bubble chart relating two measures: data [{ account: 'Globex', spend: 30, revenue: 95, seats: 120, segment: 'Enterprise' }], xField 'spend', yField 'revenue', optional sizeField (bubbles), groupField (one colour and legend entry per value), nameField (tooltip title), xLabel/yLabel axis titles, referenceX/referenceY dashed quadrant lines, x and y formats. Height 260-360 px; clicking a point sets clickedDataPoint to its row and fires onClick.",
      "defaultSize": {
        "width": 16,
        "height": 320
      },
      "properties": [
        {
          "key": "data",
          "label": "Data",
          "valueType": "array",
          "default": "{{[{ account: 'Northwind', spend: 12, revenue: 48, seats: 40, segment: 'Mid-market' }, { account: 'Globex', spend: 30, revenue: 95, seats: 120, segment: 'Ent…"
        },
        {
          "key": "xField",
          "label": "X field",
          "valueType": "string",
          "default": "spend"
        },
        {
          "key": "yField",
          "label": "Y field",
          "valueType": "string",
          "default": "revenue"
        },
        {
          "key": "sizeField",
          "label": "Size field (bubbles)",
          "valueType": "string",
          "default": "seats"
        },
        {
          "key": "groupField",
          "label": "Group field (one colour each)",
          "valueType": "string",
          "default": "segment"
        },
        {
          "key": "nameField",
          "label": "Name field (tooltip title)",
          "valueType": "string",
          "default": "account"
        },
        {
          "key": "xLabel",
          "label": "X axis title",
          "valueType": "string",
          "default": "Marketing spend ($k)"
        },
        {
          "key": "yLabel",
          "label": "Y axis title",
          "valueType": "string",
          "default": "Revenue ($k)"
        },
        {
          "key": "xAxisFormat",
          "label": "X format",
          "valueType": "string",
          "default": "number",
          "allowedValues": [
            "number",
            "currency",
            "percent",
            "compact"
          ]
        },
        {
          "key": "yAxisFormat",
          "label": "Y format",
          "valueType": "string",
          "default": "number",
          "allowedValues": [
            "number",
            "currency",
            "percent",
            "compact"
          ]
        },
        {
          "key": "currency",
          "label": "Currency code",
          "valueType": "string",
          "default": "USD"
        },
        {
          "key": "referenceX",
          "label": "Vertical line at x",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ],
          "default": ""
        },
        {
          "key": "referenceY",
          "label": "Horizontal line at y",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ],
          "default": ""
        },
        {
          "key": "pointSize",
          "label": "Point size (px)",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ],
          "default": "{{6}}"
        },
        {
          "key": "fillOpacity",
          "label": "Fill opacity (0 to 1)",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ],
          "default": ""
        },
        {
          "key": "valuePrefix",
          "label": "Value prefix",
          "valueType": "string",
          "default": ""
        },
        {
          "key": "valueSuffix",
          "label": "Value suffix",
          "valueType": "string",
          "default": ""
        },
        {
          "key": "emptyText",
          "label": "Empty message",
          "valueType": "string",
          "default": "No data"
        },
        {
          "key": "animate",
          "label": "Animate",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "showGrid",
          "label": "Grid",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "showLegend",
          "label": "Legend",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "colors",
          "label": "Series colors (in order)",
          "valueType": "array",
          "default": "{{[]}}"
        },
        {
          "key": "highlightClicked",
          "label": "Highlight clicked point",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "loadingState",
          "label": "Loading state",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "loadingIndicator",
          "label": "Loading look",
          "valueType": "string",
          "default": "spinner",
          "allowedValues": [
            "spinner",
            "skeleton"
          ]
        },
        {
          "key": "visibility",
          "label": "Visibility",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "collapseWhenHidden",
          "label": "Collapse when hidden",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "disabledState",
          "label": "Disable",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "tooltipFormat",
          "label": "Tooltip",
          "default": "plainText",
          "allowedValues": [
            "plainText",
            "markdown",
            "html"
          ]
        },
        {
          "key": "tooltip",
          "label": "Tooltip",
          "valueType": "string",
          "default": ""
        }
      ],
      "styles": [
        {
          "key": "boxShadow",
          "label": "Box shadow",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ],
          "default": "0px 0px 0px 0px #00000040"
        },
        {
          "key": "chartColor",
          "label": "Chart color (series palette from it)",
          "valueType": "string"
        },
        {
          "key": "gridColor",
          "label": "Grid line color",
          "valueType": "string"
        },
        {
          "key": "axisTextColor",
          "label": "Axis label color",
          "valueType": "string"
        },
        {
          "key": "legendTextColor",
          "label": "Legend text color",
          "valueType": "string"
        },
        {
          "key": "referenceLineColor",
          "label": "Reference line color",
          "valueType": "string"
        },
        {
          "key": "cssClass",
          "label": "CSS class",
          "default": ""
        }
      ],
      "events": [
        {
          "id": "onClick",
          "label": "On click"
        },
        {
          "id": "onDoubleClick",
          "label": "On double click"
        }
      ],
      "actions": [
        {
          "handle": "clearClickedPoint",
          "displayName": "Clear clicked point"
        },
        {
          "handle": "setVisibility",
          "displayName": "Set visibility",
          "params": [
            {
              "handle": "value",
              "displayName": "Value",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setDisable",
          "displayName": "Set disable",
          "params": [
            {
              "handle": "value",
              "displayName": "Value",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setLoading",
          "displayName": "Set loading",
          "params": [
            {
              "handle": "value",
              "displayName": "Value",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        }
      ],
      "exposedVariables": [
        {
          "name": "isVisible",
          "default": true
        },
        {
          "name": "isLoading",
          "default": false
        },
        {
          "name": "isDisabled",
          "default": false
        },
        {
          "name": "clickedDataPoint",
          "default": {}
        }
      ],
      "authoringHints": {
        "styles": "Every style falls back to the app theme, so set only what the design needs to blend in (its accent, surfaces, borders and text colours), taking colours from the app theme or brand, never the defaults of another product. Radii and sizes are px. Styles are the way to restyle a pack widget: a cssClass only takes effect with workspace Custom styles, and Tailwind class names the pack does not already use are not compiled, so do not rely on either; for a one-off visual a style cannot express, use an Html component. Bind loadingState to the query's isLoading (each widget draws a skeleton or spinner in its own shape); tooltip shows on hover.",
        "usage": "Two measures per row: xField and yField; sizeField makes bubbles, groupField colours and a legend per value, nameField titles the tooltip; referenceX/referenceY split it into quadrants. 260 to 360px tall."
      }
    }
  ],
  "unknown_types": []
}
