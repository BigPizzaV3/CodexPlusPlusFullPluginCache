{
  "components": [
    {
      "type": "DaterangePicker",
      "name": "DateRangePicker",
      "description": "Choose date ranges",
      "defaultSize": {
        "width": 10,
        "height": 40
      },
      "properties": [
        {
          "key": "label",
          "label": "Label",
          "valueType": "string",
          "default": "Label"
        },
        {
          "key": "placeholder",
          "label": "Placeholder",
          "valueType": "string",
          "default": "Select Date Range"
        },
        {
          "key": "defaultStartDate",
          "label": "Default start date",
          "valueType": "string",
          "default": "01/04/2022"
        },
        {
          "key": "defaultEndDate",
          "label": "Default end date",
          "valueType": "string",
          "default": "10/04/2022"
        },
        {
          "key": "format",
          "label": "Format",
          "valueType": "string",
          "default": "DD/MM/YYYY"
        },
        {
          "key": "showClearBtn",
          "label": "Enable clear button",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "loadingState",
          "label": "Loading state",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "visibility",
          "label": "Visibility",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "collapseWhenHidden",
          "label": "Collapse when hidden",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "disabledState",
          "label": "Disable",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "tooltipFormat",
          "label": "Tooltip",
          "default": "plainText",
          "allowedValues": [
            "plainText",
            "markdown",
            "html"
          ]
        },
        {
          "key": "tooltip",
          "label": "Tooltip",
          "valueType": "string",
          "default": ""
        }
      ],
      "styles": [
        {
          "key": "labelColor",
          "label": "Color",
          "valueType": "string",
          "default": "var(--cc-primary-text)"
        },
        {
          "key": "labelFontSize",
          "label": "Size",
          "valueType": "number",
          "default": "{{12}}"
        },
        {
          "key": "alignment",
          "label": "Alignment",
          "valueType": "string",
          "default": "side",
          "allowedValues": [
            "side",
            "top"
          ]
        },
        {
          "key": "direction",
          "label": "Direction",
          "valueType": "string",
          "default": "left",
          "allowedValues": [
            "left",
            "right"
          ]
        },
        {
          "key": "auto",
          "label": "Width",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "fieldBackgroundColor",
          "label": "Background",
          "valueType": "string",
          "default": "var(--cc-surface1-surface)"
        },
        {
          "key": "fieldBorderColor",
          "label": "Border",
          "valueType": "string",
          "default": "var(--cc-default-border)"
        },
        {
          "key": "accentColor",
          "label": "Accent",
          "valueType": "string",
          "default": "var(--cc-primary-brand)"
        },
        {
          "key": "selectedTextColor",
          "label": "Text",
          "valueType": "string",
          "default": "var(--cc-primary-text)"
        },
        {
          "key": "errTextColor",
          "label": "Error text",
          "valueType": "string",
          "default": "var(--cc-error-systemStatus)"
        },
        {
          "key": "icon",
          "label": "Icon",
          "valueType": "string",
          "default": "IconCalendarMonth"
        },
        {
          "key": "borderRadius",
          "label": "Border radius",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ],
          "default": "{{6}}"
        },
        {
          "key": "boxShadow",
          "label": "Box shadow",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ],
          "default": "0px 0px 0px 0px #00000040"
        },
        {
          "key": "padding",
          "label": "Padding",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ],
          "default": "default",
          "allowedValues": [
            "default",
            "none"
          ]
        },
        {
          "key": "labelWidth",
          "default": "20"
        },
        {
          "key": "iconVisibility",
          "default": true
        },
        {
          "key": "iconDirection",
          "default": "left"
        },
        {
          "key": "iconColor",
          "default": "var(--cc-default-icon)"
        },
        {
          "key": "widthType",
          "default": "ofComponent"
        },
        {
          "key": "cssClass",
          "label": "CSS class",
          "default": ""
        }
      ],
      "events": [
        {
          "id": "onSelect",
          "label": "On select"
        },
        {
          "id": "onFocus",
          "label": "On focus"
        },
        {
          "id": "onBlur",
          "label": "On blur"
        }
      ],
      "actions": [
        {
          "handle": "setStartDate",
          "displayName": "Set Start Date",
          "params": [
            {
              "handle": "value",
              "displayName": "Value"
            },
            {
              "handle": "format",
              "displayName": "Format"
            }
          ]
        },
        {
          "handle": "clearStartDate",
          "displayName": "Clear Start Date"
        },
        {
          "handle": "setEndDate",
          "displayName": "Set End Date",
          "params": [
            {
              "handle": "value",
              "displayName": "Value"
            },
            {
              "handle": "format",
              "displayName": "Format"
            }
          ]
        },
        {
          "handle": "clearEndDate",
          "displayName": "Clear End Date"
        },
        {
          "handle": "setDateRange",
          "displayName": "Set Date Range",
          "params": [
            {
              "handle": "startDate",
              "displayName": "Start Date"
            },
            {
              "handle": "endDate",
              "displayName": "End Date"
            },
            {
              "handle": "format",
              "displayName": "Format"
            }
          ]
        },
        {
          "handle": "clearDateRange",
          "displayName": "Clear Date Range"
        },
        {
          "handle": "setDisabledDates",
          "displayName": "Set disabled dates",
          "params": [
            {
              "handle": "value",
              "displayName": "Value"
            }
          ]
        },
        {
          "handle": "clearDisabledDates",
          "displayName": "Clear disabled dates"
        },
        {
          "handle": "setMinDate",
          "displayName": "Set min date",
          "params": [
            {
              "handle": "value",
              "displayName": "Value"
            }
          ]
        },
        {
          "handle": "setMaxDate",
          "displayName": "Set max date",
          "params": [
            {
              "handle": "value",
              "displayName": "Value"
            }
          ]
        },
        {
          "handle": "setVisibility",
          "displayName": "Set visibility",
          "params": [
            {
              "handle": "value",
              "displayName": "Value",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setLoading",
          "displayName": "Set loading",
          "params": [
            {
              "handle": "value",
              "displayName": "Value",
              "defaultValue": "{{false}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setDisable",
          "displayName": "Set disable",
          "params": [
            {
              "handle": "value",
              "displayName": "Value",
              "defaultValue": "{{false}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setFocus",
          "displayName": "Set focus"
        },
        {
          "handle": "setBlur",
          "displayName": "Set blur"
        }
      ],
      "exposedVariables": [
        {
          "name": "endDate",
          "default": ""
        },
        {
          "name": "startDate",
          "default": ""
        }
      ],
      "authoringHints": {
        "emptyDatasourceBinding": {
          "rule": "An empty picker can resolve to the literal strings \"undefined\" or \"Invalid date\" inside datasource options; a simple value || fallback does not cover those strings.",
          "startExample": "{{!components.range.startDate || components.range.startDate === 'undefined' || components.range.startDate === 'Invalid date' ? '1900-01-01' : components.range.startDate}}",
          "endExample": "{{!components.range.endDate || components.range.endDate === 'undefined' || components.range.endDate === 'Invalid date' ? '2999-12-31' : components.range.endDate}}"
        }
      }
    }
  ],
  "unknown_types": []
}
