{
  "components": [
    {
      "type": "Lib_shadcn_CurrencyInput",
      "name": "Lib_shadcn_CurrencyInput",
      "description": "Currency Input from the shadcn UI component library. Sizes to its content in the app (Dynamic height on).",
      "defaultSize": {
        "width": 10,
        "height": 70
      },
      "properties": [
        {
          "key": "label",
          "label": "Label",
          "valueType": "string",
          "default": "Amount"
        },
        {
          "key": "description",
          "label": "Help text",
          "valueType": "string",
          "default": ""
        },
        {
          "key": "placeholder",
          "label": "Placeholder",
          "valueType": "string",
          "default": "0.00"
        },
        {
          "key": "value",
          "label": "Default value",
          "valueType": "string",
          "default": ""
        },
        {
          "key": "currency",
          "label": "Currency",
          "valueType": "string",
          "default": "USD"
        },
        {
          "key": "currencyOptions",
          "label": "Currency options",
          "valueType": "array",
          "default": "{{[]}}",
          "description": "ISO codes the user can switch between. Empty = fixed currency."
        },
        {
          "key": "locale",
          "label": "Locale",
          "valueType": "string",
          "default": "en-US"
        },
        {
          "key": "decimalPlaces",
          "label": "Decimal places",
          "valueType": "number",
          "default": "{{2}}"
        },
        {
          "key": "currencyDisplay",
          "label": "Show currency as",
          "valueType": "string",
          "default": "symbol",
          "allowedValues": [
            "symbol",
            "code"
          ]
        },
        {
          "key": "required",
          "label": "Required",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "disabled",
          "label": "Disable",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "formattedValue",
          "label": "Formatted Value",
          "valueType": "string",
          "default": ""
        },
        {
          "key": "isValid",
          "label": "Is Valid",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "visibility",
          "label": "Visibility",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "loadingState",
          "label": "Loading state",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "disabledState",
          "label": "Disable",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "dynamicHeight",
          "label": "Dynamic height",
          "valueType": "boolean",
          "default": "{{true}}"
        }
      ],
      "styles": [
        {
          "key": "backgroundColor",
          "label": "Background",
          "valueType": "string"
        },
        {
          "key": "textColor",
          "label": "Text",
          "valueType": "string"
        },
        {
          "key": "borderColor",
          "label": "Border",
          "valueType": "string"
        },
        {
          "key": "accentColor",
          "label": "Accent",
          "valueType": "string"
        },
        {
          "key": "borderRadius",
          "label": "Border radius",
          "valueType": "number"
        },
        {
          "key": "boxShadow",
          "label": "Box shadow",
          "valueType": "string"
        }
      ],
      "events": [
        {
          "id": "onChange",
          "label": "On change"
        },
        {
          "id": "onEnterPressed",
          "label": "On enter pressed"
        },
        {
          "id": "onFocus",
          "label": "On focus"
        },
        {
          "id": "onBlur",
          "label": "On blur"
        }
      ],
      "actions": [
        {
          "handle": "setValue",
          "displayName": "Set value",
          "params": [
            {
              "handle": "value",
              "displayName": "Amount"
            }
          ]
        },
        {
          "handle": "setCurrency",
          "displayName": "Set currency",
          "params": [
            {
              "handle": "currency",
              "displayName": "ISO code"
            }
          ]
        },
        {
          "handle": "clear",
          "displayName": "Clear"
        },
        {
          "handle": "focus",
          "displayName": "Focus"
        },
        {
          "handle": "setVisibility",
          "displayName": "Set visibility",
          "params": [
            {
              "handle": "visibility",
              "displayName": "Value",
              "defaultValue": "{{false}}"
            }
          ]
        },
        {
          "handle": "setLoading",
          "displayName": "Set loading",
          "params": [
            {
              "handle": "loading",
              "displayName": "Value",
              "defaultValue": "{{false}}"
