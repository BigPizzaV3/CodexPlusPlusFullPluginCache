          ]
        },
        {
          "handle": "setDisable",
          "displayName": "Set disable",
          "params": [
            {
              "handle": "disable",
              "displayName": "Value",
              "defaultValue": "{{false}}"
            }
          ]
        }
      ],
      "exposedVariables": [
        {
          "name": "label",
          "default": "Amount"
        },
        {
          "name": "description",
          "default": ""
        },
        {
          "name": "placeholder",
          "default": "0.00"
        },
        {
          "name": "value",
          "default": ""
        },
        {
          "name": "currency",
          "default": "USD"
        },
        {
          "name": "currencyOptions",
          "default": []
        },
        {
          "name": "locale",
          "default": "en-US"
        },
        {
          "name": "decimalPlaces",
          "default": 2
        },
        {
          "name": "currencyDisplay",
          "default": "symbol"
        },
        {
          "name": "required",
          "default": false
        },
        {
          "name": "disabled",
          "default": false
        },
        {
          "name": "formattedValue",
          "default": ""
        },
        {
          "name": "isValid",
          "default": true
        },
        {
          "name": "isVisible",
          "default": true
        },
        {
          "name": "isLoading",
          "default": false
        },
        {
          "name": "isDisabled",
          "default": false
        }
      ]
    }
  ],
  "unknown_types": []
