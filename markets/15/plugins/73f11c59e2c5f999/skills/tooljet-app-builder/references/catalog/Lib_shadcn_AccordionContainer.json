{
  "components": [
    {
      "type": "Lib_shadcn_AccordionContainer",
      "name": "Lib_shadcn_AccordionContainer",
      "description": "Accordion Container from the shadcn UI component library. Drawn at the height you give it.",
      "defaultSize": {
        "width": 16,
        "height": 600
      },
      "properties": [
        {
          "key": "sections",
          "label": "Sections",
          "valueType": "array",
          "default": "{{[{\"id\":\"general\",\"title\":\"General\"},{\"id\":\"billing\",\"title\":\"Billing\"},{\"id\":\"advanced\",\"title\":\"Advanced\"}]}}",
          "description": "Array of { id, title } objects. Keep ids stable: dropped components stay with their section id."
        },
        {
          "key": "openSections",
          "label": "Open sections",
          "valueType": "array",
          "default": "{{[\"general\"]}}",
          "description": "Ids of the sections that start open."
        },
        {
          "key": "allowMultiple",
          "label": "Allow several open",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "visibility",
          "label": "Visibility",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "loadingState",
          "label": "Loading state",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "disabledState",
          "label": "Disable",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "dynamicHeight",
          "label": "Dynamic height",
          "valueType": "boolean",
          "default": "{{false}}"
        }
      ],
      "styles": [
        {
          "key": "panelHeight",
          "label": "Section height",
          "valueType": "number"
        },
        {
          "key": "headerColor",
          "label": "Header text",
          "valueType": "string"
        },
        {
          "key": "backgroundColor",
          "label": "Background",
          "valueType": "string"
        },
        {
          "key": "borderRadius",
          "label": "Border radius",
          "valueType": "number"
        },
        {
          "key": "padding",
          "label": "Padding",
          "valueType": "number"
        },
        {
          "key": "boxShadow",
          "label": "Box shadow",
          "valueType": "string"
        }
      ],
      "events": [
        {
          "id": "onToggle",
          "label": "On toggle"
        }
      ],
      "actions": [
        {
          "handle": "openSection",
          "displayName": "Open section",
          "params": [
            {
              "handle": "id",
              "displayName": "Section id"
            }
          ]
        },
        {
          "handle": "collapseAll",
          "displayName": "Collapse all"
        },
        {
          "handle": "setVisibility",
          "displayName": "Set visibility",
          "params": [
            {
              "handle": "visibility",
              "displayName": "Value",
              "defaultValue": "{{false}}"
            }
          ]
        },
        {
          "handle": "setLoading",
          "displayName": "Set loading",
          "params": [
            {
              "handle": "loading",
              "displayName": "Value",
              "defaultValue": "{{false}}"
            }
          ]
        },
        {
          "handle": "setDisable",
          "displayName": "Set disable",
          "params": [
            {
              "handle": "disable",
              "displayName": "Value",
              "defaultValue": "{{false}}"
            }
          ]
        }
      ],
      "exposedVariables": [
        {
          "name": "sections",
          "default": [
            {
              "id": "general",
              "title": "General"
            },
            {
              "id": "billing",
              "title": "Billing"
            },
            {
              "id": "advanced",
              "title": "Advanced"
            }
          ]
        },
        {
          "name": "openSections",
          "default": [
            "general"
          ]
        },
        {
          "name": "allowMultiple",
          "default": true
        },
        {
          "name": "isVisible",
          "default": true
        },
        {
          "name": "isLoading",
          "default": false
        },
        {
          "name": "isDisabled",
          "default": false
        }
      ]
    }
  ],
  "unknown_types": []
}
