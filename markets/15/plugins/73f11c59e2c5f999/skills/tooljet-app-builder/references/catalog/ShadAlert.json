{
  "components": [
    {
      "type": "ShadAlert",
      "name": "ShadAlert",
      "description": "Alert",
      "defaultSize": {
        "width": 20,
        "height": 60
      },
      "properties": [
        {
          "key": "title",
          "label": "Title",
          "valueType": "string",
          "default": "Heads up"
        },
        {
          "key": "description",
          "label": "Description",
          "valueType": "string",
          "default": ""
        },
        {
          "key": "actionLabel",
          "label": "Action label",
          "valueType": "string",
          "default": ""
        },
        {
          "key": "dismissible",
          "label": "Show close button",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "variant",
          "label": "Variant",
          "valueType": "string",
          "default": "default",
          "allowedValues": [
            "default",
            "info",
            "success",
            "warning",
            "destructive",
            "custom"
          ]
        },
        {
          "key": "dynamicHeight",
          "label": "Dynamic height",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "loadingState",
          "label": "Loading state",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "loadingIndicator",
          "label": "Loading look",
          "valueType": "string",
          "default": "spinner",
          "allowedValues": [
            "spinner",
            "skeleton"
          ]
        },
        {
          "key": "visibility",
          "label": "Visibility",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "collapseWhenHidden",
          "label": "Collapse when hidden",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "disabledState",
          "label": "Disable",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "tooltipFormat",
          "label": "Tooltip",
          "default": "plainText",
          "allowedValues": [
            "plainText",
            "markdown",
            "html"
          ]
        },
        {
          "key": "tooltip",
          "label": "Tooltip",
          "valueType": "string",
          "default": ""
        }
      ],
      "styles": [
        {
          "key": "boxShadow",
          "label": "Box shadow",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ],
          "default": "0px 0px 0px 0px #00000040"
        },
        {
          "key": "backgroundColor",
          "label": "Alert background",
          "valueType": "string"
        },
        {
          "key": "borderColor",
          "label": "Alert border color",
          "valueType": "string"
        },
        {
          "key": "accentColor",
          "label": "Custom accent",
          "valueType": "string"
        },
        {
          "key": "titleColor",
          "label": "Alert title color",
          "valueType": "string"
        },
        {
          "key": "textColor",
          "label": "Alert description color",
          "valueType": "string"
        },
        {
          "key": "borderRadius",
          "label": "Alert radius",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ]
        },
        {
          "key": "cssClass",
          "label": "CSS class",
          "default": ""
        }
      ],
      "events": [
        {
          "id": "onActionClicked",
          "label": "On action clicked"
        },
        {
          "id": "onClose",
          "label": "On close"
        }
      ],
      "actions": [
        {
          "handle": "setTitle",
          "displayName": "Set title",
          "params": [
            {
              "handle": "title",
              "displayName": "Title",
              "defaultValue": "New title"
            }
          ]
        },
        {
          "handle": "setDescription",
          "displayName": "Set description",
          "params": [
            {
              "handle": "description",
              "displayName": "Description",
              "defaultValue": "New description"
            }
          ]
        },
        {
          "handle": "setVariant",
          "displayName": "Set variant",
          "params": [
            {
              "handle": "variant",
              "displayName": "Variant (default, info, success, warning, destructive or custom)",
              "defaultValue": "info"
            }
          ]
        },
        {
          "handle": "setVisibility",
          "displayName": "Set visibility",
          "params": [
            {
              "handle": "value",
              "displayName": "Value",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setDisable",
          "displayName": "Set disable",
          "params": [
            {
              "handle": "value",
              "displayName": "Value",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setLoading",
          "displayName": "Set loading",
          "params": [
            {
              "handle": "value",
              "displayName": "Value",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        }
      ],
      "exposedVariables": [
        {
          "name": "title",
          "default": "Heads up"
        },
        {
          "name": "description",
          "default": ""
        },
        {
          "name": "variant",
          "default": "default"
        },
        {
          "name": "isVisible",
          "default": true
        },
        {
          "name": "isLoading",
          "default": false
        },
        {
          "name": "isDisabled",
          "default": false
        }
      ],
      "authoringHints": {
        "styles": "Every style falls back to the app theme, so set only what the design needs to blend in (its accent, surfaces, borders and text colours), taking colours from the app theme or brand, never the defaults of another product. Radii and sizes are px. Styles are the way to restyle a pack widget: a cssClass only takes effect with workspace Custom styles, and Tailwind class names the pack does not already use are not compiled, so do not rely on either; for a one-off visual a style cannot express, use an Html component. Bind loadingState to the query's isLoading (each widget draws a skeleton or spinner in its own shape); tooltip shows on hover."
      }
    }
  ],
  "unknown_types": []
}
