{
  "components": [
    {
      "type": "ShadLineChart",
      "name": "ShadLineChart",
      "description": "Line chart for trends: data [{ month: 'Jan', revenue: 18600, expenses: 8000 }], xField 'month', yFields 'revenue,expenses' (one line each); curve monotone/linear/step, dots, strokeWidth, dashedFields, an optional target line (referenceValue, referenceLabel) and yAxisFormat number/currency/percent/compact. Height 200-320 px; clicking a point sets clickedDataPoint and fires onClick.",
      "defaultSize": {
        "width": 20,
        "height": 280
      },
      "properties": [
        {
          "key": "data",
          "label": "Data",
          "valueType": "array",
          "default": "{{[{ month: 'Jan', revenue: 18600, expenses: 8000 }, { month: 'Feb', revenue: 30500, expenses: 20000 }, { month: 'Mar', revenue: 23700, expenses: 12000 }, {…"
        },
        {
          "key": "xField",
          "label": "X field",
          "valueType": "string",
          "default": "month"
        },
        {
          "key": "yFields",
          "label": "Series fields (one or many)",
          "valueType": "union",
          "valueTypes": [
            "string",
            "array"
          ],
          "default": "{{['revenue', 'expenses']}}"
        },
        {
          "key": "curve",
          "label": "Curve",
          "valueType": "string",
          "default": "monotone",
          "allowedValues": [
            "monotone",
            "linear",
            "step"
          ]
        },
        {
          "key": "showDots",
          "label": "Dots",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "strokeWidth",
          "label": "Line width (px)",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ],
          "default": "{{2}}"
        },
        {
          "key": "dashedFields",
          "label": "Dashed series (fields)",
          "valueType": "union",
          "valueTypes": [
            "string",
            "array"
          ],
          "default": ""
        },
        {
          "key": "referenceValue",
          "label": "Target line value",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ],
          "default": ""
        },
        {
          "key": "referenceLabel",
          "label": "Target line label",
          "valueType": "string",
          "default": ""
        },
        {
          "key": "yAxisFormat",
          "label": "Value format",
          "valueType": "string",
          "default": "number",
          "allowedValues": [
            "number",
            "currency",
            "percent",
            "compact"
          ]
        },
        {
          "key": "currency",
          "label": "Currency code",
          "valueType": "string",
          "default": "USD"
        },
        {
          "key": "valuePrefix",
          "label": "Value prefix",
          "valueType": "string",
          "default": ""
        },
        {
          "key": "valueSuffix",
          "label": "Value suffix",
          "valueType": "string",
          "default": ""
        },
        {
          "key": "emptyText",
          "label": "Empty message",
          "valueType": "string",
          "default": "No data"
        },
        {
          "key": "animate",
          "label": "Animate",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "showGrid",
          "label": "Grid",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "showLegend",
          "label": "Legend",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "seriesLabels",
          "label": "Series labels ({ field: label })",
          "valueType": "union",
          "valueTypes": [
            "object",
            "array"
          ],
          "default": "{{{} }}"
        },
        {
          "key": "colors",
          "label": "Series colors (in order)",
          "valueType": "array",
          "default": "{{[]}}"
        },
        {
          "key": "highlightClicked",
          "label": "Highlight clicked point",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "loadingState",
          "label": "Loading state",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "loadingIndicator",
          "label": "Loading look",
          "valueType": "string",
          "default": "spinner",
          "allowedValues": [
            "spinner",
            "skeleton"
          ]
        },
        {
          "key": "visibility",
          "label": "Visibility",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "collapseWhenHidden",
          "label": "Collapse when hidden",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "disabledState",
          "label": "Disable",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "tooltipFormat",
          "label": "Tooltip",
          "default": "plainText",
          "allowedValues": [
            "plainText",
            "markdown",
            "html"
          ]
        },
        {
          "key": "tooltip",
          "label": "Tooltip",
          "valueType": "string",
          "default": ""
        }
      ],
      "styles": [
        {
          "key": "boxShadow",
          "label": "Box shadow",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ],
          "default": "0px 0px 0px 0px #00000040"
        },
        {
          "key": "chartColor",
          "label": "Chart color (series palette from it)",
          "valueType": "string"
        },
        {
          "key": "gridColor",
          "label": "Grid line color",
          "valueType": "string"
        },
        {
          "key": "axisTextColor",
          "label": "Axis label color",
          "valueType": "string"
        },
        {
          "key": "legendTextColor",
          "label": "Legend text color",
          "valueType": "string"
        },
        {
          "key": "referenceLineColor",
          "label": "Target line color",
          "valueType": "string"
        },
        {
          "key": "cssClass",
          "label": "CSS class",
          "default": ""
        }
      ],
      "events": [
        {
          "id": "onClick",
          "label": "On click"
        },
        {
          "id": "onDoubleClick",
          "label": "On double click"
        }
      ],
      "actions": [
        {
          "handle": "clearClickedPoint",
          "displayName": "Clear clicked point"
        },
        {
          "handle": "setVisibility",
          "displayName": "Set visibility",
          "params": [
            {
              "handle": "value",
              "displayName": "Value",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setDisable",
          "displayName": "Set disable",
          "params": [
            {
              "handle": "value",
              "displayName": "Value",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setLoading",
          "displayName": "Set loading",
          "params": [
            {
              "handle": "value",
              "displayName": "Value",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        }
      ],
      "exposedVariables": [
        {
          "name": "isVisible",
          "default": true
        },
        {
          "name": "isLoading",
          "default": false
        },
        {
          "name": "isDisabled",
          "default": false
        },
        {
          "name": "clickedDataPoint",
          "default": {}
        }
      ],
      "authoringHints": {
        "styles": "Every style falls back to the app theme, so set only what the design needs to blend in (its accent, surfaces, borders and text colours), taking colours from the app theme or brand, never the defaults of another product. Radii and sizes are px. Styles are the way to restyle a pack widget: a cssClass only takes effect with workspace Custom styles, and Tailwind class names the pack does not already use are not compiled, so do not rely on either; for a one-off visual a style cannot express, use an Html component. Bind loadingState to the query's isLoading (each widget draws a skeleton or spinner in its own shape); tooltip shows on hover.",
        "usage": "Rows [{ month, revenue, expenses }] with xField 'month' and yFields ['revenue', 'expenses']; referenceValue draws a target line; yAxisFormat percent expects values already in percent. 200 to 320px tall."
      }
    }
  ],
  "unknown_types": []
}
