{
  "components": [
    {
      "type": "Lib_shadcn_RadialChart",
      "name": "Lib_shadcn_RadialChart",
      "description": "Radial Chart from the shadcn UI component library. Drawn at the height you give it.",
      "defaultSize": {
        "width": 10,
        "height": 220
      },
      "properties": [
        {
          "key": "mode",
          "label": "Mode",
          "valueType": "string",
          "default": "progress",
          "allowedValues": [
            "progress",
            "categories"
          ]
        },
        {
          "key": "value",
          "label": "Value (progress)",
          "valueType": "number",
          "default": "{{72}}"
        },
        {
          "key": "maxValue",
          "label": "Max value",
          "valueType": "number",
          "default": "{{100}}"
        },
        {
          "key": "data",
          "label": "Data (categories)",
          "valueType": "array",
          "default": "{{[{\"channel\":\"Organic\",\"visitors\":420},{\"channel\":\"Paid\",\"visitors\":310},{\"channel\":\"Referral\",\"visitors\":190},{\"channel\":\"Social\",\"visitors\":120}]}}"
        },
        {
          "key": "categoryField",
          "label": "Category field",
          "valueType": "string",
          "default": "channel"
        },
        {
          "key": "valueField",
          "label": "Value field",
          "valueType": "string",
          "default": "visitors"
        },
        {
          "key": "centerValue",
          "label": "Center value",
          "valueType": "string",
          "default": "",
          "description": "Empty = percent / total."
        },
        {
          "key": "centerLabel",
          "label": "Center label",
          "valueType": "string",
          "default": "Complete"
        },
        {
          "key": "rounded",
          "label": "Rounded ends",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "showTrack",
          "label": "Track",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "showLegend",
          "label": "Legend (categories)",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "colors",
          "label": "Colors",
          "valueType": "array",
          "default": "{{[]}}"
        },
        {
          "key": "emptyText",
          "label": "Empty text",
          "valueType": "string",
          "default": "No data"
        },
        {
          "key": "clickedDataPoint",
          "label": "Clicked Data Point",
          "valueType": "object",
          "default": "{{{}}}"
        },
        {
          "key": "visibility",
          "label": "Visibility",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "loadingState",
          "label": "Loading state",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "disabledState",
          "label": "Disable",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "dynamicHeight",
          "label": "Dynamic height",
          "valueType": "boolean",
          "default": "{{false}}"
        }
      ],
      "styles": [
        {
          "key": "chartColor",
          "label": "Bar",
          "valueType": "string"
        },
        {
          "key": "trackColor",
          "label": "Track",
          "valueType": "string"
        },
        {
          "key": "centerValueColor",
          "label": "Center value",
          "valueType": "string"
        },
        {
          "key": "boxShadow",
          "label": "Box shadow",
          "valueType": "string"
        }
      ],
      "events": [
        {
          "id": "onClick",
          "label": "On click"
        },
        {
          "id": "onDoubleClick",
          "label": "On double click"
        }
      ],
      "actions": [
        {
          "handle": "clearClickedPoint",
          "displayName": "Clear clicked point"
        },
        {
          "handle": "setVisibility",
          "displayName": "Set visibility",
          "params": [
            {
              "handle": "visibility",
              "displayName": "Value",
              "defaultValue": "{{false}}"
            }
          ]
        },
        {
          "handle": "setLoading",
          "displayName": "Set loading",
          "params": [
            {
              "handle": "loading",
              "displayName": "Value",
              "defaultValue": "{{false}}"
            }
          ]
        },
        {
          "handle": "setDisable",
          "displayName": "Set disable",
          "params": [
            {
              "handle": "disable",
              "displayName": "Value",
              "defaultValue": "{{false}}"
            }
          ]
        }
      ],
      "exposedVariables": [
        {
          "name": "mode",
          "default": "progress"
        },
        {
          "name": "value",
          "default": 72
        },
        {
          "name": "maxValue",
          "default": 100
        },
        {
          "name": "data",
          "default": [
            {
              "channel": "Organic",
              "visitors": 420
            },
            {
              "channel": "Paid",
              "visitors": 310
            },
            {
              "channel": "Referral",
              "visitors": 190
            },
            {
              "channel": "Social",
              "visitors": 120
            }
          ]
        },
        {
          "name": "categoryField",
          "default": "channel"
        },
        {
          "name": "valueField",
          "default": "visitors"
        },
        {
          "name": "centerValue",
          "default": ""
        },
        {
          "name": "centerLabel",
          "default": "Complete"
        },
        {
          "name": "rounded",
          "default": true
        },
        {
          "name": "showTrack",
          "default": true
        },
        {
          "name": "showLegend",
          "default": true
        },
        {
          "name": "colors",
          "default": []
        },
        {
          "name": "emptyText",
          "default": "No data"
        },
        {
          "name": "clickedDataPoint",
          "default": {}
        },
        {
          "name": "isVisible",
          "default": true
        },
        {
          "name": "isLoading",
          "default": false
        },
        {
          "name": "isDisabled",
          "default": false
        }
      ]
    }
  ],
  "unknown_types": []
}
