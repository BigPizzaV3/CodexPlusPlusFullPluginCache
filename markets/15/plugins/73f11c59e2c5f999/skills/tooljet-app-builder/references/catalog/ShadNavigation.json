{
  "components": [
    {
      "type": "ShadNavigation",
      "name": "ShadNavigation",
      "description": "App navigation: a vertical sidebar list or a horizontal top bar from items [{ label, value, icon?: 'IconHome', badge?, disabled?, group? (sidebar heading), children?: [{ label, value }] }] (children open as a dropdown in the top bar, a nested list in the sidebar). variant pills, underline or ghost; defaultValue is the active item; onClick fires on click with exposed value and selectedItem { label, value, parentLabel, parentValue } (wire page switches here); selectItem(value). Item height 36px; a top bar is 40px tall, a sidebar fills the widget's height",
      "defaultSize": {
        "width": 9,
        "height": 320
      },
      "properties": [
        {
          "key": "items",
          "label": "Items",
          "valueType": "array",
          "default": "{{[{ label: 'Dashboard', value: 'dashboard', icon: 'IconLayoutDashboard' }, { label: 'Orders', value: 'orders', icon: 'IconShoppingCart', badge: 12 }, { labe…"
        },
        {
          "key": "defaultValue",
          "label": "Active item (value)",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number",
            "boolean",
            "array",
            "object"
          ],
          "default": "dashboard"
        },
        {
          "key": "orientation",
          "label": "Orientation",
          "valueType": "string",
          "default": "vertical",
          "allowedValues": [
            "vertical",
            "horizontal"
          ]
        },
        {
          "key": "variant",
          "label": "Variant",
          "valueType": "string",
          "default": "pills",
          "allowedValues": [
            "pills",
            "underline",
            "ghost"
          ]
        },
        {
          "key": "size",
          "label": "Size",
          "valueType": "string",
          "default": "default",
          "allowedValues": [
            "sm",
            "default",
            "lg"
          ]
        },
        {
          "key": "align",
          "label": "Align (top bar)",
          "valueType": "string",
          "default": "start",
          "allowedValues": [
            "start",
            "center",
            "end",
            "stretch"
          ]
        },
        {
          "key": "collapsed",
          "label": "Collapsed (icon-only sidebar)",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "loadingState",
          "label": "Loading state",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "loadingIndicator",
          "label": "Loading look",
          "valueType": "string",
          "default": "spinner",
          "allowedValues": [
            "spinner",
            "skeleton"
          ]
        },
        {
          "key": "visibility",
          "label": "Visibility",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "collapseWhenHidden",
          "label": "Collapse when hidden",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "disabledState",
          "label": "Disable",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "tooltipFormat",
          "label": "Tooltip",
          "default": "plainText",
          "allowedValues": [
            "plainText",
            "markdown",
            "html"
          ]
        },
        {
          "key": "tooltip",
          "label": "Tooltip",
          "valueType": "string",
          "default": ""
        }
      ],
      "styles": [
        {
          "key": "boxShadow",
          "label": "Box shadow",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ],
          "default": "0px 0px 0px 0px #00000040"
        },
        {
          "key": "backgroundColor",
          "label": "Background",
          "valueType": "string"
        },
        {
          "key": "textColor",
          "label": "Item text color",
          "valueType": "string"
        },
        {
          "key": "iconColor",
          "label": "Item icon color",
          "valueType": "string"
        },
        {
          "key": "hoverBackgroundColor",
          "label": "Item hover background",
          "valueType": "string"
        },
        {
          "key": "activeBackgroundColor",
          "label": "Active item background",
          "valueType": "string"
        },
        {
          "key": "activeTextColor",
          "label": "Active item text color",
          "valueType": "string"
        },
        {
          "key": "indicatorColor",
          "label": "Active indicator color (underline)",
          "valueType": "string"
        },
        {
          "key": "badgeBackgroundColor",
          "label": "Badge background",
          "valueType": "string"
        },
        {
          "key": "badgeTextColor",
          "label": "Badge text color",
          "valueType": "string"
        },
        {
          "key": "groupLabelColor",
          "label": "Group heading color",
          "valueType": "string"
        },
        {
          "key": "separatorColor",
          "label": "Separator color",
          "valueType": "string"
        },
        {
          "key": "itemRadius",
          "label": "Item radius",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ]
        },
        {
          "key": "cssClass",
          "label": "CSS class",
          "default": ""
        }
      ],
      "events": [
        {
          "id": "onClick",
          "label": "On click"
        }
      ],
      "actions": [
        {
          "handle": "selectItem",
          "displayName": "Select item",
          "params": [
            {
              "handle": "id",
              "displayName": "Item value",
              "defaultValue": ""
            }
          ]
        },
        {
          "handle": "setItemVisibility",
          "displayName": "Set item visibility",
          "params": [
            {
              "handle": "id",
              "displayName": "Item value",
              "defaultValue": ""
            },
            {
              "handle": "value",
              "displayName": "Visible",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setItemDisable",
          "displayName": "Set item disable",
          "params": [
            {
              "handle": "id",
              "displayName": "Item value",
              "defaultValue": ""
            },
            {
              "handle": "value",
              "displayName": "Disabled",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setCollapsed",
          "displayName": "Set collapsed",
          "params": [
            {
              "handle": "value",
              "displayName": "Value",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setVisibility",
          "displayName": "Set visibility",
          "params": [
            {
              "handle": "value",
              "displayName": "Value",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setDisable",
          "displayName": "Set disable",
          "params": [
            {
              "handle": "value",
              "displayName": "Value",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setLoading",
          "displayName": "Set loading",
          "params": [
            {
              "handle": "value",
              "displayName": "Value",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        }
      ],
      "exposedVariables": [
        {
          "name": "isVisible",
          "default": true
        },
        {
          "name": "isLoading",
          "default": false
        },
        {
          "name": "isDisabled",
          "default": false
        },
        {
          "name": "value",
          "default": ""
        },
        {
          "name": "selectedItem",
          "default": null
        },
        {
          "name": "previousSelectedItem",
          "default": null
        },
        {
          "name": "isCollapsed",
          "default": false
        }
      ],
      "authoringHints": {
        "styles": "Every style falls back to the app theme, so set only what the design needs to blend in (its accent, surfaces, borders and text colours), taking colours from the app theme or brand, never the defaults of another product. Radii and sizes are px. Styles are the way to restyle a pack widget: a cssClass only takes effect with workspace Custom styles, and Tailwind class names the pack does not already use are not compiled, so do not rely on either; for a one-off visual a style cannot express, use an Html component. Bind loadingState to the query's isLoading (each widget draws a skeleton or spinner in its own shape); tooltip shows on hover.",
        "usage": "A vertical sidebar fills its height; a horizontal top bar is 40px. Wire onClick to switch-page on components.<name>.value (selectedItem is the clicked item); selectItem on page load does not fire onClick."
      }
    }
  ],
  "unknown_types": []
}
