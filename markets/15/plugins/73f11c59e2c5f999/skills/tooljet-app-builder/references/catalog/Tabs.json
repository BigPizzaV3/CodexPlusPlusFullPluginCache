{
  "components": [
    {
      "type": "Tabs",
      "name": "Tabs",
      "description": "Organize content in tabs",
      "defaultSize": {
        "width": 15,
        "height": 450
      },
      "properties": [
        {
          "key": "useDynamicOptions",
          "label": "Dynamic options",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "loadingState",
          "label": "Loading state",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "visibility",
          "label": "Visibility",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "collapseWhenHidden",
          "label": "Collapse when hidden",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "disabledState",
          "label": "Disable",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "tabs",
          "label": "Tabs",
          "valueType": "array",
          "default": "{{[ \n\t\t{ title: 'Home', id: '0' }, \n\t\t{ title: 'Profile', id: '1' }, \n\t\t{ title: 'Settings', id: '2' } \n ]}}"
        },
        {
          "key": "defaultTab",
          "label": "Default tab",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ],
          "default": "0"
        },
        {
          "key": "hideTabs",
          "label": "Hide tabs",
          "valueType": "boolean",
          "default": false
        },
        {
          "key": "renderOnlyActiveTab",
          "label": "Render only active tab",
          "valueType": "boolean",
          "default": false
        },
        {
          "key": "scrollToTopOnTabSwitch",
          "label": "Scroll to top on tab switch",
          "valueType": "boolean",
          "default": false
        },
        {
          "key": "dynamicHeight",
          "label": "Dynamic height",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "tooltipFormat",
          "label": "Tooltip",
          "default": "plainText",
          "allowedValues": [
            "plainText",
            "markdown",
            "html"
          ]
        },
        {
          "key": "tooltip",
          "label": "Tooltip",
          "valueType": "string",
          "default": ""
        },
        {
          "key": "tabItems",
          "default": [
            {
              "id": "t0",
              "title": "Tab 1",
              "icon": {
                "value": "IconHome2"
              },
              "iconVisibility": {
                "value": false
              },
              "loading": {
                "value": false
              },
              "disable": {
                "value": false
              },
              "visible": {
                "value": true
              },
              "fieldBackgroundColor": {
                "value": "var(--cc-surface1-surface)"
              }
            },
            {
              "id": "t1",
              "title": "Tab 2",
              "icon": {
                "value": "IconHome2"
              },
              "iconVisibility": {
                "value": false
              },
              "loading": {
                "value": false
              },
              "disable": {
                "value": false
              },
              "visible": {
                "value": true
              },
              "fieldBackgroundColor": {
                "value": "var(--cc-surface1-surface)"
              }
            },
            {
              "id": "t2",
              "title": "Tab 3",
              "icon": {
                "value": "IconHome2"
              },
              "iconVisibility": {
                "value": false
              },
              "loading": {
                "value": false
              },
              "disable": {
                "value": false
              },
              "visible": {
                "value": true
              },
              "fieldBackgroundColor": {
                "value": "var(--cc-surface1-surface)"
              }
            }
          ]
        }
      ],
      "styles": [
        {
          "key": "headerBackground",
          "label": "Header background",
          "valueType": "string",
          "default": "var(--cc-surface1-surface)"
        },
        {
          "key": "divider",
          "label": "Divider",
          "valueType": "string",
          "default": "var(--cc-default-border)"
        },
        {
          "key": "unselectedText",
          "label": "Unselected text",
          "valueType": "string",
          "default": "var(--cc-placeholder-text)"
        },
        {
          "key": "selectedText",
          "label": "Selected text",
          "valueType": "string",
          "default": "var(--cc-primary-text)"
        },
        {
          "key": "hoverBackground",
          "label": "Hover Background",
          "valueType": "string",
          "default": "#1B1F24"
        },
        {
          "key": "unselectedIcon",
          "label": "Unselected Icon",
          "valueType": "string",
          "default": "var(--cc-default-icon)"
        },
        {
          "key": "selectedIcon",
          "label": "Selected Icon",
          "valueType": "string",
          "default": "var(--cc-default-icon)"
        },
        {
          "key": "accent",
          "label": "Accent",
          "valueType": "string",
          "default": "var(--cc-primary-brand)"
        },
        {
          "key": "tabWidth",
          "label": "Tab width",
          "default": "auto",
          "allowedValues": [
            "auto",
            "split"
          ]
        },
        {
          "key": "transition",
          "label": "Transition",
          "default": "none",
          "allowedValues": [
            "slide",
            "none"
          ]
        },
        {
          "key": "commonBackgroundColor",
          "label": "Common background color",
          "valueType": "string",
          "default": "var(--cc-surface1-surface)"
        },
        {
          "key": "border",
          "label": "Border",
          "valueType": "string",
          "default": "var(--cc-weak-border)"
        },
        {
          "key": "borderRadius",
          "label": "Border radius",
          "default": "{{6}}"
        },
        {
          "key": "boxShadow",
          "label": "Box shadow",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ],
          "default": "0px 0px 0px 0px #00000040"
        },
        {
          "key": "padding",
          "label": "Padding",
          "valueType": "string",
          "default": "default",
          "allowedValues": [
            "default",
            "none"
          ]
        },
        {
          "key": "highlightColor",
          "default": "var(--cc-primary-brand)"
        },
        {
          "key": "cssClass",
          "label": "CSS class",
          "default": ""
        }
      ],
      "events": [
        {
          "id": "onTabSwitch",
          "label": "On tab switch"
        }
      ],
      "actions": [
        {
          "handle": "setTab",
          "displayName": "Set current tab",
          "params": [
            {
              "handle": "id",
              "displayName": "Id"
            }
          ]
        },
        {
          "handle": "setVisibility",
          "displayName": "Set visibility",
          "params": [
            {
              "handle": "setVisibility",
              "displayName": "Value",
              "defaultValue": "{{false}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setDisable",
          "displayName": "Set disable",
          "params": [
            {
              "handle": "setDisable",
              "displayName": "Value",
              "defaultValue": "{{false}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setLoading",
          "displayName": "Set loading",
          "params": [
            {
              "handle": "setLoading",
              "displayName": "Value",
              "defaultValue": "{{false}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setTabDisable",
          "displayName": "Set Tab disable",
          "params": [
            {
              "handle": "tabId",
              "displayName": "Tab",
              "type": "select",
              "isDynamicOpiton": true,
              "optionsGetter": "component.definition.properties.tabItems.value"
            },
            {
              "handle": "value",
              "type": "toggle",
              "displayName": "Value",
              "defaultValue": "{{false}}"
            }
          ]
        },
        {
          "handle": "setTabLoading",
          "displayName": "Set Tab Loading",
          "params": [
            {
              "handle": "tabId",
              "displayName": "Tab",
              "type": "select",
              "isDynamicOpiton": true,
              "optionsGetter": "component.definition.properties.tabItems.value"
            },
            {
              "handle": "value",
              "type": "toggle",
              "displayName": "Value",
              "defaultValue": "{{false}}"
            }
          ]
        },
        {
          "handle": "setTabVisibility",
          "displayName": "Set Tab visibility",
          "params": [
            {
              "handle": "tabId",
              "displayName": "Tab",
              "type": "select",
              "isDynamicOpiton": true,
              "optionsGetter": "component.definition.properties.tabItems.value"
            },
            {
              "handle": "value",
              "type": "toggle",
              "displayName": "Value",
              "defaultValue": "{{false}}"
            }
          ]
        }
      ],
      "exposedVariables": [
        {
          "name": "currentTab",
          "default": ""
        },
        {
          "name": "currentTabTitle",
          "default": ""
        },
        {
          "name": "isVisible",
          "default": true
        },
        {
          "name": "isDisabled",
          "default": false
        },
        {
          "name": "isLoading",
          "default": false
        }
      ]
    }
  ],
  "unknown_types": []
}
