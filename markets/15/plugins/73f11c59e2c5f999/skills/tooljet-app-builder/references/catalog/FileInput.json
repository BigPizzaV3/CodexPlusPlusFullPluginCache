{
  "components": [
    {
      "type": "FileInput",
      "name": "FileInput",
      "description": "File input",
      "defaultSize": {
        "width": 10,
        "height": 60
      },
      "properties": [
        {
          "key": "label",
          "label": "Label",
          "valueType": "string",
          "default": "Label"
        },
        {
          "key": "instructionText",
          "label": "Placeholder",
          "valueType": "string",
          "default": "Click to select file"
        },
        {
          "key": "enableMultiple",
          "label": "Allow uploading multiple files",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "enableClearSelection",
          "label": "Enable clear selection",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "parseContent",
          "label": "Enable parsing",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "parseFileType",
          "label": "File type",
          "valueType": "string",
          "default": "auto-detect",
          "allowedValues": [
            "auto-detect",
            "csv",
            "xls",
            "xlsx",
            "json"
          ]
        },
        {
          "key": "loadingState",
          "label": "Loading",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "visibility",
          "label": "Visibility",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "disabledState",
          "label": "Disable",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "tooltipFormat",
          "label": "Tooltip",
          "default": "plainText",
          "allowedValues": [
            "plainText",
            "markdown",
            "html"
          ]
        },
        {
          "key": "tooltip",
          "label": "Tooltip",
          "valueType": "string",
          "default": ""
        }
      ],
      "styles": [
        {
          "key": "labelColor",
          "label": "Color",
          "valueType": "string",
          "default": "var(--cc-primary-text)"
        },
        {
          "key": "labelFontSize",
          "label": "Size",
          "valueType": "number",
          "default": "{{12}}"
        },
        {
          "key": "alignment",
          "label": "Alignment",
          "valueType": "string",
          "default": "top",
          "allowedValues": [
            "side",
            "top"
          ]
        },
        {
          "key": "direction",
          "label": "Direction",
          "valueType": "string",
          "default": "left",
          "allowedValues": [
            "left",
            "right"
          ]
        },
        {
          "key": "auto",
          "label": "Width",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "icon",
          "label": "Icon",
          "valueType": "string",
          "default": "IconFileSearch"
        },
        {
          "key": "backgroundColor",
          "label": "Background",
          "valueType": "string",
          "default": "var(--cc-surface1-surface)"
        },
        {
          "key": "borderColor",
          "label": "Border",
          "valueType": "string",
          "default": "var(--cc-default-border)"
        },
        {
          "key": "accentColor",
          "label": "Accent",
          "valueType": "string",
          "default": "var(--cc-primary-brand)"
        },
        {
          "key": "textColor",
          "label": "Text",
          "valueType": "string",
          "default": "var(--cc-primary-text)"
        },
        {
          "key": "errTextColor",
          "label": "Error text",
          "valueType": "string",
          "default": "var(--cc-error-systemStatus)"
        },
        {
          "key": "borderRadius",
          "label": "Border radius",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ],
          "default": "{{6}}"
        },
        {
          "key": "boxShadow",
          "label": "Box shadow",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ],
          "default": "0px 0px 0px 0px #00000040"
        },
        {
          "key": "padding",
          "label": "Padding",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ],
          "default": "default",
          "allowedValues": [
            "default",
            "none"
          ]
        },
        {
          "key": "labelWidth",
          "default": "33"
        },
        {
          "key": "widthType",
          "default": "ofComponent"
        },
        {
          "key": "iconVisibility",
          "default": false
        },
        {
          "key": "iconColor",
          "default": "var(--cc-default-icon)"
        },
        {
          "key": "cssClass",
          "label": "CSS class",
          "default": ""
        }
      ],
      "events": [
        {
          "id": "onFileSelected",
          "label": "On File Selected"
        },
        {
          "id": "onFileLoaded",
          "label": "On File Loaded"
        }
      ],
      "actions": [
        {
          "handle": "clear",
          "displayName": "Clear"
        },
        {
          "handle": "setFocus",
          "displayName": "Set focus"
        },
        {
          "handle": "setBlur",
          "displayName": "Set blur"
        },
        {
          "handle": "setVisibility",
          "displayName": "Set visibility",
          "params": [
            {
              "handle": "disable",
              "displayName": "Value",
              "defaultValue": "{{false}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setDisable",
          "displayName": "Set disable",
          "params": [
            {
              "handle": "disable",
              "displayName": "Value",
              "defaultValue": "{{false}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setLoading",
          "displayName": "Set loading",
          "params": [
            {
              "handle": "loading",
              "displayName": "Value",
              "defaultValue": "{{false}}",
              "type": "toggle"
            }
          ]
        }
      ],
      "exposedVariables": [
        {
          "name": "files",
          "default": []
        },
        {
          "name": "id",
          "default": ""
        },
        {
          "name": "isParsing",
          "default": false
        },
        {
          "name": "isValid",
          "default": true
        },
        {
          "name": "fileSize",
          "default": 0
        },
        {
          "name": "isMandatory",
          "default": false
        },
        {
          "name": "isLoading",
          "default": false
        },
        {
          "name": "isVisible",
          "default": true
        },
        {
          "name": "isDisabled",
          "default": false
        }
      ]
    }
  ],
  "unknown_types": []
}
