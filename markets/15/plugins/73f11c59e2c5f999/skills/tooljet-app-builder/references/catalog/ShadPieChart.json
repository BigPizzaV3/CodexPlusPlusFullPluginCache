{
  "components": [
    {
      "type": "ShadPieChart",
      "name": "ShadPieChart",
      "description": "Pie or donut chart with an optional center figure",
      "defaultSize": {
        "width": 12,
        "height": 280
      },
      "properties": [
        {
          "key": "data",
          "label": "Data",
          "valueType": "array",
          "default": "{{[{ type: 'Charter', value: 62 }, { type: 'Day trip', value: 24 }, { type: 'Event', value: 14 }]}}"
        },
        {
          "key": "categoryField",
          "label": "Category field",
          "valueType": "string",
          "default": "type"
        },
        {
          "key": "valueField",
          "label": "Value field",
          "valueType": "string",
          "default": "value"
        },
        {
          "key": "donut",
          "label": "Donut",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "centerValue",
          "label": "Center figure",
          "valueType": "string",
          "default": ""
        },
        {
          "key": "centerLabel",
          "label": "Center caption",
          "valueType": "string",
          "default": ""
        },
        {
          "key": "showLegend",
          "label": "Legend",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "emptyText",
          "label": "Empty message",
          "valueType": "string",
          "default": "No data"
        },
        {
          "key": "colors",
          "label": "Series colors (in order)",
          "valueType": "array",
          "default": "{{[]}}"
        },
        {
          "key": "highlightClicked",
          "label": "Highlight clicked point",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "loadingState",
          "label": "Loading state",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "loadingIndicator",
          "label": "Loading look",
          "valueType": "string",
          "default": "spinner",
          "allowedValues": [
            "spinner",
            "skeleton"
          ]
        },
        {
          "key": "visibility",
          "label": "Visibility",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "collapseWhenHidden",
          "label": "Collapse when hidden",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "disabledState",
          "label": "Disable",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "tooltipFormat",
          "label": "Tooltip",
          "default": "plainText",
          "allowedValues": [
            "plainText",
            "markdown",
            "html"
          ]
        },
        {
          "key": "tooltip",
          "label": "Tooltip",
          "valueType": "string",
          "default": ""
        }
      ],
      "styles": [
        {
          "key": "boxShadow",
          "label": "Box shadow",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ],
          "default": "0px 0px 0px 0px #00000040"
        },
        {
          "key": "chartColor",
          "label": "Chart color (series palette from it)",
          "valueType": "string"
        },
        {
          "key": "legendTextColor",
          "label": "Legend text color",
          "valueType": "string"
        },
        {
          "key": "sliceBorderColor",
          "label": "Slice border color",
          "valueType": "string"
        },
        {
          "key": "centerValueColor",
          "label": "Center figure color",
          "valueType": "string"
        },
        {
          "key": "centerLabelColor",
          "label": "Center caption color",
          "valueType": "string"
        },
        {
          "key": "cssClass",
          "label": "CSS class",
          "default": ""
        }
      ],
      "events": [
        {
          "id": "onClick",
          "label": "On click"
        },
        {
          "id": "onDoubleClick",
          "label": "On double click"
        }
      ],
      "actions": [
        {
          "handle": "clearClickedPoint",
          "displayName": "Clear clicked point"
        },
        {
          "handle": "setVisibility",
          "displayName": "Set visibility",
          "params": [
            {
              "handle": "value",
              "displayName": "Value",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setDisable",
          "displayName": "Set disable",
          "params": [
            {
              "handle": "value",
              "displayName": "Value",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setLoading",
          "displayName": "Set loading",
          "params": [
            {
              "handle": "value",
              "displayName": "Value",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        }
      ],
      "exposedVariables": [
        {
          "name": "isVisible",
          "default": true
        },
        {
          "name": "isLoading",
          "default": false
        },
        {
          "name": "isDisabled",
          "default": false
        },
        {
          "name": "clickedDataPoint",
          "default": {}
        }
      ],
      "authoringHints": {
        "styles": "Every style falls back to the app theme, so set only what the design needs to blend in (its accent, surfaces, borders and text colours), taking colours from the app theme or brand, never the defaults of another product. Radii and sizes are px. Styles are the way to restyle a pack widget: a cssClass only takes effect with workspace Custom styles, and Tailwind class names the pack does not already use are not compiled, so do not rely on either; for a one-off visual a style cannot express, use an Html component. Bind loadingState to the query's isLoading (each widget draws a skeleton or spinner in its own shape); tooltip shows on hover. chartColor alone gives an on-brand palette (lighter tints and a deeper shade of it for later slices); properties.colors lists explicit slice colours in order."
      }
    }
  ],
  "unknown_types": []
}
