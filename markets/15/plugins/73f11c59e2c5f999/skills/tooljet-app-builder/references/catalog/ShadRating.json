{
  "components": [
    {
      "type": "ShadRating",
      "name": "ShadRating",
      "description": "Rating: a row of 1 to 10 icons (star, heart or circle) with optional half steps and read-only mode; keyboard accessible. Exposes value (number, 0 for none). Height: 24px for the default size (32px for lg), plus 22px with a label",
      "defaultSize": {
        "width": 6,
        "height": 50
      },
      "properties": [
        {
          "key": "label",
          "label": "Label",
          "valueType": "string",
          "default": "Rating"
        },
        {
          "key": "description",
          "label": "Help text",
          "valueType": "string",
          "default": ""
        },
        {
          "key": "defaultValue",
          "label": "Default value",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ],
          "default": "{{4}}"
        },
        {
          "key": "max",
          "label": "Number of icons (1 to 10)",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ],
          "default": "{{5}}"
        },
        {
          "key": "icon",
          "label": "Icon",
          "valueType": "string",
          "default": "star",
          "allowedValues": [
            "star",
            "heart",
            "circle"
          ]
        },
        {
          "key": "size",
          "label": "Size",
          "valueType": "string",
          "default": "default",
          "allowedValues": [
            "sm",
            "default",
            "lg"
          ]
        },
        {
          "key": "allowHalf",
          "label": "Allow half values",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "allowClear",
          "label": "Click the current value to clear",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "readOnly",
          "label": "Read only",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "showValue",
          "label": "Show value text",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "valueLabels",
          "label": "Value labels (one per icon)",
          "valueType": "array",
          "default": "{{[]}}"
        },
        {
          "key": "dynamicHeight",
          "label": "Dynamic height",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "loadingState",
          "label": "Loading state",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "visibility",
          "label": "Visibility",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "collapseWhenHidden",
          "label": "Collapse when hidden",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "disabledState",
          "label": "Disable",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "tooltipFormat",
          "label": "Tooltip",
          "default": "plainText",
          "allowedValues": [
            "plainText",
            "markdown",
            "html"
          ]
        },
        {
          "key": "tooltip",
          "label": "Tooltip",
          "valueType": "string",
          "default": ""
        }
      ],
      "styles": [
        {
          "key": "boxShadow",
          "label": "Box shadow",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ],
          "default": "0px 0px 0px 0px #00000040"
        },
        {
          "key": "filledColor",
          "label": "Filled icon color",
          "valueType": "string"
        },
        {
          "key": "emptyColor",
          "label": "Empty icon color",
          "valueType": "string"
        },
        {
          "key": "valueTextColor",
          "label": "Value text color",
          "valueType": "string"
        },
        {
          "key": "labelColor",
          "label": "Label color",
          "valueType": "string"
        },
        {
          "key": "helpTextColor",
          "label": "Help text color",
          "valueType": "string"
        },
        {
          "key": "accentColor",
          "label": "Focus ring color",
          "valueType": "string"
        },
        {
          "key": "errorColor",
          "label": "Error color",
          "valueType": "string"
        },
        {
          "key": "cssClass",
          "label": "CSS class",
          "default": ""
        }
      ],
      "events": [
        {
          "id": "onChange",
          "label": "On change"
        }
      ],
      "actions": [
        {
          "handle": "setValue",
          "displayName": "Set value",
          "params": [
            {
              "handle": "value",
              "displayName": "Value",
              "defaultValue": "{{3}}"
            }
          ]
        },
        {
          "handle": "clear",
          "displayName": "Clear"
        },
        {
          "handle": "resetValue",
          "displayName": "Reset value"
        },
        {
          "handle": "setVisibility",
          "displayName": "Set visibility",
          "params": [
            {
              "handle": "value",
              "displayName": "Value",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setDisable",
          "displayName": "Set disable",
          "params": [
            {
              "handle": "value",
              "displayName": "Value",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setLoading",
          "displayName": "Set loading",
          "params": [
            {
              "handle": "value",
              "displayName": "Value",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        }
      ],
      "exposedVariables": [
        {
          "name": "isVisible",
          "default": true
        },
        {
          "name": "isLoading",
          "default": false
        },
        {
          "name": "isDisabled",
          "default": false
        },
        {
          "name": "isValid",
          "default": true
        },
        {
          "name": "isMandatory",
          "default": false
        },
        {
          "name": "value",
          "default": 0
        },
        {
          "name": "label",
          "default": "Rating"
        }
      ],
      "authoringHints": {
        "styles": "Every style falls back to the app theme, so set only what the design needs to blend in (its accent, surfaces, borders and text colours), taking colours from the app theme or brand, never the defaults of another product. Radii and sizes are px. Styles are the way to restyle a pack widget: a cssClass only takes effect with workspace Custom styles, and Tailwind class names the pack does not already use are not compiled, so do not rely on either; for a one-off visual a style cannot express, use an Html component. Bind loadingState to the query's isLoading (each widget draws a skeleton or spinner in its own shape); tooltip shows on hover.",
        "usage": "value is 0 when unrated; readOnly for display. About 24px tall, +22 with a label."
      }
    }
  ],
  "unknown_types": []
}
