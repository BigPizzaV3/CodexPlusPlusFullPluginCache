{
  "components": [
    {
      "type": "ModalV2",
      "name": "Modal",
      "description": "Show pop-up windows",
      "defaultSize": {
        "width": 10,
        "height": 40
      },
      "properties": [
        {
          "key": "loadingState",
          "label": "Loading state",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "dynamicHeight",
          "label": "Dynamic height",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "visibility",
          "label": "Modal trigger visibility",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "collapseWhenHidden",
          "label": "Collapse when hidden",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "disabledTrigger",
          "label": "Disable modal trigger",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "disabledModal",
          "label": "Disable modal window",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "useDefaultButton",
          "label": "Use default trigger button",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "triggerButtonLabel",
          "label": "Trigger button label",
          "valueType": "string",
          "default": "Launch Modal"
        },
        {
          "key": "showHeader",
          "label": "Header",
          "default": "{{true}}"
        },
        {
          "key": "showFooter",
          "label": "Footer",
          "default": "{{true}}"
        },
        {
          "key": "size",
          "label": "Width",
          "valueType": "string",
          "default": "lg",
          "allowedValues": [
            "sm",
            "lg",
            "xl",
            "fullscreen"
          ]
        },
        {
          "key": "modalHeight",
          "label": "Height",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ],
          "default": "{{400}}"
        },
        {
          "key": "variant",
          "label": "Kind",
          "valueType": "string",
          "default": "dialog",
          "allowedValues": [
            "dialog",
            "sheet"
          ],
          "description": "'dialog' opens centred. 'sheet' slides in against one edge (side): a right or left sheet takes the full height at the Width's size (sm 360px, lg 480px, xl 640px) and suits detail panels; a top or bottom one takes the full width at the modal's Height. Header, body, footer, close behaviour and actions work the same."
        },
        {
          "key": "side",
          "label": "Sheet side",
          "valueType": "string",
          "default": "right",
          "allowedValues": [
            "right",
            "left",
            "top",
            "bottom"
          ],
          "description": "The edge a sheet opens against; used only when variant is 'sheet'."
        },
        {
          "key": "hideOnEsc",
          "label": "Close on escape key",
          "default": "{{true}}"
        },
        {
          "key": "closeOnClickingOutside",
          "label": "Close on clicking outside",
          "default": "{{false}}"
        },
        {
          "key": "hideCloseButton",
          "label": "Hide close button",
          "default": "{{false}}"
        },
        {
          "key": "tooltipFormat",
          "label": "Tooltip",
          "default": "plainText",
          "allowedValues": [
            "plainText",
            "markdown",
            "html"
          ]
        },
        {
          "key": "tooltip",
          "label": "Tooltip",
          "valueType": "string",
          "default": ""
        },
        {
          "key": "headerHeight",
          "default": 80
        },
        {
          "key": "footerHeight",
          "default": 80
        }
      ],
      "styles": [
        {
          "key": "headerBackgroundColor",
          "label": "Background",
          "valueType": "string",
          "default": "var(--cc-surface1-surface)"
        },
        {
          "key": "headerDividerColor",
          "label": "Divider",
          "valueType": "string",
          "default": "var(--cc-default-border)"
        },
        {
          "key": "bodyBackgroundColor",
          "label": "Background",
          "valueType": "string",
          "default": "var(--cc-surface1-surface)"
        },
        {
          "key": "footerBackgroundColor",
          "label": "Background",
          "valueType": "string",
          "default": "var(--cc-surface1-surface)"
        },
        {
          "key": "footerDividerColor",
          "label": "Divider",
          "valueType": "string",
          "default": "var(--cc-default-border)"
        },
        {
          "key": "triggerButtonBackgroundColor",
          "label": "Background",
          "valueType": "string",
          "default": "var(--cc-primary-brand)"
        },
        {
          "key": "triggerButtonHoverBackgroundMode",
          "label": "Hover background",
          "valueType": "string",
          "default": "auto",
          "allowedValues": [
            "auto",
            "manual"
          ]
        },
        {
          "key": "triggerButtonTextColor",
          "label": "Text",
          "valueType": "string",
          "default": "var(--cc-surface1-surface)"
        },
        {
          "key": "triggerButtonTextSize",
          "label": "Font size",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ],
          "default": "{{14}}"
        },
        {
          "key": "triggerButtonFontWeight",
          "label": "Font Weight",
          "default": "normal",
          "allowedValues": [
            "normal",
            "medium",
            "bold",
            "lighter",
            "bolder"
          ]
        },
        {
          "key": "triggerButtonContentAlignment",
          "label": "Content alignment",
          "valueType": "string",
          "default": "center"
        },
        {
          "key": "icon",
          "label": "Icon",
          "valueType": "string",
          "default": "IconAlignBoxBottomLeft"
        },
        {
          "key": "iconColor",
          "label": "Icon color",
          "valueType": "string",
          "default": "var(--cc-surface1-surface)"
        },
        {
          "key": "iconVisibility",
          "default": false
        },
        {
          "key": "direction",
          "default": "left"
        },
        {
          "key": "triggerButtonHoverBackgroundColor",
          "default": "var(--cc-primary-brand)"
        },
        {
          "key": "cssClass",
          "label": "CSS class",
          "default": ""
        }
      ],
      "events": [
        {
          "id": "onOpen",
          "label": "On open"
        },
        {
          "id": "onClose",
          "label": "On close"
        }
      ],
      "actions": [
        {
          "handle": "open",
          "displayName": "Open"
        },
        {
          "handle": "close",
          "displayName": "Close"
        },
        {
          "handle": "setVisibility",
          "displayName": "Set visibility",
          "params": [
            {
              "handle": "setVisibility",
              "displayName": "Value",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setDisableTrigger",
          "displayName": "Set disable trigger",
          "params": [
            {
              "handle": "setDisableTrigger",
              "displayName": "Value",
              "defaultValue": "{{false}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setDisableModal",
          "displayName": "Set disable modal",
          "params": [
            {
              "handle": "setDisableModal",
              "displayName": "Value",
              "defaultValue": "{{false}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setLoading",
          "displayName": "Set loading",
          "params": [
            {
              "handle": "setLoading",
              "displayName": "Value",
              "defaultValue": "{{false}}",
              "type": "toggle"
            }
          ]
        }
      ],
      "exposedVariables": [
        {
          "name": "show",
          "default": false
        },
        {
          "name": "isDisabledModal",
          "default": false
        },
        {
          "name": "isDisabledTrigger",
          "default": false
        },
        {
          "name": "isVisible",
          "default": true
        },
        {
          "name": "isLoading",
          "default": false
        }
      ],
      "defaultChildren": [
        {
          "componentName": "Text",
          "slotName": "header",
          "layout": {
            "top": 20,
            "left": 1,
            "height": 40
          },
          "displayName": "ModalHeaderTitle",
          "properties": [
            "text"
          ],
          "accessorKey": "text",
          "styles": [
            "fontWeight",
            "textSize",
            "textColor",
            "fontWeight"
          ],
          "defaultValue": {
            "text": "Modal title",
            "textSize": 20,
            "textColor": "var(--cc-primary-text)",
            "fontWeight": "bold"
          }
        },
        {
          "componentName": "Button",
          "slotName": "footer",
          "layout": {
            "top": 20,
            "left": 22,
            "height": 40
          },
          "displayName": "ModalFooterCancel",
          "properties": [
            "text"
          ],
          "styles": [
            "textColor",
            "loaderColor",
            "iconColor",
            "borderRadius",
            "iconVisibility",
            "direction",
            "icon",
            "type",
            "borderColor",
            "padding"
          ],
          "defaultValue": {
            "textColor": "var(--cc-primary-text)",
            "loaderColor": "var(--cc-surface1-surface)",
            "icon": "IconAlignBoxBottomLeft",
            "text": "Button1",
            "type": "outline",
            "borderColor": "var(--cc-default-border)",
            "iconColor": "var(--cc-default-icon)",
            "borderRadius": 6,
            "iconVisibility": false,
            "direction": "left",
            "padding": "default"
          }
        },
        {
          "componentName": "Button",
          "slotName": "footer",
          "layout": {
            "top": 20,
            "left": 32,
            "height": 40
          },
          "displayName": "ModalFooterConfirm",
          "properties": [
            "text"
          ],
          "defaultValue": {
            "text": "Button2",
            "padding": "none"
          }
        }
      ],
      "renderingHints": {
        "childCoordinateSpace": "Modal-local 43-column grid; child (0,0) is the modal body top-left.",
        "recommendedFieldAlignment": "top",
        "recommendedSingleLineFieldHeightPx": 40,
        "topAlignedRenderedFootprintPx": 60,
        "recommendedFieldRowStepPx": "authored field height + 30px (20px label/validation footprint + 10px gap); this is 70px only for a 40px-authored field",
        "recommendedTextAreaHeightPx": "90–100",
        "recommendedTwoColumnGutterCols": 2
      },
      "authoringHints": {
        "nativeSlots": {
          "mcpField": "slot_name",
          "allowedValues": [
            "header",
            "body",
            "footer"
          ],
          "defaultValue": "body",
          "rule": "Put the modal title Text in header, fields/content in body, and native action buttons in footer. Do not leave showHeader enabled with an empty header and add a duplicate title row to the body.",
          "parentRule": "Set parent_ref for a same-batch modal or parent for an existing modal; coordinates are relative to the selected slot canvas."
        },
        "closeLifecycle": {
          "event": "onClose",
          "rule": "Put transient selected-record/form cleanup on ModalV2 onClose, not only on a Cancel button: native X and enabled Escape/outside-dismiss paths must not leave stale selection. If a Table opens the detail modal, deselect its row on close when needed so clicking that same row again can reopen its details. Keep cleanup idempotent and never write or delete database records as cleanup.",
          "verification": "Test Cancel, native X, each enabled dismissal path and successful-save close, then reopen the same record and a different record. Do not assume a working Cancel proves every close path."
        }
      }
    }
  ],
  "unknown_types": []
}
