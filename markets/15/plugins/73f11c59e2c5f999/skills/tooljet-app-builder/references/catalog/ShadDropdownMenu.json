{
  "components": [
    {
      "type": "ShadDropdownMenu",
      "name": "ShadDropdownMenu",
      "description": "Dropdown menu: a trigger button (label + variant, or an icon-only '...' trigger) opening a menu of items [{ label, value, icon?: 'IconPencil', description?, shortcut?: '⌘E', disabled?, visible?, destructive?, separator? (line above), group? (heading) }]. On select fires onSelect with lastClickedOption { label, value, description }. Height 36px (sm 32px, lg 40px)",
      "defaultSize": {
        "width": 6,
        "height": 40
      },
      "properties": [
        {
          "key": "label",
          "label": "Label",
          "valueType": "string",
          "default": "Actions"
        },
        {
          "key": "triggerType",
          "label": "Trigger",
          "valueType": "string",
          "default": "button",
          "allowedValues": [
            "button",
            "icon"
          ]
        },
        {
          "key": "variant",
          "label": "Variant",
          "valueType": "string",
          "default": "outline",
          "allowedValues": [
            "default",
            "secondary",
            "outline",
            "ghost",
            "destructive",
            "link"
          ]
        },
        {
          "key": "size",
          "label": "Size",
          "valueType": "string",
          "default": "default",
          "allowedValues": [
            "sm",
            "default",
            "lg"
          ]
        },
        {
          "key": "triggerIcon",
          "label": "Trigger icon (Tabler name, e.g. IconDots)",
          "valueType": "string",
          "default": ""
        },
        {
          "key": "showChevron",
          "label": "Show chevron",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "fullWidth",
          "label": "Full width",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "items",
          "label": "Items",
          "valueType": "array",
          "default": "{{[{ label: 'Edit', value: 'edit', icon: 'IconPencil', shortcut: '⌘E' }, { label: 'Duplicate', value: 'duplicate', icon: 'IconCopy', shortcut: '⌘D' }, { labe…"
        },
        {
          "key": "menuLabel",
          "label": "Menu heading",
          "valueType": "string",
          "default": ""
        },
        {
          "key": "align",
          "label": "Menu align",
          "valueType": "string",
          "default": "start",
          "allowedValues": [
            "start",
            "center",
            "end"
          ]
        },
        {
          "key": "side",
          "label": "Menu side",
          "valueType": "string",
          "default": "bottom",
          "allowedValues": [
            "bottom",
            "top",
            "right",
            "left"
          ]
        },
        {
          "key": "optionsLoadingState",
          "label": "Options loading state",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "loadingState",
          "label": "Loading state",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "visibility",
          "label": "Visibility",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "collapseWhenHidden",
          "label": "Collapse when hidden",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "disabledState",
          "label": "Disable",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "tooltipFormat",
          "label": "Tooltip",
          "default": "plainText",
          "allowedValues": [
            "plainText",
            "markdown",
            "html"
          ]
        },
        {
          "key": "tooltip",
          "label": "Tooltip",
          "valueType": "string",
          "default": ""
        }
      ],
      "styles": [
        {
          "key": "boxShadow",
          "label": "Box shadow",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ],
          "default": "0px 0px 0px 0px #00000040"
        },
        {
          "key": "backgroundColor",
          "label": "Trigger background",
          "valueType": "string"
        },
        {
          "key": "hoverBackgroundColor",
          "label": "Trigger hover background",
          "valueType": "string"
        },
        {
          "key": "textColor",
          "label": "Trigger text color",
          "valueType": "string"
        },
        {
          "key": "borderColor",
          "label": "Trigger border color",
          "valueType": "string"
        },
        {
          "key": "borderRadius",
          "label": "Trigger radius",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ]
        },
        {
          "key": "menuBackgroundColor",
          "label": "Menu background",
          "valueType": "string"
        },
        {
          "key": "menuBorderColor",
          "label": "Menu border color",
          "valueType": "string"
        },
        {
          "key": "itemTextColor",
          "label": "Item text color",
          "valueType": "string"
        },
        {
          "key": "itemHoverBackgroundColor",
          "label": "Item hover background",
          "valueType": "string"
        },
        {
          "key": "itemHoverTextColor",
          "label": "Item hover text color",
          "valueType": "string"
        },
        {
          "key": "descriptionColor",
          "label": "Item description and shortcut color",
          "valueType": "string"
        },
        {
          "key": "iconColor",
          "label": "Item icon color",
          "valueType": "string"
        },
        {
          "key": "destructiveColor",
          "label": "Destructive item color",
          "valueType": "string"
        },
        {
          "key": "menuRadius",
          "label": "Menu radius",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ]
        },
        {
          "key": "menuWidth",
          "label": "Menu width (px)",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ]
        },
        {
          "key": "cssClass",
          "label": "CSS class",
          "default": ""
        }
      ],
      "events": [
        {
          "id": "onSelect",
          "label": "On select"
        },
        {
          "id": "onOpen",
          "label": "On open"
        },
        {
          "id": "onClose",
          "label": "On close"
        }
      ],
      "actions": [
        {
          "handle": "open",
          "displayName": "Open menu"
        },
        {
          "handle": "close",
          "displayName": "Close menu"
        },
        {
          "handle": "setVisibility",
          "displayName": "Set visibility",
          "params": [
            {
              "handle": "value",
              "displayName": "Value",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setDisable",
          "displayName": "Set disable",
          "params": [
            {
              "handle": "value",
              "displayName": "Value",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setLoading",
          "displayName": "Set loading",
          "params": [
            {
              "handle": "value",
              "displayName": "Value",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        }
      ],
      "exposedVariables": [
        {
          "name": "isVisible",
          "default": true
        },
        {
          "name": "isLoading",
          "default": false
        },
        {
          "name": "isDisabled",
          "default": false
        },
        {
          "name": "lastClickedOption",
          "default": null
        },
        {
          "name": "isOpen",
          "default": false
        }
      ],
      "authoringHints": {
        "styles": "Every style falls back to the app theme, so set only what the design needs to blend in (its accent, surfaces, borders and text colours), taking colours from the app theme or brand, never the defaults of another product. Radii and sizes are px. Styles are the way to restyle a pack widget: a cssClass only takes effect with workspace Custom styles, and Tailwind class names the pack does not already use are not compiled, so do not rely on either; for a one-off visual a style cannot express, use an Html component. Bind loadingState to the query's isLoading (each widget draws a skeleton or spinner in its own shape); tooltip shows on hover.",
        "usage": "triggerType 'icon' gives a row '⋯' menu; branch on components.<name>.lastClickedOption.value in onSelect. 36px tall."
      }
    }
  ],
  "unknown_types": []
}
