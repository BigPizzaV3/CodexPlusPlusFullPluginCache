        },
        {
          "name": "description",
          "default": ""
        },
        {
          "name": "placeholder",
          "default": ""
        },
        {
          "name": "value",
          "default": ""
        },
        {
          "name": "country",
          "default": "US"
        },
        {
          "name": "onlyCountries",
          "default": []
        },
        {
          "name": "isCountryChangeEnabled",
          "default": true
        },
        {
          "name": "showFlag",
          "default": true
        },
        {
          "name": "required",
          "default": false
        },
        {
          "name": "disabled",
          "default": false
        },
        {
          "name": "countryCode",
          "default": "+1"
        },
        {
          "name": "formattedValue",
          "default": ""
        },
        {
          "name": "isValidNumber",
          "default": false
        },
        {
          "name": "isValid",
          "default": true
        },
        {
          "name": "isVisible",
          "default": true
        },
        {
          "name": "isLoading",
          "default": false
        },
        {
          "name": "isDisabled",
          "default": false
        }
      ]
    }
