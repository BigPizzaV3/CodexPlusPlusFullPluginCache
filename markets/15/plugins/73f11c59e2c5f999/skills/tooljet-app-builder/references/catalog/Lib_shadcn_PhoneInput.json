{
  "components": [
    {
      "type": "Lib_shadcn_PhoneInput",
      "name": "Lib_shadcn_PhoneInput",
      "description": "Phone Input from the shadcn UI component library. Sizes to its content in the app (Dynamic height on).",
      "defaultSize": {
        "width": 10,
        "height": 70
      },
      "properties": [
        {
          "key": "label",
          "label": "Label",
          "valueType": "string",
          "default": "Phone number"
        },
        {
          "key": "description",
          "label": "Help text",
          "valueType": "string",
          "default": ""
        },
        {
          "key": "placeholder",
          "label": "Placeholder",
          "valueType": "string",
          "default": ""
        },
        {
          "key": "value",
          "label": "Default number",
          "valueType": "string",
          "default": "",
          "description": "National digits, without the country code."
        },
        {
          "key": "country",
          "label": "Default country",
          "valueType": "string",
          "default": "US",
          "description": "ISO code, e.g. US, IN, GB."
        },
        {
          "key": "onlyCountries",
          "label": "Only these countries",
          "valueType": "array",
          "default": "{{[]}}",
          "description": "ISO codes; empty = all."
        },
        {
          "key": "isCountryChangeEnabled",
          "label": "Allow country change",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "showFlag",
          "label": "Show flag",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "required",
          "label": "Required",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "disabled",
          "label": "Disable",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "countryCode",
          "label": "Country Code",
          "valueType": "string",
          "default": "+1"
        },
        {
          "key": "formattedValue",
          "label": "Formatted Value",
          "valueType": "string",
          "default": ""
        },
        {
          "key": "isValidNumber",
          "label": "Is Valid Number",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "isValid",
          "label": "Is Valid",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "visibility",
          "label": "Visibility",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "loadingState",
          "label": "Loading state",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "disabledState",
          "label": "Disable",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "dynamicHeight",
          "label": "Dynamic height",
          "valueType": "boolean",
          "default": "{{true}}"
        }
      ],
      "styles": [
        {
          "key": "backgroundColor",
          "label": "Background",
          "valueType": "string"
        },
        {
          "key": "textColor",
          "label": "Text",
          "valueType": "string"
        },
        {
          "key": "borderColor",
          "label": "Border",
          "valueType": "string"
        },
        {
          "key": "accentColor",
          "label": "Accent",
          "valueType": "string"
        },
        {
          "key": "borderRadius",
          "label": "Border radius",
          "valueType": "number"
        },
        {
          "key": "boxShadow",
          "label": "Box shadow",
          "valueType": "string"
        }
      ],
      "events": [
        {
          "id": "onChange",
          "label": "On change"
        },
        {
          "id": "onEnterPressed",
          "label": "On enter pressed"
        },
        {
          "id": "onFocus",
          "label": "On focus"
        },
        {
          "id": "onBlur",
          "label": "On blur"
        }
      ],
      "actions": [
        {
          "handle": "setValue",
          "displayName": "Set number",
          "params": [
            {
              "handle": "value",
              "displayName": "Number"
            }
          ]
        },
        {
          "handle": "setCountryCode",
          "displayName": "Set country",
          "params": [
            {
              "handle": "country",
              "displayName": "ISO code"
            }
          ]
        },
        {
          "handle": "clear",
          "displayName": "Clear"
        },
        {
          "handle": "focus",
          "displayName": "Focus"
        },
        {
          "handle": "setVisibility",
          "displayName": "Set visibility",
          "params": [
            {
              "handle": "visibility",
              "displayName": "Value",
              "defaultValue": "{{false}}"
            }
          ]
        },
        {
          "handle": "setLoading",
          "displayName": "Set loading",
          "params": [
            {
              "handle": "loading",
              "displayName": "Value",
              "defaultValue": "{{false}}"
            }
          ]
        },
        {
          "handle": "setDisable",
          "displayName": "Set disable",
          "params": [
            {
              "handle": "disable",
              "displayName": "Value",
              "defaultValue": "{{false}}"
            }
          ]
        }
      ],
      "exposedVariables": [
