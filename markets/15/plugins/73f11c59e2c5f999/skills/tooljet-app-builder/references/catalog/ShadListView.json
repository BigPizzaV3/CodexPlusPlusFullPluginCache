{
  "components": [
    {
      "type": "ShadListView",
      "name": "ShadListView",
      "description": "List or grid: one canvas repeated per item of data; parent components to it and bind them to {{listItem.<field>}}. A click selects the item (selectedItem, selectedRecord; onRecordClicked); optional pagination (client or server side), dividers, hover and selected highlight. Items have a fixed height (rowHeight)",
      "defaultSize": {
        "width": 30,
        "height": 260
      },
      "properties": [
        {
          "key": "data",
          "label": "List data",
          "valueType": "array",
          "default": "{{[{ id: 1, name: 'Ada Lovelace', email: 'ada@example.com', role: 'Engineering' }, { id: 2, name: 'Alan Turing', email: 'alan@example.com', role: 'Research'…"
        },
        {
          "key": "mode",
          "label": "Layout",
          "valueType": "string",
          "default": "list",
          "allowedValues": [
            "list",
            "grid"
          ]
        },
        {
          "key": "columns",
          "label": "Grid columns",
          "valueType": "number",
          "default": "{{3}}"
        },
        {
          "key": "rowHeight",
          "label": "Item height (px)",
          "valueType": "number",
          "default": "{{72}}"
        },
        {
          "key": "gap",
          "label": "Gap between items (px)",
          "valueType": "number",
          "default": "{{8}}"
        },
        {
          "key": "idField",
          "label": "Id field (for selection across data changes)",
          "valueType": "string",
          "default": "id"
        },
        {
          "key": "showBorder",
          "label": "Dividers between items (list)",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "highlightSelectedRow",
          "label": "Highlight selected item",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "enablePagination",
          "label": "Pagination",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "rowsPerPage",
          "label": "Items per page",
          "valueType": "number",
          "default": "{{10}}"
        },
        {
          "key": "serverSidePagination",
          "label": "Server-side pagination (data is one page)",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "totalRecords",
          "label": "Total items (server-side)",
          "valueType": "number",
          "default": "{{0}}"
        },
        {
          "key": "emptyText",
          "label": "Empty message",
          "valueType": "string",
          "default": "No items"
        },
        {
          "key": "dynamicHeight",
          "label": "Dynamic height",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "loadingState",
          "label": "Loading state",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "loadingIndicator",
          "label": "Loading look",
          "valueType": "string",
          "default": "spinner",
          "allowedValues": [
            "spinner",
            "skeleton"
          ]
        },
        {
          "key": "visibility",
          "label": "Visibility",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "collapseWhenHidden",
          "label": "Collapse when hidden",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "disabledState",
          "label": "Disable",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "tooltipFormat",
          "label": "Tooltip",
          "default": "plainText",
          "allowedValues": [
            "plainText",
            "markdown",
            "html"
          ]
        },
        {
          "key": "tooltip",
          "label": "Tooltip",
          "valueType": "string",
          "default": ""
        }
      ],
      "styles": [
        {
          "key": "boxShadow",
          "label": "Box shadow",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ],
          "default": "0px 0px 0px 0px #00000040"
        },
        {
          "key": "accentColor",
          "label": "Accent (selected outline, pagination)",
          "valueType": "string"
        },
        {
          "key": "backgroundColor",
          "label": "List background",
          "valueType": "string"
        },
        {
          "key": "itemBackgroundColor",
          "label": "Item background",
          "valueType": "string"
        },
        {
          "key": "itemHoverBackgroundColor",
          "label": "Item hover background",
          "valueType": "string"
        },
        {
          "key": "selectedItemBackgroundColor",
          "label": "Selected item background",
          "valueType": "string"
        },
        {
          "key": "itemBorderColor",
          "label": "Item border color",
          "valueType": "string"
        },
        {
          "key": "dividerColor",
          "label": "Divider color",
          "valueType": "string"
        },
        {
          "key": "itemBorderRadius",
          "label": "Item radius",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ]
        },
        {
          "key": "itemVariant",
          "label": "Item look",
          "valueType": "string",
          "default": "outline",
          "allowedValues": [
            "plain",
            "outline"
          ]
        },
        {
          "key": "itemShadow",
          "label": "Item shadow",
          "valueType": "string",
          "default": "none",
          "allowedValues": [
            "none",
            "sm",
            "md",
            "lg"
          ]
        },
        {
          "key": "padding",
          "label": "Padding around the list (px)",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ]
        },
        {
          "key": "emptyTextColor",
          "label": "Empty message color",
          "valueType": "string"
        },
        {
          "key": "cssClass",
          "label": "CSS class",
          "default": ""
        }
      ],
      "events": [
        {
          "id": "onRecordClicked",
          "label": "Record clicked"
        },
        {
          "id": "onPageChanged",
          "label": "Page changed"
        }
      ],
      "actions": [
        {
          "handle": "selectItem",
          "displayName": "Select item",
          "params": [
            {
              "handle": "id",
              "displayName": "Item id (idField value)"
            }
          ]
        },
        {
          "handle": "clearSelection",
          "displayName": "Clear selection",
          "params": []
        },
        {
          "handle": "setPage",
          "displayName": "Set page",
          "params": [
            {
              "handle": "page",
              "displayName": "Page (1-based)",
              "defaultValue": "{{1}}"
            }
          ]
        },
        {
          "handle": "setVisibility",
          "displayName": "Set visibility",
          "params": [
            {
              "handle": "value",
              "displayName": "Value",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setDisable",
          "displayName": "Set disable",
          "params": [
            {
              "handle": "value",
              "displayName": "Value",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setLoading",
          "displayName": "Set loading",
          "params": [
            {
              "handle": "value",
              "displayName": "Value",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        }
      ],
      "exposedVariables": [
        {
          "name": "isVisible",
          "default": true
        },
        {
          "name": "isLoading",
          "default": false
        },
        {
          "name": "isDisabled",
          "default": false
        },
        {
          "name": "data",
          "default": []
        },
        {
          "name": "children",
          "default": {}
        },
        {
          "name": "selectedItem",
          "default": {}
        },
        {
          "name": "selectedItemId",
          "default": null
        },
        {
          "name": "selectedRecord",
          "default": {}
        },
        {
          "name": "selectedRecordId",
          "default": null
        },
        {
          "name": "pageIndex",
          "default": 1
        }
      ],
      "defaultChildren": [
        {
          "componentName": "ShadAvatar",
          "layout": {
            "top": 16,
            "left": 1,
            "height": 40,
            "width": 3
          },
          "properties": [
            "names",
            "size"
          ],
          "accessorKey": "name",
          "defaultValue": {
            "size": "{{40}}"
          }
        },
        {
          "componentName": "ShadText",
          "layout": {
            "top": 14,
            "left": 5,
            "height": 22,
            "width": 20
          },
          "properties": [
            "text",
            "tone"
          ],
          "accessorKey": "name",
          "defaultValue": {
            "tone": "small"
          }
        },
        {
          "componentName": "ShadText",
          "layout": {
            "top": 36,
            "left": 5,
            "height": 22,
            "width": 20
          },
          "properties": [
            "text",
            "tone"
          ],
          "accessorKey": "email",
          "defaultValue": {
            "tone": "muted"
          }
        },
        {
          "componentName": "ShadBadge",
          "layout": {
            "top": 24,
            "left": 27,
            "height": 24,
            "width": 7
          },
          "properties": [
            "text",
            "variant"
          ],
          "accessorKey": "role",
          "defaultValue": {
            "variant": "secondary"
          }
        },
        {
          "componentName": "ShadButton",
          "layout": {
            "top": 18,
            "left": 35,
            "height": 36,
            "width": 7
          },
          "properties": [
            "text",
            "variant",
            "size"
          ],
          "defaultValue": {
            "text": "View",
            "variant": "outline",
            "size": "sm"
          }
        }
      ],
      "authoringHints": {
        "list": {
          "content": "One canvas repeated per item: create the item components with parent_ref to the list (no slot) and bind them to {{listItem.<field>}}. Every item has the same height, properties.rowHeight in px: size it to the item content. mode \"grid\" with columns repeats items in a grid; each cell has its own 43-column canvas (a full-cell child is left 0, width 43).",
          "selection": "A click selects the item and fires onRecordClicked: selectedItem (the data item) and selectedItemId (its idField value); selectedRecord / selectedRecordId keep the native Listview meaning (the item's component values and its index). selectItem(id) selects from an action. A button in an item acts on that item through listItem.",
          "paging": "enablePagination with rowsPerPage slices the data client side. With serverSidePagination the data is the current page: bind the query to components.<list>.pageIndex (1-based), set totalRecords for page numbers, and refetch on onPageChanged (fired by the pager, not by setPage).",
          "styles": "Item background, hover, selected, border, radius and shadow, dividers (showBorder, list mode), list background and padding, accent: each falls back to the theme."
        },
        "styles": "Every style falls back to the app theme, so set only what the design needs to blend in (its accent, surfaces, borders and text colours), taking colours from the app theme or brand, never the defaults of another product. Radii and sizes are px. Styles are the way to restyle a pack widget: a cssClass only takes effect with workspace Custom styles, and Tailwind class names the pack does not already use are not compiled, so do not rely on either; for a one-off visual a style cannot express, use an Html component. Bind loadingState to the query's isLoading (each widget draws a skeleton or spinner in its own shape); tooltip shows on hover."
      }
    }
  ],
  "unknown_types": []
}
