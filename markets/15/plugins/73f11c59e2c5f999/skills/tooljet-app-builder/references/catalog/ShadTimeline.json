{
  "components": [
    {
      "type": "ShadTimeline",
      "name": "ShadTimeline",
      "description": "Vertical timeline / activity feed: items [{ title, description, time, status or color, icon? }] (status words such as done, active, pending, failed take theme colours; statusColors maps your own); marker ('dot' or 'icon' with lucide names); density ('comfortable', 'compact'); newestFirst; timePosition ('right', 'top'); dateFormat for ISO times. Clicking an item sets lastClickedItem and fires onItemClicked. Height: about 66px per item with a description (44px without), 50px compact",
      "defaultSize": {
        "width": 14,
        "height": 230
      },
      "properties": [
        {
          "key": "items",
          "label": "Items",
          "valueType": "array",
          "default": "{{[{ title: 'Order placed', description: 'Ada Lovelace placed order #1024', time: '09:12', status: 'done', icon: 'shopping-cart' }, { title: 'Payment confirm…"
        },
        {
          "key": "marker",
          "label": "Marker",
          "valueType": "string",
          "default": "dot",
          "allowedValues": [
            "dot",
            "icon"
          ]
        },
        {
          "key": "density",
          "label": "Density",
          "valueType": "string",
          "default": "comfortable",
          "allowedValues": [
            "comfortable",
            "compact"
          ]
        },
        {
          "key": "newestFirst",
          "label": "Newest first (reverse)",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "timePosition",
          "label": "Time",
          "valueType": "string",
          "default": "right",
          "allowedValues": [
            "right",
            "top"
          ]
        },
        {
          "key": "dateFormat",
          "label": "Date format for ISO times (empty: as given)",
          "valueType": "string",
          "default": ""
        },
        {
          "key": "statusColors",
          "label": "Colours by status",
          "valueType": "object",
          "default": "{{{}}}"
        },
        {
          "key": "dynamicHeight",
          "label": "Dynamic height",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "loadingState",
          "label": "Loading state",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "loadingIndicator",
          "label": "Loading look",
          "valueType": "string",
          "default": "spinner",
          "allowedValues": [
            "spinner",
            "skeleton"
          ]
        },
        {
          "key": "visibility",
          "label": "Visibility",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "collapseWhenHidden",
          "label": "Collapse when hidden",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "disabledState",
          "label": "Disable",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "tooltipFormat",
          "label": "Tooltip",
          "default": "plainText",
          "allowedValues": [
            "plainText",
            "markdown",
            "html"
          ]
        },
        {
          "key": "tooltip",
          "label": "Tooltip",
          "valueType": "string",
          "default": ""
        }
      ],
      "styles": [
        {
          "key": "boxShadow",
          "label": "Box shadow",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ],
          "default": "0px 0px 0px 0px #00000040"
        },
        {
          "key": "markerColor",
          "label": "Marker color (items without status)",
          "valueType": "string"
        },
        {
          "key": "lineColor",
          "label": "Connecting line color",
          "valueType": "string"
        },
        {
          "key": "titleColor",
          "label": "Title color",
          "valueType": "string"
        },
        {
          "key": "descriptionColor",
          "label": "Description color",
          "valueType": "string"
        },
        {
          "key": "timeColor",
          "label": "Time color",
          "valueType": "string"
        },
        {
          "key": "cssClass",
          "label": "CSS class",
          "default": ""
        }
      ],
      "events": [
        {
          "id": "onItemClicked",
          "label": "On item clicked"
        }
      ],
      "actions": [
        {
          "handle": "setVisibility",
          "displayName": "Set visibility",
          "params": [
            {
              "handle": "value",
              "displayName": "Value",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setDisable",
          "displayName": "Set disable",
          "params": [
            {
              "handle": "value",
              "displayName": "Value",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setLoading",
          "displayName": "Set loading",
          "params": [
            {
              "handle": "value",
              "displayName": "Value",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        }
      ],
      "exposedVariables": [
        {
          "name": "isVisible",
          "default": true
        },
        {
          "name": "isLoading",
          "default": false
        },
        {
          "name": "isDisabled",
          "default": false
        },
        {
          "name": "lastClickedItem",
          "default": {}
        }
      ],
      "authoringHints": {
        "styles": "Every style falls back to the app theme, so set only what the design needs to blend in (its accent, surfaces, borders and text colours), taking colours from the app theme or brand, never the defaults of another product. Radii and sizes are px. Styles are the way to restyle a pack widget: a cssClass only takes effect with workspace Custom styles, and Tailwind class names the pack does not already use are not compiled, so do not rely on either; for a one-off visual a style cannot express, use an Html component. Bind loadingState to the query's isLoading (each widget draws a skeleton or spinner in its own shape); tooltip shows on hover.",
        "usage": "items [{ title, description?, time, status or color, icon? }]; status words (done, active, pending, failed...) map to theme colours. About 66px per item with a description."
      }
    }
  ],
  "unknown_types": []
}
