{
  "components": [
    {
      "type": "ShadNumberInput",
      "name": "ShadNumberInput",
      "description": "Number input: value is a number (null when empty), rounded to decimalPlaces (0 to 10); step buttons (stepper: split -/+ at both ends, stacked arrows at the right, or none) and ArrowUp/ArrowDown move by step and stop at the Min/Max value validation; optional prefix/suffix text inside the box (e.g. '$', 'kg') and thousands separators. Height: 64px with a label (label above the control), 36px without; add 24px for help text or a validation message",
      "defaultSize": {
        "width": 10,
        "height": 70
      },
      "properties": [
        {
          "key": "label",
          "label": "Label",
          "valueType": "string",
          "default": "Quantity"
        },
        {
          "key": "description",
          "label": "Help text",
          "valueType": "string",
          "default": ""
        },
        {
          "key": "placeholder",
          "label": "Placeholder",
          "valueType": "string",
          "default": "0"
        },
        {
          "key": "defaultValue",
          "label": "Default value",
          "valueType": "union",
          "valueTypes": [
            "number",
            "string"
          ],
          "default": "{{1}}"
        },
        {
          "key": "decimalPlaces",
          "label": "Decimal places",
          "valueType": "number",
          "default": "{{2}}"
        },
        {
          "key": "step",
          "label": "Step",
          "valueType": "number",
          "default": "{{1}}"
        },
        {
          "key": "stepper",
          "label": "Step buttons",
          "valueType": "string",
          "default": "split",
          "allowedValues": [
            "split",
            "stacked",
            "none"
          ]
        },
        {
          "key": "prefix",
          "label": "Prefix (inside the box)",
          "valueType": "string",
          "default": ""
        },
        {
          "key": "suffix",
          "label": "Suffix (inside the box)",
          "valueType": "string",
          "default": ""
        },
        {
          "key": "thousandSeparator",
