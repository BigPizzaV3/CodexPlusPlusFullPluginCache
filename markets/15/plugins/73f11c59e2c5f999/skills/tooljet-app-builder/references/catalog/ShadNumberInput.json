          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "showClearBtn",
          "label": "Show clear button",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "loadingState",
          "label": "Loading state",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "visibility",
