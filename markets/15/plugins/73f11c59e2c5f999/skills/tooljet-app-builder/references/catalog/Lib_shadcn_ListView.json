{
  "components": [
    {
      "type": "Lib_shadcn_ListView",
      "name": "Lib_shadcn_ListView",
      "description": "List View from the shadcn UI component library. A list of items: itemContent 'fields' (titleField, subtitleField, metaField) or 'components' (rows of child components reading {{listItem}}, rowHeight). Sizes to its content in the app (Dynamic height on).",
      "defaultSize": {
        "width": 30,
        "height": 300
      },
      "properties": [
        {
          "key": "data",
          "label": "Data",
          "valueType": "array",
          "default": "{{[{\"id\":1,\"title\":\"Northwind order #1042\",\"subtitle\":\"Acme Corp · 3 items\",\"meta\":\"$1,240\",\"image\":\"\"},{\"id\":2,\"title\":\"Northwind order #1043\",\"subtitle\":\"Globex · 1 item\",\"meta\":\"$320\",\"image\":\"\"},{\"id\":3,\"title\":\"Northwind order #1044\",\"subtitle\":\"Initech · 7 items\",\"meta\":\"$2,980\",\"image\":\"\"},{\"id\":4,\"title\":\"Northwind order #1045\",\"subtitle\":\"Umbrella · 2 items\",\"meta\":\"$615\",\"image\":\"\"}]}}",
          "description": "Array of objects, e.g. {{queries.getItems.data}}."
        },
        {
          "key": "titleField",
          "label": "Title field",
          "valueType": "string",
          "default": "title"
        },
        {
          "key": "subtitleField",
          "label": "Subtitle field",
          "valueType": "string",
          "default": "subtitle"
        },
        {
          "key": "metaField",
          "label": "Right-side field",
          "valueType": "string",
          "default": "meta"
        },
        {
          "key": "imageField",
          "label": "Image field",
          "valueType": "string",
          "default": "image"
        },
        {
          "key": "idField",
          "label": "Id field",
          "valueType": "string",
          "default": "id"
        },
        {
          "key": "mode",
          "label": "Layout",
          "valueType": "string",
          "default": "list",
          "allowedValues": [
            "list",
            "grid"
          ]
        },
        {
          "key": "columns",
          "label": "Grid columns",
          "valueType": "number",
          "default": "{{3}}"
        },
        {
          "key": "showBorder",
          "label": "Border",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "highlightSelectedRow",
          "label": "Highlight selected",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "enablePagination",
          "label": "Pagination",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "rowsPerPage",
          "label": "Items per page",
          "valueType": "number",
          "default": "{{10}}"
        },
        {
          "key": "emptyText",
          "label": "Empty text",
          "valueType": "string",
          "default": "No items"
        },
        {
          "key": "itemContent",
          "label": "Item content",
          "valueType": "string",
          "default": "fields",
          "allowedValues": [
            "fields",
            "components"
          ]
        },
        {
          "key": "rowHeight",
          "label": "Item height (px)",
          "valueType": "number",
          "default": "{{72}}",
          "minimum": 24,
          "maximum": 1200
        },
        {
          "key": "selectedItemId",
          "label": "Selected Item Id",
          "valueType": "string",
          "default": ""
        },
        {
          "key": "selectedItem",
          "label": "Selected Item",
          "valueType": "object",
          "default": "{{{}}}"
        },
        {
          "key": "pageIndex",
          "label": "Page Index",
          "valueType": "number",
          "default": "{{0}}"
        },
        {
          "key": "visibility",
          "label": "Visibility",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "loadingState",
          "label": "Loading state",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "disabledState",
          "label": "Disable",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "dynamicHeight",
          "label": "Dynamic height",
          "valueType": "boolean",
          "default": "{{true}}"
        }
      ],
      "styles": [
        {
          "key": "accentColor",
          "label": "Accent",
          "valueType": "string"
        },
        {
          "key": "itemBackgroundColor",
          "label": "Item background",
          "valueType": "string"
        },
        {
          "key": "gap",
