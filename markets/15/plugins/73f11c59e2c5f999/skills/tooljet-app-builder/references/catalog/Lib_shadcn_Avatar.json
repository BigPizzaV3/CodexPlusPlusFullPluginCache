{
  "components": [
    {
      "type": "Lib_shadcn_Avatar",
      "name": "Lib_shadcn_Avatar",
      "description": "Avatar from the shadcn UI component library. Drawn at the height you give it.",
      "defaultSize": {
        "width": 10,
        "height": 50
      },
      "properties": [
        {
          "key": "imageUrl",
          "label": "Image URL",
          "valueType": "string",
          "default": "https://github.com/shadcn.png"
        },
        {
          "key": "name",
          "label": "Name",
          "valueType": "string",
          "default": "Jane Cooper"
        },
        {
          "key": "subtitle",
          "label": "Subtitle",
          "valueType": "string",
          "default": "jane@acme.com"
        },
        {
          "key": "showDetails",
          "label": "Show name and subtitle",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "size",
          "label": "Size",
          "valueType": "string",
          "default": "md",
          "allowedValues": [
            "sm",
            "md",
            "lg"
          ]
        },
        {
          "key": "shape",
          "label": "Shape",
          "valueType": "string",
          "default": "circle",
          "allowedValues": [
            "circle",
            "square"
          ]
        },
        {
          "key": "visibility",
          "label": "Visibility",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "loadingState",
          "label": "Loading state",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "disabledState",
          "label": "Disable",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "dynamicHeight",
          "label": "Dynamic height",
          "valueType": "boolean",
          "default": "{{false}}"
        }
      ],
      "styles": [
        {
          "key": "fallbackColor",
          "label": "Initials background",
          "valueType": "string"
        },
        {
          "key": "textColor",
          "label": "Text",
          "valueType": "string"
        },
        {
          "key": "boxShadow",
          "label": "Box shadow",
          "valueType": "string"
        }
      ],
      "events": [
        {
          "id": "onClick",
          "label": "On click"
        }
      ],
      "actions": [
        {
          "handle": "setVisibility",
          "displayName": "Set visibility",
          "params": [
            {
              "handle": "visibility",
              "displayName": "Value",
              "defaultValue": "{{false}}"
            }
          ]
        },
        {
          "handle": "setLoading",
          "displayName": "Set loading",
          "params": [
            {
              "handle": "loading",
              "displayName": "Value",
              "defaultValue": "{{false}}"
            }
          ]
        },
        {
          "handle": "setDisable",
          "displayName": "Set disable",
          "params": [
            {
              "handle": "disable",
              "displayName": "Value",
              "defaultValue": "{{false}}"
            }
          ]
        }
      ],
      "exposedVariables": [
        {
          "name": "imageUrl",
          "default": "https://github.com/shadcn.png"
        },
        {
          "name": "name",
          "default": "Jane Cooper"
        },
        {
          "name": "subtitle",
          "default": "jane@acme.com"
        },
        {
          "name": "showDetails",
          "default": true
        },
        {
          "name": "size",
          "default": "md"
        },
        {
          "name": "shape",
          "default": "circle"
        },
        {
          "name": "isVisible",
          "default": true
        },
        {
          "name": "isLoading",
          "default": false
        },
        {
          "name": "isDisabled",
          "default": false
        }
      ]
    }
  ],
  "unknown_types": []
}
