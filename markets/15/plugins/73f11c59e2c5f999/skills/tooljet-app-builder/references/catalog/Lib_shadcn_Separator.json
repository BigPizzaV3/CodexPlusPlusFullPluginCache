{
  "components": [
    {
      "type": "Lib_shadcn_Separator",
      "name": "Lib_shadcn_Separator",
      "description": "Separator from the shadcn UI component library. Drawn at the height you give it.",
      "defaultSize": {
        "width": 20,
        "height": 30
      },
      "properties": [
        {
          "key": "orientation",
          "label": "Orientation",
          "valueType": "string",
          "default": "horizontal",
          "allowedValues": [
            "horizontal",
            "vertical"
          ]
        },
        {
          "key": "label",
          "label": "Label",
          "valueType": "string",
          "default": "",
          "description": "Optional text in the middle."
        },
        {
          "key": "visibility",
          "label": "Visibility",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "loadingState",
          "label": "Loading state",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "disabledState",
          "label": "Disable",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "dynamicHeight",
          "label": "Dynamic height",
          "valueType": "boolean",
          "default": "{{false}}"
        }
      ],
      "styles": [
        {
          "key": "lineColor",
          "label": "Line",
          "valueType": "string"
        },
        {
          "key": "thickness",
          "label": "Thickness",
          "valueType": "number"
        },
        {
          "key": "boxShadow",
          "label": "Box shadow",
          "valueType": "string"
        }
      ],
      "events": [],
      "actions": [
        {
          "handle": "setVisibility",
          "displayName": "Set visibility",
          "params": [
            {
              "handle": "visibility",
              "displayName": "Value",
              "defaultValue": "{{false}}"
            }
          ]
        },
        {
          "handle": "setLoading",
          "displayName": "Set loading",
          "params": [
            {
              "handle": "loading",
              "displayName": "Value",
              "defaultValue": "{{false}}"
            }
          ]
        },
        {
          "handle": "setDisable",
          "displayName": "Set disable",
          "params": [
            {
              "handle": "disable",
              "displayName": "Value",
              "defaultValue": "{{false}}"
            }
          ]
        }
      ],
      "exposedVariables": [
        {
          "name": "orientation",
          "default": "horizontal"
        },
        {
          "name": "label",
          "default": ""
        },
        {
          "name": "isVisible",
          "default": true
        },
        {
          "name": "isLoading",
          "default": false
        },
        {
          "name": "isDisabled",
          "default": false
        }
      ]
    }
