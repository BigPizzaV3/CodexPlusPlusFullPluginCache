{
  "components": [
    {
      "type": "FilePicker",
      "name": "FilePicker",
      "description": "File Picker",
      "defaultSize": {
        "width": 15,
        "height": 220
      },
      "properties": [
        {
          "key": "label",
          "label": "Label",
          "valueType": "string",
          "default": "Upload files"
        },
        {
          "key": "instructionText",
          "label": "Placeholder",
          "valueType": "string",
          "default": "Drag and drop files here or click to select files"
        },
        {
          "key": "enableDropzone",
          "label": "Use drop zone",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "enablePicker",
          "label": "Use file picker",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "enableMultiple",
          "label": "Allow picking multiple files",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "parseContent",
          "label": "Enable parsing",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "parseFileType",
          "label": "File type",
          "valueType": "string",
          "default": "auto-detect",
          "allowedValues": [
            "auto-detect",
            "csv",
            "tsv",
            "vnd.ms-excel",
            "vnd.openxmlformats-officedocument.spreadsheetml.sheet"
          ]
        },
        {
          "key": "delimiter",
          "label": "Delimiter",
          "valueType": "string",
          "default": ","
        },
        {
          "key": "dynamicHeight",
          "label": "Dynamic height",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "loadingState",
          "label": "Show loading state",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "visibility",
          "label": "Visibility",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "collapseWhenHidden",
          "label": "Collapse when hidden",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "disabledState",
          "label": "Disable",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "tooltipFormat",
          "label": "Tooltip",
          "default": "plainText",
          "allowedValues": [
            "plainText",
            "markdown",
            "html"
          ]
        },
        {
          "key": "tooltip",
          "label": "Tooltip",
          "valueType": "string",
          "default": ""
        }
      ],
      "styles": [
        {
          "key": "dropzoneTitleColor",
          "label": "Title",
          "valueType": "string",
          "default": "var(--cc-primary-text)"
        },
        {
          "key": "borderRadius",
          "label": "Border Radius",
          "valueType": "number",
          "default": "{{6}}"
        },
        {
          "key": "boxShadow",
          "label": "Box shadow",
          "valueType": "string",
          "default": "0px 1px 3px #0000001A"
        },
        {
          "key": "padding",
          "label": "Padding",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ],
          "default": "default",
          "allowedValues": [
            "default",
            "none"
          ]
        },
        {
          "key": "cssClass",
          "label": "CSS class",
          "default": ""
        }
      ],
      "events": [
        {
          "id": "onFileSelected",
          "label": "On File Selected"
        },
        {
          "id": "onFileLoaded",
          "label": "On File Loaded"
        },
        {
          "id": "onFileDeselected",
          "label": "On File Deselected"
        }
      ],
      "actions": [
        {
          "handle": "clearFiles",
          "displayName": "Clear Files"
        },
        {
          "handle": "setFileName",
          "displayName": "Set File Name",
          "params": [
            {
              "handle": "indexOrUpdates",
              "displayName": "Index"
            },
            {
              "handle": "newNameIfSingle",
              "displayName": "New File Name"
            }
          ]
        },
        {
          "handle": "setVisibility",
          "displayName": "Set Visibility",
          "params": [
            {
              "handle": "disable",
              "displayName": "Value",
              "defaultValue": "{{false}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setLoading",
          "displayName": "Set Loading",
          "params": [
            {
              "handle": "loading",
              "displayName": "Value",
              "defaultValue": "{{false}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setDisable",
          "displayName": "Set Disable",
          "params": [
            {
              "handle": "disable",
              "displayName": "Value",
              "defaultValue": "{{false}}",
              "type": "toggle"
            }
          ]
        }
      ],
      "exposedVariables": [
        {
          "name": "file",
          "default": [
            {
              "name": "",
              "content": "",
              "dataURL": "",
              "type": "",
              "parsedValue": null
            }
          ]
        },
        {
          "name": "isParsing",
          "default": false
        },
        {
          "name": "isValid",
          "default": true
        },
        {
          "name": "fileSize",
          "default": 0
        },
        {
          "name": "isMandatory",
          "default": false
        },
        {
          "name": "isLoading",
          "default": false
        },
        {
          "name": "isVisible",
          "default": true
        },
        {
          "name": "isDisabled",
          "default": false
        }
      ],
      "authoringHints": {
        "acceptedTypes": "Use top-level validation.fileType, a comma-separated MIME string; for images and PDFs use image/*,application/pdf. enableValidation controls mandatory state and does not disable the file-type restriction. Labels and parseFileType do not change accepted types.",
        "filePayload": "components.<picker>.file[0].dataURL is bare base64, without a data: prefix; base64Data contains the same payload. Preserve name, type (MIME) and payload together. content is decoded text, not a reliable binary-document representation.",
        "preview": "Never bind bare base64 directly to href or src: it becomes a relative URL. For a consumer that supports data URLs, construct data:<validated MIME>;base64,<payload> from an allowlisted document/image MIME and the stored payload. Browser top-level data-URL navigation may be blocked; use a supported native preview or an explicit Blob download workflow and verify reopening the saved document. Filename display alone does not prove preview works.",
        "processing": "FilePicker reads file content; it does not provide OCR or PDF rasterization. Inspect configured native JS libraries before promising those workflows. Preserve originals and handle missing dependencies honestly."
      }
    }
  ],
  "unknown_types": []
}
