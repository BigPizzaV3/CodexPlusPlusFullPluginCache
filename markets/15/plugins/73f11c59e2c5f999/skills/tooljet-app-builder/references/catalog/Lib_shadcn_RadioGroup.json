{
  "components": [
    {
      "type": "Lib_shadcn_RadioGroup",
      "name": "Lib_shadcn_RadioGroup",
      "description": "Radio Group from the shadcn UI component library. Sizes to its content in the app (Dynamic height on).",
      "defaultSize": {
        "width": 10,
        "height": 110
      },
      "properties": [
        {
          "key": "label",
          "label": "Label",
          "valueType": "string",
          "default": "Notify me about"
        },
        {
          "key": "options",
          "label": "Options",
          "valueType": "array",
          "default": "{{[{\"label\":\"All new messages\",\"value\":\"all\"},{\"label\":\"Direct messages and mentions\",\"value\":\"mentions\"},{\"label\":\"Nothing\",\"value\":\"none\"}]}}",
          "description": "Array of { label, value } objects, or plain strings."
        },
        {
          "key": "value",
          "label": "Default value",
          "valueType": "string",
          "default": "all"
        },
        {
          "key": "orientation",
          "label": "Layout",
          "valueType": "string",
          "default": "vertical",
          "allowedValues": [
            "vertical",
            "horizontal"
          ]
        },
        {
          "key": "disabled",
          "label": "Disable",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "visibility",
          "label": "Visibility",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "loadingState",
          "label": "Loading state",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "disabledState",
          "label": "Disable",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "dynamicHeight",
          "label": "Dynamic height",
          "valueType": "boolean",
          "default": "{{true}}"
        }
      ],
      "styles": [
        {
          "key": "accentColor",
          "label": "Selected",
          "valueType": "string"
        },
        {
          "key": "textColor",
          "label": "Text",
          "valueType": "string"
        },
        {
          "key": "borderColor",
          "label": "Border",
          "valueType": "string"
        },
        {
          "key": "boxShadow",
          "label": "Box shadow",
          "valueType": "string"
        }
      ],
      "events": [
        {
          "id": "onChange",
          "label": "On change"
        }
      ],
      "actions": [
        {
          "handle": "setValue",
          "displayName": "Select option",
          "params": [
            {
              "handle": "value",
              "displayName": "Value"
            }
          ]
        },
        {
          "handle": "setVisibility",
          "displayName": "Set visibility",
          "params": [
            {
              "handle": "visibility",
              "displayName": "Value",
              "defaultValue": "{{false}}"
            }
          ]
        },
        {
          "handle": "setLoading",
          "displayName": "Set loading",
          "params": [
            {
              "handle": "loading",
              "displayName": "Value",
              "defaultValue": "{{false}}"
            }
          ]
        },
        {
          "handle": "setDisable",
          "displayName": "Set disable",
          "params": [
            {
              "handle": "disable",
              "displayName": "Value",
              "defaultValue": "{{false}}"
            }
          ]
        }
      ],
      "exposedVariables": [
        {
          "name": "label",
          "default": "Notify me about"
        },
        {
          "name": "options",
          "default": [
            {
              "label": "All new messages",
              "value": "all"
            },
            {
              "label": "Direct messages and mentions",
              "value": "mentions"
            },
            {
              "label": "Nothing",
              "value": "none"
            }
          ]
        },
        {
          "name": "value",
          "default": "all"
        },
        {
          "name": "orientation",
          "default": "vertical"
        },
        {
          "name": "disabled",
          "default": false
        },
        {
          "name": "isVisible",
          "default": true
        },
        {
          "name": "isLoading",
          "default": false
        },
        {
          "name": "isDisabled",
          "default": false
        }
      ]
    }
  ],
  "unknown_types": []
}
