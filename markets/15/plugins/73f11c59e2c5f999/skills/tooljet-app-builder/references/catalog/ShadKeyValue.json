{
  "components": [
    {
      "type": "ShadKeyValue",
      "name": "ShadKeyValue",
      "description": "Description list for a record's details: data is an object ({ Status: 'Active', Owner: 'Ada' }) or an array of { label, value, type?, format? } with type text, number, currency, date, badge, link or boolean (format: a date format or { currency, decimalPlaces, prefix, suffix }); columns 1 to 4; layout 'inline' (label beside the value, labelWidth) or 'stacked'; dividers; emptyText for blanks; currency, dateFormat and badgeColors defaults; allowCopy. Height: about 41px per row inline, 69px stacked (per column when columns > 1)",
      "defaultSize": {
        "width": 14,
        "height": 260
      },
      "properties": [
        {
          "key": "data",
          "label": "Data (object or array)",
          "valueType": "union",
          "valueTypes": [
            "array",
            "object"
          ],
          "default": "{{[{ label: 'Customer', value: 'Ada Lovelace' }, { label: 'Email', value: 'ada@example.com', type: 'link' }, { label: 'Status', value: 'Active', type: 'badge…"
        },
        {
          "key": "columns",
          "label": "Columns",
          "valueType": "string",
          "default": "1",
          "allowedValues": [
            "1",
            "2",
            "3",
            "4"
          ]
        },
        {
          "key": "layout",
          "label": "Layout",
          "valueType": "string",
          "default": "inline",
          "allowedValues": [
            "stacked",
            "inline"
          ]
        },
        {
          "key": "labelWidth",
          "label": "Label width (side by side; px or %)",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ],
          "default": "40%"
        },
        {
          "key": "dividers",
          "label": "Dividers",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "emptyText",
          "label": "Empty value text",
          "valueType": "string",
          "default": "—"
        },
        {
          "key": "currency",
          "label": "Currency (currency rows)",
          "valueType": "string",
          "default": "USD"
        },
        {
          "key": "locale",
          "label": "Number locale",
          "valueType": "string",
          "default": "en-US"
        },
        {
          "key": "dateFormat",
          "label": "Date format (date rows)",
          "valueType": "string",
          "default": "DD MMM YYYY"
        },
        {
          "key": "badgeColors",
          "label": "Badge colours by value",
          "valueType": "object",
          "default": "{{{ Active: '#16a34a' }}}"
        },
        {
          "key": "allowCopy",
          "label": "Copy button on hover",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "dynamicHeight",
          "label": "Dynamic height",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "loadingState",
          "label": "Loading state",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "loadingIndicator",
          "label": "Loading look",
          "valueType": "string",
          "default": "spinner",
          "allowedValues": [
            "spinner",
            "skeleton"
          ]
        },
        {
          "key": "visibility",
          "label": "Visibility",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "collapseWhenHidden",
          "label": "Collapse when hidden",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "disabledState",
          "label": "Disable",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "tooltipFormat",
          "label": "Tooltip",
          "default": "plainText",
          "allowedValues": [
            "plainText",
            "markdown",
            "html"
          ]
        },
        {
          "key": "tooltip",
          "label": "Tooltip",
          "valueType": "string",
          "default": ""
        }
      ],
      "styles": [
        {
          "key": "boxShadow",
          "label": "Box shadow",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ],
          "default": "0px 0px 0px 0px #00000040"
        },
        {
          "key": "labelColor",
          "label": "Label color",
          "valueType": "string"
        },
        {
          "key": "valueColor",
          "label": "Value color",
          "valueType": "string"
        },
        {
          "key": "dividerColor",
          "label": "Divider color",
          "valueType": "string"
        },
        {
          "key": "linkColor",
          "label": "Link color",
          "valueType": "string"
        },
        {
          "key": "cssClass",
          "label": "CSS class",
          "default": ""
        }
      ],
      "events": [
        {
          "id": "onFieldClick",
          "label": "On field click"
        }
      ],
      "actions": [
        {
          "handle": "setVisibility",
          "displayName": "Set visibility",
          "params": [
            {
              "handle": "value",
              "displayName": "Value",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setDisable",
          "displayName": "Set disable",
          "params": [
            {
              "handle": "value",
              "displayName": "Value",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setLoading",
          "displayName": "Set loading",
          "params": [
            {
              "handle": "value",
              "displayName": "Value",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        }
      ],
      "exposedVariables": [
        {
          "name": "isVisible",
          "default": true
        },
        {
          "name": "isLoading",
          "default": false
        },
        {
          "name": "isDisabled",
          "default": false
        },
        {
          "name": "data",
          "default": []
        },
        {
          "name": "lastClickedField",
          "default": {}
        }
      ],
      "authoringHints": {
        "styles": "Every style falls back to the app theme, so set only what the design needs to blend in (its accent, surfaces, borders and text colours), taking colours from the app theme or brand, never the defaults of another product. Radii and sizes are px. Styles are the way to restyle a pack widget: a cssClass only takes effect with workspace Custom styles, and Tailwind class names the pack does not already use are not compiled, so do not rely on either; for a one-off visual a style cannot express, use an Html component. Bind loadingState to the query's isLoading (each widget draws a skeleton or spinner in its own shape); tooltip shows on hover.",
        "usage": "A record's details: an object or [{ label, value, type?, format? }], types text, number, currency, date, badge, link, boolean; 1 to 4 columns. About 41px per row inline."
      }
    }
  ],
  "unknown_types": []
}
