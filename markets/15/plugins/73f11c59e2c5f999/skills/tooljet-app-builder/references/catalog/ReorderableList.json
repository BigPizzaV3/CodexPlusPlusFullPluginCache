{
  "components": [
    {
      "type": "ReorderableList",
      "name": "ReorderableList",
      "description": "Reorderable List",
      "defaultSize": {
        "width": 10,
        "height": 200
      },
      "properties": [
        {
          "key": "advanced",
          "label": "Dynamic options",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "schema",
          "label": "Schema",
          "default": "{{[{\"label\":\"Card1\",\"value\":\"1\", \"format\": \"plain\"},{\"label\":\"Card2\",\"value\":\"2\", \"format\": \"plain\"},{\"label\":\"Card3\",\"value\":\"3\", \"format\": \"plain\"}]}}"
        },
        {
          "key": "dynamicHeight",
          "label": "Dynamic height",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "loadingState",
          "label": "Loading state",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "visibility",
          "label": "Visibility",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "collapseWhenHidden",
          "label": "Collapse when hidden",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "disabledState",
          "label": "Disable",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "tooltipFormat",
          "label": "Tooltip",
          "default": "plainText",
          "allowedValues": [
            "plainText",
            "markdown",
            "html"
          ]
        },
        {
          "key": "tooltip",
          "label": "Tooltip",
          "valueType": "string",
          "default": ""
        },
        {
          "key": "options",
          "default": [
            {
              "format": "plain",
              "label": "Card1",
              "value": "1"
            },
            {
              "format": "plain",
              "label": "Card2",
              "value": "2"
            },
            {
              "format": "plain",
              "label": "Card3",
              "value": "3"
            }
          ]
        }
      ],
      "styles": [
        {
          "key": "textColor",
          "label": "Text",
          "valueType": "string",
          "default": "var(--cc-primary-text)"
        },
        {
          "key": "padding",
          "label": "Padding",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ],
          "default": "default",
          "allowedValues": [
            "default",
            "none"
          ]
        },
        {
          "key": "cssClass",
          "label": "CSS class",
          "default": ""
        }
      ],
      "events": [
        {
          "id": "onChange",
          "label": "On change"
        }
      ],
      "actions": [
        {
          "handle": "setDisable",
          "displayName": "Set disable",
          "params": [
            {
              "handle": "disable",
              "displayName": "Value",
              "defaultValue": "{{false}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setLoading",
          "displayName": "Set loading",
          "params": [
            {
              "handle": "loading",
              "displayName": "Value",
              "defaultValue": "{{false}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setVisibility",
          "displayName": "Set visibility",
          "params": [
            {
              "handle": "disable",
              "displayName": "Value",
              "defaultValue": "{{false}}",
              "type": "toggle"
            }
          ]
        }
      ],
      "exposedVariables": [
        {
          "name": "options",
          "default": []
        },
        {
          "name": "isVisible",
          "default": true
        },
        {
          "name": "isDisabled",
          "default": false
        },
        {
          "name": "isLoading",
          "default": false
        },
        {
          "name": "values",
          "valueType": "array",
          "semantics": "Ordered option values (options.map(option => option.value)), initialized on mount and refreshed when options/schema change. Published before onChange after a reorder. Persist the order with components.<name>.values, not the nonexistent .value alias; use .options for the full option objects."
        }
      ]
    }
  ],
  "unknown_types": []
}
