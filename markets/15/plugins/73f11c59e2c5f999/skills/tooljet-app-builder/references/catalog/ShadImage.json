{
  "components": [
    {
      "type": "ShadImage",
      "name": "ShadImage",
      "description": "Image: source (URL), alternativeText, imageFit (cover, contain, fill), aspectRatio ('auto' fills the drawn height; '16/9', '4/3', '1/1' size it from the width), caption below, fallback when the URL is empty or fails ('placeholder', 'icon', or 'initials' of fallbackText), showBorder, zoomOnClick lightbox; a skeleton shows while it loads; onClick. Height: as drawn with aspect auto (a caption takes 28px of it)",
      "defaultSize": {
        "width": 10,
        "height": 200
      },
      "properties": [
        {
          "key": "source",
          "label": "Image URL",
          "valueType": "string",
          "default": "https://images.unsplash.com/photo-1506744038136-46273834b3fb?w=800"
        },
        {
          "key": "alternativeText",
          "label": "Alt text",
          "valueType": "string",
          "default": "Mountain lake at sunrise"
        },
        {
          "key": "imageFit",
          "label": "Fit",
          "valueType": "string",
          "default": "cover",
          "allowedValues": [
            "cover",
            "contain",
            "fill"
          ]
        },
        {
          "key": "aspectRatio",
          "label": "Aspect ratio",
          "valueType": "string",
          "default": "auto",
          "allowedValues": [
            "auto",
            "1/1",
            "4/3",
            "3/2",
            "16/9",
            "21/9",
            "3/4",
            "9/16"
          ]
        },
        {
          "key": "caption",
          "label": "Caption",
          "valueType": "string",
          "default": ""
        },
        {
          "key": "fallback",
          "label": "Fallback",
          "valueType": "string",
          "default": "placeholder",
          "allowedValues": [
            "placeholder",
            "icon",
            "initials"
          ]
        },
        {
          "key": "fallbackText",
          "label": "Fallback name (initials) or text",
          "valueType": "string",
          "default": ""
        },
        {
          "key": "showBorder",
          "label": "Border",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "zoomOnClick",
          "label": "Zoom on click (lightbox)",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "dynamicHeight",
          "label": "Dynamic height",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "loadingState",
          "label": "Loading state",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "loadingIndicator",
          "label": "Loading look",
          "valueType": "string",
          "default": "spinner",
          "allowedValues": [
            "spinner",
            "skeleton"
          ]
        },
        {
          "key": "visibility",
          "label": "Visibility",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "collapseWhenHidden",
          "label": "Collapse when hidden",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "disabledState",
          "label": "Disable",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "tooltipFormat",
          "label": "Tooltip",
          "default": "plainText",
          "allowedValues": [
            "plainText",
            "markdown",
            "html"
          ]
        },
        {
          "key": "tooltip",
          "label": "Tooltip",
          "valueType": "string",
          "default": ""
        }
      ],
      "styles": [
        {
          "key": "boxShadow",
          "label": "Box shadow",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ],
          "default": "0px 0px 0px 0px #00000040"
        },
        {
          "key": "borderRadius",
          "label": "Image radius",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ]
        },
        {
          "key": "borderColor",
          "label": "Border color",
          "valueType": "string"
        },
        {
          "key": "backgroundColor",
          "label": "Background (letterbox and fallback)",
          "valueType": "string"
        },
        {
          "key": "fallbackTextColor",
          "label": "Fallback text and icon color",
          "valueType": "string"
        },
        {
          "key": "captionColor",
          "label": "Caption color",
          "valueType": "string"
        },
        {
          "key": "cssClass",
          "label": "CSS class",
          "default": ""
        }
      ],
      "events": [
        {
          "id": "onClick",
          "label": "On click"
        }
      ],
      "actions": [
        {
          "handle": "setImageURL",
          "displayName": "Set image URL",
          "params": [
            {
              "handle": "url",
              "displayName": "URL",
              "defaultValue": ""
            }
          ]
        },
        {
          "handle": "clearImage",
          "displayName": "Clear image"
        },
        {
          "handle": "setVisibility",
          "displayName": "Set visibility",
          "params": [
            {
              "handle": "value",
              "displayName": "Value",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setDisable",
          "displayName": "Set disable",
          "params": [
            {
              "handle": "value",
              "displayName": "Value",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setLoading",
          "displayName": "Set loading",
          "params": [
            {
              "handle": "value",
              "displayName": "Value",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        }
      ],
      "exposedVariables": [
        {
          "name": "isVisible",
          "default": true
        },
        {
          "name": "isLoading",
          "default": false
        },
        {
          "name": "isDisabled",
          "default": false
        },
        {
          "name": "hasError",
          "default": false
        },
        {
          "name": "imageURL",
          "default": ""
        },
        {
          "name": "alternativeText",
          "default": ""
        }
      ],
      "authoringHints": {
        "styles": "Every style falls back to the app theme, so set only what the design needs to blend in (its accent, surfaces, borders and text colours), taking colours from the app theme or brand, never the defaults of another product. Radii and sizes are px. Styles are the way to restyle a pack widget: a cssClass only takes effect with workspace Custom styles, and Tailwind class names the pack does not already use are not compiled, so do not rely on either; for a one-off visual a style cannot express, use an Html component. Bind loadingState to the query's isLoading (each widget draws a skeleton or spinner in its own shape); tooltip shows on hover.",
        "usage": "aspectRatio 'auto' fills the drawn box; a ratio such as '16/9' sizes it from the width. Fallback shows when the URL is empty or fails."
      }
    }
  ],
  "unknown_types": []
}
