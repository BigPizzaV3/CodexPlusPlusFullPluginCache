        },
        {
          "key": "value",
          "label": "Default value",
          "valueType": "number",
          "default": "{{3}}"
        },
        {
          "key": "max",
          "label": "Stars",
          "valueType": "number",
          "default": "{{5}}"
        },
        {
          "key": "readOnly",
          "label": "Read only",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "visibility",
          "label": "Visibility",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "loadingState",
          "label": "Loading state",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "disabledState",
          "label": "Disable",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "dynamicHeight",
          "label": "Dynamic height",
          "valueType": "boolean",
          "default": "{{true}}"
        }
      ],
      "styles": [
        {
          "key": "starColor",
          "label": "Star color",
          "valueType": "string"
        },
        {
          "key": "starSize",
          "label": "Star size",
          "valueType": "number"
        },
        {
          "key": "boxShadow",
          "label": "Box shadow",
          "valueType": "string"
        }
