      "exposedVariables": [
        {
          "name": "label",
          "default": "Rate your experience"
        },
        {
          "name": "value",
          "default": 3
        },
        {
          "name": "max",
          "default": 5
        },
        {
          "name": "readOnly",
          "default": false
        },
        {
          "name": "isVisible",
          "default": true
        },
        {
          "name": "isLoading",
          "default": false
        },
        {
          "name": "isDisabled",
          "default": false
