{
  "components": [
    {
      "type": "Lib_shadcn_Stepper",
      "name": "Lib_shadcn_Stepper",
      "description": "Stepper from the shadcn UI component library. Drawn at the height you give it.",
      "defaultSize": {
        "width": 20,
        "height": 500
      },
      "properties": [
        {
          "key": "steps",
          "label": "Steps",
          "valueType": "array",
          "default": "{{[{\"id\":\"account\",\"label\":\"Account\"},{\"id\":\"profile\",\"label\":\"Profile\"},{\"id\":\"review\",\"label\":\"Review\"}]}}",
          "description": "Array of { id, label } objects. Keep ids stable: dropped components stay with their step id."
        },
        {
          "key": "currentStep",
          "label": "Start step",
          "valueType": "string",
          "default": "account"
        },
        {
          "key": "finishLabel",
          "label": "Finish button",
          "valueType": "string",
          "default": "Finish"
        },
        {
          "key": "visibility",
          "label": "Visibility",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "loadingState",
          "label": "Loading state",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "disabledState",
          "label": "Disable",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "dynamicHeight",
          "label": "Dynamic height",
          "valueType": "boolean",
          "default": "{{false}}"
        }
      ],
      "styles": [
        {
          "key": "accentColor",
          "label": "Accent",
          "valueType": "string"
        },
        {
          "key": "backgroundColor",
          "label": "Background",
          "valueType": "string"
        },
        {
          "key": "borderRadius",
          "label": "Border radius",
          "valueType": "number"
        },
        {
          "key": "padding",
          "label": "Padding",
          "valueType": "number"
        },
        {
          "key": "boxShadow",
          "label": "Box shadow",
          "valueType": "string"
        }
      ],
      "events": [
        {
          "id": "onStepChange",
          "label": "On step change"
        },
        {
          "id": "onComplete",
          "label": "On complete"
        }
      ],
      "actions": [
        {
          "handle": "next",
          "displayName": "Next step"
        },
        {
          "handle": "back",
          "displayName": "Previous step"
        },
        {
          "handle": "goToStep",
          "displayName": "Go to step",
          "params": [
            {
              "handle": "id",
              "displayName": "Step id"
            }
          ]
        },
        {
          "handle": "setVisibility",
          "displayName": "Set visibility",
          "params": [
            {
              "handle": "visibility",
              "displayName": "Value",
              "defaultValue": "{{false}}"
            }
          ]
        },
        {
          "handle": "setLoading",
          "displayName": "Set loading",
          "params": [
            {
              "handle": "loading",
              "displayName": "Value",
              "defaultValue": "{{false}}"
            }
          ]
        },
        {
          "handle": "setDisable",
          "displayName": "Set disable",
          "params": [
            {
              "handle": "disable",
              "displayName": "Value",
              "defaultValue": "{{false}}"
            }
          ]
        }
      ],
      "exposedVariables": [
        {
          "name": "steps",
          "default": [
            {
              "id": "account",
              "label": "Account"
            },
            {
              "id": "profile",
              "label": "Profile"
            },
            {
              "id": "review",
              "label": "Review"
            }
          ]
        },
        {
          "name": "currentStep",
          "default": "account"
        },
        {
          "name": "finishLabel",
          "default": "Finish"
        },
        {
          "name": "isVisible",
          "default": true
        },
        {
          "name": "isLoading",
          "default": false
        },
        {
          "name": "isDisabled",
          "default": false
        }
      ]
    }
  ],
  "unknown_types": []
}
