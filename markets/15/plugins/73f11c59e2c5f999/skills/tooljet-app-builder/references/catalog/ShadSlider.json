{
  "components": [
    {
      "type": "ShadSlider",
      "name": "ShadSlider",
      "description": "Slider, single value or range. Height: 64px with a label (label above the control), 36px without; add 24px for help text",
      "defaultSize": {
        "width": 14,
        "height": 60
      },
      "properties": [
        {
          "key": "label",
          "label": "Label",
          "valueType": "string",
          "default": "Label"
        },
        {
          "key": "description",
          "label": "Help text",
          "valueType": "string",
          "default": ""
        },
        {
          "key": "min",
          "label": "Minimum",
          "valueType": "number",
          "default": "{{0}}"
        },
        {
          "key": "max",
          "label": "Maximum",
          "valueType": "number",
          "default": "{{100}}"
        },
        {
          "key": "step",
          "label": "Step",
          "valueType": "number",
          "default": "{{1}}"
        },
        {
          "key": "range",
          "label": "Range",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "defaultValue",
          "label": "Default value (number, or [start, end] for a range)",
          "valueType": "union",
          "valueTypes": [
            "number",
            "array"
          ],
          "default": "{{50}}"
        },
        {
          "key": "loadingState",
          "label": "Loading state",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "visibility",
          "label": "Visibility",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "collapseWhenHidden",
          "label": "Collapse when hidden",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "disabledState",
          "label": "Disable",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "tooltipFormat",
          "label": "Tooltip",
          "default": "plainText",
          "allowedValues": [
            "plainText",
            "markdown",
            "html"
          ]
        },
        {
          "key": "tooltip",
          "label": "Tooltip",
          "valueType": "string",
          "default": ""
        }
      ],
      "styles": [
        {
          "key": "boxShadow",
          "label": "Box shadow",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ],
          "default": "0px 0px 0px 0px #00000040"
        },
        {
          "key": "accentColor",
          "label": "Range and handle color",
          "valueType": "string"
        },
        {
          "key": "labelColor",
          "label": "Label color",
          "valueType": "string"
        },
        {
          "key": "helpTextColor",
          "label": "Help text color",
          "valueType": "string"
        },
        {
          "key": "trackColor",
          "label": "Track color",
          "valueType": "string"
        },
        {
          "key": "cssClass",
          "label": "CSS class",
          "default": ""
        }
      ],
      "events": [
        {
          "id": "onChange",
          "label": "On change (on release)"
        }
      ],
      "actions": [
        {
          "handle": "setValue",
          "displayName": "Set value",
          "params": [
            {
              "handle": "num1",
              "displayName": "Value",
              "defaultValue": "{{50}}"
            }
          ]
        },
        {
          "handle": "setRangeValue",
          "displayName": "Set range value",
          "params": [
            {
              "handle": "num1",
              "displayName": "Start",
              "defaultValue": "{{20}}"
            },
            {
              "handle": "num2",
              "displayName": "End",
              "defaultValue": "{{80}}"
            }
          ]
        },
        {
          "handle": "reset",
          "displayName": "Reset"
        },
        {
          "handle": "setVisibility",
          "displayName": "Set visibility",
          "params": [
            {
              "handle": "value",
              "displayName": "Value",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setDisable",
          "displayName": "Set disable",
          "params": [
            {
              "handle": "value",
              "displayName": "Value",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setLoading",
          "displayName": "Set loading",
          "params": [
            {
              "handle": "value",
              "displayName": "Value",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        }
      ],
      "exposedVariables": [
        {
          "name": "isVisible",
          "default": true
        },
        {
          "name": "isLoading",
          "default": false
        },
        {
          "name": "isDisabled",
          "default": false
        },
        {
          "name": "value",
          "default": 50
        },
        {
          "name": "label",
          "default": "Label"
        }
      ],
      "authoringHints": {
        "styles": "Every style falls back to the app theme, so set only what the design needs to blend in (its accent, surfaces, borders and text colours), taking colours from the app theme or brand, never the defaults of another product. Radii and sizes are px. Styles are the way to restyle a pack widget: a cssClass only takes effect with workspace Custom styles, and Tailwind class names the pack does not already use are not compiled, so do not rely on either; for a one-off visual a style cannot express, use an Html component. Bind loadingState to the query's isLoading (each widget draws a skeleton or spinner in its own shape); tooltip shows on hover."
      }
    }
  ],
  "unknown_types": []
}
