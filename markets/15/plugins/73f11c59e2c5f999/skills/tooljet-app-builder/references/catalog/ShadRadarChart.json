{
  "components": [
    {
      "type": "ShadRadarChart",
      "name": "ShadRadarChart",
      "description": "Radar (spider) chart comparing scores across categories: data [{ skill: 'Speed', alex: 86, jordan: 65 }], categoryField 'skill' (one spoke per row), yFields 'alex,jordan' (one filled polygon each); fillOpacity, gridShape polygon/circle, dots, legend, maxValue (blank = auto). Best square, 240-320 px; clicking sets clickedDataPoint and fires onClick.",
      "defaultSize": {
        "width": 12,
        "height": 300
      },
      "properties": [
        {
          "key": "data",
          "label": "Data",
          "valueType": "array",
          "default": "{{[{ skill: 'Speed', alex: 86, jordan: 65 }, { skill: 'Quality', alex: 72, jordan: 90 }, { skill: 'Support', alex: 64, jordan: 78 }, { skill: 'Pricing', alex…"
        },
        {
          "key": "categoryField",
          "label": "Category field",
          "valueType": "string",
          "default": "skill"
        },
        {
          "key": "yFields",
          "label": "Series fields (one or many)",
          "valueType": "union",
          "valueTypes": [
            "string",
            "array"
          ],
          "default": "{{['alex', 'jordan']}}"
        },
        {
          "key": "maxValue",
          "label": "Max value (blank = auto)",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ],
          "default": "{{100}}"
        },
        {
          "key": "fillOpacity",
          "label": "Fill opacity (0 to 1)",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ],
          "default": "{{0.5}}"
        },
        {
          "key": "gridShape",
          "label": "Grid shape",
          "valueType": "string",
          "default": "polygon",
          "allowedValues": [
            "polygon",
            "circle"
          ]
        },
        {
          "key": "showGrid",
          "label": "Grid",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "showDots",
          "label": "Dots",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "valuePrefix",
          "label": "Value prefix",
          "valueType": "string",
          "default": ""
        },
        {
          "key": "valueSuffix",
          "label": "Value suffix",
          "valueType": "string",
          "default": ""
        },
        {
          "key": "emptyText",
          "label": "Empty message",
          "valueType": "string",
          "default": "No data"
        },
        {
          "key": "animate",
          "label": "Animate",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "showLegend",
          "label": "Legend",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "seriesLabels",
          "label": "Series labels ({ field: label })",
          "valueType": "union",
          "valueTypes": [
            "object",
            "array"
          ],
          "default": "{{{} }}"
        },
        {
          "key": "colors",
          "label": "Series colors (in order)",
          "valueType": "array",
          "default": "{{[]}}"
        },
        {
          "key": "highlightClicked",
          "label": "Highlight clicked point",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "loadingState",
          "label": "Loading state",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "loadingIndicator",
          "label": "Loading look",
          "valueType": "string",
          "default": "spinner",
          "allowedValues": [
            "spinner",
            "skeleton"
          ]
        },
        {
          "key": "visibility",
          "label": "Visibility",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "collapseWhenHidden",
          "label": "Collapse when hidden",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "disabledState",
          "label": "Disable",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "tooltipFormat",
          "label": "Tooltip",
          "default": "plainText",
          "allowedValues": [
            "plainText",
            "markdown",
            "html"
          ]
        },
        {
          "key": "tooltip",
          "label": "Tooltip",
          "valueType": "string",
          "default": ""
        }
      ],
      "styles": [
        {
          "key": "boxShadow",
          "label": "Box shadow",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ],
          "default": "0px 0px 0px 0px #00000040"
        },
        {
          "key": "chartColor",
          "label": "Chart color (series palette from it)",
          "valueType": "string"
        },
        {
          "key": "gridColor",
          "label": "Grid line color",
          "valueType": "string"
        },
        {
          "key": "axisTextColor",
          "label": "Axis label color",
          "valueType": "string"
        },
        {
          "key": "legendTextColor",
          "label": "Legend text color",
          "valueType": "string"
        },
        {
          "key": "cssClass",
          "label": "CSS class",
          "default": ""
        }
      ],
      "events": [
        {
          "id": "onClick",
          "label": "On click"
        },
        {
          "id": "onDoubleClick",
          "label": "On double click"
        }
      ],
      "actions": [
        {
          "handle": "clearClickedPoint",
          "displayName": "Clear clicked point"
        },
        {
          "handle": "setVisibility",
          "displayName": "Set visibility",
          "params": [
            {
              "handle": "value",
              "displayName": "Value",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setDisable",
          "displayName": "Set disable",
          "params": [
            {
              "handle": "value",
              "displayName": "Value",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setLoading",
          "displayName": "Set loading",
          "params": [
            {
              "handle": "value",
              "displayName": "Value",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        }
      ],
      "exposedVariables": [
        {
          "name": "isVisible",
          "default": true
        },
        {
          "name": "isLoading",
          "default": false
        },
        {
          "name": "isDisabled",
          "default": false
        },
        {
          "name": "clickedDataPoint",
          "default": {}
        }
      ],
      "authoringHints": {
        "styles": "Every style falls back to the app theme, so set only what the design needs to blend in (its accent, surfaces, borders and text colours), taking colours from the app theme or brand, never the defaults of another product. Radii and sizes are px. Styles are the way to restyle a pack widget: a cssClass only takes effect with workspace Custom styles, and Tailwind class names the pack does not already use are not compiled, so do not rely on either; for a one-off visual a style cannot express, use an Html component. Bind loadingState to the query's isLoading (each widget draws a skeleton or spinner in its own shape); tooltip shows on hover.",
        "usage": "Rows [{ skill: 'Speed', alex: 86 }] with categoryField 'skill'; set maxValue 100 for scores. Keep it square, 240 to 320px."
      }
    }
  ],
  "unknown_types": []
}
