{
  "components": [
    {
      "type": "ShadCircularProgress",
      "name": "ShadCircularProgress",
      "description": "Circular progress ring: value 0 to 100 (clamped), size and thickness (px), lineCap ('round', 'flat'), centerText ('value' shows 63%, 'custom' shows text, 'none') with an optional label under it; barColor (default: the primary), trackColor, textColor, labelColor styles. Height: the size (96px by default)",
      "defaultSize": {
        "width": 5,
        "height": 100
      },
      "properties": [
        {
          "key": "value",
          "label": "Value (0 to 100)",
          "valueType": "number",
          "default": "{{63}}"
        },
        {
          "key": "size",
          "label": "Size (px)",
          "valueType": "number",
          "default": "{{96}}"
        },
        {
          "key": "thickness",
          "label": "Thickness (px)",
          "valueType": "number",
          "default": "{{8}}"
        },
        {
          "key": "lineCap",
          "label": "Ends",
          "valueType": "string",
          "default": "round",
          "allowedValues": [
            "round",
            "flat"
          ]
        },
        {
          "key": "centerText",
          "label": "Centre text",
          "valueType": "string",
          "default": "value",
          "allowedValues": [
            "value",
            "custom",
            "none"
          ]
        },
        {
          "key": "text",
          "label": "Custom centre text",
          "valueType": "string",
          "default": ""
        },
        {
          "key": "label",
          "label": "Sub-label",
          "valueType": "string",
          "default": "Complete"
        },
        {
          "key": "dynamicHeight",
          "label": "Dynamic height",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "loadingState",
          "label": "Loading state",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "loadingIndicator",
          "label": "Loading look",
          "valueType": "string",
          "default": "spinner",
          "allowedValues": [
            "spinner",
            "skeleton"
          ]
        },
        {
          "key": "visibility",
          "label": "Visibility",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "collapseWhenHidden",
          "label": "Collapse when hidden",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "disabledState",
          "label": "Disable",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "tooltipFormat",
          "label": "Tooltip",
          "default": "plainText",
          "allowedValues": [
            "plainText",
            "markdown",
            "html"
          ]
        },
        {
          "key": "tooltip",
          "label": "Tooltip",
          "valueType": "string",
          "default": ""
        }
      ],
      "styles": [
        {
          "key": "boxShadow",
          "label": "Box shadow",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ],
          "default": "0px 0px 0px 0px #00000040"
        },
        {
          "key": "barColor",
          "label": "Bar color",
          "valueType": "string"
        },
        {
          "key": "trackColor",
          "label": "Track color",
          "valueType": "string"
        },
        {
          "key": "textColor",
          "label": "Centre text color",
          "valueType": "string"
        },
        {
          "key": "labelColor",
          "label": "Sub-label color",
          "valueType": "string"
        },
        {
          "key": "alignment",
          "label": "Alignment",
          "valueType": "string",
          "default": "center"
        },
        {
          "key": "cssClass",
          "label": "CSS class",
          "default": ""
        }
      ],
      "events": [],
      "actions": [
        {
          "handle": "setValue",
          "displayName": "Set value",
          "params": [
            {
              "handle": "value",
              "displayName": "Percent",
              "defaultValue": "{{50}}"
            }
          ]
        },
        {
          "handle": "setVisibility",
          "displayName": "Set visibility",
          "params": [
            {
              "handle": "value",
              "displayName": "Value",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setDisable",
          "displayName": "Set disable",
          "params": [
            {
              "handle": "value",
              "displayName": "Value",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setLoading",
          "displayName": "Set loading",
          "params": [
            {
              "handle": "value",
              "displayName": "Value",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        }
      ],
      "exposedVariables": [
        {
          "name": "isVisible",
          "default": true
        },
        {
          "name": "isLoading",
          "default": false
        },
        {
          "name": "isDisabled",
          "default": false
        },
        {
          "name": "value",
          "default": 0
        }
      ],
      "authoringHints": {
        "styles": "Every style falls back to the app theme, so set only what the design needs to blend in (its accent, surfaces, borders and text colours), taking colours from the app theme or brand, never the defaults of another product. Radii and sizes are px. Styles are the way to restyle a pack widget: a cssClass only takes effect with workspace Custom styles, and Tailwind class names the pack does not already use are not compiled, so do not rely on either; for a one-off visual a style cannot express, use an Html component. Bind loadingState to the query's isLoading (each widget draws a skeleton or spinner in its own shape); tooltip shows on hover.",
        "usage": "value 0 to 100; centerText value, custom or none with a sub-label. Height equals the size."
      }
    }
  ],
  "unknown_types": []
}
