{
  "components": [
    {
      "type": "ShadTags",
      "name": "ShadTags",
      "description": "Read-only tag chips: tags is an array or a comma-separated string; tagColors maps a value to a colour ({ Paid: '#16a34a' }: tinted chip, light background and strong text of that hue); variant ('soft', 'outline', 'solid'), size ('sm', 'default', 'lg'), overflow ('wrap', or 'single' for one line with +N), pill. Clicking a tag sets lastClickedTag and fires onTagClicked. Height: 24px per line",
      "defaultSize": {
        "width": 12,
        "height": 30
      },
      "properties": [
        {
          "key": "tags",
          "label": "Tags (array or comma-separated)",
          "valueType": "union",
          "valueTypes": [
            "array",
            "string"
          ],
          "default": "{{['Design', 'Frontend', 'Urgent']}}"
        },
        {
          "key": "tagColors",
          "label": "Colours by tag",
          "valueType": "object",
          "default": "{{{ Urgent: '#dc2626' }}}"
        },
        {
          "key": "variant",
          "label": "Variant",
          "valueType": "string",
          "default": "soft",
          "allowedValues": [
            "soft",
            "outline",
            "solid"
          ]
        },
        {
          "key": "size",
          "label": "Size",
          "valueType": "string",
          "default": "default",
          "allowedValues": [
            "sm",
            "default",
            "lg"
          ]
        },
        {
          "key": "overflow",
          "label": "Overflow",
          "valueType": "string",
          "default": "wrap",
          "allowedValues": [
            "wrap",
            "single"
          ]
        },
        {
          "key": "pill",
          "label": "Pill shape",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "dynamicHeight",
          "label": "Dynamic height",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "loadingState",
          "label": "Loading state",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "loadingIndicator",
          "label": "Loading look",
          "valueType": "string",
          "default": "spinner",
          "allowedValues": [
            "spinner",
            "skeleton"
          ]
        },
        {
          "key": "visibility",
          "label": "Visibility",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "collapseWhenHidden",
          "label": "Collapse when hidden",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "disabledState",
          "label": "Disable",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "tooltipFormat",
          "label": "Tooltip",
          "default": "plainText",
          "allowedValues": [
            "plainText",
            "markdown",
            "html"
          ]
        },
        {
          "key": "tooltip",
          "label": "Tooltip",
          "valueType": "string",
          "default": ""
        }
      ],
      "styles": [
        {
          "key": "boxShadow",
          "label": "Box shadow",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ],
          "default": "0px 0px 0px 0px #00000040"
        },
        {
          "key": "backgroundColor",
          "label": "Tag background (unmapped tags)",
          "valueType": "string"
        },
        {
          "key": "textColor",
          "label": "Tag text color (unmapped tags)",
          "valueType": "string"
        },
        {
          "key": "borderColor",
          "label": "Tag border color",
          "valueType": "string"
        },
        {
          "key": "borderRadius",
          "label": "Tag radius",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ]
        },
        {
          "key": "cssClass",
          "label": "CSS class",
          "default": ""
        }
      ],
      "events": [
        {
          "id": "onTagClicked",
          "label": "On tag clicked"
        }
      ],
      "actions": [
        {
          "handle": "setVisibility",
          "displayName": "Set visibility",
          "params": [
            {
              "handle": "value",
              "displayName": "Value",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setDisable",
          "displayName": "Set disable",
          "params": [
            {
              "handle": "value",
              "displayName": "Value",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setLoading",
          "displayName": "Set loading",
          "params": [
            {
              "handle": "value",
              "displayName": "Value",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        }
      ],
      "exposedVariables": [
        {
          "name": "isVisible",
          "default": true
        },
        {
          "name": "isLoading",
          "default": false
        },
        {
          "name": "isDisabled",
          "default": false
        },
        {
          "name": "lastClickedTag",
          "default": ""
        },
        {
          "name": "tags",
          "default": []
        }
      ],
      "authoringHints": {
        "styles": "Every style falls back to the app theme, so set only what the design needs to blend in (its accent, surfaces, borders and text colours), taking colours from the app theme or brand, never the defaults of another product. Radii and sizes are px. Styles are the way to restyle a pack widget: a cssClass only takes effect with workspace Custom styles, and Tailwind class names the pack does not already use are not compiled, so do not rely on either; for a one-off visual a style cannot express, use an Html component. Bind loadingState to the query's isLoading (each widget draws a skeleton or spinner in its own shape); tooltip shows on hover.",
        "usage": "Read-only chips from an array or comma text; tagColors { Paid: '#16a34a' } tints them. 24px per line."
      }
    }
  ],
  "unknown_types": []
}
