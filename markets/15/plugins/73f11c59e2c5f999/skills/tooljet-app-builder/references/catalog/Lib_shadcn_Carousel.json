{
  "components": [
    {
      "type": "Lib_shadcn_Carousel",
      "name": "Lib_shadcn_Carousel",
      "description": "Carousel from the shadcn UI component library. Drawn at the height you give it.",
      "defaultSize": {
        "width": 20,
        "height": 410
      },
      "properties": [
        {
          "key": "slides",
          "label": "Slides",
          "valueType": "array",
          "default": "{{[{\"image\":\"https://images.unsplash.com/photo-1500530855697-b586d89ba3ee?w=1200\",\"title\":\"Coastal routes\",\"description\":\"Faster delivery across 12 ports\"},{\"image\":\"https://images.unsplash.com/photo-1469474968028-56623f02e42e?w=1200\",\"title\":\"Mountain depots\",\"description\":\"New warehouses opening in Q1\"},{\"image\":\"https://images.unsplash.com/photo-1506744038136-46273834b3fb?w=1200\",\"title\":\"Lakeside hubs\",\"description\":\"Cold-chain capacity doubled\"}]}}",
          "description": "Array of { image, title, description }."
        },
        {
          "key": "currentIndex",
          "label": "Start slide (0-based)",
          "valueType": "number",
          "default": "{{0}}"
        },
        {
          "key": "imageFit",
          "label": "Image fit",
          "valueType": "string",
          "default": "cover",
          "allowedValues": [
            "cover",
            "contain"
          ]
        },
        {
          "key": "captionPosition",
          "label": "Caption",
          "valueType": "string",
          "default": "overlay",
          "allowedValues": [
            "overlay",
            "below",
            "none"
          ]
        },
        {
          "key": "showArrows",
          "label": "Arrows",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "showDots",
          "label": "Dots",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "loop",
          "label": "Loop",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "autoplay",
          "label": "Autoplay",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "interval",
          "label": "Autoplay interval (ms)",
          "valueType": "number",
          "default": "{{5000}}"
        },
        {
          "key": "pauseOnHover",
          "label": "Pause on hover",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "currentSlide",
          "label": "Current Slide",
          "valueType": "object",
          "default": "{{{}}}"
        },
        {
          "key": "clickedSlide",
          "label": "Clicked Slide",
          "valueType": "object",
          "default": "{{{}}}"
        },
        {
          "key": "visibility",
          "label": "Visibility",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "loadingState",
          "label": "Loading state",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "disabledState",
          "label": "Disable",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "dynamicHeight",
          "label": "Dynamic height",
          "valueType": "boolean",
          "default": "{{false}}"
        }
      ],
      "styles": [
        {
          "key": "activeDotColor",
          "label": "Active dot",
          "valueType": "string"
        },
        {
          "key": "borderRadius",
          "label": "Border radius",
          "valueType": "number"
        },
        {
          "key": "boxShadow",
          "label": "Box shadow",
          "valueType": "string"
        }
      ],
      "events": [
        {
          "id": "onSlideChanged",
          "label": "On slide changed"
        },
        {
          "id": "onSlideClicked",
          "label": "On slide clicked"
        }
      ],
      "actions": [
        {
          "handle": "next",
          "displayName": "Next slide"
        },
        {
          "handle": "previous",
          "displayName": "Previous slide"
        },
        {
          "handle": "goTo",
          "displayName": "Go to slide",
          "params": [
            {
              "handle": "index",
              "displayName": "Index (0-based)"
            }
          ]
        },
        {
          "handle": "setVisibility",
          "displayName": "Set visibility",
          "params": [
            {
              "handle": "visibility",
              "displayName": "Value",
              "defaultValue": "{{false}}"
            }
          ]
        },
        {
          "handle": "setLoading",
          "displayName": "Set loading",
          "params": [
            {
              "handle": "loading",
              "displayName": "Value",
              "defaultValue": "{{false}}"
            }
          ]
        },
        {
          "handle": "setDisable",
          "displayName": "Set disable",
          "params": [
            {
              "handle": "disable",
              "displayName": "Value",
              "defaultValue": "{{false}}"
            }
          ]
        }
      ],
      "exposedVariables": [
        {
          "name": "slides",
          "default": [
            {
              "image": "https://images.unsplash.com/photo-1500530855697-b586d89ba3ee?w=1200",
              "title": "Coastal routes",
              "description": "Faster delivery across 12 ports"
            },
            {
              "image": "https://images.unsplash.com/photo-1469474968028-56623f02e42e?w=1200",
              "title": "Mountain depots",
              "description": "New warehouses opening in Q1"
            },
            {
              "image": "https://images.unsplash.com/photo-1506744038136-46273834b3fb?w=1200",
              "title": "Lakeside hubs",
              "description": "Cold-chain capacity doubled"
            }
          ]
        },
        {
          "name": "currentIndex",
          "default": 0
        },
        {
          "name": "imageFit",
          "default": "cover"
        },
        {
          "name": "captionPosition",
          "default": "overlay"
        },
        {
          "name": "showArrows",
          "default": true
        },
        {
          "name": "showDots",
          "default": true
        },
        {
          "name": "loop",
          "default": true
        },
        {
          "name": "autoplay",
          "default": false
        },
        {
          "name": "interval",
          "default": 5000
        },
        {
          "name": "pauseOnHover",
          "default": true
        },
        {
          "name": "currentSlide",
          "default": {}
        },
        {
          "name": "clickedSlide",
          "default": {}
        },
        {
          "name": "isVisible",
          "default": true
        },
        {
          "name": "isLoading",
          "default": false
        },
        {
          "name": "isDisabled",
          "default": false
        }
      ]
    }
  ],
  "unknown_types": []
}
