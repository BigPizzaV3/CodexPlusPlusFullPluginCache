{
  "components": [
    {
      "type": "Lib_shadcn_FileUpload",
      "name": "Lib_shadcn_FileUpload",
      "description": "File Upload from the shadcn UI component library. Sizes to its content in the app (Dynamic height on).",
      "defaultSize": {
        "width": 12,
        "height": 220
      },
      "properties": [
        {
          "key": "label",
          "label": "Label",
          "valueType": "string",
          "default": ""
        },
        {
          "key": "description",
          "label": "Help text",
          "valueType": "string",
          "default": ""
        },
        {
          "key": "title",
          "label": "Title",
          "valueType": "string",
          "default": "Drag & drop files here"
        },
        {
          "key": "hint",
          "label": "Hint",
          "valueType": "string",
          "default": "or click to browse"
        },
        {
          "key": "accept",
          "label": "Accepted types",
          "valueType": "string",
          "default": "",
          "description": "e.g. .csv,image/*"
        },
        {
          "key": "multiple",
          "label": "Multiple files",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "maxFiles",
          "label": "Max files",
          "valueType": "number",
          "default": "{{5}}"
        },
        {
          "key": "maxSize",
          "label": "Max size (bytes)",
          "valueType": "number",
          "default": "{{5242880}}"
        },
        {
          "key": "parseContent",
          "label": "Parse content",
          "valueType": "boolean",
          "default": "{{false}}",
          "description": "Read CSV or JSON into `content`."
        },
        {
          "key": "parseFileType",
          "label": "Parse as",
          "valueType": "string",
          "default": "auto-detect",
          "allowedValues": [
            "auto-detect",
            "csv",
            "json"
          ]
        },
        {
          "key": "delimiter",
          "label": "CSV delimiter",
          "valueType": "string",
          "default": ","
        },
        {
          "key": "required",
          "label": "Required",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "disabled",
          "label": "Disable",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "file",
          "label": "File",
          "valueType": "array",
          "default": "{{[]}}"
        },
        {
          "key": "isParsing",
          "label": "Is Parsing",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "isValid",
          "label": "Is Valid",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "visibility",
          "label": "Visibility",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "loadingState",
          "label": "Loading state",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "disabledState",
          "label": "Disable",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "dynamicHeight",
          "label": "Dynamic height",
          "valueType": "boolean",
          "default": "{{true}}"
        }
      ],
      "styles": [
        {
          "key": "dropzoneBackgroundColor",
          "label": "Dropzone background",
          "valueType": "string"
        },
        {
          "key": "dropzoneBorderColor",
          "label": "Dropzone border",
          "valueType": "string"
        },
        {
          "key": "accentColor",
          "label": "Accent",
          "valueType": "string"
        },
        {
          "key": "borderRadius",
          "label": "Border radius",
          "valueType": "number"
        },
        {
          "key": "boxShadow",
          "label": "Box shadow",
          "valueType": "string"
        }
      ],
      "events": [
        {
          "id": "onFileSelected",
          "label": "On file selected"
        },
        {
          "id": "onFileDeselected",
          "label": "On file deselected"
        },
        {
          "id": "onFileLoaded",
          "label": "On file loaded"
        }
      ],
      "actions": [
        {
          "handle": "clearFiles",
          "displayName": "Clear files"
        },
        {
          "handle": "setVisibility",
          "displayName": "Set visibility",
          "params": [
            {
              "handle": "visibility",
              "displayName": "Value",
              "defaultValue": "{{false}}"
            }
          ]
        },
        {
          "handle": "setLoading",
          "displayName": "Set loading",
          "params": [
            {
              "handle": "loading",
              "displayName": "Value",
              "defaultValue": "{{false}}"
            }
          ]
        },
        {
          "handle": "setDisable",
          "displayName": "Set disable",
          "params": [
            {
              "handle": "disable",
              "displayName": "Value",
              "defaultValue": "{{false}}"
            }
          ]
        }
      ],
      "exposedVariables": [
        {
          "name": "label",
          "default": ""
        },
        {
          "name": "description",
          "default": ""
        },
        {
          "name": "title",
          "default": "Drag & drop files here"
        },
        {
          "name": "hint",
          "default": "or click to browse"
        },
        {
          "name": "accept",
          "default": ""
        },
        {
          "name": "multiple",
          "default": true
        },
        {
          "name": "maxFiles",
          "default": 5
        },
        {
          "name": "maxSize",
          "default": 5242880
        },
        {
          "name": "parseContent",
          "default": false
        },
        {
          "name": "parseFileType",
          "default": "auto-detect"
        },
        {
          "name": "delimiter",
          "default": ","
        },
        {
          "name": "required",
          "default": false
        },
        {
          "name": "disabled",
          "default": false
        },
        {
          "name": "file",
          "default": []
        },
        {
          "name": "isParsing",
          "default": false
        },
        {
          "name": "isValid",
          "default": true
        },
        {
          "name": "isVisible",
          "default": true
        },
        {
          "name": "isLoading",
          "default": false
        },
        {
          "name": "isDisabled",
          "default": false
        }
      ]
    }
  ],
  "unknown_types": []
}
