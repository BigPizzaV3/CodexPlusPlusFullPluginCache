{
  "components": [
    {
      "type": "ShadStat",
      "name": "ShadStat",
      "description": "Dashboard figure, from a single number to a full KPI card: label, value (a number groups its digits; valueFormat currency in currency, percent or compact formats it), change badge (change, trend) with a context line (changeLabel, e.g. 'vs last month'), footnote; optional icon (any lucide name, iconPosition right, left or top, iconStyle square, circle or none), trendData for a small trend line under the figure (numbers or [{ x, y }]), progress (0 to 100) with progressLabel for a target bar, and size sm, default or lg. Each part shows only when set. Styles valueFontFamily ('serif', 'display', 'mono', ...), labelTextTransform ('uppercase') and labelLetterSpacing ('0.1em') set the figure's typeface and a small-caps label",
      "defaultSize": {
        "width": 10,
        "height": 120
      },
      "properties": [
        {
          "key": "label",
          "label": "Label",
          "valueType": "string",
          "default": "Total revenue"
        },
        {
          "key": "value",
          "label": "Value",
          "valueType": "union",
          "valueTypes": [
            "number",
            "string"
          ],
          "default": "{{1250}}"
        },
        {
          "key": "valueFormat",
          "label": "Value format",
          "valueType": "string",
          "default": "auto",
          "allowedValues": [
            "auto",
            "number",
            "currency",
            "percent",
            "compact"
          ]
        },
        {
          "key": "currency",
          "label": "Currency (ISO code, e.g. USD)",
          "valueType": "string",
          "default": "USD"
        },
        {
          "key": "change",
          "label": "Change (e.g. +12.5%)",
          "valueType": "string",
          "default": ""
        },
        {
          "key": "changeFormat",
          "label": "Change format",
          "valueType": "string",
          "default": "number",
          "allowedValues": [
            "percent",
            "number",
            "currency"
          ]
        },
        {
          "key": "trend",
          "label": "Trend",
          "valueType": "string",
          "default": "up",
          "allowedValues": [
            "up",
            "down",
            "neutral"
          ]
        },
        {
          "key": "changeLabel",
          "label": "Change context (e.g. vs last month)",
          "valueType": "string",
          "default": ""
        },
        {
          "key": "footnote",
          "label": "Footnote",
          "valueType": "string",
          "default": ""
        },
        {
          "key": "icon",
          "label": "Icon (lucide name, e.g. wallet)",
          "valueType": "string",
          "default": ""
        },
        {
          "key": "iconPosition",
          "label": "Icon position",
          "valueType": "string",
          "default": "right",
          "allowedValues": [
            "right",
            "left",
            "top"
          ]
        },
        {
          "key": "iconStyle",
          "label": "Icon style",
          "valueType": "string",
          "default": "square",
          "allowedValues": [
            "square",
            "circle",
            "none"
          ]
        },
        {
          "key": "trendData",
          "label": "Trend data (numbers or [{ x, y }])",
          "valueType": "union",
          "valueTypes": [
            "array",
            "string"
          ],
          "default": ""
        },
        {
          "key": "sparklineType",
          "label": "Trend line",
          "valueType": "string",
          "default": "area",
          "allowedValues": [
            "area",
            "line"
          ]
        },
        {
          "key": "progress",
          "label": "Progress (0 to 100)",
          "valueType": "union",
          "valueTypes": [
            "number",
            "string"
          ],
          "default": ""
        },
        {
          "key": "progressLabel",
          "label": "Progress label",
          "valueType": "string",
          "default": ""
        },
        {
          "key": "size",
          "label": "Size",
          "valueType": "string",
          "default": "default",
          "allowedValues": [
            "sm",
            "default",
            "lg"
          ]
        },
        {
          "key": "card",
          "label": "Show as card",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "dynamicHeight",
          "label": "Dynamic height",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "loadingState",
          "label": "Loading state",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "loadingIndicator",
          "label": "Loading look",
          "valueType": "string",
          "default": "spinner",
          "allowedValues": [
            "spinner",
            "skeleton"
          ]
        },
        {
          "key": "visibility",
          "label": "Visibility",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "collapseWhenHidden",
          "label": "Collapse when hidden",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "disabledState",
          "label": "Disable",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "tooltipFormat",
          "label": "Tooltip",
          "default": "plainText",
          "allowedValues": [
            "plainText",
            "markdown",
            "html"
          ]
        },
        {
          "key": "tooltip",
          "label": "Tooltip",
          "valueType": "string",
          "default": ""
        }
      ],
      "styles": [
        {
          "key": "boxShadow",
          "label": "Box shadow",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ],
          "default": "0px 0px 0px 0px #00000040"
        },
        {
          "key": "backgroundColor",
          "label": "Card background",
          "valueType": "string"
        },
        {
          "key": "borderColor",
          "label": "Card border color",
          "valueType": "string"
        },
        {
          "key": "borderRadius",
          "label": "Card radius",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ]
        },
        {
          "key": "labelColor",
          "label": "Label color",
          "valueType": "string"
        },
        {
          "key": "valueColor",
          "label": "Value color",
          "valueType": "string"
        },
        {
          "key": "footnoteColor",
          "label": "Footnote color",
          "valueType": "string"
        },
        {
          "key": "positiveColor",
          "label": "Change color when trend is up",
          "valueType": "string"
        },
        {
          "key": "negativeColor",
          "label": "Change color when trend is down",
          "valueType": "string"
        },
        {
          "key": "iconColor",
          "label": "Icon color",
          "valueType": "string"
        },
        {
          "key": "chipColor",
          "label": "Icon tile color",
          "valueType": "string"
        },
        {
          "key": "sparklineColor",
          "label": "Trend line color",
          "valueType": "string"
        },
        {
          "key": "progressColor",
          "label": "Progress color",
          "valueType": "string"
        },
        {
          "key": "valueFontFamily",
          "label": "Value typeface",
          "valueType": "string",
          "default": "theme",
          "allowedValues": [
            "theme",
            "sans",
            "serif",
            "display",
            "mono"
          ]
        },
        {
          "key": "labelTextTransform",
          "label": "Label casing",
          "valueType": "string",
          "default": "none",
          "allowedValues": [
            "none",
            "uppercase",
            "lowercase",
            "capitalize"
          ]
        },
        {
          "key": "labelLetterSpacing",
          "label": "Label letter spacing (px, or em like 0.12em)",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ]
        },
        {
          "key": "cssClass",
          "label": "CSS class",
          "default": ""
        }
      ],
      "events": [],
      "actions": [
        {
          "handle": "setPrimaryValue",
          "displayName": "Set primary value",
          "params": [
            {
              "handle": "text",
              "displayName": "Value",
              "defaultValue": ""
            }
          ]
        },
        {
          "handle": "setSecondaryValue",
          "displayName": "Set secondary value",
          "params": [
            {
              "handle": "text",
              "displayName": "Change",
              "defaultValue": ""
            }
          ]
        },
        {
          "handle": "setTrend",
          "displayName": "Set trend",
          "params": [
            {
              "handle": "trend",
              "displayName": "Trend (up, down or neutral)",
              "defaultValue": "up"
            }
          ]
        },
        {
          "handle": "setVisibility",
          "displayName": "Set visibility",
          "params": [
            {
              "handle": "value",
              "displayName": "Value",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setDisable",
          "displayName": "Set disable",
          "params": [
            {
              "handle": "value",
              "displayName": "Value",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setLoading",
          "displayName": "Set loading",
          "params": [
            {
              "handle": "value",
              "displayName": "Value",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        }
      ],
      "exposedVariables": [
        {
          "name": "isVisible",
          "default": true
        },
        {
          "name": "isLoading",
          "default": false
        },
        {
          "name": "isDisabled",
          "default": false
        },
        {
          "name": "primaryLabel",
          "default": "Total revenue"
        },
        {
          "name": "primaryValue",
          "default": 1250
        },
        {
          "name": "secondaryLabel",
          "default": ""
        },
        {
          "name": "secondaryValue",
          "default": ""
        }
      ],
      "authoringHints": {
        "styles": "Every style falls back to the app theme, so set only what the design needs to blend in (its accent, surfaces, borders and text colours), taking colours from the app theme or brand, never the defaults of another product. Radii and sizes are px. Styles are the way to restyle a pack widget: a cssClass only takes effect with workspace Custom styles, and Tailwind class names the pack does not already use are not compiled, so do not rely on either; for a one-off visual a style cannot express, use an Html component. Bind loadingState to the query's isLoading (each widget draws a skeleton or spinner in its own shape); tooltip shows on hover. positiveColor and negativeColor colour the change badge (text on a light tint) for trend \"up\" and \"down\"; unset keeps a neutral outline badge."
      }
    }
  ],
  "unknown_types": []
}
