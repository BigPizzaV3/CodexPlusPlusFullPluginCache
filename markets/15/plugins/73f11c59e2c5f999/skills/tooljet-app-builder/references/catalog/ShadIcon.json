{
  "components": [
    {
      "type": "ShadIcon",
      "name": "ShadIcon",
      "description": "Icon: icon is any lucide name ('trending-up' or 'TrendingUp'; unknown names show a neutral dashed circle), size (px), strokeWidth, tone (default, muted, primary, success, warning, destructive) or the iconColor style, chip ('none', 'circle', 'square') for the tinted icon chip of KPI cards (chipColor style, else a tint of the icon colour; chipSize, else size x 2); onClick. Height: 40px with a chip at size 20, else the icon size",
      "defaultSize": {
        "width": 3,
        "height": 40
      },
      "properties": [
        {
          "key": "icon",
          "label": "Icon name (lucide)",
          "valueType": "string",
          "default": "trending-up"
        },
        {
          "key": "size",
          "label": "Icon size (px)",
          "valueType": "number",
          "default": "{{20}}"
        },
        {
          "key": "strokeWidth",
          "label": "Stroke width",
          "valueType": "number",
          "default": "{{2}}"
        },
        {
          "key": "tone",
          "label": "Tone (unless Icon color is set)",
          "valueType": "string",
          "default": "primary",
          "allowedValues": [
            "default",
            "muted",
            "primary",
            "success",
            "warning",
            "destructive"
          ]
        },
        {
          "key": "chip",
          "label": "Background chip",
          "valueType": "string",
          "default": "square",
          "allowedValues": [
            "none",
            "circle",
            "square"
          ]
        },
        {
          "key": "chipSize",
          "label": "Chip size (px, empty: icon x 2)",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ],
          "default": ""
        },
        {
          "key": "loadingState",
          "label": "Loading state",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "loadingIndicator",
          "label": "Loading look",
          "valueType": "string",
          "default": "spinner",
          "allowedValues": [
            "spinner",
            "skeleton"
          ]
        },
        {
          "key": "visibility",
          "label": "Visibility",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "collapseWhenHidden",
          "label": "Collapse when hidden",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "disabledState",
          "label": "Disable",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "tooltipFormat",
          "label": "Tooltip",
          "default": "plainText",
          "allowedValues": [
            "plainText",
            "markdown",
            "html"
          ]
        },
        {
          "key": "tooltip",
          "label": "Tooltip",
          "valueType": "string",
          "default": ""
        }
      ],
      "styles": [
        {
          "key": "boxShadow",
          "label": "Box shadow",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ],
          "default": "0px 0px 0px 0px #00000040"
        },
        {
          "key": "iconColor",
          "label": "Icon color",
          "valueType": "string"
        },
        {
          "key": "chipColor",
          "label": "Chip background (default: icon color tint)",
          "valueType": "string"
        },
        {
          "key": "chipRadius",
          "label": "Chip radius (square chip)",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ]
        },
        {
          "key": "alignment",
          "label": "Alignment",
          "valueType": "string",
          "default": "left"
        },
        {
          "key": "cssClass",
          "label": "CSS class",
          "default": ""
        }
      ],
      "events": [
        {
          "id": "onClick",
          "label": "On click"
        },
        {
          "id": "onHover",
          "label": "On hover"
        }
      ],
      "actions": [
        {
          "handle": "click",
          "displayName": "Click"
        },
        {
          "handle": "setVisibility",
          "displayName": "Set visibility",
          "params": [
            {
              "handle": "value",
              "displayName": "Value",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setDisable",
          "displayName": "Set disable",
          "params": [
            {
              "handle": "value",
              "displayName": "Value",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setLoading",
          "displayName": "Set loading",
          "params": [
            {
              "handle": "value",
              "displayName": "Value",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        }
      ],
      "exposedVariables": [
        {
          "name": "isVisible",
          "default": true
        },
        {
          "name": "isLoading",
          "default": false
        },
        {
          "name": "isDisabled",
          "default": false
        }
      ],
      "authoringHints": {
        "styles": "Every style falls back to the app theme, so set only what the design needs to blend in (its accent, surfaces, borders and text colours), taking colours from the app theme or brand, never the defaults of another product. Radii and sizes are px. Styles are the way to restyle a pack widget: a cssClass only takes effect with workspace Custom styles, and Tailwind class names the pack does not already use are not compiled, so do not rely on either; for a one-off visual a style cannot express, use an Html component. Bind loadingState to the query's isLoading (each widget draws a skeleton or spinner in its own shape); tooltip shows on hover.",
        "usage": "Any lucide icon name (kebab or Pascal case). { icon: 'users', tone: 'primary', chip: 'square' } is the tinted icon chip of a KPI card; 40px tall."
      }
    }
  ],
  "unknown_types": []
}
