{
  "components": [
    {
      "type": "ShadTagsInput",
      "name": "ShadTagsInput",
      "description": "Tags input: free-form tags typed in the field (Enter or comma adds, Backspace removes the last, x removes one), with optional suggestions, maxTags, duplicate check and a per-tag pattern. Exposes values (array of text). Height: 64px with a label, 36px without (one row; grows with dynamic height)",
      "defaultSize": {
        "width": 10,
        "height": 70
      },
      "properties": [
        {
          "key": "label",
          "label": "Label",
          "valueType": "string",
          "default": "Tags"
        },
        {
          "key": "description",
          "label": "Help text",
          "valueType": "string",
          "default": ""
        },
        {
          "key": "placeholder",
          "label": "Placeholder",
          "valueType": "string",
          "default": "Add a tag..."
        },
        {
          "key": "defaultValue",
          "label": "Default tags",
          "valueType": "array",
          "default": "{{[]}}"
        },
        {
          "key": "suggestions",
          "label": "Suggestions",
          "valueType": "array",
          "default": "{{['react', 'typescript', 'node', 'python', 'design', 'devops']}}"
        },
        {
          "key": "allowCustomTags",
          "label": "Allow tags not in suggestions",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "maxTags",
          "label": "Max tags (0 for no limit)",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ],
          "default": "{{0}}"
        },
        {
          "key": "caseSensitive",
          "label": "Case-sensitive duplicate check",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "tagPattern",
          "label": "Tag pattern (regex)",
          "valueType": "string",
          "default": ""
        },
        {
          "key": "patternError",
          "label": "Pattern error message",
          "valueType": "string",
          "default": ""
        },
        {
          "key": "addOnBlur",
          "label": "Add typed text on blur",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "showClearBtn",
          "label": "Show clear button",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "dynamicHeight",
          "label": "Dynamic height",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "loadingState",
          "label": "Loading state",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "visibility",
          "label": "Visibility",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "collapseWhenHidden",
          "label": "Collapse when hidden",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "disabledState",
          "label": "Disable",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "tooltipFormat",
          "label": "Tooltip",
          "default": "plainText",
          "allowedValues": [
            "plainText",
            "markdown",
            "html"
          ]
        },
        {
          "key": "tooltip",
          "label": "Tooltip",
          "valueType": "string",
          "default": ""
        }
      ],
      "styles": [
        {
          "key": "boxShadow",
          "label": "Box shadow",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ],
          "default": "0px 0px 0px 0px #00000040"
        },
        {
          "key": "labelColor",
          "label": "Label color",
          "valueType": "string"
        },
        {
          "key": "helpTextColor",
          "label": "Help text color",
          "valueType": "string"
        },
        {
          "key": "backgroundColor",
          "label": "Field background",
          "valueType": "string"
        },
        {
          "key": "textColor",
          "label": "Field text color",
          "valueType": "string"
        },
        {
          "key": "placeholderColor",
          "label": "Placeholder color",
          "valueType": "string"
        },
        {
          "key": "borderColor",
          "label": "Field border color",
          "valueType": "string"
        },
        {
          "key": "accentColor",
          "label": "Accent (focus ring, checks)",
          "valueType": "string"
        },
        {
          "key": "errorColor",
          "label": "Error color (message and border)",
          "valueType": "string"
        },
        {
          "key": "borderRadius",
          "label": "Field radius",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ]
        },
        {
          "key": "chipBackgroundColor",
          "label": "Chip background",
          "valueType": "string"
        },
        {
          "key": "chipTextColor",
          "label": "Chip text color",
          "valueType": "string"
        },
        {
          "key": "menuBackgroundColor",
          "label": "Menu background",
          "valueType": "string"
        },
        {
          "key": "menuTextColor",
          "label": "Menu text color",
          "valueType": "string"
        },
        {
          "key": "optionHoverColor",
          "label": "Highlighted option background",
          "valueType": "string"
        },
        {
          "key": "cssClass",
          "label": "CSS class",
          "default": ""
        }
      ],
      "events": [
        {
          "id": "onChange",
          "label": "On change"
        },
        {
          "id": "onTagAdded",
          "label": "On tag added"
        },
        {
          "id": "onTagDeleted",
          "label": "On tag deleted"
        },
        {
          "id": "onFocus",
          "label": "On focus"
        },
        {
          "id": "onBlur",
          "label": "On blur"
        }
      ],
      "actions": [
        {
          "handle": "setTags",
          "displayName": "Set tags",
          "params": [
            {
              "handle": "tags",
              "displayName": "Tags",
              "defaultValue": "{{[]}}"
            }
          ]
        },
        {
          "handle": "selectTags",
          "displayName": "Select tags (add)",
          "params": [
            {
              "handle": "tags",
              "displayName": "Tags",
              "defaultValue": "{{[]}}"
            }
          ]
        },
        {
          "handle": "deselectTags",
          "displayName": "Deselect tags (remove)",
          "params": [
            {
              "handle": "tags",
              "displayName": "Tags",
              "defaultValue": "{{[]}}"
            }
          ]
        },
        {
          "handle": "clear",
          "displayName": "Clear"
        },
        {
          "handle": "setFocus",
          "displayName": "Set focus"
        },
        {
          "handle": "setBlur",
          "displayName": "Set blur"
        },
        {
          "handle": "setVisibility",
          "displayName": "Set visibility",
          "params": [
            {
              "handle": "value",
              "displayName": "Value",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setDisable",
          "displayName": "Set disable",
          "params": [
            {
              "handle": "value",
              "displayName": "Value",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setLoading",
          "displayName": "Set loading",
          "params": [
            {
              "handle": "value",
              "displayName": "Value",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        }
      ],
      "exposedVariables": [
        {
          "name": "isVisible",
          "default": true
        },
        {
          "name": "isLoading",
          "default": false
        },
        {
          "name": "isDisabled",
          "default": false
        },
        {
          "name": "isValid",
          "default": true
        },
        {
          "name": "isMandatory",
          "default": false
        },
        {
          "name": "values",
          "default": []
        },
        {
          "name": "newTagsAdded",
          "default": []
        },
        {
          "name": "lastAddedTag",
          "default": ""
        },
        {
          "name": "lastRemovedTag",
          "default": ""
        },
        {
          "name": "label",
          "default": ""
        }
      ],
      "authoringHints": {
        "styles": "Every style falls back to the app theme, so set only what the design needs to blend in (its accent, surfaces, borders and text colours), taking colours from the app theme or brand, never the defaults of another product. Radii and sizes are px. Styles are the way to restyle a pack widget: a cssClass only takes effect with workspace Custom styles, and Tailwind class names the pack does not already use are not compiled, so do not rely on either; for a one-off visual a style cannot express, use an Html component. Bind loadingState to the query's isLoading (each widget draws a skeleton or spinner in its own shape); tooltip shows on hover.",
        "usage": "defaultValue is an array of text; exposes values (the array). Height 64 with a label; it grows as tags wrap."
      }
    }
  ],
  "unknown_types": []
}
