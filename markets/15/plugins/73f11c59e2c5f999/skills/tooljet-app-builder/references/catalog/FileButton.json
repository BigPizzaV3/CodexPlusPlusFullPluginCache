{
  "components": [
    {
      "type": "FileButton",
      "name": "FileButton",
      "description": "A button that triggers file selection. Label updates to show selected file count after selection.",
      "defaultSize": {
        "width": 10,
        "height": 40
      },
      "properties": [
        {
          "key": "buttonText",
          "label": "Button text",
          "valueType": "string",
          "default": "Upload file"
        },
        {
          "key": "enableMultiple",
          "label": "Enable multiple files",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "parseContent",
          "label": "Parse file content",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "parseFileType",
          "label": "File type",
          "valueType": "string",
          "default": "auto-detect",
          "allowedValues": [
            "auto-detect",
            "csv",
            "xls",
            "xlsx",
            "json"
          ]
        },
        {
          "key": "delimiter",
          "label": "Delimiter",
          "valueType": "string",
          "default": ","
        },
        {
          "key": "enableClearSelection",
          "label": "Enable clear selection",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "loadingState",
          "label": "Loading state",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "visibility",
          "label": "Visibility",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "disabledState",
          "label": "Disable",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "tooltipFormat",
          "label": "Tooltip",
          "default": "plainText",
          "allowedValues": [
            "plainText",
            "markdown",
            "html"
          ]
        },
        {
          "key": "tooltip",
          "label": "Tooltip",
          "valueType": "string",
          "default": ""
        }
      ],
      "styles": [
        {
          "key": "labelSize",
          "label": "Label size",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ],
          "default": "14"
        },
        {
          "key": "labelWeight",
          "label": "Label weight",
          "valueType": "string",
          "default": "medium",
          "allowedValues": [
            "normal",
            "medium",
            "bold"
          ]
        },
        {
          "key": "labelColor",
          "label": "Label color",
          "valueType": "string",
          "default": "var(--cc-surface1-surface)"
        },
        {
          "key": "icon",
          "label": "Icon",
          "valueType": "string",
          "default": "IconFileSearch"
        },
        {
          "key": "iconColor",
          "label": "Icon color",
          "valueType": "string",
          "default": "var(--cc-surface1-surface)"
        },
        {
          "key": "loaderColor",
          "label": "Loader color",
          "valueType": "string",
          "default": "var(--cc-surface1-surface)"
        },
        {
          "key": "contentAlignment",
          "label": "Content alignment",
          "default": "center",
          "allowedValues": [
            "left",
            "center",
            "right"
          ]
        },
        {
          "key": "buttonType",
          "label": "Button type",
          "valueType": "string",
          "default": "solid",
          "allowedValues": [
            "solid",
            "outline"
          ]
        },
        {
          "key": "backgroundColor",
          "label": "Background",
          "valueType": "string",
          "default": "var(--cc-primary-brand)"
        },
        {
          "key": "borderRadius",
          "label": "Border radius",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ],
          "default": "6"
        },
        {
          "key": "boxShadow",
          "label": "Box shadow",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ],
          "default": "0px 0px 0px 0px #00000040"
        },
        {
          "key": "padding",
          "label": "Padding",
          "valueType": "string",
          "default": "default",
          "allowedValues": [
            "default",
            "none"
          ]
        },
        {
          "key": "iconVisibility",
          "default": true
        },
        {
          "key": "iconDirection",
          "default": "left"
        },
        {
          "key": "cssClass",
          "label": "CSS class",
          "default": ""
        }
      ],
      "events": [
        {
          "id": "onFileSelected",
          "label": "On file selected"
        },
        {
          "id": "onFileLoaded",
          "label": "On file loaded"
        }
      ],
      "actions": [
        {
          "handle": "clear",
          "displayName": "Clear"
        },
        {
          "handle": "setFocus",
          "displayName": "Set focus"
        },
        {
          "handle": "setBlur",
          "displayName": "Set blur"
        },
        {
          "handle": "setVisibility",
          "displayName": "Set visibility",
          "params": [
            {
              "handle": "value",
              "displayName": "Value",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setDisable",
          "displayName": "Set disable",
          "params": [
            {
              "handle": "value",
              "displayName": "Value",
              "defaultValue": "{{false}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setLoading",
          "displayName": "Set loading",
          "params": [
            {
              "handle": "value",
              "displayName": "Value",
              "defaultValue": "{{false}}",
              "type": "toggle"
            }
          ]
        }
      ],
      "exposedVariables": [
        {
          "name": "files",
          "default": []
        },
        {
          "name": "isParsing",
          "default": false
        },
        {
          "name": "isValid",
          "default": false
        },
        {
          "name": "isMandatory",
          "default": false
        },
        {
          "name": "isLoading",
          "default": false
        },
        {
          "name": "isVisible",
          "default": true
        },
        {
          "name": "isDisabled",
          "default": false
        }
      ]
    }
  ],
  "unknown_types": []
}
