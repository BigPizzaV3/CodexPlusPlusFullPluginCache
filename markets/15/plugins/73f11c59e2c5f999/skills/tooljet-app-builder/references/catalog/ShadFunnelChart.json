{
  "components": [
    {
      "type": "ShadFunnelChart",
      "name": "ShadFunnelChart",
      "description": "Funnel of stages in order: data [{ stage: 'Visited', count: 12480 }, { stage: 'Paid', count: 412 }], stageField 'stage', valueField 'count'; one bar per stage sized to the widest, its value, and its conversion % from the stage before (conversionBase 'previous') or from the first ('first'); align center/left, colorByStage (palette per stage, else one colour fading down), yAxisFormat for values. About 44 px per stage; clicking a stage sets clickedDataPoint to its row and fires onClick.",
      "defaultSize": {
        "width": 16,
        "height": 240
      },
      "properties": [
        {
          "key": "data",
          "label": "Data",
          "valueType": "array",
          "default": "{{[{ stage: 'Visited', count: 12480 }, { stage: 'Signed up', count: 3920 }, { stage: 'Activated', count: 2210 }, { stage: 'Trial', count: 1180 }, { stage: 'P…"
        },
        {
          "key": "stageField",
          "label": "Stage field",
          "valueType": "string",
          "default": "stage"
        },
        {
          "key": "valueField",
          "label": "Value field",
          "valueType": "string",
          "default": "count"
        },
        {
          "key": "showConversion",
          "label": "Conversion %",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "conversionBase",
          "label": "Conversion from",
          "valueType": "string",
          "default": "previous",
          "allowedValues": [
            "previous",
            "first"
          ]
        },
        {
          "key": "align",
          "label": "Bar alignment",
          "valueType": "string",
          "default": "center",
          "allowedValues": [
            "center",
            "left"
          ]
        },
        {
          "key": "colorByStage",
          "label": "Colour per stage",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "yAxisFormat",
          "label": "Value format",
          "valueType": "string",
          "default": "number",
          "allowedValues": [
            "number",
            "currency",
            "percent",
            "compact"
          ]
        },
        {
          "key": "currency",
          "label": "Currency code",
          "valueType": "string",
          "default": "USD"
        },
        {
          "key": "valuePrefix",
          "label": "Value prefix",
          "valueType": "string",
          "default": ""
        },
        {
          "key": "valueSuffix",
          "label": "Value suffix",
          "valueType": "string",
          "default": ""
        },
        {
          "key": "emptyText",
          "label": "Empty message",
          "valueType": "string",
          "default": "No data"
        },
        {
          "key": "animate",
          "label": "Animate",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "colors",
          "label": "Series colors (in order)",
          "valueType": "array",
          "default": "{{[]}}"
        },
        {
          "key": "highlightClicked",
          "label": "Highlight clicked point",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "loadingState",
          "label": "Loading state",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "loadingIndicator",
          "label": "Loading look",
          "valueType": "string",
          "default": "spinner",
          "allowedValues": [
            "spinner",
            "skeleton"
          ]
        },
        {
          "key": "visibility",
          "label": "Visibility",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "collapseWhenHidden",
          "label": "Collapse when hidden",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "disabledState",
          "label": "Disable",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "tooltipFormat",
          "label": "Tooltip",
          "default": "plainText",
          "allowedValues": [
            "plainText",
            "markdown",
            "html"
          ]
        },
        {
          "key": "tooltip",
          "label": "Tooltip",
          "valueType": "string",
          "default": ""
        }
      ],
      "styles": [
        {
          "key": "boxShadow",
          "label": "Box shadow",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ],
          "default": "0px 0px 0px 0px #00000040"
        },
        {
          "key": "chartColor",
          "label": "Chart color (series palette from it)",
          "valueType": "string"
        },
        {
          "key": "axisTextColor",
          "label": "Stage label color",
          "valueType": "string"
        },
        {
          "key": "cssClass",
          "label": "CSS class",
          "default": ""
        }
      ],
      "events": [
        {
          "id": "onClick",
          "label": "On click"
        },
        {
          "id": "onDoubleClick",
          "label": "On double click"
        }
      ],
      "actions": [
        {
          "handle": "clearClickedPoint",
          "displayName": "Clear clicked point"
        },
        {
          "handle": "setVisibility",
          "displayName": "Set visibility",
          "params": [
            {
              "handle": "value",
              "displayName": "Value",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setDisable",
          "displayName": "Set disable",
          "params": [
            {
              "handle": "value",
              "displayName": "Value",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setLoading",
          "displayName": "Set loading",
          "params": [
            {
              "handle": "value",
              "displayName": "Value",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        }
      ],
      "exposedVariables": [
        {
          "name": "isVisible",
          "default": true
        },
        {
          "name": "isLoading",
          "default": false
        },
        {
          "name": "isDisabled",
          "default": false
        },
        {
          "name": "clickedDataPoint",
          "default": {}
        }
      ],
      "authoringHints": {
        "styles": "Every style falls back to the app theme, so set only what the design needs to blend in (its accent, surfaces, borders and text colours), taking colours from the app theme or brand, never the defaults of another product. Radii and sizes are px. Styles are the way to restyle a pack widget: a cssClass only takes effect with workspace Custom styles, and Tailwind class names the pack does not already use are not compiled, so do not rely on either; for a one-off visual a style cannot express, use an Html component. Bind loadingState to the query's isLoading (each widget draws a skeleton or spinner in its own shape); tooltip shows on hover.",
        "usage": "Ordered stages [{ stage: 'Visited', count: 12480 }] with stageField and valueField; each stage shows its value and conversion from the one before (conversionBase 'first' for overall). About 44px per stage."
      }
    }
  ],
  "unknown_types": []
}
