{
  "components": [
    {
      "type": "ShadDialog",
      "name": "ShadDialog",
      "description": "Dialog or side sheet (ToolJet Modal in the pack look): header, body and footer canvases (put a ShadHeading and a muted ShadText in the header, the form in the body, ShadButtons in the footer); open and close it with the show-modal / close-modal event actions or its open and close actions; exposed show. Kind \"sheet\" slides in from the side at full height",
      "defaultSize": {
        "width": 10,
        "height": 40
      },
      "properties": [
        {
          "key": "loadingState",
          "label": "Loading state",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "dynamicHeight",
          "label": "Dynamic height",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "visibility",
          "label": "Modal trigger visibility",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "collapseWhenHidden",
          "label": "Collapse when hidden",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "disabledTrigger",
          "label": "Disable modal trigger",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "disabledModal",
          "label": "Disable modal window",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "useDefaultButton",
          "label": "Use default trigger button",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "triggerButtonLabel",
          "label": "Trigger button label",
          "valueType": "string",
          "default": "Open dialog"
        },
        {
          "key": "showHeader",
          "label": "Header",
          "default": "{{true}}"
        },
        {
          "key": "showFooter",
          "label": "Footer",
          "default": "{{true}}"
        },
        {
          "key": "size",
          "label": "Width",
          "valueType": "string",
          "default": "lg",
          "allowedValues": [
            "sm",
            "lg",
            "xl",
            "fullscreen"
          ]
        },
        {
          "key": "modalHeight",
          "label": "Height",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ],
          "default": "{{400}}"
        },
        {
          "key": "hideOnEsc",
          "label": "Close on escape key",
          "default": "{{true}}"
        },
        {
          "key": "closeOnClickingOutside",
          "label": "Close on clicking outside",
          "default": "{{false}}"
        },
        {
          "key": "hideCloseButton",
          "label": "Hide close button",
          "default": "{{false}}"
        },
        {
          "key": "tooltipFormat",
          "label": "Tooltip",
          "default": "plainText",
          "allowedValues": [
            "plainText",
            "markdown",
            "html"
          ]
        },
        {
          "key": "tooltip",
          "label": "Tooltip",
          "valueType": "string",
          "default": ""
