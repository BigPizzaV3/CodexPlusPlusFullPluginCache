        {
          "name": "show",
          "default": false
        },
        {
          "name": "isDisabledModal",
          "default": false
        },
        {
          "name": "isDisabledTrigger",
          "default": false
        },
        {
          "name": "isVisible",
          "default": true
        },
        {
          "name": "isLoading",
          "default": false
        }
      ],
      "defaultChildren": [
        {
          "componentName": "ShadHeading",
          "slotName": "header",
          "layout": {
            "top": 12,
            "left": 1,
            "height": 32
          },
          "displayName": "DialogTitle",
          "properties": [
            "text",
            "level"
          ],
          "defaultValue": {
            "text": "Dialog title",
            "level": "h4"
          }
        },
        {
          "componentName": "ShadText",
          "slotName": "header",
          "layout": {
            "top": 44,
            "left": 1,
            "height": 24
          },
          "displayName": "DialogDescription",
          "properties": [
            "text",
            "tone"
          ],
          "defaultValue": {
            "text": "Describe what this dialog is for.",
            "tone": "muted"
          }
        },
        {
          "componentName": "ShadButton",
          "slotName": "footer",
          "layout": {
            "top": 16,
            "left": 27,
            "width": 7,
            "height": 36
          },
          "displayName": "DialogCancel",
          "properties": [
            "text",
            "variant"
          ],
          "defaultValue": {
            "text": "Cancel",
            "variant": "outline"
          }
        },
        {
          "componentName": "ShadButton",
          "slotName": "footer",
          "layout": {
            "top": 16,
            "left": 35,
            "width": 7,
            "height": 36
          },
          "displayName": "DialogConfirm",
          "properties": [
            "text"
          ],
          "defaultValue": {
            "text": "Save"
          }
        }
      ],
      "renderingHints": {
        "childCoordinateSpace": "Modal-local 43-column grid; child (0,0) is the modal body top-left.",
        "recommendedFieldAlignment": "top",
        "recommendedSingleLineFieldHeightPx": 40,
        "topAlignedRenderedFootprintPx": 60,
        "recommendedFieldRowStepPx": "authored field height + 30px (20px label/validation footprint + 10px gap); this is 70px only for a 40px-authored field",
        "recommendedTextAreaHeightPx": "90–100",
        "recommendedTwoColumnGutterCols": 2
      },
      "authoringHints": {
        "nativeSlots": {
          "mcpField": "slot_name",
          "allowedValues": [
            "header",
            "body",
            "footer"
          ],
          "defaultValue": "body",
          "rule": "Put the modal title Text in header, fields/content in body, and native action buttons in footer. Do not leave showHeader enabled with an empty header and add a duplicate title row to the body.",
          "parentRule": "Set parent_ref for a same-batch modal or parent for an existing modal; coordinates are relative to the selected slot canvas."
        },
        "closeLifecycle": {
          "event": "onClose",
          "rule": "Put transient selected-record/form cleanup on ModalV2 onClose, not only on a Cancel button: native X and enabled Escape/outside-dismiss paths must not leave stale selection. If a Table opens the detail modal, deselect its row on close when needed so clicking that same row again can reopen its details. Keep cleanup idempotent and never write or delete database records as cleanup.",
          "verification": "Test Cancel, native X, each enabled dismissal path and successful-save close, then reopen the same record and a different record. Do not assume a working Cancel proves every close path."
        },
        "styles": "Every style falls back to the app theme, so set only what the design needs to blend in (its accent, surfaces, borders and text colours), taking colours from the app theme or brand, never the defaults of another product. Radii and sizes are px. Styles are the way to restyle a pack widget: a cssClass only takes effect with workspace Custom styles, and Tailwind class names the pack does not already use are not compiled, so do not rely on either; for a one-off visual a style cannot express, use an Html component. Bind loadingState to the query's isLoading (each widget draws a skeleton or spinner in its own shape); tooltip shows on hover.",
        "composition": "Header: a ShadHeading (level \"h4\") with a muted ShadText description under it; body: the content or form; footer: ShadButtons, an outline Cancel then the primary action, right-aligned. Set useDefaultButton false and open it with show-modal from a ShadButton or a table row event. variant \"sheet\" (side \"right\") is a full-height side panel for record details and edit forms; \"dialog\" is centred for confirmations and short forms. Body of a record-details sheet: one FlexContainer column holding, top to bottom, the headline figure or status (a ShadStat or a ShadBadge), one ShadKeyValue for the fields (data an array of { label, value, type } from the selected record, columns 2, layout \"stacked\"), then longer notes in a ShadText; never label and value ShadTexts placed by hand on a grid. Footer: every button inside one FlexContainer row (justifyContent \"flex-end\", gap 8), the outline or ghost action first, the primary last. Read the record as components.<table>?.selectedRow?.<field> ?? '-', or guard on components.<table>?.selectedRow?.id: a selection is {} when nothing is selected, which is truthy."
      }
    }
  ],
  "unknown_types": []
}
