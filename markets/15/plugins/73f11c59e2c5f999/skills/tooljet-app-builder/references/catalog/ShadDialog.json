        {
          "handle": "setLoading",
          "displayName": "Set loading",
          "params": [
            {
              "handle": "setLoading",
              "displayName": "Value",
              "defaultValue": "{{false}}",
              "type": "toggle"
            }
          ]
        }
      ],
