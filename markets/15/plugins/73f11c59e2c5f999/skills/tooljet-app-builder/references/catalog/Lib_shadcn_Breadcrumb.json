{
  "components": [
    {
      "type": "Lib_shadcn_Breadcrumb",
      "name": "Lib_shadcn_Breadcrumb",
      "description": "Breadcrumb from the shadcn UI component library. Drawn at the height you give it.",
      "defaultSize": {
        "width": 14,
        "height": 30
      },
      "properties": [
        {
          "key": "items",
          "label": "Items",
          "valueType": "array",
          "default": "{{[\"Home\",\"Fleet\",\"Seraphine\"]}}",
          "description": "Strings or { label, value } objects; the last is the current page."
        },
        {
          "key": "lastClickedItem",
          "label": "Last Clicked Item",
          "valueType": "object",
          "default": "{{{}}}"
        },
        {
          "key": "visibility",
          "label": "Visibility",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "loadingState",
          "label": "Loading state",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "disabledState",
          "label": "Disable",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "dynamicHeight",
          "label": "Dynamic height",
          "valueType": "boolean",
          "default": "{{false}}"
        }
      ],
      "styles": [
        {
          "key": "textColor",
          "label": "Text",
          "valueType": "string"
        },
        {
          "key": "currentColor",
          "label": "Current page",
          "valueType": "string"
        },
        {
          "key": "boxShadow",
          "label": "Box shadow",
          "valueType": "string"
        }
      ],
      "events": [
        {
          "id": "onItemClicked",
          "label": "On item clicked"
        }
      ],
      "actions": [
        {
          "handle": "setVisibility",
          "displayName": "Set visibility",
          "params": [
            {
              "handle": "visibility",
              "displayName": "Value",
              "defaultValue": "{{false}}"
            }
          ]
        },
        {
          "handle": "setLoading",
          "displayName": "Set loading",
          "params": [
            {
              "handle": "loading",
              "displayName": "Value",
              "defaultValue": "{{false}}"
            }
          ]
        },
        {
          "handle": "setDisable",
          "displayName": "Set disable",
          "params": [
            {
              "handle": "disable",
              "displayName": "Value",
              "defaultValue": "{{false}}"
            }
          ]
        }
      ],
      "exposedVariables": [
        {
          "name": "items",
          "default": [
            "Home",
            "Fleet",
            "Seraphine"
          ]
        },
        {
          "name": "lastClickedItem",
          "default": {}
        },
        {
          "name": "isVisible",
          "default": true
        },
        {
          "name": "isLoading",
          "default": false
        },
        {
          "name": "isDisabled",
          "default": false
        }
      ]
    }
  ],
  "unknown_types": []
}
