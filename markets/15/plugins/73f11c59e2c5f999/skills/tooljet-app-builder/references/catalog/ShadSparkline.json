{
  "components": [
    {
      "type": "ShadSparkline",
      "name": "ShadSparkline",
      "description": "Tiny line or area trend for KPI cards, no axes or grid: data [12, 18, 15, 22] or [{ x: 'Mon', y: 12 }]; type line/area, curve, end dot, colorByTrend (last vs first value, positiveColor/negativeColor styles; lowerIsBetter flips it), optional min/max band. Height 24-64 px (40 typical), placed under a Stat; exposes trend ('up' | 'down' | 'flat') and lastValue.",
      "defaultSize": {
        "width": 8,
        "height": 40
      },
      "properties": [
        {
          "key": "data",
          "label": "Data",
          "valueType": "array",
          "default": "{{[12, 18, 15, 22, 19, 26, 24, 31]}}"
        },
        {
          "key": "type",
          "label": "Type",
          "valueType": "string",
          "default": "area",
          "allowedValues": [
            "line",
            "area"
          ]
        },
        {
          "key": "curve",
          "label": "Curve",
          "valueType": "string",
          "default": "monotone",
          "allowedValues": [
            "monotone",
            "linear",
            "step"
          ]
        },
        {
          "key": "strokeWidth",
          "label": "Line width (px)",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ],
          "default": "{{2}}"
        },
        {
          "key": "showEndDot",
          "label": "End dot",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "colorByTrend",
          "label": "Color by trend",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "lowerIsBetter",
          "label": "Lower is better",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "showBand",
          "label": "Min/max band",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "bandMin",
          "label": "Band from (blank = data min)",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ],
          "default": ""
        },
        {
          "key": "bandMax",
          "label": "Band to (blank = data max)",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ],
          "default": ""
        },
        {
          "key": "showTooltip",
          "label": "Tooltip",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "valuePrefix",
          "label": "Value prefix",
          "valueType": "string",
          "default": ""
        },
        {
          "key": "valueSuffix",
          "label": "Value suffix",
          "valueType": "string",
          "default": ""
        },
        {
          "key": "emptyText",
          "label": "Empty message",
          "valueType": "string",
          "default": "No data"
        },
        {
          "key": "animate",
          "label": "Animate",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "loadingState",
          "label": "Loading state",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "loadingIndicator",
          "label": "Loading look",
          "valueType": "string",
          "default": "spinner",
          "allowedValues": [
            "spinner",
            "skeleton"
          ]
        },
        {
          "key": "visibility",
          "label": "Visibility",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "collapseWhenHidden",
          "label": "Collapse when hidden",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "disabledState",
          "label": "Disable",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "tooltipFormat",
          "label": "Tooltip",
          "default": "plainText",
          "allowedValues": [
            "plainText",
            "markdown",
            "html"
          ]
        },
        {
          "key": "tooltip",
          "label": "Tooltip",
          "valueType": "string",
          "default": ""
        }
      ],
      "styles": [
        {
          "key": "boxShadow",
          "label": "Box shadow",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ],
          "default": "0px 0px 0px 0px #00000040"
        },
        {
          "key": "chartColor",
          "label": "Line color",
          "valueType": "string"
        },
        {
          "key": "positiveColor",
          "label": "Color when trend is up",
          "valueType": "string"
        },
        {
          "key": "negativeColor",
          "label": "Color when trend is down",
          "valueType": "string"
        },
        {
          "key": "bandColor",
          "label": "Band color",
          "valueType": "string"
        },
        {
          "key": "cssClass",
          "label": "CSS class",
          "default": ""
        }
      ],
      "events": [
        {
          "id": "onClick",
          "label": "On click"
        },
        {
          "id": "onDoubleClick",
          "label": "On double click"
        }
      ],
      "actions": [
        {
          "handle": "setVisibility",
          "displayName": "Set visibility",
          "params": [
            {
              "handle": "value",
              "displayName": "Value",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setDisable",
          "displayName": "Set disable",
          "params": [
            {
              "handle": "value",
              "displayName": "Value",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setLoading",
          "displayName": "Set loading",
          "params": [
            {
              "handle": "value",
              "displayName": "Value",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        }
      ],
      "exposedVariables": [
        {
          "name": "isVisible",
          "default": true
        },
        {
          "name": "isLoading",
          "default": false
        },
        {
          "name": "isDisabled",
          "default": false
        },
        {
          "name": "trend",
          "default": "flat"
        },
        {
          "name": "lastValue",
          "default": null
        }
      ],
      "authoringHints": {
        "styles": "Every style falls back to the app theme, so set only what the design needs to blend in (its accent, surfaces, borders and text colours), taking colours from the app theme or brand, never the defaults of another product. Radii and sizes are px. Styles are the way to restyle a pack widget: a cssClass only takes effect with workspace Custom styles, and Tailwind class names the pack does not already use are not compiled, so do not rely on either; for a one-off visual a style cannot express, use an Html component. Bind loadingState to the query's isLoading (each widget draws a skeleton or spinner in its own shape); tooltip shows on hover.",
        "usage": "data [12, 18, ...] or [{ x, y }]; 24 to 64px tall under a ShadStat; exposes trend (up, down, flat) to bind to the Stat trend."
      }
    }
  ],
  "unknown_types": []
}
