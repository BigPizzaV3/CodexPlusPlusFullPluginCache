{
  "components": [
    {
      "type": "RangeSliderV2",
      "name": "RangeSlider",
      "description": "Adjust value range",
      "defaultSize": {
        "width": 9,
        "height": 60
      },
      "properties": [
        {
          "key": "enableTwoHandle",
          "label": "Slider type",
          "default": "slider",
          "allowedValues": [
            "slider",
            "rangeSlider"
          ]
        },
        {
          "key": "label",
          "label": "Label",
          "valueType": "string",
          "default": "Label"
        },
        {
          "key": "min",
          "label": "Min value",
          "valueType": "number",
          "default": "{{0}}"
        },
        {
          "key": "max",
          "label": "Max value",
          "valueType": "number",
          "default": "{{100}}"
        },
        {
          "key": "value",
          "label": "Default value",
          "default": "{{50}}"
        },
        {
          "key": "startValue",
          "label": "Default start value",
          "default": "{{50}}"
        },
        {
          "key": "endValue",
          "label": "Default end value",
          "default": "{{80}}"
        },
        {
          "key": "stepSize",
          "label": "Step size",
          "valueType": "number",
          "default": "{{1}}"
        },
        {
          "key": "schema",
          "label": "Set marks",
          "default": "{{[\t{label: '25%',value: 25},{label: '50%',value: 50},{label: '75%',value: 75}\t]}}"
        },
        {
          "key": "loadingState",
          "label": "Show loading state",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "visibility",
          "label": "Visibility",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "disabledState",
          "label": "Disable",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "tooltipFormat",
          "label": "Tooltip",
          "default": "plainText",
          "allowedValues": [
            "plainText",
            "markdown",
            "html"
          ]
        },
        {
          "key": "tooltip",
          "label": "Tooltip",
          "valueType": "string",
          "default": ""
        }
      ],
      "styles": [
        {
          "key": "color",
          "label": "Color",
          "valueType": "string",
          "default": "var(--cc-primary-text)"
        },
        {
          "key": "labelFontSize",
          "label": "Size",
          "valueType": "number",
          "default": "{{12}}"
        },
        {
          "key": "alignment",
          "label": "Alignment",
          "valueType": "string",
          "default": "side",
          "allowedValues": [
            "side",
            "top"
          ]
        },
        {
          "key": "auto",
          "label": "Width",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "lineColor",
          "label": "Track",
          "valueType": "string",
          "default": "var(--cc-surface3-surface)"
        },
        {
          "key": "trackColor",
          "label": "Accent",
          "valueType": "string",
          "default": "var(--cc-primary-brand)"
        },
        {
          "key": "handleColor",
          "label": "Handle",
          "valueType": "string",
          "default": "var(--cc-surface1-surface)"
        },
        {
          "key": "handleBorderColor",
          "label": "Handle border",
          "valueType": "string",
          "default": "var(--cc-default-border)"
        },
        {
          "key": "markerLabel",
          "label": "Marker label",
          "valueType": "string",
          "default": "var(--cc-primary-text)"
        },
        {
          "key": "padding",
          "label": "Padding",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ],
          "default": "default",
          "allowedValues": [
            "default",
            "none"
          ]
        },
        {
          "key": "direction",
          "default": "left"
        },
        {
          "key": "width",
          "default": "{{33}}"
        },
        {
          "key": "visibility",
          "default": "{{true}}"
        },
        {
          "key": "widthType",
          "default": "ofComponent"
        },
        {
          "key": "cssClass",
          "label": "CSS class",
          "default": ""
        }
      ],
      "events": [
        {
          "id": "onChange",
          "label": "On change"
        }
      ],
      "actions": [
        {
          "handle": "setValue",
          "displayName": "Set value",
          "params": [
            {
              "handle": "num1",
              "displayName": "Value",
              "defaultValue": "0"
            }
          ]
        },
        {
          "handle": "setRangeValue",
          "displayName": "Set range value",
          "params": [
            {
              "handle": "num1",
              "displayName": "Min value"
            },
            {
              "handle": "num2",
              "displayName": "Max value"
            }
          ]
        },
        {
          "handle": "reset",
          "displayName": "Reset"
        },
        {
          "handle": "setDisable",
          "displayName": "Set disable",
          "params": [
            {
              "displayName": "Value",
              "defaultValue": "{{false}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setLoading",
          "displayName": "Set loading",
          "params": [
            {
              "displayName": "Value",
              "defaultValue": "{{false}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setVisibility",
          "displayName": "Set visibility",
          "params": [
            {
              "displayName": "Value",
              "defaultValue": "{{false}}",
              "type": "toggle"
            }
          ]
        }
      ],
      "exposedVariables": [
        {
          "name": "value",
          "default": null
        },
        {
          "name": "label",
          "default": "Label"
        },
        {
          "name": "isVisible",
          "default": true
        },
        {
          "name": "isDisabled",
          "default": false
        },
        {
          "name": "isLoading",
          "default": false
        }
      ]
    }
  ],
  "unknown_types": []
}
