{
  "components": [
    {
      "type": "ShadCurrencyInput",
      "name": "ShadCurrencyInput",
      "description": "Currency amount input: the currency sign inside the box, the amount formatted for the locale with Intl (1,250.00 in en-US, 1.250,00 in de-DE). Exposes value (a number, null when empty), formattedValue ('$1,250.00') and currency ('USD'). currency is an ISO code; currencyOptions (['USD', 'EUR', 'GBP']) adds a currency picker at the start of the box; decimalPlaces empty uses the currency's own (JPY 0). Height: 64px with a label (label above the control), 36px without; add 24px for help text or a validation message",
      "defaultSize": {
        "width": 10,
        "height": 70
      },
      "properties": [
        {
          "key": "label",
          "label": "Label",
          "valueType": "string",
          "default": "Amount"
        },
        {
          "key": "description",
          "label": "Help text",
          "valueType": "string",
          "default": ""
        },
        {
          "key": "placeholder",
          "label": "Placeholder",
          "valueType": "string",
          "default": "0.00"
        },
        {
          "key": "defaultValue",
          "label": "Default value",
          "valueType": "union",
          "valueTypes": [
            "number",
            "string"
          ],
          "default": ""
        },
        {
          "key": "currency",
          "label": "Currency (ISO code)",
          "valueType": "string",
          "default": "USD"
        },
        {
          "key": "currencyOptions",
          "label": "Currencies to choose from (empty: fixed)",
          "valueType": "array",
          "default": "{{[]}}"
        },
        {
          "key": "locale",
          "label": "Number format locale",
          "valueType": "string",
          "default": "en-US"
        },
        {
          "key": "decimalPlaces",
          "label": "Decimal places (empty: the currency's own)",
          "valueType": "union",
          "valueTypes": [
            "number",
            "string"
          ],
          "default": ""
        },
        {
          "key": "currencyDisplay",
          "label": "Currency sign",
          "valueType": "string",
          "default": "symbol",
          "allowedValues": [
            "symbol",
            "narrowSymbol",
            "code"
          ]
        },
        {
          "key": "showClearBtn",
          "label": "Show clear button",
