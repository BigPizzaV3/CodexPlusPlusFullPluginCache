{
  "components": [
    {
      "type": "ShadDatePicker",
      "name": "ShadDatePicker",
      "description": "Date picker (popover calendar), single date or range. Height: 64px with a label (label above the control), 36px without; add 24px for help text",
      "defaultSize": {
        "width": 10,
        "height": 70
      },
      "properties": [
        {
          "key": "label",
          "label": "Label",
          "valueType": "string",
          "default": "Date"
        },
        {
          "key": "description",
          "label": "Help text",
          "valueType": "string",
          "default": ""
        },
        {
          "key": "mode",
          "label": "Mode",
          "valueType": "string",
          "default": "single",
          "allowedValues": [
            "single",
            "range"
          ]
        },
        {
          "key": "placeholder",
          "label": "Placeholder",
          "valueType": "string",
          "default": "Pick a date"
        },
        {
          "key": "defaultValue",
          "label": "Default (YYYY-MM-DD, or [start, end] for a range)",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number",
            "boolean",
            "array",
            "object"
          ],
          "default": ""
        },
        {
          "key": "format",
