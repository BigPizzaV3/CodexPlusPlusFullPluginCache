      "description": "Edit source code",
      "defaultSize": {
        "width": 15,
        "height": 120
      },
      "properties": [
        {
          "key": "enableLineNumber",
          "label": "Show line number",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "dynamicHeight",
          "label": "Dynamic height",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "collapseWhenHidden",
          "label": "Collapse when hidden",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "mode",
          "label": "Mode",
          "valueType": "string",
          "default": "javascript"
        },
        {
          "key": "placeholder",
          "label": "Placeholder",
          "valueType": "string",
          "default": ""
        }
      ],
      "styles": [
        {
          "key": "visibility",
          "label": "Visibility",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "disabledState",
