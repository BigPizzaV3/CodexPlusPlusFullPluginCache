{
  "components": [
    {
      "type": "ShadDateTimePicker",
      "name": "ShadDateTimePicker",
      "description": "Date and time picker: a field opening a calendar with a time row (hour, minute, AM/PM; a time every minuteStep minutes from midnight). Exposes value as 'YYYY-MM-DDTHH:mm' (local time, '' when empty), selectedDate 'YYYY-MM-DD', selectedTime 'HH:mm', unixTimestamp (ms) and displayValue (dateFormat plus the time). defaultValue takes ISO text, 'YYYY-MM-DD HH:mm' or a unix timestamp; minDate/maxDate ('YYYY-MM-DD') and disabledDates (array) block days. Height: 64px with a label (label above the control), 36px without; add 24px for help text or a validation message",
      "defaultSize": {
        "width": 12,
        "height": 70
      },
      "properties": [
        {
          "key": "label",
          "label": "Label",
          "valueType": "string",
          "default": "Date and time"
        },
        {
          "key": "description",
          "label": "Help text",
          "valueType": "string",
          "default": ""
        },
        {
          "key": "placeholder",
          "label": "Placeholder",
          "valueType": "string",
          "default": "Pick a date and time"
        },
        {
          "key": "defaultValue",
          "label": "Default value (YYYY-MM-DD HH:mm)",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ],
          "default": ""
        },
        {
          "key": "dateFormat",
          "label": "Date display format",
          "valueType": "string",
          "default": "DD MMM YYYY"
        },
        {
          "key": "timeFormat",
          "label": "Time format",
          "valueType": "string",
          "default": "12h",
          "allowedValues": [
            "12h",
            "24h"
          ]
        },
        {
          "key": "minuteStep",
          "label": "Minute step",
          "valueType": "number",
          "default": "{{5}}"
        },
        {
          "key": "minDate",
          "label": "Earliest date (YYYY-MM-DD)",
          "valueType": "string",
          "default": ""
        },
        {
          "key": "maxDate",
          "label": "Latest date (YYYY-MM-DD)",
          "valueType": "string",
          "default": ""
        },
        {
          "key": "disabledDates",
          "label": "Disabled dates",
          "valueType": "array",
          "default": "{{[]}}"
        },
        {
          "key": "showClearBtn",
          "label": "Show clear button",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "loadingState",
          "label": "Loading state",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "visibility",
          "label": "Visibility",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "collapseWhenHidden",
          "label": "Collapse when hidden",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "disabledState",
          "label": "Disable",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "tooltipFormat",
          "label": "Tooltip",
          "default": "plainText",
          "allowedValues": [
            "plainText",
            "markdown",
            "html"
          ]
        },
        {
          "key": "tooltip",
          "label": "Tooltip",
          "valueType": "string",
          "default": ""
        }
      ],
      "styles": [
        {
          "key": "boxShadow",
          "label": "Box shadow",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ],
          "default": "0px 0px 0px 0px #00000040"
        },
        {
          "key": "labelColor",
          "label": "Label color",
          "valueType": "string"
        },
        {
          "key": "helpTextColor",
          "label": "Help text color",
          "valueType": "string"
        },
        {
          "key": "backgroundColor",
          "label": "Field background",
          "valueType": "string"
        },
        {
          "key": "textColor",
          "label": "Field text color",
          "valueType": "string"
        },
        {
          "key": "placeholderColor",
          "label": "Placeholder color",
          "valueType": "string"
        },
        {
          "key": "borderColor",
          "label": "Field border color",
          "valueType": "string"
        },
        {
          "key": "accentColor",
          "label": "Accent (focus ring, selection)",
          "valueType": "string"
        },
        {
          "key": "errorColor",
          "label": "Error color (message and border)",
          "valueType": "string"
        },
        {
          "key": "borderRadius",
          "label": "Field radius",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ]
        },
        {
          "key": "iconColor",
          "label": "Calendar icon color",
          "valueType": "string"
        },
        {
          "key": "popoverBackgroundColor",
          "label": "Popover background",
          "valueType": "string"
        },
        {
          "key": "popoverTextColor",
          "label": "Popover text color",
          "valueType": "string"
        },
        {
          "key": "hoverColor",
          "label": "Popover item hover background",
          "valueType": "string"
        },
        {
          "key": "selectedTextColor",
          "label": "Selected item text color (on the accent)",
          "valueType": "string"
        },
        {
          "key": "cssClass",
          "label": "CSS class",
          "default": ""
        }
      ],
      "events": [
        {
          "id": "onSelect",
          "label": "On select"
        },
        {
          "id": "onFocus",
          "label": "On focus"
        },
        {
          "id": "onBlur",
          "label": "On blur"
        }
      ],
      "actions": [
        {
          "handle": "setValue",
