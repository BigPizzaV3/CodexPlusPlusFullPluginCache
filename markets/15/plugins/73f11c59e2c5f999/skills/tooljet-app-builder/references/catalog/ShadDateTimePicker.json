              "defaultValue": "{{[]}}"
            }
          ]
        },
        {
          "handle": "clearDisabledDates",
          "displayName": "Clear disabled dates"
        },
        {
          "handle": "setFocus",
          "displayName": "Set focus"
        },
        {
          "handle": "setBlur",
          "displayName": "Set blur"
        },
        {
          "handle": "setVisibility",
