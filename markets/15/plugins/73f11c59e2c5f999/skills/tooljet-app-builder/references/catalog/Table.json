      "renderingHints": {
        "visibleRowCapacity": {
          "regularRowHeightPx": 46,
          "condensedRowHeightPx": 40,
          "fixedChromePx": "≈154 with the default 56px toolbar, 40px column header, 56px footer, and borders",
          "formula": "minimum static height ≈ fixed chrome + rowsPerPage × row height",
          "rule": "If authored height is smaller, the page rows remain reachable through an inner scrollbar but appear clipped. Reduce rowsPerPage, use dynamicHeight, or increase the authored height."
        }
      },
      "authoringHints": {
        "look": "styles.tableLook \"shadcn\" draws this Table in the ToolJet UI 2.0 look (card frame, search-first toolbar, quiet header, hairline rows, UI 2.0 buttons and pagination); use it for tables in apps built in ToolJet UI 2.0. Properties, columns, row action buttons, events and exposed values are the Table's own in both looks.",
        "rowActionDisplay": "In the UI 2.0 table look a button column takes buttonDisplay: 'icons' (32px ghost icon buttons, the label as tooltip) for one to three actions every row needs at a glance (View, Edit, Delete), or 'menu' (one '...' button at the row's right edge opening a dropdown) for three or more actions or rarely used ones; 'buttons' (default) keeps labelled buttons, for a single primary row action ('Check in', 'Approve'). Icons come from buttonIconName with buttonIconVisibility true, else from the label's verb (Edit pencil, Delete trash, View eye, Approve check, Send, Export, Copy, Archive...): give every button a short verb label. Delete, Remove and Reject draw in the destructive colour, set apart at the end of the menu. Events, rowData bindings (buttonVisibility, disableButton) and selectedRow work as for labelled buttons; leave name empty or 'Actions' and do not pin it. The ToolJet look ignores buttonDisplay.",
        "checkboxSelection": "For bulk actions (approve, export, assign, delete several rows) turn on showBulkSelector: the table draws a checkbox column with a select-all box in the header (the UI 2.0 checkbox in that look). Read components.<table>.selectedRows (the row objects) and selectedRowsId; put the bulk action in a ShadButton above the table whose text counts them ('Approve 3') and whose disabledState is {{!(components.<table>.selectedRows || []).length}}; onSelectionChanged fires on each change. Keep allowSelection on. After the action runs, refresh the data query (the selection clears with new data). A checkbox column is for acting on several rows; for opening one record, use onRowClicked.",
        "serverSideDataFlow": {
          "exposedVariables": {
            "pageIndex": "1-based number",
            "searchText": "string",
            "sortApplied": "[{column,columnKey,direction:\"asc\"|\"desc\"}]",
            "filters": "[{column,condition,value}]"
          },
          "reactiveReadRule": "When page/count options reference Table or external-filter exposed state, prefer runOnDependencyChange=true so reads occur after the new state is published. Keep onPageLoad for initial hydration and onRefresh for explicit refresh.",
          "initialPageGuard": "pageIndex can be undefined when a page-load query first evaluates. For offset pagination use ((components.<table>.pageIndex || 1) - 1) * pageSize, or an equivalent nullish guard; the unguarded subtraction produces NaN and an empty table.",
          "eventRule": "With reactive reads, onPageChanged/onSearch/onSort/onFilterChanged and external-filter events should not also run those queries. Use them only for non-query effects such as resetting pageIndex to 1; duplicate wiring causes redundant or stale reads."
        },
        "runtimeCompatibility": {
          "autogenerateColumns": true,
          "useDynamicColumn": "{{false}}",
          "rule": "For explicit static columns, keep table-level autogenerateColumns=true and useDynamicColumn=false. MCP normalizes these defaults because some ToolJet versions crash while generating column transformations when autogenerateColumns is false."
        },
        "dataProjection": {
          "rule": "With explicit columns and autogenerateColumns=true, bind data to a new object containing only visible and behavior-needed keys. A .map(r => r) identity map or {...r} spread is not a projection and can leak undeclared datasource fields.",
          "safeExample": "{{queries.listRows.data.map(r => ({id:r.id,name:r.name,status:r.status}))}}",
          "unsafeExamples": [
            "{{queries.listRows.data.map(r => r)}}",
