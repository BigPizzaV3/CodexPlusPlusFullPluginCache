{
  "components": [
    {
      "type": "Link",
      "name": "Link",
      "description": "Add link to the text",
      "defaultSize": {
        "width": 6,
        "height": 30
      },
      "properties": [
        {
          "key": "linkText",
          "label": "Link text",
          "valueType": "string",
          "default": "Click here"
        },
        {
          "key": "linkTarget",
          "label": "Link target",
          "valueType": "string",
          "default": "https://dev.to/"
        },
        {
          "key": "targetType",
          "label": "Target type",
          "valueType": "string",
          "default": "new",
          "allowedValues": [
            "new",
            "same"
          ]
        },
        {
          "key": "loadingState",
          "label": "Loading state",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "visibility",
          "label": "Visibility",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "disabledState",
          "label": "Disable",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "dynamicHeight",
          "label": "Dynamic height",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "collapseWhenHidden",
          "label": "Collapse when hidden",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
