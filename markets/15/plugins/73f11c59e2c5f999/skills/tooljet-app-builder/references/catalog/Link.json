          "default": "{{14}}"
        },
        {
          "key": "horizontalAlignment",
          "label": "Alignment",
          "valueType": "string",
          "default": "left"
        },
        {
          "key": "icon",
          "label": "Icon",
          "valueType": "string",
          "default": "IconLink"
        },
        {
          "key": "underline",
          "label": "Underline",
          "valueType": "string",
          "default": "on-hover",
          "allowedValues": [
            "no-underline",
            "on-hover",
            "underline"
          ]
        },
        {
          "key": "boxShadow",
          "label": "Box Shadow",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ],
          "default": "0px 0px 0px 0px #00000040"
        },
        {
          "key": "padding",
          "label": "Padding",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ],
          "default": "default",
          "allowedValues": [
            "default",
            "none"
          ]
        },
        {
          "key": "verticalAlignment",
          "default": "center"
        },
        {
          "key": "iconVisibility",
          "default": false
        },
        {
          "key": "cssClass",
          "label": "CSS class",
          "default": ""
