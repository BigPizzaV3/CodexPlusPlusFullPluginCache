              "defaultValue": "{{false}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setLoading",
          "displayName": "Set loading",
          "params": [
            {
              "handle": "isLoading",
              "displayName": "Value",
              "defaultValue": "{{false}}",
              "type": "toggle"
            }
          ]
