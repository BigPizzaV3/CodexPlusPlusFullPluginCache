{
  "components": [
    {
      "type": "Lib_shadcn_TabsContainer",
      "name": "Lib_shadcn_TabsContainer",
      "description": "Tabs Container from the shadcn UI component library. Tabs [{id,label}] each with a canvas of child components (slot tab_<id>); currentTab. Drawn at the height you give it.",
      "defaultSize": {
        "width": 20,
        "height": 400
      },
      "properties": [
        {
          "key": "tabs",
          "label": "Tabs",
          "valueType": "array",
          "default": "{{[{\"id\":\"details\",\"label\":\"Details\"},{\"id\":\"activity\",\"label\":\"Activity\"}]}}",
          "description": "Array of { id, label } objects. Keep ids stable: dropped components stay with their tab id."
        },
        {
          "key": "currentTab",
          "label": "Default tab",
          "valueType": "string",
          "default": "details"
        },
        {
          "key": "currentTabTitle",
          "label": "Current Tab Title",
          "valueType": "string",
          "default": ""
        },
        {
          "key": "visibility",
          "label": "Visibility",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "loadingState",
          "label": "Loading state",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "disabledState",
          "label": "Disable",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "dynamicHeight",
          "label": "Dynamic height",
          "valueType": "boolean",
          "default": "{{false}}"
        }
      ],
      "styles": [
        {
          "key": "accentColor",
          "label": "Active tab",
          "valueType": "string"
        },
        {
          "key": "backgroundColor",
          "label": "Background",
          "valueType": "string"
        },
        {
          "key": "borderRadius",
          "label": "Border radius",
          "valueType": "number"
        },
        {
          "key": "padding",
          "label": "Padding",
          "valueType": "number"
        },
        {
          "key": "boxShadow",
          "label": "Box shadow",
          "valueType": "string"
        }
      ],
      "events": [
        {
          "id": "onChange",
          "label": "On change"
        },
        {
          "id": "onTabSwitch",
          "label": "On tab switch"
        }
      ],
      "actions": [
        {
          "handle": "setTab",
          "displayName": "Set tab",
          "params": [
            {
              "handle": "id",
              "displayName": "Tab id"
            }
          ]
        },
        {
          "handle": "nextTab",
          "displayName": "Next tab"
        },
        {
          "handle": "previousTab",
          "displayName": "Previous tab"
        },
        {
          "handle": "setVisibility",
          "displayName": "Set visibility",
          "params": [
            {
              "handle": "visibility",
              "displayName": "Value",
              "defaultValue": "{{false}}"
            }
          ]
        },
        {
          "handle": "setLoading",
          "displayName": "Set loading",
          "params": [
            {
              "handle": "loading",
              "displayName": "Value",
              "defaultValue": "{{false}}"
            }
          ]
        },
        {
          "handle": "setDisable",
          "displayName": "Set disable",
          "params": [
            {
              "handle": "disable",
              "displayName": "Value",
              "defaultValue": "{{false}}"
            }
          ]
        }
      ],
      "exposedVariables": [
        {
          "name": "tabs",
          "default": [
            {
              "id": "details",
              "label": "Details"
            },
            {
              "id": "activity",
              "label": "Activity"
            }
          ]
        },
        {
          "name": "currentTab",
          "default": "details"
        },
        {
          "name": "currentTabTitle",
          "default": ""
        },
        {
          "name": "isVisible",
          "default": true
        },
        {
          "name": "isLoading",
          "default": false
        },
        {
          "name": "isDisabled",
          "default": false
        }
      ]
    }
  ],
  "unknown_types": []
}
