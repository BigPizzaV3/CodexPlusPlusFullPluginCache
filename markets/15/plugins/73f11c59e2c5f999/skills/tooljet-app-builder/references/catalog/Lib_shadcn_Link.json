{
  "components": [
    {
      "type": "Lib_shadcn_Link",
      "name": "Lib_shadcn_Link",
      "description": "Link from the shadcn UI component library. Drawn at the height you give it.",
      "defaultSize": {
        "width": 6,
        "height": 30
      },
      "properties": [
        {
          "key": "linkText",
          "label": "Text",
          "valueType": "string",
          "default": "View details"
        },
        {
          "key": "linkTarget",
          "label": "URL",
          "valueType": "string",
          "default": "https://tooljet.com"
        },
        {
          "key": "targetType",
          "label": "Open in",
          "valueType": "string",
          "default": "new",
          "allowedValues": [
            "new",
            "same"
          ]
        },
        {
          "key": "underline",
          "label": "Underline",
          "valueType": "string",
          "default": "on-hover",
          "allowedValues": [
            "on-hover",
            "always",
            "never"
          ]
        },
        {
          "key": "showIcon",
          "label": "Show icon",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "visibility",
          "label": "Visibility",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "loadingState",
          "label": "Loading state",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "disabledState",
          "label": "Disable",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "dynamicHeight",
          "label": "Dynamic height",
          "valueType": "boolean",
          "default": "{{false}}"
        }
      ],
      "styles": [
        {
          "key": "textColor",
          "label": "Text color",
          "valueType": "string"
        },
        {
          "key": "fontSize",
          "label": "Font size",
          "valueType": "number"
        },
        {
          "key": "boxShadow",
          "label": "Box shadow",
          "valueType": "string"
        }
      ],
      "events": [
        {
          "id": "onClick",
          "label": "On click"
        },
        {
          "id": "onHover",
          "label": "On hover"
        }
      ],
      "actions": [
        {
          "handle": "click",
          "displayName": "Click"
        },
        {
          "handle": "setLinkTarget",
          "displayName": "Set URL",
          "params": [
            {
              "handle": "url",
              "displayName": "URL"
            }
          ]
        },
        {
          "handle": "setLinkText",
          "displayName": "Set text",
          "params": [
            {
              "handle": "text",
              "displayName": "Text"
            }
          ]
        },
        {
          "handle": "setVisibility",
          "displayName": "Set visibility",
          "params": [
            {
              "handle": "visibility",
              "displayName": "Value",
              "defaultValue": "{{false}}"
            }
          ]
        },
        {
          "handle": "setLoading",
          "displayName": "Set loading",
          "params": [
            {
              "handle": "loading",
              "displayName": "Value",
              "defaultValue": "{{false}}"
            }
          ]
        },
        {
          "handle": "setDisable",
          "displayName": "Set disable",
          "params": [
            {
              "handle": "disable",
              "displayName": "Value",
              "defaultValue": "{{false}}"
            }
          ]
        }
      ],
      "exposedVariables": [
        {
          "name": "linkText",
          "default": "View details"
        },
        {
          "name": "linkTarget",
          "default": "https://tooljet.com"
        },
        {
          "name": "targetType",
          "default": "new"
        },
        {
          "name": "underline",
          "default": "on-hover"
        },
        {
          "name": "showIcon",
          "default": false
        },
        {
          "name": "isVisible",
          "default": true
        },
        {
          "name": "isLoading",
          "default": false
        },
        {
          "name": "isDisabled",
          "default": false
        }
      ]
    }
  ],
  "unknown_types": []
}
