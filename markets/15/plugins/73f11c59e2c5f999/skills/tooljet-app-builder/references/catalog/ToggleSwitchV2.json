{
  "components": [
    {
      "type": "ToggleSwitchV2",
      "name": "ToggleSwitch",
      "description": "User-controlled on-off switch",
      "defaultSize": {
        "width": 6,
        "height": 30
      },
      "properties": [
        {
          "key": "label",
          "label": "Label",
          "valueType": "string",
          "default": "Label"
        },
        {
          "key": "defaultValue",
          "label": "Default state",
          "valueType": "boolean",
          "default": "{{false}}",
          "allowedValues": [
            "{{true}}",
            "{{false}}"
          ]
        },
        {
          "key": "loadingState",
          "label": "Loading state",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "visibility",
          "label": "Visibility",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "collapseWhenHidden",
          "label": "Collapse when hidden",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "disabledState",
          "label": "Disable",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "tooltipFormat",
          "label": "Tooltip",
          "default": "plainText",
          "allowedValues": [
            "plainText",
            "markdown",
            "html"
          ]
        },
        {
          "key": "tooltip",
          "label": "Tooltip",
          "valueType": "string",
          "default": ""
        }
      ],
      "styles": [
        {
          "key": "textColor",
          "label": "Text Color",
          "valueType": "string",
          "default": "var(--cc-primary-text)"
        },
        {
          "key": "borderColor",
          "label": "Border color",
          "valueType": "string",
          "default": "var(--cc-default-border)"
        },
        {
          "key": "toggleSwitchColor",
          "label": "Checked color",
          "valueType": "string",
          "default": "var(--cc-primary-brand)"
        },
        {
          "key": "uncheckedColor",
          "label": "Unchecked color",
          "valueType": "string",
          "default": "var(--cc-surface3-surface)"
        },
        {
          "key": "handleColor",
          "label": "Handle color",
          "valueType": "string",
          "default": "var(--cc-surface1-surface)"
        },
        {
          "key": "alignment",
          "label": "Alignment",
          "valueType": "string",
          "default": "right",
          "allowedValues": [
            "left",
            "right"
          ]
        },
        {
          "key": "boxShadow",
          "label": "Box Shadow",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ],
          "default": "0px 0px 0px 0px #00000090"
        },
        {
          "key": "padding",
          "label": "Padding",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ],
          "default": "default",
          "allowedValues": [
            "default",
            "none"
          ]
        },
        {
          "key": "cssClass",
          "label": "CSS class",
          "default": ""
        }
      ],
      "events": [
        {
          "id": "onChange",
          "label": "On change"
        }
      ],
      "actions": [
        {
          "handle": "toggle",
          "displayName": "toggle"
        },
        {
          "handle": "setValue",
          "displayName": "Set value",
          "params": [
            {
              "handle": "value",
              "displayName": "value"
            }
          ]
        },
        {
          "handle": "setVisibility",
          "displayName": "Set visibility",
          "params": [
            {
              "handle": "disable",
              "displayName": "Value",
              "defaultValue": "{{false}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setDisable",
          "displayName": "Set disable",
          "params": [
            {
              "handle": "disable",
              "displayName": "Value",
              "defaultValue": "{{false}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setLoading",
          "displayName": "Set loading",
          "params": [
            {
              "handle": "loading",
              "displayName": "Value",
              "defaultValue": "{{false}}",
              "type": "toggle"
            }
          ]
        }
      ],
      "exposedVariables": [
        {
          "name": "value",
          "default": false
        },
        {
          "name": "label",
          "default": "Label"
        },
        {
          "name": "isMandatory",
          "default": false
        },
        {
          "name": "isVisible",
          "default": true
        },
        {
          "name": "isDisabled",
          "default": false
        },
        {
          "name": "isLoading",
          "default": false
        }
      ]
    }
  ],
  "unknown_types": []
}
