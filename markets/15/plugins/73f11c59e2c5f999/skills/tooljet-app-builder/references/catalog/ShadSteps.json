{
  "components": [
    {
      "type": "ShadSteps",
      "name": "ShadSteps",
      "description": "Stepper (native Steps names): steps [{ id, name, description?, visible?, disabled?, tooltip? }]; currentStep is the current step's id; numbered circles (variant 'dots' for small dots), check marks on completed steps, connecting lines; orientation 'horizontal' or 'vertical'. stepsSelectable lets users click a step (onSelect; exposed currentStepId, currentStepIndex). Actions setStep(id), nextStep, previousStep, resetSteps, setStepVisible(id, visible), setStepDisable(id, disabled). Height: 60px horizontal (78px with descriptions); vertical about 66px per step",
      "defaultSize": {
        "width": 24,
        "height": 80
      },
      "properties": [
        {
          "key": "steps",
          "label": "Steps",
          "valueType": "array",
          "default": "{{[{ id: 1, name: 'Account', description: 'Your details' }, { id: 2, name: 'Company', description: 'Team and size' }, { id: 3, name: 'Billing', description:…"
        },
        {
          "key": "currentStep",
          "label": "Current step (id)",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ],
          "default": "{{2}}"
        },
        {
          "key": "stepsSelectable",
          "label": "Steps selectable",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "orientation",
          "label": "Orientation",
          "valueType": "string",
          "default": "horizontal",
          "allowedValues": [
            "horizontal",
            "vertical"
          ]
        },
        {
          "key": "variant",
          "label": "Marker",
          "valueType": "string",
          "default": "numbers",
          "allowedValues": [
            "numbers",
            "dots"
          ]
        },
        {
          "key": "dynamicHeight",
          "label": "Dynamic height",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "loadingState",
          "label": "Loading state",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "loadingIndicator",
          "label": "Loading look",
          "valueType": "string",
          "default": "spinner",
          "allowedValues": [
            "spinner",
            "skeleton"
          ]
        },
        {
          "key": "visibility",
          "label": "Visibility",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "collapseWhenHidden",
          "label": "Collapse when hidden",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "disabledState",
          "label": "Disable",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "tooltipFormat",
          "label": "Tooltip",
          "default": "plainText",
          "allowedValues": [
            "plainText",
            "markdown",
            "html"
          ]
        },
        {
          "key": "tooltip",
          "label": "Tooltip",
          "valueType": "string",
          "default": ""
        }
      ],
      "styles": [
        {
          "key": "boxShadow",
          "label": "Box shadow",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ],
          "default": "0px 0px 0px 0px #00000040"
        },
        {
          "key": "completedAccent",
          "label": "Completed and current accent",
          "valueType": "string"
        },
        {
          "key": "incompletedAccent",
          "label": "Upcoming step accent (circle border, line)",
          "valueType": "string"
        },
        {
          "key": "completedLabel",
          "label": "Completed step label",
          "valueType": "string"
        },
        {
          "key": "currentStepLabel",
          "label": "Current step label",
          "valueType": "string"
        },
        {
          "key": "incompletedLabel",
          "label": "Upcoming step label",
          "valueType": "string"
        },
        {
          "key": "descriptionColor",
          "label": "Description color",
          "valueType": "string"
        },
        {
          "key": "cssClass",
          "label": "CSS class",
          "default": ""
        }
      ],
      "events": [
        {
          "id": "onSelect",
          "label": "On select"
        }
      ],
      "actions": [
        {
          "handle": "setStep",
          "displayName": "Set step",
          "params": [
            {
              "handle": "option",
              "displayName": "Step id",
              "defaultValue": "{{1}}"
            }
          ]
        },
        {
          "handle": "nextStep",
          "displayName": "Next step",
          "params": []
        },
        {
          "handle": "previousStep",
          "displayName": "Previous step",
          "params": []
        },
        {
          "handle": "resetSteps",
          "displayName": "Reset steps",
          "params": []
        },
        {
          "handle": "setStepVisible",
          "displayName": "Set step visible",
          "params": [
            {
              "handle": "id",
              "displayName": "Step id"
            },
            {
              "handle": "visibility",
              "displayName": "Visible",
              "defaultValue": "{{false}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setStepDisable",
          "displayName": "Set step disable",
          "params": [
            {
              "handle": "id",
              "displayName": "Step id"
            },
            {
              "handle": "disabled",
              "displayName": "Disabled",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setVisibility",
          "displayName": "Set visibility",
          "params": [
            {
              "handle": "value",
              "displayName": "Value",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setDisable",
          "displayName": "Set disable",
          "params": [
            {
              "handle": "value",
              "displayName": "Value",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setLoading",
          "displayName": "Set loading",
          "params": [
            {
              "handle": "value",
              "displayName": "Value",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        }
      ],
      "exposedVariables": [
        {
          "name": "isVisible",
          "default": true
        },
        {
          "name": "isLoading",
          "default": false
        },
        {
          "name": "isDisabled",
          "default": false
        },
        {
          "name": "currentStepId",
          "default": 1
        },
        {
          "name": "currentStepIndex",
          "default": 0
        },
        {
          "name": "steps",
          "default": []
        }
      ],
      "authoringHints": {
        "styles": "Every style falls back to the app theme, so set only what the design needs to blend in (its accent, surfaces, borders and text colours), taking colours from the app theme or brand, never the defaults of another product. Radii and sizes are px. Styles are the way to restyle a pack widget: a cssClass only takes effect with workspace Custom styles, and Tailwind class names the pack does not already use are not compiled, so do not rely on either; for a one-off visual a style cannot express, use an Html component. Bind loadingState to the query's isLoading (each widget draws a skeleton or spinner in its own shape); tooltip shows on hover.",
        "usage": "steps [{ id, title, description? }], currentStep is an id; setStep, nextStep, previousStep; exposes currentStepIndex. 60px tall, 78 with descriptions."
      }
    }
  ],
  "unknown_types": []
}
