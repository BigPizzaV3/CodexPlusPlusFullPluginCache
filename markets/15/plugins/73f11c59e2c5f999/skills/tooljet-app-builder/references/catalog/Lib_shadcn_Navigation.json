{
  "components": [
    {
      "type": "Lib_shadcn_Navigation",
      "name": "Lib_shadcn_Navigation",
      "description": "Navigation from the shadcn UI component library. Drawn at the height you give it.",
      "defaultSize": {
        "width": 9,
        "height": 320
      },
      "properties": [
        {
          "key": "items",
          "label": "Items",
          "valueType": "array",
          "default": "{{[{\"label\":\"Dashboard\",\"value\":\"dashboard\",\"icon\":\"dashboard\",\"group\":\"Workspace\"},{\"label\":\"Orders\",\"value\":\"orders\",\"icon\":\"package\",\"badge\":\"12\",\"group\":\"Workspace\"},{\"label\":\"Customers\",\"value\":\"customers\",\"icon\":\"users\",\"group\":\"Workspace\"},{\"label\":\"Reports\",\"value\":\"reports\",\"icon\":\"bar-chart\",\"group\":\"Insights\"},{\"label\":\"Settings\",\"value\":\"settings\",\"icon\":\"settings\",\"group\":\"Insights\"}]}}",
          "description": "Array of { label, value, icon, badge, group, disabled, hidden }."
        },
        {
          "key": "value",
          "label": "Selected item",
          "valueType": "string",
          "default": "dashboard"
        },
        {
          "key": "orientation",
          "label": "Orientation",
          "valueType": "string",
          "default": "vertical",
          "allowedValues": [
            "vertical",
            "horizontal"
          ]
        },
        {
          "key": "variant",
          "label": "Variant",
          "valueType": "string",
          "default": "pills",
          "allowedValues": [
            "pills",
            "underline",
            "ghost"
          ]
        },
        {
          "key": "collapsed",
          "label": "Collapsed (icons only)",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "showCollapseButton",
          "label": "Show collapse button",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "previousSelectedItem",
          "label": "Previous Selected Item",
          "valueType": "string",
          "default": ""
        },
        {
          "key": "visibility",
          "label": "Visibility",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "loadingState",
          "label": "Loading state",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "disabledState",
          "label": "Disable",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "dynamicHeight",
          "label": "Dynamic height",
          "valueType": "boolean",
          "default": "{{false}}"
        }
      ],
      "styles": [
        {
          "key": "backgroundColor",
          "label": "Background",
          "valueType": "string"
        },
        {
          "key": "activeBackgroundColor",
          "label": "Active background",
          "valueType": "string"
        },
        {
          "key": "indicatorColor",
          "label": "Active indicator",
          "valueType": "string"
        },
        {
          "key": "textColor",
          "label": "Text",
          "valueType": "string"
        },
        {
          "key": "boxShadow",
          "label": "Box shadow",
          "valueType": "string"
        }
      ],
      "events": [
        {
          "id": "onClick",
          "label": "On click"
        }
      ],
      "actions": [
        {
          "handle": "selectItem",
          "displayName": "Select item",
          "params": [
            {
              "handle": "value",
              "displayName": "Item value"
            }
          ]
        },
        {
          "handle": "setCollapsed",
          "displayName": "Collapse",
          "params": [
            {
              "handle": "collapsed",
              "displayName": "Collapsed"
            }
          ]
        },
        {
          "handle": "setVisibility",
          "displayName": "Set visibility",
          "params": [
            {
              "handle": "visibility",
              "displayName": "Value",
              "defaultValue": "{{false}}"
            }
          ]
        },
        {
          "handle": "setLoading",
          "displayName": "Set loading",
          "params": [
            {
              "handle": "loading",
              "displayName": "Value",
              "defaultValue": "{{false}}"
            }
          ]
        },
        {
          "handle": "setDisable",
          "displayName": "Set disable",
          "params": [
            {
              "handle": "disable",
              "displayName": "Value",
              "defaultValue": "{{false}}"
            }
          ]
        }
      ],
      "exposedVariables": [
        {
          "name": "items",
          "default": [
            {
              "label": "Dashboard",
              "value": "dashboard",
              "icon": "dashboard",
              "group": "Workspace"
            },
            {
              "label": "Orders",
