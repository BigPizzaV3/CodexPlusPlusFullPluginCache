              "icon": "users",
              "group": "Workspace"
            },
            {
              "label": "Reports",
              "value": "reports",
              "icon": "bar-chart",
              "group": "Insights"
            },
            {
              "label": "Settings",
              "value": "settings",
              "icon": "settings",
              "group": "Insights"
            }
          ]
        },
        {
          "name": "value",
          "default": "dashboard"
        },
        {
          "name": "orientation",
          "default": "vertical"
        },
        {
          "name": "variant",
          "default": "pills"
        },
        {
          "name": "collapsed",
          "default": false
        },
        {
          "name": "showCollapseButton",
          "default": true
        },
        {
          "name": "previousSelectedItem",
          "default": ""
        },
        {
          "name": "isVisible",
          "default": true
        },
        {
          "name": "isLoading",
