{
  "components": [
    {
      "type": "Lib_shadcn_OtpInput",
      "name": "Lib_shadcn_OtpInput",
      "description": "Otp Input from the shadcn UI component library. Sizes to its content in the app (Dynamic height on).",
      "defaultSize": {
        "width": 12,
        "height": 90
      },
      "properties": [
        {
          "key": "label",
          "label": "Label",
          "valueType": "string",
          "default": "Verification code"
        },
        {
          "key": "length",
          "label": "Digits",
          "valueType": "number",
          "default": "{{6}}"
        },
        {
          "key": "value",
          "label": "Default value",
          "valueType": "string",
          "default": ""
        },
        {
          "key": "description",
          "label": "Help text",
          "valueType": "string",
          "default": "Enter the code we sent to your phone."
        },
        {
          "key": "disabled",
          "label": "Disable",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "isComplete",
          "label": "Is Complete",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "visibility",
          "label": "Visibility",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "loadingState",
          "label": "Loading state",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "disabledState",
          "label": "Disable",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "dynamicHeight",
          "label": "Dynamic height",
          "valueType": "boolean",
          "default": "{{true}}"
        }
      ],
      "styles": [
        {
          "key": "backgroundColor",
          "label": "Background",
          "valueType": "string"
        },
        {
          "key": "textColor",
          "label": "Text",
          "valueType": "string"
        },
        {
          "key": "borderColor",
          "label": "Border",
          "valueType": "string"
        },
        {
          "key": "accentColor",
          "label": "Focus ring",
          "valueType": "string"
        },
        {
          "key": "borderRadius",
          "label": "Border radius",
          "valueType": "number"
        },
        {
          "key": "boxShadow",
          "label": "Box shadow",
          "valueType": "string"
        }
      ],
      "events": [
        {
          "id": "onChange",
          "label": "On change"
        },
        {
          "id": "onComplete",
          "label": "On complete"
        }
      ],
      "actions": [
        {
          "handle": "clear",
          "displayName": "Clear"
        },
        {
          "handle": "setValue",
          "displayName": "Set value",
          "params": [
            {
              "handle": "value",
              "displayName": "Value"
            }
          ]
        },
        {
          "handle": "setVisibility",
          "displayName": "Set visibility",
          "params": [
            {
              "handle": "visibility",
              "displayName": "Value",
              "defaultValue": "{{false}}"
            }
          ]
        },
        {
          "handle": "setLoading",
          "displayName": "Set loading",
          "params": [
            {
              "handle": "loading",
              "displayName": "Value",
              "defaultValue": "{{false}}"
            }
          ]
        },
        {
          "handle": "setDisable",
          "displayName": "Set disable",
          "params": [
            {
              "handle": "disable",
              "displayName": "Value",
              "defaultValue": "{{false}}"
            }
          ]
        }
      ],
      "exposedVariables": [
        {
          "name": "label",
          "default": "Verification code"
        },
        {
          "name": "length",
          "default": 6
        },
        {
          "name": "value",
          "default": ""
        },
        {
          "name": "description",
          "default": "Enter the code we sent to your phone."
        },
        {
          "name": "disabled",
          "default": false
        },
        {
          "name": "isComplete",
          "default": false
        },
        {
          "name": "isVisible",
          "default": true
        },
        {
          "name": "isLoading",
          "default": false
        },
        {
          "name": "isDisabled",
          "default": false
        }
      ]
    }
