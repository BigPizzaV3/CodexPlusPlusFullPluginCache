{
  "components": [
    {
      "type": "MultiselectV2",
      "name": "Multiselect",
      "description": "Multiple item selector",
      "defaultSize": {
        "width": 10,
        "height": 40
      },
      "properties": [
        {
          "key": "label",
          "label": "Label",
          "valueType": "string",
          "default": "Select"
        },
        {
          "key": "placeholder",
          "label": "Placeholder",
          "valueType": "string",
          "default": "Select the options"
        },
        {
          "key": "advanced",
          "label": "Dynamic options",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "value",
          "label": "Default value",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number",
            "boolean"
          ],
          "description": "Inspector metadata, not the runtime initial-selection property: static mode reads values (an array). The exposed current selection is also .values, never .value."
        },
        {
          "key": "schema",
          "label": "Schema",
          "default": "{{[ {label: 'option1',value: 1,caption: null,disable: false,visible: true,default: true},{label: 'option2',value: 2,caption: null,disable: false,visible: tru…",
          "description": "Advanced mode (advanced=true) options: initial selection uses entries with visible=true and default=true. Static mode instead reads properties.values. Preserve value types and distinguish selectedOptions objects from exposed values."
        },
        {
          "key": "showAllOption",
          "label": "Enable select all option",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "maxLimit",
          "label": "Max selection limit",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ],
          "default": ""
        },
        {
          "key": "showAllSelectedLabel",
          "label": "Show \"All items are selected\"",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "optionsLoadingState",
          "label": "Options loading state",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "sort",
          "label": "Sort options",
          "valueType": "string",
          "default": "none",
          "allowedValues": [
            "none",
            "asc",
            "desc"
          ]
        },
        {
          "key": "showClearBtn",
          "label": "Show clear selection button",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "showSearchInput",
          "label": "Show search in options",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "serverSideSearch",
          "label": "Search type",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "loadingState",
          "label": "Loading state",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "visibility",
          "label": "Visibility",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "collapseWhenHidden",
          "label": "Collapse when hidden",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "disabledState",
          "label": "Disable",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "tooltipFormat",
          "label": "Tooltip",
          "default": "plainText",
          "allowedValues": [
            "plainText",
            "markdown",
            "html"
          ]
        },
        {
          "key": "tooltip",
          "label": "Tooltip",
          "valueType": "string",
          "default": ""
        },
        {
          "key": "values",
          "default": [
            "1",
            "2"
          ],
          "description": "Static mode (advanced=false) initial selection: an array of option values, matched without type coercion. Option default flags do not initialize static mode. Use [] for intentionally empty selection; do not replace it with fallback defaults."
        },
        {
          "key": "options",
          "default": [
            {
              "label": "option1",
              "value": "1",
              "caption": null,
              "disable": {
                "value": false
              },
              "visible": {
                "value": true
              },
              "default": {
                "value": false
              }
            },
            {
              "label": "option2",
              "value": "2",
              "caption": null,
              "disable": {
                "value": false
              },
              "visible": {
                "value": true
              },
              "default": {
                "value": true
              }
            },
            {
              "label": "option3",
              "value": "3",
              "caption": null,
              "disable": {
                "value": false
              },
              "visible": {
                "value": true
              },
              "default": {
                "value": false
              }
            }
          ]
        }
      ],
      "styles": [
        {
          "key": "labelColor",
          "label": "Color",
          "valueType": "string",
          "default": "var(--cc-primary-text)"
        },
        {
          "key": "labelFontSize",
          "label": "Size",
          "valueType": "number",
          "default": "{{12}}"
        },
        {
          "key": "alignment",
          "label": "Alignment",
          "valueType": "string",
          "default": "side",
          "allowedValues": [
            "side",
            "top"
          ]
        },
        {
          "key": "direction",
          "label": "Direction",
          "valueType": "string",
          "default": "left",
          "allowedValues": [
            "left",
            "right"
          ]
        },
        {
          "key": "auto",
          "label": "Width",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "fieldBackgroundColor",
          "label": "Background",
          "valueType": "string",
          "default": "var(--cc-surface1-surface)"
        },
        {
          "key": "fieldBorderColor",
          "label": "Border",
          "valueType": "string",
          "default": "var(--cc-default-border)"
        },
        {
          "key": "accentColor",
          "label": "Accent",
          "valueType": "string",
          "default": "var(--cc-primary-brand)"
        },
        {
          "key": "selectedTextColor",
          "label": "Text",
          "valueType": "string",
          "default": "var(--cc-primary-text)"
        },
        {
          "key": "errTextColor",
          "label": "Error Text",
          "valueType": "string",
          "default": "var(--cc-error-systemStatus)"
        },
        {
          "key": "icon",
          "label": "Icon",
          "valueType": "string",
          "default": "IconHome2"
        },
        {
          "key": "iconColor",
          "label": "Icon color",
          "valueType": "string",
          "default": "var(--cc-default-icon)"
        },
        {
          "key": "fieldBorderRadius",
          "label": "Border radius",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ],
          "default": "6"
        },
        {
          "key": "boxShadow",
          "label": "Box Shadow",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ],
          "default": "0px 0px 0px 0px #00000040"
        },
        {
          "key": "padding",
          "label": "Padding",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ],
          "default": "default",
          "allowedValues": [
            "default",
            "none"
          ]
        },
        {
          "key": "labelWidth",
          "default": "33"
        },
        {
          "key": "iconVisibility",
          "default": false
        },
        {
          "key": "widthType",
          "default": "ofComponent"
        },
        {
          "key": "cssClass",
          "label": "CSS class",
          "default": ""
        }
      ],
      "events": [
        {
          "id": "onSelect",
          "label": "On select"
        },
        {
          "id": "onSearchTextChanged",
          "label": "On search text changed"
        },
        {
          "id": "onFocus",
          "label": "On focus"
        },
        {
          "id": "onBlur",
          "label": "On blur"
        }
      ],
      "actions": [
        {
          "handle": "selectOptions",
          "displayName": "Select Options",
          "params": [
            {
              "handle": "option",
              "displayName": "Option"
            }
          ]
        },
        {
          "handle": "deselectOptions",
          "displayName": "Deselect Options",
          "params": [
            {
              "handle": "option",
              "displayName": "Option"
            }
          ]
        },
        {
          "handle": "clear",
          "displayName": "Clear"
        },
        {
          "handle": "setVisibility",
          "displayName": "Set visibility",
          "params": [
            {
              "handle": "setVisibility",
              "displayName": "Value",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setLoading",
          "displayName": "Set loading",
          "params": [
            {
              "handle": "setLoading",
              "displayName": "Value",
              "defaultValue": "{{false}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setDisable",
          "displayName": "Set disable",
          "params": [
            {
              "handle": "setDisable",
              "displayName": "Value",
              "defaultValue": "{{false}}",
              "type": "toggle"
            }
          ]
        }
      ],
      "exposedVariables": [
        {
          "name": "searchText",
          "default": ""
        },
        {
          "name": "values",
          "valueType": "array",
          "semantics": "Selected option values, published before onSelect; an empty selection is []. Read components.<name>.values, not the nonexistent .value alias. Static initial selection comes from properties.values; advanced mode uses visible/default schema entries."
        },
        {
          "name": "selectedOptions",
          "valueType": "array",
          "semantics": "Selected option objects projected to { label, value, caption }, published with values. Not .selected and not the scalar DropdownV2 selectedOption."
        },
        {
          "name": "options",
          "valueType": "array",
          "semantics": "Rendered options projected to { label, value, caption }; distinct from the selected values."
        }
      ],
      "renderingHints": {
        "formLabelAlignment": "Use styles.alignment.value=\"top\" in forms, modals, and fields 18 columns or narrower.",
        "compactFormHeight": "Use the harvested defaultSize.height (normally 40px) for a standard single-line field. With a top label it occupies about 60px; use a 70px top-to-top row step for a 10px gap.",
        "valueTextSizing": "Authored height does not enlarge the value text. Only labelFontSize is exposed; oversized fields make the unchanged value text look too small."
      }
    }
  ],
  "unknown_types": []
}
