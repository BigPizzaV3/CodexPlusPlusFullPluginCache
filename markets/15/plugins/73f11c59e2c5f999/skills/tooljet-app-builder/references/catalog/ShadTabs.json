              }
            },
            {
              "id": "t1",
              "title": "Activity",
              "icon": {
                "value": "IconHome2"
              },
              "iconVisibility": {
                "value": false
              },
              "loading": {
                "value": false
              },
              "disable": {
                "value": false
              },
              "visible": {
