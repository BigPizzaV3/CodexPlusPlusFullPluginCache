        {
          "key": "tabItems",
          "default": [
            {
              "id": "t0",
              "title": "Overview",
              "icon": {
                "value": "IconHome2"
              },
              "iconVisibility": {
                "value": false
              },
              "loading": {
                "value": false
              },
              "disable": {
                "value": false
              },
              "visible": {
                "value": true
