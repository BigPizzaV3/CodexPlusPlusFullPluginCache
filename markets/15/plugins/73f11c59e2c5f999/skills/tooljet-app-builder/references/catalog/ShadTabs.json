            {
              "handle": "tabId",
              "displayName": "Tab"
            },
            {
              "handle": "value",
              "displayName": "Value",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setTabVisibility",
          "displayName": "Set tab visibility",
          "params": [
            {
              "handle": "tabId",
              "displayName": "Tab"
            },
            {
              "handle": "value",
              "displayName": "Value",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setVisibility",
          "displayName": "Set visibility",
          "params": [
            {
              "handle": "value",
              "displayName": "Value",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setDisable",
          "displayName": "Set disable",
          "params": [
            {
              "handle": "value",
              "displayName": "Value",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setLoading",
          "displayName": "Set loading",
          "params": [
            {
              "handle": "value",
              "displayName": "Value",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        }
      ],
      "exposedVariables": [
        {
          "name": "isVisible",
          "default": true
        },
        {
          "name": "isLoading",
          "default": false
        },
        {
          "name": "isDisabled",
          "default": false
        },
        {
          "name": "currentTab",
          "default": "t0"
        },
        {
          "name": "currentTabTitle",
          "default": "Overview"
        },
        {
          "name": "currentStepIndex",
          "default": 0
        },
        {
          "name": "isFirstStep",
          "default": true
        },
        {
          "name": "isLastStep",
          "default": false
        }
      ],
      "authoringHints": {
        "tabs": {
          "items": "Author properties.tabItems as [{id:\"t0\", title:\"Profile\"}, {id:\"t1\", title:\"Billing\"}] (ids t0, t1, ...), or set useDynamicOptions \"{{true}}\" and bind tabs to [{id, title}]. The catalog default titles (Overview / Activity / Settings) are placeholders: replace them. defaultTab is a tab id.",
          "content": "Each tab is its own canvas: create its components with parent_ref to the Tabs and slot_name \"tab-<id>\" (tab-t0, tab-t1). A tab without children renders an empty panel.",
          "styles": "variant \"pills\" (the default: a muted pill bar), \"underline\" (a bottom border with an accent indicator) or \"steps\" (a wizard: numbered steps, Back / Next / Finish buttons below, onFinish on the last step; linearSteps keeps steps in order). tabsAlign start | center | stretch. The tab strip is 50px; panels pad 8px; the wizard footer adds 56px. Style colours (accent, tab text, active tab, bar, panel, border, radius, font size) fall back to the theme.",
          "actions": "setTab(id), nextTab, previousTab, setTabDisable / setTabLoading / setTabVisibility (tabId, value), setVisibility, setDisable, setLoading. Exposed: currentTab, currentTabTitle, currentStepIndex, isFirstStep, isLastStep."
        },
        "styles": "Every style falls back to the app theme, so set only what the design needs to blend in (its accent, surfaces, borders and text colours), taking colours from the app theme or brand, never the defaults of another product. Radii and sizes are px. Styles are the way to restyle a pack widget: a cssClass only takes effect with workspace Custom styles, and Tailwind class names the pack does not already use are not compiled, so do not rely on either; for a one-off visual a style cannot express, use an Html component. Bind loadingState to the query's isLoading (each widget draws a skeleton or spinner in its own shape); tooltip shows on hover."
      }
    }
  ],
  "unknown_types": []
}
