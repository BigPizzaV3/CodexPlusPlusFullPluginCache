{
  "components": [
    {
      "type": "ShadTabs",
      "name": "ShadTabs",
      "description": "Tabs: a container with one canvas per tab (parent the tab content with slot_name tab-<id>). Variants: pills (the default), underline, or steps (a wizard with Back/Next/Finish buttons)",
      "defaultSize": {
        "width": 30,
        "height": 360
      },
      "properties": [
        {
          "key": "useDynamicOptions",
          "label": "Dynamic options",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "tabs",
          "label": "Tabs",
          "valueType": "array",
          "default": "{{[{ id: 't0', title: 'Overview' }, { id: 't1', title: 'Activity' }, { id: 't2', title: 'Settings' }]}}"
        },
        {
          "key": "defaultTab",
          "label": "Default tab",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ],
          "default": "t0"
        },
        {
          "key": "variant",
          "label": "Style",
          "valueType": "string",
          "default": "pills",
          "allowedValues": [
            "pills",
            "underline",
            "steps"
          ]
        },
        {
          "key": "tabsAlign",
          "label": "Tab alignment",
          "valueType": "string",
          "default": "start",
          "allowedValues": [
            "start",
            "center",
            "stretch"
          ]
        },
        {
          "key": "hideTabs",
          "label": "Hide tabs",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "renderOnlyActiveTab",
          "label": "Render only active tab",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "scrollToTopOnTabSwitch",
          "label": "Scroll to top on tab switch",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "showStepNav",
          "label": "Wizard: Back and Next buttons",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "nextLabel",
          "label": "Wizard: Next label",
          "valueType": "string",
          "default": "Next"
        },
        {
          "key": "backLabel",
          "label": "Wizard: Back label",
          "valueType": "string",
          "default": "Back"
        },
        {
          "key": "finishLabel",
          "label": "Wizard: Finish label",
          "valueType": "string",
          "default": "Finish"
        },
        {
          "key": "linearSteps",
          "label": "Wizard: steps in order only",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "dynamicHeight",
          "label": "Dynamic height",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "loadingState",
          "label": "Loading state",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "loadingIndicator",
          "label": "Loading look",
          "valueType": "string",
          "default": "spinner",
          "allowedValues": [
            "spinner",
            "skeleton"
          ]
        },
        {
          "key": "visibility",
          "label": "Visibility",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "collapseWhenHidden",
          "label": "Collapse when hidden",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "disabledState",
          "label": "Disable",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "tooltipFormat",
          "label": "Tooltip",
          "default": "plainText",
          "allowedValues": [
            "plainText",
            "markdown",
            "html"
          ]
        },
        {
          "key": "tooltip",
          "label": "Tooltip",
          "valueType": "string",
          "default": ""
