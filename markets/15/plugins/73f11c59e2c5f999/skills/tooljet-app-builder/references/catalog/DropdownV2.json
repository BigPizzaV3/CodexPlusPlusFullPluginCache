{
  "components": [
    {
      "type": "DropdownV2",
      "name": "Dropdown",
      "description": "Single item selector",
      "defaultSize": {
        "width": 10,
        "height": 40
      },
      "properties": [
        {
          "key": "label",
          "label": "Label",
          "valueType": "string",
          "default": "Select"
        },
        {
          "key": "placeholder",
          "label": "Placeholder",
          "valueType": "string",
          "default": "Select an option"
        },
        {
          "key": "advanced",
          "label": "Dynamic options",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "schema",
          "label": "Schema",
          "default": "{{[\t{label: 'option1',value: 1,caption: null,disable: false,visible: true,default: true},{label: 'option2',value: 2,caption: null,disable: false,visible: true},{label: 'option3',value: 3,caption: null,disable: false,visible: true}\t]}}",
          "requires": {
            "advanced": "{{true}}"
          },
          "mutuallyExclusiveWith": [
            "options"
          ]
        },
        {
          "key": "optionsLoadingState",
          "label": "Options loading state",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "sort",
          "label": "Sort options",
          "valueType": "string",
          "default": "none",
          "allowedValues": [
            "none",
            "asc",
            "desc"
          ]
        },
        {
          "key": "showClearBtn",
          "label": "Show clear selection button",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "showSearchInput",
          "label": "Show search in options",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "serverSideSearch",
          "label": "Search type",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "loadingState",
          "label": "Loading state",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "visibility",
          "label": "Visibility",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "collapseWhenHidden",
          "label": "Collapse when hidden",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "disabledState",
          "label": "Disable",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "tooltipFormat",
          "label": "Tooltip",
          "default": "plainText",
          "allowedValues": [
            "plainText",
            "markdown",
            "html"
          ]
        },
        {
          "key": "tooltip",
          "label": "Tooltip",
          "valueType": "string",
          "default": ""
        },
        {
          "key": "options",
          "default": [
            {
              "label": "option1",
              "value": "1",
              "caption": null,
              "disable": {
                "value": false
              },
              "visible": {
                "value": true
              },
              "default": {
                "value": false
              }
            },
            {
              "label": "option2",
              "value": "2",
              "caption": null,
              "disable": {
                "value": false
              },
              "visible": {
                "value": true
              },
              "default": {
                "value": true
              }
            },
            {
              "label": "option3",
              "value": "3",
              "caption": null,
              "disable": {
                "value": false
              },
              "visible": {
                "value": true
              },
              "default": {
                "value": false
              }
            }
          ],
          "requires": {
            "advanced": "{{false}}"
          },
          "mutuallyExclusiveWith": [
            "schema"
          ]
        }
      ],
      "styles": [
        {
          "key": "labelColor",
          "label": "Color",
          "valueType": "string",
          "default": "var(--cc-primary-text)"
        },
        {
          "key": "labelFontSize",
          "label": "Size",
          "valueType": "number",
          "default": "{{12}}"
        },
        {
          "key": "alignment",
          "label": "Alignment",
          "valueType": "string",
          "default": "side",
          "allowedValues": [
            "side",
            "top"
          ]
        },
        {
          "key": "direction",
          "label": "Direction",
          "valueType": "string",
          "default": "left",
          "allowedValues": [
            "left",
            "right"
          ]
        },
        {
          "key": "auto",
          "label": "Width",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "fieldBackgroundColor",
          "label": "Background",
          "valueType": "string",
          "default": "var(--cc-surface1-surface)"
        },
        {
          "key": "fieldBorderColor",
          "label": "Border",
          "valueType": "string",
          "default": "var(--cc-default-border)"
        },
        {
          "key": "accentColor",
          "label": "Accent",
          "valueType": "string",
          "default": "var(--cc-primary-brand)"
        },
        {
          "key": "selectedTextColor",
          "label": "Text",
          "valueType": "string",
          "default": "var(--cc-primary-text)"
        },
        {
          "key": "placeholderTextColor",
          "label": "Placeholder Text",
          "valueType": "string",
          "default": "var(--cc-placeholder-text)"
        },
        {
          "key": "errTextColor",
          "label": "Error text",
          "valueType": "string",
          "default": "var(--cc-error-systemStatus)"
        },
        {
          "key": "icon",
          "label": "Icon",
          "valueType": "string",
          "default": "IconHome2"
        },
        {
          "key": "fieldBorderRadius",
          "label": "Border radius",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ],
          "default": "6"
        },
        {
          "key": "boxShadow",
          "label": "Box shadow",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ],
          "default": "0px 0px 0px 0px #00000040"
        },
        {
          "key": "menuWidthMode",
          "label": "Menu width",
          "valueType": "string",
          "default": "matchField",
          "allowedValues": [
            "matchField",
            "matchContent",
            "custom"
          ]
        },
        {
          "key": "menuCustomWidth",
          "label": "Custom menu width",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ],
          "default": "256"
        },
        {
          "key": "padding",
          "label": "Padding",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ],
          "default": "default",
          "allowedValues": [
            "default",
            "none"
          ]
        },
        {
          "key": "labelWidth",
          "default": "33"
        },
        {
          "key": "iconVisibility",
          "default": false
        },
        {
          "key": "iconColor",
          "default": "var(--cc-default-icon)"
        },
        {
          "key": "widthType",
          "default": "ofComponent"
        },
        {
          "key": "cssClass",
          "label": "CSS class",
          "default": ""
        }
      ],
      "events": [
        {
          "id": "onSelect",
          "label": "On select"
        },
        {
          "id": "onSearchTextChanged",
          "label": "On search text changed"
        },
        {
          "id": "onFocus",
          "label": "On focus"
        },
        {
          "id": "onBlur",
          "label": "On blur"
        }
      ],
      "actions": [
        {
          "handle": "selectOption",
          "displayName": "Select option",
          "params": [
            {
              "handle": "select",
              "displayName": "Select"
            }
          ]
        },
        {
          "handle": "setVisibility",
          "displayName": "Set visibility",
          "params": [
            {
              "handle": "setVisibility",
              "displayName": "Value",
              "defaultValue": "{{true}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "clear",
          "displayName": "Clear"
        },
        {
          "handle": "setLoading",
          "displayName": "Set loading",
          "params": [
            {
              "handle": "setLoading",
              "displayName": "Value",
              "defaultValue": "{{false}}",
              "type": "toggle"
            }
          ]
        },
        {
          "handle": "setDisable",
          "displayName": "Set disable",
          "params": [
            {
              "handle": "setDisable",
              "displayName": "Value",
              "defaultValue": "{{false}}",
              "type": "toggle"
            }
          ]
        }
      ],
      "exposedVariables": [
        {
          "name": "searchText",
          "default": ""
        },
        {
          "name": "label",
          "default": "Select"
        },
        {
          "name": "value"
        },
        {
          "name": "selectedOption"
        },
        {
          "name": "options"
        }
      ],
      "renderingHints": {
        "formLabelAlignment": "Use styles.alignment.value=\"top\" in forms, modals, and fields 18 columns or narrower.",
        "compactFormHeight": "Use the harvested defaultSize.height (normally 40px) for a standard single-line field. With a top label it occupies about 60px; use a 70px top-to-top row step for a 10px gap.",
        "valueTextSizing": "Authored height does not enlarge the value text. Only labelFontSize is exposed; oversized fields make the unchanged value text look too small."
      },
      "authoringHints": {
        "optionModes": {
          "rule": "ToolJet reads schema only when advanced=true; otherwise it silently renders options.",
          "static": {
            "modeProperty": "properties.advanced.value",
            "modeValue": "{{false}}",
            "dataProperty": "properties.options.value"
          },
          "dynamic": {
            "modeProperty": "properties.advanced.value",
            "modeValue": "{{true}}",
            "dataProperty": "properties.schema.value"
          },
          "preselectionRule": "The selected option must have visible=true and default=true."
        }
      }
    }
  ],
  "unknown_types": []
}
