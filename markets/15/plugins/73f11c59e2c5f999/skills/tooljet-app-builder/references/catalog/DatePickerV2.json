{
  "components": [
    {
      "type": "DatePickerV2",
      "name": "DatePicker",
      "description": "Choose date",
      "defaultSize": {
        "width": 10,
        "height": 40
      },
      "properties": [
        {
          "key": "label",
          "label": "Label",
          "valueType": "string",
          "default": "Label"
        },
        {
          "key": "customDateFormat"
        },
        {
          "key": "placeholder",
          "label": "Placeholder",
          "valueType": "string",
          "default": "Select date"
        },
        {
          "key": "defaultValue",
          "label": "Default value",
          "valueType": "string",
          "default": "01/01/2022"
        },
        {
          "key": "showClearBtn",
          "label": "Enable clear button",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "loadingState",
          "label": "Loading state",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "visibility",
          "label": "Visibility",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "collapseWhenHidden",
          "label": "Collapse when hidden",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "disabledState",
          "label": "Disable",
          "valueType": "boolean",
          "default": "{{false}}"
        },
        {
          "key": "tooltipFormat",
          "label": "Tooltip",
          "default": "plainText",
          "allowedValues": [
            "plainText",
            "markdown",
            "html"
          ]
        },
        {
          "key": "tooltip",
          "label": "Tooltip",
          "valueType": "string",
          "default": ""
        },
        {
          "key": "dateFormat",
          "default": "DD/MM/YYYY"
        }
      ],
      "styles": [
        {
          "key": "labelColor",
          "label": "Color",
          "valueType": "string",
          "default": "var(--cc-primary-text)"
        },
        {
          "key": "labelFontSize",
          "label": "Size",
          "valueType": "number",
          "default": "{{12}}"
        },
        {
          "key": "alignment",
          "label": "Alignment",
          "valueType": "string",
          "default": "side",
          "allowedValues": [
            "side",
            "top"
          ]
        },
        {
          "key": "direction",
          "label": "Direction",
          "valueType": "string",
          "default": "left",
          "allowedValues": [
            "left",
            "right"
          ]
        },
        {
          "key": "auto",
          "label": "Width",
          "valueType": "boolean",
          "default": "{{true}}"
        },
        {
          "key": "fieldBackgroundColor",
          "label": "Background",
          "valueType": "string",
          "default": "var(--cc-surface1-surface)"
        },
        {
          "key": "fieldBorderColor",
          "label": "Border",
          "valueType": "string",
          "default": "var(--cc-default-border)"
        },
        {
          "key": "accentColor",
          "label": "Accent",
          "valueType": "string",
          "default": "var(--cc-primary-brand)"
        },
        {
          "key": "selectedTextColor",
          "label": "Text",
          "valueType": "string",
          "default": "var(--cc-primary-text)"
        },
        {
          "key": "errTextColor",
          "label": "Error text",
          "valueType": "string",
          "default": "var(--cc-error-systemStatus)"
        },
        {
          "key": "icon",
          "label": "Icon",
          "valueType": "string",
          "default": "IconCalendarEvent"
        },
        {
          "key": "fieldBorderRadius",
          "label": "Border radius",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ],
          "default": "{{6}}"
        },
        {
          "key": "boxShadow",
          "label": "Box shadow",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ],
          "default": "0px 0px 0px 0px #00000040"
        },
        {
          "key": "padding",
          "label": "Padding",
          "valueType": "union",
          "valueTypes": [
            "string",
            "number"
          ],
          "default": "default",
          "allowedValues": [
            "default",
            "none"
          ]
        },
        {
          "key": "labelWidth",
          "default": "20"
        },
        {
          "key": "iconVisibility",
          "default": true
        },
        {
          "key": "iconDirection",
          "default": "left"
        },
        {
          "key": "iconColor",
          "default": "var(--cc-default-icon)"
        },
        {
          "key": "widthType",
          "default": "ofComponent"
        },
        {
          "key": "cssClass",
          "label": "CSS class",
          "default": ""
        }
