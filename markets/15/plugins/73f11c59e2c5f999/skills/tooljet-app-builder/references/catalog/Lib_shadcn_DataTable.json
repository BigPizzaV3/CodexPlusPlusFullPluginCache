        "width": 28,
        "height": 500
      },
      "properties": [
        {
          "key": "data",
          "label": "Data",
          "valueType": "array",
          "default": "{{[{\"id\":1,\"name\":\"Olivia Martin\",\"email\":\"olivia@example.com\",\"plan\":\"Pro\",\"amount\":1999},{\"id\":2,\"name\":\"Jackson Lee\",\"email\":\"jackson@example.com\",\"plan\":\"Free\",\"amount\":0},{\"id\":3,\"name\":\"Isabella Nguyen\",\"email\":\"isabella@example.com\",\"plan\":\"Team\",\"amount\":4900},{\"id\":4,\"name\":\"William Kim\",\"email\":\"will@example.com\",\"plan\":\"Pro\",\"amount\":1999},{\"id\":5,\"name\":\"Sofia Davis\",\"email\":\"sofia@example.com\",\"plan\":\"Enterprise\",\"amount\":12900},{\"id\":6,\"name\":\"Liam Johnson\",\"email\":\"liam@example.com\",\"plan\":\"Free\",\"amount\":0},{\"id\":7,\"name\":\"Emma Brown\",\"email\":\"emma@example.com\",\"plan\":\"Team\",\"amount\":4900}]}}",
          "description": "Array of row objects, e.g. {{queries.getUsers.data}}."
        },
        {
          "key": "columns",
          "label": "Columns",
          "valueType": "array",
          "default": "{{[{\"key\":\"name\",\"label\":\"Name\"},{\"key\":\"email\",\"label\":\"Email\"},{\"key\":\"plan\",\"label\":\"Plan\"},{\"key\":\"amount\",\"label\":\"Amount\",\"align\":\"right\"}]}}",
