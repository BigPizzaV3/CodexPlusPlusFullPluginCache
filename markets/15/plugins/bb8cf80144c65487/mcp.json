{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "hypro": {
      "type": "streamable-http",
      "url": "https://www.hypro.app/api/mcp/hypro",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "authorizationUrl": "https://www.hypro.app/api/mcp/hypro/oauth/auth",
            "tokenUrl": "https://www.hypro.app/api/mcp/hypro/oauth/token",
            "baseScopes": [
              "hypro:read",
              "hypro:write"
            ],
            "registrationUrl": "https://www.hypro.app/api/mcp/hypro/oauth/register"
          }
        }
      }
    }
  }
}
