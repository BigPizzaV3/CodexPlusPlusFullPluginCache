{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "systemsculpt": {
      "type": "streamable-http",
      "url": "https://systemsculpt.com/mcp/chatgpt",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": { "mode": "cimd" },
            "defaultScopes": ["account:read", "captures:read", "captures:process", "captures:delete", "billing:manage", "account:preferences", "sessions:manage", "offline_access"]
          }
        }
      }
    }
  }
}
