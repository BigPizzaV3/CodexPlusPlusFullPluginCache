{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "codecanvas-research-companion": {
      "type": "streamable-http",
      "url": "https://research.codecanvasgh.tech/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "research-companion-chatgpt",
              "tokenEndpointAuthMethod": "none"
            },
            "authorizationUrl": "https://auth.codecanvasgh.tech/realms/research-companion/protocol/openid-connect/auth",
            "tokenUrl": "https://auth.codecanvasgh.tech/realms/research-companion/protocol/openid-connect/token",
            "baseScopes": [
              "openid",
              "research:use"
            ]
          }
        }
      }
    }
  }
}
