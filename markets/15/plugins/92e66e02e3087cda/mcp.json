{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "wpzoom": {
      "type": "streamable-http",
      "url": "https://mcp.wpzoom.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "authorizationUrl": "https://mcp.wpzoom.com/authorize",
            "tokenUrl": "https://mcp.wpzoom.com/oauth/token",
            "registrationUrl": "https://mcp.wpzoom.com/oauth/register",
            "baseScopes": ["sites:read", "sites:write", "offline_access"]
          }
        }
      }
    }
  }
}
