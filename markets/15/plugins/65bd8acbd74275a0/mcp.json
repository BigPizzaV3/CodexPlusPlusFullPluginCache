{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "prep-desk": {
      "type": "streamable-http",
      "url": "https://prepdesk-mcp-gateway.crypto-dev-solidity.workers.dev/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "cimd"
            },
            "baseScopes": [
              "practice:read",
              "practice:write",
              "content:read",
              "results:read"
            ]
          }
        }
      }
    }
  }
}
