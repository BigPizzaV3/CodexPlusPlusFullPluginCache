{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "mygood-planner": {
      "type": "streamable-http",
      "url": "https://chatgpt.mygood.io/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "mixed",
            "client": {
              "mode": "dcr"
            },
            "resource": "https://chatgpt.mygood.io",
            "baseScopes": [
              "budget.read",
              "budget.write"
            ]
          }
        }
      }
    }
  }
}
