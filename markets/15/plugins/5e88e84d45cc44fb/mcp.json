{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "deltafluency": {
      "type": "streamable-http",
      "url": "https://mcp.deltafluency.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "deltafluency-chatgpt",
              "tokenEndpointAuthMethod": "client_secret_post"
            },
            "authorizationUrl": "https://mcp.deltafluency.com/connect/authorize",
            "tokenUrl": "https://mcp.deltafluency.com/connect/token",
            "baseScopes": ["mcp:read"]
          }
        }
      }
    }
  }
}
