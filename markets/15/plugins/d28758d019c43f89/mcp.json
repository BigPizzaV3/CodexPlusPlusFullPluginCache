{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "infinite-audience": {
      "type": "streamable-http",
      "url": "https://mcp.infiniteaudience.ai/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "resource": "https://mcp.infiniteaudience.ai/mcp",
            "baseScopes": [
              "discovery",
              "openid",
              "email"
            ],
            "oidcEnabled": true
          }
        }
      }
    }
  }
}
