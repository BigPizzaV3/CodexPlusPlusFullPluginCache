{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "algomo": {
      "type": "streamable-http",
      "url": "https://mcp.algomo.com/mcp/v2",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": { "mode": "dcr" },
            "authorizationServerBase": "https://mcp.algomo.com",
            "authorizationUrl": "https://mcp.algomo.com/mcp/authorize",
            "tokenUrl": "https://mcp.algomo.com/mcp/token",
            "registrationUrl": "https://mcp.algomo.com/mcp/register",
            "resource": "https://mcp.algomo.com/mcp/v2",
            "baseScopes": ["mcp:full"]
          }
        }
      }
    }
  }
}
