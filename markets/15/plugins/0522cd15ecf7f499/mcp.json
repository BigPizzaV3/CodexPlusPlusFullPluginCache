{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "version-info": {
      "type": "streamable-http",
      "url": "https://mcp.versioninfoplugin.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "versioninfo-chatgpt-public",
              "tokenEndpointAuthMethod": "none"
            },
            "baseScopes": [
              "inventory:read",
              "connections:write"
            ],
            "defaultScopes": [
              "openid",
              "email",
              "offline_access",
              "inventory:read",
              "connections:write"
            ],
            "oidcEnabled": true,
            "oidcScopesSupported": [
              "openid",
              "email"
            ]
          }
        }
      }
    }
  }
}
