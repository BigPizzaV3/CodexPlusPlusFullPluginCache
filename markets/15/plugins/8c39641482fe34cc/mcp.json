{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "invisit": {
      "type": "streamable-http",
      "url": "https://app.invisit.dev/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": { "mode": "cimd" },
            "defaultScopes": ["mcp:read", "mcp:write", "mcp:manage", "offline_access"]
          }
        }
      }
    }
  }
}
