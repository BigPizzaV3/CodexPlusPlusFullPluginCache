{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "selskabsinfo": {
      "type": "streamable-http",
      "url": "https://mcp.selskabsinfo.dk",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "defaultScopes": ["email", "profile"],
            "oidcEnabled": false
          }
        }
      }
    }
  }
}
