{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "paperzilla": {
      "type": "streamable-http",
      "url": "https://paperzilla.ai/api/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "cimd"
            },
            "baseScopes": [
              "catalog:read",
              "projects:read",
              "markdown:generate",
              "feedback:write",
              "offline_access"
            ],
            "resource": "https://paperzilla.ai/api/mcp"
          }
        }
      }
    }
  }
}
