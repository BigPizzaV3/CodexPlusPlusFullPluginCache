{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "newspass": {
      "type": "streamable-http",
      "url": "https://connect.sitetrail.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": { "mode": "cimd" },
            "baseScopes": ["newspass:read", "newspass:submit", "offline_access"],
            "defaultScopes": ["newspass:read", "newspass:submit", "offline_access"]
          }
        }
      }
    }
  }
}
