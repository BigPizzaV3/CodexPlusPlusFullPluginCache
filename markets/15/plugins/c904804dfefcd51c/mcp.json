{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "codetelemetry-oauth": {
      "type": "streamable-http",
      "url": "https://codetelemetry.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "2389i82n701efe8pgssj67g0b",
              "tokenEndpointAuthMethod": "none"
            },
            "resource": "https://codetelemetry.com/mcp",
            "baseScopes": [
              "https://codetelemetry.com/mcp/codetelemetry.read"
            ],
            "authorizationUrl": "https://auth.codetelemetry.com/oauth2/authorize",
            "tokenUrl": "https://auth.codetelemetry.com/oauth2/token",
            "authorizationServerBase": "https://codetelemetry.com",
            "oidcEnabled": false
          }
        }
      }
    }
  }
}
