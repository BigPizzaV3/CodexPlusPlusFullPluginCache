{
  "openapi": "3.1.0",
  "info": {
    "title": "Lnkk.it AI Integration API",
    "description": "Model Context Protocol and Actions API for Link Management, QR Codes, Smart App Opener, and Analytics.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://www.lnkk.it/api/v1",
      "description": "Lnkk.it Production REST API"
    },
    {
      "url": "https://www.lnkk.it/api/mcp",
      "description": "Lnkk.it MCP Remote Hosted Gateway"
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "lnkk_k1_..."
      }
    }
  },
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/links": {
      "get": {
        "summary": "List user short links",
        "operationId": "listShortLinks",
        "parameters": [
          { "name": "search", "in": "query", "schema": { "type": "string" } },
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 20 } }
        ],
        "responses": {
          "200": { "description": "Paginated list of short links" },
          "401": { "description": "Unauthorized - Missing or invalid API key" },
          "403": { "description": "Forbidden - Paid plan required (Creator Pro, Growth, Plus)" }
        }
      },
      "post": {
        "summary": "Create a new short link",
        "operationId": "createShortLink",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["original_url"],
                "properties": {
                  "original_url": { "type": "string", "format": "uri", "description": "The URL to shorten" },
                  "custom_alias": { "type": "string", "description": "Custom slug" },
                  "title": { "type": "string", "description": "Reference title" },
                  "domain_name": { "type": "string", "description": "Verified custom domain (e.g. links.mybrand.com)" },
                  "app_opener_enabled": { "type": "boolean", "default": true, "description": "Auto-breakout to native mobile app" },
                  "utm_parameters": { "type": "object", "description": "UTM tracking tags" },
                  "password": { "type": "string", "description": "Optional lock passcode" },
                  "expires_at": { "type": "string", "format": "date-time", "description": "Expiration timestamp" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Short link created successfully" },
          "400": { "description": "Validation or security error" },
          "403": { "description": "Upgrade required" }
        }
      }
    },
    "/domains": {
      "get": {
        "summary": "List connected custom domains",
        "operationId": "listCustomDomains",
        "responses": {
          "200": { "description": "List of active verified custom domains" },
          "403": { "description": "Upgrade required" }
        }
      }
    },
    "/analytics/overview": {
      "get": {
        "summary": "Get account click analytics overview",
        "operationId": "getAccountAnalytics",
        "parameters": [
          { "name": "days", "in": "query", "schema": { "type": "integer", "default": 30 } }
        ],
        "responses": {
          "200": { "description": "Aggregate click metrics and top links" }
        }
      }
    }
  }
}
