{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "hagelab": {
      "type": "streamable-http",
      "url": "https://mcp.hagelab.com.br/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "76ee538d4749d5e235ca62370217d8a0",
              "tokenEndpointAuthMethod": "client_secret_post"
            },
            "authorizationUrl": "https://hagelab.com.br/oauth2/authorize",
            "tokenUrl": "https://hagelab.com.br/oauth2/token",
            "baseScopes": ["docs:read", "api:read"]
          }
        }
      }
    }
  }
}
