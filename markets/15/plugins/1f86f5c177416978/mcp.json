{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "exza-remote": {
      "type": "streamable-http",
      "url": "https://remote.exza.de/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "authorizationServerBase": "https://remote.exza.de",
            "resource": "https://remote.exza.de/mcp",
            "baseScopes": [
              "computer:read"
            ]
          }
        }
      }
    }
  }
}
