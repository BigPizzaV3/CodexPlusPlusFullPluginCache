{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "readingtrack": {
      "type": "streamable-http",
      "url": "https://www.readingtrack.com/api/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": { "mode": "provided", "clientId": "readingtrack-chatgpt", "tokenEndpointAuthMethod": "none" },
            "resource": "https://www.readingtrack.com/api/mcp",
            "baseScopes": ["reading:write", "lists:read", "lists:write"]
          }
        }
      }
    }
  }
}
