              "tools_triggered": "search_articles",
              "expected_behavior": "search_articles\ub97c articleType=1, municipalityCode=\"11680\"\uc73c\ub85c \ud638\ucd9c\ud569\ub2c8\ub2e4. \uac15\ub0a8\uad6c \ub2e8\uc704 \uac80\uc0c9 \uacb0\uacfc\ub9cc \uc548\ub0b4\ud558\uace0 \ud2b9\uc815 \ub3d9(\uc608: \uc0bc\uc131\ub3d9)\uc73c\ub85c \uac80\uc0c9\ud588\ub2e4\uace0 \uc8fc\uc7a5\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. \ub9e4\ubb3c \ub9c1\ud06c\ub97c \ud3ec\ud568\ud569\ub2c8\ub2e4."
            },
            {
              "description": "\ud0a4\uc6cc\ub4dc \uc0ac\ubb34\uc2e4 \uac80\uc0c9",
              "prompt": "\uc81c\ubaa9\uc5d0 \uc0ac\ubb34\uc2e4\uc774 \ud3ec\ud568\ub41c \uc784\ub300 \ub9e4\ubb3c\uc744 \ucc3e\uc544\uc918.",
              "tools_triggered": "search_articles",
              "expected_behavior": "search_articles\ub97c keyword=\"\uc0ac\ubb34\uc2e4\"\ub85c \ud638\ucd9c\ud569\ub2c8\ub2e4. \uac80\uc0c9 \uacb0\uacfc\ub97c \ub3c4\uad6c \uc751\ub2f5\uc5d0 \uadfc\uac70\ud574 \ubcf4\uc5ec\uc8fc\uace0 \uc81c\ubaa9 \ubc0f \ub9e4\ubb3c \ub9c1\ud06c\ub97c \ud3ec\ud568\ud558\uba70, \uacb0\uacfc\uac00 \uc5c6\ub2e4\uba74 \uadf8 \uc0ac\uc2e4\uc744 \uc124\uba85\ud569\ub2c8\ub2e4."
            }
          ],
          "negative": [
            {
              "description": "\ub9e4\ubb3c \uc608\uc57d \ub610\ub294 \uacc4\uc57d \uccb4\uacb0 \ubd88\uac00 \u2014 \ub9e4\ubb3c \uac80\uc0c9\ub9cc \uc9c0\uc6d0\ud558\uba70 \uc608\uc57d\u00b7\uacc4\uc57d \uccb4\uacb0 \uae30\ub2a5\uc740 \uc5c6\ub2e4\uace0 \uc124\uba85\ud569\ub2c8\ub2e4. search_articles\ub97c \uc608\uc57d\uc774\ub098 \uacc4\uc57d \uc2e4\ud589 \uc218\ub2e8\uc73c\ub85c \ud638\ucd9c\ud558\uc9c0 \uc54a\uc73c\uba70 \uacc4\uc57d \uc644\ub8cc\ub97c \uc8fc\uc7a5\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4.",
              "prompt": "\uc774 \uc0c1\uac00 \ub9e4\ubb3c\uc744 \uc9c0\uae08 \uc608\uc57d\ud558\uace0 \uc784\ub300\ucc28 \uacc4\uc57d\uae4c\uc9c0 \uccb4\uacb0\ud574 \uc918."
            },
            {
              "description": "\ub9e4\ubb3c \ub4f1\ub85d\u00b7\uc218\uc815 \ubd88\uac00 \u2014 \uc77d\uae30 \uc804\uc6a9 \ub9e4\ubb3c \uac80\uc0c9 \ub3c4\uad6c\ub85c\ub294 \ub4f1\ub85d\u00b7\uc218\uc815\ud560 \uc218 \uc5c6\ub2e4\uace0 \uc124\uba85\ud569\ub2c8\ub2e4. search_articles\ub97c \ub370\uc774\ud130 \ubcc0\uacbd \ubaa9\uc801\uc73c\ub85c \ud638\ucd9c\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4.",
              "prompt": "\ub124\ubaa8\uc5d0 \ub0b4 \uc0c1\uac00 \ub9e4\ubb3c\uc744 \uc0c8\ub85c \ub4f1\ub85d\ud558\uace0 \ubcf4\uc99d\uae08\uc744 2,000\ub9cc \uc6d0\uc73c\ub85c \uc124\uc815\ud574 \uc918."
            },
            {
              "description": "\uc2e4\uc2dc\uac04 \uacb0\uc81c\u00b7\uc1a1\uae08 \ubd88\uac00 \u2014 \uc1a1\uae08 \ubc0f \uacb0\uc81c \uae30\ub2a5\uc744 \uc81c\uacf5\ud558\uc9c0 \uc54a\ub294\ub2e4\uace0 \uc124\uba85\ud569\ub2c8\ub2e4. search_articles\ub97c \uacb0\uc81c \uc2e4\ud589 \uc218\ub2e8\uc73c\ub85c \ud638\ucd9c\ud558\uc9c0 \uc54a\uace0 \uc1a1\uae08\ud588\ub2e4\uace0 \uc8fc\uc7a5\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4.",
              "prompt": "\uc774 \uc0ac\ubb34\uc2e4 \uacc4\uc57d\uae08\uc744 \uc9d1\uc8fc\uc778\uc5d0\uac8c \ubc14\ub85c \uc1a1\uae08\ud574 \uc918."
            }
          ]
        },
        "demo_recording_url": "https://www.youtube.com/watch?v=Zy0GbTCfNAA"
      },
      "publication": {
        "release_notes": "NEMO \ubd80\ub3d9\uc0b0 \ub9e4\ubb3c \uac80\uc0c9 \uc11c\ube44\uc2a4\uc758 \uba85\uce6d\uc744 \uba85\ud655\ud788 \ud558\uace0 \uc0c1\uac00\u00b7\uc0ac\ubb34\uc2e4 \uc784\ub300 \ub9e4\ubb3c \uac80\uc0c9 MCP \uae30\ub2a5\uacfc \uc2ec\uc0ac\uc6a9 \ud14c\uc2a4\ud2b8\ub97c \uc720\uc9c0\ud569\ub2c8\ub2e4."
