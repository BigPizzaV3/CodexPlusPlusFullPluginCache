          "\uac15\ub0a8\uad6c\uc5d0\uc11c \ubcf4\uc99d\uae08 5,000\ub9cc \uc6d0 \uc774\ud558\uc778 \uc0ac\ubb34\uc2e4 \ub9e4\ubb3c\uc744 \ucc3e\uc544\uc918.",
          "\uc11c\uc6b8\ud2b9\ubcc4\uc2dc\uc5d0 \ub4f1\ub85d\ub41c \uc0c1\uac00 \uc784\ub300 \ub9e4\ubb3c \ucc3e\uc544\uc918.",
          "\uac15\ub0a8\uad6c\uc5d0 \ub4f1\ub85d\ub41c \uc0c1\uac00 \ub9e4\ubb3c\uc744 \ucc3e\uc544\uc918.",
          "\uc81c\ubaa9\uc5d0 \uc0ac\ubb34\uc2e4\uc774 \ud3ec\ud568\ub41c \uc784\ub300 \ub9e4\ubb3c\uc744 \ucc3e\uc544\uc918."
        ],
        "test_cases": {
          "positive": [
            {
              "description": "\uac15\ub0a8\uad6c \uc0c1\uac00 \uc6d4\uc138 \ubc0f \ubcf4\uc99d\uae08 \ud544\ud130",
              "prompt": "\uac15\ub0a8\uad6c\uc5d0\uc11c \ubcf4\uc99d\uae08 3,000\ub9cc \uc6d0 \uc774\ud558, \uc6d4\uc138 100\ub9cc \uc6d0 \uc774\ud558 \uc0c1\uac00 \ub9e4\ubb3c \ucc3e\uc544\uc918.",
              "tools_triggered": "search_articles",
              "expected_behavior": "search_articles\ub97c articleType=1, municipalityCode=\"11680\", maxDeposit=3000, maxMonthlyRent=100\uc73c\ub85c \ud638\ucd9c\ud569\ub2c8\ub2e4. \ubc18\ud658\ub41c \uc2e4\uc81c \ub9e4\ubb3c\ub9cc \ubcf4\uc5ec\uc8fc\uace0 \uac01 \ub9e4\ubb3c\uc758 \ubcf4\uc99d\uae08\uc740 3,000\ub9cc \uc6d0 \uc774\ud558, \uc6d4\uc138\ub294 100\ub9cc \uc6d0 \uc774\ud558\uc774\uba70 \uc81c\ubaa9\uacfc \ub9e4\ubb3c \ub9c1\ud06c\ub97c \ud3ec\ud568\ud574\uc57c \ud569\ub2c8\ub2e4."
            },
            {
              "description": "\uac15\ub0a8\uad6c \uc0ac\ubb34\uc2e4 \ubcf4\uc99d\uae08 \ud544\ud130",
              "prompt": "\uac15\ub0a8\uad6c\uc5d0\uc11c \ubcf4\uc99d\uae08 5,000\ub9cc \uc6d0 \uc774\ud558\uc778 \uc0ac\ubb34\uc2e4 \ub9e4\ubb3c\uc744 \ucc3e\uc544\uc918.",
              "tools_triggered": "search_articles",
              "expected_behavior": "search_articles\ub97c articleType=2, municipalityCode=\"11680\", maxDeposit=5000\uc73c\ub85c \ud638\ucd9c\ud569\ub2c8\ub2e4. \ubc18\ud658\ub41c \uc2e4\uc81c \uc0ac\ubb34\uc2e4 \ub9e4\ubb3c\ub9cc \ud45c\uc2dc\ud558\uace0 \ubcf4\uc99d\uae08\uc774 5,000\ub9cc \uc6d0 \uc774\ud558\uc778\uc9c0 \ud655\uc778\ud558\uba70, \uc81c\ubaa9\uacfc \ub9c1\ud06c\ub97c \uc81c\uacf5\ud569\ub2c8\ub2e4."
            },
            {
              "description": "\uc11c\uc6b8\uc2dc \uc804\uccb4 \uc0c1\uac00 \uac80\uc0c9",
              "prompt": "\uc11c\uc6b8\ud2b9\ubcc4\uc2dc\uc5d0 \ub4f1\ub85d\ub41c \uc0c1\uac00 \uc784\ub300 \ub9e4\ubb3c \ucc3e\uc544\uc918.",
              "tools_triggered": "search_articles",
              "expected_behavior": "search_articles\ub97c articleType=1, provinceCode=\"11\"\ub85c \ud638\ucd9c\ud569\ub2c8\ub2e4. \uc2e4\uc81c \ub3c4\uad6c \uacb0\uacfc\uc5d0 \ud3ec\ud568\ub41c \uc11c\uc6b8\uc2dc \uc0c1\uac00 \ub9e4\ubb3c\uc758 \uc81c\ubaa9, \uac00\uaca9 \ubc0f \ub9c1\ud06c\ub97c \uc548\ub0b4\ud558\uba70 \uacb0\uacfc\uac00 \uc5c6\uc73c\uba74 \uc5c6\ub2e4\uace0 \uc54c\ub9bd\ub2c8\ub2e4."
            },
            {
              "description": "\uac15\ub0a8\uad6c \uc0c1\uac00 \uc9c0\uc5ed \uac80\uc0c9",
