{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "mid-wellbeing": {
      "type": "streamable-http",
      "url": "https://midconsulting.io/api/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "mid-chatgpt-public",
              "tokenEndpointAuthMethod": "client_secret_post"
            },
            "authorizationUrl": "https://midconsulting.io/api/midOAuth/auth",
            "tokenUrl": "https://midconsulting.io/api/midOAuth/token",
            "resource": "https://midconsulting.io/api/mcp",
            "baseScopes": [
              "mid:coaching"
            ]
          }
        }
      }
    }
  }
}
