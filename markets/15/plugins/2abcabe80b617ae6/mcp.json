{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "baton-buyer": {
      "type": "streamable-http",
      "url": "https://api.baton.com/mcp/buyer",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "authorizationServerBase": "https://api.baton.com",
            "resource": "https://api.baton.com/mcp/buyer",
            "baseScopes": [
              "buyer:read"
            ],
            "defaultScopes": [
              "buyer:read",
              "buyer:write"
            ]
          }
        }
      }
    }
  }
}
