{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "simple-photo-gallery": {
      "type": "streamable-http",
      "url": "https://app.simple.photo/api/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": [
              "openid",
              "profile",
              "offline_access",
              "galleries:read",
              "assets:read"
            ],
            "defaultScopes": [
              "openid",
              "profile",
              "offline_access",
              "galleries:read",
              "galleries:write",
              "galleries:publish",
              "galleries:access",
              "assets:read",
              "assets:write",
              "assets:delete",
              "ai:run"
            ],
            "oidcEnabled": true,
            "oidcScopesSupported": [
              "openid",
              "profile",
              "email"
            ]
          }
        }
      }
    }
  }
}
