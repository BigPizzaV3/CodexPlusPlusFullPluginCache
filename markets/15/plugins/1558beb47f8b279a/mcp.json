{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "lessonsforge": {
      "type": "streamable-http",
      "url": "https://mcp.lessonsforge.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "cimd"
            },
            "baseScopes": [
              "projects.read",
              "content.read",
              "content.write"
            ]
          }
        }
      }
    }
  }
}
