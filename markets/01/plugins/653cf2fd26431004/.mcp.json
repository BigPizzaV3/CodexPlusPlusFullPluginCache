{
  "mcpServers": {
    "rosalind": {
      "command": "./scripts/launch_rosalind_mcp",
      "args": [
        "./mcp/server.cjs",
        "--stdio"
      ],
      "cwd": ".",
      "env_vars": [
        "CODEX_BROWSER_USE_NODE_PATH",
        "CODEX_CLI_PATH",
        "CODEX_ELECTRON_RESOURCES_PATH",
        "CODEX_MCP_NODE_PATH",
        "ROSALIND_SENTRY_DSN",
        "ROSALIND_SENTRY_ENABLED",
        "XDG_CACHE_HOME"
      ]
    }
  }
}
