{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "auditory": {
      "type": "streamable-http",
      "url": "https://api.auditory.co/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "rhSaBPWpimQtgotq",
              "tokenEndpointAuthMethod": "none"
            },
            "baseScopes": [
              "openid",
              "auditory:calls:read",
              "auditory:transcripts:read"
            ]
          }
        }
      }
    }
  }
}
