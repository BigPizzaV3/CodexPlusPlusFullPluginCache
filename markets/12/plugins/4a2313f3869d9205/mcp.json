{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "logibee": {
      "type": "streamable-http",
      "url": "https://ai.logibee.ai/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "chatgpt-logibee-ai-prod",
              "tokenEndpointAuthMethod": "none"
            },
            "resource": "https://ai.logibee.ai/mcp",
            "baseScopes": [
              "shipments:read",
              "offline_access"
            ]
          }
        }
      }
    }
  }
}
