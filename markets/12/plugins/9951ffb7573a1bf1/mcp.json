{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "lunelink": {
      "type": "streamable-http",
      "url": "https://app.lunelink.com/api/mcp/_handle",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "https://app.lunelink.com/.well-known/chatgpt-oauth-client.json",
              "tokenEndpointAuthMethod": "none"
            }
          }
        }
      }
    }
  }
}
