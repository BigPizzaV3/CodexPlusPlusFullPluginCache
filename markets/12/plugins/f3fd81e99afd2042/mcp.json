{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "osmo": {
      "type": "streamable-http",
      "url": "https://api.getosmo.app/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "cimd"
            },
            "baseScopes": [
              "osmo.help",
              "calls.read",
              "calls.write"
            ],
            "defaultScopes": [
              "osmo.help",
              "calls.read",
              "calls.write"
            ],
            "authorizationUrl": "https://api.getosmo.app/mcp/oauth/authorize",
            "tokenUrl": "https://api.getosmo.app/mcp/oauth/token",
            "registrationUrl": "https://api.getosmo.app/mcp/oauth/register",
            "authorizationServerBase": "https://api.getosmo.app"
          }
        }
      }
    }
  }
}
