{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "gremiox": {
      "type": "streamable-http",
      "url": "https://api.gremiox.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": [
              "gremiox:read",
              "gremiox:write",
              "gremiox:delete",
              "gremiox:send",
              "gremiox:admin"
            ]
          }
        }
      }
    }
  }
}
