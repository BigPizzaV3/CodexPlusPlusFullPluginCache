{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "zrouter": {
      "type": "streamable-http",
      "url": "https://zrouter.si/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": { "mode": "dcr" },
            "resource": "https://zrouter.si/mcp",
            "baseScopes": ["account"]
          }
        }
      }
    }
  }
}
