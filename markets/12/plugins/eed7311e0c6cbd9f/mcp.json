{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "superset": {
      "type": "streamable-http",
      "url": "https://www.supersetapp.com/api/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "mixed",
            "client": {
              "mode": "dcr"
            },
            "registrationUrl": "https://www.supersetapp.com/oauth2/register",
            "baseScopes": [
              "catalog.read",
              "profile.read",
              "workouts.read",
              "workouts.write",
              "health.read",
              "coaching.read",
              "coaching.write"
            ]
          }
        }
      }
    }
  }
}
