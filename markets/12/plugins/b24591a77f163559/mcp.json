{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "solid-commerce-openai": {
      "type": "streamable-http",
      "url": "https://mcp.solidcommerce.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "solidcommerce-openai",
              "tokenEndpointAuthMethod": "client_secret_post"
            },
            "authorizationUrl": "https://auth.takeoffcommerce.com/oauth/authorize",
            "tokenUrl": "https://auth.takeoffcommerce.com/oauth/token",
            "authorizationServerBase": "https://auth.takeoffcommerce.com/",
            "resource": "https://mcp.solidcommerce.com/mcp",
            "baseScopes": [
              "openid",
              "offline_access",
              "orders:orders:read",
              "orders:tracking:read",
              "orders:shipments:read",
              "fulfillment:ship_now:read",
              "catalog:products:read",
              "inventory:warehouses:read",
              "inventory:analytics:read",
              "listings:list_items:read",
              "listings:ebay_queue:read"
            ],
            "defaultScopes": []
          }
        }
      }
    }
  }
}
