{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "pipedrive": {
      "type": "streamable-http",
      "url": "https://mcp.pipedrive.ai/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": [
              "activities:full",
              "admin",
              "base",
              "contact-fields:full",
              "contacts:full",
              "deal-fields:full",
              "deals:full",
              "leads:full",
              "mail-sending:full",
              "mail:full",
              "product-fields:full",
              "products:full",
              "project-fields:full",
              "projects:full",
              "search:read",
              "users:read"
            ]
          }
        }
      }
    }
  }
}
