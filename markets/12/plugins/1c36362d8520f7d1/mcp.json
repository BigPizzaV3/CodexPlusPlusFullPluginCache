{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "weddingflow": {
      "type": "streamable-http",
      "url": "https://api.weddingflow.co.kr/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "weddingflow-chatgpt",
              "tokenEndpointAuthMethod": "client_secret_basic"
            },
            "authorizationUrl": "https://api.weddingflow.co.kr/oauth/authorize",
            "tokenUrl": "https://api.weddingflow.co.kr/oauth/token",
            "resource": "https://api.weddingflow.co.kr/mcp",
            "baseScopes": [
              "weddingflow"
            ]
          }
        }
      }
    }
  }
}
