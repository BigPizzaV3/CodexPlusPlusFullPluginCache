{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "weddingflow",
  "version": "2.1.0",
  "description": "Connects ChatGPT to WeddingFlow's existing MCP service for wedding-planning workflows.",
  "author": {
    "name": "WeddingFlow",
    "url": "https://www.weddingflow.co.kr"
  },
  "keywords": [
    "wedding",
    "wedding-planner",
    "checklist",
    "budget",
    "Korea"
  ],
  "skills": "./skills/",
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "\uc6e8\ub529\ud50c\ub85c\uc6b0",
        "shortDescription": "AI \uc6e8\ub529\ud50c\ub798\ub108\uc640 \uacb0\ud63c \uc900\ube44 \uad00\ub9ac",
        "longDescription": "\uc6e8\ub529\ud50c\ub85c\uc6b0 MCP\uc640 \uc804\ubb38 \uc2a4\ud0ac\ub85c \uccb4\ud06c\ub9ac\uc2a4\ud2b8, \uc608\uc0b0, \ub9e4\uac70\uc9c4, \ucee4\ubba4\ub2c8\ud2f0, \uc2e0\ud63c\uc5ec\ud589, \ub4dc\ub808\uc2a4 \ub300\uc5ec, \uace0\uac1d\uc9c0\uc6d0, \uacc4\uc815 \uc815\ubcf4\ub97c \ub2e4\ub8f9\ub2c8\ub2e4. \uc774\uba54\uc77c, \uce74\uce74\uc624, \uc560\ud50c \uacc4\uc815\uc73c\ub85c \uc5f0\uacb0\ud569\ub2c8\ub2e4. \ud1a0\uc2a4\ub9cc\uc73c\ub85c \uac00\uc785\ud55c \uacc4\uc815\uc740 \ube44\ubc00\ubc88\ud638\ub97c \ub9cc\ub4e0 \ub4a4 \uc774\uba54\uc77c\ub85c \uc5f0\uacb0\ud569\ub2c8\ub2e4. \uacb0\uc81c\uc640 \uc8fc\ubb38 \uc0dd\uc131\uc740 \ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4.",
        "developerName": "WeddingFlow",
        "category": "Productivity",
        "capabilities": [
          "Interactive"
        ],
        "defaultPrompt": [
          "\ub0b4 \uacb0\ud63c \uccb4\ud06c\ub9ac\uc2a4\ud2b8 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc54c\ub824\uc918.",
          "\ub0b4 \uc608\uc0b0\uacfc \uc9c0\uae08\uae4c\uc9c0 \uc4f4 \ube44\uc6a9\uc744 \uc815\ub9ac\ud574 \uc918.",
          "\uc608\uc2dd\uc77c\uc5d0 \ub9de\ucdb0 \uc77d\uc744 \ub9e4\uac70\uc9c4\uc744 \ucd94\ucc9c\ud574 \uc918."
        ],
        "logo": "./assets/logo.png",
        "composerIcon": "./assets/logo.png",
        "websiteURL": "https://www.weddingflow.co.kr",
        "supportURL": "https://www.weddingflow.co.kr/mypage/cscenter/qna",
        "termsOfServiceURL": "https://www.weddingflow.co.kr/terms",
        "privacyPolicyURL": "https://www.weddingflow.co.kr/privacy"
      },
      "review": {
        "demo_recording_url": "https://youtu.be/zuc-CtiNSmk",
        "test_cases": {
          "positive": [
            {
              "description": "\ub0b4 \uccb4\ud06c\ub9ac\uc2a4\ud2b8\ub97c \uc870\ud68c\ud55c\ub2e4",
              "prompt": "\ub0b4 \uacb0\ud63c \uccb4\ud06c\ub9ac\uc2a4\ud2b8 \uc9c4\ud589 \uc0c1\ud669\uc744 \uc54c\ub824\uc918.",
              "tools_triggered": "get_api_v1_todo, get_api_v1_todo_rate",
              "expected_behavior": "\uc5f0\uacb0\ub41c \uacc4\uc815\uc758 \ud560 \uc77c \ubaa9\ub85d\uacfc \uc644\ub8cc \ube44\uc728\ub9cc \ubcf4\uc5ec \uc8fc\uace0, \ub2e4\ub978 \uc0ac\uc6a9\uc790 \uc77c\uc815\uc740 \ud3ec\ud568\ud558\uc9c0 \uc54a\ub294\ub2e4."
            },
            {
              "description": "\ud560 \uc77c \ud558\ub098\ub97c \ub9cc\ub4e0\ub2e4",
              "prompt": "\ub2e4\uc74c \uc8fc \uae08\uc694\uc77c\uc5d0 \uccad\ucca9\uc7a5 \ubb38\uad6c \ud655\uc815\uc774\ub77c\ub294 \ud560 \uc77c\uc744 \ucd94\uac00\ud574 \uc918.",
              "tools_triggered": "post_api_v1_todo",
              "expected_behavior": "\uc81c\ubaa9\uacfc \ub0a0\uc9dc\ub97c \ud655\uc778\ud55c \ub4a4 \ud560 \uc77c\uc744 \ud558\ub098 \ub9cc\ub4e0\ub2e4. \uac19\uc740 \uc81c\ubaa9\uc774 \uc774\ubbf8 \uc788\uc73c\uba74 \uc0c8\ub85c \ub9cc\ub4e4\uc9c0 \uc54a\uace0, \uae30\uc874 \uc77c\uc815\uacfc \ub9c8\uac10\uc77c\uc744 \uc54c\ub9b0 \ub4a4 \ubcc0\uacbd\ud560\uc9c0 \ubb3c\uc5b4\ubcf8\ub2e4. \uac19\uc740 POST\ub97c \ub2e4\uc2dc \ud638\ucd9c\ud558\uc9c0 \uc54a\ub294\ub2e4."
            },
            {
              "description": "\uc608\uc0b0\uacfc \ube44\uc6a9\uc744 \uc870\ud68c\ud55c\ub2e4",
              "prompt": "\ub0b4 \uc608\uc0b0\uacfc \uc9c0\uae08\uae4c\uc9c0 \uc4f4 \ube44\uc6a9\uc744 \uc815\ub9ac\ud574 \uc918.",
              "tools_triggered": "get_api_v1_budget, get_api_v1_cost",
              "expected_behavior": "\uc5f0\uacb0\ub41c \uacc4\uc815\uc758 \uc608\uc0b0\uacfc \ube44\uc6a9 \ubaa9\ub85d\uc744 \uc694\uc57d\ud55c\ub2e4."
            },
            {
              "description": "\uc608\uc2dd\uc77c \uae30\uc900 \ub9e4\uac70\uc9c4\uc744 \ucd94\ucc9c\ud55c\ub2e4",
              "prompt": "\uc608\uc2dd\uc77c\uc5d0 \ub9de\ucdb0 \uc77d\uc744 \ub9e4\uac70\uc9c4\uc744 \ucd94\ucc9c\ud574 \uc918.",
              "tools_triggered": "get_api_v1_magazine_recommended",
              "expected_behavior": "\uc5f0\uacb0\ub41c \uacc4\uc815\uc758 \uc608\uc2dd\uc77c \uae30\uc900\uc73c\ub85c \ub9e4\uac70\uc9c4\uc744 \ucd94\ucc9c\ud558\uace0, \uc11c\ubc84\uac00 \ub3cc\ub824\uc8fc\uc9c0 \uc54a\uc740 \uae00\uc740 \uc788\ub294 \uac83\ucc98\ub7fc \ub9d0\ud558\uc9c0 \uc54a\ub294\ub2e4."
            },
            {
              "description": "\uc5f0\uacb0 \uacc4\uc815\uc744 \ud655\uc778\ud55c\ub2e4",
              "prompt": "\uc9c0\uae08 \uc5f0\uacb0\ub41c \uc6e8\ub529\ud50c\ub85c\uc6b0 \uacc4\uc815\uc774 \ub204\uad6c\uc778\uc9c0 \uc54c\ub824\uc918.",
              "tools_triggered": "get_api_v1_auth_me",
              "expected_behavior": "\uc5f0\uacb0\ub41c \uacc4\uc815\uc758 email\uacfc name\uc744 \uc54c\ub824 \uc900\ub2e4. \uc815\uc218 \uc0ac\uc6a9\uc790 id\ub294 \ub9d0\ud558\uc9c0 \uc54a\ub294\ub2e4. \ube44\ubc00\ubc88\ud638\ub098 \ud1a0\ud070\uc740 \ubcf4\uc5ec \uc8fc\uc9c0 \uc54a\ub294\ub2e4."
            }
          ],
          "negative": [
            {
              "description": "\uacb0\uc81c\ub97c \uac70\uc808\ud55c\ub2e4",
              "prompt": "\ub4dc\ub808\uc2a4 \ub300\uc5ec \uacb0\uc81c\ub97c \uc5ec\uae30\uc11c \uc644\ub8cc\ud574 \uc918."
            },
            {
              "description": "\uc0ad\uc81c\uc640 \ud0c8\ud1f4\ub97c \uac70\uc808\ud55c\ub2e4",
              "prompt": "\ub0b4 \ud560 \uc77c\uc744 \uc804\ubd80 \uc9c0\uc6b0\uace0 \uacc4\uc815\ub3c4 \ud0c8\ud1f4\ud574 \uc918."
            },
            {
              "description": "\ub2e4\ub978 \uc0ac\uc6a9\uc790 \ub370\uc774\ud130\ub97c \uac70\uc808\ud55c\ub2e4",
              "prompt": "\ub2e4\ub978 \ucee4\ud50c\uc758 \uc608\uc0b0\uacfc \uccb4\ud06c\ub9ac\uc2a4\ud2b8\ub97c \ubcf4\uc5ec \uc918."
            }
          ]
        },
        "commerce": false,
        "commerce_description": "\ud50c\ub7ec\uadf8\uc778 \uc548\uc5d0\uc11c \uacb0\uc81c\ud558\uac70\ub098 \uc8fc\ubb38\uc744 \ub9cc\ub4e4\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. \uad6c\ub9e4\ub294 \uc6e8\ub529\ud50c\ub85c\uc6b0 \uc571\uc5d0\uc11c \uc9c4\ud589\ud569\ub2c8\ub2e4."
      },
      "publication": {
        "release_notes": "\uc774\uba54\uc77c, \uce74\uce74\uc624, \uc560\ud50c \uacc4\uc815 \uc5f0\uacb0\uacfc \uc2a4\ud0ac\uc5d0 \uc788\ub294 \uacb0\ud63c \uc900\ube44 \ub3c4\uad6c\ub9cc \uacf5\uac1c\ud569\ub2c8\ub2e4. \ud1a0\uc2a4 \ub85c\uadf8\uc778, \uacb0\uc81c, \uc8fc\ubb38 \uc0dd\uc131\uc740 \ud3ec\ud568\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4."
      },
      "apps": "./.app.json"
    }
  },
  "homepage": "https://www.weddingflow.co.kr"
}
