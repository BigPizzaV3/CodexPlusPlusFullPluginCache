{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "seller-insights": {
      "type": "streamable-http",
      "url": "https://talktodata.navines.com/mcp/seller-insights-openai",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "cimd"
            },
            "baseScopes": [
              "ebay.read",
              "ebay.write"
            ],
            "defaultScopes": [
              "ebay.read",
              "ebay.write"
            ]
          }
        }
      }
    }
  }
}
