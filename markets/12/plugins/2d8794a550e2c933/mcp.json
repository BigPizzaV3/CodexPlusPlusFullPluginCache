{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "AVATALK": {
      "type": "streamable-http",
      "url": "https://avatalk.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "01a06c38-638e-7083-9ea6-81309d5ce4a3",
              "tokenEndpointAuthMethod": "none"
            },
            "defaultScopes": [
              "communication_style.read",
              "writing_samples.read",
              "profile.read",
              "family.read",
              "memories.read"
            ]
          }
        }
      }
    }
  }
}
