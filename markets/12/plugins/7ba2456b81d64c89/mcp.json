{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "3montovano": {
      "type": "streamable-http",
      "url": "https://3montovano.com/api/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "chatgpt-3montovano",
              "tokenEndpointAuthMethod": "none"
            },
            "authorizationUrl": "https://3montovano.com/oauth/authorize",
            "tokenUrl": "https://3montovano.com/api/oauth/token",
            "baseScopes": [
              "read"
            ]
          }
        }
      }
    }
  }
}
