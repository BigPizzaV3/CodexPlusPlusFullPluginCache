{
    "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
    "mcpServers": {
        "file-fast": {
            "type": "streamable-http",
            "url": "https://file.fast/mcp",
            "extensions": {
                "com.openai": {
                    "auth": {
                        "type": "oauth",
                        "client": {
                            "mode": "dcr"
                        },
                        "registrationUrl": "https://file.fast/oauth/register",
                        "authorizationUrl": "https://file.fast/oauth/authorize",
                        "tokenUrl": "https://file.fast/oauth/token",
                        "baseScopes": ["mcp:use"]
                    }
                }
            }
        }
    }
}
