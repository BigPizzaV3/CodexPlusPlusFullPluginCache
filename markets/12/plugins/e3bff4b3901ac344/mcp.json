{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "muserig": {
      "type": "streamable-http",
      "url": "https://muserig.com/mcp/planning",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "resource": "https://muserig.com/mcp/planning",
            "baseScopes": [
              "openid",
              "email",
              "offline_access",
              "muserig:planning:read",
              "muserig:planning:draft"
            ],
            "oidcEnabled": true,
            "oidcConfigurationUrl": "https://muserig.com/api/auth/.well-known/openid-configuration"
          }
        }
      }
    }
  }
}
