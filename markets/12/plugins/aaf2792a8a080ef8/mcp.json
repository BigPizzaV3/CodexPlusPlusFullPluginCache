{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "task-mafia": {
      "type": "streamable-http",
      "url": "https://taskmafia.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": { "mode": "dcr" },
          "baseScopes": ["mcp:tasks", "offline_access"],
          "defaultScopes": [],
          "oidcEnabled": false
          }
        }
      }
    }
  }
}
