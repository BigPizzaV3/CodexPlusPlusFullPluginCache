{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "metadata-cleaner": {
      "type": "streamable-http",
      "url": "https://www.myworkingmemory.ai/api/metadata/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "cimd"
            },
            "authorizationUrl": "https://www.myworkingmemory.ai/api/metadata/oauth/authorize",
            "tokenUrl": "https://www.myworkingmemory.ai/api/metadata/oauth/token",
            "resource": "https://www.myworkingmemory.ai/api/metadata/mcp",
            "baseScopes": ["metadata.inspect", "metadata.clean"]
          }
        }
      }
    }
  }
}
