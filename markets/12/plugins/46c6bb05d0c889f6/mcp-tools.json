    {
      "name": "sagi_consultar",
      "title": "Consulta SQL somente leitura",
      "description": "SQL livre de leitura no banco PostgreSQL do ERP SAGI, executado pela API SAGI (sintaxe PostgreSQL: https://www.postgresql.org/docs/current/sql-select.html): SELECT, CTEs de leitura, JOIN, UNION, subconsultas, agregacoes e todos os filtros de negocio nas areas autorizadas em PERMISSA. Valida estrutura, views e funcoes; bloqueia escrita e segredos. Colunas explicitas, COUNT(*) permitido. Paginacao apos agregacao.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "sql": {
            "type": "string",
            "minLength": 1,
            "maxLength": 30000
          },
          "deslocamento": {
            "default": 0,
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000
          },
          "limite": {
            "default": 100,
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        },
        "required": [
          "sql"
        ]
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false,
        "title": "Consulta SQL somente leitura"
      }
    },
    {
      "name": "sagi_pesagens_compra_mensal",
      "title": "Compras mensais FILIAL2 2026 (referência)",
      "description": "Relatorio de referencia: compras ENTRADA de 2026 da FILIAL2, agrupadas por mes/produto/subcodigo/unidade, com devolucoes assinadas. Usa consulta fixa homologada. Paginado por proximo_deslocamento; o total exige todas as paginas. Limitado a FILIAL2 em 2026.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "deslocamento": {
            "default": 0,
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "multipleOf": 100
          }
        }
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false,
        "title": "Compras mensais FILIAL2 2026 (referência)"
      }
    },
    {
      "name": "sagi_estoque",
      "title": "Estoque físico por produto e filial",
      "description": "Estoque fisico oficial por produto e filial, com preco/custo medio (medioc) e valor (totalc), na data e hora informadas. Usa a mesma fonte da API SAGI buscarProdutos. Sem filiais, retorna todas as filiais, cada uma separada. Por padrao soma todas as unidades de negocio da filial; unidade_negocio (id de unidades_negocio_cadastradas) restringe a uma unidade.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "data": {
            "default": null,
            "description": "AAAA-MM-DD; vazio = hoje",
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "hora": {
            "default": null,
            "description": "HH:MM:SS; vazio = agora",
            "anyOf": [
              {
                "type": "string",
                "pattern": "^([01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d$"
              },
              {
                "type": "null"
              }
            ]
          },
          "filiais": {
            "default": [],
            "maxItems": 30,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(MATRIZ|FILIAL\\d+)$"
            }
          },
          "codpro": {
            "default": null,
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 6
              },
              {
                "type": "null"
              }
            ]
          },
          "subcod": {
            "default": null,
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "S",
                  "F"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "unidade_negocio": {
            "default": null,
            "description": "vazio (padrao) = todas as unidades de negocio somadas; preencha so se o usuario pedir uma unidade especifica",
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9999
              },
              {
                "type": "null"
              }
            ]
          },
          "somente_com_saldo": {
            "default": true,
            "type": "boolean"
          },
          "deslocamento": {
            "default": 0,
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000
          },
          "limite": {
            "default": 100,
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        }
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false,
        "title": "Estoque físico por produto e filial"
      }
    },
    {
      "name": "sagi_pesagens",
      "title": "Pesagens de entrada e saída",
      "description": "Pesagens ENTRADA/SAIDA com todos os 12 filtros documentados, em qualquer periodo e filiais da empresa. Lista ou mes/produto/unidade; preserva devolucoes com sinal. Nao inclui servicos.",
