            "minimum": 1,
            "maximum": 100
          },
          "movimento": {
            "type": "string",
            "enum": [
              "ENTRADA",
              "SAIDA"
            ]
          },
          "filiais": {
            "default": [],
            "maxItems": 50,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(MATRIZ|FILIAL\\d+)$"
            }
          },
          "fornecedor_ou_cliente": {
            "default": null,
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "produto": {
            "default": null,
            "anyOf": [
              {
                "type": "string",
                "maxLength": 30
              },
              {
                "type": "null"
              }
            ]
          },
          "subcodigo": {
