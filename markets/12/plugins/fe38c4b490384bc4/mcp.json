{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "infotech-crm": {
      "type": "streamable-http",
      "url": "https://mcp.infotech-crm.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "cimd"
            },
            "baseScopes": [
              "crm.leads.read",
              "crm.contacts.read",
              "crm.customers.read",
              "crm.deals.read",
              "crm.tickets.read",
              "crm.activities.read",
              "crm.reports.read"
            ]
          }
        }
      }
    }
  }
}
