{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "encoded-brands": {
      "type": "streamable-http",
      "url": "https://encoder.encodedbrands.ai/api/agent/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "mixed",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": ["encoded:brand:author", "encoded:brand:manage"]
          }
        }
      }
    }
  }
}
