{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "kritmatta": {
      "type": "streamable-http",
      "url": "https://app.kritmatta.com/api/chatgpt/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "kritmatta-chatgpt",
              "tokenEndpointAuthMethod": "none"
            },
            "baseScopes": [
              "workspace:read",
              "work:write"
            ]
          }
        }
      }
    }
  }
}
