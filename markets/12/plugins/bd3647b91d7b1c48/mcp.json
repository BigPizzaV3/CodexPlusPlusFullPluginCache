{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "doednemt": {
      "type": "streamable-http",
      "url": "https://doednemt.dk/api/mcp/chatgpt",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "75e000e2-8219-44a3-a86c-4b81f82499be",
              "tokenEndpointAuthMethod": "none"
            },
            "resource": "https://doednemt.dk/api/mcp/chatgpt",
            "baseScopes": ["openid", "email", "offline_access"],
            "defaultScopes": ["openid", "email", "offline_access"],
            "oidcEnabled": true,
            "oidcScopesSupported": ["openid", "email"]
          }
        }
      }
    }
  }
}
