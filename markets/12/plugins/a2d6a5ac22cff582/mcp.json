{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "butler": {
      "type": "streamable-http",
      "url": "https://mybutlerdid.it/mcp/openai-v2",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "registrationUrl": "https://mybutlerdid.it/oauth/register",
            "baseScopes": [
              "butler:access",
              "offline_access"
            ]
          }
        }
      }
    }
  }
}
