{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "kj-admin": {
      "type": "streamable-http",
      "url": "https://mcp.kaojai.ai/admin",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "baseScopes": [
              "https://mcp.kaojai.ai/workspace.read",
              "https://mcp.kaojai.ai/workspace.action",
              "https://mcp.kaojai.ai/workspace.setting"
            ]
          }
        }
      }
    }
  }
}
