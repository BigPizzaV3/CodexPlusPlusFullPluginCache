{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "not-so-dumbbell": {
      "type": "streamable-http",
      "url": "https://notsodumbbell.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "mixed",
            "client": { "mode": "provided", "clientId": "chatgpt-notsodumbbell", "tokenEndpointAuthMethod": "none" },
            "baseScopes": ["training:read"]
          }
        }
      }
    }
  }
}
