{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "influexpert": {
      "type": "streamable-http",
      "url": "https://platform.influexpert.app/api/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": { "mode": "dcr" },
            "baseScopes": ["mcp", "offline_access"]
          }
        }
      }
    }
  }
}
