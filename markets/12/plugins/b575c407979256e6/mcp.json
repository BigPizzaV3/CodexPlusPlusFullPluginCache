{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "brvvo": {
      "type": "streamable-http",
      "url": "https://mcp.brvvo.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "mixed",
            "client": {
              "mode": "dcr"
            },
            "authorizationServerBase": "https://mcp.brvvo.com",
            "authorizationUrl": "https://mcp.brvvo.com/oauth/authorize",
            "tokenUrl": "https://mcp.brvvo.com/oauth/token",
            "registrationUrl": "https://mcp.brvvo.com/oauth/register",
            "resource": "https://mcp.brvvo.com/mcp",
            "baseScopes": [
              "projects.read",
              "builds.write",
              "sites.publish"
            ]
          }
        }
      }
    }
  }
}
