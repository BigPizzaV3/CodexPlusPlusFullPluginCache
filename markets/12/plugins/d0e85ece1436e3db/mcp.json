{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "lacuanta": {
      "type": "streamable-http",
      "url": "https://lacuanta.web.app/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {"mode": "dcr"},
            "registrationUrl": "https://lacuanta.web.app/agent/oauth/register",
            "authorizationUrl": "https://lacuanta.web.app/agent/oauth/authorize",
            "tokenUrl": "https://lacuanta.web.app/agent/oauth/token",
            "baseScopes": ["balances:read", "calendar:read", "weekend:read", "weekend:contribute"]
          }
        }
      }
    }
  }
}
