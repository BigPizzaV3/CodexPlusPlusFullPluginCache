{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "titan": {
      "type": "streamable-http",
      "url": "https://titan-api.foxary.com/mcp",
      "extensions": {"com.openai": {"auth": {
        "type": "oauth",
        "authorizationServerBase": "https://titan-api.foxary.com/api/auth",
        "authorizationUrl": "https://titan-api.foxary.com/api/auth/oauth2/authorize",
        "tokenUrl": "https://titan-api.foxary.com/api/auth/oauth2/token",
        "resource": "https://titan-api.foxary.com/mcp",
        "baseScopes": ["nutrition:read", "nutrition:write", "body:read", "body:write", "workouts:read", "workouts:write", "routines:write", "offline_access"]
      }}}
    }
  }
}
