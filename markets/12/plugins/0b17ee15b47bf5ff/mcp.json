{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "ad-insights": {
      "type": "streamable-http",
      "url": "https://talktodata.navines.com/mcp/ad-insights-openai",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "https://chatgpt.com/oauth/client.json",
              "tokenEndpointAuthMethod": "none"
            },
            "baseScopes": [
              "google_ads.read"
            ],
            "defaultScopes": [
              "google_ads.read",
              "google_ads.write"
            ]
          }
        }
      }
    }
  }
}
