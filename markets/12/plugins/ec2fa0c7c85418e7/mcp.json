{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "invoicepig": {
      "type": "streamable-http",
      "url": "https://www.invoicepig.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": ["profile", "user:org:read", "offline_access"],
            "resource": "https://www.invoicepig.com/mcp"
          }
        }
      }
    }
  }
}
