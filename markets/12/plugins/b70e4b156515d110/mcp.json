{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "citationlab-manager": {
      "type": "streamable-http",
      "url": "https://manager.citationlab.ai/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "citationlab-chatgpt-plugin",
              "tokenEndpointAuthMethod": "none"
            },
            "baseScopes": ["read", "write", "offline_access"]
          }
        }
      }
    }
  }
}
