{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "huechat": {
      "type": "streamable-http",
      "url": "https://app.huechat.ai/v2/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": [
              "mcp:use"
            ],
            "defaultScopes": [
              "account:read",
              "agents:read",
              "ai_agents:read",
              "reports:read",
              "inboxes:read",
              "conversations:read",
              "messages:read",
              "contacts:read",
              "labels:read",
              "lists:read",
              "custom_fields:read",
              "templates:read",
              "broadcasts:read",
              "tickets:read",
              "deals:read",
              "products:read",
              "appointments:read",
              "conversations:write",
              "contacts:write",
              "labels:write",
              "lists:write",
              "custom_fields:write",
              "templates:write",
              "tickets:write",
              "deals:write",
              "broadcasts:write",
              "appointments:write",
              "messages:send",
              "templates:send",
              "broadcasts:send"
            ]
          }
        }
      }
    }
  }
}
