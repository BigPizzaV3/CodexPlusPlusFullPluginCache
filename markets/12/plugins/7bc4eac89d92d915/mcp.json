{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "wavelocus": {
      "type": "streamable-http",
      "url": "https://assistant.wavelocus.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": { "mode": "cimd" },
            "defaultScopes": ["investigation:read"]
          }
        }
      }
    }
  }
}
