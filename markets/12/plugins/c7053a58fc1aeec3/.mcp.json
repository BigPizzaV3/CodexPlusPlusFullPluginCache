{
  "mcpServers": {
    "fantaclub": {
      "url": "https://www.fantaclub.it/servlet/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "defaultScopes": [
              "mcp:read",
              "offline_access"
            ]
          }
        }
      }
    }
  }
}
