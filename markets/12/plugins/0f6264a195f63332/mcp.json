{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "ruliad": {
      "type": "streamable-http",
      "url": "https://api.theruliad.ai/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "resource": "https://api.theruliad.ai/mcp",
            "baseScopes": [
              "connection:read",
              "projects:read",
              "projects:write",
              "production:write",
              "exports:write"
            ],
            "defaultScopes": [
              "connection:read",
              "projects:read",
              "projects:write",
              "production:write",
              "exports:write"
            ]
          }
        }
      }
    }
  }
}
