{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "hyperia": {
      "type": "streamable-http",
      "url": "https://platform.hyperhia.com/mcp/hyperia",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "hyperia-chatgpt",
              "tokenEndpointAuthMethod": "client_secret_basic"
            },
            "baseScopes": [
              "hyperia.read"
            ],
            "defaultScopes": [
              "threads.read",
              "threads.write",
              "threads.publish",
              "mail",
              "knowledge.read",
              "tasks.read"
            ]
          }
        }
      }
    }
  }
}
