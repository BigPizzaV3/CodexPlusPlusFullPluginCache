{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "gyroscope": {
      "type": "streamable-http",
      "url": "https://mcp.gyrosco.pe/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "https://chatgpt.com/oauth/client.json",
              "tokenEndpointAuthMethod": "none"
            },
            "defaultScopes": [
              "profile.read",
              "health.summary.read",
              "nutrition.read",
              "activity.read",
              "nutrition.write",
              "activity.write"
            ]
          }
        }
      }
    }
  }
}
