{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "prot0": {
      "type": "streamable-http",
      "url": "https://prot0.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "authorizationUrl": "https://prot0.com/oauth/authorize",
            "tokenUrl": "https://prot0.com/oauth/token",
            "registrationUrl": "https://prot0.com/oauth/register",
            "authorizationServerBase": "https://prot0.com",
            "resource": "https://prot0.com/mcp",
            "baseScopes": [
              "workspaces:read",
              "workspaces:write",
              "members:read",
              "members:write",
              "projects:read",
              "projects:write",
              "data:read",
              "data:write"
            ]
          }
        }
      }
    }
  }
}
