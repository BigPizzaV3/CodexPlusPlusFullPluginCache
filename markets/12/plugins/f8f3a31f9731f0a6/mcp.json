{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "entrust-ai-apex": {
      "type": "streamable-http",
      "url": "https://apex.entrustai.co/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "chatgpt-apex-live",
              "tokenEndpointAuthMethod": "client_secret_post"
            },
            "authorizationUrl": "https://apex.entrustai.co/oauth/authorize",
            "tokenUrl": "https://apex.entrustai.co/oauth/token"
          }
        }
      }
    }
  }
}