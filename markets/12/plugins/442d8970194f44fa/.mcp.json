{
  "mcpServers": {
    "agentplace": {
      "type": "streamable-http",
      "url": "https://api.agentplace.io/mcp/authoring",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": [
              "authoring:read",
              "openid",
              "email"
            ],
            "authorizationUrl": "https://api.agentplace.io/mcp/authoring/oauth/authorize",
            "tokenUrl": "https://api.agentplace.io/mcp/authoring/oauth/token",
            "registrationUrl": "https://api.agentplace.io/mcp/authoring/oauth/register"
          }
        }
      }
    }
  }
}
