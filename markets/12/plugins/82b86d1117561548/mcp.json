{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "persprotect": {
      "type": "streamable-http",
      "url": "https://persprotect.com/api/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "mixed",
            "client": {
              "mode": "provided",
              "clientId": "persprotect-openai-public",
              "tokenEndpointAuthMethod": "none"
            },
            "authorizationServerBase": "https://persprotect.com",
            "authorizationUrl": "https://persprotect.com/api/plugin/oauth/auth",
            "tokenUrl": "https://persprotect.com/api/plugin/oauth/token",
            "resource": "https://persprotect.com/api/mcp"
          }
        }
      }
    }
  }
}
