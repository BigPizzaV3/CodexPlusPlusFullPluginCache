{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "dnd-srd-oracle": {
      "type": "streamable-http",
      "url": "https://dnd-oracle.apps.loskutoff.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "mixed",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": [
              "openid",
              "email"
            ],
            "defaultScopes": [
              "play-sessions"
            ],
            "oidcEnabled": true
          }
        }
      }
    }
  }
}
