{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "sirius": {
      "type": "streamable-http",
      "url": "https://sirius-mcp-production.up.railway.app/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "buscaia-sirius-plugin",
              "tokenEndpointAuthMethod": "client_secret_basic"
            },
            "authorizationUrl": "https://sirius-backend-production.up.railway.app/oauth/authorize",
            "tokenUrl": "https://sirius-backend-production.up.railway.app/oauth/token",
            "authorizationServerBase": "https://sirius-backend-production.up.railway.app",
            "resource": "https://sirius-mcp-production.up.railway.app",
            "baseScopes": [
              "buscagpt.access",
              "product:siriusrisk"
            ]
          }
        }
      }
    }
  }
}
