{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "evenda": {
      "type": "streamable-http",
      "url": "https://evenda.io/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": [
              "workspace:read",
              "events:read"
            ],
            "defaultScopes": [
              "analytics:read",
              "catalog:manage",
              "catalog:read",
              "customers:read",
              "events:manage",
              "events:publish",
              "events:read",
              "events:write",
              "finance:read",
              "forms:manage",
              "marketing:manage",
              "marketing:read",
              "notifications:manage",
              "notifications:read",
              "orders:read",
              "reviews:manage",
              "reviews:read",
              "sales:read",
              "settings:manage",
              "settings:read",
              "support:manage",
              "support:read",
              "team:manage",
              "team:read",
              "tickets:issue_paid",
              "tickets:send",
              "workspace:read"
            ]
          }
        }
      }
    }
  }
}
