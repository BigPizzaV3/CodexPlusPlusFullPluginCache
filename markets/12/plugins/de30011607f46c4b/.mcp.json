{
  "mcpServers": {
    "user-intuition": {
      "url": "https://mcp.userintuition.ai/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": [
              "openid",
              "email",
              "read",
              "write",
              "panel:launch",
              "rewards:send"
            ]
          }
        }
      }
    }
  }
}
