{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "vaultivo": {
      "type": "streamable-http",
      "url": "https://app.vaultivo.at/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": ["mcp:use"]
          }
        }
      }
    }
  }
}
