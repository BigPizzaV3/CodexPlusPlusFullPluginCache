{
  "mcpServers": {
    "tickertrac": {
      "url": "https://api.tickertrac.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "registrationUrl": "https://api.tickertrac.com/mcp-oauth/register",
            "authorizationUrl": "https://api.tickertrac.com/mcp-oauth/authorize",
            "tokenUrl": "https://api.tickertrac.com/mcp-oauth/token",
            "baseScopes": [
              "read"
            ]
          }
        }
      }
    }
  }
}
