{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "relayplay": {
      "type": "streamable-http",
      "url": "https://api.relayplay.app/chatgpt/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "mixed",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": [
              "relayplay:prepare",
              "relayplay:confirm",
              "relayplay:link"
            ],
            "authorizationUrl": "https://api.relayplay.app/chatgpt/authorize",
            "tokenUrl": "https://api.relayplay.app/chatgpt/token",
            "registrationUrl": "https://api.relayplay.app/chatgpt/register"
          }
        }
      }
    }
  }
}
