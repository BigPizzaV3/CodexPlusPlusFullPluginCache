{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "webste": {
      "type": "streamable-http",
      "url": "https://webste-mcp.hachari88.workers.dev/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "authorizationUrl": "https://webste-plugins.jp.auth0.com/authorize",
            "tokenUrl": "https://webste-plugins.jp.auth0.com/oauth/token",
            "registrationUrl": "https://webste-plugins.jp.auth0.com/oidc/register",
            "authorizationServerBase": "https://webste-plugins.jp.auth0.com/",
            "resource": "https://webste-mcp.hachari88.workers.dev",
            "baseScopes": [
              "use:mcp"
            ]
          }
        }
      }
    }
  }
}