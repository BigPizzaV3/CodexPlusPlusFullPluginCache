{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "veora": {
      "type": "streamable-http",
      "url": "https://connect-dev.veora.io/mcp/veorik",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "veora-chatgpt-dev",
              "tokenEndpointAuthMethod": "none"
            },
            "baseScopes": [
              "tasks:read",
              "tasks:create",
              "tasks:cancel",
              "events:subscribe"
            ]
          }
        }
      }
    }
  }
}
