{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "spensa": {
      "type": "streamable-http",
      "url": "https://www.spensa.ai/api/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "IACIPvgpzHOzvJFAxSzYjNehvHMKvZWT",
              "tokenEndpointAuthMethod": "client_secret_post"
            },
            "baseScopes": [
              "offline_access"
            ],
            "oidcEnabled": false,
            "authorizationUrl": "https://www.spensa.ai/api/auth/oauth2/authorize",
            "tokenUrl": "https://www.spensa.ai/api/auth/oauth2/token"
          }
        }
      }
    }
  }
}
