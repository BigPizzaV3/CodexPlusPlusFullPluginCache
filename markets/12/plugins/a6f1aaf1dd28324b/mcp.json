{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "store-manager": {
      "type": "streamable-http",
      "url": "https://api.addsynapse.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": [
              "ops:read",
              "ops:write",
              "offline_access"
            ]
          }
        }
      }
    }
  }
}
