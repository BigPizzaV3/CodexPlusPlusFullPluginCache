{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "medical-supervision": {
      "type": "streamable-http",
      "url": "https://members.ainstans.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "https://chatgpt.com/oauth/client.json",
              "tokenEndpointAuthMethod": "none"
            },
            "authorizationUrl": "https://members.ainstans.com/oauth/authorize",
            "tokenUrl": "https://members.ainstans.com/oauth/token",
            "resource": "https://members.ainstans.com/mcp",
            "baseScopes": [
              "medical:supervise"
            ]
          }
        }
      }
    }
  }
}
