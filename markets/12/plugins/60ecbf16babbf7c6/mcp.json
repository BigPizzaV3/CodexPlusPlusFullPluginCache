{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "arivustudio": {
      "type": "streamable-http",
      "url": "https://api.arivulabs.ai/mcp/studio",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "https://chatgpt.com/oauth/client.json",
              "tokenEndpointAuthMethod": "none"
            },
            "authorizationUrl": "https://api.arivulabs.ai/oauth/authorize",
            "tokenUrl": "https://api.arivulabs.ai/oauth/token"
          }
        }
      }
    }
  }
}
