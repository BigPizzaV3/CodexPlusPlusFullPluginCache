{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "supmartech-meta-ads-interest-finder": {
      "type": "streamable-http",
      "url": "https://supmartech.com/meta-interest-finder/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": ["interest:read", "offline_access"]
          }
        }
      }
    }
  }
}
