{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "refinery": {
      "type": "streamable-http",
      "url": "https://app.textql.com/refinery-mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "783b4570-6d54-4ebb-9843-6105cc1a9dbc",
              "tokenEndpointAuthMethod": "client_secret_post"
            },
            "baseScopes": [
              "mcp:tools",
              "api:read",
              "api:write",
              "action:execute",
              "action:write",
              "agent:read",
              "agent:write",
              "api_access_key:read",
              "chat:read",
              "chat:write",
              "connector:raw_sql",
              "connector:read",
              "connector:write",
              "context:read",
              "context:write",
              "context_policy:read",
              "context_policy:write",
              "dashboard:read",
              "dashboard:write",
              "dataset:read",
              "dataset:write",
              "design_system:write",
              "feed:read",
              "feed:write",
              "mcp:read",
              "mcp:write",
              "observability:read",
              "observability:write",
              "ontology:read",
              "ontology:write",
              "pipeline:read",
              "pipeline:write",
              "playbook:read",
              "playbook:write",
              "sandbox:read",
              "sandbox:write",
              "template:read",
              "template:write",
              "usage:read",
              "workflow:read",
              "workflow:write"
            ]
          }
        }
      }
    }
  }
}