{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "riffcade",
  "version": "1.0.1",
  "description": "RIFFCADE: an arcade of open-source browser games you can play right in the chat.",
  "author": {
    "name": "Albert D Matalon, LLC",
    "url": "https://riffcade.com"
  },
  "homepage": "https://riffcade.com",
  "keywords": [
    "games",
    "arcade",
    "browser games",
    "open source"
  ],
  "extensions": {
    "com.openai": {
      "onboardingSkill": "./skills/get-started/SKILL.md",
      "interface": {
        "displayName": "RIFFCADE",
        "shortDescription": "Arcade of browser games",
        "longDescription": "RIFFCADE is an arcade of open-source browser games you can play right inside ChatGPT. No sign-in, no downloads.\n\nWith RIFFCADE in ChatGPT you can:\n- Open the arcade and browse the games\n- Play any game right in the chat\n- Discover newly added games\n- Rate the games you play",
        "developerName": "Albert D Matalon, LLC",
        "category": "Entertainment",
        "capabilities": [
          "Browse games",
          "Play games",
          "Discover new games",
          "Rate games"
        ],
        "websiteURL": "https://riffcade.com",
        "supportURL": "https://riffcade.com/arcade/support.html",
        "privacyPolicyURL": "https://riffcade.com/arcade/privacy.html",
        "termsOfServiceURL": "https://riffcade.com/arcade/terms.html",
        "defaultPrompt": [
          "Open RIFFCADE and show me the games.",
          "Let's play a quick game on RIFFCADE.",
          "What's new on RIFFCADE?"
        ],
        "brandColor": "#7C3AED",
        "composerIcon": "./assets/icon.png",
        "logo": "./assets/logo.png"
      },
      "apps": "./.app.json"
    }
  }
}
