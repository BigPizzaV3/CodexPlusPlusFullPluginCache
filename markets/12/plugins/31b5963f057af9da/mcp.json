{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "orderlyai": {
      "type": "streamable-http",
      "url": "https://api.withorderly.com/mcp/v2",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "mixed",
            "client": {
              "mode": "dcr"
            },
            "resource": "https://api.withorderly.com/mcp/v2",
            "defaultScopes": [
              "read",
              "write"
            ]
          }
        }
      }
    }
  }
}