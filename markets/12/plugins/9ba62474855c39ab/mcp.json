{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "mitsa-mail": {
      "type": "streamable-http",
      "url": "https://mitsa.email/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "authorizationServerBase": "https://mitsa.email",
            "registrationUrl": "https://mitsa.email/oauth/register",
            "resource": "https://mitsa.email/mcp",
            "baseScopes": [
              "mail.read",
              "mail.draft",
              "mail.send",
              "mail.modify",
              "contacts.read",
              "contacts.write",
              "calendar.read",
              "calendar.write",
              "reminders.read",
              "reminders.write"
            ],
            "defaultScopes": [
              "mail.read",
              "mail.draft",
              "mail.send",
              "mail.modify",
              "contacts.read",
              "contacts.write",
              "calendar.read",
              "calendar.write",
              "reminders.read",
              "reminders.write"
            ]
          }
        }
      }
    }
  }
}
