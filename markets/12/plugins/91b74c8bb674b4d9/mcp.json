{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "prebit": {
      "type": "streamable-http",
      "url": "https://mcp.prebit.in/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "prebit-chatgpt",
              "tokenEndpointAuthMethod": "none"
            },
            "authorizationUrl": "https://admin.prebit.in/api/mcp-oauth/authorize",
            "tokenUrl": "https://admin.prebit.in/api/mcp-oauth/token",
            "resource": "https://mcp.prebit.in/mcp",
            "baseScopes": [
              "prebit:read",
              "prebit:write",
              "prebit:theme",
              "offline_access"
            ]
          }
        }
      }
    }
  }
}
