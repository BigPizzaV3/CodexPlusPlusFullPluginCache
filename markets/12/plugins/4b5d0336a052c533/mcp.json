{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "mynawoo-mystery": {
      "type": "streamable-http",
      "url": "https://api.mynawoo.com/mystery-mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": [
              "mystery:play"
            ],
            "defaultScopes": [
              "mystery:play"
            ],
            "oidcEnabled": false
          }
        }
      }
    }
  }
}
