{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "vokolla": {
      "type": "streamable-http",
      "url": "https://vokolla.com/api/mcp/editorial",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "resource": "https://vokolla.com/api/mcp",
            "baseScopes": [
              "ai:write",
              "drafts:write",
              "releases:read"
            ]
          }
        }
      }
    }
  }
}
