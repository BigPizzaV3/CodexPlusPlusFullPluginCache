{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "weavo-supplier": {
      "type": "streamable-http",
      "url": "https://mcp.weavo.net/mcp/supplier",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "weavo-chatgpt",
              "tokenEndpointAuthMethod": "none"
            },
            "baseScopes": [
              "mcp",
              "offline_access"
            ]
          }
        }
      }
    }
  }
}
