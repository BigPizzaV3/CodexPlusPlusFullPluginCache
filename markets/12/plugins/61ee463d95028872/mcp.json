{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "easy-gogo": {
      "type": "streamable-http",
      "url": "https://www.easy-gogo.com/api/plugin/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": { "mode": "dcr" },
            "resource": "https://www.easy-gogo.com/api/plugin/mcp",
            "baseScopes": ["brand:read", "brand:write", "content:run", "brand:sync", "content:write", "social:publish"]
          }
        }
      }
    }
  }
}
