{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "plugpup-qr",
  "version": "1.0.2",
  "description": "Make scannable QR codes for links, text, Wi-Fi logins and contact cards (vCard), plus EAN-13, UPC-A and Code 128 barcodes. Pick colors, then download a high-resolution PNG. Barcode check digits are validated or added automatically.",
  "author": {
    "name": "Abdessamad Chokri",
    "email": "support@plugpup.com",
    "url": "https://plugpup.com"
  },
  "homepage": "https://plugpup.com",
  "extensions": {
    "com.openai": {
      "auth": {
        "type": "none"
      },
      "interface": {
        "displayName": "PlugPup QR & Barcode Generator",
        "shortDescription": "QR codes & barcodes as PNG",
        "longDescription": "Make scannable QR codes for links, text, Wi-Fi logins and contact cards (vCard), plus EAN-13, UPC-A and Code 128 barcodes. Pick colors, then download a high-resolution PNG. Barcode check digits are validated or added automatically.",
        "developerName": "Abdessamad Chokri",
        "category": "Productivity",
        "capabilities": [
          "QR codes",
          "EAN-13, UPC-A, Code 128 barcodes"
        ],
        "websiteURL": "https://plugpup.com",
        "supportURL": "https://plugpup.com/support.html",
        "privacyPolicyURL": "https://plugpup.com/privacy.html",
        "termsOfServiceURL": "https://plugpup.com/terms.html",
        "defaultPrompt": [
          "QR code for https://example.com",
          "Wi-Fi QR code for network CafeGuest password latte123",
          "UPC barcode for 03600029145"
        ],
        "brandColor": "#EA580C",
        "brandColorDark": "#FB923C",
        "composerIcon": "./assets/icon.png",
        "logo": "./assets/icon.png"
      },
      "review": {
        "test_cases": {
          "positive": [
            {
              "description": "QR image + Download PNG",
              "prompt": "Make a QR code for https://example.com",
              "tools_triggered": "make_qr",
              "expected_behavior": "QR image + Download PNG."
            },
            {
              "description": "QR encoding WIFI:T:WPA",
              "prompt": "Wi-Fi QR for network Home, password hunter22",
              "tools_triggered": "make_qr",
              "expected_behavior": "QR encoding WIFI:T:WPA;S:Home;P:hunter22;;"
            },
            {
              "description": "vCard QR",
              "prompt": "QR code contact card for Ada Lovelace, ada@example.com",
              "tools_triggered": "make_qr",
              "expected_behavior": "vCard QR."
            },
            {
              "description": "barcode 4006381333931 (check digit added)",
              "prompt": "EAN-13 barcode for 400638133393",
              "tools_triggered": "make_barcode",
              "expected_behavior": "barcode 4006381333931 (check digit added)."
            },
            {
              "description": "colored QR",
              "prompt": "Navy blue QR code (#1e3a8a) for my menu link https://menu.example.com",
              "tools_triggered": "make_qr",
              "expected_behavior": "colored QR."
            }
          ],
          "negative": [
            {
              "description": "Out of scope 1",
              "prompt": "Translate hello into French"
            },
            {
              "description": "Out of scope 2",
              "prompt": "What is a QR code invented for?"
            },
            {
              "description": "Out of scope 3",
              "prompt": "Scan this receipt and total it"
            }
          ]
        },
        "demo_recording_url": "https://plugpup.com/demo/qr.mp4",
        "commerce": false
      },
      "publication": {
        "release_notes": "v1.0.2 \u2014 Privacy policy now lists every tool input and output, purposes, recipients, retention and user controls. QR (URL, text, Wi-Fi, vCard) and EAN-13/UPC-A/Code 128 barcodes with PNG download."
      },
      "apps": "./.app.json"
    }
  }
}
