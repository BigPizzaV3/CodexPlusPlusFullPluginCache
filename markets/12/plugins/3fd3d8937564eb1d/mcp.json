{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "firmenatlas": {
      "type": "streamable-http",
      "url": "https://api.firmenatlas.com/mcp/apps",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "baseScopes": [
              "companies.read",
              "people.read",
              "analytics.read",
              "lists.write",
              "offline_access"
            ],
            "defaultScopes": [
              "companies.read",
              "people.read",
              "analytics.read",
              "lists.write",
              "offline_access"
            ],
            "client": {
              "mode": "dcr"
            }
          }
        }
      }
    }
  }
}
