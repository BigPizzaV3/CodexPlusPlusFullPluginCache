{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "acikmutfak": {
      "type": "streamable-http",
      "url": "https://acikmutfak.vercel.app/api/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "mixed",
            "client": {
              "mode": "provided",
              "clientId": "chatgpt-connector",
              "tokenEndpointAuthMethod": "none"
            },
            "resource": "https://acikmutfak.vercel.app/api/mcp",
            "baseScopes": [
              "recipes:publish",
              "offline_access"
            ]
          }
        }
      }
    }
  }
}
