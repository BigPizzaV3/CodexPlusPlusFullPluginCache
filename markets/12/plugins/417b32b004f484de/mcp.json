{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "humanstoknow": {
      "type": "streamable-http",
      "url": "https://www.humanstoknow.com/api/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": ["mcp:read", "drafts:write", "skills:publish", "votes:write", "comments:write"],
            "defaultScopes": ["openid", "email", "offline_access"]
          }
        }
      }
    }
  }
}
