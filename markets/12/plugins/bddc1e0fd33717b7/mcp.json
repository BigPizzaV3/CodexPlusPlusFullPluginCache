{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "vubli": {
      "type": "streamable-http",
      "url": "https://vubli-backend-api-s5x7myqvca-uc.a.run.app/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": [
              "vubli:read"
            ],
            "defaultScopes": [
              "vubli:write",
              "vubli:publish"
            ]
          }
        }
      }
    }
  }
}
