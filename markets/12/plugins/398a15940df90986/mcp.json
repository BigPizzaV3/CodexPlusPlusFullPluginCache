{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "reportaste": {
      "type": "streamable-http",
      "url": "https://mcp.reportaste.it/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": { "mode": "dcr" },
            "defaultScopes": ["catalogo:read", "analisi:read", "gestionale:read"]
          }
        }
      }
    }
  }
}
