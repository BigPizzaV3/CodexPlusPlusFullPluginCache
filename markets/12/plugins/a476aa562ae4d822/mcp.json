{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "unsecat": {
      "type": "streamable-http",
      "url": "https://unsecat.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {"mode": "dcr"},
            "baseScopes": ["calculation:read", "classics:read"]
          }
        }
      }
    }
  }
}
