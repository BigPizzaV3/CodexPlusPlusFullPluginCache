{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "voiceaiwrapper": {
      "type": "streamable-http",
      "url": "https://api.voiceaiwrapper.app/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "baseScopes": ["agents.read", "agents.write"]
          }
        }
      }
    }
  }
}
