{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "propfocus": {
      "type": "streamable-http",
      "url": "https://mcp.propfocus.in/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": { "mode": "dcr" },
            "defaultScopes": ["mcp", "propfocus"]
          }
        }
      }
    }
  }
}
