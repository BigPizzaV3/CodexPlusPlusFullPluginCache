{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "stuon": {
      "type": "streamable-http",
      "url": "https://mcp.stuon.space/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "authorizationServerBase": "https://mcp.stuon.space",
            "registrationUrl": "https://mcp.stuon.space/oauth/register",
            "resource": "https://mcp.stuon.space/mcp",
            "baseScopes": ["profile:read", "study:read", "study:write"]
          }
        }
      }
    }
  }
}
