{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "duitmyself": {
      "type": "streamable-http",
      "url": "https://mcp.duitmyself.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "duitmyself-chatgpt",
              "tokenEndpointAuthMethod": "client_secret_post"
            },
            "authorizationUrl": "https://relay.duitmyself.app/api/auth/oauth2/authorize",
            "tokenUrl": "https://relay.duitmyself.app/api/auth/oauth2/token",
            "baseScopes": ["accounts:read", "transactions:read", "categories:read", "payees:read", "offline_access"],
            "oidcEnabled": false
          }
        }
      }
    }
  }
}
