{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "figurelane": {
      "type": "streamable-http",
      "url": "https://figurelane.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "figurelane-chatgpt",
              "tokenEndpointAuthMethod": "none"
            },
            "authorizationUrl": "https://figurelane.com/api/auth/oauth2/authorize",
            "tokenUrl": "https://figurelane.com/api/auth/oauth2/token",
            "resource": "https://figurelane.com/mcp",
            "baseScopes": [
              "figurelane:read",
              "figurelane:records:write",
              "figurelane:review:approve",
              "figurelane:invoices:write",
              "figurelane:documents:upload",
              "offline_access"
            ]
          }
        }
      }
    }
  }
}
