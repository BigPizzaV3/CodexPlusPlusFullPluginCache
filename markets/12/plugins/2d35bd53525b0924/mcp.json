{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "command-center": {
      "type": "streamable-http",
      "url": "https://mynd-connect.humbleolm16.chatgpt.site/api/command-mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": [
              "openid",
              "email",
              "offline_access"
            ]
          }
        }
      }
    }
  }
}
