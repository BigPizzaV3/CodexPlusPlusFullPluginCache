{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "american-fox-results": {
      "type": "streamable-http",
      "url": "https://www.americanfox.org/signals/chatgpt",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "american-fox-chatgpt-private",
              "tokenEndpointAuthMethod": "none"
            },
            "authorizationUrl": "https://www.americanfox.org/signals/chatgpt/oauth/auth",
            "tokenUrl": "https://www.americanfox.org/signals/chatgpt/oauth/token",
            "authorizationServerBase": "https://www.americanfox.org/signals/chatgpt/oauth",
            "resource": "https://www.americanfox.org/signals/chatgpt",
            "baseScopes": [
              "results:read"
            ],
            "oidcEnabled": false
          }
        }
      }
    }
  }
}
