{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "seemor": {
      "type": "streamable-http",
      "url": "https://api.seemor.ai/api/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "resource": "https://api.seemor.ai/api/mcp",
            "authorizationServerBase": "https://cvnytjlvrsozrxbmiqdn.supabase.co/auth/v1",
            "authorizationUrl": "https://cvnytjlvrsozrxbmiqdn.supabase.co/auth/v1/oauth/authorize",
            "tokenUrl": "https://cvnytjlvrsozrxbmiqdn.supabase.co/auth/v1/oauth/token",
            "registrationUrl": "https://cvnytjlvrsozrxbmiqdn.supabase.co/auth/v1/oauth/clients/register",
            "baseScopes": ["profile", "email"],
            "defaultScopes": ["profile", "email"]
          }
        }
      }
    }
  }
}
