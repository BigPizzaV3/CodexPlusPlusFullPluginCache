{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "ego": {
      "type": "streamable-http",
      "url": "https://api.egocrm.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "chatgpt",
              "tokenEndpointAuthMethod": "none"
            },
            "authorizationUrl": "https://api.egocrm.com/mcp/connect",
            "tokenUrl": "https://api.egocrm.com/mcp/api/auth/oauth/token",
            "resource": "https://api.egocrm.com/mcp/",
            "baseScopes": [
              "ego:api"
            ],
            "defaultScopes": [
              "ego:api"
            ]
          }
        }
      }
    }
  }
}