{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "dropair-home": {
      "type": "streamable-http",
      "url": "https://test.dropair.cn/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "dropair-chatgpt-test",
              "tokenEndpointAuthMethod": "none"
            },
            "resource": "https://test.dropair.cn/mcp",
            "baseScopes": [
              "home:read"
            ],
            "defaultScopes": [
              "home:read",
              "home:history",
              "home:control"
            ]
          }
        }
      }
    }
  }
}
