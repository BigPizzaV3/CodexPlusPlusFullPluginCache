{
  "version": "1.0",
  "topLevelSchema": {
    "theme": {
      "designPreset": "editorial (shared foundation; author colors and font for the event)",
      "fontPreset": "gothic | mincho | maru-gothic",
      "accentColor": "lowercase six-digit hex",
      "pageBackgroundColor": "lowercase six-digit hex"
    },
    "lpHeader": {
      "enabled": "boolean",
      "text": "string"
    },
    "lpBlocks": "array<object>"
  },
  "requiredBlockShape": {
    "id": "string",
    "type": "string",
    "content": "object",
    "layout": "object (optional)"
  },
  "conversionCriticalTypes": [
    "hero",
    "section",
    "process",
    "calendar",
    "map",
    "buttons|stickycta"
  ],
  "blockCatalog": [
    {
      "blockType": "free-design",
      "purpose": "Responsive HTML/CSS composition with independently editable text and approved images; retain native booking and access blocks",
      "requiredFields": [
        "title",
        "html"
      ],
      "recommendedFields": [
        "css",
        "texts",
        "images"
      ],
      "example": {
        "type": "free-design",
        "content": {
          "title": "Event introduction",
          "html": "<section data-lp-role=\"orientation\"><h2 data-lp-text=\"intro-title\"></h2><p data-lp-text=\"intro-body\"></p></section>",
          "css": "section{padding:clamp(24px,5vw,80px)}h2{font-size:clamp(28px,4vw,56px)}",
          "texts": [
            {
              "id": "intro-title",
              "label": "見出し",
              "value": "光の入り方を、現地で。",
              "role": "heading"
            },
            {
              "id": "intro-body",
              "label": "説明",
              "value": "住まいを歩きながら、暮らしを思い描く見学会です。",
              "role": "body"
            }
          ],
          "images": []
        }
      }
    },
    {
      "blockType": "hero",
      "purpose": "First-view key visual and semantic event identity",
      "requiredFields": [
        "title"
      ],
      "recommendedFields": [
        "subtitle",
        "imageUrl",
        "visualMode"
      ],
      "example": {
        "type": "hero",
        "content": {
          "title": "Weekend showroom tour",
          "subtitle": "Compare plans and reserve in 3 minutes",
          "visualMode": "overlay",
          "imageUrl": "https://example.com/generated-hero.png",
          "ctaText": "来場予約をする",
          "ctaAnchor": "#booking-section"
        }
      },
      "rendererBehavior": "content.imageHeightMode applies only when content.composition is absent; any explicit composition selects its own photo sizing, so imageHeightMode has no effect. With no composition, prefer content.imageHeightMode=natural when the artwork's ratio should define the full-width composition or a finished text-bearing key visual would lose lettering to a framed crop; otherwise omit or use framed for legacy framing. image-only and imageFit=contain alone do not imply natural height. When content.composition=framed-photo, content.titleDirection=horizontal, content.imageUrl is present, and content.visualMode is not image-only, content.flowLayout=true opts into intrinsic rows: eyebrow/title/subtitle on the left and eventLabel/metaText/CTA on the right above the photo, stacking on mobile; omit or false preserves legacy layout. For photo-spread, on containers wider than 960px, the 3:2 main photo is left with the headline beside it on the right; eventLabel and metaText/CTA share the row above the visual and subtitle appears in a footer below the photo. At 960px or less, eventLabel stays before the visual; the title moves above the photo; the photo comes before subtitle/footer; metaText/CTA overview follows the footer. Use content.composition=editorial-cover/framed-photo/split-panel/photo-spread according to the artwork and copy."
    },
    {
      "blockType": "section",
      "purpose": "Introduce section topic and context transition",
      "requiredFields": [
        "title"
      ],
      "recommendedFields": [
        "subtitle"
      ],
      "example": {
        "type": "section",
        "content": {
          "title": "Why this event matters",
          "subtitle": "Learn practical housing options"
        }
      },
      "rendererBehavior": "title/subtitle only. Usually tight spacing; align its outer axis with the following content. For a new LP, prefer content.presentation=editorial when the transition benefits; omit only when its role is better served by legacy rendering."
    },
    {
      "blockType": "text",
      "purpose": "Narrative explanation and detail",
      "requiredFields": [
        "text"
      ],
      "recommendedFields": [],
      "example": {
        "type": "text",
        "content": {
          "text": "Talk with specialists and compare choices in one visit."
        }
      }
    },
    {
      "blockType": "media",
      "purpose": "Visual proof: photo-story for a large image with heading/body below; editorial for asymmetric image/copy; split or stacked when appropriate",
      "requiredFields": [],
      "recommendedFields": [
        "presentation",
        "title",
        "body",
        "imageUrl",
        "imageAlt"
      ],
      "example": {
        "type": "media",
        "content": {
          "presentation": "editorial",
          "title": "光の入り方を体感",
          "body": "写真と同じ空間を歩き、時間帯による明るさの違いを確かめます。",
          "imageUrl": "https://example.com/living-room.jpg",
          "imageAlt": "自然光が入るリビング"
        }
      },
      "rendererBehavior": "Choose content.presentation by photo role. Prefer photo-story for a large image followed by title/body, editorial for asymmetric image and short copy, split for balanced comparison, or stacked for one vertical group. Use the best-fitting option for new LPs; do not repeat one image/copy structure for all media."
    },
    {
      "blockType": "image",
      "purpose": "Single image emphasis",
      "requiredFields": [
        "src"
      ],
      "recommendedFields": [
        "alt",
        "caption"
      ],
      "example": {
        "type": "image",
        "content": {
          "src": "https://example.com/hero.jpg",
          "alt": "Living room",
          "caption": "Natural light and wood finish"
        }
      }
    },
    {
      "blockType": "cardgrid",
      "purpose": "Feature list with structured cards",
      "requiredFields": [
        "cards[].title"
      ],
      "recommendedFields": [
        "cards[].text",
        "columns"
      ],
      "example": {
        "type": "cardgrid",
        "content": {
          "columns": 3,
          "cards": [
            {
              "title": "High insulation",
              "text": "Comfort in all seasons"
            },
            {
              "title": "Efficient layout",
              "text": "Better daily flow"
            }
          ]
        }
      },
      "rendererBehavior": "columns=2 stays 2 columns on mobile; 3 becomes 1; 4 becomes 2. Use for short parallel items whose copy density fits both PC and mobile. For a new LP, prefer content.presentation=editorial when these items benefit; omit only when legacy rendering better fits their structure."
    },
    {
      "blockType": "benefit",
      "purpose": "Single visit benefit or conversion incentive",
      "requiredFields": [
        "title",
        "label"
      ],
      "recommendedFields": [
        "description"
      ],
      "example": {
        "type": "benefit",
        "content": {
          "title": "子育て目線の間取りを体感",
          "label": "来場メリット",
          "description": "生活動線と収納の工夫を実際の空間で確認できます。"
        }
      }
    },
    {
      "blockType": "publisher",
      "purpose": "Current publisher profile and company-site link",
      "requiredFields": [
        "title"
      ],
      "recommendedFields": [
        "showLogo",
        "showAddress",
        "showPhone",
        "phoneSource",
        "showHomepage"
      ],
      "example": {
        "type": "publisher",
        "content": {
          "title": "主催者情報",
          "showLogo": true,
          "showAddress": true,
          "showPhone": true,
          "phoneSource": "branch",
          "showHomepage": true
        }
      }
    },
    {
      "blockType": "relatedevents",
      "purpose": "Current published events from the same branch or organization",
      "requiredFields": [
        "title",
        "scope"
      ],
      "recommendedFields": [
        "limit"
      ],
      "example": {
        "type": "relatedevents",
        "content": {
          "title": "関連イベント",
          "scope": "branch",
          "limit": 3
        }
      }
    },
    {
      "blockType": "comparison",
      "purpose": "Before/after or option comparison",
      "requiredFields": [],
      "recommendedFields": [
        "items",
        "headers"
      ],
      "example": {
        "type": "comparison",
        "content": {
          "headers": [
            "Plan A",
            "Plan B"
          ],
          "items": [
            "Price range",
            "Lot size support"
          ]
        }
      }
    },
    {
      "blockType": "metrics",
      "purpose": "Quantitative proof and confidence",
      "requiredFields": [
        "items[].label",
        "items[].value"
      ],
      "recommendedFields": [],
      "example": {
        "type": "metrics",
        "content": {
          "items": [
            {
              "label": "Satisfaction",
              "value": "4.8/5"
            },
            {
              "label": "Avg consultation",
              "value": "60 min"
            }
          ]
        }
      },
      "rendererBehavior": "Flex items wrap at min-width 160px. Use short numeric values; long dates, ranges, and sentences belong in notice/specs/text. For a new LP, prefer content.presentation=editorial when the source-backed numeric story benefits; omit only when legacy rendering better fits."
    },
    {
      "blockType": "kpi",
      "purpose": "Top-level KPI snapshot",
      "requiredFields": [],
      "recommendedFields": [
        "items"
      ],
      "example": {
        "type": "kpi",
        "content": {
          "items": [
            {
              "label": "Bookings",
              "value": "128"
            }
          ]
        }
      }
    },
    {
      "blockType": "process",
      "purpose": "Reservation-to-visit step explanation",
      "requiredFields": [
        "steps[].title"
      ],
      "recommendedFields": [
        "steps[].text"
      ],
      "example": {
        "type": "process",
        "content": {
          "steps": [
            {
              "title": "Select slot",
              "text": "Pick date and time"
            },
            {
              "title": "Confirm details",
              "text": "Review and submit"
            }
          ]
        }
      },
      "rendererBehavior": "The renderer adds number badges. Omit ordinals from titles. Fixed layout: PC 3 columns, tablet 2, mobile 1; 3 or 4 steps can leave an orphan row."
    },
    {
      "blockType": "calendar",
      "purpose": "Reservation slot selector entry point",
      "requiredFields": [],
      "recommendedFields": [
        "title",
        "note",
        "presentation"
      ],
      "example": {
        "type": "calendar",
        "content": {
          "title": "Available slots",
          "note": "Choose a convenient time"
        }
      },
      "rendererBehavior": "For a new LP, choose content.presentation=stacked for a short heading/date and centered calendar, or split when substantial copy balances the columns. omit or use null only when legacy rendering better fits."
    },
    {
      "blockType": "faq",
      "purpose": "Reduce booking friction with Q&A",
      "requiredFields": [
        "items[].q",
        "items[].a"
      ],
      "recommendedFields": [],
      "example": {
        "type": "faq",
        "content": {
          "items": [
            {
              "q": "How long does it take?",
              "a": "Usually 60-90 minutes."
            }
          ]
        }
      },
      "rendererBehavior": "For a new LP, prefer content.presentation=editorial when the question sequence benefits; omit only when legacy rendering better fits."
    },
    {
      "blockType": "map",
      "purpose": "Venue location and access guidance",
      "requiredFields": [
        "locationId"
      ],
      "recommendedFields": [
        "title",
        "address",
        "note"
      ],
      "example": {
        "type": "map",
        "content": {
          "title": "Venue access",
          "locationId": "selected-event-location-id",
          "address": "Tokyo Chiyoda",
          "note": "Parking available"
        }
      }
    },
    {
      "blockType": "buttons",
      "purpose": "CTA group with explicit actions",
      "requiredFields": [
        "buttons[].label",
        "buttons[].href|buttons[].anchor"
      ],
      "recommendedFields": [
        "buttons[].variant"
      ],
      "example": {
        "type": "buttons",
        "content": {
          "buttons": [
            {
              "label": "Reserve now",
              "anchor": "#booking-section"
            }
          ]
        }
      }
    },
    {
      "blockType": "stickycta",
      "purpose": "Persistent CTA for mobile conversion support",
      "requiredFields": [],
      "recommendedFields": [
        "label",
        "anchor|href"
      ],
      "example": {
        "type": "stickycta",
        "content": {
          "label": "Book a visit",
          "anchor": "#booking-section"
        }
      }
    },
    {
      "blockType": "form",
      "purpose": "Custom lead capture form",
      "requiredFields": [
        "title",
        "fields"
      ],
      "recommendedFields": [
        "submitLabel",
        "note"
      ],
      "example": {
        "type": "form",
        "content": {
          "title": "Contact form",
          "fields": [
            {
              "id": "name",
              "label": "Name",
              "type": "text",
              "required": true
            }
          ]
        }
      }
    },
    {
      "blockType": "gallery",
      "purpose": "Multi-image proof section",
      "requiredFields": [],
      "recommendedFields": [
        "items"
      ],
      "example": {
        "type": "gallery",
        "content": {
          "items": [
            {
              "src": "https://example.com/1.jpg",
              "alt": "Kitchen"
            }
          ]
        }
      },
      "rendererBehavior": "Choose content.presentation=editorial for a deliberate primary/detail hierarchy; otherwise use the equal-weight grid for related evidence."
    },
    {
      "blockType": "specs",
      "purpose": "Structured specification table",
      "requiredFields": [
        "items[].key",
        "items[].value"
      ],
      "recommendedFields": [],
      "example": {
        "type": "specs",
        "content": {
          "items": [
            {
              "key": "Structure",
              "value": "Wood frame"
            },
            {
              "key": "Site area",
              "value": "120 m2"
            }
          ]
        }
      },
      "rendererBehavior": "For a new LP, prefer content.presentation=editorial when source-backed facts benefit from a distinct editorial rhythm; omit only when legacy rendering better fits."
    },
    {
      "blockType": "notice",
      "purpose": "Important notes and disclosures",
      "requiredFields": [],
      "recommendedFields": [
        "text",
        "level"
      ],
      "example": {
        "type": "notice",
        "content": {
          "text": "Slots may close early.",
          "level": "info"
        }
      },
      "rendererBehavior": "For a new LP, prefer content.presentation=editorial when an important source-backed notice benefits from a distinct treatment; omit only when legacy rendering better fits."
    },
    {
      "blockType": "share",
      "purpose": "Social sharing controls",
      "requiredFields": [],
      "recommendedFields": [
        "showX",
        "showFacebook",
        "showLine"
      ],
      "example": {
        "type": "share",
        "content": {
          "showX": true,
          "showLine": true
        }
      }
    },
    {
      "blockType": "script",
      "purpose": "Script injection (requires explicit review)",
      "requiredFields": [
        "code"
      ],
      "recommendedFields": [
        "placement"
      ],
      "example": {
        "type": "script",
        "content": {
          "code": "console.info('lp')",
          "placement": "footer"
        }
      }
    },
    {
      "blockType": "header",
      "purpose": "Top header styling or navigation area",
      "requiredFields": [],
      "recommendedFields": [
        "title",
        "links"
      ],
      "example": {
        "type": "header",
        "content": {
          "title": "Event details"
        }
      }
    },
    {
      "blockType": "testimonials",
      "purpose": "Social proof from attendees",
      "requiredFields": [],
      "recommendedFields": [
        "items"
      ],
      "example": {
        "type": "testimonials",
        "content": {
          "items": [
            {
              "quote": "Very helpful consultation.",
              "author": "A Family"
            }
          ]
        }
      }
    },
    {
      "blockType": "policy",
      "purpose": "Policy and terms disclosure",
      "requiredFields": [
        "items[]"
      ],
      "recommendedFields": [],
      "example": {
        "type": "policy",
        "content": {
          "items": [
            "Personal data usage follows company privacy policy."
          ]
        }
      }
    },
    {
      "blockType": "spacer",
      "purpose": "Vertical spacing control",
      "requiredFields": [],
      "recommendedFields": [
        "size"
      ],
      "example": {
        "type": "spacer",
        "content": {
          "size": "md"
        }
      }
    }
  ],
  "external_usage_notice": "Shared references provide business knowledge. Runtime, UI, tool, or save examples inside them describe the internal surface and must not be executed as written. Follow the external workflow, the current live contract, and its confirmation requirements."
}
