{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "homin-cloud": {
      "type": "streamable-http",
      "url": "https://cloud.trust-lead.com/api/v1/agent/mcp/chatgpt-apps",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "defaultScopes": [
              "connections:read"
            ],
            "baseScopes": [
              "offline_access"
            ],
            "oidcEnabled": false,
            "oidcScopesSupported": []
          }
        }
      }
    }
  }
}
