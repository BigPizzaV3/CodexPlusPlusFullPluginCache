{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "myssagent": {
      "type": "streamable-http",
      "url": "https://myssagent.com/api/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "mixed",
            "client": {
              "mode": "dcr"
            },
            "oidcEnabled": false,
            "defaultScopes": [
              "email",
              "profile",
              "offline_access"
            ]
          }
        }
      }
    }
  }
}
