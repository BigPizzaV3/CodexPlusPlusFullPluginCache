{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "exclusively-me": {
      "type": "streamable-http",
      "url": "https://api.exclusively.me/app",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "mixed",
            "client": { "mode": "dcr" },
            "authorizationUrl": "https://exclusively.me/oauth/authorize",
            "tokenUrl": "https://exclusively.me/oauth/token",
            "registrationUrl": "https://exclusively.me/oauth/register",
            "baseScopes": ["read", "write"]
          }
        }
      }
    }
  }
}
