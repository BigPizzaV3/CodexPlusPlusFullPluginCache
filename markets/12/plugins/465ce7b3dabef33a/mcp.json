{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "recallr": {
      "type": "streamable-http",
      "url": "https://mcp.recallr-ai.org/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": [
              "recallr"
            ],
            "authorizationUrl": "https://mcp.recallr-ai.org/authorize",
            "tokenUrl": "https://mcp.recallr-ai.org/token",
            "registrationUrl": "https://mcp.recallr-ai.org/register",
            "authorizationServerBase": "https://mcp.recallr-ai.org",
            "resource": "https://mcp.recallr-ai.org/mcp",
            "oidcEnabled": false
          }
        }
      }
    }
  }
}
