{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "beevvy": {
      "type": "streamable-http",
      "url": "https://mcp.beevvy.com",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "authorizationServerBase": "https://jtyqtdjeyrzmkxbmhohh.supabase.co/auth/v1",
            "authorizationUrl": "https://jtyqtdjeyrzmkxbmhohh.supabase.co/auth/v1/oauth/authorize",
            "tokenUrl": "https://jtyqtdjeyrzmkxbmhohh.supabase.co/auth/v1/oauth/token",
            "registrationUrl": "https://jtyqtdjeyrzmkxbmhohh.supabase.co/auth/v1/oauth/clients/register",
            "resource": "https://jtyqtdjeyrzmkxbmhohh.supabase.co/functions/v1/mcp",
            "defaultScopes": ["openid", "email", "profile"]
          }
        }
      }
    }
  }
}
