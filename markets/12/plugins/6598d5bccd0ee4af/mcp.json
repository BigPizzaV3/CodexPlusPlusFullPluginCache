{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "zas": {
      "type": "streamable-http",
      "url": "https://zas.red/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": { "mode": "provided", "clientId": "zas-chatgpt-hosted-pilot", "tokenEndpointAuthMethod": "none" },
            "baseScopes": ["zas.read", "zas.send", "offline_access"],
            "resource": "https://zas.red/mcp"
          }
        }
      }
    }
  }
}

