{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "rtobase": {
      "type": "streamable-http",
      "url": "https://rtobase.com.au/api/v1/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": { "mode": "dcr" },
            "authorizationUrl": "https://rtobase.com.au/oauth/authorize",
            "tokenUrl": "https://rtobase.com.au/api/v1/oauth/token",
            "registrationUrl": "https://rtobase.com.au/api/v1/oauth/register",
            "resource": "https://rtobase.com.au/api/v1/mcp"
          }
        }
      }
    }
  }
}
