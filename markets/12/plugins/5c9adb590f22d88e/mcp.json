{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "photoaistudio": {
      "type": "streamable-http",
      "url": "https://www.photoaistudio.com/api/mcp/chatgpt",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "mixed",
            "client": {
              "mode": "provided",
              "clientId": "https://chatgpt.com/oauth/client.json",
              "tokenEndpointAuthMethod": "none"
            },
            "authorizationUrl": "https://www.photoaistudio.com/api/oauth/authorize",
            "tokenUrl": "https://www.photoaistudio.com/api/oauth/token",
            "resource": "https://www.photoaistudio.com/api/mcp/chatgpt",
            "baseScopes": [
              "photos:read",
              "photos:write"
            ],
            "oidcEnabled": false
          }
        }
      }
    }
  }
}
