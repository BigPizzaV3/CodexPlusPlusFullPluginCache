{
  "title": "Retail Sales Executive",
  "category": "Sales",
  "description": "Monthly scorecard for a store-based sales executive: revenue target, new customers, quote conversion, daily store routine and customer feedback.",
  "metrics": [
    {
      "name": "Attendance",
      "category": "Attendance",
      "weightage": 10
    },
    {
      "name": "Timing",
      "category": "Timing",
      "weightage": 10
    },
    {
      "name": "Monthly Sales",
      "category": "Core KPIs",
      "kpi_type": "Goal-ProRata",
      "weightage": 15,
      "target_value": 500000,
      "unit": "INR",
      "dkr_field": {
        "name": "Sales today",
        "description": "Total value of invoices closed today, in INR."
      },
      "goal_config": {
        "mqr_threshold": 70
      }
    },
    {
      "name": "New Customers",
      "category": "Core KPIs",
      "kpi_type": "Goal-Slab",
      "weightage": 5,
      "target_value": 20,
      "dkr_field": {
        "name": "New customers today",
        "description": "Customers who bought from us for the first time today."
      },
      "goal_config": {
        "slabs": [
          {
            "target": 20,
            "points": 5
          },
          {
            "target": 16,
            "points": 3
          }
        ]
      }
    },
    {
      "name": "Quote to Order Conversion",
      "category": "Core KPIs",
      "kpi_type": "Conversion",
      "weightage": 10,
      "target_value": 80,
      "dkr_field": {
        "name": "Quotes and orders today",
        "description": "Quotes given and orders won today."
      },
      "conversion_config": {
        "input_a_label": "Quotes given",
        "input_b_label": "Orders won",
        "slabs": [
          {
            "target": 80,
            "points": 10
          },
          {
            "target": 70,
            "points": 5
          }
        ]
      }
    },
    {
      "name": "Store Routine",
      "category": "Core KPIs",
      "kpi_type": "Checklist",
      "weightage": 10,
      "checklist_config": {
        "tasks": [
          {
            "name": "Open the store and set up displays",
            "points": 2,
            "frequency": "daily"
          },
          {
            "name": "Close the day and lock the cash drawer",
            "points": 2,
            "frequency": "daily"
          },
          {
            "name": "Update the stock register",
            "points": 2,
            "frequency": "weekly"
          },
          {
            "name": "Review price tags and offers",
            "points": 2,
            "frequency": "bi-weekly"
          },
          {
            "name": "Month-end stock count",
            "points": 2,
            "frequency": "monthly"
          }
        ]
      }
    },
    {
      "name": "Management Audit",
      "category": "Core KPIs",
      "kpi_type": "Audit-Feedback",
      "weightage": 10,
      "audit_feedback_config": {
        "type": "internal",
        "rating_scale": 5,
        "frequency": "monthly",
        "audit_count": 1,
        "parameters": [
          {
            "name": "Grooming and behaviour",
            "weightage": 2
          },
          {
            "name": "Product knowledge",
            "weightage": 2
          },
          {
            "name": "Customer approach",
            "weightage": 2
          },
          {
            "name": "Stock and display upkeep",
            "weightage": 2
          },
          {
            "name": "Work efficiency",
            "weightage": 2
          }
        ]
      }
    },
    {
      "name": "Customer Feedback",
      "category": "Core KPIs",
      "kpi_type": "Audit-Feedback",
      "weightage": 10,
      "audit_feedback_config": {
        "type": "external",
        "rating_scale": 5,
        "frequency": "monthly",
        "audit_count": 5,
        "parameters": [
          {
            "name": "Overall satisfaction",
            "weightage": 2
          },
          {
            "name": "Politeness and behaviour",
            "weightage": 2
          },
          {
            "name": "Product guidance",
            "weightage": 2
          },
          {
            "name": "Waiting time",
            "weightage": 2
          },
          {
            "name": "Follow-up after purchase",
            "weightage": 2
          }
        ]
      }
    },
    {
      "name": "To-Do List",
      "category": "Core KPIs",
      "kpi_type": "ToDo-List",
      "weightage": 10
    },
    {
      "name": "Reports",
      "category": "Reports",
      "weightage": 10
    }
  ]
}
