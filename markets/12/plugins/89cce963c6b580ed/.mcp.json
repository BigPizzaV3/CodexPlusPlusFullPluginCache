{
  "mcpServers": {
    "doctilla": {
      "type": "streamable-http",
      "url": "https://mcp.doctilla.co.uk/mcp",
      "headers": {},
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "cimd"
            },
            "baseScopes": [
              "doctilla:read"
            ],
            "defaultScopes": [
              "doctilla:read",
              "doctilla:write"
            ],
            "oidcEnabled": false
          }
        }
      }
    }
  }
}
