{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "doctilla": {
      "type": "streamable-http",
      "url": "https://mcp.doctilla.co.uk/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "cimd"
            },
            "baseScopes": [
              "doctilla:read"
            ],
            "defaultScopes": [
              "doctilla:read",
              "doctilla:write"
            ],
            "oidcEnabled": false
          }
        }
      }
    }
  }
}
