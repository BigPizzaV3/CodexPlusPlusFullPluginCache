{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "moltsheet": {
      "type": "streamable-http",
      "url": "https://www.moltsheet.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": { "mode": "provided", "clientId": "moltsheet-openai", "tokenEndpointAuthMethod": "none" },
            "resource": "https://www.moltsheet.com/mcp",
            "authorizationUrl": "https://www.moltsheet.com/oauth/authorize",
            "tokenUrl": "https://www.moltsheet.com/oauth/token",
            "baseScopes": ["sheets:read"],
            "defaultScopes": ["sheets:read", "sheets:write", "sheets:manage"],
            "oidcEnabled": false
          }
        }
      }
    }
  }
}
