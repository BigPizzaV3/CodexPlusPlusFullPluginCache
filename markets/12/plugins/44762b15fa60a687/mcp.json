{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "remotecommand": {
      "type": "streamable-http",
      "url": "https://api.remotecommand.app/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": [
              "devices:read",
              "files:read",
              "files:write",
              "terminal:read",
              "terminal:execute"
            ]
          }
        }
      }
    }
  }
}
