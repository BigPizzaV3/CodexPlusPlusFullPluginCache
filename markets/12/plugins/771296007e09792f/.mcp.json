{
  "mcpServers": {
    "superlift": {
      "type": "streamable-http",
      "url": "https://superlift-mcp.fly.dev/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "cimd"
            },
            "authorizationUrl": "https://superlift-mcp.fly.dev/authorize",
            "tokenUrl": "https://superlift-mcp.fly.dev/token",
            "baseScopes": ["training:read", "program:write"]
          }
        }
      }
    }
  }
}
