{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "plugpup-wordle",
  "version": "1.0.1",
  "description": "Stuck on Wordle? Enter your guesses and colors (or paste the colored squares) and see every word that still fits, ranked, with a suggested next guess. Tap tiles to update colors and re-solve right in the chat. Also finds crossword and word-game answers from patterns like c?t with letters to include or exclude. Full 170,000-word dictionary.",
  "author": {
    "name": "Abdessamad Chokri",
    "email": "support@plugpup.com",
    "url": "https://plugpup.com"
  },
  "homepage": "https://plugpup.com",
  "extensions": {
    "com.openai": {
      "auth": {
        "type": "none"
      },
      "interface": {
        "displayName": "PlugPup Wordle Solver",
        "shortDescription": "Wordle & crossword helper",
        "longDescription": "Stuck on Wordle? Enter your guesses and colors (or paste the colored squares) and see every word that still fits, ranked, with a suggested next guess. Tap tiles to update colors and re-solve right in the chat. Also finds crossword and word-game answers from patterns like c?t with letters to include or exclude. Full 170,000-word dictionary.",
        "developerName": "Abdessamad Chokri",
        "category": "Entertainment",
        "capabilities": [
          "Wordle solver",
          "Crossword pattern finder"
        ],
        "websiteURL": "https://plugpup.com",
        "supportURL": "https://plugpup.com/support.html",
        "privacyPolicyURL": "https://plugpup.com/privacy.html",
        "termsOfServiceURL": "https://plugpup.com/terms.html",
        "defaultPrompt": [
          "Wordle help: CRANE was \ud83d\udfe9\u2b1b\u2b1b\ud83d\udfe8\u2b1b",
          "Words matching c?t?h",
          "5-letter words with a and e but no s"
        ],
        "brandColor": "#EA580C",
        "brandColorDark": "#FB923C",
        "composerIcon": "./assets/icon.png",
        "logo": "./assets/icon.png"
      },
      "review": {
        "test_cases": {
          "positive": [
            {
              "description": "candidates include CRATE",
              "prompt": "Wordle: CRANE gave green green green gray green",
              "tools_triggered": "solve_wordle",
              "expected_behavior": "candidates include CRATE."
            },
            {
              "description": "candidate list + suggestion",
              "prompt": "My Wordle: SLATE \ud83d\udfe8\u2b1b\ud83d\udfe9\u2b1b\u2b1b then ROAST \u2b1b\u2b1b\ud83d\udfe9\ud83d\udfe8\u2b1b",
              "tools_triggered": "solve_wordle",
              "expected_behavior": "candidate list + suggestion."
            },
            {
              "description": "matches include catch, cutch",
              "prompt": "Crossword: 5 letters, c?t?h",
              "tools_triggered": "solve_pattern",
              "expected_behavior": "matches include catch, cutch."
            },
            {
              "description": "list of matches",
              "prompt": "Words matching ??ple with no a",
              "tools_triggered": "solve_pattern",
              "expected_behavior": "list of matches."
            },
            {
              "description": "candidates without a,u,d,i,o",
              "prompt": "Wordle solver: first guess AUDIO was all gray",
              "tools_triggered": "solve_wordle",
              "expected_behavior": "candidates without a,u,d,i,o."
            }
          ],
          "negative": [
            {
              "description": "Out of scope 1",
              "prompt": "Define the word 'crane'"
            },
            {
              "description": "Out of scope 2",
              "prompt": "Who invented Wordle?"
            },
            {
              "description": "Out of scope 3",
              "prompt": "Write a poem using the word 'slate'"
            }
          ]
        },
        "demo_recording_url": "https://plugpup.com/demo/wordle.mp4",
        "commerce": false
      },
      "publication": {
        "release_notes": "v1.0.1 \u2014 Developer listed as verified owner (Abdessamad Chokri). Wordle solver with interactive board; crossword pattern finder."
      },
      "apps": "./.app.json"
    }
  }
}
