{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "geodd": {
      "type": "streamable-http",
      "url": "https://api.geodd.io/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "authorizationUrl": "https://api.geodd.io/oauth/authorize",
            "tokenUrl": "https://api.geodd.io/oauth/token",
            "authorizationServerBase": "https://api.geodd.io",
            "resource": "https://api.geodd.io/mcp",
            "client": {
              "mode": "provided",
              "clientId": "chatgpt",
              "tokenEndpointAuthMethod": "none"
            },
            "baseScopes": ["identity:read"],
            "defaultScopes": [
              "billing:read",
              "compute:launch",
              "compute:read",
              "compute:ssh-keys:create",
              "identity:read",
              "inference:keys:create",
              "inference:read",
              "support:read",
              "support:write"
            ]
          }
        }
      }
    }
  }
}
