{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "supersimple": {
      "type": "streamable-http",
      "url": "https://app.supersimple.io/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": [
              "data:read",
              "apps:read",
              "apps:write",
              "ai:read",
              "ai:write",
              "inbox:read",
              "inbox:write"
            ]
          }
        }
      }
    }
  }
}
