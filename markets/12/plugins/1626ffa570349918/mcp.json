{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "nervus": {
      "type": "streamable-http",
      "url": "https://app.nervus.chat/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "cimd"
            },
            "registrationUrl": "https://app.nervus.chat/oauth/register",
            "baseScopes": [
              "nervus:read"
            ]
          }
        }
      }
    }
  }
}
