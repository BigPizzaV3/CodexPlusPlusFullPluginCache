{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "quicktion": {
      "type": "streamable-http",
      "url": "https://quicktion.io/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "cimd"
            },
            "authorizationUrl": "https://quicktion.io/oauth/authorize",
            "tokenUrl": "https://quicktion.io/api/oauth/token",
            "registrationUrl": "https://quicktion.io/api/oauth/register",
            "resource": "https://quicktion.io/mcp",
            "baseScopes": [
              "destinations:read",
              "emails:write",
              "emails:read"
            ]
          }
        }
      }
    }
  }
}
