{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "polytweaks": {
      "type": "streamable-http",
      "url": "https://api.polytweaks.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "polytweaks-chatgpt-core",
              "tokenEndpointAuthMethod": "none"
            },
            "authorizationUrl": "https://api.polytweaks.com/oauth/chatgpt/authorize",
            "tokenUrl": "https://api.polytweaks.com/oauth/chatgpt/token",
            "resource": "https://api.polytweaks.com/mcp",
            "baseScopes": [
              "models:read",
              "models:write",
              "comments:read",
              "comments:write",
              "shares:write"
            ]
          }
        }
      }
    }
  }
}
