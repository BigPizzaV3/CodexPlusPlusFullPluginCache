{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "ecommerce-leads": {
      "type": "streamable-http",
      "url": "https://getecommerceleads.com/api/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "mixed",
            "client": {
              "mode": "dcr"
            },
            "authorizationUrl": "https://getecommerceleads.com/oauth/authorize",
            "tokenUrl": "https://getecommerceleads.com/oauth/token",
            "registrationUrl": "https://getecommerceleads.com/oauth/register",
            "resource": "https://getecommerceleads.com/api/mcp"
          }
        }
      }
    }
  }
}
