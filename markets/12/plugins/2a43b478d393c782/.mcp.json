{
  "mcpServers": {
    "todo": {
      "url": "https://api.todo.work/api_integrations/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "cimd"
            },
            "authorizationUrl": "https://app.todo.work/oauth/authorize",
            "tokenUrl": "https://api.todo.work/api_integrations/oauth_token",
            "registrationUrl": "https://api.todo.work/api_integrations/oauth_register",
            "authorizationServerBase": "https://api.todo.work",
