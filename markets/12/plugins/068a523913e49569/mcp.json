{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "mole-notes": {
      "type": "streamable-http",
      "url": "https://api.molenotes.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "C0jV3443lIstif2V",
              "tokenEndpointAuthMethod": "none"
            },
            "baseScopes": [
              "offline_access"
            ],
            "defaultScopes": [
              "notes:search",
              "notes:read",
              "notes:write"
            ],
            "oidcEnabled": false
          }
        }
      }
    }
  }
}
