{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "fieldnotes-china": {
      "type": "streamable-http",
      "url": "https://research.fenuli.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": [
              "offline_access"
            ],
            "defaultScopes": [
              "research:read",
              "projects:read",
              "projects:write",
              "exports:write",
              "coverage:read",
              "coverage:write",
              "offline_access"
            ]
          }
        }
      }
    }
  }
}
