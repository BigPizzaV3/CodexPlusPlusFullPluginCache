{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "summitplate": {
      "type": "streamable-http",
      "url": "https://www.summitplate.com/api/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "cimd"
            },
            "baseScopes": [
              "cookbook:read",
              "cookbook:write",
              "plans:read",
              "plans:write",
              "groceries:read",
              "groceries:write"
            ],
            "defaultScopes": []
          }
        }
      }
    }
  }
}
