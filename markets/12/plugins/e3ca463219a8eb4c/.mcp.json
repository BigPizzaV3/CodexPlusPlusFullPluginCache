{
  "mcpServers": {
    "astrofaith": {
      "type": "http",
      "url": "https://api.astro.faith/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "oidcEnabled": true,
            "oidcConfigurationUrl": "https://my.astro.faith/.well-known/openid-configuration",
            "oidcUserinfoEndpoint": "https://my.astro.faith/oauth/userinfo",
            "defaultScopes": [
              "openid",
              "email",
              "calculations:read",
              "birthdata:read",
              "birthdata:write",
              "theme:read",
              "theme:write",
              "rules:read",
              "rules:write",
              "dignities:read",
              "dignities:write",
              "orbs:read",
              "orbs:write"
            ]
          }
        }
      }
    }
  }
}
