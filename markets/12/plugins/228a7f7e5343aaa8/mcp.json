{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "reddgrow": {
      "type": "streamable-http",
      "url": "https://mcp.reddgrow.ai/core/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": { "mode": "dcr" },
            "registrationUrl": "https://mcp.reddgrow.ai/oauth/register",
            "baseScopes": ["read", "write"]
          }
        }
      }
    }
  }
}
