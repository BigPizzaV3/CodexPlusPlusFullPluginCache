{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "red-paper": {
      "type": "streamable-http",
      "url": "https://www.checkplagiarism.ai/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "authorizationServerBase": "https://www.checkplagiarism.ai",
            "registrationUrl": "https://www.checkplagiarism.ai/o/register/",
            "resource": "https://www.checkplagiarism.ai/mcp",
            "defaultScopes": ["reports:read", "scan:submit"]
          }
        }
      }
    }
  }
}
