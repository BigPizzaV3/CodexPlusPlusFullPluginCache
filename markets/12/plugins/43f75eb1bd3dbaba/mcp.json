{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "shopping-ads-solutions": {
      "type": "streamable-http",
      "url": "https://bo.shoppingadssolutions.com/api/v1/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "sas-chatgpt-private",
              "tokenEndpointAuthMethod": "none"
            },
            "resource": "https://bo.shoppingadssolutions.com/api/v1/mcp",
            "baseScopes": [
              "briefs:read",
              "context:read",
              "briefs:draft"
            ],
            "authorizationUrl": "https://bo.shoppingadssolutions.com/api/v1/ai/oauth/authorize",
            "tokenUrl": "https://bo.shoppingadssolutions.com/api/v1/ai/oauth/token"
          }
        }
      }
    }
  }
}
