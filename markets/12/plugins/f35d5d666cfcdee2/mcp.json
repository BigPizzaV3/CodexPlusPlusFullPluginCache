{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "intervl": {
      "type": "streamable-http",
      "url": "https://intervl.cc/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": [
              "profile:read",
              "workouts:write",
              "rides:read"
            ]
          }
        }
      }
    }
  }
}
