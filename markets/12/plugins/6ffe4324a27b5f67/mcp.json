{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "animiotics": {
      "type": "streamable-http",
      "url": "https://animiotics.com/api/vps/chatgpt/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": { "mode": "dcr" },
            "authorizationServerBase": "https://animiotics.com/api/vps/chatgpt",
            "authorizationUrl": "https://animiotics.com/connect/chatgpt",
            "tokenUrl": "https://animiotics.com/api/vps/chatgpt/token",
            "registrationUrl": "https://animiotics.com/api/vps/chatgpt/register",
            "resource": "https://animiotics.com/api/vps/chatgpt/mcp",
            "baseScopes": ["animations:read", "animations:write"]
          }
        }
      }
    }
  }
}
