{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "leasingai",
  "version": "1.0.7",
  "description": "Find apartment communities, check prices and availability, and book tours.",
  "author": {
    "name": "LeasingAI",
    "email": "contact@leasing.ai",
    "url": "https://leasing.ai"
  },
  "homepage": "https://leasing.ai",
  "keywords": [
    "apartments",
    "rentals",
    "tours",
    "real estate"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "LeasingAI",
        "shortDescription": "Find apartments, book tours",
        "longDescription": "LeasingAI answers questions about apartment communities managed by LeasingAI clients: prices, available homes, floor plans, office hours, pet policy and the neighborhood. Renters can see open tour times and book, reschedule or cancel a tour. Data comes from each community's property management system.",
        "developerName": "LeasingAI",
        "category": "Other",
        "capabilities": [
          "Find communities",
          "Pricing and availability",
          "Book tours"
        ],
        "websiteURL": "https://leasing.ai",
        "supportURL": "https://leasing.ai/support",
        "privacyPolicyURL": "https://leasing.ai/privacy",
        "termsOfServiceURL": "https://leasing.ai/terms",
        "defaultPrompt": [
          "What apartments are available and how much is rent?",
          "When can I tour this community?",
          "What are the office hours?"
        ],
        "logo": "./assets/logo.png",
        "composerIcon": "./assets/logo.png"
      },
      "onboardingSkill": "./skills/get-started/SKILL.md",
      "review": {
        "test_cases": {
          "positive": [
            {
              "description": "Pick a community",
              "prompt": "Show me the communities I can ask about.",
              "tools_triggered": "choose_community",
              "expected_behavior": "Shows a list of communities and lets the user pick one."
            },
            {
              "description": "Prices and availability",
              "prompt": "What homes are available at Yardi Leasing Sandbox and what is the rent?",
              "tools_triggered": "get_pricing_and_availability",
              "expected_behavior": "Lists available homes with rent from the community's data, without inventing prices."
            },
            {
              "description": "Community details",
              "prompt": "What are the office hours and pet policy at Yardi Leasing Sandbox?",
              "tools_triggered": "get_property_details",
              "expected_behavior": "Answers with the community's stored office hours and pet policy, or says they are not published."
            },
            {
              "description": "Tour times",
              "prompt": "When can I tour Yardi Leasing Sandbox this week?",
              "tools_triggered": "get_tour_availability",
              "expected_behavior": "Shows open tour times in the community's time zone, or explains how to request a tour."
            },
            {
              "description": "Book a tour",
              "prompt": "Book the first open tour time for me. My name is Test Reviewer, my email is reviewer@example.com and my phone is 805-555-0100.",
              "tools_triggered": "get_tour_availability, book_tour",
              "expected_behavior": "Asks the user to allow the booking, books the tour and returns a confirmation code with the date, time and time zone."
            }
          ],
          "negative": [
            {
              "description": "Payments",
              "prompt": "Pay my rent for this month."
            },
            {
              "description": "Maintenance",
              "prompt": "Submit a maintenance request for my leaking sink."
            },
            {
              "description": "Unrelated",
              "prompt": "Write me a poem about the ocean."
            }
          ]
        },
        "commerce": false,
        "commerce_description": "LeasingAI does not sell products or process payments.",
        "demo_recording_url": "https://drive.google.com/file/d/12TMIqm4sO3rr5wCnBsL-dWR-EJdiWDZ7/view?usp=sharing"
      },
