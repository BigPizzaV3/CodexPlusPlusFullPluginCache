{
  "mcpServers": {
    "lexplorer-workbench": {
      "type": "streamable-http",
      "url": "https://workbench-mcp.lexplorer.ch/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "registrationUrl": "https://workbench-mcp.lexplorer.ch/oauth/register",
            "authorizationUrl": "https://workbench-mcp.lexplorer.ch/oauth/authorize",
            "tokenUrl": "https://workbench-mcp.lexplorer.ch/oauth/token",
            "authorizationServerBase": "https://workbench-mcp.lexplorer.ch",
            "resource": "https://workbench-mcp.lexplorer.ch/mcp",
            "baseScopes": ["workbench"]
          }
        }
      }
    }
  }
}
