{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "posteverywhere": {
      "type": "streamable-http",
      "url": "https://mcp.posteverywhere.ai/chatgpt",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "authorizationUrl": "https://app.posteverywhere.ai/api/oauth/authorize",
            "tokenUrl": "https://app.posteverywhere.ai/api/oauth/token",
            "registrationUrl": "https://app.posteverywhere.ai/api/oauth/register",
            "baseScopes": [
              "read",
              "write",
              "ai"
            ]
          }
        }
      }
    }
  }
}
