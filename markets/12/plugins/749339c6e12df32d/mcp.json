{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "zoofiai": {
      "type": "streamable-http",
      "url": "https://mcp.zoofiai.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "registrationUrl": "https://app.zoofiai.com/oauth/register",
            "authorizationUrl": "https://app.zoofiai.com/oauth/authorize",
            "tokenUrl": "https://app.zoofiai.com/oauth/token",
            "resource": "https://mcp.zoofiai.com/mcp",
            "baseScopes": [
              "openid",
              "email",
              "profile",
              "wordpress",
              "offline_access"
            ],
            "oidcEnabled": true,
            "oidcConfigurationUrl": "https://app.zoofiai.com/.well-known/openid-configuration",
            "oidcUserinfoEndpoint": "https://app.zoofiai.com/oauth/userinfo"
          }
        }
      }
    }
  }
}
