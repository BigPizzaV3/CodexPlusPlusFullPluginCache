{
  "mcpServers": {
    "notely-voice": {
      "type": "http",
      "url": "https://mcp.notelyvoice.ai/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "authorizationUrl": "https://mcp.notelyvoice.ai/mcp/oauth/bridge/authorize",
            "tokenUrl": "https://mcp.notelyvoice.ai/mcp/oauth/bridge/token",
            "registrationUrl": "https://mcp.notelyvoice.ai/mcp/oauth/register",
            "baseScopes": [
              "email"
            ]
          }
        }
      }
    }
  }
}
