{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "clout": {
      "type": "streamable-http",
      "url": "https://app.tryclout.ai/api/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": { "mode": "dcr" },
            "baseScopes": ["clout:read"],
            "defaultScopes": ["clout:read", "clout:generate"]
          }
        }
      }
    }
  }
}
