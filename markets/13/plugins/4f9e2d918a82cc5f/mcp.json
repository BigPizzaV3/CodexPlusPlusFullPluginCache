{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "somantic": {
      "type": "streamable-http",
      "url": "https://www.somantic.net/api/mcp/",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": [
              "api"
            ]
          }
        }
      }
    }
  }
}
