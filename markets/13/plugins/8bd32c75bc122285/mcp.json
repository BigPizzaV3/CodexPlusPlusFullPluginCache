{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "caute": {
      "type": "streamable-http",
      "url": "https://mcp.getcaute.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "cimd"
            },
            "defaultScopes": ["search", "items:read", "items:write", "notes:write"]
          }
        }
      }
    }
  }
}
