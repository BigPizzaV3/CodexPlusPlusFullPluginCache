{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "familyofx": {
      "type": "streamable-http",
      "url": "https://familyofx.com/api/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "familyofx-openai",
              "tokenEndpointAuthMethod": "none"
            },
            "authorizationUrl": "https://familyofx.com/api/auth/oauth2/authorize",
            "tokenUrl": "https://familyofx.com/api/auth/oauth2/token",
            "resource": "https://familyofx.com/api/mcp"
          }
        }
      }
    }
  }
}
