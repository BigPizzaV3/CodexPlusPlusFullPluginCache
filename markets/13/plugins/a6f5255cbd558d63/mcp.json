{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "solo-cloud": {
      "type": "streamable-http",
      "url": "https://solo.cloud/public/api/v1/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "https://chatgpt.com/oauth/client.json",
              "tokenEndpointAuthMethod": "none"
            },
            "authorizationUrl": "https://solo.cloud/public/api/v1/mcp/oauth/authorize",
            "tokenUrl": "https://solo.cloud/public/api/v1/mcp/oauth/token",
            "resource": "https://solo.cloud/public/api/v1/mcp",
            "baseScopes": [
              "papi"
            ],
            "oidcEnabled": false
          }
        }
      }
    }
  }
}
