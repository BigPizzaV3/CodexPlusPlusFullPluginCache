{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "ai-labs-audit": {
      "type": "streamable-http",
      "url": "https://mcp.ailabsaudit.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "authorizationServerBase": "https://mcp.ailabsaudit.com/",
            "authorizationUrl": "https://mcp.ailabsaudit.com/authorize",
            "tokenUrl": "https://mcp.ailabsaudit.com/token",
            "registrationUrl": "https://mcp.ailabsaudit.com/register",
            "resource": "https://mcp.ailabsaudit.com/mcp",
            "baseScopes": [
              "mcp:tools"
            ]
          }
        }
      }
    }
  }
}
