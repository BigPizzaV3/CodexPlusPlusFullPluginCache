{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "cashflowpot": {
      "type": "streamable-http",
      "url": "https://mcp.quollnet.com/cashflowpot",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "baseScopes": [
              "mcp:connect"
            ],
            "defaultScopes": [
              "mcp:connect"
            ],
            "authorizationUrl": "https://quollnet.com/api/oauth/authorize",
            "tokenUrl": "https://quollnet.com/api/oauth/token",
            "client": {
              "mode": "provided",
              "clientId": "chatgpt-qauth-access",
              "tokenEndpointAuthMethod": "none"
            }
          }
        }
      }
    }
  }
}
