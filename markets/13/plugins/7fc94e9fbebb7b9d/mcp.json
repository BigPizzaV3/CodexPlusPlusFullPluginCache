{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "qrwise": {
      "type": "streamable-http",
      "url": "https://api.qrwise.com/chatgpt/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "qrwise-chatgpt-production",
              "tokenEndpointAuthMethod": "client_secret_post"
            },
            "baseScopes": ["qrwise:merchant:read"],
            "defaultScopes": ["qrwise:merchant:read"]
          }
        }
      }
    }
  }
}
