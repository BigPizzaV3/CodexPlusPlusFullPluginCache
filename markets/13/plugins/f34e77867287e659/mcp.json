{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "formulio": {
      "type": "streamable-http",
      "url": "https://api.formul.io/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {"mode": "cimd"},
            "resource": "https://api.formul.io/mcp",
            "baseScopes": ["calculate", "recipes:read", "ingredients:read", "diagnose"]
          }
        }
      }
    }
  }
}
