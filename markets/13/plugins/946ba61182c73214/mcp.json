{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "bidsonar": {
      "type": "streamable-http",
      "url": "https://bidsonar.com/api/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": { "mode": "dcr" },
            "defaultScopes": ["profile", "email"],
            "oidcEnabled": false
          }
        }
      }
    }
  }
}
