{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "paply": {
      "type": "streamable-http",
      "url": "https://api.paply.app/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": { "mode": "dcr" },
            "defaultScopes": ["paply.read", "paply.drafts"]
          }
        }
      }
    }
  }
}
