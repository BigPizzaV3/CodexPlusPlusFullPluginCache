{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "flowsdesigner": {
      "type": "streamable-http",
      "url": "https://flowsdesigner.com/api/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "authorizationUrl": "https://flowsdesigner.com/oauth/authorize",
            "tokenUrl": "https://flowsdesigner.com/api/oauth/token",
            "registrationUrl": "https://flowsdesigner.com/api/oauth/register",
            "baseScopes": [
              "contacts:read",
              "conversations:read",
              "messages:read",
              "flows:read",
              "tables:read"
            ],
            "defaultScopes": [
              "contacts:read",
              "contacts:write",
              "conversations:read",
              "messages:read",
              "messages:write",
              "flows:read",
              "flows:write",
              "tables:read",
              "tables:write"
            ]
          }
        }
      }
    }
  }
}