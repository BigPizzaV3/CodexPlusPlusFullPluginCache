{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "sev": {
      "type": "streamable-http",
      "url": "https://etsquare.ai/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "sev-openai-plugin",
              "tokenEndpointAuthMethod": "none"
            },
            "resource": "https://etsquare.ai/mcp",
            "baseScopes": [
              "sev:discover",
              "sev:read_passage"
            ]
          }
        }
      }
    }
  }
}
