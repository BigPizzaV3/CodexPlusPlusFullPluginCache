{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "map-metra": {
      "type": "streamable-http",
      "url": "https://www.mapmetra.com/api/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": { "mode": "dcr" },
            "baseScopes": ["mapmetra:read", "mapmetra:propose"]
          }
        }
      }
    }
  }
}
