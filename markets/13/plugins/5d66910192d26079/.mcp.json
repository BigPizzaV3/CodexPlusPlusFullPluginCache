{
  "mcpServers": {
    "thrifted": {
      "type": "streamable-http",
      "url": "https://thrifted.mt/mcp",
      "headers": {},
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "mixed",
            "client": {
              "mode": "provided",
              "clientId": "https://chatgpt.com/oauth/client.json",
              "tokenEndpointAuthMethod": "none"
            },
            "baseScopes": [
              "profile.read",
              "listings.read"
            ],
            "authorizationUrl": "https://thrifted.mt/oauth/authorize",
            "tokenUrl": "https://thrifted.mt/oauth/token",
            "authorizationServerBase": "https://thrifted.mt",
            "resource": "https://thrifted.mt"
          }
        }
      }
    }
  }
}
