{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "rivora": {
      "type": "streamable-http",
      "url": "https://api.rivoraconnect.com.au/mcp/",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "registrationUrl": "https://api.rivoraconnect.com.au/register",
            "baseScopes": [
              "handoff:read"
            ],
            "defaultScopes": [
              "handoff:read",
              "proposal:write"
            ]
          }
        }
      }
    }
  }
}
