{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "monarch": {
      "type": "streamable-http",
      "url": "https://app.africacomputefund.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "authorizationServerBase": "https://app.africacomputefund.com",
            "authorizationUrl": "https://app.africacomputefund.com/oauth/mcp/authorize",
            "tokenUrl": "https://app.africacomputefund.com/oauth/mcp/token",
            "registrationUrl": "https://app.africacomputefund.com/oauth/mcp/register",
            "resource": "https://app.africacomputefund.com/mcp",
            "baseScopes": [
              "monarch:read"
            ],
            "defaultScopes": [
              "openid",
              "email",
              "monarch:read"
            ]
          }
        }
      }
    }
  }
}
