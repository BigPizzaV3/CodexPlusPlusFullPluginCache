{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "orvo": {
      "type": "streamable-http",
      "url": "https://www.getorvo.com/api/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "defaultScopes": [
              "mcp",
              "mcp:write"
            ],
            "oidcEnabled": false
          }
        }
      }
    }
  }
}
