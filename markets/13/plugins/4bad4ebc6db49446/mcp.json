{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "eye-photo": {
      "type": "streamable-http",
      "url": "https://eye.photo/mcp/plugin",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "mixed",
            "client": {
              "mode": "cimd"
            },
            "baseScopes": [
              "studio:read"
            ],
            "defaultScopes": [
              "studio:read"
            ]
          }
        }
      }
    }
  }
}
