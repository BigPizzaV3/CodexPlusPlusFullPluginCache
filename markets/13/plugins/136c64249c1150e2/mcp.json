{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "callpad": {
      "type": "streamable-http",
      "url": "https://chatgpt-reviewer.staging.callpad.ai/api/chatgpt/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "mixed",
            "client": {
              "mode": "provided",
              "clientId": "callpad-customer-booking",
              "tokenEndpointAuthMethod": "none"
            },
            "authorizationServerBase": "https://chatgpt-reviewer.staging.callpad.ai/realms/callpad-customers",
            "resource": "https://chatgpt-reviewer.staging.callpad.ai/api/chatgpt/mcp",
            "oidcEnabled": false,
            "oidcScopesSupported": [],
            "authorizationUrl": "https://chatgpt-reviewer.staging.callpad.ai/realms/callpad-customers/protocol/openid-connect/auth",
            "tokenUrl": "https://chatgpt-reviewer.staging.callpad.ai/realms/callpad-customers/protocol/openid-connect/token",
            "baseScopes": [
              "booking:prepare",
              "booking:create",
              "booking:status"
            ],
            "defaultScopes": [
              "booking:prepare",
              "booking:create",
              "booking:status"
            ]
          }
        }
      }
    }
  }
}
