{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "investorlists": {
      "type": "streamable-http",
      "url": "https://investorlists.vc/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "registrationUrl": "https://investorlists.vc/oauth/register",
            "resource": "https://investorlists.vc/mcp",
            "baseScopes": [
              "investors"
            ]
          }
        }
      }
    }
  }
}
