{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "deepline-openai": {
      "type": "streamable-http",
      "url": "https://code.deepline.com/api/v2/mcp/openai",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": ["deepline:mcp"]
          }
        }
      }
    }
  }
}
