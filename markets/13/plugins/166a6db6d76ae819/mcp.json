{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "bonder": {
      "type": "streamable-http",
      "url": "https://mcp.bonder.us/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": ["email"],
            "oidcEnabled": false
          }
        }
      }
    }
  }
}
