{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "rafiq": {
      "type": "streamable-http",
      "url": "https://api.rafiq-agent.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "rafiq-agent",
              "tokenEndpointAuthMethod": "none"
            },
            "baseScopes": [
              "business:read"
            ],
            "defaultScopes": [
              "replies:read",
              "replies:write",
              "business:read",
              "business:write",
              "settings:read",
              "settings:write",
              "catalog:read",
              "catalog:write",
              "conversations:read",
              "conversations:write",
              "conversations:send",
              "orders:read",
              "orders:write",
              "storefront:read",
              "storefront:write",
              "reports:read",
              "customers:read",
              "customers:write",
              "automation:read",
              "automation:write"
            ]
          }
        }
      }
    }
  }
}
