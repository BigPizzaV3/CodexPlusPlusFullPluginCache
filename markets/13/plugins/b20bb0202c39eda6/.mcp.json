{
  "mcpServers": {
    "mollkom": {
      "url": "https://connect.mollkom.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "resource": "https://connect.mollkom.com/mcp",
            "oidcEnabled": true,
            "baseScopes": [
              "openid",
              "email",
              "offline_access"
            ],
            "defaultScopes": [
              "stores:read",
              "catalog:read",
              "drafts:write",
              "integrations:read",
              "social:read",
              "social:drafts:write",
              "marketing:read",
              "marketing:drafts:write",
              "orders:read",
              "notifications:read",
              "catalog:changes:write",
              "catalog:metrics:read",
              "store:data:read",
              "catalog:manage",
              "store:manage"
            ]
          }
        }
      }
    }
  }
}
