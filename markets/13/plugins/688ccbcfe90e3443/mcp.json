{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "optiwing": {
      "type": "streamable-http",
      "url": "https://api.optiwing.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "optiwing-chatgpt",
              "tokenEndpointAuthMethod": "none"
            },
            "baseScopes": ["openid", "offline_access", "email", "optiwing:account:read", "optiwing:research"]
          }
        }
      }
    }
  }
}
