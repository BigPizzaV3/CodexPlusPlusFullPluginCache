{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "scout-data": {
      "type": "streamable-http",
      "url": "https://api-atlas.scoutdata.com/api/v1/mcp/chatgpt",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "mixed",
            "client": {
              "mode": "dcr"
            },
            "authorizationServerBase": "https://api-atlas.scoutdata.com/plugin-auth",
            "authorizationUrl": "https://api-atlas.scoutdata.com/plugin-auth/authorize",
            "tokenUrl": "https://api-atlas.scoutdata.com/plugin-auth/token",
            "registrationUrl": "https://api-atlas.scoutdata.com/plugin-auth/register",
            "resource": "https://api-atlas.scoutdata.com/api/v1/mcp/chatgpt"
          }
        }
      }
    }
  }
}