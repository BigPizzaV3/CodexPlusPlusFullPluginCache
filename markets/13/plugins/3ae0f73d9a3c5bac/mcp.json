{
	"$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
	"mcpServers": {
		"target-company-finder": {
			"type": "streamable-http",
			"url": "https://target-company-finder.jamesgunaca.com/mcp",
			"extensions": {
				"com.openai": {
					"auth": {
						"type": "mixed",
						"client": {
							"mode": "dcr"
						},
						"authorizationUrl": "https://solid-carousel-10.authkit.app/oauth2/authorize",
						"tokenUrl": "https://solid-carousel-10.authkit.app/oauth2/token",
						"registrationUrl": "https://solid-carousel-10.authkit.app/oauth2/register"
					}
				}
			}
		}
	}
}
