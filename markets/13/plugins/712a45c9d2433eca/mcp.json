{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "estii": {
      "type": "streamable-http",
      "url": "https://api.estii.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": { "mode": "dcr" },
            "defaultScopes": ["read", "read_write", "offline_access"]
          }
        }
      }
    }
  }
}
