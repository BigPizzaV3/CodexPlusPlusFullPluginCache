{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "monkandmonkey": {
      "type": "streamable-http",
      "url": "https://monkandmonkey.org/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "oidcEnabled": false,
            "client": {
              "mode": "dcr"
            },
            "authorizationServerBase": "https://monkandmonkey.org",
            "authorizationUrl": "https://monkandmonkey.org/authorize",
            "tokenUrl": "https://monkandmonkey.org/token",
            "registrationUrl": "https://monkandmonkey.org/register",
            "resource": "https://monkandmonkey.org/mcp",
            "baseScopes": [
              "read",
              "write"
            ]
          }
        }
      }
    }
  }
}
