{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "onstage": {
      "type": "streamable-http",
      "url": "https://api.on-stage.app/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "baseScopes": [
              "team:read",
              "events:read",
              "songs:read",
              "reports:read",
              "songs:write",
              "events:write",
              "files:write"
            ]
          }
        }
      }
    }
  }
}
