{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "seminai": {
      "type": "streamable-http",
      "url": "https://mcp.seminai.tech/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "resource": "https://mcp.seminai.tech/mcp",
            "baseScopes": ["seminai:read"],
            "defaultScopes": [
              "seminai:read",
              "seminai:write",
              "seminai:delete",
              "seminai:proposals",
              "seminai:execute",
              "offline_access",
              "openid",
              "email"
            ]
          }
        }
      }
    }
  }
}
