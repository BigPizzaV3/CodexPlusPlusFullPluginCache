{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "coherence": {
      "type": "streamable-http",
      "url": "https://coherence.presagetech.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "authorizationUrl": "https://coherence.presagetech.com/authorize",
            "tokenUrl": "https://coherence.presagetech.com/token",
            "authorizationServerBase": "https://coherence.presagetech.com",
            "resource": "https://coherence.presagetech.com/mcp",
            "baseScopes": [
              "coherence:mcp"
            ]
          }
        }
      }
    }
  }
}
