{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "f3d-api": {
      "type": "streamable-http",
      "url": "https://f3d.saveugene.dev/api/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "7d244c159bae9cc4cae064c6a25b7dfb23d1f71cb3fbc43313d5f73bfd706141",
              "tokenEndpointAuthMethod": "client_secret_post"
            },
            "authorizationUrl": "https://f3d.saveugene.dev/api/oauth/authorize",
            "tokenUrl": "https://f3d.saveugene.dev/api/oauth/token",
            "defaultScopes": [
              "products:read",
              "products:write",
              "recipes:read",
              "recipes:write",
              "fridge:read",
              "fridge:write",
              "diary:read",
              "diary:write"
            ]
          }
        }
      }
    }
  }
}
