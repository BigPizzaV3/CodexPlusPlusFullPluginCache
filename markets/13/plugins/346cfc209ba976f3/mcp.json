{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "copropole": {
      "type": "streamable-http",
      "url": "https://www.copropole.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "mixed",
            "client": {
              "mode": "cimd"
            },
            "resource": "https://www.copropole.com/mcp",
            "oidcEnabled": true,
            "baseScopes": [
              "profile:read",
              "copro:read",
              "copro:write"
            ]
          }
        }
      }
    }
  }
}