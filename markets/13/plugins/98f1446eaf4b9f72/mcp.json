{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "butterspace-account-connection": {
      "type": "streamable-http",
      "url": "https://app.butter.space/api/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "mixed",
            "authorizationUrl": "https://ourtacvqswcrgbtcicmx.supabase.co/auth/v1/oauth/authorize",
            "tokenUrl": "https://ourtacvqswcrgbtcicmx.supabase.co/auth/v1/oauth/token",
            "oidcConfigurationUrl": "https://ourtacvqswcrgbtcicmx.supabase.co/auth/v1/.well-known/openid-configuration",
            "client": {
              "mode": "provided",
              "clientId": "326fd5b3-4b1e-4de8-a28e-d925bc777746",
              "tokenEndpointAuthMethod": "none"
            },
            "baseScopes": ["openid"],
            "defaultScopes": ["openid"],
            "oidcEnabled": true,
            "oidcScopesSupported": ["openid"]
          }
        }
      }
    }
  }
}
