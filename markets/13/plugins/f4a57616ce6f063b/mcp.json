{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "altodocs": {
      "type": "streamable-http",
      "url": "https://app.altodocs.io/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "defaultScopes": [
              "documents:read",
              "documents:write",
              "calculations:evaluate",
              "projects:create"
            ]
          }
        }
      }
    }
  }
}
