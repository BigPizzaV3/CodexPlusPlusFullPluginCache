{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "fitness": {
      "type": "streamable-http",
      "url": "https://fitness.consuelohq.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "cimd"
            },
            "resource": "https://fitness.consuelohq.com/mcp",
            "baseScopes": [
              "fitness:read",
              "fitness:write"
            ]
          }
        }
      }
    }
  }
}
