{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "booklee": {
      "type": "streamable-http",
      "url": "https://booklee.app/api/mcp/chatgpt",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "cimd"
            },
            "resource": "https://booklee.app/api/mcp/chatgpt",
            "baseScopes": ["profile:read", "offline_access"]
          }
        }
      }
    }
  }
}
