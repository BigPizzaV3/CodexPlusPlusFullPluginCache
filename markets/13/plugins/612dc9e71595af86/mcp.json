{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "intelidress": {
      "type": "streamable-http",
      "url": "https://connect.intelidress.app/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "registrationUrl": "https://connect.intelidress.app/oauth/register",
            "baseScopes": [
              "closet.read",
              "closet.write"
            ]
          }
        }
      }
    }
  }
}
