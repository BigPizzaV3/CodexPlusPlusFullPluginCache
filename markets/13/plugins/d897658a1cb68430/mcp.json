{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "kleiobase": {
      "type": "streamable-http",
      "url": "https://kleiobase.com/api/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "cimd"
            },
            "authorizationUrl": "https://kleiobase.com/api/oauth/authorize",
            "tokenUrl": "https://kleiobase.com/api/oauth/token",
            "registrationUrl": "https://kleiobase.com/api/oauth/register",
            "authorizationServerBase": "https://kleiobase.com",
            "resource": "https://kleiobase.com/api/mcp"
          }
        }
      }
    }
  }
}
