{
  "mcpServers": {
    "chatbotgen": {
      "type": "streamable-http",
      "url": "https://www.chatbotgen.com/mcp/chatgpt",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "mixed",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": [
              "chatbots:read",
              "chatbots:write",
              "conversations:read"
            ]
          }
        }
      }
    }
  }
}
