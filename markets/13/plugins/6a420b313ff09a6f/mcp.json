{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "redline": {
      "type": "streamable-http",
      "url": "https://api.bookcicle.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "mixed",
            "client": {
              "mode": "cimd"
            },
            "resource": "https://api.bookcicle.com",
            "baseScopes": [],
            "defaultScopes": [
              "redline.comparison.write"
            ]
          }
        }
      }
    }
  }
}
