{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "postologic": {
      "type": "streamable-http",
      "url": "https://posts.poweredbyconcierge.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": { "mode": "dcr" },
            "resource": "https://posts.poweredbyconcierge.com/mcp",
            "baseScopes": ["workspaces.read", "offline_access"],
            "defaultScopes": [
              "accounts.read",
              "posts.read",
              "posts.write",
              "posts.schedule"
            ]
          }
        }
      }
    }
  }
}
