{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "screenhance": {
      "type": "streamable-http",
      "url": "https://app.screenhance.com/api/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "screenhance-chatgpt",
              "tokenEndpointAuthMethod": "none"
            },
            "baseScopes": [
              "launch:read",
              "launch:write",
              "launch:render"
            ],
            "resource": "https://app.screenhance.com/api/mcp"
          }
        }
      }
    }
  }
}
