{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "stitch-companion": {
      "type": "streamable-http",
      "url": "https://stitch-companion.workshop.ideasallday.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "https://chatgpt.com/oauth/client.json",
              "tokenEndpointAuthMethod": "none"
            },
            "resource": "https://stitch-companion.workshop.ideasallday.com/mcp",
            "baseScopes": [
              "offline_access"
            ],
            "defaultScopes": [
              "stitch-companion:use"
            ],
            "authorizationUrl": "https://workshop.ideasallday.com/api/auth/oauth2/authorize",
            "tokenUrl": "https://workshop.ideasallday.com/api/auth/oauth2/token",
            "authorizationServerBase": "https://workshop.ideasallday.com/api/auth"
          }
        }
      }
    }
  }
}
