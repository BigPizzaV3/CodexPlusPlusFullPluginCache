{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "qrmenu": {
      "type": "streamable-http",
      "url": "https://qrmenu.evdsoft.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": { "mode": "dcr" },
            "resource": "https://qrmenu.evdsoft.com/mcp",
            "baseScopes": ["qrmenu:read"],
            "defaultScopes": ["qrmenu:write"],
            "oidcEnabled": false
          }
        }
      }
    }
  }
}
