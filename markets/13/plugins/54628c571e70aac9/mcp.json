{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "rentahuman_workspace": {
      "type": "streamable-http",
      "url": "https://rentahuman.ai/api/mcp/chatgpt",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "resource": "https://rentahuman.ai/api/mcp/chatgpt",
            "baseScopes": [
              "mcp:read"
            ],
            "defaultScopes": [
              "mcp:read"
            ]
          }
        }
      }
    }
  }
}
