{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "leadlyze": {
      "type": "streamable-http",
      "url": "https://app.leadlyze.com/api/v1/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "defaultScopes": [
              "leads",
              "contacts",
              "companies",
              "deals",
              "tasks"
            ],
            "authorizationUrl": "https://app.leadlyze.com/api/v1/oauth/authorize",
            "registrationUrl": "https://app.leadlyze.com/api/v1/oauth/register",
            "tokenUrl": "https://app.leadlyze.com/api/v1/oauth/token"
          }
        }
      }
    }
  }
}
