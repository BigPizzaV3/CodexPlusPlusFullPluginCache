{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "blu": {
      "type": "streamable-http",
      "url": "https://api.bluleadership.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "defaultScopes": [
              "blu.context.read",
              "blu.company.read",
              "blu.initiative.read",
              "blu.initiative.write",
              "blu.target.read",
              "blu.target.write",
              "blu.individual_goal.read",
              "blu.weekly_game_plan.read",
              "blu.weekly_game_plan.write",
              "blu.file.read",
              "blu.file.write",
              "blu.context.write"
            ]
          }
        }
      }
    }
  }
}
