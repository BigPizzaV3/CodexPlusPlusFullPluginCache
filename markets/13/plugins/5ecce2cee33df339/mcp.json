{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "superpost": {
      "type": "streamable-http",
      "url": "https://superpost.social/api/v1/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "defaultScopes": [
              "read",
              "preview",
              "propose",
              "review",
              "draft",
              "schedule",
              "publish",
              "import",
              "openid",
              "profile",
              "email"
            ]
          }
        }
      }
    }
  }
}
