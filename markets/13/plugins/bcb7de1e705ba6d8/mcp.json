{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "revor-ai": {
      "type": "streamable-http",
      "url": "https://revor.ai/api/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": { "mode": "dcr" },
            "baseScopes": [
              "mcp:identity.read", "mcp:jobs.read", "mcp:websets.read",
              "mcp:websets.write", "mcp:research.write", "mcp:contacts.write",
              "mcp:customs.write", "mcp:billing.read", "mcp:connect.read",
              "mcp:outreach.write", "mcp:jobs.write", "offline_access"
            ]
          }
        }
      }
    }
  }
}
