{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "houndtrust": {
      "type": "streamable-http",
      "url": "https://houndtrust.com/api/plugin/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "mixed",
            "client": {
              "mode": "dcr"
            },
            "registrationUrl": "https://houndtrust.com/api/plugin/oauth/register",
            "authorizationServerBase": "https://houndtrust.com",
            "resource": "https://houndtrust.com/api/plugin/mcp",
            "oidcEnabled": false
          }
        }
      }
    }
  }
}
