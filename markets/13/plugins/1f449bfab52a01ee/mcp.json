{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "convertee-ai-studio": {
      "type": "streamable-http",
      "url": "https://login.convertee.cz/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": { "mode": "dcr" },
            "baseScopes": ["newsletter:build", "offline_access"],
            "defaultScopes": ["newsletter:build", "newsletter:edit", "offline_access"]
          }
        }
      }
    }
  }
}
