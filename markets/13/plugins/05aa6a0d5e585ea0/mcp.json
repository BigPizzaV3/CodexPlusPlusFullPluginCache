{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "harvest": {
      "type": "streamable-http",
      "url": "https://api.harvestapp.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "registrationUrl": "https://id.getharvest.com/oauth2/registrations",
            "resource": "https://api.harvestapp.com/mcp"
          }
        }
      }
    }
  }
}
