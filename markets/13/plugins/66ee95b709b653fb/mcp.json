{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "flywheel": {
      "type": "streamable-http",
      "url": "https://flywheeldayone.com/mcp/calculator/",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "mixed",
            "client": {
              "mode": "dcr"
            },
            "resource": "https://flywheeldayone.com/mcp/calculator/",
            "baseScopes": [
              "offline_access"
            ],
            "defaultScopes": [
              "openid"
            ],
            "oidcEnabled": false,
            "oidcScopesSupported": []
          }
        }
      }
    }
  }
}
