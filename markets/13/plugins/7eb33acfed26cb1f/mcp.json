{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "nesis": {
      "type": "streamable-http",
      "url": "https://api.nesis.cl/mcp/paginas",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "nesis-paginas-chatgpt",
              "tokenEndpointAuthMethod": "none"
            },
            "baseScopes": [
              "paginas:leer",
              "paginas:editar",
              "paginas:publicar",
              "reservas:configurar",
              "agenda:leer",
              "agenda:gestionar"
            ]
          }
        }
      }
    }
  }
}
