{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "grapemail": {
      "type": "streamable-http",
      "url": "https://connect.grapemailserver.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": [
              "openid",
              "email",
              "offline_access"
            ],
            "defaultScopes": [
              "mail.read",
              "mail.drafts",
              "mail.send"
            ],
            "oidcEnabled": true
          }
        }
      }
    }
  }
}
