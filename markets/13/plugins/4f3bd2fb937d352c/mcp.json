{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "activitymessenger": {
      "type": "streamable-http",
      "url": "https://activitymessenger.com/api/mcp/openai",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "activitymessenger-openai",
              "tokenEndpointAuthMethod": "none"
            },
            "baseScopes": [
              "am:read"
            ],
            "resource": "https://activitymessenger.com/api/mcp/openai"
          }
        }
      }
    }
  }
}
