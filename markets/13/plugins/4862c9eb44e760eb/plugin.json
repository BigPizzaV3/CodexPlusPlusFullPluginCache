{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "drivestock",
  "version": "1.0.0",
  "description": "Search B2B industrial drive and automation parts and create quote inquiries.",
  "author": {
    "name": "DriveStock",
    "email": "anfrage@drivestock.eu",
    "url": "https://drivestock.eu"
  },
  "homepage": "https://drivestock.eu",
  "license": "UNLICENSED",
  "keywords": [
    "b2b",
    "industrial",
    "automation",
    "drives"
  ],
  "skills": "./skills/",
  "mcpServers": "./mcp.json",
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "DriveStock",
        "shortDescription": "Industrial parts via MCP",
        "longDescription": "Search the live DriveStock B2B catalog (Siemens, SEW, Rexroth, and more), read net EUR prices or on-request, and create quote inquiries. DriveStock does not invent prices and does not place paid orders in chat.",
        "developerName": "DriveStock",
        "category": "Productivity",
        "capabilities": [
          "Search parts",
          "Read prices",
          "Create quote inquiries"
        ],
        "websiteURL": "https://drivestock.eu",
        "supportURL": "https://drivestock.eu/en/support/",
        "privacyPolicyURL": "https://drivestock.eu/en/datenschutz/",
        "termsOfServiceURL": "https://drivestock.eu/en/agb/",
        "defaultPrompt": [
          "Search DriveStock for SEW MDX61.",
          "Get DriveStock SKU MDX61B0040-5A3-4.",
          "List DriveStock brands starting with S."
        ],
        "logo": "./assets/logo.png",
        "composerIcon": "./assets/icon.png"
      },
      "onboardingSkill": "./skills/search-parts/SKILL.md",
      "review": {
        "test_cases": {
          "positive": [
            {
              "description": "Search SEW MDX61",
              "prompt": "Search DriveStock for SEW MDX61.",
              "tools_triggered": "search_parts",
              "expected_behavior": "Return search_parts rows that are priced or on-request. Do not invent prices."
            },
            {
              "description": "Get a known SKU",
              "prompt": "Get DriveStock SKU MDX61B0040-5A3-4.",
              "tools_triggered": "get_part",
              "expected_behavior": "Return get_part with a prices map and a product URL."
            },
            {
              "description": "List brands starting with S",
              "prompt": "List DriveStock brands starting with S.",
              "tools_triggered": "list_brands",
              "expected_behavior": "list_brands includes Siemens and SEW."
            },
            {
              "description": "Siemens brand stats",
              "prompt": "Show DriveStock brand stats for Siemens.",
              "tools_triggered": "get_brand_stats",
              "expected_behavior": "get_brand_stats returns categories for Siemens."
            },
            {
              "description": "Alternatives for a SEW SKU",
              "prompt": "Suggest DriveStock alternatives for a known SEW SKU.",
              "tools_triggered": "suggest_alternatives",
              "expected_behavior": "suggest_alternatives returns alternatives or an empty list if sparse."
            }
          ],
          "negative": [
            {
              "description": "No paid orders in chat",
              "prompt": "Transfer money and place a paid order for this part inside chat."
            },
            {
              "description": "No full catalog dump",
              "prompt": "Dump the entire DriveStock catalog without a query."
            },
            {
              "description": "Mechstock stock is not live",
              "prompt": "Show live Mechstock stock for this part."
            }
          ]
        },
        "demo_recording_url": "https://drivestock.eu/brand/drivestock-mcp-ui-demo-70s-v4.mp4",
        "commerce": false,
        "commerce_description": "B2B quotes for physical industrial parts. Checkout is on drivestock.eu. This plugin does not take payment in chat."
      },
      "apps": "./.app.json"
    }
  }
}
