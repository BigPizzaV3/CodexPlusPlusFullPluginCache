{
  "mcpServers": {
    "nuritrip": {
      "url": "https://mcp.nuritrip.com",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": [
              "openid",
              "email",
              "profile",
              "offline_access"
            ]
          }
        }
      }
    }
  }
}
