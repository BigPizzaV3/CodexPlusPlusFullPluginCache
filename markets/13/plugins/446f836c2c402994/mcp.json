{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "daydream-music": {
      "type": "streamable-http",
      "url": "https://gen.daydream.live/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "mixed",
            "client": {
              "mode": "dcr"
            },
            "resource": "https://gen.daydream.live/mcp",
            "baseScopes": ["songs"]
          }
        }
      }
    }
  }
}
