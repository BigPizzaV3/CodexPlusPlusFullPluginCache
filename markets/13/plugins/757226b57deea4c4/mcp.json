{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "optimate": {
      "type": "streamable-http",
      "url": "https://www.optimatesocial.com/api/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "resource": "https://www.optimatesocial.com/api/mcp",
            "baseScopes": [
              "optimate.read",
              "optimate.write"
            ]
          }
        }
      }
    }
  }
}