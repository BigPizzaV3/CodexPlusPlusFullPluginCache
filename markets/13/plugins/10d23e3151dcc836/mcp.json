{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "astroanamnesis": {
      "type": "streamable-http",
      "url": "https://astroanamnesis.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "astro-chatgpt-production-20261009",
              "tokenEndpointAuthMethod": "none"
            },
            "resource": "https://astroanamnesis.com/mcp",
            "baseScopes": [
              "astroanamnesis:method"
            ],
            "authorizationUrl": "https://astroanamnesis.com/oauth/authorize",
            "tokenUrl": "https://astroanamnesis.com/oauth/token",
            "defaultScopes": [
              "astroanamnesis:method",
              "astroanamnesis:charts:read",
              "astroanamnesis:notebook:draft",
              "astroanamnesis:notebook:read",
              "astroanamnesis:charts:calculate"
            ]
          }
        }
      }
    }
  }
}
