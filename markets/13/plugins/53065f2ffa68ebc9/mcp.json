{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "agriax": {
      "type": "streamable-http",
      "url": "https://portal.agri.ax/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "agriax-chatgpt",
              "tokenEndpointAuthMethod": "client_secret_basic"
            },
            "resource": "https://portal.agri.ax/mcp",
            "baseScopes": [
              "account:self:read"
            ],
            "oidcEnabled": false
          }
        }
      }
    }
  }
}
