{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "argautos": {
      "type": "streamable-http",
      "url": "https://argautos.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "authorizationUrl": "https://argautos.com/oauth/authorize",
            "tokenUrl": "https://argautos.com/oauth/token",
            "registrationUrl": "https://argautos.com/oauth/register",
            "resource": "https://argautos.com/mcp",
            "defaultScopes": [
              "catalogo:leer",
              "precios:leer",
              "cuota:leer"
            ]
          }
        }
      }
    }
  }
}
