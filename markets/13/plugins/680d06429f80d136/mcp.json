{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "noise": {
      "type": "streamable-http",
      "url": "https://talktodata.navines.com/mcp/noise",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "https://chatgpt.com/oauth/client.json",
              "tokenEndpointAuthMethod": "none"
            },
            "baseScopes": ["noise.manage"],
            "defaultScopes": ["noise.manage"]
          }
        }
      }
    }
  }
}
