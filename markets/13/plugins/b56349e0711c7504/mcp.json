{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "monthwe": {
      "type": "streamable-http",
      "url": "https://our-month-public.our-month.workers.dev/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {"mode": "dcr"},
            "authorizationUrl": "https://our-month-public.our-month.workers.dev/mcp/authorize",
            "tokenUrl": "https://our-month-public.our-month.workers.dev/mcp/token",
            "registrationUrl": "https://our-month-public.our-month.workers.dev/mcp/register",
            "authorizationServerBase": "https://our-month-public.our-month.workers.dev",
            "resource": "https://our-month-public.our-month.workers.dev/mcp",
            "baseScopes": ["budget:read"],
            "defaultScopes": ["budget:read", "import:write"],
            "oidcEnabled": false
          }
        }
      }
    }
  }
}
