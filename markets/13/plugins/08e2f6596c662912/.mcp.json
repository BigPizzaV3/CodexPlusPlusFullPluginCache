{
    "mcpServers": {
        "hansan-mes": {
            "type": "http",
            "url": "https://hansan.baseon.ai/api/mcp",
            "extensions": {
                "com.openai": {
                    "auth": {
                        "type": "oauth",
                        "client": {
                            "mode": "dcr"
                        },
                        "authorizationUrl": "https://hansan.baseon.ai/mcp/oauth/authorize",
                        "tokenUrl": "https://hansan.baseon.ai/api/mcp/oauth/token",
                        "registrationUrl": "https://hansan.baseon.ai/api/mcp/oauth/register"
                    }
                }
            }
        }
    }
}
