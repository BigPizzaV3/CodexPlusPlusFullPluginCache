{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "soulnests": {
      "type": "streamable-http",
      "url": "https://soulnests.com/api/chatgpt/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "mixed",
            "client": {
              "mode": "provided",
              "clientId": "soulnests-chatgpt",
              "tokenEndpointAuthMethod": "none"
            },
            "authorizationUrl": "https://soulnests.com/api/chatgpt/oauth/authorize",
            "tokenUrl": "https://soulnests.com/api/chatgpt/oauth/token",
            "resource": "https://soulnests.com/api/chatgpt/mcp",
            "baseScopes": [
              "soulnests:profile",
              "meditations:create",
              "meditations:read",
              "quizzes:save",
              "quizzes:read"
            ]
          }
        }
      }
    }
  }
}
