{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "fluxmicro": {
      "type": "streamable-http",
      "url": "https://mcp.fluxmicro.fr/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "registrationUrl": "https://fluxmicro.fr/api/mcp/oauth/register",
            "baseScopes": [
              "fluxmicro:read",
              "fluxmicro:write",
              "fluxmicro:send",
              "fluxmicro:settings"
            ]
          }
        }
      }
    }
  }
}
