{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "sellfy": {
      "type": "streamable-http",
      "url": "https://api.sellfy.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {"mode": "dcr"},
            "baseScopes": ["mcp:read", "mcp:write"],
            "defaultScopes": ["mcp:read", "mcp:write"]
          }
        }
      }
    }
  }
}
