{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "superlift": {
      "type": "streamable-http",
      "url": "https://app.superlift.uk/api/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "superlift_chatgpt",
              "tokenEndpointAuthMethod": "none"
            },
            "authorizationUrl": "https://app.superlift.uk/?mcp_connect=1",
            "tokenUrl": "https://app.superlift.uk/api/mcp-oauth?action=token",
            "resource": "https://app.superlift.uk/api/mcp"
          }
        }
      }
    }
  }
}
