{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "zopley": {
      "type": "streamable-http",
      "url": "https://zopley.com/api/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "mixed",
            "client": {
              "mode": "provided",
              "clientId": "zopley-chatgpt",
              "tokenEndpointAuthMethod": "none"
            },
            "authorizationUrl": "https://www.zopley.com/oauth/authorize",
            "tokenUrl": "https://www.zopley.com/api/oauth/token",
            "resource": "https://zopley.com/api/mcp",
            "baseScopes": ["dashboard:read", "offline_access"],
            "defaultScopes": [
              "dashboard:read",
              "profile:write",
              "notifications:write",
              "library:write",
              "rooms:write",
              "offline_access"
            ]
          }
        }
      }
    }
  }
}
