{
  "mcpServers": {
    "1tapedit": {
      "type": "streamable-http",
      "url": "https://1tapedit.com/api/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "chatgpt_1tapedit_plugin",
              "tokenEndpointAuthMethod": "none"
            },
            "authorizationUrl": "https://1tapedit.com/oauth/authorize",
            "tokenUrl": "https://1tapedit.com/api/oauth/token",
            "baseScopes": [
              "media:generate"
            ]
          }
        }
      }
    }
  }
}
