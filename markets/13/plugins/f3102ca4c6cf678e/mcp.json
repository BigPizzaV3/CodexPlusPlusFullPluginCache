{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "chattube": {
      "type": "streamable-http",
      "url": "https://chattube.io/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "mixed",
            "client": {
              "mode": "provided",
              "clientId": "chattube-chatgpt",
              "tokenEndpointAuthMethod": "client_secret_basic"
            },
            "authorizationServerBase": "https://chattube.io",
            "resource": "https://chattube.io/mcp",
            "baseScopes": [
              "youtube.read"
            ]
          }
        }
      }
    }
  }
}
