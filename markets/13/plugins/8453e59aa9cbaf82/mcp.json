{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "pagelantern": {
      "type": "streamable-http",
      "url": "https://pagelantern.com/api/chatgpt/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "pagelantern-chatgpt",
              "tokenEndpointAuthMethod": "none"
            },
            "authorizationUrl": "https://pagelantern.com/api/chatgpt/oauth/authorize",
            "tokenUrl": "https://pagelantern.com/api/chatgpt/oauth/token",
            "authorizationServerBase": "https://pagelantern.com",
            "resource": "https://pagelantern.com/api/chatgpt/mcp",
            "baseScopes": [
              "monitors:read",
              "reports:read"
            ],
            "defaultScopes": [
              "monitors:read",
              "reports:read"
            ]
          }
        }
      }
    }
  }
}
