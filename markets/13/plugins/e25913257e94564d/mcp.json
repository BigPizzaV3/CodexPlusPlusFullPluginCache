{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "mostly-recipes": {
      "type": "streamable-http",
      "url": "https://mostly.recipes/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": [
              "recipes:inbox"
            ],
            "defaultScopes": [
              "recipes:inbox",
              "offline_access"
            ],
            "authorizationUrl": "https://mostly.recipes/api/auth/oauth2/authorize",
            "tokenUrl": "https://mostly.recipes/api/auth/oauth2/token",
            "registrationUrl": "https://mostly.recipes/api/auth/oauth2/register"
          }
        }
      }
    }
  }
}
