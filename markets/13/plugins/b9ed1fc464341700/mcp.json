{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "rbbt-lab": {
      "type": "streamable-http",
      "url": "https://platform.rbbtlab.ai/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": { "mode": "cimd" },
            "baseScopes": ["sales.observe", "offline_access"],
            "defaultScopes": ["sales.observe", "sales.operate", "sales.configure", "offline_access"]
          }
        }
      }
    }
  }
}
