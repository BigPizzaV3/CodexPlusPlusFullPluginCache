{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "flitware": {
      "type": "streamable-http",
      "url": "https://api.flitware.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "authorizationUrl": "https://api.flitware.com/api/mcp/oauth/authorize",
            "tokenUrl": "https://api.flitware.com/api/mcp/oauth/token",
            "registrationUrl": "https://api.flitware.com/api/mcp/oauth/register",
            "authorizationServerBase": "https://api.flitware.com/mcp",
            "resource": "https://api.flitware.com/mcp",
            "baseScopes": [
              "mcp:fleets:read",
              "mcp:services:read",
              "mcp:services:write",
              "mcp:maintenance:read",
              "mcp:maintenance:write",
              "mcp:documents:read",
              "mcp:checklists:read",
              "mcp:checklists:write",
              "mcp:support:read",
              "mcp:support:write",
              "mcp:billing:read",
              "mcp:templates:exec",
              "mcp:driver:read",
              "mcp:contact:read",
              "offline_access"
            ]
          }
        }
      }
    }
  }
}
