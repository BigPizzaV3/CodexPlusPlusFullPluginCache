{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "dp-tienda-online": {
      "type": "streamable-http",
      "url": "https://dptiendaonline.com/mcp/openai",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "cimd"
            },
            "baseScopes": ["tienda:read"],
            "defaultScopes": ["tienda:read", "tienda:write"]
          }
        }
      }
    }
  }
}
