{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "sottaku": {
      "type": "streamable-http",
      "url": "https://sottaku.app/integrations/chatgpt/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {"mode": "provided", "clientId": "sottaku-chatgpt", "tokenEndpointAuthMethod": "none"},
            "authorizationUrl": "https://sottaku.app/integrations/chatgpt/authorize",
            "tokenUrl": "https://sottaku.app/integrations/chatgpt/token",
            "resource": "https://sottaku.app/integrations/chatgpt/mcp",
            "baseScopes": ["learning:read"],
            "defaultScopes": ["learning:read", "learning:write"]
          }
        }
      }
    }
  }
}
