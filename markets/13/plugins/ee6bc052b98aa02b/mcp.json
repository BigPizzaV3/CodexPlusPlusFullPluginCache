{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "sol": {
      "type": "streamable-http",
      "url": "https://sol.inspiria.co.il/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": { "mode": "provided", "clientId": "aibot", "tokenEndpointAuthMethod": "none" },
            "authorizationServerBase": "https://ws1.inspiria.co.il/",
            "authorizationUrl": "https://ws1.inspiria.co.il/connect/authorize",
            "tokenUrl": "https://ws1.inspiria.co.il/connect/token",
            "resource": "https://sol.inspiria.co.il/mcp",
            "baseScopes": ["openid"],
            "defaultScopes": ["openid", "offline_access"]
          }
        }
      }
    }
  }
}
