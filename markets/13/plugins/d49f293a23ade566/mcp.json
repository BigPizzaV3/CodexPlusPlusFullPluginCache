{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "runta": {
      "type": "streamable-http",
      "url": "https://mcp.runta.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "cimd"
            },
            "baseScopes": ["runtime:read", "runtime:manage"]
          }
        }
      }
    }
  }
}
