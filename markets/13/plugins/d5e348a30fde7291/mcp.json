{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "tunio": {
      "type": "streamable-http",
      "url": "https://mcp.tunio.ai/mcp/chatgpt",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "registrationUrl": "https://auth.tunio.ai/oauth2/register",
            "baseScopes": [
              "api:read",
              "api:write"
            ]
          }
        }
      }
    }
  }
}