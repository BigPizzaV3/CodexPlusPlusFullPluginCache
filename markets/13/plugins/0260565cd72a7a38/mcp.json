{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "tuneintime": {
      "type": "streamable-http",
      "url": "https://www.tuneintime.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "mixed",
            "client": { "mode": "cimd" },
            "authorizationServerBase": "https://www.tuneintime.com",
            "authorizationUrl": "https://www.tuneintime.com/oauth/authorize",
            "tokenUrl": "https://www.tuneintime.com/api/oauth/token",
            "registrationUrl": "https://www.tuneintime.com/api/oauth/register",
            "resource": "https://www.tuneintime.com/mcp",
            "baseScopes": ["pianos"],
            "oidcEnabled": false
          }
        }
      }
    }
  }
}
