{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "kitabh": {
      "type": "streamable-http",
      "url": "https://mcp.kitabh.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": { "mode": "cimd" },
            "baseScopes": ["mcp:read", "mcp:tools"]
          }
        }
      }
    }
  }
}
