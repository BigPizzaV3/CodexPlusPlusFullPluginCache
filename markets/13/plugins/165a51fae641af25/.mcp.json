{
  "mcpServers": {
    "alium": {
      "type": "http",
      "url": "https://app.alium.io/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": ["read_transcripts"]
          }
        }
      }
    }
  }
}
