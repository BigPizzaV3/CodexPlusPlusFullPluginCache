{
  "mcpServers": {
    "julius": {
      "type": "streamable-http",
      "url": "https://mcp.julius.ai/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "authorizationServerBase": "https://auth.julius.ai/",
            "authorizationUrl": "https://auth.julius.ai/authorize",
            "tokenUrl": "https://auth.julius.ai/oauth/token",
            "registrationUrl": "https://auth.julius.ai/oidc/register",
            "resource": "https://mcp.julius.ai/mcp",
            "baseScopes": [
              "mcp:connect"
            ]
          }
        }
      }
    }
  },
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json"
}
