{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "event-network": {
      "type": "streamable-http",
      "url": "https://mcp.eventnetwork.eu/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "mixed",
            "client": {
              "mode": "dcr"
            },
            "authorizationServerBase": "https://auth.newsystems.pl",
            "resource": "https://mcp.eventnetwork.eu/mcp",
            "oidcEnabled": true,
            "oidcScopesSupported": [
              "openid"
            ],
            "baseScopes": [
              "openid",
              "eventnetwork:read"
            ]
          }
        }
      }
    }
  }
}
