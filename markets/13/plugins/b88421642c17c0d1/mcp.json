{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "questionpunk": {
      "type": "streamable-http",
      "url": "https://app.questionpunk.com/api/v1",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "resource": "https://app.questionpunk.com/api/v1",
            "baseScopes": [
              "read",
              "write",
              "responses:read"
            ]
          }
        }
      }
    }
  }
}
