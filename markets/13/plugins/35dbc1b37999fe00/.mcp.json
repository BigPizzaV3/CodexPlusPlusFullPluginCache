{
  "mcpServers": {
    "shape": {
      "type": "streamable-http",
      "url": "https://shapecalendar.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "registrationUrl": "https://shapecalendar.com/oauth/register",
            "authorizationUrl": "https://shapecalendar.com/oauth/authorize",
            "tokenUrl": "https://shapecalendar.com/oauth/token",
            "resource": "https://shapecalendar.com/mcp",
            "baseScopes": [
              "mcp"
            ]
          }
        }
      }
    }
  }
}
