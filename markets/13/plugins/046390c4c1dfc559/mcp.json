{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "findability": {
      "type": "streamable-http",
      "url": "https://app.humanforward.io/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "registrationUrl": "https://app.humanforward.io/oauth/register",
            "authorizationUrl": "https://app.humanforward.io/oauth/authorize",
            "tokenUrl": "https://app.humanforward.io/oauth/token",
            "resource": "https://app.humanforward.io/mcp",
            "baseScopes": ["findability:read", "findability:run"]
          }
        }
      }
    }
  }
}
