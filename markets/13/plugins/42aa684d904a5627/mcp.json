{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "xpress-bi": {
      "extensions": {
        "com.openai": {
          "auth": {
            "oidcConfigurationUrl": "https://identity.technosoftcr.com/.well-known/openid-configuration",
            "authorizationUrl": "https://identity.technosoftcr.com/connect/authorize",
            "tokenUrl": "https://identity.technosoftcr.com/connect/token",
            "authorizationServerBase": "https://identity.technosoftcr.com/",
            "client": {
              "mode": "provided",
              "clientId": "chatgpt-xpressbi",
              "tokenEndpointAuthMethod": "none"
            },
            "oidcEnabled": true,
            "defaultScopes": [
              "openid",
              "profile",
              "offline_access",
              "xpressbi.read"
            ],
            "resource": "https://bimcp.technosoftcr.com/mcp",
            "type": "oauth"
          }
        }
      },
      "type": "streamable-http",
      "url": "https://bimcp.technosoftcr.com/mcp"
    }
  }
}