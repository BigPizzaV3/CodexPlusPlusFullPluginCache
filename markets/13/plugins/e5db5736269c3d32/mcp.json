{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "kuotia": {
      "type": "streamable-http",
      "url": "https://kuotia.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "mixed",
            "client": {
              "mode": "cimd"
            },
            "defaultScopes": [
              "kuotia:gestoria:read",
              "kuotia:gestoria:write"
            ]
          }
        }
      }
    }
  }
}
