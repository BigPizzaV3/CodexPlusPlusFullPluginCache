{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "affilisend": {
      "type": "streamable-http",
      "url": "https://affilisend.com.br/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": { "mode": "cimd" },
            "authorizationServerBase": "https://affilisend.com.br/oidc",
            "authorizationUrl": "https://affilisend.com.br/oidc/auth",
            "tokenUrl": "https://affilisend.com.br/oidc/token",
            "oidcConfigurationUrl": "https://affilisend.com.br/oidc/.well-known/openid-configuration",
            "resource": "https://affilisend.com.br/mcp",
            "baseScopes": ["affilisend:read", "offline_access"]
          }
        }
      }
    }
  }
}
