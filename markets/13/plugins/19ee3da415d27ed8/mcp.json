{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "cvrack": {
      "type": "streamable-http",
      "url": "https://api.cvrack.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "cimd"
            },
            "resource": "https://api.cvrack.com/mcp",
          "authorizationUrl": "https://api.cvrack.com/oauth/authorize",
          "tokenUrl": "https://api.cvrack.com/oauth/token",
            "baseScopes": ["resumes:read", "resumes:drafts:write"]
          }
        }
      }
    }
  }
}
