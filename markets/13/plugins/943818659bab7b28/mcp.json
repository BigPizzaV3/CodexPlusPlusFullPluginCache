{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "cvember": {
      "type": "streamable-http",
      "url": "https://mcp.cvember.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "mixed",
            "client": {
              "mode": "cimd"
            },
            "authorizationUrl": "https://cvember.com/oauth/authorize",
            "tokenUrl": "https://cvember.com/oauth/token",
            "authorizationServerBase": "https://cvember.com",
            "resource": "https://mcp.cvember.com/mcp",
            "baseScopes": [
              "read",
              "drafts",
              "offline_access"
            ]
          }
        }
      }
    }
  }
}