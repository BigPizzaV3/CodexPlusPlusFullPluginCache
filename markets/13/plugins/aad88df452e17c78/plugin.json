        "commerce_description": "No payments, purchases or paid features are implemented in this application.",
        "test_cases": {
          "positive": [
            {
              "description": "\u041d\u0430\u0447\u0430\u0442\u044c \u043d\u043e\u0432\u044b\u0439 \u0440\u0430\u0437\u0433\u043e\u0432\u043e\u0440. \u0418\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c \u0432\u044b\u043c\u044b\u0448\u043b\u0435\u043d\u043d\u044b\u0435 \u0434\u0430\u043d\u043d\u044b\u0435: \u0431\u043b\u043e\u0433 \u043d\u0443\u0442\u0440\u0438\u0446\u0438\u043e\u043b\u043e\u0433\u0430, \u0432\u0437\u0440\u043e\u0441\u043b\u044b\u0435 \u0441 \u043f\u043b\u043e\u0442\u043d\u044b\u043c \u0433\u0440\u0430\u0444\u0438\u043a\u043e\u043c, \u0443\u0447\u0435\u0431\u043d\u044b\u0439 \u043f\u0440\u0430\u043a\u0442\u0438\u043a\u0443\u043c \u0431\u0435\u0437 \u0443\u043a\u0430\u0437\u0430\u043d\u043d\u043e\u0439 \u0446\u0435\u043d\u044b. \u0421\u043e\u0437\u0434\u0430\u0442\u044c \u043f\u0435\u0440\u0438\u043e\u0434 1\u201314 \u043d\u043e\u044f\u0431\u0440\u044f 2026 \u0433\u043e\u0434\u0430.",
              "prompt": "\u041f\u043e\u0434\u0433\u043e\u0442\u043e\u0432\u044c \u0442\u0435\u043a\u0443\u0449\u0438\u0439 \u043a\u043e\u043d\u0442\u0435\u043d\u0442-\u043f\u043b\u0430\u043d \u043d\u0430 1\u201314 \u043d\u043e\u044f\u0431\u0440\u044f 2026 \u0433\u043e\u0434\u0430 \u0434\u043b\u044f \u0443\u0447\u0435\u0431\u043d\u043e\u0433\u043e \u043f\u0440\u0430\u043a\u0442\u0438\u043a\u0443\u043c\u0430 \u043e \u043f\u0440\u043e\u0441\u0442\u044b\u0445 \u0437\u0430\u0432\u0442\u0440\u0430\u043a\u0430\u0445. \u0410\u0443\u0434\u0438\u0442\u043e\u0440\u0438\u044f: \u0432\u0437\u0440\u043e\u0441\u043b\u044b\u0435 \u0441 \u043f\u043b\u043e\u0442\u043d\u044b\u043c \u0433\u0440\u0430\u0444\u0438\u043a\u043e\u043c. \u0426\u0435\u043d\u044b \u0438 \u043e\u0442\u0437\u044b\u0432\u044b \u043d\u0435 \u043f\u0440\u0438\u0434\u0443\u043c\u044b\u0432\u0430\u0439. \u0414\u043e\u0431\u0430\u0432\u044c \u0434\u0432\u0435 \u043a\u0430\u0440\u0442\u043e\u0447\u043a\u0438: \u0437\u043d\u0430\u043a\u043e\u043c\u0441\u0442\u0432\u043e 2 \u043d\u043e\u044f\u0431\u0440\u044f \u0438 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u0443 4 \u043d\u043e\u044f\u0431\u0440\u044f. \u041e\u0442\u043a\u0440\u043e\u0439 \u0440\u0435\u0434\u0430\u043a\u0442\u043e\u0440.",
              "tools_triggered": "create_content_draft, edit_content_draft, open_content_draft",
              "expected_behavior": "\u0421\u043e\u0437\u0434\u0430\u043d draft \u0441 \u043e\u0434\u043d\u0438\u043c \u043f\u043b\u0430\u043d\u043e\u043c, \u0443\u043d\u0438\u043a\u0430\u043b\u044c\u043d\u044b\u043c\u0438 id \u0438 \u0434\u0432\u0443\u043c\u044f \u043a\u0430\u0440\u0442\u043e\u0447\u043a\u0430\u043c\u0438 \u0432\u043d\u0443\u0442\u0440\u0438 \u043f\u0435\u0440\u0438\u043e\u0434\u0430. \u0421\u0442\u0430\u0442\u0443\u0441\u044b \u0418\u0434\u0435\u044f \u0438\u043b\u0438 \u0412 \u0440\u0430\u0431\u043e\u0442\u0435. open_content_draft \u0432\u043e\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442 launch_url \u043d\u0430 \u0437\u0430\u043f\u043e\u043b\u043d\u0435\u043d\u043d\u044b\u0439 \u0432\u0435\u0431-\u043f\u043b\u0430\u043d\u0435\u0440; \u043c\u043e\u0434\u0435\u043b\u044c \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442 \u0435\u0433\u043e Markdown-\u0441\u0441\u044b\u043b\u043a\u043e\u0439. \u041f\u0440\u0438 \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0438 \u0441\u0441\u044b\u043b\u043a\u0438 \u0432\u0438\u0434\u043d\u044b \u043e\u0431\u0435 \u043a\u0430\u0440\u0442\u043e\u0447\u043a\u0438. \u041f\u043e\u043b\u0443\u0447\u0435\u043d\u0438\u0435 \u0441\u0441\u044b\u043b\u043a\u0438 \u043d\u0435 \u0432\u044b\u0434\u0430\u0451\u0442\u0441\u044f \u0437\u0430 \u043d\u0430\u0431\u043b\u044e\u0434\u0430\u0435\u043c\u0443\u044e \u0437\u0430\u0433\u0440\u0443\u0437\u043a\u0443 \u0438\u043d\u0442\u0435\u0440\u0444\u0435\u0439\u0441\u0430. \u041d\u0435\u0442 \u043e\u0431\u043b\u0430\u0447\u043d\u043e\u0433\u043e \u0441\u043e\u0445\u0440\u0430\u043d\u0435\u043d\u0438\u044f \u0438\u043b\u0438 \u0432\u0441\u0442\u0440\u043e\u0435\u043d\u043d\u043e\u0433\u043e \u0432\u0438\u0434\u0436\u0435\u0442\u0430."
            },
            {
              "description": "\u0412 \u0442\u0435\u043a\u0443\u0449\u0435\u043c \u0440\u0430\u0437\u0433\u043e\u0432\u043e\u0440\u0435 \u0441\u043e\u0437\u0434\u0430\u0442\u044c \u043f\u043b\u0430\u043d 1\u201314 \u043d\u043e\u044f\u0431\u0440\u044f \u0441 \u0434\u0432\u0443\u043c\u044f \u043a\u0430\u0440\u0442\u043e\u0447\u043a\u0430\u043c\u0438 \u0438 \u0441\u043e\u0445\u0440\u0430\u043d\u0438\u0442\u044c \u0432\u043e\u0437\u0432\u0440\u0430\u0449\u0451\u043d\u043d\u044b\u0439 draft \u0432 \u043a\u043e\u043d\u0442\u0435\u043a\u0441\u0442\u0435. \u0412\u044b\u0431\u0440\u0430\u0442\u044c \u043f\u0435\u0440\u0432\u0443\u044e \u043a\u0430\u0440\u0442\u043e\u0447\u043a\u0443 \u0434\u043b\u044f \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u044f.",
              "prompt": "\u0421\u043e\u043a\u0440\u0430\u0442\u0438 \u0442\u0435\u043a\u0441\u0442 \u043f\u0435\u0440\u0432\u043e\u0439 \u043a\u0430\u0440\u0442\u043e\u0447\u043a\u0438 \u0434\u043e \u0442\u0440\u0451\u0445 \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0435\u043d\u0438\u0439. \u041e\u0441\u0442\u0430\u043b\u044c\u043d\u0443\u044e \u043e\u0441\u0442\u0430\u0432\u044c \u043a\u0430\u043a \u0435\u0441\u0442\u044c. \u041f\u0435\u0440\u0432\u0443\u044e \u043a\u0430\u0440\u0442\u043e\u0447\u043a\u0443 \u0432 \u044d\u0442\u043e\u0439 \u0440\u0435\u0434\u0430\u043a\u0446\u0438\u0438 \u0441\u043e\u0433\u043b\u0430\u0441\u043e\u0432\u044b\u0432\u0430\u044e. \u041f\u043e\u043a\u0430\u0436\u0438 \u043e\u0431\u043d\u043e\u0432\u043b\u0451\u043d\u043d\u044b\u0435 \u043c\u0430\u0442\u0435\u0440\u0438\u0430\u043b\u044b.",
              "tools_triggered": "edit_content_draft, open_content_draft",
              "expected_behavior": "\u0418\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u0442\u0441\u044f \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0439 draft \u0438 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u044e\u0449\u0438\u0439 id \u043f\u0435\u0440\u0432\u043e\u0439 \u043a\u0430\u0440\u0442\u043e\u0447\u043a\u0438; approvalConfirmed=true \u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u0435\u0442 \u044f\u0432\u043d\u043e\u043c\u0443 \u0441\u043e\u0433\u043b\u0430\u0441\u043e\u0432\u0430\u043d\u0438\u044e. \u041f\u0435\u0440\u0432\u0430\u044f \u043a\u0430\u0440\u0442\u043e\u0447\u043a\u0430 \u0421\u043e\u0433\u043b\u0430\u0441\u043e\u0432\u0430\u043d\u043e, id \u0438 \u0432\u0442\u043e\u0440\u0430\u044f \u043a\u0430\u0440\u0442\u043e\u0447\u043a\u0430 \u0441\u043e\u0445\u0440\u0430\u043d\u0435\u043d\u044b. \u0424\u0430\u043a\u0442 \u043f\u0443\u0431\u043b\u0438\u043a\u0430\u0446\u0438\u0438 \u043d\u0435 \u0437\u0430\u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f. \u041d\u043e\u0432\u0430\u044f \u0441\u0441\u044b\u043b\u043a\u0430 \u0432\u043a\u043b\u044e\u0447\u0430\u0435\u0442 \u0430\u043a\u0442\u0443\u0430\u043b\u044c\u043d\u0443\u044e \u0440\u0435\u0434\u0430\u043a\u0446\u0438\u044e. \u0412\u0441\u0442\u0440\u043e\u0435\u043d\u043d\u044b\u0439 \u0432\u0438\u0434\u0436\u0435\u0442 \u043d\u0435 \u0432\u044b\u0437\u044b\u0432\u0430\u0435\u0442\u0441\u044f."
            },
            {
              "description": "\u041f\u043e\u0434\u0433\u043e\u0442\u043e\u0432\u0438\u0442\u044c \u0442\u0435\u043a\u0443\u0449\u0438\u0439 \u043f\u043b\u0430\u043d \u0441 \u0434\u0432\u0443\u043c\u044f \u043e\u0434\u0438\u043d\u0430\u043a\u043e\u0432\u044b\u043c\u0438 \u0442\u0435\u043c\u0430\u043c\u0438 \u043d\u0430 \u044d\u0442\u0430\u043f\u0435 \u0417\u043d\u0430\u043a\u043e\u043c\u0441\u0442\u0432\u043e, \u0443 \u043e\u0434\u043d\u043e\u0439 \u043a\u0430\u0440\u0442\u043e\u0447\u043a\u0438 \u043f\u0443\u0441\u0442\u043e\u0439 \u0442\u0435\u043a\u0441\u0442. \u0414\u0440\u0443\u0433\u0438\u0435 \u044d\u0442\u0430\u043f\u044b \u043d\u0435 \u0434\u043e\u0431\u0430\u0432\u043b\u044f\u0442\u044c.",
              "prompt": "\u041f\u0440\u043e\u0432\u0435\u0440\u044c \u0442\u0435\u043a\u0443\u0449\u0438\u0439 \u043f\u043b\u0430\u043d: \u043a\u0430\u043a\u0438\u0435 \u044d\u0442\u0430\u043f\u044b \u043f\u0440\u043e\u0433\u0440\u0435\u0432\u0430 \u043f\u0440\u043e\u043f\u0443\u0449\u0435\u043d\u044b, \u043f\u043e\u0432\u0442\u043e\u0440\u044f\u044e\u0442\u0441\u044f \u043b\u0438 \u0442\u0435\u043c\u044b \u0438 \u0432 \u043a\u0430\u043a\u0438\u0445 \u043a\u0430\u0440\u0442\u043e\u0447\u043a\u0430\u0445 \u0435\u0449\u0451 \u043d\u0435\u0442 \u0442\u0435\u043a\u0441\u0442\u0430? \u041d\u0435 \u043c\u0435\u043d\u044f\u0439 \u043c\u0430\u0442\u0435\u0440\u0438\u0430\u043b\u044b.",
              "tools_triggered": "audit_content_draft",
              "expected_behavior": "\u0412\u043e\u0437\u0432\u0440\u0430\u0449\u0435\u043d\u044b \u0447\u0435\u0442\u044b\u0440\u0435 \u043f\u0440\u043e\u043f\u0443\u0449\u0435\u043d\u043d\u044b\u0445 \u044d\u0442\u0430\u043f\u0430: \u041f\u0440\u043e\u0431\u043b\u0435\u043c\u0430, \u0420\u0435\u0448\u0435\u043d\u0438\u0435, \u0414\u043e\u0432\u0435\u0440\u0438\u0435, \u041f\u0440\u0435\u0434\u043b\u043e\u0436\u0435\u043d\u0438\u0435; \u043f\u043e\u0432\u0442\u043e\u0440 \u0442\u0435\u043c\u044b \u0438 \u043e\u0434\u043d\u0430 \u043a\u0430\u0440\u0442\u043e\u0447\u043a\u0430 \u0431\u0435\u0437 \u0442\u0435\u043a\u0441\u0442\u0430. Draft \u043d\u0435 \u043c\u0435\u043d\u044f\u0435\u0442\u0441\u044f. \u041f\u0440\u043e\u0432\u0435\u0440\u043a\u0430 \u043d\u0430\u0437\u0432\u0430\u043d\u0430 \u0440\u0435\u0434\u0430\u043a\u0446\u0438\u043e\u043d\u043d\u043e\u0439, \u0431\u0435\u0437 \u043f\u0440\u043e\u0433\u043d\u043e\u0437\u0430 \u043f\u0440\u043e\u0434\u0430\u0436."
            },
            {
              "description": "\u0418\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c \u0442\u0435\u043a\u0443\u0449\u0438\u0439 \u043f\u043b\u0430\u043d 1\u201314 \u043d\u043e\u044f\u0431\u0440\u044f \u0441 \u043e\u0434\u043d\u043e\u0439 \u0441\u043e\u0433\u043b\u0430\u0441\u043e\u0432\u0430\u043d\u043d\u043e\u0439 \u043a\u0430\u0440\u0442\u043e\u0447\u043a\u043e\u0439. \u041f\u0435\u0440\u0432\u044b\u0439 \u0445\u043e\u0434: \u043f\u0440\u0435\u0434\u043f\u0440\u043e\u0441\u043c\u043e\u0442\u0440 \u043f\u0435\u0440\u0435\u043d\u043e\u0441\u0430 \u043d\u0430 7 \u0434\u043d\u0435\u0439 \u0431\u0435\u0437 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u0439. \u0412\u0442\u043e\u0440\u043e\u0439 \u0445\u043e\u0434 \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044f: \u041f\u043e\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u044e \u043f\u0435\u0440\u0435\u043d\u043e\u0441 \u043d\u0430 \u0441\u0435\u043c\u044c \u0434\u043d\u0435\u0439.",
