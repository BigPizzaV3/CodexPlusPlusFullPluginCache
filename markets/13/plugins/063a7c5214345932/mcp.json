{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "stemconsole": {
      "type": "streamable-http",
      "url": "https://stemconsole.ai/mcp/chatgpt",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "resource": "https://stemconsole.ai/mcp/chatgpt",
            "baseScopes": [
              "account"
            ]
          }
        }
      }
    }
  }
}
