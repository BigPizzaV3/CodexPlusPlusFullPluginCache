{
  "mcpServers": {
    "reducto-office": {
      "type": "http",
      "url": "https://office.reducto.ai/mcp/app",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "authorizationUrl": "https://accounts.reducto.ai/authorize",
            "tokenUrl": "https://accounts.reducto.ai/api/oauth/token",
            "registrationUrl": "https://accounts.reducto.ai/api/oauth/register",
            "authorizationServerBase": "https://accounts.reducto.ai",
            "resource": "https://office.reducto.ai/mcp/app",
            "defaultScopes": [
              "mcp"
            ]
          }
        }
      }
    }
  }
}
