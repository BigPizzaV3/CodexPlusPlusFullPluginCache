{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "xms-calendar": {
      "type": "streamable-http",
      "url": "https://app.xmscalendar.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "xms-calendar-chatgpt",
              "tokenEndpointAuthMethod": "none"
            },
            "authorizationUrl": "https://app.xmscalendar.com/oauth/authorize",
            "tokenUrl": "https://app.xmscalendar.com/oauth/token",
            "baseScopes": ["calendar.read", "calendar.write"]
          }
        }
      }
    }
  }
}
