{
  "mcpServers": {
    "moodlens-todo": {
      "type": "http",
      "url": "https://moodlenstodo.com/api/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "resource": "https://moodlenstodo.com/api/mcp",
            "baseScopes": [
              "tasks",
              "documents",
              "proposals",
              "contracts",
              "team",
              "columns",
              "boards",
              "sprints",
              "write"
            ]
          }
        }
      }
    }
  }
}
