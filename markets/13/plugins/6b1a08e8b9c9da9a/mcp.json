{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "terminal-commands": {
      "type": "streamable-http",
      "url": "https://mcp.terminalcommands.fr/mcp?app=terminal-commands-public",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "authorizationUrl": "https://auth.terminalcommands.fr/authorize",
            "tokenUrl": "https://auth.terminalcommands.fr/oauth/token",
            "authorizationServerBase": "https://auth.terminalcommands.fr/",
            "resource": "https://mcp.terminalcommands.fr",
            "oidcEnabled": true,
            "oidcConfigurationUrl": "https://auth.terminalcommands.fr/.well-known/openid-configuration",
            "oidcUserinfoEndpoint": "https://auth.terminalcommands.fr/userinfo",
            "oidcScopesSupported": ["openid", "email", "offline_access"],
            "registrationUrl": "https://auth.terminalcommands.fr/oidc/register",
            "baseScopes": ["openid", "email", "offline_access", "terminal:use"]
          }
        }
      }
    }
  }
}
