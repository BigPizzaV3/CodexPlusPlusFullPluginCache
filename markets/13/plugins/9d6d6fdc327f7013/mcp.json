{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "pipeledger": {
      "type": "streamable-http",
      "url": "https://mcp.pipeledger.ai/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "cimd"
            },
            "registrationUrl": "https://app.pipeledger.ai/api/oauth/register",
            "authorizationServerBase": "https://app.pipeledger.ai",
            "authorizationUrl": "https://app.pipeledger.ai/api/oauth/authorize",
            "tokenUrl": "https://app.pipeledger.ai/api/oauth/token",
            "resource": "https://mcp.pipeledger.ai/mcp",
            "baseScopes": [
              "mcp:agent.viewer.standard",
              "offline_access"
            ],
            "oidcEnabled": false
          }
        }
      }
    }
  }
}
