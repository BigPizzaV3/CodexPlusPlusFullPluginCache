{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "olaf-school": {
      "type": "streamable-http",
      "url": "https://school.hiolaf.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "YgydkaXGQdSFs9Ha",
              "tokenEndpointAuthMethod": "none"
            },
            "baseScopes": ["openid", "email", "offline_access"],
            "oidcScopesSupported": ["openid", "email"]
          }
        }
      }
    }
  }
}
