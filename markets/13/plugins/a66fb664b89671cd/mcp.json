{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "brand-up": {
      "type": "streamable-http",
      "url": "https://api.brand-up.net/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "registrationUrl": "https://api.brand-up.net/mcp/oauth/register",
            "baseScopes": [
              "brandup:read"
            ]
          }
        }
      }
    }
  }
}
