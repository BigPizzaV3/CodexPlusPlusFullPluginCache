{
  "mcpServers": {
    "chargen": {
      "url": "https://api.char-gen.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "registrationUrl": "https://api.char-gen.com/mcp/oauth/register",
            "authorizationUrl": "https://api.char-gen.com/oauth2/authorize",
            "tokenUrl": "https://api.char-gen.com/oauth2/token",
            "resource": "https://api.char-gen.com/mcp",
            "baseScopes": [
              "mcp:read",
              "mcp:write",
              "mcp:generate"
            ]
          }
        }
      }
    }
  }
}
