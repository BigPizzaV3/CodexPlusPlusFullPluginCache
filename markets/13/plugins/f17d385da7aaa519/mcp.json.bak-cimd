{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "review-expert": {
      "type": "streamable-http",
      "url": "https://mcp.review.expert",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "cimd"
            },
            "defaultScopes": ["apps:read", "reviews:read", "replies:draft"]
          }
        }
      }
    }
  }
}
