{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "review-expert": {
      "type": "streamable-http",
      "url": "https://mcp.review.expert",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "rxc_9bf39f748ca840e6ac4884550ab7fa20",
              "tokenEndpointAuthMethod": "none"
            },
            "defaultScopes": [
              "apps:read",
              "reviews:read",
              "replies:draft"
            ]
          }
        }
      }
    }
  }
}
