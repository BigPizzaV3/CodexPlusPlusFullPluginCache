{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "revenue": {
      "type": "streamable-http",
      "url": "https://revenue.fitness/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": { "mode": "cimd" },
            "authorizationUrl": "https://revenue.fitness/oauth/authorize",
            "tokenUrl": "https://revenue.fitness/oauth/token",
            "baseScopes": ["revenue:read"]
          }
        }
      }
    }
  }
}
