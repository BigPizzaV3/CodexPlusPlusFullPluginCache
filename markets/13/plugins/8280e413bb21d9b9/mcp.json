{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "fluentside": {
      "type": "streamable-http",
      "url": "https://fluentside.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "authorizationUrl": "https://clerk.fluentside.com/oauth/authorize",
            "tokenUrl": "https://clerk.fluentside.com/oauth/token",
            "baseScopes": ["openid", "profile", "email"],
            "oidcEnabled": true
          }
        }
      }
    }
  }
}
