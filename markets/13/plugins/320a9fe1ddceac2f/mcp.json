{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "kosher-compass": {
      "type": "streamable-http",
      "url": "https://kosher-compass.com/chatgpt/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "authorizationServerBase": "https://kosher-compass.com",
            "resource": "https://kosher-compass.com/chatgpt/mcp",
            "authorizationUrl": "https://kosher-compass.com/chatgpt/oauth/authorize",
            "tokenUrl": "https://kosher-compass.com/chatgpt/oauth/token",
            "registrationUrl": "https://kosher-compass.com/chatgpt/oauth/register",
            "baseScopes": [
              "trips:read",
              "trips:write"
            ]
          }
        }
      }
    }
  }
}