{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "teamtime": {
      "type": "streamable-http",
      "url": "https://teamtime-mcp-poc.vercel.app/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "mixed",
            "client": {
              "mode": "provided",
              "clientId": "openai-teamtime-production",
              "tokenEndpointAuthMethod": "client_secret_post"
            },
            "authorizationUrl": "https://dashboard.teamtime.shop/oauth/authorize",
            "tokenUrl": "https://dashboard.teamtime.shop/oauth/token",
            "resource": "https://teamtime-mcp-poc.vercel.app/mcp",
            "baseScopes": [
              "products:read",
              "products:images:write",
              "products:create"
            ]
          }
        }
      }
    }
  }
}
