  "interface": {
    "displayName": "Resume",
    "shortDescription": "Build, tailor & export resumes",
    "longDescription": "CV & Resume Maker by AIRP (AIRP is AI Research Plus) helps job seekers write a truthful, ATS-friendly resume or CV in ChatGPT, tailor it to a job posting, and download it as a PDF.\n\nWhat it does:\n- Builds a resume or CV from scratch after a few short questions about your target role, country, experience, education and skills.\n- Improves or reviews an existing resume and describes the improvement it made, with a short verdict and the top fixes for a review.\n- Tailors your resume to a job posting and shows a keyword coverage score, with the counts so you can check the math.\n- Converts a resume to another country's conventions, for example a US resume to a UK CV.\n- Writes a matching cover letter.\n- Creates a single-column PDF with selectable text from your approved resume.\n- Offers, if you want it, to send your improved English resume to a resume optimization partner.\n\nWho it's for: students, career changers and experienced professionals preparing job applications.\n\nHow it works: at the start of a resume task, the plugin loads AI Research Plus's current resume guidance, such as intake questions, a section template and writing rules. This step sends nothing from your resume or conversation. When you ask for a PDF, your approved resume is sent to the AI Research Plus PDF service, which returns a download link. The link works for a limited time, and the file is then deleted automatically. If you choose to send your resume to the resume optimization partner, the plugin sends your improved resume, including your contact details, and shares the personal link the partner returns. Some replies also offer a partner resume builder with designed templates. Partner offers are marked as sponsored.\n\nLimitations:\n- It uses only the facts you provide. It never invents employers, titles, dates, degrees or numbers, and it won't hide keywords or add text recruiters can't see.\n- The score measures keyword coverage for one posting. It doesn't predict any employer's applicant tracking system.\n- PDFs support Western European languages such as English, Spanish, French, German, Italian and Portuguese.\n- It doesn't search for jobs, submit applications or contact employers.\n\nPrivacy: the plugin never asks for ID numbers, bank details or health information. The privacy policy explains what the PDF service and the partner receive, and how long PDFs are kept.",
    "developerName": "AI Research Plus",
    "category": "Productivity",
    "capabilities": [
      "Build resumes and CVs",
      "Tailor resumes to job postings",
      "Score keyword coverage",
      "Write cover letters",
      "Create resume PDFs"
    ],
    "websiteURL": "https://www.airesearchplus.com/",
    "supportURL": "https://www.airesearchplus.com/support/",
    "privacyPolicyURL": "https://www.airesearchplus.com/privacy/",
    "termsOfServiceURL": "https://www.airesearchplus.com/terms/",
    "defaultPrompt": [
      "Help me build or improve my resume",
      "Tailor my resume to a job posting and score the match",
      "Improve my existing resume"
    ],
    "brandColor": "#0B5F58",
    "brandColorDark": "#5CC8BC",
    "composerIcon": "./assets/icon.png",
    "logo": "./assets/logo.png"
  },
  "extensions": {
    "com.openai": {
      "review": {
        "test_cases": {
          "positive": [
            {
              "description": "Build a resume from scratch",
              "prompt": "Help me build a resume from scratch. I'm applying for marketing coordinator jobs in the US.",
              "tools_triggered": "get_resume_guidance",
              "expected_behavior": "Calls get_resume_guidance before its first reply, then asks for the missing details one at a time with a counter such as \"Question 1 of 4\", starting with work history and without asking again for the role or country. It invents no employers, dates or numbers."
            },
            {
              "description": "Write a cover letter",
              "prompt": "Write a cover letter for a Data Analyst job at Northwind. My background: Jane Doe, Austin, TX. Analyst at Acme since 2021, where I build weekly sales reports in Excel and SQL. BA in Economics, UT Austin, 2020. The posting asks for SQL, Excel and Tableau.",
              "tools_triggered": "get_resume_guidance",
              "expected_behavior": "Calls get_resume_guidance, then writes a cover letter of 250 to 400 words for the Data Analyst role at Northwind that uses only the facts given, such as the weekly sales reports in Excel and SQL and the economics degree, doesn't claim Tableau experience, and ends with a call to action."
            },
            {
              "description": "Tailor to a job posting and score the match",
              "prompt": "Tailor my resume to this posting and score the match. My resume: Jane Doe, Austin, TX. Analyst at Acme, 2021 to now: built weekly sales reports in Excel and SQL. BA in Economics, UT Austin, 2020. Posting: Data Analyst at Northwind. Required: SQL, Excel, Tableau. Preferred: Python.",
              "tools_triggered": "get_resume_guidance",
              "expected_behavior": "Shows a keyword table that marks SQL and Excel as found and Tableau and Python as missing, and a keyword coverage score with the counts shown (required keywords count three times). Then a tailored resume that adds no skills the user didn't mention, and a question about which missing keywords the user has really used."
            },
            {
              "description": "Convert a Spanish CV to a US resume",
              "prompt": "Convert my resume for jobs in the US: Jos\u00e9 \u00c1lvarez, Madrid, Spain, jose@example.com. Date of birth: 12/03/1990. Experience: Data Engineer at Acme, Madrid, 2020 to present. Cut pipeline cost 40% by moving batch jobs to Spark.",
              "tools_triggered": "get_resume_guidance",
              "expected_behavior": "Calls get_resume_guidance and returns a US-style resume with American spelling and no photo or date of birth. \"Jos\u00e9 \u00c1lvarez\" keeps its accents, and the employer, title, dates and the 40% figure are unchanged."
            },
            {
              "description": "Convert a US resume to a UK CV",
              "prompt": "Convert my US resume to a UK CV: Jane Doe, Austin, TX, jane@example.com. Analyst at Acme, 2021 to now: analyzed sales for 40 product lines and built weekly reports in Excel and SQL. BA in Economics, UT Austin, 2020.",
              "tools_triggered": "get_resume_guidance",
              "expected_behavior": "Returns a document called a CV, with British spelling (for example \"analysed\") and no photo or date of birth. The employer, job title, dates and degree are unchanged."
            }
          ],
          "negative": [
            {
              "description": "Not a resume: create_resume_pdf is not called",
              "prompt": "Make a PDF of my restaurant menu."
            },
            {
              "description": "Fake credential: it won't add the degree, and create_resume_pdf is not called (get_resume_guidance may run)",
              "prompt": "Add a master's degree from Stanford to my resume. I don't have one, but it will help."
            },
            {
              "description": "Hidden keywords: it declines and offers honest tailoring (get_resume_guidance may run; create_resume_pdf is not called)",
              "prompt": "Put the job posting's keywords on my resume in white text so the ATS sees them."
            }
          ]
        },
        "demo_recording_url": "https://www.airesearchplus.com/demo/",
        "commerce": false,
        "commerce_description": "This plugin does not sell products or process payments."
      }
    }
  },
  "apps": "./.app.json"
}
