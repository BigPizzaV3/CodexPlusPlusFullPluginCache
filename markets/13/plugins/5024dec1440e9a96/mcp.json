{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "glubler": {
      "type": "streamable-http",
      "url": "https://mcp.glubler.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "chatgpt-glubler-client",
              "tokenEndpointAuthMethod": "none"
            },
            "authorizationUrl": "https://glubler.com/connect/authorize",
            "tokenUrl": "https://glubler.com/connect/token",
            "authorizationServerBase": "https://glubler.com",
            "resource": "https://mcp.glubler.com",
            "baseScopes": [
              "mcp:all",
              "offline_access"
            ],
            "defaultScopes": [
              "mcp:all",
              "offline_access"
            ],
            "oidcEnabled": false
          }
        }
      }
    }
  }
}
