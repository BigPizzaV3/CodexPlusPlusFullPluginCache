{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "eyeview": {
      "type": "streamable-http",
      "url": "https://api.eyeview.pro/api/chatgpt/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "mixed",
            "client": {
              "mode": "provided",
              "clientId": "eyeview-chatgpt",
              "tokenEndpointAuthMethod": "none"
            },
            "authorizationServerBase": "https://api.eyeview.pro/api/chatgpt/oauth",
            "resource": "https://api.eyeview.pro/api/chatgpt/mcp",
            "authorizationUrl": "https://app.eyeview.pro/chatgpt/connect",
            "tokenUrl": "https://api.eyeview.pro/api/chatgpt/oauth/token",
            "baseScopes": [
              "documents:read"
            ]
          }
        }
      }
    }
  }
}
