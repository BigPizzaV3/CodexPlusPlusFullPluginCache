{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "asia-odyssey-travel": {
      "type": "streamable-http",
      "url": "https://api.aotclub.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "mixed",
            "client": {
              "mode": "provided",
              "clientId": "aot-chatgpt",
              "tokenEndpointAuthMethod": "none"
            },
            "authorizationUrl": "https://api.aotclub.com/oauth/authorize",
            "tokenUrl": "https://api.aotclub.com/oauth/token"
          }
        }
      }
    }
  }
}
