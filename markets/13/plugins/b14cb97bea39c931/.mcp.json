{
  "mcpServers": {
    "resell-pro": {
      "url": "https://resellpro.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": [
              "analytics:read",
              "offline_access",
              "openid",
              "email"
            ]
          }
        }
      }
    }
  }
}