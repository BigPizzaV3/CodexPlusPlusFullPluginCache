{
    "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
    "mcpServers": {
        "planvortex": {
            "type": "streamable-http",
            "url": "https://mcp.planvortex.com/mcp",
            "extensions": {
                "com.openai": {
                    "auth": {
                        "type": "oauth",
                        "client": {
                            "mode": "provided",
                            "clientId": "mcp-chatgpt",
                            "tokenEndpointAuthMethod": "client_secret_basic"
                        },
                        "baseScopes": [
                            "planvortex:read",
                            "planvortex:write"
                        ]
                    }
                }
            }
        }
    }
}
