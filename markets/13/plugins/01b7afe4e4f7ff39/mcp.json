{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "bettership": {
      "type": "streamable-http",
      "url": "https://api.bettership.ai/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": [
              "library:read",
              "maker:read",
              "openid",
              "email"
            ]
          }
        }
      }
    }
  }
}
