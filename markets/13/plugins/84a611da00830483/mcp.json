{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "chefbear": {
      "type": "streamable-http",
      "url": "https://chef-bear.com/api/menu-sharing/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "chefbear-chatgpt",
              "tokenEndpointAuthMethod": "none"
            },
            "baseScopes": ["menus:read", "menus:import", "menus:share", "menus:list", "taste:read", "taste:write"]
          }
        }
      }
    }
  }
}
