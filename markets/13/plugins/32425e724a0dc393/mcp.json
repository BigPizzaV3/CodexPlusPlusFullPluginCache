{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "campaigntrackly": {
      "type": "streamable-http",
      "url": "https://app.campaigntrackly.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "0vdeEV7M09xSNyPOmjmI2FUf3yP0aBn9",
              "tokenEndpointAuthMethod": "client_secret_post"
            },
            "resource": "https://app.campaigntrackly.com/mcp",
            "baseScopes": [
              "openid",
              "email",
              "campaigntrackly:context:read",
              "campaigntrackly:preview",
              "campaigntrackly:campaign:save"
            ]
          }
        }
      }
    }
  }
}
