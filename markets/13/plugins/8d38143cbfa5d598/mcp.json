{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "reviato": {
      "type": "streamable-http",
      "url": "https://www.reviato.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "mixed",
            "authorizationUrl": "https://www.reviato.com/oauth/authorize",
            "tokenUrl": "https://www.reviato.com/oauth/token",
            "baseScopes": [
              "audits",
              "properties"
            ],
            "client": {
              "mode": "provided",
              "clientId": "fviW6SXCiHpMhQE6x_0YBEKO9hWnmS0UNmua3XwbppU",
              "tokenEndpointAuthMethod": "none"
            }
          }
        }
      }
    }
  }
}
