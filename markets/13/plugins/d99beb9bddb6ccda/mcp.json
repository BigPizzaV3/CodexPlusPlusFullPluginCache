{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "sakuraseisai-personal-scenarios": {
      "type": "streamable-http",
      "url": "https://mcp.sakuraseisai.com/v1-1/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "mixed",
            "client": {
              "mode": "provided",
              "clientId": "https://chatgpt.com/oauth/client.json",
              "tokenEndpointAuthMethod": "none"
            },
            "resource": "https://mcp.sakuraseisai.com/v1-1/mcp",
            "defaultScopes": [
              "scenario-management:read"
            ]
          }
        }
      }
    }
  }
}
