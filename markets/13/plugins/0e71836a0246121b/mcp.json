{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "reyda": {
      "type": "streamable-http",
      "url": "https://api.reyda.ai/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "reyda-chatgpt-production",
              "tokenEndpointAuthMethod": "none"
            },
            "resource": "https://api.reyda.ai/mcp",
            "baseScopes": [
              "opportunities:read",
              "documents:read",
              "pipeline:read",
              "intelligence:read"
            ]
          }
        }
      }
    }
  }
}
