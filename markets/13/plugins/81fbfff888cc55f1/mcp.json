{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "dalail": {
      "type": "streamable-http",
      "url": "https://chat.dalail.ai/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": { "mode": "dcr" },
            "defaultScopes": ["openid", "email", "offline_access"],
            "oidcScopesSupported": ["openid", "email", "offline_access"]
          }
        }
      }
    }
  }
}
