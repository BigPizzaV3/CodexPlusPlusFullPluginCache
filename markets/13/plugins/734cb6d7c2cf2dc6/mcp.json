{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "trackside": {
      "type": "streamable-http",
      "url": "https://trackside.camotors.co/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": [
              "sessions:read",
              "telemetry:read"
            ]
          }
        }
      }
    }
  }
}
