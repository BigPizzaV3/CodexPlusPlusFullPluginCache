{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "aidelly": {
      "type": "streamable-http",
      "url": "https://app.aidelly.ai/api/mcp/chatgpt",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "defaultScopes": [
              "workspaces:read",
              "connections:read",
              "brand:read",
              "brand:write",
              "drafts:read",
              "drafts:write",
              "posts:read",
              "approvals:read",
              "analytics:read"
            ]
          }
        }
      }
    }
  }
}
