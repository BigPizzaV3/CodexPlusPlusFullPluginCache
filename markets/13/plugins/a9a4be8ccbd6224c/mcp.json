{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "bulls-crm": {
      "type": "streamable-http",
      "url": "https://bulls-crm.bullaria.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": ["crm.lecture", "crm.ecriture"]
          }
        }
      }
    }
  }
}
