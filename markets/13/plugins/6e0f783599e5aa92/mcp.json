{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "sommo": {
      "type": "streamable-http",
      "url": "https://api.sommo.app/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "sommo-chatgpt",
              "tokenEndpointAuthMethod": "none"
            },
            "resource": "https://api.sommo.app/mcp",
            "baseScopes": [
              "cellar:write",
              "journal:write",
              "learning:read",
              "learning:write",
              "wine:read"
            ]
          }
        }
      }
    }
  }
}
