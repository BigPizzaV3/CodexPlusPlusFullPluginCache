{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "coldlytics": {
      "type": "streamable-http",
      "url": "https://mcp.coldlytics.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "authorizationServerBase": "https://app.coldlytics.com",
            "resource": "https://mcp.coldlytics.com/mcp",
            "oidcEnabled": true
          }
        }
      }
    }
  }
}
