      "type": "streamable-http",
      "url": "https://anifusion.ai/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "defaultScopes": ["openid", "email"]
          }
        }
      }
    }
  }
