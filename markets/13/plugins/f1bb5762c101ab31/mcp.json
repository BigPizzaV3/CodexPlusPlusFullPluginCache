{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "skroutz-shopping": {
      "type": "streamable-http",
      "url": "https://api.skroutz.gr/api/agents/mcp/shopping",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": ["shopping_mcp"]
          }
        }
      }
    }
  }
}
