{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "kliqo": {
      "type": "streamable-http",
      "url": "https://kliqo.ai/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "mixed",
            "client": {
              "mode": "provided",
              "clientId": "kliqo-chatgpt",
              "tokenEndpointAuthMethod": "none"
            },
            "authorizationUrl": "https://kliqo.ai/api/auth/oauth2/authorize",
            "tokenUrl": "https://kliqo.ai/api/auth/oauth2/token",
            "resource": "https://kliqo.ai/mcp"
          }
        }
      }
    }
  }
}
