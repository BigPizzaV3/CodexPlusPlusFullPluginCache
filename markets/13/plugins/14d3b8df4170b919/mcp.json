{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "zupy": {
      "type": "streamable-http",
      "url": "https://api.zupy.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "mixed",
            "client": {
              "mode": "provided",
              "clientId": "zupy-chatgpt-diretorio",
              "tokenEndpointAuthMethod": "client_secret_basic"
            },
            "authorizationServerBase": "https://zupy.com",
            "authorizationUrl": "https://zupy.com/oauth/authorize/",
            "tokenUrl": "https://zupy.com/oauth/token/",
            "resource": "https://api.zupy.com/mcp",
            "baseScopes": [
              "zupy.read",
              "zupy.write"
            ]
          }
        }
      }
    }
  }
}
