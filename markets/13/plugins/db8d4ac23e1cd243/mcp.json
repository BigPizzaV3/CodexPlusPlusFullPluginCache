{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "clarvo": {
      "type": "streamable-http",
      "url": "https://hire.clarvo.ai/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "resource": "https://hire.clarvo.ai/mcp",
            "baseScopes": ["clarvo:read", "clarvo:search", "clarvo:write"]
          }
        }
      }
    }
  }
}
