{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "node-negocio": {
      "type": "streamable-http",
      "url": "https://app.allinnode.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "https://chatgpt.com/oauth/client.json",
              "tokenEndpointAuthMethod": "none"
            },
            "authorizationServerBase": "https://clerk.allinnode.com",
            "resource": "https://app.allinnode.com/mcp",
            "baseScopes": ["node:read"],
            "defaultScopes": ["node:read"],
            "oidcEnabled": false
          }
        }
      }
    }
  }
}
