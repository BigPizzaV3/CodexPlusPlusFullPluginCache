{
  "mcpServers": {
    "antom": {
      "url": "https://mcp.antom.com",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "registrationUrl": "https://dashboard-apiv2.antom.com/mcp/oauth2/register",
            "authorizationUrl": "https://dashboard-apiv2.antom.com/mcp/oauth2/authorize",
            "tokenUrl": "https://dashboard-apiv2.antom.com/mcp/oauth2/token",
            "authorizationServerBase": "https://dashboard-apiv2.antom.com",
            "resource": "https://mcp.antom.com"
          }
        }
      }
    }
  }
}
