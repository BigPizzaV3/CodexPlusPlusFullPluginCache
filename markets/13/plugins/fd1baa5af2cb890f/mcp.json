{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "tourmind-hotel": {
      "type": "streamable-http",
      "url": "https://mcp-booking.tourmind.com/mcp/oauth/toc",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "resource": "https://mcp-booking.tourmind.com/mcp/oauth/toc",
            "baseScopes": [
              "mcp:access"
            ],
            "client": {
              "mode": "provided",
              "clientId": "chatgpt",
              "tokenEndpointAuthMethod": "none"
            }
          }
        }
      }
    }
  }
}
