{
  "mcpServers": {
    "halal-rihla": {
      "type": "streamable-http",
      "url": "https://halalrihla.com/chatgpt/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "authorizationServerBase": "https://halalrihla.com",
            "resource": "https://halalrihla.com/chatgpt/mcp",
            "authorizationUrl": "https://halalrihla.com/chatgpt/oauth/authorize",
            "tokenUrl": "https://halalrihla.com/chatgpt/oauth/token",
            "registrationUrl": "https://halalrihla.com/chatgpt/oauth/register",
            "baseScopes": [
              "trips:read",
              "trips:write"
            ]
          }
        }
      }
    }
  }
}