{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "0xarchive": {
      "type": "streamable-http",
      "url": "https://mcp.0xarchive.io/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "defaultScopes": [
              "mcp:market.read",
              "mcp:webhooks.read",
              "mcp:webhooks.write",
              "mcp:feedback.write"
            ]
          }
        }
      }
    }
  }
}
