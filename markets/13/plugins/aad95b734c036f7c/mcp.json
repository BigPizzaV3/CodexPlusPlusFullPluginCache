{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "goagentconnect": {
      "type": "streamable-http",
      "url": "https://goagentconnect.ai/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "baseScopes": [
              "messages:read",
              "messages:send",
              "files:read",
              "files:write",
              "events:subscribe"
            ],
            "authorizationUrl": "https://goagentconnect.ai/oauth/authorize",
            "tokenUrl": "https://goagentconnect.ai/oauth/token",
            "registrationUrl": "https://goagentconnect.ai/oauth/register",
            "authorizationServerBase": "https://goagentconnect.ai",
            "resource": "https://goagentconnect.ai/mcp",
            "client": {
              "mode": "dcr"
            }
          }
        }
      }
    }
  }
}
