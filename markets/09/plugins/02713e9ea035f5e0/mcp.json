{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "snapshot": {
      "type": "streamable-http",
      "url": "https://www.makesnapshots.com/api/chatgpt/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "mixed",
            "client": { "mode": "dcr" },
            "authorizationUrl": "https://www.makesnapshots.com/api/chatgpt/oauth/authorize",
            "tokenUrl": "https://www.makesnapshots.com/api/chatgpt/oauth/token",
            "registrationUrl": "https://www.makesnapshots.com/api/chatgpt/oauth/register",
            "resource": "https://www.makesnapshots.com/api/chatgpt/mcp",
            "baseScopes": ["snapshot:cards", "snapshot:cart"]
          }
        }
      }
    }
  }
}
