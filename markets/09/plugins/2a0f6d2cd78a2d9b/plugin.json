{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "worxley",
  "version": "1.0.10",
  "description": "Worxley MCP gives AI assistants secure access to CRM data: leads, deals, customers, tickets, follow-ups, campaigns and reports through natural language.",
  "author": {
    "name": "Acadyn Labs LLP"
  },
  "keywords": [
    "crm",
    "sales",
    "marketing",
    "leads",
    "deals",
    "customers",
    "tasks",
    "tickets",
    "campaigns",
    "reports",
    "worxley"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Worxley",
        "shortDescription": "AI CRM for Customer Operations",
        "longDescription": "Worxley gives AI assistants secure access to CRM data. Search and manage leads, deals, customers, tickets, follow-ups, campaigns and reports using natural language.",
        "developerName": "Acadyn Labs LLP",
        "category": "Business & Operations",
        "defaultPrompt": [
          "Show my latest leads",
          "Find overdue follow-ups",
          "Summarize this month's sales activity"
        ],
        "websiteURL": "https://www.worxley.com",
        "supportURL": "https://help.worxley.com",
        "privacyPolicyURL": "https://worxley.com/privacy",
        "termsOfServiceURL": "https://worxley.com/terms",
        "logo": "./assets/logo.png",
        "composerIcon": "./assets/logo.png"
      },
      "apps": "./.app.json"
    }
  }
}
