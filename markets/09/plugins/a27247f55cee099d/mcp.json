{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "dmxready": {
      "type": "streamable-http",
      "url": "https://mcp.dmxready.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "resource": "https://mcp.dmxready.com",
            "baseScopes": [
              "profile",
              "email",
              "offline_access"
            ]
          }
        }
      }
    }
  }
}
