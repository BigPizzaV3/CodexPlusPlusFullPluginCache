{
  "extension": "StockViz Mutual Funds",
  "annotations_exposed": false,
  "annotation_status": "not_available_from_runtime",
  "credentials_or_tokens_included": false,
  "tools": [
    {
      "name": "stockvizmfmcp__list_strategies",
      "description": "List published mutual-fund strategies.",
      "input_schema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "annotations": null
    },
    {
      "name": "stockvizmfmcp__get_strategy_definition",
      "description": "Return exact strategy rules, current model portfolio, and provenance.",
      "input_schema": {
        "type": "object",
        "properties": {
          "strategy_id": {
            "type": "string"
          }
        },
        "required": [
          "strategy_id"
        ],
        "additionalProperties": false
      },
      "annotations": null
    },
    {
      "name": "stockvizmfmcp__get_strategy_portfolio",
      "description": "Return the current mutual-fund model portfolio for a published strategy, including scheme codes, names, factors, weights, and as-of date.",
      "input_schema": {
        "type": "object",
        "properties": {
          "strategy_id": {
            "type": "string"
          }
        },
        "required": [
          "strategy_id"
        ],
        "additionalProperties": false
      },
      "annotations": null
    },
    {
      "name": "stockvizmfmcp__get_strategy_backtest",
      "description": "Resolve a published strategy to its single linked backtest run.",
      "input_schema": {
        "type": "object",
        "properties": {
          "strategy_id": {
            "type": "string"
          }
        },
        "required": [
          "strategy_id"
        ],
        "additionalProperties": false
      },
      "annotations": null
    },
    {
      "name": "stockvizmfmcp__search_backtests",
      "description": "List published backtest runs; a strategy_id resolves only to its linked run.",
      "input_schema": {
        "type": "object",
        "properties": {
          "strategy_id": {
            "type": "string"
          }
        },
        "required": [
          "strategy_id"
        ],
        "additionalProperties": false
      },
      "annotations": null
    },
    {
      "name": "stockvizmfmcp__get_backtest_summary",
      "description": "Return metrics and provenance for a backtest run.",
      "input_schema": {
        "type": "object",
        "properties": {
          "run_id": {
            "type": "string"
          }
        },
        "required": [
          "run_id"
        ],
        "additionalProperties": false
      },
      "annotations": null
    },
    {
      "name": "stockvizmfmcp__get_backtest_metrics",
      "description": "Calculate performance metrics for arbitrary backtest windows directly from published monthly observations.",
      "input_schema": {
        "type": "object",
        "properties": {
          "run_id": {
            "type": "string"
          },
          "series": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "maxItems": 20
          },
          "start": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "end": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        },
        "required": [
          "run_id",
          "series",
          "start",
          "end"
        ],
        "additionalProperties": false
      },
      "annotations": null
    },
    {
      "name": "stockvizmfmcp__compare_strategies",
      "description": "Compare published backtest summaries by run ID.",
      "input_schema": {
        "type": "object",
        "properties": {
          "run_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "maxItems": 10
          }
        },
        "required": [
          "run_ids"
        ],
        "additionalProperties": false
      },
      "annotations": null
    },
    {
      "name": "stockvizmfmcp__explain_signal",
      "description": "Explain a factor-momentum signal without inventing missing factor history.",
      "input_schema": {
        "type": "object",
        "properties": {
          "strategy_id": {
            "type": "string"
          },
          "signal_date": {
            "type": "string"
          }
        },
        "required": [
          "strategy_id",
          "signal_date"
        ],
        "additionalProperties": false
      },
      "annotations": null
    },
    {
      "name": "stockvizmfmcp__get_index_metrics",
      "description": "Compare approved factor indices and NIFTY 500 TR over a daily date window using finance-toolkit; returns compact metrics and a winner only for aligned, covered windows, never raw levels.",
      "input_schema": {
        "type": "object",
        "properties": {
          "indices": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "NIFTY500 LOW VOLATILITY 50 TR",
                "NIFTY500 MOMENTUM 50 TR",
                "NIFTY500 QUALITY 50 TR",
                "NIFTY500 VALUE 50 TR",
                "NIFTY 500 TR"
              ]
            },
            "minItems": 1,
            "maxItems": 5
          },
          "start": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "end": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        },
        "required": [
          "indices",
          "start",
          "end"
        ],
        "additionalProperties": false
      },
      "annotations": null
    },
    {
      "name": "stockvizmfmcp__get_data_quality",
      "description": "Return dataset freshness and validation status.",
      "input_schema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "annotations": null
    }
  ],
  "unavailable_metadata": [
    "MCP tool annotations",
    "A runtime tools/list response containing complete StockViz tool metadata",
    "Exact schemas for any StockViz operations not exposed in the current callable-tool registry"
  ]
}
