{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "mentionedon": {
      "type": "streamable-http",
      "url": "https://mentioned-on.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "authorizationServerBase": "https://mentioned-on.com",
            "resource": "https://mentioned-on.com/mcp",
            "registrationUrl": "https://mentioned-on.com/oauth/register",
            "authorizationUrl": "https://mentioned-on.com/oauth/authorize",
            "tokenUrl": "https://mentioned-on.com/oauth/token",
            "baseScopes": [
              "brands:read",
              "website:write"
            ]
          }
        }
      }
    }
  }
}
