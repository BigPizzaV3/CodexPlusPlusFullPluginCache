{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "average-rent": {
      "type": "streamable-http",
      "url": "https://average-rent.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": { "mode": "cimd" },
            "defaultScopes": ["rent:read"],
            "baseScopes": ["offline_access"],
            "oidcEnabled": true,
            "oidcScopesSupported": ["openid", "email"]
          }
        }
      }
    }
  }
}
