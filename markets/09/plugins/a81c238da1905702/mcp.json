{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "fiest": {
      "type": "streamable-http",
      "url": "https://mcp.fiest.io/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "baseScopes": ["openid", "offline_access"],
            "defaultScopes": [
              "openid",
              "profile",
              "email",
              "offline_access",
              "fiest.restaurant.read",
              "fiest.analytics.read",
              "fiest.orders.read",
              "fiest.inventory.read",
              "fiest.menu.read",
              "fiest.organization.read",
              "fiest.accounting.read",
              "fiest.tasks.read",
              "fiest.tasks.write",
              "fiest.inventory.documents.read",
              "fiest.inventory.documents.write",
              "fiest.receipts.read",
              "fiest.invoicing.read",
              "fiest.invoicing.write",
              "fiest.campaigns.read",
              "fiest.campaigns.propose",
              "fiest.surplus.read",
              "fiest.surplus.propose",
              "fiest.accounting.corrections.write",
              "fiest.menu.structure.write",
              "fiest.menu.publish.write",
              "fiest.catalog.import.write",
              "fiest.inventory.import.write",
              "fiest.opening-hours.write"
            ]
          }
        }
      }
    }
  }
}
