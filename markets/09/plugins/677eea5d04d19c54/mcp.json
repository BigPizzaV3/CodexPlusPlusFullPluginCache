{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "onemoreday": {
      "type": "streamable-http",
      "url": "https://onemoreday-api.onrender.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "cimd"
            },
            "resource": "https://onemoreday-api.onrender.com/mcp",
            "defaultScopes": [
              "omd.health.read",
              "omd.workouts.read",
              "omd.nutrition.read",
              "omd.plans.read",
              "omd.goals.read",
              "omd.social.read",
              "omd.settings.read",
              "omd.avatars.read",
              "omd.business.read",
              "omd.nutrition.write",
              "omd.missions.write",
              "omd.workouts.write",
              "omd.sleep.write",
              "omd.social.write",
              "omd.coaching.write",
              "omd.settings.write",
              "omd.avatars.write",
              "omd.plans.write"
            ]
          }
        }
      }
    }
  }
}
