{
    "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
    "mcpServers": {
        "voicelogs": {
            "type": "streamable-http",
            "url": "https://api.voicelogs.co/mcp",
            "extensions": {
                "com.openai": {
                    "auth": {
                        "type": "oauth",
                        "client": {
                            "mode": "dcr"
                        },
                        "authorizationUrl": "https://api.voicelogs.co/oauth/authorize",
                        "tokenUrl": "https://api.voicelogs.co/oauth/token",
                        "registrationUrl": "https://api.voicelogs.co/oauth/register",
                        "baseScopes": [
                            "mcp:read"
                        ]
                    }
                }
            }
        }
    }
}
