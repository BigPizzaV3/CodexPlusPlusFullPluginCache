{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "activepieces-cloud-plugin",
  "version": "1.0.0",
  "description": "Use Activepieces to build, manage, and run automations using natural language.",
  "author": {
    "name": "Activepieces",
    "email": "support@activepieces.com",
    "url": "https://www.activepieces.com"
  },
  "homepage": "https://www.activepieces.com",
  "license": "MIT",
  "keywords": [
    "automation",
    "workflows",
    "AI",
    "MCP"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Activepieces",
        "shortDescription": "AI workflow automation",
        "longDescription": "Use Activepieces to build, manage, and run automations across your connected apps using natural language.",
        "developerName": "Activepieces",
        "category": "Productivity",
        "capabilities": [
          "Build and edit automation workflows through Chat",
          "Build and run AI agents through Chat",
          "Execute tasks across 760+ apps",
          "Manage and run existing workflows using natural language"
        ],
        "websiteURL": "https://www.activepieces.com",
        "supportURL": "https://community.activepieces.com/c/need-help/5",
        "privacyPolicyURL": "https://www.activepieces.com/privacy",
        "termsOfServiceURL": "https://www.activepieces.com/terms",
        "defaultPrompt": [
          "Summarize the content of the recent docs in my Google Drive",
          "Show me my Activepieces flows",
          "Help me build a workflow"
        ],
        "logo": "./assets/activepieces-logo.png"
      },
      "apps": "./.app.json"
    }
  }
}
