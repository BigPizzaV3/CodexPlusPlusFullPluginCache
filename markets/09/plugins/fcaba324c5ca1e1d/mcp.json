{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "preismonitoring-mcp": {
      "type": "streamable-http",
      "url": "https://api.preismonitoring.de/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "mixed",
            "client": {
              "mode": "cimd"
            },
            "baseScopes": [
              "mcp",
              "offline_access"
            ]
          }
        }
      }
    }
  }
}
