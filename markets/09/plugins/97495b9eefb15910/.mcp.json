{
  "mcpServers": {
    "standout": {
      "type": "streamable-http",
      "url": "https://standout.work/api/talent/mcp/public",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "mixed",
            "client": {
              "mode": "cimd"
            },
            "authorizationUrl": "https://standout.work/api/talent/mcp/oauth/authorize",
            "tokenUrl": "https://standout.work/api/talent/mcp/oauth/token",
            "defaultScopes": ["talent:read", "talent:write"]
          }
        }
      }
    }
  }
}
