      "interface": {
        "displayName": "KAIL \uacfc\uc2e4\ube44\uc728",
        "shortDescription": "\uacfc\uc2e4\ube44\uc728\uc744 \ub3c4\ud45c\u00b7\ud310\ub840\ub85c \ud310\uc815",
        "longDescription": "\ub300\ud55c\ubbfc\uad6d\uc5d0\uc11c \ub09c \uc790\ub3d9\ucc28 \uc0ac\uace0\uc758 \uacfc\uc2e4\ube44\uc728\uc744 \ud310\uc815\ud569\ub2c8\ub2e4.\n\n\uc0ac\uace0 \uc0c1\ud669\uc744 \ub9d0\ub85c \uc124\uba85\ud558\uba74 \ud310\uc815\uc5d0 \ud544\uc694\ud55c \uc0ac\uc2e4\uc744 \ud55c \ubc88\uc5d0 \ud558\ub098\uc529 \ub418\ubb3c\uc5b4 \uc881\ud788\uace0, \uc190\ud574\ubcf4\ud5d8\ud611\ud68c \u300c\uc790\ub3d9\ucc28\uc0ac\uace0 \uacfc\uc2e4\ube44\uc728 \uc778\uc815\uae30\uc900\u300d\uc758 \uacf5\uc2dd \ub3c4\ud45c \uc911 \ud574\ub2f9 \uc720\ud615\uc744 \ucc3e\uc544 \uae30\ubcf8 \uacfc\uc2e4\ube44\uc728\uacfc \uac00\uac10 \uc694\uc18c\ub97c \uc81c\uc2dc\ud569\ub2c8\ub2e4.\n\n\u00b7 \uc65c \uadf8 \ube44\uc728\uc778\uc9c0 \u2014 \uc801\uc6a9\ub41c \ubc95\ub9ac\uc640 \ub3c4\ub85c\uad50\ud1b5\ubc95 \uc870\ubb38, \ub300\ubc95\uc6d0 \ud310\uc2dc\ub97c \ud568\uaed8 \ub0c5\ub2c8\ub2e4.\n\u00b7 \uc2e4\uc81c \ud310\uacb0\uc740 \uc5b4\ub560\ub294\uc9c0 \u2014 \uac19\uc740 \uc720\ud615\uc758 \ud558\uae09\uc2ec \ud310\uacb0\uc744 \ucc3e\uc544, \uc0ac\uac74\ubc88\ud638\uc640 \ud310\uc2dc\ub97c \uc778\uc6a9\ud558\uace0 \u300c\uadf8 \ud310\uacb0\uc5d0\uc11c \ube44\uc728\uc744 \uac00\ub978 \uc0ac\uc815\u300d\uc774 \ubb34\uc5c7\uc774\uc5c8\ub294\uc9c0 \ubcf4\uc5ec\uc90d\ub2c8\ub2e4.\n\n\ud310\uc815\uc740 \uaddc\uce59 \uae30\ubc18 \ud310\uc815\uae30\uac00 \ud558\uba70, \ub3c4\ud45c\u00b7\ud310\uacb0\u00b7\uc870\ubb38\uc740 \ubaa8\ub450 \uacf5\uac1c\ub41c \uc790\ub8cc\uc785\ub2c8\ub2e4.\n\n\u26d4\ub300\ud55c\ubbfc\uad6d\uc5d0\uc11c \ub09c \uc0ac\uace0\ub9cc \ub2e4\ub8f9\ub2c8\ub2e4.\n\u26d4\ucc38\uace0 \uc790\ub8cc\uc774\uba70 \ubc95\ub960 \uc790\ubb38\uc774 \uc544\ub2d9\ub2c8\ub2e4. \uad6c\uccb4\uc801\uc778 \uc0ac\uac74\uc740 \ubcc0\ud638\uc0ac\uc640 \uc0c1\ub2f4\ud558\uc2ed\uc2dc\uc624.",
        "developerName": "HONG KYUN SHIN",
        "capabilities": [
          "Read"
        ],
        "websiteURL": "https://accident.kail.kr",
        "privacyPolicyURL": "https://accident.kail.kr/privacy",
        "termsOfServiceURL": "https://accident.kail.kr/terms",
        "defaultPrompt": [
          "\uc2e0\ud638 \uc5c6\ub294 \uad50\ucc28\ub85c\uc5d0\uc11c \uc9c1\uc9c4\ud558\ub2e4 \uc67c\ucabd \ub3c4\ub85c\uc5d0\uc11c \ub098\uc628 \ucc28\uc640 \ubd80\ub52a\ud614\uc5b4\uc694. \uacfc\uc2e4\ube44\uc728\uc774 \uc5b4\ub5bb\uac8c \ub418\ub098\uc694?",
          "\ub9de\uc740\ud3b8\uc5d0\uc11c \uc88c\ud68c\uc804\ud558\ub294 \ucc28\uc640 \ubd80\ub52a\ud614\uc2b5\ub2c8\ub2e4. \uc81c \uc2e0\ud638\ub294 \ub179\uc0c9\uc774\uc5c8\uc5b4\uc694.",
          "\uc81c \uacfc\uc2e4\uc774 40%\ub85c \ub098\uc654\ub294\ub370, \uc774\ub97c \ub0ae\ucd9c \uadfc\uac70\uac00 \ub418\ub294 \ud310\ub840\uac00 \uc788\ub098\uc694?"
        ],
