{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "tovelai": {
      "type": "streamable-http",
      "url": "https://web.tovel.ai/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "authorizationUrl": "https://web.tovel.ai/mcp-oauth/authorize",
            "tokenUrl": "https://web.tovel.ai/mcp-oauth/token",
            "registrationUrl": "https://web.tovel.ai/mcp-oauth/register",
            "resource": "https://web.tovel.ai/mcp"
          }
        }
      }
    }
  }
}
