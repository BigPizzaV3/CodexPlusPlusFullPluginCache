{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "attentive": {
      "type": "streamable-http",
      "url": "https://attentive-ui-mcp.attentivemobile.com/mcp?readOnly=false",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "baseScopes": [
              "mcp",
              "offline_access"
            ],
            "defaultScopes": [
              "mcp",
              "offline_access"
            ]
          }
        }
      }
    }
  }
}
