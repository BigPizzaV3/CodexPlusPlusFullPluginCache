{
  "mcpServers": {
    "switchbooks-remote": {
      "type": "streamable-http",
      "url": "https://app.switchbooks.ai/api/mcp/chatgpt",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "baseScopes": [
              "switchbooks.read"
            ],
            "defaultScopes": [
              "switchbooks.read",
              "switchbooks.write"
            ]
          }
        }
      }
    }
  }
}
