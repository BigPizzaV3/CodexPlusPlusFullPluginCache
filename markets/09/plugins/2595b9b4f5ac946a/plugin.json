{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "truecal",
  "version": "0.1.7",
  "description": "Log meals, review your food diary, and track recorded weight and available synced activity.",
  "author": {
    "name": "SUPERBOX LLC",
    "email": "support@truecal.com",
    "url": "https://truecal.com"
  },
  "homepage": "https://truecal.com",
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "TrueCal",
        "shortDescription": "Log meals and track progress",
        "longDescription": "Connect your TrueCal account to log meals from food descriptions, review saved meals and daily totals, view recorded weight and activity already synced to TrueCal, and add a weight entry. Features depend on account access and usage limits. Nutrition results are estimates.",
        "developerName": "SUPERBOX LLC",
        "websiteURL": "https://truecal.com",
        "supportURL": "https://truecal.com/faq",
        "privacyPolicyURL": "https://truecal.com/privacy",
        "termsOfServiceURL": "https://truecal.com/terms",
        "logo": "./assets/icon.png",
        "composerIcon": "./assets/icon.png",
        "category": "Healthcare",
        "capabilities": [
          "Log meals",
          "Review food diary",
          "Track weight and progress"
        ],
        "defaultPrompt": [
          "Log a chicken rice bowl and a cup of Greek yogurt for lunch.",
          "Show my weight and progress.",
          "How many calories have I logged today?"
        ]
      },
      "review": {
        "demo_recording_url": "https://storage.googleapis.com/truecal-assets/chatgpt-plugin/review/20261001/f65eb5deb0b00ec12cf3dbeba652b326a52167b86911c76e11f05b479ccbc958/truecal-submission-walkthrough.mp4"
      },
      "apps": "./.app.json"
    }
  }
}
