{
  "name": "zelta-bmi-india",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --no-warnings --test tests/*.test.mjs",
    "check": "npm run typecheck && npm test && wrangler deploy --dry-run --outdir /tmp/wrangler-dry-$npm_package_name",
    "deploy": "wrangler deploy",
    "smoke": "node --experimental-strip-types --no-warnings scripts/smoke.mjs",
    "package": "node --experimental-strip-types --no-warnings scripts/package.mjs"
  },
  "dependencies": {
    "astronomy-engine": "^2.1.19"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260930.2",
    "typescript": "^5.6.0",
    "wrangler": "^4.40.0"
  }
}
