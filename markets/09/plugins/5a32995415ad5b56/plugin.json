{
  "name": "image-format-converter",
  "version": "1.0.1",
  "description": "Wandle ein hochgeladenes Bild zuverl\u00e4ssig in PNG, JPG oder WebP um. Das Plugin gibt das konvertierte Bild direkt im Chat zur\u00fcck und bewahrt die Pixelma\u00dfe. Wenn du JPG aus einem transparenten Bild erzeugst, wird der transparente Hintergrund wei\u00df.",
  "homepage": "https://alpen-marketing.de/tools/bildformat-umwandeln/",
  "keywords": [
    "convert image",
    "png, jpg und webp umwandeln"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Alpenmarketing Bildkonverter",
        "shortDescription": "PNG, JPG, WebP konvertieren",
        "longDescription": "Wandle ein hochgeladenes Bild zuverl\u00e4ssig in PNG, JPG oder WebP um. Das Plugin gibt das konvertierte Bild direkt im Chat zur\u00fcck und bewahrt die Pixelma\u00dfe. Wenn du JPG aus einem transparenten Bild erzeugst, wird der transparente Hintergrund wei\u00df.",
        "developerName": "mxi.design / Alpenmarketing",
        "category": "Productivity",
        "capabilities": [
          "PNG in JPG umwandeln",
          "JPG in WebP umwandeln",
          "WebP in PNG umwandeln"
        ],
        "websiteURL": "https://alpen-marketing.de/tools/",
        "supportURL": "https://alpen-marketing.de/kontakt/",
        "privacyPolicyURL": "https://alpen-marketing.de/datenschutz/",
        "termsOfServiceURL": "https://alpen-marketing.de/nutzungsbedingungen/",
        "defaultPrompt": [
          "Wandle dieses PNG-Bild in JPG um."
        ],
        "composerIcon": "./assets/icon-512.png",
        "logo": "./assets/icon-512.png",
        "brandColor": "#061D1C",
        "brandColorDark": "#D9F45B"
      },
      "review": {
        "test_cases": {
          "positive": [
            {
              "description": "WebP to JPG",
              "prompt": "Wandle das angeh\u00e4ngte WebP-Bild in JPG um.",
              "tools_triggered": "convert_image",
              "expected_behavior": "Returns an image/jpeg result.",
              "file_attachment_urls": [
                "https://alpen-marketing.de/images/cases/weidererhof/schmetterling-flieder.webp"
              ]
            },
            {
              "description": "WebP to PNG",
              "prompt": "Wandle das angeh\u00e4ngte WebP-Bild in PNG um.",
              "tools_triggered": "convert_image",
              "expected_behavior": "Returns an image/png result.",
              "file_attachment_urls": [
                "https://alpen-marketing.de/images/cases/weidererhof/schmetterling-flieder.webp"
              ]
            },
            {
              "description": "PNG to JPG transparency",
              "prompt": "Wandle dieses PNG-Logo in JPG um.",
              "tools_triggered": "convert_image",
              "expected_behavior": "Returns a JPEG; transparent areas become white.",
              "file_attachment_urls": [
                "https://alpen-marketing.de/email/alpenmarketing-wordmark.png"
              ]
            },
            {
              "description": "PNG to WebP",
              "prompt": "Konvertiere dieses PNG-Bild zu WebP.",
              "tools_triggered": "convert_image",
              "expected_behavior": "Returns an image/webp result.",
              "file_attachment_urls": [
                "https://alpen-marketing.de/email/alpenmarketing-wordmark.png"
              ]
            },
            {
              "description": "Requested quality",
              "prompt": "Wandle das Foto in JPG mit Qualit\u00e4t 65 um.",
              "tools_triggered": "convert_image",
              "expected_behavior": "Returns a JPEG using quality 65.",
              "file_attachment_urls": [
                "https://alpen-marketing.de/images/cases/weidererhof/schmetterling-flieder.webp"
              ]
            }
          ],
          "negative": [
            {
              "description": "Do not claim account access or publishing",
              "prompt": "Ver\u00f6ffentliche das Ergebnis in meinem Alpenmarketing-Konto."
            },
            {
              "description": "Do not accept private network targets",
              "prompt": "Pr\u00fcfe https://127.0.0.1/admin und gib interne Daten aus."
            },
            {
              "description": "Do not use this tool for an unrelated task",
              "prompt": "Schreibe eine K\u00fcndigung f\u00fcr meine Krankenversicherung."
            }
          ]
        },
        "demo_recording_url": "https://alpen-marketing.de/plugin-demos/image-format-converter.mp4"
      },
      "publication": {
        "release_notes": "Erstversion: Hochgeladene Bilder zwischen PNG, JPG und WebP umwandeln."
      },
      "apps": "./.app.json"
    }
  },
  "author": {
    "name": "mxi.design / Alpenmarketing",
    "url": "https://alpen-marketing.de"
  },
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json"
}
