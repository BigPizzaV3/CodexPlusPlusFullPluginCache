{
  "name": "scaffolde-capability-builder",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": false,
      "invocation_logs": false,
      "persist": false
    },
    "traces": {
      "enabled": false,
      "persist": true
    }
  },
  "limits": {
    "cpu_ms": 10
  },
  "ratelimits": [
    {
      "name": "SERVICE_RATE_LIMITER",
      "namespace_id": "1001202610",
      "simple": {
        "limit": 300,
        "period": 60
      }
    }
  ],
  "routes": [
    {
      "pattern": "capability-builder.scaffolde.ai",
      "custom_domain": true
    }
  ],
  "preview_urls": false
}
