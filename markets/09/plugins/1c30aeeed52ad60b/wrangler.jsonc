{
  "name": "scaffolde-capability-builder",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-09-24",
  "workers_dev": false,
  "observability": {
    "enabled": false,
    "logs": {
      "enabled": false,
      "invocation_logs": false
    },
    "traces": {
      "enabled": false
    }
  },
  "limits": {
    "cpu_ms": 10
  },
  "ratelimits": [
    {
      "name": "SERVICE_RATE_LIMITER",
      "namespace_id": "1001202610",
      "simple": {
        "limit": 300,
        "period": 60
      }
    }
  ]
}
