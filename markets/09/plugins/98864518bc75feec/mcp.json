{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "ych-assistant-oauth": {
      "type": "streamable-http",
      "url": "https://openai-mcp.ychadvisory.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "https://chatgpt.com/oauth/client.json",
              "tokenEndpointAuthMethod": "none"
            },
            "resource": "https://openai-mcp.ychadvisory.com/mcp",
            "baseScopes": [
              "ych:context:read",
              "ych:development:read",
              "ych:knowledge:read",
              "ych:workflow:write",
              "offline_access"
            ]
          }
        }
      }
    }
  }
}