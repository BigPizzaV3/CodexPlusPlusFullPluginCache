{
  "name": "donestate",
  "version": "0.3.3",
  "description": "Governed autonomous coding with durable execution and independent verification handoff.",
  "author": {
    "name": "AyobamiH",
    "url": "https://github.com/AyobamiH"
  },
  "homepage": "https://proofandstate.com/donestate",
  "repository": "https://github.com/AyobamiH/donestate",
  "license": "Apache-2.0",
  "keywords": [
    "autonomous-coding",
    "developer-tools",
    "github",
    "mcp",
    "verification"
  ],
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "DoneState",
        "shortDescription": "Governed coding with proof",
        "longDescription": "Execute an authorised repository change in an isolated coding sandbox, validate the exact result, publish a branch or pull request, and stop for independent OpsTruth verification. DoneState never approves or merges its own pull request and does not deploy or publish releases.",
        "developerName": "AYOBAMI JOHN HAASTRUP",
        "category": "Developer Tools",
        "capabilities": [
          "Interactive",
          "Write"
        ],
        "websiteURL": "https://proofandstate.com/donestate",
        "privacyPolicyURL": "https://proofandstate.com/legal/privacy",
        "termsOfServiceURL": "https://proofandstate.com/legal/terms",
        "defaultPrompt": [
          "Implement this issue and open a verified PR.",
          "Run this repository objective autonomously.",
          "Maintain this selected repository with verified PR-only repairs."
        ],
        "brandColor": "#2563EB",
        "supportURL": "https://proofandstate.com/contact",
        "logo": "./assets/donestate-icon.png",
        "composerIcon": "./assets/donestate-icon.png"
      },
      "apps": "./.app.json"
    }
  }
}
