{
  "mcpServers": {
    "hidesc": {
      "type": "streamable-http",
      "url": "https://mcp.hidesc.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "authorizationServerBase": "https://mcp.hidesc.com",
            "authorizationUrl": "https://mcp.hidesc.com/oauth/authorize",
            "tokenUrl": "https://mcp.hidesc.com/oauth/token",
            "registrationUrl": "https://mcp.hidesc.com/oauth/register",
            "resource": "https://mcp.hidesc.com/mcp",
            "baseScopes": [
              "tasks:read",
              "tasks:write",
              "projects:read",
              "contacts:read",
              "users:read"
            ]
          }
        }
      }
    }
  }
}
