{
  "mcpServers": {
    "trekmail": {
      "type": "http",
      "url": "https://trekmail.net/mcp?profile=directory",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "defaultScopes": [
              "openid",
              "email",
              "messages:read",
              "messages:send",
              "messages:write",
              "tools:core",
              "tools:email",
              "tools:email_settings",
              "tools:contacts",
              "tools:calendar",
              "tools:drive",
              "tools:domains",
              "tools:white_label",
              "tools:mail_admin",
              "tools:delivery",
              "tools:migrations",
              "tools:support",
              "tools:verifier",
              "tools:credentials",
              "private-notes:read",
              "private-notes:create",
              "private-notes:write",
              "private-notes:revoke",
              "private-notes:consume",
              "private-notes:settings:read",
              "private-notes:settings:write",
              "billing:read",
              "branding:read",
              "branding:write",
              "members:read",
              "members:write",
              "activity:read",
              "domains:read",
              "domains:create",
              "domains:write",
              "domains:delete",
              "domains:dns:read",
              "domains:dns:recheck",
              "mailboxes:messages:read",
              "mailboxes:create",
              "mailboxes:write",
              "mailboxes:delete",
              "mailboxes:invites:create",
              "mailboxes:forwarding:read",
              "mailboxes:forwarding:write",
              "mailboxes:rules:read",
              "mailboxes:rules:write",
              "mailboxes:auto-reply:read",
              "mailboxes:auto-reply:write",
              "migrations:read",
              "migrations:write",
              "tickets:read",
              "tickets:write",
              "smtp:read",
              "smtp:write",
              "verify:read",
              "verify:write",
              "cloudflare:read",
              "cloudflare:write",
              "cloudflare:delete",
              "drive:account:read",
              "drive:account:write",
              "drive:account:share",
              "drive:account:purge",
              "drive:mailbox:read",
              "drive:mailbox:write",
              "drive:mailbox:share",
              "drive:mailbox:purge",
              "drive:addon:read",
              "drive:devices:read",
              "drive:devices:write"
            ]
          }
        }
      }
    }
