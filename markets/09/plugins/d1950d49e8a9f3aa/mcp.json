{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "intakra": {
      "type": "streamable-http",
      "url": "https://intakra.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "authorizationServerBase": "https://intakra.com",
            "resource": "https://intakra.com/mcp",
            "registrationUrl": "https://intakra.com/oauth/register",
            "authorizationUrl": "https://intakra.com/oauth/authorize",
            "tokenUrl": "https://intakra.com/oauth/token",
            "baseScopes": [
              "openid",
              "email",
              "accounts:read"
            ]
          }
        }
      }
    }
  }
}
