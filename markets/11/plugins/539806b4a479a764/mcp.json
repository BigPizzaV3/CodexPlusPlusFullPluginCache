{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "spellar": {
      "type": "streamable-http",
      "url": "https://mcp.spellar.ai/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "registrationUrl": "https://api.spellar.ai/api/oauth/register",
            "authorizationUrl": "https://api.spellar.ai/api/oauth/authorize",
            "tokenUrl": "https://api.spellar.ai/api/oauth/token"
          }
        }
      }
    }
  }
}