{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "energitrack": {
      "type": "streamable-http",
      "url": "https://tars.energitrack.io/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "energitrack-chatgpt-mcp-prod",
              "tokenEndpointAuthMethod": "none"
            },
            "authorizationUrl": "https://oauth.energitrack.io/oauth2/auth",
            "tokenUrl": "https://oauth.energitrack.io/oauth2/token",
            "authorizationServerBase": "https://oauth.energitrack.io",
            "resource": "https://tars.energitrack.io/mcp",
            "baseScopes": [
              "mcp:read",
              "offline_access"
            ],
            "defaultScopes": [
              "mcp:read",
              "mcp:write",
              "mcp:ems:write"
            ],
            "oidcEnabled": false
          }
        }
      }
    }
  }
}
