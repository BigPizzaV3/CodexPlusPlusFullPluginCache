{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "sunseekr": {
      "type": "streamable-http",
      "url": "https://mcp.sunseekr.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": { "mode": "dcr" },
            "defaultScopes": ["sun:read", "saved:read", "saved:write"]
          }
        }
      }
    }
  }
}
