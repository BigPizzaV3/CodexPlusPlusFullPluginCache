{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "index-movie-diary": {
      "type": "streamable-http",
      "url": "https://index-movie-diary.daffodil-coat.workers.dev/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": [
              "openid",
              "offline_access"
            ],
            "defaultScopes": [
              "diary"
            ]
          }
        }
      }
    }
  }
}
