{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "imageat": {
      "type": "streamable-http",
      "url": "https://mcp.imageat.com/chatgpt/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "imageat-chatgpt-public",
              "tokenEndpointAuthMethod": "none"
            },
            "authorizationUrl": "https://mcp.imageat.com/authorize",
            "tokenUrl": "https://mcp.imageat.com/token",
            "resource": "https://mcp.imageat.com/chatgpt/mcp",
            "baseScopes": [
              "mcp"
            ]
          }
        }
      }
    }
  }
}
