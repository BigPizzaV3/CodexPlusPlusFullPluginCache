{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "sendwhale": {
      "type": "streamable-http",
      "url": "https://www.gosendwhale.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": { "mode": "dcr" },
            "authorizationServerBase": "https://www.gosendwhale.com",
            "authorizationUrl": "https://www.gosendwhale.com/mcp/oauth/authorize",
            "tokenUrl": "https://www.gosendwhale.com/mcp/oauth/token",
            "registrationUrl": "https://www.gosendwhale.com/mcp/oauth/register",
            "resource": "https://www.gosendwhale.com/mcp",
            "baseScopes": ["workspace:read"],
            "defaultScopes": ["workspace:read", "brand:write", "email:write"]
          }
        }
      }
    }
  }
}
