{
  "mcpServers": {
    "replier": {
      "type": "http",
      "url": "https://api.usereplier.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "cimd"
            },
            "baseScopes": ["replier:read", "replier:write"]
          }
        }
      }
    }
  }
}
