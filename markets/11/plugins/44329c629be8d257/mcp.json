{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "digo-email": {
      "type": "streamable-http",
      "url": "https://www.digo.email/api/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "registrationUrl": "https://www.digo.email/api/oauth/registra",
            "authorizationUrl": "https://www.digo.email/oauth/autorizza",
            "tokenUrl": "https://www.digo.email/api/oauth/token"
          }
        }
      }
    }
  }
}
