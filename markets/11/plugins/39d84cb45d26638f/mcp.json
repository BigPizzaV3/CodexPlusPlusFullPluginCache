{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "catetin-ai": {
      "type": "streamable-http",
      "url": "https://api.catetin.ai/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "chatgpt",
              "tokenEndpointAuthMethod": "client_secret_post"
            },
            "authorizationUrl": "https://api.catetin.ai/oauth/authorize",
            "tokenUrl": "https://api.catetin.ai/oauth/token",
            "authorizationServerBase": "https://api.catetin.ai",
            "resource": "https://api.catetin.ai/mcp",
            "baseScopes": [
              "catetin.groups.read",
              "catetin.transactions.read",
              "catetin.transactions.write",
              "catetin.messages.write",
              "catetin.subscription.read",
              "catetin.groups.write",
              "catetin.messages.read",
              "catetin.profile.read",
              "catetin.profile.write",
              "catetin.exports"
            ]
          }
        }
      }
    }
  }
}
