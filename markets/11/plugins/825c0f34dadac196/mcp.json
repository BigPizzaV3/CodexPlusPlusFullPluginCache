{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "mtg-tools": {
      "type": "streamable-http",
      "url": "https://landfiller.app/mtg/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "mixed",
            "client": {
              "mode": "dcr"
            },
            "authorizationServerBase": "https://landfiller.app",
            "authorizationUrl": "https://landfiller.app/oauth/authorize",
            "tokenUrl": "https://landfiller.app/oauth/token",
            "registrationUrl": "https://landfiller.app/oauth/register",
            "resource": "https://landfiller.app/mtg/mcp",
            "defaultScopes": [
              "plans:read",
              "plans:write"
            ],
            "oidcEnabled": false
          }
        }
      }
    }
  }
}
