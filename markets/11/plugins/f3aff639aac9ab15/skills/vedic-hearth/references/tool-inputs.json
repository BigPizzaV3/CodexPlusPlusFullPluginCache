{
  "tool": "shortlist_products",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "query": {
        "default": "",
        "type": "string",
        "maxLength": 80
      },
      "maxPricePaise": {
        "type": "integer",
        "minimum": 0,
        "maximum": 1000000000
      },
      "material": {
        "default": "",
        "type": "string",
        "maxLength": 80
      }
    },
    "required": [
      "query",
      "material"
    ],
    "additionalProperties": false
  },
  "example": {
    "query": "",
    "maxPricePaise": 600000,
    "material": ""
  },
  "exampleNotice": "Example product handles must be confirmed through search_products before use. Prices and availability are not guaranteed by examples."
}
