{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "mcp-fit": {
      "type": "streamable-http",
      "url": "https://mcp-fit-connect.stfngg.chatgpt.site/connector",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "defaultScopes": [
              "fit.read",
              "fit.write"
            ]
          }
        }
      }
    }
  }
}
