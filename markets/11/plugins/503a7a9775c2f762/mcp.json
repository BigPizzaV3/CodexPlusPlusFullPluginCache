{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "talktodata-merchant-insights": {
      "type": "streamable-http",
      "url": "https://talktodata.navines.com/mcp/google-merchant",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "cimd"
            },
            "baseScopes": [
              "google_merchant.read"
            ],
            "defaultScopes": [
              "google_merchant.read",
              "google_merchant.write"
            ]
          }
        }
      }
    }
  }
}
