{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "nihongo321": {
      "type": "streamable-http",
      "url": "https://mcp.nihongo321.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "authorizationUrl": "https://auth.nihongo321.com/authorize",
            "tokenUrl": "https://auth.nihongo321.com/oauth/token",
            "baseScopes": [
              "learning:read",
              "learning:write",
              "quiz:read",
              "quiz:write"
            ],
            "client": {
              "mode": "provided",
              "clientId": "GcsnheZ8HyYqM8T8kUsEXvIw7KQ5KLop",
              "tokenEndpointAuthMethod": "client_secret_post"
            }
          }
        }
      }
    }
  }
}
