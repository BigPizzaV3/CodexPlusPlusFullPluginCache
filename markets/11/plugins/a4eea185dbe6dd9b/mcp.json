{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "fleetkeep-full": {
      "type": "streamable-http",
      "url": "https://fleetkeep.co.uk/api/mcp/full",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "fleetkeep-openai-full",
              "tokenEndpointAuthMethod": "none"
            },
            "authorizationUrl": "https://fleetkeep.co.uk/auth/oauth2/authorize",
            "tokenUrl": "https://fleetkeep.co.uk/auth/oauth2/token",
            "authorizationServerBase": "https://fleetkeep.co.uk/auth",
            "resource": "https://fleetkeep.co.uk/api",
            "baseScopes": [
              "vehicles:read",
              "vehicles:write",
              "operations:read",
              "operations:write",
              "tolls:read",
              "tolls:write",
              "documents:read",
              "documents:write",
              "maintenance:read",
              "maintenance:write",
              "reminders:read",
              "reminders:write",
              "profile:read",
              "guidance:read",
              "exports:read",
              "offline_access"
            ],
            "defaultScopes": [],
            "oidcEnabled": false
          }
        }
      }
    }
  }
}
