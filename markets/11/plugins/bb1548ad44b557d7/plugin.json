{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "popety",
  "version": "1.0.0",
  "description": "Swiss real-estate intelligence: 9 guided workflows (parcel reports, valuations, market analysis, development sourcing) driving the Popety.io connector.",
  "author": {
    "name": "Popety.io"
  },
  "homepage": "https://developers.popety.io",
  "repository": "https://github.com/Popety/popety-io-claude-plugin",
  "license": "MIT",
  "keywords": [
    "swiss",
    "real-estate",
    "proptech",
    "cadastre",
    "valuation",
    "zoning",
    "mcp"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Popety.io",
        "shortDescription": "Swiss real-estate intelligence",
        "longDescription": "Swiss real-estate intelligence: 9 guided workflows (parcel reports, valuations, market analysis, development sourcing) driving the Popety.io connector.",
        "developerName": "Popety.io",
        "category": "Data & Analytics",
        "capabilities": [
          "Read"
        ],
        "websiteURL": "https://www.popety.io",
        "supportURL": "https://popety.io/contact",
        "privacyPolicyURL": "https://developers.popety.io/privacy",
        "termsOfServiceURL": "https://developers.popety.io/terms",
        "logo": "./assets/logo.png",
        "screenshots": [
          "./assets/shot-1-value-estimate.png",
          "./assets/shot-2-listings-grid.png",
          "./assets/shot-3-market-stats.png",
          "./assets/shot-4-parcel-card.png",
          "./assets/shot-5-regulations.png"
        ],
        "brandColor": "#00ADE6"
      },
      "apps": "./.app.json"
    }
  }
}
