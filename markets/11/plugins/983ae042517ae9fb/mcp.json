{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "beksar": {
      "type": "streamable-http",
      "url": "https://mcp.beksar.kz/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "mixed",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": [
              "analytics:read",
              "inventory:write"
            ]
          }
        }
      }
    }
  }
}
