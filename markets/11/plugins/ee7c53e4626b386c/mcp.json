{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "swingsmith": {
      "type": "streamable-http",
      "url": "https://connect.swingsmithpro.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": [
              "openid",
              "email",
              "offline_access",
              "account:read",
              "analyses:read",
              "drills:read"
            ]
          }
        }
      }
    }
  }
}
