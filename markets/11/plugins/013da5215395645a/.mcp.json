{
  "mcpServers": {
    "BlueSkil": {
      "url": "https://api.blueskil.com/api/v1/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "mixed",
            "client": {
              "mode": "dcr"
            },
            "defaultScopes": [
              "jobs:read",
              "jobs:write",
              "applications:read",
              "applications:write",
              "profile:read",
              "profile:write",
              "messages:read",
              "messages:write",
              "companies:read",
              "companies:write",
              "candidates:read",
              "ai:generate",
              "ugc:read",
              "ugc:write",
              "activity:read"
            ]
          }
        }
      }
    }
  }
}