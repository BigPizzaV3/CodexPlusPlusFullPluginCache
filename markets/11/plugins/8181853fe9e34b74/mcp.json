{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "longevity": {
      "type": "streamable-http",
      "url": "https://golongevity.app/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "2891c1f8-15f5-4ae2-9143-02f67fe8eb61",
              "tokenEndpointAuthMethod": "none"
            },
            "baseScopes": ["offline_access"],
            "defaultScopes": ["email"],
            "oidcEnabled": false
          }
        }
      }
    }
  }
}
