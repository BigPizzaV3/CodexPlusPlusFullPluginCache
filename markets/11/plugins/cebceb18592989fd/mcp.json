{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "cuentix": {
      "type": "streamable-http",
      "url": "https://www.cuentixapp.com/api/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": [
              "financial:read"
            ]
          }
        }
      }
    }
  }
}
