{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "crosspublish": {
      "type": "streamable-http",
      "url": "https://crosspublish.com/api/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": { "mode": "cimd" },
            "authorizationServerBase": "https://crosspublish.com/api/auth",
            "resource": "https://crosspublish.com/api/mcp",
            "baseScopes": ["openid", "offline_access"]
          }
        }
      }
    }
  }
}
