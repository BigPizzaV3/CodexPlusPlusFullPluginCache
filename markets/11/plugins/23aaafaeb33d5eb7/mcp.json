{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "clariomoney": {
      "type": "streamable-http",
      "url": "https://clariov4.cloud/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "registrationUrl": "https://clariov4.cloud/conectar/registro",
            "authorizationUrl": "https://clariov4.cloud/conectar/autorizar",
            "tokenUrl": "https://clariov4.cloud/conectar/token",
            "resource": "https://clariov4.cloud/mcp",
            "baseScopes": [
              "clario.read"
            ],
            "defaultScopes": [
              "clario.import",
              "clario.draft",
              "clario.invoice",
              "clario.movements",
              "clario.manage"
            ]
          }
        }
      }
    }
  }
}