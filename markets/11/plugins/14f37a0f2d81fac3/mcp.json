{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "previdian": {
      "type": "streamable-http",
      "url": "https://mcp.previdian.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "https://previdian.com/.well-known/chatgpt-oauth-client.json",
              "tokenEndpointAuthMethod": "none"
            },
            "baseScopes": [
              "enterprise:read",
              "offline_access"
            ]
          }
        }
      }
    }
  }
}
