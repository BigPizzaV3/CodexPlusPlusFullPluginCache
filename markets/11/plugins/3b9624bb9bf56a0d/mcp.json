{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "physioai": {
      "type": "streamable-http",
      "url": "https://auth.physioai.in/functions/v1/synergist-mcp/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "registrationUrl": "https://auth.physioai.in/functions/v1/synergist-mcp/oauth/register",
            "baseScopes": ["mcp:ask", "mcp:profile"]
          }
        }
      }
    }
  }
}
