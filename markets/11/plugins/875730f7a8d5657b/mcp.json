{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "gryz": {
      "type": "streamable-http",
      "url": "https://www.gryz.ai/api/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "authorizationUrl": "https://www.gryz.ai/oauth/authorize/",
            "tokenUrl": "https://www.gryz.ai/api/oauth/token/",
            "registrationUrl": "https://www.gryz.ai/api/oauth/register/",
            "baseScopes": [
              "documents",
              "memory:read",
              "memory:write",
              "projects:read",
              "projects:write",
              "skills:read",
              "skills:write",
              "tasks:write",
              "broker:read"
            ]
          }
        }
      }
    }
  }
}
