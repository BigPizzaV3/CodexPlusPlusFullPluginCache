{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "inkable-docs": {
      "type": "streamable-http",
      "url": "https://inkabledocs.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "13RVcdWLordZDAsa",
              "tokenEndpointAuthMethod": "none"
            },
            "authorizationUrl": "https://clerk.inkabledocs.com/oauth/authorize",
            "tokenUrl": "https://clerk.inkabledocs.com/oauth/token",
            "baseScopes": ["checks:run", "reports:read"]
          }
        }
      }
    }
  }
}
