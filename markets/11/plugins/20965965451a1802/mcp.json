{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "engagence": {
      "type": "streamable-http",
      "url": "https://engagence.ai/api/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "registrationUrl": "https://engagence.ai/api/oauth/register",
            "authorizationUrl": "https://engagence.ai/api/oauth/authorize",
            "tokenUrl": "https://engagence.ai/api/oauth/token",
            "baseScopes": [
              "account:read",
              "account:write"
            ]
          }
        }
      }
    }
  }
}
