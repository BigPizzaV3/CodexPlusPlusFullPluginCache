{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "nestforms": {
      "type": "streamable-http",
      "url": "https://www.nestforms.com/mcp/server.php",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "z5UnW4iRYtFCiHXxH9DK",
              "tokenEndpointAuthMethod": "client_secret_basic"
            },
            "authorizationUrl": "https://www.nestforms.com/api/authorize",
            "tokenUrl": "https://www.nestforms.com/api/access_token",
            "baseScopes": [
              "mcp:read"
            ]
          }
        }
      }
    }
  }
}
