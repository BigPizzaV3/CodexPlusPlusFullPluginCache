{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "issuebadge": {
      "type": "streamable-http",
      "url": "https://issuebadge-mcp.issuebadge.workers.dev/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "registrationUrl": "https://app.issuebadge.com/oauth/register",
            "authorizationUrl": "https://app.issuebadge.com/oauth/authorize",
            "tokenUrl": "https://app.issuebadge.com/oauth/token",
            "baseScopes": [
              "read",
              "write"
            ]
          }
        }
      }
    }
  }
}