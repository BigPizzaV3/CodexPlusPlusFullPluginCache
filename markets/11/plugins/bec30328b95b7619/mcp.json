{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "ativoplay-prod": {
      "type": "streamable-http",
      "url": "https://mcp-prod.ativoplay.com.br/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "chatgpt-ativoplay-private-pilot",
              "tokenEndpointAuthMethod": "none"
            },
            "authorizationUrl": "https://app.ativoplay.com.br/oauth/mcp/authorize",
            "tokenUrl": "https://app.ativoplay.com.br/oauth/mcp/token",
            "resource": "https://mcp-prod.ativoplay.com.br",
            "baseScopes": [
              "ativoplay.read",
              "media:read",
              "media:write",
              "playlists:write",
              "screens:write"
            ]
          }
        }
      }
    }
  }
}
