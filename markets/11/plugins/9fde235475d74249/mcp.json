{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "trippy-days": {
      "type": "streamable-http",
      "url": "https://www.trippy-days.com/api/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": ["trips:read", "trips:write", "offline_access"]
          }
        }
      }
    }
  }
}
