{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "arcopolis": {
      "type": "streamable-http",
      "url": "https://api.arcopolis.ai/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "mixed",
            "client": {
              "mode": "provided",
              "clientId": "https://chatgpt.com/oauth/client.json",
              "tokenEndpointAuthMethod": "none"
            },
            "authorizationUrl": "https://api.arcopolis.ai/oauth/authorize",
            "tokenUrl": "https://api.arcopolis.ai/oauth/token",
            "authorizationServerBase": "https://api.arcopolis.ai",
            "resource": "https://api.arcopolis.ai/mcp",
            "baseScopes": [
              "arcopolis.read",
              "arcopolis.visitor"
            ]
          }
        }
      }
    }
  }
}
