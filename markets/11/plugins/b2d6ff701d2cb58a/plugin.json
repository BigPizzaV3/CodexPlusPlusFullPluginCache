{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "lihi",
  "version": "0.3.2",
  "description": "Access lihi account status, group and domain switching, and automatic URL shortening through one OAuth MCP connection.",
  "author": {
    "name": "lihi",
    "url": "https://lihi.io/"
  },
  "homepage": "https://lihi.io/",
  "keywords": [
    "lihi",
    "mcp",
    "oauth",
    "account",
    "quota",
    "subscription",
    "work-group",
    "group-switching",
    "domain-switching",
    "short-url",
    "copywriting",
    "polishing",
    "publishing"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "lihi",
        "shortDescription": "Short URLs and account tools",
        "longDescription": "Connects once to the lihi OAuth MCP server for account status, group and domain switching, and automatic URL shortening while revising or preparing human-facing content.",
        "developerName": "lihi",
        "category": "Productivity",
        "capabilities": [
          "Interactive",
          "Write"
        ],
        "websiteURL": "https://lihi.io/",
        "privacyPolicyURL": "https://knowledge.lihi.io/privacy-policy/",
        "termsOfServiceURL": "https://knowledge.lihi.io/terms/",
        "defaultPrompt": [
          "Show my lihi account information",
          "View or switch my lihi work group or short URL domain",
          "Polish copy and automatically shorten detected new URLs"
        ],
        "supportURL": "https://lihistatus.com/contact",
        "composerIcon": "./assets/composer-icon.png",
        "logo": "./assets/logo.png"
      },
      "apps": "./.app.json"
    }
  }
}
