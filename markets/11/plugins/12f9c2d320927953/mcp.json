{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "groundbook": {
      "type": "streamable-http",
      "url": "https://app.groundbook.ai/api/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "defaultScopes": [
              "read",
              "write"
            ]
          }
        }
      }
    }
  }
}
