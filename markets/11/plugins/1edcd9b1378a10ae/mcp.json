{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "leadx": {
      "type": "streamable-http",
      "url": "https://agents.leadx.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "resource": "https://agents.leadx.com/mcp",
            "baseScopes": ["mcp.tools"],
            "defaultScopes": [
              "companies.read",
              "contacts.read",
              "ucc.read",
              "email.find",
              "mobile.find",
              "all_attributes.read",
              "bbb.read",
              "google_reviews.read"
            ]
          }
        }
      }
    }
  }
}
