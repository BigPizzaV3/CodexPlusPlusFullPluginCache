{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "reelsfarm": {
      "type": "streamable-http",
      "url": "https://mcp.reelsfarm.com/plugin/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "authorizationServerBase": "https://mcp.reelsfarm.com",
            "authorizationUrl": "https://mcp.reelsfarm.com/oauth/authorize",
            "tokenUrl": "https://mcp.reelsfarm.com/oauth/token",
            "registrationUrl": "https://mcp.reelsfarm.com/oauth/register",
            "resource": "https://mcp.reelsfarm.com/plugin/mcp"
          }
        }
      }
    }
  }
}
