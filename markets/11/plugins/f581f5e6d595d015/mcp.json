{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "reachype": {
      "type": "streamable-http",
      "url": "https://mcp.reachype.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": [
              "reachype:read",
              "reachype:write",
              "reachype:generate"
            ]
          }
        }
      }
    }
  }
}
