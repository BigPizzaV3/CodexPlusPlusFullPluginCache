{
  "mcpServers": {
    "privacy-blur": {
      "type": "streamable-http",
      "url": "https://mcp.firemoon.studio/privacy-blur/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "registrationUrl": "https://firemoon.studio/api/oauth/register",
            "authorizationUrl": "https://firemoon.studio/oauth/authorize",
            "tokenUrl": "https://firemoon.studio/api/oauth/token",
            "baseScopes": [
              "full_access"
            ]
          }
        }
      }
    }
  },
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json"
}
