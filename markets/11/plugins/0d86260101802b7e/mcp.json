{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "apihub": {
      "type": "streamable-http",
      "url": "https://apihub.tools/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "cimd"
            },
            "authorizationUrl": "https://apihub.tools/oauth/authorize",
            "tokenUrl": "https://apihub.tools/oauth/token",
            "registrationUrl": "https://apihub.tools/oauth/register",
            "authorizationServerBase": "https://apihub.tools",
            "resource": "https://apihub.tools/mcp",
            "defaultScopes": [
              "mcp",
              "offline_access"
            ]
          }
        }
      }
    }
  }
}
