{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "enoki": {
      "type": "streamable-http",
      "url": "https://mcp.enokilabs.ai/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "cimd"
            },
            "authorizationUrl": "https://mcp.enokilabs.ai/authorize",
            "tokenUrl": "https://mcp.enokilabs.ai/token",
            "baseScopes": [
              "read",
              "write",
              "test:run"
            ]
          }
        }
      }
    }
  }
}
