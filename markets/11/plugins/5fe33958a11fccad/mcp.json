{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "curb": {
      "type": "streamable-http",
      "url": "https://curb.sale/plugin/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "mixed",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": [
              "curb:marketplace"
            ]
          }
        }
      }
    }
  }
}
