{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "sessionplan": {
      "type": "streamable-http",
      "url": "https://app.sessionplan.app/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "mixed",
            "client": {
              "mode": "provided",
              "clientId": "ba8d20c6-4223-4605-9497-a7663dc00745",
              "tokenEndpointAuthMethod": "client_secret_post"
            },
            "resource": "https://app.sessionplan.app/mcp",
            "baseScopes": [
              "openid",
              "email",
              "offline_access"
            ]
          }
        }
      }
    }
  }
}
