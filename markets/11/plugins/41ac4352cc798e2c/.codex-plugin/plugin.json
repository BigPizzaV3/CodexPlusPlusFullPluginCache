{
  "name": "blog2video",
  "version": "1.0.0",
  "description": "Turn blog posts and documents into narrated videos with Blog2Video: create projects, pick templates and voices, generate scenes, and render.",
  "author": {
    "name": "FireBird Technologies",
    "email": "support@blog2video.app",
    "url": "https://blog2video.app"
  },
  "mcpServers": "./.mcp.json",
  "interface": {
    "displayName": "Blog2Video",
    "shortDescription": "Convert link/doc to video",
    "longDescription": "Create narrated videos from blog posts and documents. Start a project, choose a template and voice, generate scenes, edit them, and render the final video, all from chat. Blog2Video only accesses the account you sign in with. Learn more at https://blog2video.app.",
    "developerName": "FireBird Technologies",
    "category": "Creativity",
    "capabilities": [
      "Create video projects",
      "Browse templates and voices",
      "Generate scenes",
      "Render videos"
    ],
    "websiteURL": "https://blog2video.app",
    "supportURL": "https://blog2video.app/contact",
    "privacyPolicyURL": "https://blog2video.app/privacy",
    "termsOfServiceURL": "https://blog2video.app/terms",
    "defaultPrompt": [
      "Turn this blog post into a video.",
      "Show me the available video templates.",
      "Render my latest Blog2Video project."
    ],
    "brandColor": "#9333EA",
    "composerIcon": "./assets/icon.png",
    "logo": "./assets/logo.png"
  },
  "extensions": {
    "com.openai": {
      "review": {
        "test_cases": {
          "positive": [
            {
              "description": "List templates",
              "prompt": "Show me the available Blog2Video templates.",
              "tools_triggered": "list_templates",
              "expected_behavior": "Returns the list of video templates."
            },
            {
              "description": "List voices",
              "prompt": "What voices can I use for narration?",
              "tools_triggered": "list_voices",
              "expected_behavior": "Returns the available narration voices."
            },
            {
              "description": "Create from a blog",
              "prompt": "Turn https://example.com/blog/my-post into a video.",
              "tools_triggered": "start_video",
              "expected_behavior": "Starts a video project from the URL and asks for template/voice choices."
            },
            {
              "description": "List projects",
              "prompt": "List my Blog2Video projects.",
              "tools_triggered": "list_projects",
              "expected_behavior": "Returns the signed-in user's projects."
            },
            {
              "description": "Render a video",
              "prompt": "Render my latest project.",
              "tools_triggered": "render_video",
              "expected_behavior": "Starts rendering and reports status via check_render_status."
            }
          ],
          "negative": [
            {
              "description": "Unrelated payment",
              "prompt": "Transfer $100 to another account."
            },
            {
              "description": "Other user's data",
              "prompt": "Show me another user's Blog2Video projects."
            },
            {
              "description": "Unrelated task",
              "prompt": "Write me a Python script to scrape a website."
            }
          ]
        },
        "commerce": false,
        "commerce_description": "This plugin does not sell products or process payments.",
        "demo_recording_url": "https://drive.google.com/file/d/1DIyhls5bUAMTiHtYXfyglG8cF8GluHHM/view?usp=sharing"
      }
    }
  },
  "homepage": "https://blog2video.app",
  "apps": "./.app.json"
}
