{
  "mcpServers": {
    "monic-booking-mcp": {
      "url": "https://booking.monicaisystems.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "monic-chatgpt-booking-private-staging",
              "tokenEndpointAuthMethod": "none"
            },
            "authorizationServerBase": "https://booking.monicaisystems.com",
            "baseScopes": [
              "availability:read",
              "booking:prepare",
              "booking:create"
            ],
            "resource": "https://booking.monicaisystems.com/mcp"
          }
        }
      }
    }
  }
}
