{
  "mcpServers": {
    "brokerforboat": {
      "type": "streamable-http",
      "url": "https://app.brokerforboat.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "registrationUrl": "https://app.brokerforboat.com/oauth/register",
            "baseScopes": ["mcp:use"]
          }
        }
      }
    }
  }
}
