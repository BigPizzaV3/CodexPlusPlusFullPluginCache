{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "patt-pro": {
      "type": "streamable-http",
      "url": "https://mcp.patt.club/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "patt-chatgpt",
              "tokenEndpointAuthMethod": "none"
            },
            "resource": "https://mcp.patt.club/mcp",
            "baseScopes": ["patt:read"],
            "oidcEnabled": false
          }
        }
      }
    }
  }
}
