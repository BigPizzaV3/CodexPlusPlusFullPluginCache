{
  "mcpServers": {
    "nexusplus": {
      "type": "streamable-http",
      "url": "https://nexusplus.ai/api/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": [
              "read",
              "emit"
            ]
          }
        }
      }
    }
  }
}
