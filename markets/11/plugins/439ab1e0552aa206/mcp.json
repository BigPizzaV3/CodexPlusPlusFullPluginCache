{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "propovo": {
      "type": "streamable-http",
      "url": "https://api.propovo.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "resource": "https://api.propovo.com/mcp",
            "baseScopes": [
              "documents:read",
              "context:read",
              "drafts:write",
              "context:write"
            ],
            "defaultScopes": [
              "documents:read",
              "context:read",
              "drafts:write",
              "context:write"
            ],
            "oidcEnabled": false
          }
        }
      }
    }
  }
}
