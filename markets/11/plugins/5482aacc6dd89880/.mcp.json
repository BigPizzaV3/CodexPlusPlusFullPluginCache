{
	"mcpServers": {
		"swoop": {
			"type": "http",
			"url": "https://getswoop.ai/api/plugin/mcp",
			"extensions": {
				"com.openai": {
					"auth": {
						"type": "oauth",
						"client": {
							"mode": "dcr"
						},
						"authorizationUrl": "https://getswoop.ai/api/plugin/oauth/authorize",
						"tokenUrl": "https://getswoop.ai/api/plugin/oauth/token",
						"registrationUrl": "https://getswoop.ai/api/plugin/oauth/register",
						"resource": "https://getswoop.ai/api/plugin/mcp",
						"baseScopes": ["swoop"]
					}
				}
			}
		}
	}
}
