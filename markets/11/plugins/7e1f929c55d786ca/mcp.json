{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "semban": {
      "type": "streamable-http",
      "url": "https://semban.de/api/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "https://chatgpt.com/oauth/client.json",
              "tokenEndpointAuthMethod": "none"
            },
            "authorizationServerBase": "https://semban.de",
            "authorizationUrl": "https://semban.de/api/mcp-oauth/authorize",
            "tokenUrl": "https://semban.de/api/mcp-oauth/token",
            "resource": "https://semban.de/api/mcp",
            "baseScopes": [
              "study:read",
              "planner:read",
              "tasks:propose"
            ]
          }
        }
      }
    }
  }
}
