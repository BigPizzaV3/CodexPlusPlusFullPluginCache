{
  "mcpServers": {
    "clinked": {
      "url": "https://clinked.app/mcp/",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "clinked-chatgpt",
              "tokenEndpointAuthMethod": "none"
            },
            "authorizationUrl": "https://api.clinked.com/oauth/authorize",
            "tokenUrl": "https://api.clinked.com/oauth/token",
            "authorizationServerBase": "https://api.clinked.com",
            "resource": "https://clinked.app/mcp",
            "baseScopes": ["read", "write"]
          }
        }
      }
    }
  }
}
