{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "perture-readonly": {
      "url": "https://app.perture.co/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "baseScopes": [
              "brands:read",
              "assets:read"
            ],
            "defaultScopes": [
              "brands:read",
              "assets:read"
            ],
            "resource": "https://app.perture.co/mcp",
            "type": "oauth",
            "client": {
              "mode": "dcr"
            }
          }
        }
      },
      "type": "streamable-http"
    }
  }
}
