{
    "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
    "mcpServers": {
        "geosurge-client": {
            "type": "streamable-http",
            "url": "https://mcp.geosurge.ai/",
            "extensions": {
                "com.openai": {
                    "auth": {
                        "type": "oauth",
                        "client": {
                            "mode": "dcr"
                        },
                        "baseScopes": [
                            "mcp:read",
                            "mcp:write"
                        ],
                        "defaultScopes": [
                            "mcp:read",
                            "mcp:write"
                        ],
                        "resource": "https://mcp.geosurge.ai",
                        "oidcEnabled": false
                    }
                }
            }
        }
    }
}
