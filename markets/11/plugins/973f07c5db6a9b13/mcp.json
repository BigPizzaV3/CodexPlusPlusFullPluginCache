{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "simplio3d": {
      "type": "streamable-http",
      "url": "https://app.simplio3d.ai/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "defaultScopes": [
              "docs:read",
              "workspace:read",
              "projects:read",
              "assets:read",
              "materials:read",
              "configurator:read",
              "pricing:read",
              "forms:read",
              "workflows:read"
            ],
            "oidcEnabled": false
          }
        }
      }
    }
  }
}
