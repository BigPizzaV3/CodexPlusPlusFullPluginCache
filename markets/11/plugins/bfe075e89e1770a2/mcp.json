{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "openajan": {
      "type": "streamable-http",
      "url": "https://openajan.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": { "mode": "dcr" },
            "baseScopes": ["shops:read", "orders:write"]
          }
        }
      }
    }
  }
}
