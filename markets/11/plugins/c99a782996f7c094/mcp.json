{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "cattalog": {
      "type": "streamable-http",
      "url": "https://app.cattalog.ai/api/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "oidc-chatgpt-cattalog-v1",
              "tokenEndpointAuthMethod": "client_secret_basic"
            },
            "resource": "https://app.cattalog.ai/api/mcp",
            "baseScopes": [
              "openid",
              "email",
              "offline_access",
              "documents:read",
              "documents:write",
              "sources:read",
              "sources:write",
              "render"
            ]
          }
        }
      }
    }
  }
}
