{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "nimply": {
      "type": "streamable-http",
      "url": "https://mcp.nimply.io/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": [
              "workspace:read",
              "channels:read",
              "posts:read",
              "posts:write",
              "posts:publish",
              "media:read",
              "media:write",
              "analytics:read",
              "links:read",
              "links:write",
              "designs:read",
              "designs:write",
              "agents:read",
              "agents:write",
              "agents:run",
              "automations:read",
              "automations:write"
            ],
            "defaultScopes": [
              "workspace:read",
              "channels:read",
              "posts:read",
              "posts:write",
              "posts:publish",
              "media:read",
              "media:write",
              "analytics:read",
              "links:read",
              "links:write",
              "designs:read",
              "designs:write",
              "agents:read",
              "agents:write",
              "agents:run",
              "automations:read",
              "automations:write"
            ]
          }
        }
      }
    }
  }
}
