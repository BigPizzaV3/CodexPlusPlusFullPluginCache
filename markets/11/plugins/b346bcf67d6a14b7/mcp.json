{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "flashloop": {
      "type": "streamable-http",
      "url": "https://mcp.flashloop.ai/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "authorizationUrl": "https://mcp.flashloop.ai/authorize",
            "tokenUrl": "https://mcp.flashloop.ai/token",
            "registrationUrl": "https://mcp.flashloop.ai/register",
            "baseScopes": [
              "email"
            ]
          }
        }
      }
    }
  }
}