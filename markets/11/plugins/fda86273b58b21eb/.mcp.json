{
  "mcpServers": {
    "relayq": {
      "url": "https://api.relayq.app/api/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "authorizationServerBase": "https://api.relayq.app/api/auth",
            "resource": "https://api.relayq.app/api/mcp",
            "baseScopes": [
              "openid",
              "profile",
              "email",
              "offline_access",
              "tasks:read",
              "tasks:write"
            ]
          }
        }
      }
    }
  }
}
