{
  "mcpServers": {
    "topview-3d": {
      "type": "streamable-http",
      "url": "https://mcp-3d.topview.ai",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "resource": "https://mcp-3d.topview.ai",
            "baseScopes": [
              "mcp:tools"
            ]
          }
        }
      }
    }
  }
}
