{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "sense": {
      "type": "streamable-http",
      "url": "https://api.getsense.ai/mcp/apps",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "registrationUrl": "https://api.getsense.ai/register",
            "baseScopes": [
              "read",
              "write"
            ]
          }
        }
      }
    }
  }
}