{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "ping": {
      "type": "streamable-http",
      "url": "https://public-api.ping.tm/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "authorizationServerBase": "https://auth-api.ping.tm",
            "authorizationUrl": "https://auth-api.ping.tm/connect/authorize",
            "tokenUrl": "https://auth-api.ping.tm/connect/token",
            "registrationUrl": "https://auth-api.ping.tm/connect/register",
            "resource": "https://public-api.ping.tm/mcp"
          }
        }
      }
    }
  }
}
