{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "cocanvas": {
      "type": "streamable-http",
      "url": "https://cocanvas.studio/api/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "cocanvas-chatgpt",
              "tokenEndpointAuthMethod": "none"
            },
            "authorizationUrl": "https://cocanvas.studio/oauth/authorize",
            "tokenUrl": "https://cocanvas.studio/api/oauth/token",
            "resource": "https://cocanvas.studio/api/mcp",
            "baseScopes": ["lookup"],
            "defaultScopes": ["lookup", "write"]
          }
        }
      }
    }
  }
}
