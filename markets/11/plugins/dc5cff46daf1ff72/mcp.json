{
	"$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
	"mcpServers": {
		"productbyte": {
			"type": "streamable-http",
			"url": "https://mcp.productbyte.com/chatgpt",
			"extensions": {
				"com.openai": {
					"auth": {
						"type": "oauth",
						"client": { "mode": "cimd" },
						"baseScopes": [
							"workspace:read",
							"accounts:read",
							"accounts:connect",
							"accounts:disconnect",
							"products:read",
							"collections:read",
							"collections:write",
							"collections:delete",
							"imports:read",
							"imports:write",
							"imports:delete",
							"exports:read",
							"exports:write",
							"exports:delete",
							"campaigns:read",
							"campaigns:write",
							"posts:publish",
							"analytics:read"
						]
					}
				}
			}
		}
	}
}
