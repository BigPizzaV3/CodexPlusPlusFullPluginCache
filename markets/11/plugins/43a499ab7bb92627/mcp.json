{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "wheredai": {
      "type": "streamable-http",
      "url": "https://api.whered.ai/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "wheredai-chatgpt",
              "tokenEndpointAuthMethod": "none"
            },
            "resource": "https://api.whered.ai/mcp",
            "defaultScopes": [
              "read",
              "write",
              "offline_access"
            ]
          }
        }
      }
    }
  }
}
