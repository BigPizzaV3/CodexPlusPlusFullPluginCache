{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "leado-marketing": {
      "type": "streamable-http",
      "url": "https://leadomarketing.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {"mode": "dcr"},
            "authorizationServerBase": "https://leadomarketing.com",
            "resource": "https://leadomarketing.com/mcp",
            "baseScopes": ["leado:read", "leado:write", "leado:publish"]
          }
        }
      }
    }
  }
}
