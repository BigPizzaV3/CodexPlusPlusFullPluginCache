{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "active-digit-ai": {
      "type": "streamable-http",
      "url": "https://ai.activedigit.co.il/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "mixed",
            "client": {
              "mode": "dcr"
            },
            "authorizationUrl": "https://ai.activedigit.co.il/oauth/authorize",
            "tokenUrl": "https://ai.activedigit.co.il/oauth/token",
            "baseScopes": [
              "projects:read",
              "projects:write"
            ]
          }
        }
      }
    }
  }
}
