{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "yet-postroom": {
      "type": "streamable-http",
      "url": "https://social.notacompanynameyet.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "authorizationUrl": "https://social.notacompanynameyet.com/oauth/agent/authorize",
            "tokenUrl": "https://social.notacompanynameyet.com/oauth/agent/token",
            "registrationUrl": "https://social.notacompanynameyet.com/oauth/agent/register",
            "resource": "https://social.notacompanynameyet.com/mcp",
            "baseScopes": [
              "social.read"
            ],
            "defaultScopes": [
              "social.read",
              "social.write"
            ]
          }
        }
      }
    }
  }
}