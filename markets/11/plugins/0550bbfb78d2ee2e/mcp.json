{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "climbx": {
      "type": "streamable-http",
      "url": "https://climbx.so/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "defaultScopes": ["climbx:read", "climbx:write", "offline_access"]
          }
        }
      }
    }
  }
}
