{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "delulus-director": {
      "type": "streamable-http",
      "url": "https://director.delulus.productions/director/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "-O9YTd7eiepXRq7a",
              "tokenEndpointAuthMethod": "none"
            },
            "authorizationUrl": "https://director.delulus.productions/director/authorize",
            "tokenUrl": "https://director.delulus.productions/director/token",
            "baseScopes": [
              "director:read",
              "course:access:read",
              "offline_access"
            ]
          }
        }
      }
    }
  }
}
