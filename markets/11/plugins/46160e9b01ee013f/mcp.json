{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "no404": {
      "type": "streamable-http",
      "url": "https://www.no404.tr/api/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": [
              "sites.read",
              "redirects.write"
            ]
          }
        }
      }
    }
  }
}
