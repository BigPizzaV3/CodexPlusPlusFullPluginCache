{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "pulltrader": {
      "type": "streamable-http",
      "url": "https://mcp.pulltrader.app/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "tpc_sFEgwQ3tfdupNt9cExSucS",
              "tokenEndpointAuthMethod": "none"
            },
            "resource": "https://mcp.pulltrader.app/mcp",
            "defaultScopes": [
              "collection:read",
              "collection:write",
              "research:spend",
              "seller:read"
            ],
            "oidcScopesSupported": [
              "openid",
              "profile",
              "email",
              "offline_access"
            ]
          }
        }
      }
    }
  }
}
