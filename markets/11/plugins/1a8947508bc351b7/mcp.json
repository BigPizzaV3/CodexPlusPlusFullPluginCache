{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "delegance": {
      "type": "streamable-http",
      "url": "https://portal.delegancebrokerage.com/api/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": [
              "policies:read",
              "policies:write",
              "documents:read",
              "documents:write",
              "coi:generate",
              "quotes:read",
              "quotes:write",
              "claims:read",
              "claims:write",
              "scheduling:write",
              "portfolio:read"
            ]
          }
        }
      }
    }
  }
}
