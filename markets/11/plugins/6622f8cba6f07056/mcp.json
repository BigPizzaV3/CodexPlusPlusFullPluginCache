{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "ordersapps": {
      "type": "streamable-http",
      "url": "https://mcp.ordersapps.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "ordersapps-chatgpt-plugin",
              "tokenEndpointAuthMethod": "none"
            },
            "baseScopes": [
              "store.read",
              "store.write",
              "offline_access"
            ]
          }
        }
      }
    }
  }
}
