{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "registry-lookup": {
      "type": "streamable-http",
      "url": "https://registry-lookup.com/mcp/sse",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": [
              "mcp:tools"
            ]
          }
        }
      }
    }
  }
}
