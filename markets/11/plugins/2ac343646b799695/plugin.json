        "test_cases": {
          "positive": [
            {
              "description": "List the stores the signed-in owner manages",
              "prompt": "imachika \u3067\u7ba1\u7406\u3057\u3066\u3044\u308b\u304a\u5e97\u3092\u4e00\u89a7\u3067\u898b\u305b\u3066",
              "tools_triggered": "list_stores",
              "expected_behavior": "Lists only the stores managed by the signed-in test account (the test store), with their names."
            },
            {
              "description": "Read a store's basic information",
              "prompt": "\u304a\u5e97\u306e\u55b6\u696d\u6642\u9593\u3068\u4f4f\u6240\u3092\u6559\u3048\u3066",
              "tools_triggered": "list_stores, get_store_basic_info",
              "expected_behavior": "Shows the test store's business hours and address as stored in imachika, without inventing missing values."
            },
            {
              "description": "Create a news post after confirmation",
              "prompt": "\u304a\u77e5\u3089\u305b\u306b\u300e\u79cb\u306e\u65b0\u30e1\u30cb\u30e5\u30fc\u59cb\u3081\u307e\u3057\u305f\u300f\u3068\u3044\u3046\u8a18\u4e8b\u3092\u4f5c\u3063\u3066",
              "tools_triggered": "list_stores, module_fields, module_create",
              "expected_behavior": "Drafts the news post text, shows it to the user, and saves the post on the test store as a draft only after the user confirms, then tells the user it is a draft and not yet published."
            },
            {
              "description": "Add an FAQ entry after confirmation",
              "prompt": "\u3088\u304f\u3042\u308b\u8cea\u554f\u306b\u300e\u99d0\u8eca\u5834\u306f\u3042\u308a\u307e\u3059\u304b\uff1f\u300f\u3092\u8ffd\u52a0\u3057\u3066\u3002\u7b54\u3048\u306f\u300e\u8fd1\u304f\u306e\u30b3\u30a4\u30f3\u30d1\u30fc\u30ad\u30f3\u30b0\u3092\u3054\u5229\u7528\u304f\u3060\u3055\u3044\u300f\u3067",
              "tools_triggered": "list_stores, module_fields, module_create",
              "expected_behavior": "Shows the question and answer to be added, then saves the FAQ entry on the test store as a draft after the user confirms, and tells the user it is a draft and not yet published."
            },
            {
              "description": "Change business hours after confirmation",
              "prompt": "\u6bce\u9031\u6c34\u66dc\u65e5\u3092\u5b9a\u4f11\u65e5\u306b\u3057\u3066",
              "tools_triggered": "list_stores, get_store_basic_info, update_store_basic_info",
              "expected_behavior": "Reads the current weekly hours, shows the change (Wednesday closed, other days unchanged), and updates the test store after the user confirms."
