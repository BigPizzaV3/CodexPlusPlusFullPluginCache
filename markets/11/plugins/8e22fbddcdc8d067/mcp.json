{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "tripnoted": {
      "type": "streamable-http",
      "url": "https://app.tripnoted.com/mcp/planning",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "mixed",
            "client": {
              "mode": "cimd"
            },
            "authorizationUrl": "https://app.tripnoted.com/authorize",
            "tokenUrl": "https://app.tripnoted.com/token",
            "resource": "https://app.tripnoted.com/mcp/planning",
            "baseScopes": ["planning:read", "planning:write", "planning:account", "trip:read", "trip:write"],
            "defaultScopes": []
          }
        }
      }
    }
  }
}
