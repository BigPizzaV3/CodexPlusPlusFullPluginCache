{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "pickleheads": {
      "type": "streamable-http",
      "url": "https://mcp.pickleheads.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "cimd"
            },
            "defaultScopes": ["openid", "offline_access", "read", "write"]
          }
        }
      }
    }
  }
}
