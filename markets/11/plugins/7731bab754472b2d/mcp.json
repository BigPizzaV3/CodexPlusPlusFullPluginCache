{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "orbits": {
      "type": "streamable-http",
      "url": "https://api.tryorbits.com/functions/v1/orbits_mcp/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "resource": "https://api.tryorbits.com/functions/v1/orbits_mcp/mcp",
            "authorizationUrl": "https://api.tryorbits.com/auth/v1/oauth/authorize",
            "baseScopes": [
              "openid",
              "email",
              "profile"
            ],
            "client": {
              "mode": "provided",
              "clientId": "e788b229-821f-4b38-8d54-5a5542837872",
              "tokenEndpointAuthMethod": "none"
            }
          }
        }
      }
    }
  }
}
