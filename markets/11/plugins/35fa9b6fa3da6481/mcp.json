{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "asktender": {
      "type": "streamable-http",
      "url": "https://asktender.org/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "mixed",
            "client": {
              "mode": "provided",
              "clientId": "atc_FWuyFDfZsLWPV34oqoRiHkzr",
              "tokenEndpointAuthMethod": "none"
            },
            "authorizationUrl": "https://app.asktender.org/oauth/authorize",
            "tokenUrl": "https://app.asktender.org/oauth/token",
            "authorizationServerBase": "https://app.asktender.org",
            "resource": "https://asktender.org/mcp",
            "baseScopes": [
              "tenders"
            ],
            "oidcEnabled": false
          }
        }
      }
    }
  }
}