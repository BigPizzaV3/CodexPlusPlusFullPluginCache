44 \uc548\ub0b4\ud569\ub2c8\ub2e4.\n\n[\uc774\ub7f0 \ubd84\uaed8 \ub9de\uc2b5\ub2c8\ub2e4]\n\uc9d1\u00b7\uc0ac\ubb34\uc2e4 \uccad\uc18c\ub97c \uc54c\uc544\ubcf4\ub294 \uc911\uc774\uac70\ub098, \ud2b9\uc815 \uc11c\ube44\uc2a4\uc758 \ubc94\uc704\uc640 \ube44\uc6a9\uc744 \ubbf8\ub9ac \ud655\uc778\ud558\uace0 \uc2f6\uc740 \ubd84. \uc774\ubbf8 \uc774\uc6a9 \uc911\uc774\ub77c\uba74 \ubb38\uc758 \uacbd\ub85c\ub97c \ube60\ub974\uac8c \ucc3e\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n\n[\ud560 \uc218 \uc5c6\ub294 \uc77c]\n\u2022 \uc608\uc57d\uc744 \ub9cc\ub4e4\uac70\ub098 \ubcc0\uacbd\u00b7\ucde8\uc18c\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. \uc608\uc57d\uc740 \uccad\uc5f0 \uc571\uc5d0\uc11c \uc9c4\ud589\ud558\uba70, \uc5ec\uae30\uc11c\ub294 \uc548\ub0b4\ub9cc \ud569\ub2c8\ub2e4.\n\u2022 \uace0\uac1d\ub2d8\uc758 \uc608\uc57d \ub0b4\uc5ed, \ucfe0\ud3f0, \ud3ec\uc778\ud2b8\ub97c \uc870\ud68c\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4.\n\u2022 \uacb0\uc81c\ub098 \ud658\ubd88\uc744 \ucc98\ub9ac\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4.\n\n[\ub370\uc774\ud130 \ucde8\uae09]\n\ub85c\uadf8\uc778\uc774 \ud544\uc694 \uc5c6\uc73c\uba70 \uac1c\uc778\uc815\ubcf4\ub97c \uc218\uc9d1\ud558\uac70\ub098 \uc800\uc7a5\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. \uc11c\ube44\uc2a4 \ubc94\uc704\uc640 \uac00\uaca9\uc740 \uacf5\uc2dd \ud648\ud398\uc774\uc9c0\uc5d0\uc11c \uc77d\uc5b4\uc624\ubbc0\ub85c \uae08\uc561\uc744 \uc784\uc758\ub85c \ucd94\uc815\ud558\uc9c0 \uc54a\uace0, \uc548\ub0b4\ud558\ub294 \ub9c1\ud06c\ub294 \ubaa8\ub450 \uccad\uc5f0 \uacf5\uc2dd \ub3c4\uba54\uc778\uc785\ub2c8\ub2e4.\n\n\uc8fc\uc2dd\ud68c\uc0ac \uccad\uc5f0 \u00b7 \uacbd\uae30\ub3c4 \uc131\ub0a8\uc2dc \ubd84\ub2f9\uad6c \ud310\uad50\ub85c242 \ud310\uad50\ub514\uc9c0\ud138\uc13c\ud130 C\ub3d9 1002\ud638\n\uc6f9\uc0ac\uc774\ud2b8 https://chyeon.com\n\uace0\uac1d\uc13c\ud130 1877-7753 (\uc6d4~\ud1a0 08:00~18:00, \uc77c\uc694\uc77c\u00b7\uacf5\ud734\uc77c \ud734\ubb34)",
