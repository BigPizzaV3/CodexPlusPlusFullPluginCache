{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "tabemon": {
      "type": "streamable-http",
      "url": "https://mcp.tabemon.ai/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "01a138d9-a24a-707a-a679-9eceee80dbf1",
              "tokenEndpointAuthMethod": "none"
            },
            "authorizationUrl": "https://app.tabemon.ai/oauth/authorize",
            "tokenUrl": "https://app.tabemon.ai/oauth/token",
            "resource": "https://mcp.tabemon.ai/mcp",
            "baseScopes": ["mcp:read"],
            "defaultScopes": ["mcp:write"]
          }
        }
      }
    }
  }
}
