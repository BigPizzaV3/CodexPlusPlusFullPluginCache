{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "ricky": {
      "type": "streamable-http",
      "url": "https://getricky.ai/api/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": { "mode": "dcr" },
            "registrationUrl": "https://getricky.ai/api/oauth/register",
            "authorizationUrl": "https://getricky.ai/auth/authorize",
            "tokenUrl": "https://getricky.ai/api/oauth/token",
            "baseScopes": ["ricky:operator"]
          }
        }
      }
    }
  }
}
