{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "infolegale": {
      "type": "streamable-http",
      "url": "https://mcp.infolegale.fr/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "mcp.infolegale.fr",
              "tokenEndpointAuthMethod": "none"
            },
            "baseScopes": [
              "ilg:mcp"
            ],
            "authorizationUrl": "https://sso.infolegale.fr/realms/infolegale/protocol/openid-connect/auth",
            "tokenUrl": "https://sso.infolegale.fr/realms/infolegale/protocol/openid-connect/token"
          }
        }
      }
    }
  }
}