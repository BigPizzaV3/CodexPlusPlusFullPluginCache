{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "rial": {
      "type": "streamable-http",
      "url": "https://mcp.rial.io/chatgpt/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "authorizationServerBase": "https://api.rial.io",
            "resource": "https://mcp.rial.io",
            "authorizationUrl": "https://api.rial.io/v1/oauth/authorize",
            "tokenUrl": "https://api.rial.io/v1/oauth/token",
            "registrationUrl": "https://api.rial.io/v1/oauth/register"
          }
        }
      }
    }
  }
}
