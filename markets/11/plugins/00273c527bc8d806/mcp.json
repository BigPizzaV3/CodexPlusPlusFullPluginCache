{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "advanza": {
      "type": "streamable-http",
      "url": "https://mcp.advanza.ai/openai/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "registrationUrl": "https://api.advanza.ai/connect/register",
            "authorizationServerBase": "https://api.advanza.ai/",
            "baseScopes": [
              "openid",
              "email",
              "profile",
              "offline_access",
              "advanza.agent"
            ]
          }
        }
      }
    }
  }
}
