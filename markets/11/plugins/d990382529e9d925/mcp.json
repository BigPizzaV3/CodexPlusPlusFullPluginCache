{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "festkit": {
      "type": "streamable-http",
      "url": "https://app.usefestkit.com/mcp/vendor",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "festkit-chatgpt-vendor",
              "tokenEndpointAuthMethod": "none"
            },
            "resource": "https://app.usefestkit.com/mcp/vendor",
            "defaultScopes": [
              "vendor:profile:read",
              "vendor:documents:read",
              "vendor:events:read",
              "vendor:profile:write",
              "vendor:results:write"
            ]
          }
        }
      }
    }
  }
}
