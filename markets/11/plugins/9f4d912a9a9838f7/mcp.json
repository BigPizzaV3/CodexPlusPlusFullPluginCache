      "type": "streamable-http",
      "url": "https://mcp.defoorreport.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": ["news"]
          }
        }
      }
    }
  }
}
