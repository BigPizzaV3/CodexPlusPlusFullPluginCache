{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "material": {
      "type": "streamable-http",
      "url": "https://material.sc/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "defaultScopes": [
              "openid",
              "profile",
              "email",
              "offline_access",
              "spaces:read",
              "spaces:write",
              "cards:read",
              "cards:write",
              "captures:write",
              "exports:read"
            ]
          }
        }
      }
    }
  }
}
