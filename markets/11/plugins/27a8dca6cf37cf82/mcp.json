{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "kipify": {
      "type": "streamable-http",
      "url": "https://api.kipify.io/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "registrationUrl": "https://api.kipify.io/mcp/oauth/register",
            "authorizationUrl": "https://api.kipify.io/mcp/oauth/authorize",
            "tokenUrl": "https://api.kipify.io/mcp/oauth/token",
            "resource": "https://api.kipify.io/mcp"
          }
        }
      }
    }
  }
}
