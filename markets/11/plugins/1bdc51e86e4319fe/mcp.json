{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "ghimai": {
      "type": "streamable-http",
      "url": "https://ghimai.com/api/plugin/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "mixed",
            "resource": "https://ghimai.com/api/plugin/mcp",
            "baseScopes": [
              "ghimai.profile.read",
              "ghimai.visibility.read"
            ],
            "defaultScopes": [
              "ghimai.profile.read",
              "ghimai.visibility.read"
            ]
          }
        }
      }
    }
  }
}
