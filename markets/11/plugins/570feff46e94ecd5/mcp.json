{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "nv-design": {
      "type": "streamable-http",
      "url": "https://design.newvision.io/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "mixed",
            "client": {
              "mode": "provided",
              "clientId": "33nrf6vhalafstihd2ik5qu7in",
              "tokenEndpointAuthMethod": "client_secret_basic"
            },
            "authorizationUrl": "https://auth.newvision.io/oauth2/authorize",
            "tokenUrl": "https://auth.newvision.io/oauth2/token",
            "authorizationServerBase": "https://auth-proxy.newvision.io",
            "resource": "https://design.newvision.io/mcp",
            "baseScopes": [
              "openid",
              "email"
            ],
            "defaultScopes": [],
            "oidcEnabled": true,
            "oidcConfigurationUrl": "https://cognito-idp.eu-north-1.amazonaws.com/eu-north-1_IItUS7oyH/.well-known/openid-configuration",
            "oidcUserinfoEndpoint": "https://auth.newvision.io/oauth2/userInfo",
            "oidcScopesSupported": [
              "openid",
              "email"
            ]
          }
        }
      }
    }
  }
}
