{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "govintel": {
      "type": "streamable-http",
      "url": "https://mcp.govintel.ai/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "authorizationUrl": "https://rfp-production-f5ba.up.railway.app/oauth/authorize",
            "tokenUrl": "https://rfp-production-f5ba.up.railway.app/oauth/token",
            "baseScopes": [
              "mimi.read"
            ]
          }
        }
      }
    }
  }
}