{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "reach": {
      "type": "streamable-http",
      "url": "https://examedix.ch/reach/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "registrationUrl": "https://examedix.ch/reach/oauth/register",
            "authorizationServerBase": "https://examedix.ch/reach/oauth",
            "resource": "https://examedix.ch/reach/mcp",
            "baseScopes": ["openid", "email", "profile", "workstation.read"],
            "oidcEnabled": true,
            "oidcConfigurationUrl": "https://examedix.ch/reach/oauth/.well-known/openid-configuration",
            "oidcUserinfoEndpoint": "https://examedix.ch/reach/oauth/userinfo",
            "oidcScopesSupported": ["openid", "email", "profile"]
          }
        }
      }
    }
  }
}