{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "replifast": {
      "type": "streamable-http",
      "url": "https://www.replifast.com/api/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "61f6cefb-4bb5-4459-8498-c0eab852fb28",
              "tokenEndpointAuthMethod": "client_secret_basic"
            },
            "baseScopes": [
              "email",
              "offline_access"
            ]
          }
        }
      }
    }
  }
}
