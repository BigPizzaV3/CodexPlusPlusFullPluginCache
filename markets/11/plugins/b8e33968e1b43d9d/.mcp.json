{
  "mcpServers": {
    "loppee-business": {
      "type": "streamable-http",
      "url": "https://loppee.com/mcp/business",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "mixed",
            "client": {
              "mode": "dcr"
            },
            "resource": "https://loppee.com/mcp/business",
            "baseScopes": [
              "loppee:business:read",
              "loppee:business:profile:write",
              "loppee:business:communications:write",
              "loppee:business:jobs:write"
            ],
            "defaultScopes": [],
            "authorizationServerBase": "https://loppee.com/oauth",
            "authorizationUrl": "https://loppee.com/oauth/auth",
            "tokenUrl": "https://loppee.com/oauth/token",
            "registrationUrl": "https://loppee.com/oauth/reg"
          }
        }
      }
    }
  }
}
