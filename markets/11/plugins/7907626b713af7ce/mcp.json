{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "nieru": {
      "type": "streamable-http",
      "url": "https://api.nieru.net/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "mixed",
            "client": {
              "mode": "provided",
              "clientId": "531e99fa-3208-4321-bea6-4362fc65d420",
              "tokenEndpointAuthMethod": "none"
            },
            "authorizationUrl": "https://api.nieru.net/oauth/authorize",
            "tokenUrl": "https://api.nieru.net/oauth/token",
            "authorizationServerBase": "https://api.nieru.net",
            "resource": "https://api.nieru.net/mcp",
            "defaultScopes": [
              "settings:read",
              "settings:draft"
            ]
          }
        }
      }
    }
  }
}
