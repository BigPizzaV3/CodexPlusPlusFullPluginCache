{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "voy": {
      "type": "streamable-http",
      "url": "https://www.voiceofyours.com/api/agent/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": { "mode": "cimd" },
            "baseScopes": ["recommendations:read", "items:read"]
          }
        }
      }
    }
  }
}
