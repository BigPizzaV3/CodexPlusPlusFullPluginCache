{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "saff": {
      "type": "streamable-http",
      "url": "https://saffnow.com/api/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "cimd"
            },
            "defaultScopes": [
              "tables:read",
              "documents:read",
              "results:read",
              "tables:create",
              "documents:submit",
              "offline_access"
            ],
            "baseScopes": [
              "tables:read",
              "documents:read",
              "results:read",
              "tables:create",
              "documents:submit",
              "offline_access"
            ]
          }
        }
      }
    }
  }
}
