{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "exepad": {
      "type": "streamable-http",
      "url": "https://mcp.exepad.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "cimd"
            },
            "baseScopes": [
              "apps:read",
              "apps:create",
              "source:read",
              "source:write",
              "builds:run",
              "preview:read",
              "data:read",
              "preview:act",
              "apps:publish",
              "apps:manage"
            ]
          }
        }
      }
    }
  }
}
