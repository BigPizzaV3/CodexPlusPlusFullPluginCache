{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "token-weather-budget",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-11",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": false
  },
  "ratelimits": [
    {
      "name": "MCP_IP_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 120,
        "period": 60
      }
    },
    {
      "name": "MCP_SERVICE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 1200,
        "period": 60
      }
    }
  ],
  "vars": {
    "PUBLIC_ORIGIN": "https://token-weather-budget.475035492.workers.dev"
  },
  "dev": {
    "ip": "127.0.0.1",
    "port": 8787,
    "local_protocol": "http"
  }
}
