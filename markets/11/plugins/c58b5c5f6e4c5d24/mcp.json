{
	"$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
	"mcpServers": {
		"mwm-ai": {
			"type": "streamable-http",
			"url": "https://mcp.mwm.ai/mcp",
			"extensions": {
				"com.openai": {
					"auth": {
						"type": "oauth",
						"client": {
							"mode": "dcr"
						},
						"baseScopes": [
							"mcp:access",
							"offline_access"
						]
					}
				}
			}
		}
	}
}
