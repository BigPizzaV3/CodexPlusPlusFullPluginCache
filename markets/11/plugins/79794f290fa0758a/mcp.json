{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "lex": {
      "type": "streamable-http",
      "url": "https://mcp.adminio.nl/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "mixed",
            "client": {
              "mode": "provided",
              "clientId": "lex-chatgpt-internal-v1",
              "tokenEndpointAuthMethod": "none"
            },
            "baseScopes": [
              "lex:read"
            ]
          }
        }
      }
    }
  }
}
