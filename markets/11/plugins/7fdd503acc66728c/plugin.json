{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "scriptnib",
  "version": "0.1.8",
  "description": "Connect to ScriptNib through its authenticated MCP server.",
  "author": {
    "name": "David Borges"
  },
  "homepage": "https://scriptnib.com",
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "ScriptNib",
        "shortDescription": "Connect your screenplay work",
        "longDescription": "Connect ChatGPT to the existing ScriptNib MCP server. Sign in with ScriptNib to access the tools exposed by your account.",
        "developerName": "David Borges",
        "category": "Creativity",
        "defaultPrompt": "Help me work with my ScriptNib projects.",
        "websiteURL": "https://scriptnib.com",
        "supportURL": "https://scriptnib.com/support",
        "privacyPolicyURL": "https://scriptnib.com/privacy",
        "termsOfServiceURL": "https://scriptnib.com/terms",
        "logo": "assets/icon-512.png",
        "composerIcon": "assets/icon-512.png"
      },
      "apps": "./.app.json"
    }
  }
}
