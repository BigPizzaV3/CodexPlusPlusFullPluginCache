{
  "mcpServers": {
    "loppee-personal": {
      "type": "streamable-http",
      "url": "https://loppee.com/mcp/personal",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "mixed",
            "client": {
              "mode": "dcr"
            },
            "resource": "https://loppee.com/mcp/personal",
            "baseScopes": [
              "loppee:businesses:read",
              "loppee:location:read",
              "loppee:messages:read",
              "loppee:messages:write",
              "loppee:reviews:write",
              "loppee:jobs:read",
              "loppee:jobs:write"
            ],
            "defaultScopes": [],
            "authorizationServerBase": "https://loppee.com/oauth",
            "authorizationUrl": "https://loppee.com/oauth/auth",
            "tokenUrl": "https://loppee.com/oauth/token",
            "registrationUrl": "https://loppee.com/oauth/reg"
          }
        }
      }
    }
  }
}
