{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "flow-analytics": {
      "type": "streamable-http",
      "url": "https://buyflow.io/api/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": { "mode": "provided", "clientId": "flow-analytics-openai", "tokenEndpointAuthMethod": "none" },
            "resource": "https://buyflow.io/api/mcp",
            "baseScopes": ["sites:read", "analytics:read"]
          }
        }
      }
    }
  }
}
