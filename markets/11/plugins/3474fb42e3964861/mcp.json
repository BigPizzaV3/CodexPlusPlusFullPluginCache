{
	"$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
	"mcpServers": {
		"collabed": {
			"type": "streamable-http",
			"url": "https://collabed.app/mcp",
			"extensions": {
				"com.openai": {
					"auth": {
						"type": "mixed",
						"client": {
							"mode": "dcr"
						},
						"resource": "https://collabed.app/mcp",
						"authorizationServerBase": "https://collabed.app",
						"authorizationUrl": "https://collabed.app/oauth/authorize",
						"tokenUrl": "https://collabed.app/oauth/token",
						"registrationUrl": "https://collabed.app/oauth/register",
						"baseScopes": [
							"deals:read",
							"deals:write"
						],
						"oidcEnabled": false
					}
				}
			}
		}
	}
}
