{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "ouish": {
      "type": "streamable-http",
      "url": "https://mcp.ouish.co/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "ouish-chatgpt",
              "tokenEndpointAuthMethod": "none"
            },
            "authorizationServerBase": "https://mcp.ouish.co",
            "resource": "https://mcp.ouish.co/mcp",
            "baseScopes": ["openid", "offline_access", "wishlists:read", "wishlists:write"]
          }
        }
      }
    }
  }
}
