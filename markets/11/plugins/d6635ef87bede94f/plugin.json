{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "gyft",
  "version": "1.0.5",
  "description": "Search gift cards and use Gyft commerce workflows through the Gyft MCP server.",
  "author": {
    "name": "Gyft"
  },
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Gyft",
        "shortDescription": "Gift card shopping",
        "longDescription": "Gyft is a comprehensive gift card marketplace that empowers consumers to conveniently buy, share, manage, and redeem gift cards from over 200 leading brands, offering a secure and streamlined gifting experience.",
        "developerName": "Gyft",
        "category": "Other",
        "websiteURL": "https://gyft-marketplace.gift.solutions",
        "supportURL": "https://gyft-marketplace.gift.solutions/support/contact",
        "privacyPolicyURL": "https://tw-media-production.wgiftcard.com/giftcard/private/418/text/gift_solutions_privacy_policy.html",
        "termsOfServiceURL": "https://gyft-marketplace.gift.solutions/store/termsAndConditions",
        "logo": "./assets/gyft-logo.png",
        "composerIcon": "./assets/gyft-logo.png",
        "capabilities": [
          "Search gift cards"
        ],
        "defaultPrompt": [
          "Find me some gift cards.",
          "Find physical gift cards.",
          "Help me shop for a gift card."
        ]
      },
      "apps": "./.app.json"
    }
  }
}
