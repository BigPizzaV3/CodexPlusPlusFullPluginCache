{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "cmdpress": {
      "type": "streamable-http",
      "url": "https://app.cmdpress.com/api/ai/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "cmdpress-chatgpt",
              "tokenEndpointAuthMethod": "none"
            },
            "baseScopes": [
              "ai:mcp",
              "ai:web:read",
              "sites:read",
              "design:read",
              "posts:read",
              "posts:create",
              "posts:update",
              "posts:publish",
              "posts:delete",
              "plugins:read",
              "plugins:update",
              "plugins:install",
              "themes:read",
              "themes:update",
              "core:update",
              "performance:read",
              "performance:scan",
              "analytics:read",
              "security:scan",
              "backups:read",
              "backups:create",
              "maintenance:manage",
              "users:read",
              "sites:write"
            ]
          }
        }
      }
    }
  }
}
