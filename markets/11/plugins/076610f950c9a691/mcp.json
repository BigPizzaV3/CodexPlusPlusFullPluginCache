{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "artboard": {
      "type": "streamable-http",
      "url": "https://cheery-crane-27.convex.site/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "cimd"
            },
            "authorizationServerBase": "https://clerk.artboard.studio",
            "authorizationUrl": "https://clerk.artboard.studio/oauth/authorize",
            "tokenUrl": "https://clerk.artboard.studio/oauth/token",
            "resource": "https://cheery-crane-27.convex.site/mcp",
            "baseScopes": [
              "openid",
              "profile",
              "email"
            ]
          }
        }
      }
    }
  }
}
