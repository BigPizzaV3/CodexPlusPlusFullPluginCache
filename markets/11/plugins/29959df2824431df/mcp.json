{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "agentcron": {
      "type": "streamable-http",
      "url": "https://api.agentcron.ai/api/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "cimd"
            },
            "authorizationServerBase": "https://api.agentcron.ai/oauth",
            "authorizationUrl": "https://api.agentcron.ai/oauth/auth",
            "tokenUrl": "https://api.agentcron.ai/oauth/token",
            "baseScopes": [
              "openid",
              "email",
              "offline_access",
              "projects:read",
              "boards:read",
              "cards:read",
              "cards:write",
              "files:read",
              "files:write",
              "channels:read",
              "channels:write"
            ]
          }
        }
      }
    }
  }
}
