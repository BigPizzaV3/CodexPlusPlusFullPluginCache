{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "bexel-cde": {
      "type": "streamable-http",
      "url": "https://cde-ws.bexelmanager.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "mixed",
            "client": {
              "mode": "provided",
              "clientId": "bxl.client.mcpweb",
              "tokenEndpointAuthMethod": "none"
            },
            "baseScopes": [
              "openid",
              "profile",
              "email",
              "bxl.mcpweb_mcp",
              "offline_access",
              "session_access"
            ]
          }
        }
      }
    }
  }
}
