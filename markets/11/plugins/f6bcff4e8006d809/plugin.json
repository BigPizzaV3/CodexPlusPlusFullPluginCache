{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "taxflow",
  "version": "1.0.1",
  "description": "Read invoices, totals, and suppliers for a connected TaxFlow business, and submit an invoice file.",
  "author": {
    "name": "TaxFlow",
    "email": "support@runtaxflow.com",
    "url": "https://www.runtaxflow.com"
  },
  "homepage": "https://www.runtaxflow.com",
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "TaxFlow",
        "shortDescription": "Collect and review invoices",
        "longDescription": "Read the connected business's invoices, totals, suppliers, and anomalies, and submit an invoice file. Approve, categorize, and delete stay in the TaxFlow app.",
        "developerName": "TaxFlow",
        "category": "Finance",
        "websiteURL": "https://www.runtaxflow.com",
        "supportURL": "https://www.runtaxflow.com/contact",
        "privacyPolicyURL": "https://www.runtaxflow.com/privacy",
        "termsOfServiceURL": "https://www.runtaxflow.com/terms",
        "logo": "./assets/logo.png",
        "composerIcon": "./assets/logo.png"
      },
      "apps": "./.app.json"
    }
  }
}
