  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "ownerbox-reservations",
  "version": "1.0.0",
  "description": "\ub9e4\uc7a5 \uac80\uc0c9\ubd80\ud130 \uc608\uc57d \uc811\uc218\uae4c\uc9c0 \ub3c4\uc640\uc8fc\ub294 \uc608\uc57d \uc11c\ube44\uc2a4\uc785\ub2c8\ub2e4. \n\ub9e4\uc7a5 \uc774\ub984\uc774\ub098 \uac80\uc0c9\uc5b4\ub85c \ub9e4\uc7a5\uc744 \ucc3e\uace0, \uc6d0\ud558\ub294 \ub0a0\uc9dc\uc640 \uc774\uc6a9 \uc2dc\uac04\uc5d0 \ub9de\ucdb0 \uc608\uc57d \uac00\ub2a5\ud55c \uc2dc\uac04\uc744 \ud655\uc778\ud560 \uc218\n\uc788\uc2b5\ub2c8\ub2e4.\n\n \uc608\uc57d\ud560 \ub9e4\uc7a5\uacfc \uc2dc\uac04\uc744 \uc120\ud0dd\ud55c \ud6c4 \uc774\ub984\uacfc \uc5f0\ub77d\ucc98 \ub4f1 \ud544\uc694\ud55c \uc815\ubcf4\ub97c \uc785\ub825\ud558\uba74, \uc608\uc57d \ub0b4\uc6a9\uc744 \ud655\uc778\ud558\uace0 \uc0ac\uc6a9\uc790 \ub3d9\uc758\ub97c \ubc1b\uc544 \uc608\uc57d\uc744 \uc811\uc218\ud569\ub2c8\ub2e4.\n \n  \uc811\uc218\ub41c \uc608\uc57d\uc740 \ub300\uae30 \uc0c1\ud0dc\ub85c \ub4f1\ub85d\ub418\uba70, \ucd5c\uc885 \ud655\uc815 \uc5ec\ubd80\ub294 \ub9e4\uc7a5\uc758 \uc548\ub0b4\ub97c \ub530\ub77c\uc8fc\uc138\uc694.",
