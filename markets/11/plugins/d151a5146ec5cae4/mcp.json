{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "submitforbacklinks": {
      "type": "streamable-http",
      "url": "https://submitforbacklinks.com/api/plugin/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "submitforbacklinks-openai",
              "tokenEndpointAuthMethod": "none"
            },
            "resource": "https://submitforbacklinks.com/api/plugin/mcp",
            "baseScopes": [
              "sites:scan",
              "submissions:read",
              "submissions:write",
              "submissions:submit"
            ]
          }
        }
      }
    }
  }
}
