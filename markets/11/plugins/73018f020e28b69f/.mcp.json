{
  "mcpServers": {
    "qualifybase": {
      "url": "https://www.qualifybase.com/api/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "resource": "https://www.qualifybase.com/api/mcp",
            "defaultScopes": [
              "qualifybase.read",
              "qualifybase.write",
              "qualifybase.prompts.read",
              "qualifybase.prompts.write"
            ],
            "baseScopes": [
              "qualifybase.read",
              "qualifybase.write",
              "qualifybase.prompts.read",
              "qualifybase.prompts.write"
            ]
          }
        }
      }
    }
  }
}
