{
  "mcpServers": {
    "feasly-workspace": {
      "url": "https://app.feasly.com/chatgpt/mcp",
      "type": "streamable-http",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "mixed",
            "client": {
              "mode": "provided",
              "clientId": "feasly-chatgpt-models",
              "tokenEndpointAuthMethod": "none"
            },
            "baseScopes": [
              "openid",
              "feasly:models"
            ],
            "authorizationUrl": "https://auth.feasly.com/realms/feasly-os/protocol/openid-connect/auth",
            "tokenUrl": "https://auth.feasly.com/realms/feasly-os/protocol/openid-connect/token"
          }
        }
      }
    }
  }
}
