{
  "mcpServers": {
    "t1u": {
      "type": "streamable-http",
      "url": "https://api.t1u.ai/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "https://chatgpt.com/oauth/client.json",
              "tokenEndpointAuthMethod": "none"
            },
            "authorizationUrl": "https://api.t1u.ai/oauth/mcp/authorize",
            "tokenUrl": "https://api.t1u.ai/oauth/mcp/token",
            "baseScopes": [
              "openid",
              "email",
              "mcp:read",
              "mcp:write"
            ]
          }
        }
      }
    }
  },
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json"
}
