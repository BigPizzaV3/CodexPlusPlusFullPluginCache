{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "propera": {
      "type": "streamable-http",
      "url": "https://propera-api.onrender.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "propera-chatgpt-prod",
              "tokenEndpointAuthMethod": "none"
            },
            "authorizationUrl": "https://propera-api.onrender.com/oauth/authorize",
            "tokenUrl": "https://propera-api.onrender.com/oauth/token",
            "authorizationServerBase": "https://propera-api.onrender.com",
            "resource": "https://propera-api.onrender.com/mcp",
            "baseScopes": [
              "propera:read",
              "propera:write"
            ],
            "defaultScopes": [
              "propera:read",
              "propera:write"
            ],
            "oidcEnabled": false
          }
        }
      }
    }
  }
}
