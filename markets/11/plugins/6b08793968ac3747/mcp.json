{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "bumper-vehicle-reports": {
      "type": "streamable-http",
      "url": "https://www.bumper.com/ms/ltvco-prod-apis-mcp-server/mcp/reports",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "https://chatgpt.com/oauth/client.json",
              "tokenEndpointAuthMethod": "none"
            },
            "authorizationUrl": "https://www.bumper.com/oauth/authorize",
            "tokenUrl": "https://www.bumper.com/oauth/token",
            "authorizationServerBase": "https://www.bumper.com",
            "resource": "https://www.bumper.com/ms/ltvco-prod-apis-mcp-server/mcp/reports",
            "baseScopes": [
              "vehicle.reports.create"
            ]
          }
        }
      }
    }
  }
}
