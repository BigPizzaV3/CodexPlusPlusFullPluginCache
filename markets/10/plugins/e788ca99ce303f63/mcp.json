{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "SSL": {
      "type": "streamable-http",
      "url": "https://mcp.shortstorylovers.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "cimd"
            },
            "resource": "https://mcp.shortstorylovers.com",
            "baseScopes": [
              "author.read",
              "stories.read",
              "stories.write",
              "stories.publish",
              "author_site.read",
              "author_site.write",
              "audience.read",
              "audience.moderate",
              "notifications.read",
              "notifications.write"
            ]
          }
        }
      }
    }
  }
}
