{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "unboundmark": {
      "type": "streamable-http",
      "url": "https://app.unboundmark.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "defaultScopes": [
              "workspace.read",
              "workspace.write",
              "attachments.read",
              "attachments.write",
              "network.fetch",
              "offline_access"
            ]
          }
        }
      }
    }
  }
}
