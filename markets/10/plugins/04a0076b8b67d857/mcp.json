{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "omnia-connect": {
      "type": "streamable-http",
      "url": "https://mcp.omniaseo.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "defaultScopes": [
              "offline_access",
              "omnia:activity:read",
              "omnia:activity:write",
              "omnia:approval:read",
              "omnia:chat:read",
              "omnia:chat:write",
              "omnia:events:read",
              "omnia:events:write",
              "omnia:evolution:read",
              "omnia:evolution:write",
              "omnia:flow:read",
              "omnia:flow:write",
              "omnia:kanban:read",
              "omnia:kanban:write",
              "omnia:nano:content",
              "omnia:nano:read",
              "omnia:nano:write",
              "omnia:notifications:read",
              "omnia:notifications:write",
              "omnia:preferences:write",
              "omnia:prysmbot:read",
              "omnia:prysmbot:write",
              "omnia:team:read",
              "omnia:usage:read",
              "omnia:workspace:feedback",
              "omnia:workspace:read"
            ]
          }
        }
      }
    }
  }
}
