{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "dailysocial": {
      "type": "streamable-http",
      "url": "https://api.daily-social.app/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "baseScopes": [
              "dailysocial:tools",
              "offline_access"
            ]
          }
        }
      }
    }
  }
}
