      "name": "sellapp_get_profile",
      "title": "Get connected SellApp account",
      "description": "Return the SellApp account this connection signs in as: a stable account ID, username and email. Use it to tell connected accounts apart. It changes nothing.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "description": "Stable SellApp account identifier. It never changes for this account and is never reused."
          },
          "name": {
            "type": "string",
            "description": "SellApp username."
          },
          "email": {
            "type": "string",
            "description": "Account email address, for display only."
          },
          "nickname": {
            "type": "string",
            "description": "Label that helps tell connected SellApp accounts apart."
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
