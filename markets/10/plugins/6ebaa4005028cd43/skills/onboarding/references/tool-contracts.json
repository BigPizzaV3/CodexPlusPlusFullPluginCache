    {
      "name": "sellapp_search_docs",
      "description": "Search public Sell documentation and API reference content. Returns bounded excerpts and citation URLs; use sellapp_get_doc for the full page. No store is required. Documentation does not grant access to business operations.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "pattern": "\\S"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10,
            "default": 5
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false
