              "admin"
            ]
          }
        ]
      }
    },
    {
      "name": "sellapp_get_doc",
      "description": "Read a public Sell documentation page as bounded Markdown. Use the path returned by sellapp_search_docs. Continue with next_offset and revision when truncated. No store is required; arbitrary URLs and local files are not accepted.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "pattern": "^/(?:[a-zA-Z0-9_-]+(?:/[a-zA-Z0-9_-]+)*)?$"
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000000,
            "default": 0,
            "description": "Unicode character offset returned as next_offset."
          },
          "max_chars": {
            "type": "integer",
            "minimum": 1000,
            "maximum": 20000,
            "default": 12000
          },
          "revision": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "description": "Pass the returned revision when continuing a page to detect changed content."
          }
        },
        "required": [
          "path"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
