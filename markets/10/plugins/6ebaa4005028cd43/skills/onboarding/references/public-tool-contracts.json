{
  "version": 1,
  "endpoint": "https://sell.app/mcp/onboarding",
  "tools": [
    {
      "name": "sellapp_open_onboarding",
      "title": "Try a store before signup",
      "description": "Open SellApp onboarding before account connection. Make a private template preview, then use hosted signup or sign-in and a separate reviewed private-store claim. Connecting the authenticated Merchant plugin still requires its normal browser consent.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "securitySchemes": [
        {
          "type": "noauth"
        }
      ],
      "_meta": {
        "ui": {
          "resourceUri": "ui://sellapp/merchant-v1",
          "visibility": [
            "model",
            "app"
          ]
        },
        "securitySchemes": [
          {
            "type": "noauth"
          }
        ]
      }
    },
    {
      "name": "sellapp_create_store_preview",
      "title": "Create a private store preview",
      "description": "Create a private, 24-hour template preview from merchant-authored business, product, audience and style. No account needed. This is not AI generation, store creation, publishing, connection consent, or billing. Keep sensitive data out of the brief. business_name accepts letters, numbers and spaces only (3-48 characters). Template choice is clean, warm or bold. Limits apply.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "business_name": {
            "type": "string",
            "minLength": 3,
            "maxLength": 48,
            "description": "Business name using letters, numbers and spaces only (any script); no punctuation or symbols such as apostrophes, ampersands or hyphens."
          },
          "product_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "product_description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "audience": {
            "type": "string",
            "minLength": 1,
            "maxLength": 250
          },
          "style": {
            "type": "string",
            "enum": [
              "clean",
              "warm",
              "bold"
            ]
          }
        },
        "required": [
          "business_name",
          "product_name",
          "product_description",
          "audience",
          "style"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false
      },
      "securitySchemes": [
        {
          "type": "noauth"
        }
      ],
      "_meta": {
        "ui": {
          "resourceUri": "ui://sellapp/merchant-v1",
          "visibility": [
            "model",
            "app"
          ]
        },
        "securitySchemes": [
          {
            "type": "noauth"
          }
        ]
      }
    },
    {
      "name": "sellapp_get_store_preview",
      "title": "Resume a private preview",
      "description": "Read a private preview using its capability token. This reveals only its design brief and stage; it never grants merchant access. Expired previews cannot be claimed.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "preview_id": {
            "type": "string",
            "format": "uuid"
          },
          "preview_token": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64
          }
        },
        "required": [
          "preview_id",
          "preview_token"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "securitySchemes": [
        {
          "type": "noauth"
        }
      ],
      "_meta": {
        "ui": {
          "resourceUri": "ui://sellapp/merchant-v1",
          "visibility": [
            "model",
            "app"
          ]
        },
        "securitySchemes": [
          {
            "type": "noauth"
          }
        ]
      }
    }
  ]
}
