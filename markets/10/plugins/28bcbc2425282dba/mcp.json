{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "frontdesk": {
      "type": "streamable-http",
      "url": "https://mcp.myaifrontdeskadmin.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": [
              "configuration:read",
              "configuration:write",
              "crm:read",
              "crm:write",
              "crm-schema:read",
              "crm-schema:write",
              "sequences:read",
              "sequences:write",
              "scheduling:read",
              "scheduling:write",
              "inbox:read",
              "integrations:read",
              "integrations:write",
              "content:read",
              "content:write",
              "actions:execute"
            ]
          }
        }
      }
    }
  }
}
