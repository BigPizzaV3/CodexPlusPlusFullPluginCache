{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "vividsites": {
      "type": "streamable-http",
      "url": "https://www.vividsites.app/api/connector",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "vividsites-chatgpt",
              "tokenEndpointAuthMethod": "none"
            },
            "authorizationUrl": "https://www.vividsites.app/oauth/authorize",
            "tokenUrl": "https://www.vividsites.app/api/oauth/token",
            "authorizationServerBase": "https://www.vividsites.app",
            "resource": "https://www.vividsites.app/api/connector",
            "baseScopes": [
              "library:read"
            ]
          }
        }
      }
    }
  }
}
