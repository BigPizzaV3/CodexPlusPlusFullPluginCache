{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "sharesign": {
      "type": "streamable-http",
      "url": "https://sharesign.co/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "defaultScopes": [
              "documents:read",
              "documents:preview",
              "documents:author",
              "documents:write",
              "rooms:read",
              "rooms:search",
              "rooms:analytics",
              "rooms:prepare",
              "rooms:diligence",
              "cap-table:read",
              "cap-table:prepare",
              "closings:read",
              "deals:read",
              "cohorts:read",
              "funds:read",
              "clients:read",
              "offline_access"
            ]
          }
        }
      }
    }
  }
}
