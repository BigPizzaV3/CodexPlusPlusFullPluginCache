{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "AI Engine": {
      "type": "streamable-http",
      "url": "https://connect.meowapps.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "cimd"
            },
            "authorizationUrl": "https://connect.meowapps.com/authorize",
            "tokenUrl": "https://connect.meowapps.com/oauth/token",
            "registrationUrl": "https://connect.meowapps.com/oauth/register",
            "authorizationServerBase": "https://connect.meowapps.com",
            "resource": "https://connect.meowapps.com/mcp",
            "baseScopes": ["mcp"]
          }
        }
      }
    }
  }
}
