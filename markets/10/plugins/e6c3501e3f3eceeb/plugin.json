{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "clipfabulous",
  "version": "0.1.2",
  "description": "Create and edit AI images and access your saved creations through your ClipFabulous account.",
  "author": {
    "name": "Michael Alexander",
    "url": "https://clipfabulous.com"
  },
  "homepage": "https://clipfabulous.com",
  "repository": "https://github.com/alexandermichaelwinston/clipfabulous-ai",
  "keywords": [
    "images",
    "creative",
    "credits"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "ClipFabulous",
        "shortDescription": "Create and edit AI images",
        "longDescription": "Create and edit AI images for ads, social posts and creative projects using your ClipFabulous account. Explore image models and aspect ratios, check your account profile, and view or download your saved creations. Image generation and edits require your approval. This connector supports JPEG image workflows.",
        "developerName": "Michael Alexander",
        "category": "Creativity",
        "capabilities": [
          "Check profile and credits",
          "View saved creations",
          "List image models",
          "Create images with approval",
          "Edit saved images with approval"
        ],
        "websiteURL": "https://clipfabulous.com",
        "defaultPrompt": [
          "Check the live credit balance for my specified ClipFabulous account without generating or spending credits."
        ],
        "brandColor": "#EA00B8",
        "brandColorDark": "#00DFFA",
        "composerIcon": "./assets/clipfabulous-logo.jpg",
        "composerIconDark": "./assets/clipfabulous-logo.jpg",
        "logo": "./assets/clipfabulous-logo.jpg",
        "logoDark": "./assets/clipfabulous-logo.jpg",
        "supportURL": "https://clipfabulous.com/support/",
        "privacyPolicyURL": "https://clipfabulous.com/privacy/",
        "termsOfServiceURL": "https://clipfabulous.com/terms/"
      },
      "apps": "./.app.json"
    }
  }
}
