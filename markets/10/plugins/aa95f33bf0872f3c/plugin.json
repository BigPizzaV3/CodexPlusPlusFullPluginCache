{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "cello",
  "version": "1.0.0",
  "description": "Launch and manage referral and partner programs with Cello.",
  "author": {
    "name": "Cello",
    "email": "support@cello.so",
    "url": "https://cello.so/"
  },
  "homepage": "https://cello.so/",
  "repository": "https://github.com/getcello/cello-cursor-plugin",
  "keywords": [
    "cello",
    "referrals",
    "partners",
    "affiliates",
    "growth"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Cello",
        "shortDescription": "Referral program tools",
        "longDescription": "Connect ChatGPT and Codex to Cello to integrate, diagnose, and improve referral and partner programs.",
        "developerName": "Cello",
        "category": "Business & Operations",
        "capabilities": [
          "Read",
          "Write"
        ],
        "defaultPrompt": [
          "Create a Cello integration plan for this app.",
          "Check the health of my Cello integration.",
          "Analyze my Cello referral program performance."
        ],
        "brandColor": "#0B3DFF",
        "websiteURL": "https://cello.so/",
        "supportURL": "https://docs.cello.so/mcp/introduction",
        "privacyPolicyURL": "https://cello.so/privacy-policy-cello-platform",
        "termsOfServiceURL": "https://cello.so/terms-of-service/",
        "composerIcon": "./assets/logo.png",
        "logo": "./assets/logo.png"
      },
      "apps": "./.app.json"
    }
  }
}
