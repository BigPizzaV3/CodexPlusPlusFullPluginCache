{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "gluon-erp-mcp": {
      "type": "streamable-http",
      "url": "https://mcpserver.gluonerp.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "baseScopes": [
              "finance.write",
              "reports.discover",
              "reports.validate",
              "reports.read",
              "reports.execute",
              "reports.write"
            ],
            "client": {
              "mode": "cimd"
            },
            "defaultScopes": [
              "erp.read",
              "profile.read",
              "tenant.read",
              "subscription.read",
              "sales.read",
              "customers.read",
              "finance.read",
              "inventory.read",
              "finance.write",
              "reports.discover",
              "reports.validate",
              "reports.read",
              "reports.execute",
              "reports.write"
            ]
          }
        }
      }
    }
  }
}
