{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "urlme": {
      "type": "streamable-http",
      "url": "https://api.urlme.link/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "defaultScopes": [
              "profile:read",
              "links:read",
              "links:write",
              "usage:read",
              "showcases:read",
              "showcases:write"
            ],
            "client": {
              "mode": "cimd"
            },
            "type": "oauth"
          }
        }
      }
    }
  }
}
