{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "ontown",
  "version": "1.0.0",
  "description": "Find what's on in any city and post events to ontown, an open calendar of local events.",
  "author": {
    "name": "ontown",
    "url": "https://ontown.app"
  },
  "homepage": "https://ontown.app",
  "repository": "https://github.com/slyapustin/events",
  "license": "MIT",
  "keywords": [
    "events",
    "meetups",
    "concerts",
    "city",
    "calendar",
    "what's on"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "ontown",
        "shortDescription": "What's on in your city",
        "longDescription": "ontown is an open calendar of local events: meetups, concerts, talks, workshops, markets. Ask what's happening in a city today, this weekend or this week, get details and sign-up links, or post your own event. Events are shown in the city's local time.",
        "developerName": "ontown",
        "category": "Entertainment",
        "capabilities": [
          "Read",
          "Write"
        ],
        "websiteURL": "https://ontown.app",
        "privacyPolicyURL": "https://ontown.app/privacy/",
        "termsOfServiceURL": "https://ontown.app/terms/",
        "defaultPrompt": [
          "What's on in Gda\u0144sk this weekend?",
          "Find tech meetups in Lisbon next week",
          "Post my event to ontown"
        ],
        "brandColor": "#4a39cc",
        "composerIcon": "./assets/icon.png",
        "logo": "./assets/logo.png",
        "supportURL": "https://ontown.app/about/",
        "brandColorDark": "#ffd43b"
      },
      "apps": "./.app.json"
    }
  }
}
