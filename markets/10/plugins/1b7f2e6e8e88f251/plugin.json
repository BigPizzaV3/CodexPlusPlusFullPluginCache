{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "app-6ab3eb75adb08191b57c34f62d813e8e",
  "version": "1.0.0",
  "description": "Control your smart home with SwitchNest",
  "homepage": "https://onlineswitch.bhartitechnical.com/",
  "author": {
    "name": "ANIL ALOK",
    "email": "anilalok99@gmail.com",
    "url": "https://onlineswitch.bhartitechnical.com/"
  },
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "SwitchNest",
        "shortDescription": "Control your smart home",
        "longDescription": "SwitchNest connects your smart home devices with ChatGPT. Users can view device status, control connected switches and appliances, manage rooms, set schedules and timers, run scenes and routines, and interact with their SwitchNest smart-home system using natural language. Access is limited to devices and data authorized by the user through their SwitchNest account. All device control actions go through the authenticated user home membership and the existing SwitchNest authorization model.",
        "developerName": "ANIL ALOK",
        "category": "Productivity",
        "capabilities": [],
        "websiteURL": "https://onlineswitch.bhartitechnical.com/",
        "supportURL": "https://onlineswitch.bhartitechnical.com/support",
        "privacyPolicyURL": "https://onlineswitch.bhartitechnical.com/privacy",
        "termsOfServiceURL": "https://onlineswitch.bhartitechnical.com/terms",
        "brandColor": "#0284c7",
        "composerIcon": "./icon.png",
        "logo": "./logo.png"
      },
      "mcpServer": {
        "url": "https://onlineswitch.bhartitechnical.com/mcp",
        "authentication_type": "oauth",
        "authentication": {
          "type": "oauth",
          "client_id": "chatgpt-mcp",
          "authorization_url": "https://onlineswitch.bhartitechnical.com/oauth/authorize",
          "token_url": "https://onlineswitch.bhartitechnical.com/api/oauth/token",
          "scopes": [
            "profile.read",
            "devices.read",
            "devices.control",
            "rooms.read",
            "schedules.read",
            "schedules.write",
            "energy.read"
          ],
          "pkce_required": true,
          "pkce_method": "S256"
        }
      },
      "apps": "./.app.json"
    }
  }
}
