{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "well-packed": {
      "type": "streamable-http",
      "url": "https://www.bewellpacked.com/api/v1/chatgpt/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "mixed",
            "client": {
              "mode": "dcr"
            },
            "resource": "https://www.bewellpacked.com/api/v1/chatgpt/mcp",
            "defaultScopes": [
              "openid",
              "email",
              "closet:read",
              "looks:write",
              "plans:read",
              "plans:write"
            ]
          }
        }
      }
    }
  }
}
