{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "threadcam": {
      "type": "streamable-http",
      "url": "https://www.threadcam.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "mixed",
            "client": {
              "mode": "cimd"
            },
            "baseScopes": [
              "threadcam.account"
            ]
          }
        }
      }
    }
  }
}
