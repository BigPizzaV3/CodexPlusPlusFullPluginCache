{
  "name": "carousel-creator",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:http": "node --test tests/http.integration.mjs",
    "build:carousel": "node scripts/build-carousel.mjs",
    "catalog:sync": "node scripts/sync-catalog.mjs",
    "catalog:check": "node scripts/sync-catalog.mjs --check",
    "spec": "node scripts/get-spec.mjs",
    "package:plugin": "node scripts/package-plugin.mjs",
    "render:carousel": "node scripts/render-carousel.mjs",
    "renderer:setup": "node scripts/setup-native-renderer.mjs",
    "test:native": "node --test tests/native.integration.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.2",
    "fflate": "^0.8.2",
    "sharp": "^0.34.3",
    "yaml": "^2.8.1",
    "zod": "^3.25.76"
  }
}
