{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "docmino": {
      "type": "streamable-http",
      "url": "https://mcp.docmino.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": { "mode": "cimd" },
            "baseScopes": [],
            "defaultScopes": [
              "mcp:read",
              "mcp:write",
              "mcp:share",
              "mcp:delete"
            ],
            "oidcEnabled": false
          }
        }
      }
    }
  }
}
