{
  "mcpServers": {
    "parley": {
      "type": "http",
      "url": "https://api.parley.so/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "authorizationServerBase": "https://app.parley.so",
            "authorizationUrl": "https://app.parley.so/api/mcp-oauth/authorize",
            "tokenUrl": "https://app.parley.so/api/mcp-oauth/token",
            "registrationUrl": "https://app.parley.so/api/mcp-oauth/register"
          }
        }
      }
    }
  }
}
