    "category": "Business & Operations",
    "defaultPrompt": [
      "\u05d0\u05e0\u05d9 \u05de\u05d7\u05e4\u05e9 \u05e7\u05e8\u05e7\u05e2 \u05dc\u05d4\u05e9\u05e7\u05e2\u05d4 \u05d1\u05e8\u05d7\u05d5\u05d1\u05d5\u05ea",
      "\u05d4\u05e6\u05d2 \u05dc\u05d9 \u05d0\u05ea \u05d4\u05e4\u05e8\u05d5\u05d9\u05e7\u05d8 \u05d1\u05d9\u05d0\u05dc\u05d9\u05e7 \u05e2\u05dc \u05d4\u05e4\u05d0\u05e8\u05e7",
