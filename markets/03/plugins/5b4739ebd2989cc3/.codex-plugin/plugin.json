  "apps": "./.app.json",
  "author": {
    "name": "\u682a\u5f0f\u4f1a\u793e\u30b5\u30d6\u30b9\u30af\u30e9\u30a4\u30f3 (Subscline Inc.)"
  },
  "description": "\u30b5\u30d6\u30b9\u30af\u30e9\u30a4\u30f3\u306f\u3001LINE\u3092\u6d3b\u7528\u3057\u305f\u30de\u30fc\u30b1\u30c6\u30a3\u30f3\u30b0CRM\u3067\u3059\u3002\u672c\u30b3\u30cd\u30af\u30bf\u30fc\u3092\u4f7f\u3046\u3068\u3001ChatGPT\u304b\u3089\u81ea\u793e\u306e\u30b5\u30d6\u30b9\u30af\u30e9\u30a4\u30f3\u306e\u30c7\u30fc\u30bf\u3092\u5b89\u5168\u306b\u53c2\u7167\u3057\u3001\u5404\u7a2e\u8a2d\u5b9a\u3084\u914d\u4fe1\u3092\u300c\u4e0b\u66f8\u304d\u30fb\u7121\u52b9\u72b6\u614b\u300d\u3067\u4f5c\u6210\u3067\u304d\u307e\u3059\u3002\n\n\u25a0 \u53c2\u7167\uff08read\uff09\n\u30fb\u30e6\u30fc\u30b6\u30fc\u30b0\u30eb\u30fc\u30d7\uff08\u914d\u4fe1\u30bb\u30b0\u30e1\u30f3\u30c8\uff09\u306e\u4e00\u89a7\n\u30fb\u9867\u5ba2\u57fa\u76e4\u306e\u6982\u6cc1\uff08LINE\u53cb\u3060\u3061\u6570\u30fb\u30d6\u30ed\u30c3\u30af\u6570\u3001\u30b5\u30d6\u30b9\u30af\u5951\u7d04\u306e\u7d99\u7d9a/\u89e3\u7d04\u3001\u76f4\u8fd1\u306e\u4e88\u7d04\u30fb\u6765\u5e97\uff09\n\u30fb\u8ab2\u91d1\u307e\u308f\u308a\u306e\u60c5\u5831\uff08\u8ca9\u58f2\u4e2d\u30d7\u30e9\u30f3\u3001\u30c8\u30e9\u30a4\u30a2\u30eb\u8a2d\u5b9a\u3001\u652f\u6255\u3044\u65b9\u6cd5\u306e\u533a\u5206\uff09\n\u30fb\u914d\u4fe1\u306e\u4e0b\u66f8\u304d\u4e00\u89a7\uff0f\u4e0b\u66f8\u304d\u8a73\u7d30\u3001\u9001\u4fe1\u6e08\u307f\u914d\u4fe1\u306e\u5b9f\u7e3e\u30ec\u30dd\u30fc\u30c8\uff08\u9001\u4fe1\u5bfe\u8c61\u6570\u30fb\u958b\u5c01\u30fb\u30bf\u30c3\u30d7\u30fb\u5404\u7387\uff09\n\n\u25a0 \u4f5c\u6210\uff08write\uff09\u203b\u3059\u3079\u3066\u5b89\u5168\u306a\u72b6\u614b\uff08\u4e0b\u66f8\u304d\uff0f\u7121\u52b9\uff0f\u975e\u516c\u958b\uff09\u3067\u65b0\u898f\u4f5c\u6210\u3057\u307e\u3059\u3002\u65e2\u5b58\u30c7\u30fc\u30bf\u306e\u66f4\u65b0\u30fb\u524a\u9664\u3084\u3001\u5373\u6642\u914d\u4fe1\u30fb\u5373\u6642\u516c\u958b\u306f\u884c\u3044\u307e\u305b\u3093\u3002\n\u30fb\u30bb\u30b0\u30e1\u30f3\u30c8\u914d\u4fe1\uff0f\u30b9\u30c6\u30c3\u30d7\u914d\u4fe1\u306e\u4e0b\u66f8\u304d\n\u30fb\u30e6\u30fc\u30b6\u30fc\u30b0\u30eb\u30fc\u30d7\uff08\u5168\u54e1\u5bfe\u8c61\u30fb\u6761\u4ef6\u4ed8\u304d\uff09\n\u30fb\u30ad\u30fc\u30ef\u30fc\u30c9\u81ea\u52d5\u5fdc\u7b54\n\u30fb\u30af\u30fc\u30dd\u30f3\n\u30fb\u30d7\u30e9\u30f3\n\u30fb\u30ea\u30c3\u30c1\u30e1\u30cb\u30e5\u30fc\u306e\u4e0b\u66f8\u304d\n\n\u4f5c\u6210\u3057\u305f\u5185\u5bb9\u306f\u7ba1\u7406\u753b\u9762\u3067\u78ba\u8a8d\u3057\u3001\u4eba\u304c\u6709\u52b9\u5316\u30fb\u516c\u958b\u30fb\u914d\u4fe1\u3057\u307e\u3059\u3002AI\u304cLINE\u3078\u76f4\u63a5\u914d\u4fe1\u3057\u305f\u308a\u3001\u8a2d\u5b9a\u3092\u5373\u6642\u516c\u958b\u3059\u308b\u3053\u3068\u306f\u3042\u308a\u307e\u305b\u3093\u3002\n\n\u25a0 \u5b89\u5168\u6027\n\u30fb\u5404\u63a5\u7d9a\u306f1\u3064\u306e\u30c6\u30ca\u30f3\u30c8\uff08\u5951\u7d04\u30ef\u30fc\u30af\u30b9\u30da\u30fc\u30b9\uff09\u306b\u56fa\u5b9a\u3002\u63a5\u7d9a\u5148\u306f\u30a2\u30af\u30bb\u30b9\u30c8\u30fc\u30af\u30f3\u304b\u3089\u6c7a\u307e\u308a\u3001AI\u30af\u30e9\u30a4\u30a2\u30f3\u30c8\u5074\u304b\u3089\u5909\u66f4\u3067\u304d\u306a\u3044\u305f\u3081\u3001\u30c6\u30ca\u30f3\u30c8\u8d8a\u5883\u306f\u8d77\u304d\u307e\u305b\u3093\u3002\n\u30fb\u8a8d\u8a3c\u306fOAuth 2.1\uff08PKCE\uff0f\u52d5\u7684\u30af\u30e9\u30a4\u30a2\u30f3\u30c8\u767b\u9332\uff09\u3002\u30b9\u30b3\u30fc\u30d7\uff08read\uff0fwrite\uff09\u306f\u30c4\u30fc\u30eb\u5358\u4f4d\u3067\u5236\u5fa1\u3002\n\u30fb\u3059\u3079\u3066\u306e\u30c4\u30fc\u30eb\u547c\u3073\u51fa\u3057\u306f\u76e3\u67fb\u30ed\u30b0\u306b\u8a18\u9332\u3002\u672c\u30b3\u30cd\u30af\u30bf\u30fc\u7d4c\u7531\u3067\u53d6\u5f97\u3057\u305f\u30c7\u30fc\u30bf\u3092\u5f53\u793eAI\u30e2\u30c7\u30eb\u306e\u5b66\u7fd2\u306b\u4f7f\u7528\u3057\u307e\u305b\u3093\u3002\n\n\u5bfe\u8c61\uff1a\u30b5\u30d6\u30b9\u30af\u30e9\u30a4\u30f3\u3092\u3054\u5229\u7528\u4e2d\u306e\u5e97\u8217\u30fb\u4e8b\u696d\u8005\u3055\u307e\u3002",
  "interface": {
    "capabilities": [],
    "category": "Business & Operations",
    "defaultPrompt": [
      "\u9867\u5ba2\u57fa\u76e4\u306e\u6982\u6cc1\uff08\u53cb\u3060\u3061\u6570\u30fb\u30d6\u30ed\u30c3\u30af\u6570\u3001\u30b5\u30d6\u30b9\u30af\u7d99\u7d9a/\u89e3\u7d04\u3001\u76f4\u8fd1\u306e\u4e88\u7d04\u30fb\u6765\u5e97\uff09\u3092\u8981\u7d04\u3057\u3066",
      "\u914d\u4fe1\u306e\u4e0b\u66f8\u304d\u4e00\u89a7\u3068\u3001\u9001\u4fe1\u6e08\u307f\u914d\u4fe1\u306e\u5b9f\u7e3e\uff08\u958b\u5c01\u30fb\u30bf\u30c3\u30d7\u7387\uff09\u3092\u898b\u305b\u3066",
      "\u30e6\u30fc\u30b6\u30fc\u30b0\u30eb\u30fc\u30d7\uff08\u914d\u4fe1\u30bb\u30b0\u30e1\u30f3\u30c8\uff09\u306e\u4e00\u89a7\u3092\u898b\u305b\u3066"
    ],
    "developerName": "\u682a\u5f0f\u4f1a\u793e\u30b5\u30d6\u30b9\u30af\u30e9\u30a4\u30f3 (Subscline Inc.)",
    "displayName": "subscline",
    "longDescription": "\u30b5\u30d6\u30b9\u30af\u30e9\u30a4\u30f3\u306f\u3001LINE\u3092\u6d3b\u7528\u3057\u305f\u30de\u30fc\u30b1\u30c6\u30a3\u30f3\u30b0CRM\u3067\u3059\u3002\u672c\u30b3\u30cd\u30af\u30bf\u30fc\u3092\u4f7f\u3046\u3068\u3001ChatGPT\u304b\u3089\u81ea\u793e\u306e\u30b5\u30d6\u30b9\u30af\u30e9\u30a4\u30f3\u306e\u30c7\u30fc\u30bf\u3092\u5b89\u5168\u306b\u53c2\u7167\u3057\u3001\u5404\u7a2e\u8a2d\u5b9a\u3084\u914d\u4fe1\u3092\u300c\u4e0b\u66f8\u304d\u30fb\u7121\u52b9\u72b6\u614b\u300d\u3067\u4f5c\u6210\u3067\u304d\u307e\u3059\u3002\n\n\u25a0 \u53c2\u7167\uff08read\uff09\n\u30fb\u30e6\u30fc\u30b6\u30fc\u30b0\u30eb\u30fc\u30d7\uff08\u914d\u4fe1\u30bb\u30b0\u30e1\u30f3\u30c8\uff09\u306e\u4e00\u89a7\n\u30fb\u9867\u5ba2\u57fa\u76e4\u306e\u6982\u6cc1\uff08LINE\u53cb\u3060\u3061\u6570\u30fb\u30d6\u30ed\u30c3\u30af\u6570\u3001\u30b5\u30d6\u30b9\u30af\u5951\u7d04\u306e\u7d99\u7d9a/\u89e3\u7d04\u3001\u76f4\u8fd1\u306e\u4e88\u7d04\u30fb\u6765\u5e97\uff09\n\u30fb\u8ab2\u91d1\u307e\u308f\u308a\u306e\u60c5\u5831\uff08\u8ca9\u58f2\u4e2d\u30d7\u30e9\u30f3\u3001\u30c8\u30e9\u30a4\u30a2\u30eb\u8a2d\u5b9a\u3001\u652f\u6255\u3044\u65b9\u6cd5\u306e\u533a\u5206\uff09\n\u30fb\u914d\u4fe1\u306e\u4e0b\u66f8\u304d\u4e00\u89a7\uff0f\u4e0b\u66f8\u304d\u8a73\u7d30\u3001\u9001\u4fe1\u6e08\u307f\u914d\u4fe1\u306e\u5b9f\u7e3e\u30ec\u30dd\u30fc\u30c8\uff08\u9001\u4fe1\u5bfe\u8c61\u6570\u30fb\u958b\u5c01\u30fb\u30bf\u30c3\u30d7\u30fb\u5404\u7387\uff09\n\n\u25a0 \u4f5c\u6210\uff08write\uff09\u203b\u3059\u3079\u3066\u5b89\u5168\u306a\u72b6\u614b\uff08\u4e0b\u66f8\u304d\uff0f\u7121\u52b9\uff0f\u975e\u516c\u958b\uff09\u3067\u65b0\u898f\u4f5c\u6210\u3057\u307e\u3059\u3002\u65e2\u5b58\u30c7\u30fc\u30bf\u306e\u66f4\u65b0\u30fb\u524a\u9664\u3084\u3001\u5373\u6642\u914d\u4fe1\u30fb\u5373\u6642\u516c\u958b\u306f\u884c\u3044\u307e\u305b\u3093\u3002\n\u30fb\u30bb\u30b0\u30e1\u30f3\u30c8\u914d\u4fe1\uff0f\u30b9\u30c6\u30c3\u30d7\u914d\u4fe1\u306e\u4e0b\u66f8\u304d\n\u30fb\u30e6\u30fc\u30b6\u30fc\u30b0\u30eb\u30fc\u30d7\uff08\u5168\u54e1\u5bfe\u8c61\u30fb\u6761\u4ef6\u4ed8\u304d\uff09\n\u30fb\u30ad\u30fc\u30ef\u30fc\u30c9\u81ea\u52d5\u5fdc\u7b54\n\u30fb\u30af\u30fc\u30dd\u30f3\n\u30fb\u30d7\u30e9\u30f3\n\u30fb\u30ea\u30c3\u30c1\u30e1\u30cb\u30e5\u30fc\u306e\u4e0b\u66f8\u304d\n\n\u4f5c\u6210\u3057\u305f\u5185\u5bb9\u306f\u7ba1\u7406\u753b\u9762\u3067\u78ba\u8a8d\u3057\u3001\u4eba\u304c\u6709\u52b9\u5316\u30fb\u516c\u958b\u30fb\u914d\u4fe1\u3057\u307e\u3059\u3002AI\u304cLINE\u3078\u76f4\u63a5\u914d\u4fe1\u3057\u305f\u308a\u3001\u8a2d\u5b9a\u3092\u5373\u6642\u516c\u958b\u3059\u308b\u3053\u3068\u306f\u3042\u308a\u307e\u305b\u3093\u3002\n\n\u25a0 \u5b89\u5168\u6027\n\u30fb\u5404\u63a5\u7d9a\u306f1\u3064\u306e\u30c6\u30ca\u30f3\u30c8\uff08\u5951\u7d04\u30ef\u30fc\u30af\u30b9\u30da\u30fc\u30b9\uff09\u306b\u56fa\u5b9a\u3002\u63a5\u7d9a\u5148\u306f\u30a2\u30af\u30bb\u30b9\u30c8\u30fc\u30af\u30f3\u304b\u3089\u6c7a\u307e\u308a\u3001AI\u30af\u30e9\u30a4\u30a2\u30f3\u30c8\u5074\u304b\u3089\u5909\u66f4\u3067\u304d\u306a\u3044\u305f\u3081\u3001\u30c6\u30ca\u30f3\u30c8\u8d8a\u5883\u306f\u8d77\u304d\u307e\u305b\u3093\u3002\n\u30fb\u8a8d\u8a3c\u306fOAuth 2.1\uff08PKCE\uff0f\u52d5\u7684\u30af\u30e9\u30a4\u30a2\u30f3\u30c8\u767b\u9332\uff09\u3002\u30b9\u30b3\u30fc\u30d7\uff08read\uff0fwrite\uff09\u306f\u30c4\u30fc\u30eb\u5358\u4f4d\u3067\u5236\u5fa1\u3002\n\u30fb\u3059\u3079\u3066\u306e\u30c4\u30fc\u30eb\u547c\u3073\u51fa\u3057\u306f\u76e3\u67fb\u30ed\u30b0\u306b\u8a18\u9332\u3002\u672c\u30b3\u30cd\u30af\u30bf\u30fc\u7d4c\u7531\u3067\u53d6\u5f97\u3057\u305f\u30c7\u30fc\u30bf\u3092\u5f53\u793eAI\u30e2\u30c7\u30eb\u306e\u5b66\u7fd2\u306b\u4f7f\u7528\u3057\u307e\u305b\u3093\u3002\n\n\u5bfe\u8c61\uff1a\u30b5\u30d6\u30b9\u30af\u30e9\u30a4\u30f3\u3092\u3054\u5229\u7528\u4e2d\u306e\u5e97\u8217\u30fb\u4e8b\u696d\u8005\u3055\u307e\u3002",
