{
  "format": "firemoon-life/v2",
  "plugin": "nutrition-label-lab",
  "version": "0.3.0",
  "operation": "scale_label",
  "input": {
    "name": "Oats",
    "servings": 2,
    "calories": 150,
    "protein_g": 5,
    "fiber_g": 4,
    "sodium_mg": 0,
    "added_sugar_g": 0
  },
  "output": {
    "name": "Oats",
    "servings": 2,
    "totals": {
      "calories": 300,
      "protein_g": 10,
      "fiber_g": 8,
      "sodium_mg": 0,
      "added_sugar_g": 0
    },
    "basis": "Supplied per-serving label values multiplied by servings."
  }
}