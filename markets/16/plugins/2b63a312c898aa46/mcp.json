{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "forminit": {
      "type": "streamable-http",
      "url": "https://api.forminit.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "cimd"
            },
            "baseScopes": [
              "mcp:use"
            ],
            "defaultScopes": [
              "workspaces:read",
              "forms:read",
              "submissions:read",
              "activity:read",
              "submissions:write",
              "submissions:delete",
              "forms:write",
              "workspaces:write"
            ]
          }
        }
      }
    }
  }
}
