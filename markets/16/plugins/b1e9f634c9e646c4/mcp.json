{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "rizamo": {
      "type": "streamable-http",
      "url": "https://mcp.rizamo.com/mcp?via=chatgpt-plugin",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "cimd"
            },
            "resource": "https://mcp.rizamo.com/mcp",
            "oidcEnabled": false,
            "defaultScopes": [
              "accounts:read",
              "accounts:write",
              "fields:read",
              "fields:write",
              "posts:read",
              "posts:write",
              "media:read",
              "media:write",
              "inbox:read",
              "inbox:write",
              "links:read",
              "links:write",
              "analytics:read",
              "automations:read",
              "automations:write",
              "events:read",
              "webhooks:read",
              "webhooks:write"
            ],
            "baseScopes": [
              "offline_access"
            ]
          }
        }
      }
    }
  }
}
