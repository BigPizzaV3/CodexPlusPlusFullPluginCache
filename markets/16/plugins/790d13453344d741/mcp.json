{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "aisma": {
      "type": "streamable-http",
      "url": "https://api.aisma.ai/mcp/catalog",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "defaultScopes": [
              "offline_access"
            ],
            "oidcEnabled": false
          }
        }
      }
    }
  }
}
