{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "classroom-writer": {
      "type": "streamable-http",
      "url": "https://www.classroomwriter.com/api/chatgpt/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": [
              "cwriter.assessments.create"
            ],
            "defaultScopes": [
              "cwriter.assessments.create"
            ],
            "authorizationUrl": "https://www.classroomwriter.com/gpt/connect",
            "tokenUrl": "https://www.classroomwriter.com/api/gpt-oauth/token",
            "registrationUrl": "https://www.classroomwriter.com/api/ai-connectors/oauth/register"
          }
        }
      }
    }
  }
}
