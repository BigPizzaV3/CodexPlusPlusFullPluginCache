{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "idmp-plugin",
  "version": "0.1.1",
  "description": "TDengine IDMP plugin with packaged skills for discovery, schema inspection, and safe operational workflows.",
  "author": {
    "name": "TAOS Data",
    "email": "it@taosdata.com"
  },
  "homepage": "https://tdengine.com/idmp/",
  "repository": "https://github.com/taosdata/agent-skills",
  "license": "MIT",
  "keywords": [
    "TDengine",
    "IDMP",
    "database",
    "monitoring",
    "alert",
    "dashboard",
    "industrial-data",
    "industrial-manufacturing",
    "data-management",
    "iot",
    "time-series",
    "asset-modeling",
    "data-ingestion"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "TDengine IDMP",
        "shortDescription": "Manage TDengine IDMP",
        "longDescription": "Connect to TDengine IDMP with idmp-cli and use packaged skills to explore elements, inspect schemas, model assets, build dashboards, manage alerts, and run safe operational workflows. Requires idmp-cli and an authenticated IDMP profile.",
        "developerName": "TAOS Data",
        "category": "Data & Analytics",
        "capabilities": [
          "Read",
          "Write"
        ],
        "websiteURL": "https://tdengine.com/idmp/",
        "supportURL": "https://github.com/taosdata/agent-skills/issues",
        "privacyPolicyURL": "https://tdengine.com/legal/privacy-policy/",
        "termsOfServiceURL": "https://tdengine.com/legal/tdengine-cloud-terms-of-service/",
        "defaultPrompt": [
          "Check my IDMP connection and list the available root elements."
        ],
        "brandColor": "#18499D",
        "composerIcon": "./assets/icon.png",
        "logo": "./assets/logo.png"
      }
    }
  }
}
