{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "zactra-mail": {
      "type": "streamable-http",
      "url": "https://email-backend.zactra.com/mcp/",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "authorizationServerBase": "https://email-backend.zactra.com",
            "authorizationUrl": "https://email-backend.zactra.com/oauth/authorize",
            "tokenUrl": "https://email-backend.zactra.com/oauth/token",
            "registrationUrl": "https://email-backend.zactra.com/oauth/register",
            "resource": "https://email-backend.zactra.com/mcp/",
            "baseScopes": [
              "mail:read",
              "mail:send",
              "offline_access"
            ]
          }
        }
      }
    }
  }
}
