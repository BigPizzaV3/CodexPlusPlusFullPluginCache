{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "cookiedeal": {
      "type": "streamable-http",
      "url": "https://mcp.cookiedeal.io/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "authorizationServerBase": "https://mcp.cookiedeal.io",
            "registrationUrl": "https://mcp.cookiedeal.io/oauth/register",
            "resource": "https://mcp.cookiedeal.io/mcp",
            "defaultScopes": [
              "company:search",
              "company:summary:read",
              "company:detail:read",
              "company:section:unlock",
              "cookie:balance:read",
              "cookie:spend",
              "corporate-registry:view",
              "corporate-registry:read",
              "real-estate-registry:search",
              "real-estate-registry:view",
              "real-estate-registry:read",
              "signal:read",
              "notification:read",
              "notification:write",
              "company:list:read"
            ]
          }
        }
      }
    }
  }
}
