{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "lightpass": {
      "type": "streamable-http",
      "url": "https://lightpass-connector-production.up.railway.app/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "lightpass-openai",
              "tokenEndpointAuthMethod": "client_secret_post"
            },
            "authorizationUrl": "https://lightpass-auth-production.up.railway.app/realms/lightpass/protocol/openid-connect/auth",
            "tokenUrl": "https://lightpass-auth-production.up.railway.app/realms/lightpass/protocol/openid-connect/token",
            "baseScopes": [
              "openid",
              "email",
              "profile",
              "lightpass:recommend",
              "lightpass:profile"
            ]
          }
        }
      }
    }
  }
}
