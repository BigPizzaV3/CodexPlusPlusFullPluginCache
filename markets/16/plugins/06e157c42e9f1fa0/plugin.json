{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "author": {
    "name": "AI EmpowerHub"
  },
  "description": "Generate & refine ideas",
  "extensions": {
    "com.openai": {
      "interface": {
        "capabilities": [
          "Interactive"
        ],
        "category": "Business & Operations",
        "composerIcon": "assets/startup-ideas.png",
        "defaultPrompt": [
          "Generate business ideas that fit my skills, budget, and time constraints.",
          "Give me five concepts for this customer problem and compare them.",
          "Refine this rough idea into a clear business concept."
        ],
        "developerName": "AI EmpowerHub",
        "displayName": "Startup Ideas - AI EHub",
        "logo": "assets/startup-ideas.png",
        "longDescription": "Client-facing startup idea generation and early concept guidance with specialty-specific guidance, privacy boundaries, mentor handoffs, and routing to complementary business tools.",
        "privacyPolicyURL": "https://ai-empowerhub.johnmtrenaryicloud-com.chatgpt.site/privacy/",
        "shortDescription": "Generate & refine ideas",
        "supportURL": "https://ai-empowerhub.johnmtrenaryicloud-com.chatgpt.site/support/",
        "termsOfServiceURL": "https://ai-empowerhub.johnmtrenaryicloud-com.chatgpt.site/terms/",
        "websiteURL": "https://ai-empowerhub.johnmtrenaryicloud-com.chatgpt.site/plugins/"
      }
    }
  },
  "name": "startup-concept-generator-client-pilot",
  "version": "1.0.8"
}
