{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.4"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600
    },
    "locale": {
      "enum": [
        "en",
        "zh-TW",
        "zh-CN"
      ]
    },
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 600
              },
              "group": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
              },
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              }
            },
            "required": [
              "id",
              "label",
              "group"
            ]
          },
          "minItems": 1,
          "maxItems": 40
        },
        "groups": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 600
              }
            },
            "required": [
              "id",
              "label"
            ]
          },
          "minItems": 1,
          "maxItems": 8
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
              },
              "from": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
              },
              "to": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
              },
              "kind": {
                "enum": [
                  "data",
                  "feedback",
                  "control",
                  "reference"
                ]
              },
              "from_port": {
                "enum": [
                  "left",
                  "right",
                  "top",
                  "bottom"
                ]
              },
              "to_port": {
                "enum": [
                  "left",
                  "right",
                  "top",
                  "bottom"
                ]
              },
              "waypoints": {
                "type": "array",
                "items": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    }
                  ],
                  "items": false,
                  "minItems": 2,
                  "maxItems": 2
                },
                "minItems": 0,
                "maxItems": 20
              }
            },
            "required": [
              "id",
              "from",
              "to",
              "kind"
            ]
          },
          "minItems": 0,
          "maxItems": 100
        }
      },
      "required": [
        "nodes",
        "groups",
        "edges"
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          },
          "targets": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
            },
            "minItems": 1,
            "maxItems": 148
          },
          "status": {
            "enum": [
              "confirmed",
              "unconfirmed",
              "synthetic"
            ]
          }
        },
        "required": [
          "id",
          "text",
          "targets",
          "status"
        ]
      },
      "minItems": 1,
      "maxItems": 200
    },
    "views": {
      "const": [
        {
          "id": "overview"
        }
      ]
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "dark",
            "light"
          ]
        }
      },
      "required": [
        "mode"
      ]
    },
    "story": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "guided",
            "loop"
          ]
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 600
              },
              "targets": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
                },
                "minItems": 0,
                "maxItems": 140
              },
              "duration": {
                "type": "number",
                "minimum": 1,
                "maximum": 60
              }
            },
            "required": [
              "id",
              "text",
              "targets",
              "duration"
            ]
          },
          "minItems": 1,
          "maxItems": 60
        }
      },
      "required": [
        "mode",
        "steps"
      ]
    },
    "export": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "width": {
          "const": 1920
        },
        "height": {
          "const": 1080
        },
        "formats": {
          "type": "array",
          "items": {
            "enum": [
              "json",
              "svg",
              "html",
              "png",
              "gif"
            ]
          },
          "minItems": 1,
          "maxItems": 5
        }
      },
      "required": [
        "width",
        "height",
        "formats"
      ]
    }
  },
  "required": [
    "schema_version",
    "title",
    "locale",
    "graph",
    "sources",
    "views",
    "theme",
    "story",
    "export"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Structural contract. scripts/diagram.py also enforces IDs, provenance, finite numbers, limits, loop cardinality and geometry."
}