{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "connect-the-dots": {
      "type": "streamable-http",
      "url": "https://app.ctd.ai/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": ["read", "write"]
          }
        }
      }
    }
  }
}
