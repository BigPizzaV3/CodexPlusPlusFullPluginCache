{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "datagrail": {
      "type": "streamable-http",
      "url": "https://mcpconnectordemo.datagrail.io/api/v2/mcp",
      "extensions": {
        "com.openai": {
          "urlTemplates": [
            "https://{workspace}.datagrail.io/api/v2/mcp"
          ],
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "defaultScopes": ["mcp:tools:read", "openid", "email"],
            "oidcEnabled": true
          }
        }
      }
    }
  }
}
