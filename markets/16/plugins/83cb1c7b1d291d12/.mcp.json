{
  "mcpServers": {
    "idea-ai": {
      "type": "streamable-http",
      "url": "https://mcp.idea.ai/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "cimd"
            },
            "baseScopes": [
              "mcp:read",
              "mcp:generate"
            ],
            "defaultScopes": [
              "mcp:read",
              "mcp:generate"
            ],
            "authorizationUrl": "https://oauth.creativefabrica.com/oauth2/auth",
            "tokenUrl": "https://oauth.creativefabrica.com/oauth2/token",
            "registrationUrl": "https://oauth.creativefabrica.com/oauth2/register",
            "authorizationServerBase": "https://oauth.creativefabrica.com",
            "resource": "https://mcp.idea.ai/mcp"
          }
        }
      }
    }
  }
}
