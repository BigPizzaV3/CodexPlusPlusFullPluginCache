{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "ready-for-us": {
      "type": "streamable-http",
      "url": "https://readyforus.app/api/v1/mcp/private",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "cimd"
            },
            "baseScopes": [
              "reflections:read"
            ],
            "defaultScopes": [
              "reflections:read",
              "partner_shared:read",
              "profile:read_basic",
              "offline_access"
            ]
          }
        }
      }
    }
  }
}
