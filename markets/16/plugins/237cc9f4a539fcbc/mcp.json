{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "calcing": {
      "type": "streamable-http",
      "url": "https://saas.calcing.de/mcp/openai",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "mixed",
            "client": {
              "mode": "provided",
              "clientId": "chatgpt",
              "tokenEndpointAuthMethod": "none"
            },
            "resource": "https://saas.calcing.de/mcp/openai",
            "authorizationUrl": "https://saas.calcing.de/api/oauth/authorize",
            "tokenUrl": "https://saas.calcing.de/api/oauth/token"
          }
        }
      }
    }
  }
}
