{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "brizz": {
      "type": "streamable-http",
      "url": "https://platform.brizz.dev/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": { "mode": "dcr" },
            "authorizationUrl": "https://platform.brizz.dev/mcp/oauth/authorize",
            "tokenUrl": "https://platform.brizz.dev/mcp/oauth/token",
            "baseScopes": ["mcp:read", "mcp:write"]
          }
        }
      }
    }
  }
}
