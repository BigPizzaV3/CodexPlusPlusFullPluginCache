{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "ftw-journal": {
      "type": "streamable-http",
      "url": "https://journal.financialtechwiz.com/api/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "cimd"
            },
            "defaultScopes": [
              "read:scanners",
              "read:backtests",
              "read:trades",
              "read:equity",
              "read:accounts",
              "write:trades",
              "write:journal",
              "write:equity"
            ]
          }
        }
      }
    }
  }
}
