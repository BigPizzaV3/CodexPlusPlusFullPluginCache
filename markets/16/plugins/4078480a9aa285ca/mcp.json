{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "tax-hero": {
      "type": "streamable-http",
      "url": "https://taxhero.vc/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "th_client_e09bda4fbbb4bc818a514904978d4c2a",
              "tokenEndpointAuthMethod": "client_secret_basic"
            },
            "baseScopes": [
              "profile:read"
            ],
            "defaultScopes": [
              "businesses:self:read",
              "deadlines:self:read",
              "documents:self:read",
              "subscriptions:self:read",
              "processing:self:read"
            ],
            "oidcEnabled": false
          }
        }
      }
    }
  }
}
