{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "logistify-quickbooks-desktop": {
      "type": "streamable-http",
      "url": "https://mcp.logistify.ai/quickbooks-desktop/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": ["quickbooks.read", "quickbooks.write", "offline_access"]
          }
        }
      }
    }
  }
}
