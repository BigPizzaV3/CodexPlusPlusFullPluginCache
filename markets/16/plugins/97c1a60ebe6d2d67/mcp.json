{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "nibvine": {
      "type": "streamable-http",
      "url": "https://nibvine.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "resource": "https://nibvine.com/mcp",
            "client": {
              "mode": "provided",
              "clientId": "nibvine-chatgpt",
              "tokenEndpointAuthMethod": "none"
            },
            "baseScopes": ["mcp:connect"],
            "defaultScopes": [
              "projects:read", "projects:write", "notes:read", "notes:write",
              "tasks:read", "tasks:write", "changes:read", "ideas:read", "ideas:write",
              "comments:read", "comments:write", "quicknotes:read", "quicknotes:write", "analyses:read"
            ]
          }
        }
      }
    }
  }
}
