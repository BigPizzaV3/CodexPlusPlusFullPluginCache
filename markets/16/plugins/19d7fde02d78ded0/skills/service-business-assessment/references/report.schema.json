        "close_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "job_value": {
          "type": "number",
          "minimum": 0
        },
        "currency": {
          "type": "string"
        },
        "formula": {
          "type": "string"
        },
        "limitations": {
          "type": "string"
        }
