    "schema_version",
    "id",
    "title",
    "assessment_date",
    "version",
    "business",
    "summary",
    "status",
    "entities",
    "findings",
    "pages",
    "ads",
    "opportunities",
    "sources",
    "email_test",
    "model",
    "methodology",
    "data_needed"
