          "title": {
            "type": "string"
          },
          "timing": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "work": {
            "type": "string"
          },
          "done": {
            "type": "string"
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "title",
          "timing",
          "owner",
          "work",
          "done",
          "source_ids"
        ]
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string",
