          "entity_id",
          "url",
          "canonical",
          "title",
          "description",
          "http_status",
          "type",
          "tel_links",
          "platform",
          "source_ids",
          "observed_at"
        ]
      }
    },
    "ads": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "entity_id": {
            "type": "string"
