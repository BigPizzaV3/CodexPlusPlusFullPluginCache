{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "mbc": {
      "type": "streamable-http",
      "url": "https://cenulinq.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": [
              "mbc.read"
            ],
            "defaultScopes": [
              "mbc.read",
              "mbc.expense.create"
            ],
            "oidcEnabled": false,
            "oidcScopesSupported": []
          }
        }
      }
    }
  }
}
