{
  "mcpServers": {
    "rivet": {
      "command": "node",
      "args": [
        "${PLUGIN_ROOT}/node_modules/rivet-design/bin/rivet.js",
        "mcp",
        "serve",
        "--caller-agent",
        "codex"
      ],
      "env": {
        "RIVET_PLUGIN_NAME": "rivet",
        "NODE_ENV": "production",
        "RIVET_AUTO_UPDATE_DISABLED": "1"
      },
      "type": "stdio"
    }
  },
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json"
}
