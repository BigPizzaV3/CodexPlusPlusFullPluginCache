{
  "name": "rivet-design",
  "version": "0.30.1",
  "description": "Rivet is a design agent for your coding agent. It explores dozens of design directions in parallel so you can pick the one that fits.",
  "main": "dist/index.js",
  "workspaces": [
    "src/ui",
    "src/proxy"
  ],
  "bin": {
    "rivet": "./bin/rivet.js"
  },
  "scripts": {
    "preinstall": "node scripts/verify-node-version.cjs",
    "build": "npm run clean && tsc && npm run build:assets && npm run build:ui && npm run build:bin",
    "build:assets": "mkdir -p dist/services/templates/designmd && cp src/services/templates/designmd/*.md dist/services/templates/designmd/",
    "build:ui": "cd src/ui && vite build && vite build --config vite.pages.config.ts && vite build --config vite.pages.config.ts --mode empty-project",
    "storybook:ui": "yarn workspace @rivet/ui storybook",
    "build-storybook:ui": "yarn workspace @rivet/ui build-storybook",
    "build:bin": "mkdir -p bin && cp src/bin-template.js bin/rivet.js && chmod +x bin/rivet.js",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc/typecheck.tsbuildinfo",
    "clean": "rm -rf dist src/ui/dist bin",
    "pack": "npm run build && npm pack",
    "pack:verify": "npm run pack && tar -tzf rivet-design-*.tgz | sort && echo '\n✓ Package contents listed above'",
    "prepublishOnly": "git rev-parse --abbrev-ref HEAD | grep -qx main || (echo 'ERROR: npm publish must be run from the main branch' && exit 1) && cp README.npm.md README.md && npm run build || (git checkout README.md && exit 1)",
    "postpublish": "git checkout README.md",
    "lint": "eslint . --ext ts,tsx,js,jsx --cache --cache-location node_modules/.cache/eslint/",
    "lint:fix": "yarn lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --max-old-space-size=4096 ./node_modules/jest/bin/jest.js --config src/jest.config.ts --silent",
    "test:node": "yarn test --selectProjects node --silent",
    "test:ui": "yarn test --selectProjects jsdom --silent",
    "test:e2e-helpers": "node --import tsx --test e2e/helpers/*.test.ts",
    "test:supabase": "node --import tsx --test supabase/functions/_shared/*.test.ts scripts/hosted-edge-logs.test.mjs",
    "test:install": "yarn build && node scripts/test-host-install.mjs",
    "rivet:channel": "tsx src/install/channelCli.ts",
    "test:watch": "jest --config src/jest.config.ts --watch",
    "test:coverage": "jest --config src/jest.config.ts --coverage",
    "deadcode": "knip --include files,dependencies,devDependencies",
    "deadcode:fix": "knip --fix",
    "prepare": "husky",
    "docs:sync": "node scripts/sync-external-docs.js",
    "deploy:supabase:functions": "bash scripts/deploy-supabase-functions.sh",
    "ratchet": "node scripts/ratchet.mts",
    "check:comments": "node scripts/code-comments.mjs --changed",
    "test:ratchet": "node --import tsx --test --test-concurrency=4 scripts/ratchet/*.test.ts scripts/semantic-colors.test.ts scripts/code-comments.test.mjs && python3 scripts/python-comments.test.py",
    "bench": "node --import tsx benchmarks/bench.ts",
    "bench:run": "node --import tsx benchmarks/runner.ts",
    "bench:compare": "node --import tsx benchmarks/compare.ts",
    "bench:review": "node --import tsx benchmarks/review/server.ts",
    "bench:review:hosted": "BENCH_REVIEW_HOSTED=true BENCH_REVIEW_OPEN=false node --import tsx benchmarks/review/server.ts --hosted",
    "bench:list": "node --import tsx benchmarks/list.ts",
    "bench:search-latency": "node --import tsx benchmarks/profileComparison/searchLatency.ts",
    "bench:test": "node --import tsx --test --test-reporter=dot benchmarks/*.test.ts benchmarks/agents/*.test.ts benchmarks/agents/prompts/*.test.ts benchmarks/review/*.test.ts",
    "bench:typecheck": "tsc -p benchmarks/tsconfig.json",
    "smoke:preview-dependencies": "node scripts/smoke-preview-dependencies.cjs",
    "smoke:plugin-telemetry": "node scripts/smoke-plugin-telemetry.mjs",
    "test:release-candidate": "node --test scripts/release-candidate.test.mjs",
    "release:review": "node scripts/release-review.mjs",
    "release:candidate": "node scripts/release-candidate-cli.mjs",
    "smoke:cli": "node scripts/smoke-cli.mjs && yarn test:plugin-runtime",
    "test:plugin-runtime": "node --test scripts/plugin-runtime.test.mjs scripts/plugin-telemetry.test.mjs",
    "test:source-maps": "node --test scripts/*source-maps*.test.mjs",
    "export:source-maps": "node scripts/export-source-maps.mjs",
    "smoke:runtime-upgrade": "node scripts/smoke-runtime-upgrade.mjs",
    "smoke:embedded-prototypes": "node --import tsx scripts/smoke-embedded-prototypes.mjs",
    "smoke:library-preview-origins": "node scripts/smoke-library-preview-origins.mjs",
    "perf:cli": "node scripts/bench-cli.mjs",
    "check:pre-commit": "yarn ratchet && npx lint-staged && yarn build && cd src/ui && yarn typecheck && cd ../.. && cd src/proxy && yarn build && cd ../..",
    "check:pre-push": "yarn test",
    "start:prototype-host": "node dist/prototype-host.js",
    "fix:comments": "node scripts/code-comments.mjs --write"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.0",
    "@sentry/node": "10.44.0",
    "ajv": "8.20.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "drizzle-orm": "1.0.0-rc.4",
    "express": "^5.2.1",
    "glob": "^14.0.2",
    "http-proxy-middleware": "^4.2.1",
    "js-yaml": "^5.5.0",
    "loglevel": "^1.9.2",
    "markdown-it": "^14.1.0",
    "open": "^8.4.0",
    "package-manager-detector": "^1.8.0",
    "parse5": "^8.1.0",
    "playwright-core": "^1.58.2",
    "posthog-node": "^5.52.4",
    "simple-git": "^4.0.2",
    "typescript": "^5.1.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.74.0",
    "@csstools/css-tokenizer": "^3.0.4",
    "@eslint/js": "^9.36.0",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/node": "4.3.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/express-serve-static-core": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/markdown-it": "^14.2.0",
    "@types/mvdan-sh": "^0",
    "@types/node": "^25.4.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^11.0.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.44.0",
    "@typescript-eslint/parser": "^8.44.0",
    "@typescript-eslint/typescript-estree": "^8.44.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "dockerfile-ast": "^0.7.1",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jest": "^30.1.3",
    "jest-environment-jsdom": "^30.2.0",
    "jiti": "^2.5.1",
    "knip": "^6.16.1",
    "lint-staged": "^16.1.6",
    "mvdan-sh": "0.10.1",
    "playwright": "^1.58.2",
    "postcss": "^8.4.32",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "supabase": "^2.47.2",
    "supertest": "^7.1.4",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^3.4.0",
    "ts-jest": "^29.4.4",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "vite": "^6.4.2",
    "ws": "^8.18.3",
    "yaml": "^2.8.1"
  },
  "files": [
    "dist/",
    "src/ui/dist/",
    "bin/",
    "!**/*.map",
    "scripts/verify-node-version.cjs",
    "README.npm.md"
  ],
  "keywords": [
    "design-agent",
    "coding-agent",
    "design-variants",
    "design-exploration",
    "mcp",
    "claude-code",
    "claude",
    "cursor",
    "codex",
    "design-tools",
    "frontend-development",
    "web-design"
  ],
  "author": "Rivet Design",
  "license": "GPL-3.0-or-later",
  "homepage": "https://rivet.design",
  "publishConfig": {
    "access": "public"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "useTabs": false,
    "semi": true,
    "singleQuote": true,
    "trailingComma": "all",
    "bracketSpacing": true,
    "arrowParens": "always",
    "plugins": [
      "prettier-plugin-tailwindcss"
    ]
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,css,scss,html}": [
      "prettier --write"
    ]
  },
  "packageManager": "yarn@4.12.0",
  "resolutions": {
    "nwsapi": "2.2.24"
  },
  "rivetPlugin": {
    "toolContract": "intent-v7"
  },
  "gitHead": "1d5785763f6f0b420f7e86e5e0fdc9da176d6298"
}
