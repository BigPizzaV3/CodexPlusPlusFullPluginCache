{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "spotsnow": {
      "type": "streamable-http",
      "url": "https://backend.spotsnow.io/mcp-pro",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "resource": "https://backend.spotsnow.io/mcp-pro",
            "baseScopes": [
              "mcp-pro"
            ]
          }
        }
      }
    }
  }
}
