{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:auditin72:evidence-input:1.0",
  "title": "AuditIn72 evidence input",
  "description": "Input schema only, not scored-output schema. CLI additionally enforces unique IDs, valid references, timezone ordering and dependency acyclicity.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "catalog_version": {
      "const": "1.0.0"
    },
    "audit": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "completed_at": {
          "type": "string",
          "format": "date-time"
        },
        "client_name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "illustrative": {
          "type": "boolean"
        },
        "context": {
          "type": "object",
          "properties": {
            "business_type": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "primary_conversion": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "geography": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "notes": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "scope": {
          "type": "object",
          "properties": {
            "mode": {
              "enum": [
                "single_page",
                "sampled",
                "crawl"
              ]
            },
            "pages": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "properties": {
                  "url": {
                    "type": "string",
                    "format": "uri",
                    "pattern": "^https?://"
                  },
                  "page_type": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  }
                },
                "required": [
                  "url"
                ],
                "additionalProperties": false
              }
            },
            "limitations": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "uniqueItems": true
            }
          },
          "required": [
            "mode",
            "pages",
            "limitations"
          ],
          "additionalProperties": false
        },
        "performance_notes": {
          "type": "object",
          "properties": {
            "field": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "lab": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "required": [
            "field",
            "lab"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "url",
        "started_at",
        "completed_at",
        "scope",
        "performance_notes"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$"
          },
          "url": {
            "anyOf": [
              {
                "type": "string",
                "format": "uri",
                "pattern": "^https?://"
              },
              {
                "type": "null"
              }
            ]
          },
          "source_label": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "method": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "captured_at": {
            "type": "string",
            "format": "date-time"
          },
          "observation": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "limitation": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "artifact": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "required": [
          "id",
          "url",
          "method",
          "captured_at",
          "observation"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "url": {
                  "type": "null"
                }
              }
            },
            "then": {
              "required": [
                "source_label"
              ]
            }
          }
        ]
      }
    },
    "checks": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "enum": [
              "technical_seo.crawl_index",
              "technical_seo.canonicals",
              "technical_seo.sitemaps",
              "technical_seo.internal_links",
              "technical_seo.structured_localization",
              "on_page_seo.titles",
              "on_page_seo.descriptions",
              "on_page_seo.headings",
              "on_page_seo.image_links",
              "on_page_seo.url_topic",
              "performance.field_cwv",
              "performance.lab_loading",
              "performance.assets",
              "performance.main_thread",
              "performance.delivery_stability",
              "accessibility.keyboard_focus",
              "accessibility.names_structure",
              "accessibility.contrast_zoom",
              "accessibility.forms_errors",
              "accessibility.media_motion",
              "ux_mobile.responsive",
              "ux_mobile.navigation",
              "ux_mobile.touch_readability",
              "ux_mobile.states_feedback",
              "ux_mobile.journey_consistency",
              "conversion.value_proposition",
              "conversion.primary_cta",
              "conversion.trust",
              "conversion.funnel_friction",
              "conversion.measurement",
              "security.https",
              "security.headers",
              "security.mixed_content",
              "security.cookies_forms",
              "security.exposure_errors",
              "content.usefulness",
              "content.accuracy",
              "content.clarity",
              "content.freshness",
              "content.originality_depth"
            ]
          },
          "status": {
            "enum": [
              "pass",
              "partial",
              "fail",
              "not_tested",
              "na"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "uniqueItems": true
          },
          "notes": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "na_reason": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "required": [
          "id",
          "status",
          "evidence_ids"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "enum": [
                    "pass",
                    "partial",
                    "fail",
                    "na"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "evidence_ids": {
                  "minItems": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "na"
                }
              }
            },
            "then": {
              "required": [
                "na_reason"
              ]
            },
            "else": {
              "not": {
                "required": [
                  "na_reason"
                ]
              }
            }
          }
        ]
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "category": {
            "enum": [
              "technical_seo",
              "on_page_seo",
              "performance",
              "accessibility",
              "ux_mobile",
              "conversion",
              "security",
              "content"
            ]
          },
          "check_ids": {
            "type": "array",
            "items": {
              "enum": [
                "technical_seo.crawl_index",
                "technical_seo.canonicals",
                "technical_seo.sitemaps",
                "technical_seo.internal_links",
                "technical_seo.structured_localization",
                "on_page_seo.titles",
                "on_page_seo.descriptions",
                "on_page_seo.headings",
                "on_page_seo.image_links",
                "on_page_seo.url_topic",
                "performance.field_cwv",
                "performance.lab_loading",
                "performance.assets",
                "performance.main_thread",
                "performance.delivery_stability",
                "accessibility.keyboard_focus",
                "accessibility.names_structure",
                "accessibility.contrast_zoom",
                "accessibility.forms_errors",
                "accessibility.media_motion",
                "ux_mobile.responsive",
                "ux_mobile.navigation",
                "ux_mobile.touch_readability",
                "ux_mobile.states_feedback",
                "ux_mobile.journey_consistency",
                "conversion.value_proposition",
                "conversion.primary_cta",
                "conversion.trust",
                "conversion.funnel_friction",
                "conversion.measurement",
                "security.https",
                "security.headers",
                "security.mixed_content",
                "security.cookies_forms",
                "security.exposure_errors",
                "content.usefulness",
                "content.accuracy",
                "content.clarity",
                "content.freshness",
                "content.originality_depth"
              ]
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "severity": {
            "enum": [
              "critical",
              "high",
              "medium",
              "low",
              "info"
            ]
          },
          "kind": {
            "enum": [
              "observed",
              "hypothesis",
              "needs_verification"
            ]
          },
          "impact": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "reach": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "effort_hours": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "uniqueItems": true
          },
          "remediation": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "validation": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "owner_role": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "title",
          "category",
          "check_ids",
          "severity",
          "kind",
          "impact",
          "reach",
          "effort_hours",
          "confidence",
          "evidence_ids",
          "remediation",
          "validation",
          "owner_role",
          "dependencies"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "observed"
                }
              }
            },
            "then": {
              "properties": {
                "evidence_ids": {
                  "minItems": 1
                }
              }
            }
          }
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "catalog_version",
    "audit",
    "evidence",
    "checks",
    "findings"
  ],
  "additionalProperties": false
}
