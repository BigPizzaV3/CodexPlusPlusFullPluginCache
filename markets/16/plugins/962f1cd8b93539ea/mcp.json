{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "proclipper": {
      "type": "streamable-http",
      "url": "https://proclipper.app/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": { "mode": "dcr" },
            "authorizationUrl": "https://proclipper.app/oauth/authorize",
            "tokenUrl": "https://proclipper.app/oauth/token",
            "registrationUrl": "https://proclipper.app/oauth/register",
            "resource": "https://proclipper.app/mcp",
            "baseScopes": ["transcripts:read", "transcripts:write"]
          }
        }
      }
    }
  }
}
