{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "rentalbench": {
      "type": "streamable-http",
      "url": "https://app.rentalbench.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "rentalbench-chatgpt",
              "tokenEndpointAuthMethod": "none"
            },
            "baseScopes": ["rentalbench:read"],
            "defaultScopes": ["rentalbench:read", "rentalbench:write"]
          }
        }
      }
    }
  }
}
