{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "photo2skin": {
      "type": "streamable-http",
      "url": "https://mcp.photo2skin.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": { "mode": "dcr" },
            "baseScopes": ["skins:read", "skins:generate", "maps:generate", "builds:generate", "library:write", "billing:read"]
          }
        }
      }
    }
  }
}
