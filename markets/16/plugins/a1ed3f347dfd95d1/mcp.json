{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "coachgrow": {
      "type": "streamable-http",
      "url": "https://coachos-api.teachme.to/v1/coachgrow/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "cimd"
            },
            "baseScopes": [
              "coachgrow.read",
              "coachgrow.write"
            ]
          }
        }
      }
    }
  }
}
