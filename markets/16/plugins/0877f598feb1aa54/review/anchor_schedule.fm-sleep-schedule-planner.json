{
  "format": "firemoon-life/v2",
  "plugin": "sleep-schedule-planner",
  "version": "0.3.2",
  "operation": "anchor_schedule",
  "input": {
    "opportunity_hours": 8,
    "wind_down_min": 30,
    "days": [
      {
        "day": "Monday",
        "wake": "07:00"
      },
      {
        "day": "Tuesday",
        "wake": "06:30"
      }
    ]
  },
  "output": {
    "schedule": [
      {
        "day": "Night before Monday",
        "start": "23:00",
        "finish": "07:00",
        "activity": "Sleep opportunity",
        "wind_down": "22:30"
      },
      {
        "day": "Night before Tuesday",
        "start": "22:30",
        "finish": "06:30",
        "activity": "Sleep opportunity",
        "wind_down": "22:00"
      }
    ],
    "note": "Local clock arithmetic using your chosen duration, not estimated sleep or treatment. Night before refers to the selected wake day."
  }
}