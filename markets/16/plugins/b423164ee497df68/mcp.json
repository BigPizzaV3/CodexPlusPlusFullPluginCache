{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "paprika_hosted": {
      "type": "streamable-http",
      "url": "https://paprika-demo.benebsworth.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": [
              "paprika:read"
            ],
            "defaultScopes": [
              "paprika:read"
            ]
          },
          "urlTemplates": [
            "https://{hostname}/mcp"
          ]
        }
      }
    }
  }
}
