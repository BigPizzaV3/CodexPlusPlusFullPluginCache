{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "logistify-unleashed": {
      "type": "streamable-http",
      "url": "https://mcp.logistify.ai/unleashed/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": ["unleashed.read", "offline_access"]
          }
        }
      }
    }
  }
}
