{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "dx-ai": {
      "type": "streamable-http",
      "url": "https://dx.dxca.tech/api/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "mixed",
            "client": {
              "mode": "cimd"
            },
            "defaultScopes": [
              "content:read",
              "knowledge:read",
              "agents:invoke",
              "conversations:read",
              "leads:read",
              "leads:write",
              "pipeline:read",
              "pipeline:write",
              "crm:read",
              "crm:write",
              "workflow:read"
            ]
          }
        }
      }
    }
  }
}
