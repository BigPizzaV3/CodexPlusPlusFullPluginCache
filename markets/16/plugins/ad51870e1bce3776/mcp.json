{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "workouter": {
      "type": "streamable-http",
      "url": "https://workouter.co/api/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "cimd"
            },
            "baseScopes": [
              "read:user",
              "read:workouts"
            ],
            "defaultScopes": [
              "read:user",
              "read:workouts",
              "write:workouts",
              "send:workout-links"
            ]
          }
        }
      }
    }
  }
}
