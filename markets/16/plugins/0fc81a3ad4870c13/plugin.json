{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "author": {
    "name": "AI EmpowerHub"
  },
  "description": "Grants, proposals & compliance",
  "extensions": {
    "com.openai": {
      "interface": {
        "capabilities": [
          "Interactive"
        ],
        "category": "Business & Operations",
        "composerIcon": "./assets/grant-writing.png",
        "defaultPrompt": [
          "Analyze this grant opportunity and tell me whether I appear eligible.",
          "Turn this NOFO into a compliance checklist and proposal outline.",
          "Review my grant draft against the scoring criteria."
        ],
        "developerName": "AI EmpowerHub",
        "displayName": "Grant Writing - AI EHub",
        "logo": "./assets/grant-writing.png",
        "longDescription": "Client-facing grant analysis, drafting, compliance, and review guidance with specialty-specific guidance, privacy boundaries, mentor handoffs, and routing to complementary business tools.",
        "privacyPolicyURL": "https://ai-empowerhub.johnmtrenaryicloud-com.chatgpt.site/privacy/",
        "shortDescription": "Grants, proposals & compliance",
        "supportURL": "https://ai-empowerhub.johnmtrenaryicloud-com.chatgpt.site/support/",
        "termsOfServiceURL": "https://ai-empowerhub.johnmtrenaryicloud-com.chatgpt.site/terms/",
        "websiteURL": "https://ai-empowerhub.johnmtrenaryicloud-com.chatgpt.site/plugins/"
      }
    }
  },
  "name": "grant-writing-assistant-client-pilot",
  "version": "1.0.8"
}
