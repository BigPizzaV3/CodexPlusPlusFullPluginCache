{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Contrato interno para auditoria de VRA preenchida (MPGO)",
  "description": "Estrutura do cotejo de respostas originais; não gera nem altera VRA, não valida veracidade material.",
  "type": "object",
  "required": [
    "process_id",
    "vra_title",
    "cutoff_at",
    "cutoff_source",
    "decision",
    "executive_summary",
    "scope",
    "coverage_statement",
    "conclusion",
    "expected_items_count",
    "items",
    "sources",
    "source_inventory",
    "absence_claims"
  ],
  "properties": {
    "process_id": {
      "type": "string",
      "minLength": 1
    },
    "vra_title": {
      "type": "string",
      "minLength": 1
    },
    "cutoff_at": {
      "type": "string",
      "minLength": 10
    },
    "cutoff_source": {
      "type": "string",
      "minLength": 1
    },
    "decision": {
      "enum": [
        "APROVACAO_DOCUMENTAL",
        "NECESSIDADE_DE_CORRECOES",
        "IMPEDIMENTO_TECNICO"
      ]
    },
    "executive_summary": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "coverage_statement": {
      "type": "string",
      "minLength": 1
    },
    "conclusion": {
      "type": "string",
      "minLength": 1
    },
    "expected_items_count": {
      "type": "integer",
      "minimum": 0
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "item_id",
          "item_text",
          "declared_references",
          "vra_item_locator",
          "answer_raw",
          "material_status",
          "filling_status",
          "rationale",
          "evidence"
        ],
        "properties": {
          "vra_item_locator": {
            "type": "string",
            "minLength": 1
          },
          "answer_raw": {
            "type": "string",
            "description": "Resposta literal da VRA original; string vazia para campo realmente em branco."
          },
          "declared_references": {
            "type": [
              "string",
              "array"
            ],
            "description": "Referências originalmente registradas; caso ausentes utilizar Não indicada ou lista vazia."
          },
          "original_justification": {
            "type": "string",
            "description": "Observação original, sem correção criada pela IA."
          }
        }
      }
    },
    "findings": {
      "type": "array"
    },
    "sources": {
      "type": "array"
    },
    "material_gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "coverage_blocked": {
      "type": "boolean"
    },
    "technical_block": {
      "type": "string"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_inventory": {
      "type": "object",
      "description": "Índice real de páginas e movimentos efetivamente abertos, e inspeção temporal",
      "required": [
        "total_pages",
        "max_movement_number",
        "movements",
        "reviewed_page_ranges",
        "image_only_pages",
        "visually_inspected_pages",
        "visual_detection_method",
        "pdf_pages_observed",
        "page_count_provenance",
        "first_middle_last_samples",
        "access_proof"
      ],
      "properties": {
        "total_pages": {
          "type": "integer",
          "minimum": 1
        },
        "max_movement_number": {
          "type": "integer",
          "minimum": 1
        },
        "corpus_incomplete": {
          "type": "boolean"
        },
        "movements": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "number",
              "page_start",
              "page_end",
              "joined_at",
              "temporal_status",
              "review_status",
              "review_note"
            ],
            "properties": {
              "number": {
                "type": "integer",
                "minimum": 1
              },
              "page_start": {
                "type": "integer",
                "minimum": 1
              },
              "page_end": {
                "type": "integer",
                "minimum": 1
              },
              "joined_at": {
                "type": "string"
              },
              "temporal_status": {
                "enum": [
                  "ELIGIBLE",
                  "EXCLUDED_AFTER_CUTOFF"
                ]
              },
              "review_status": {
                "enum": [
                  "REVIEWED",
                  "PARTIAL",
                  "NOT_REVIEWED",
                  "EXCLUDED"
                ]
              },
              "review_note": {
                "type": "string"
              }
            }
          }
        },
        "reviewed_page_ranges": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "image_only_pages": {
          "type": "array",
          "items": {
            "type": [
              "integer",
              "string"
            ]
          },
          "description": "Páginas image-backed relevantes detectadas durante a inspeção, mesmo sem OCR pesquisável."
        },
        "visually_inspected_pages": {
          "type": "array",
          "items": {
            "type": [
              "integer",
              "string"
            ]
          },
          "description": "Páginas efetivamente inspecionadas visualmente para confirmar documentos relevantes."
        },
        "visual_detection_method": {
          "type": "string",
          "minLength": 10,
          "description": "Procedimento usado para localizar páginas sem texto pesquisável e estabelecer necessidade de inspeção visual; execução não presumida."
        },
        "pdf_pages_observed": {
          "type": "integer",
          "minimum": 1,
          "description": "Medição observável; não substituir pelo número das páginas que o modelo diz ter lido"
        },
        "page_count_provenance": {
          "type": "string",
          "minLength": 10
        },
        "first_middle_last_samples": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "access_proof": {
          "type": "string",
          "minLength": 10
        },
        "source_pdf_sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$",
          "description": "Hash SHA-256 do PDF integral dos autos, comparável por --autos; nunca alegar verificado sem arquivo real."
        },
        "unassigned_page_ranges": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "string"
              }
            ]
          },
          "description": "Páginas físicas não incluídas na paginação dos movimentos, explicitamente conciliadas no P0."
        },
        "unassigned_pages_note": {
          "type": "string",
          "minLength": 1,
          "description": "Fundamentação de por que as páginas não vinculadas a movimentos não foram omitidas."
        }
      }
    },
    "absence_claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "item_id",
          "document_type",
          "searched_movement_ids",
          "searched_page_ranges",
          "search_methods",
          "counterevidence_review",
          "conclusion"
        ],
        "properties": {
          "item_id": {
            "type": "string"
          },
          "document_type": {
            "type": "string"
          },
          "searched_movement_ids": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "searched_page_ranges": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "search_methods": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "counterevidence_review": {
            "type": "string"
          },
          "conclusion": {
            "type": "string"
          }
        }
      }
    },
    "corpus_manifest": {
      "type": [
        "object",
        "null"
      ],
      "description": "Manifesto opcional de partes; não comprova leitura no Gemini",
      "properties": {
        "schema": {
          "type": "string"
        },
        "origin": {
          "type": "object"
        },
        "parts": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "chunk_receipts": {
      "type": "array",
      "description": "Partes materialmente recebidas e verificadas no runtime, não inferidas",
      "items": {
        "type": "object"
      }
    },
    "pages_actually_inspected": {
      "type": "array",
      "description": "Referências de páginas realmente abertas/inspecionadas",
      "items": {
        "type": "object"
      }
    },
    "vra_pdf_sha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$",
      "description": "Hash opcional do arquivo original da VRA já preenchida (vincula versão auditada)."
    }
  }
}
