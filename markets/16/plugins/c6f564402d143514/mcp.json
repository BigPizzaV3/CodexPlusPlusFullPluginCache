{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "rep-ai": {
      "type": "streamable-http",
      "url": "https://mcp.hellorep.ai/mcp/v1",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "cimd"
            },
            "baseScopes": [
              "analytics.read",
              "tickets.read",
              "messages.read",
              "customers.read",
              "support.read"
            ],
            "defaultScopes": [
              "analytics.read",
              "tickets.read",
              "messages.read",
              "customers.read",
              "support.read",
              "instructions.write",
              "faqs.write",
              "skills.write"
            ]
          }
        }
      }
    }
  }
}
