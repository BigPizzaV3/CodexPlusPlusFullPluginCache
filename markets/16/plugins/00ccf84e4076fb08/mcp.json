{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "resumeforu": {
      "type": "streamable-http",
      "url": "https://resumeforu.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "fh1384zamppgm7s8biar7",
              "tokenEndpointAuthMethod": "client_secret_basic"
            },
            "resource": "https://resumeforu.com/mcp",
            "baseScopes": ["openid", "profile", "email", "offline_access"],
            "defaultScopes": ["resumes:read", "resumes:write", "resumes:export"]
          }
        }
      }
    }
  }
}
