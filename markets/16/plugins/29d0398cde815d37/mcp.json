{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "urbanloop": {
      "type": "streamable-http",
      "url": "https://api.urbanloop.ai/agent/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "urbanloop-chatgpt",
              "tokenEndpointAuthMethod": "none"
            },
            "authorizationUrl": "https://api.urbanloop.ai/agent/oauth/authorize",
            "tokenUrl": "https://api.urbanloop.ai/agent/oauth/token",
            "resource": "https://api.urbanloop.ai/agent/mcp",
            "defaultScopes": [
              "screens:read",
              "content:read",
              "content:write",
              "screens:publish",
              "screens:write",
              "library:read",
              "library:write"
            ]
          }
        }
      }
    }
  }
}
