{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "quiverquant": {
      "type": "streamable-http",
      "url": "https://mcp.quiverquant.com/",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": { "mode": "cimd" },
            "baseScopes": ["openid", "email", "offline_access"]
          }
        }
      }
    }
  }
}
