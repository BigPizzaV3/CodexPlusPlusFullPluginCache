{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "alfer": {
      "type": "streamable-http",
      "url": "https://mcp.alfer.pe/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "authorizationUrl": "https://mcp.alfer.pe/authorize",
            "tokenUrl": "https://mcp.alfer.pe/token",
            "registrationUrl": "https://mcp.alfer.pe/register",
            "resource": "https://mcp.alfer.pe/mcp",
            "baseScopes": ["alfer:leer", "alfer:escribir", "offline_access"]
          }
        }
      }
    }
  }
}
