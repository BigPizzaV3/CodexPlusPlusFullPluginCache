{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "dashio": {
      "type": "streamable-http",
      "url": "https://app.dashio.net/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "resource": "https://app.dashio.net/mcp",
            "client": {
              "mode": "provided",
              "clientId": "dashio-chatgpt",
              "tokenEndpointAuthMethod": "none"
            },
            "baseScopes": [
              "space:read"
            ],
            "defaultScopes": []
          }
        }
      }
    }
  }
}
