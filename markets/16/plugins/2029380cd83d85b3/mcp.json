{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "paramark": {
      "type": "streamable-http",
      "url": "https://api.paramark.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": { "mode": "dcr" },
            "resource": "https://api.paramark.com/mcp",
            "authorizationServerBase": "https://signin.paramark.com",
            "authorizationUrl": "https://signin.paramark.com/oauth2/authorize",
            "tokenUrl": "https://signin.paramark.com/oauth2/token",
            "registrationUrl": "https://signin.paramark.com/oauth2/register"
          }
        }
      }
    }
  }
}
