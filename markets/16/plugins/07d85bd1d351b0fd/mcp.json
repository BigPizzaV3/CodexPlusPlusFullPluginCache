{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "chatigram": {
      "type": "streamable-http",
      "url": "https://app.chatigram.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "PSMHVORUoZ4M6gZN"
            },
            "baseScopes": [
              "workflows:read"
            ],
            "defaultScopes": [
              "workflows:read",
              "workflows:write",
              "organization:capabilities",
              "connections:read",
              "lines:read",
              "offline_access",
              "events:subscribe"
            ],
            "oidcEnabled": false
          }
        }
      }
    }
  }
}
