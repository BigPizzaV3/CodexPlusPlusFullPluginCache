{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "autodm": {
      "type": "streamable-http",
      "url": "https://api.autodm.live/mcp/stream",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": { "mode": "dcr" },
            "baseScopes": ["mcp"]
          }
        }
      }
    }
  }
}
