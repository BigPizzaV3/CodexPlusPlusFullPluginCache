                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Validation or processing error"
          }
        }
      }
    },
    "/api/mcp/tools/redact_pdf": {
      "post": {
        "summary": "Permanently redact and black out sensitive keywords, names, or regex patterns from a PDF.",
        "operationId": "redact_pdf",
        "description": "Permanently redact and black out sensitive keywords, names, or regex patterns from a PDF.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "file_url": {
                    "type": "string",
                    "description": "Direct URL of the PDF file."
                  },
                  "patterns": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Words, phrases, or numbers to black out permanently."
                  }
                },
                "required": [
                  "file_url",
                  "patterns"
