{
  "openapi": "3.1.0",
  "info": {
    "title": "KodaPDF Document Suite API",
    "description": "Headless tools for document manipulation: conversion, compression, merging, splitting, protection, redaction, OCR, summarization, and translation.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://kodapdf.com",
      "description": "Production Server"
    }
  ],
  "paths": {
    "/api/mcp/tools/convert_document": {
      "post": {
        "summary": "Convert documents between formats (Word to PDF, PDF to Word, Excel to PDF, PowerPoint to PDF, Images to PDF, etc.).",
        "operationId": "convert_document",
        "description": "Convert documents between formats (Word to PDF, PDF to Word, Excel to PDF, PowerPoint to PDF, Images to PDF, etc.).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "file_url": {
                    "type": "string",
                    "description": "Direct public URL of the document to convert."
                  },
                  "target_format": {
                    "type": "string",
                    "description": "Target output format (e.g. 'pdf', 'docx', 'xlsx', 'pptx', 'jpg', 'png', 'txt')."
                  },
                  "source_format": {
                    "type": "string",
                    "description": "Optional source format. If omitted, inferred from the file URL."
                  }
                },
                "required": [
                  "file_url",
                  "target_format"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Operation queued or completed successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "result": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Validation or processing error"
          }
        }
      }
    },
    "/api/mcp/tools/compress_pdf": {
      "post": {
        "summary": "Reduce PDF file size while preserving high visual quality for web, email, or archiving.",
        "operationId": "compress_pdf",
        "description": "Reduce PDF file size while preserving high visual quality for web, email, or archiving.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "file_url": {
                    "type": "string",
                    "description": "Direct URL of the PDF file to compress."
                  },
                  "level": {
                    "type": "string",
                    "enum": [
                      "recommended",
                      "extreme",
                      "low"
                    ],
                    "description": "Compression intensity (default is 'recommended')."
                  }
                },
                "required": [
                  "file_url"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Operation queued or completed successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "result": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Validation or processing error"
          }
        }
      }
    },
    "/api/mcp/tools/merge_pdfs": {
      "post": {
        "summary": "Merge multiple PDF documents sequentially into a single consolidated PDF.",
        "operationId": "merge_pdfs",
        "description": "Merge multiple PDF documents sequentially into a single consolidated PDF.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "file_urls": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "List of direct PDF URLs to merge in order (minimum 2 files)."
                  },
                  "output_file_name": {
                    "type": "string",
                    "description": "Optional name for the merged output file (e.g. 'Report.pdf')."
                  }
                },
                "required": [
                  "file_urls"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Operation queued or completed successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "result": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Validation or processing error"
          }
        }
      }
    },
    "/api/mcp/tools/split_pdf": {
      "post": {
        "summary": "Extract specific pages or page ranges from a PDF document into a new PDF.",
        "operationId": "split_pdf",
        "description": "Extract specific pages or page ranges from a PDF document into a new PDF.",
        "requestBody": {
          "required": true,
