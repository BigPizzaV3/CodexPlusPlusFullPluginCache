    "/api/mcp/tools/add_page_numbers": {
      "post": {
        "summary": "Insert clear page numbering across all pages of a PDF document.",
        "operationId": "add_page_numbers",
        "description": "Insert clear page numbering across all pages of a PDF document.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "file_url": {
                    "type": "string",
                    "description": "Direct URL of the PDF file."
                  },
                  "position": {
                    "type": "string",
                    "enum": [
                      "bottom-center",
                      "bottom-right",
                      "bottom-left",
                      "top-center",
                      "top-right",
                      "top-left"
                    ],
                    "description": "Position on the page."
                  },
                  "start_number": {
                    "type": "integer",
                    "description": "Starting page number (default 1)."
                  }
                },
                "required": [
                  "file_url"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Operation queued or completed successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "result": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Validation or processing error"
          }
        }
      }
    },
    "/api/mcp/tools/add_watermark": {
      "post": {
        "summary": "Stamp a customized text watermark across all pages of a PDF.",
        "operationId": "add_watermark",
        "description": "Stamp a customized text watermark across all pages of a PDF.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "file_url": {
                    "type": "string",
                    "description": "Direct URL of the PDF file."
                  },
                  "text": {
                    "type": "string",
                    "description": "Watermark text (e.g. 'CONFIDENTIAL', 'DRAFT', or company name)."
                  },
                  "opacity": {
                    "type": "number",
                    "description": "Watermark opacity from 0.1 to 1.0 (default 0.3)."
                  }
                },
                "required": [
                  "file_url",
                  "text"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Operation queued or completed successfully",
