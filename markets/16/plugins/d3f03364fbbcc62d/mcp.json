{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "contractoros": {
      "type": "streamable-http",
      "url": "https://contractor.frontlineos.dev/api/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": [
              "offline_access",
              "jobs:read",
              "jobs:write",
              "evidence:read",
              "evidence:write"
            ]
          }
        }
      }
    }
  }
}
