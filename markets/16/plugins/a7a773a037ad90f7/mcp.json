{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "vedeo": {
      "type": "streamable-http",
      "url": "https://vedeo.org/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "cimd"
            },
            "resource": "https://vedeo.org/mcp",
            "defaultScopes": [
              "account:read",
              "videos:read",
              "videos:create"
            ]
          }
        }
      }
    }
  }
}
