{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "pbjconnect": {
      "type": "streamable-http",
      "url": "https://pbjconnect.com/api/integrations/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": { "mode": "dcr" },
            "authorizationServerBase": "https://pbjconnect.com/api/integrations/oauth",
            "resource": "https://pbjconnect.com/api/integrations/mcp",
            "baseScopes": ["pbj.read", "offline_access"],
            "oidcEnabled": false
          }
        }
      }
    }
  }
}
