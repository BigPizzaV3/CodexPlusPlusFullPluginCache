{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "postcaly": {
      "type": "streamable-http",
      "url": "https://app.postcaly.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": { "mode": "dcr" },
            "baseScopes": ["posts:read", "posts:write", "posts:schedule", "media:read", "media:write", "channels:read"]
          }
        }
      }
    }
  }
}
