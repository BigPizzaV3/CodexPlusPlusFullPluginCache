{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "oasislms-nexus": {
      "type": "streamable-http",
      "url": "https://mcp.oasis-lms.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "oasis-mcp",
              "tokenEndpointAuthMethod": "client_secret_basic"
            },
            "authorizationUrl": "https://mcp.oasis-lms.com/oauth/authorize",
            "tokenUrl": "https://mcp.oasis-lms.com/oauth/token",
            "baseScopes": ["mcp", "offline_access"]
          }
        }
      }
    }
  }
}
