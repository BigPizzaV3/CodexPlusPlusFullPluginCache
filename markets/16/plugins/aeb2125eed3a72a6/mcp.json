{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "parcellab": {
      "type": "streamable-http",
      "url": "https://agents.parcellab.com/admin/mcp/",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": [
              "openid",
              "profile",
              "email",
              "accounts",
              "groups",
              "roles",
              "offline_access",
              "mcp",
              "mcp:full"
            ]
          }
        }
      }
    }
  }
}
