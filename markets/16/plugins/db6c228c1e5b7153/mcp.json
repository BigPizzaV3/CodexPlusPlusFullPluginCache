{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "salary-game": {
      "type": "streamable-http",
      "url": "https://game.workopia.io/api/mcp-salary-game",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "authorizationServerBase": "https://workopia.io",
            "authorizationUrl": "https://workopia.io/oauth/authorize",
            "tokenUrl": "https://workopia.io/api/oauth/token",
            "registrationUrl": "https://workopia.io/api/oauth/register",
            "resource": "https://game.workopia.io/api/mcp-salary-game",
            "baseScopes": [
              "salary:play"
            ],
            "defaultScopes": [
              "salary:play"
            ]
          }
        }
      }
    }
  }
}
