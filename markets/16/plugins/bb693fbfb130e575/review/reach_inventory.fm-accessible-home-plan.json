{
  "format": "firemoon-life/v2",
  "plugin": "accessible-home-plan",
  "version": "0.3.0",
  "operation": "reach_inventory",
  "input": {
    "minimum_cm": 40,
    "maximum_cm": 120,
    "locations": [
      {
        "name": "Drawer",
        "height_cm": 60
      },
      {
        "name": "High shelf",
        "height_cm": 170
      }
    ]
  },
  "output": {
    "locations": [
      {
        "name": "Drawer",
        "height_cm": 60,
        "within_chosen_range": true
      },
      {
        "name": "High shelf",
        "height_cm": 170,
        "within_chosen_range": false
      }
    ],
    "note": "Personal range comparison; depth, approach and individual needs require separate assessment."
  }
}