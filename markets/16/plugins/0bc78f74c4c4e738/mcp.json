{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "bazaaron": {
      "type": "streamable-http",
      "url": "https://bazaaron.ai/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": { "mode": "dcr" },
            "registrationUrl": "https://bazaaron.ai/oauth/register",
            "authorizationUrl": "https://bazaaron.ai/oauth/authorize",
            "tokenUrl": "https://bazaaron.ai/oauth/token",
            "baseScopes": ["shop"]
          }
        }
      }
    }
  }
}
