{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "campo-santo": {
      "type": "streamable-http",
      "url": "https://camposantoelparaiso.com/api/asesores-mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "registrationUrl": "https://camposantoelparaiso.com/api/asesores-oauth/register",
            "authorizationServerBase": "https://camposantoelparaiso.com/api/asesores-oauth",
            "resource": "https://camposantoelparaiso.com/api/asesores-mcp",
            "baseScopes": ["portal:read"]
          }
        }
      }
    }
  }
}
