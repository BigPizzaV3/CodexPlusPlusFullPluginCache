{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "farside": {
      "type": "streamable-http",
      "url": "https://api.farsideresearch.com/mcp/",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "cimd"
            },
            "baseScopes": ["read", "run"]
          }
        }
      }
    }
  }
}
