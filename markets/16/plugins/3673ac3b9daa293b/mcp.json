      "type": "streamable-http",
      "url": "https://permits.owliesays.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "mixed",
            "client": {
              "mode": "cimd"
            },
            "defaultScopes": [
              "projects:read"
            ]
          }
        }
      }
    }
  }
}
