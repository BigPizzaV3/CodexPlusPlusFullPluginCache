{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ObjectDTO structural contract",
  "description": "Generated from all reachable TypeScript DTO fields. Opaque bags are identified; this is not an import, safety, or visual acceptance verdict.",
  "$ref": "#/definitions/ObjectDTO",
  "definitions": {
    "ObjectDTO": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Local ID inside template (will be remapped on apply)"
        },
        "type": {
          "enum": [
            "image",
            "text",
            "svg",
            "shape",
            "group",
            "drawing",
            "video",
            "videoEmbed",
            "svgPath",
            "smartLine",
            "smartArrow",
            "procedural"
          ]
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "width": {
          "anyOf": [
            {
              "type": "number"
            }
          ]
        },
        "height": {
          "anyOf": [
            {
              "type": "number"
            }
          ]
        },
        "textBoxSizing": {
          "enum": [
            "auto-content",
            "fixed"
          ],
          "description": "Portable native Text box policy; absent legacy values remain fixed."
        },
        "rotation": {
          "anyOf": [
            {
              "type": "number"
            }
          ]
        },
        "props": {
          "$ref": "#/definitions/Record",
          "description": "Flexible props bag (v1); v2 should tighten per type"
        },
        "connector": {
          "anyOf": [
            {
              "$ref": "#/definitions/SmartConnectorMetadata"
            }
          ]
        },
        "anchorBinding": {
          "anyOf": [
            {
              "$ref": "#/definitions/AnchorBinding"
            }
          ]
        },
        "clipBinding": {
          "anyOf": [
            {
              "$ref": "#/definitions/ClipBinding"
            }
          ]
        },
        "visualEffects": {
          "anyOf": [
            {
              "$ref": "#/definitions/VisualEffectsV1"
            }
          ]
        },
        "kineticText": {
          "anyOf": [
            {
              "$ref": "#/definitions/KineticTextBinding"
            }
          ]
        },
        "pathMorph": {
          "anyOf": [
            {
              "$ref": "#/definitions/PathMorphBinding"
            }
          ]
        },
        "locked": {
          "enum": [
            false,
            true
          ]
        },
        "visible": {
          "enum": [
            false,
            true
          ]
        },
        "zIndex": {
          "anyOf": [
            {
              "type": "number"
            }
          ]
        },
        "styleRefs": {
          "anyOf": [
            {
              "$ref": "#/definitions/ObjectStyleRefs"
            }
          ]
        },
        "animationStart": {
          "anyOf": [
            {
              "type": "number"
            }
          ],
          "description": "Animation settings (v1 units: milliseconds; runtime converts to seconds)"
        },
        "animationDuration": {
          "anyOf": [
            {
              "type": "number"
            }
          ]
        },
        "timing": {
          "anyOf": [
            {
              "$ref": "#/definitions/SceneObjectVisibleRangeTiming"
            }
          ],
          "description": "Optional scene-local visible range, in milliseconds. Visual-only in Phase 1."
        },
        "animationType": {
          "enum": [
            "none",
            "fadeIn",
            "slideIn",
            "scaleIn",
            "drawIn",
            "pathFollow",
            "typewriter"
          ]
        },
        "animationEasing": {
          "enum": [
            "linear",
            "easeIn",
            "easeOut",
            "easeInOut"
          ]
        }
      },
      "required": [
        "id",
        "type",
        "x",
        "y",
        "props"
      ],
      "additionalProperties": false
    },
    "Record": {
      "type": "object",
      "properties": {},
      "additionalProperties": {
        "description": "Opaque unknown data; runtime validation remains authoritative."
      }
    },
    "SmartConnectorMetadata": {
      "type": "object",
      "properties": {
        "start": {
          "anyOf": [
            {
              "$ref": "#/definitions/SmartConnectorEndpointAttachment"
            }
          ]
        },
        "end": {
          "anyOf": [
            {
              "$ref": "#/definitions/SmartConnectorEndpointAttachment"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "SmartConnectorEndpointAttachment": {
      "type": "object",
      "properties": {
        "targetObjectId": {
          "type": "string"
        },
        "anchor": {
          "enum": [
            "auto",
            "top",
            "right",
            "bottom",
            "left",
            "center"
          ]
        }
      },
      "required": [
        "targetObjectId",
        "anchor"
      ],
      "additionalProperties": false
    },
    "AnchorBinding": {
      "type": "object",
      "properties": {
        "sourceObjectId": {
          "type": "string"
        },
        "sourceAnchor": {
          "enum": [
            "center",
            "top-left",
            "top-center",
            "top-right",
            "center-left",
            "center-right",
            "bottom-left",
            "bottom-center",
            "bottom-right"
          ]
        },
        "targetAnchor": {
          "enum": [
            "center",
            "top-left",
            "top-center",
            "top-right",
            "center-left",
            "center-right",
            "bottom-left",
            "bottom-center",
            "bottom-right"
          ]
        },
        "offsetX": {
          "type": "number"
        },
        "offsetY": {
          "type": "number"
        }
      },
      "required": [
        "sourceObjectId",
        "sourceAnchor",
        "targetAnchor",
        "offsetX",
        "offsetY"
      ],
      "additionalProperties": false
    },
    "ClipBinding": {
      "type": "object",
      "properties": {
        "sourceObjectId": {
          "type": "string"
        },
        "mode": {
          "type": "string",
          "const": "inside"
        }
      },
      "required": [
        "sourceObjectId",
        "mode"
      ],
      "additionalProperties": false
    },
    "VisualEffectsV1": {
      "type": "object",
      "properties": {
        "blur": {
          "anyOf": [
            {
              "type": "number"
            }
          ]
        },
        "brightness": {
          "anyOf": [
            {
              "type": "number"
            }
          ]
        },
        "contrast": {
          "anyOf": [
            {
              "type": "number"
            }
          ]
        },
        "saturation": {
          "anyOf": [
            {
              "type": "number"
            }
          ]
        },
        "shadow": {
          "anyOf": [
            {
              "$ref": "#/definitions/Record7"
            }
          ]
        },
        "glow": {
          "anyOf": [
            {
              "$ref": "#/definitions/Record8"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "Record7": {
      "type": "object",
      "properties": {
        "color": {
          "type": "string"
        },
        "blur": {
          "type": "number"
        },
        "offsetX": {
          "type": "number"
        },
        "offsetY": {
          "type": "number"
        },
        "opacity": {
          "type": "number"
        }
      },
      "required": [
        "color",
        "blur",
        "offsetX",
        "offsetY",
        "opacity"
      ],
      "additionalProperties": false
    },
    "Record8": {
      "type": "object",
      "properties": {
        "color": {
          "type": "string"
        },
        "blur": {
          "type": "number"
        },
        "opacity": {
          "type": "number"
        }
      },
      "required": [
        "color",
        "blur",
        "opacity"
      ],
      "additionalProperties": false
    },
    "KineticTextBinding": {
      "type": "object",
      "properties": {
        "version": {
          "type": "number",
          "const": 1
        },
        "mode": {
          "type": "string",
          "const": "word"
        },
        "startMs": {
          "type": "number"
        },
        "durationMs": {
          "type": "number"
        },
        "staggerMs": {
          "type": "number"
        },
        "easing": {
          "enum": [
            "linear",
            "ease-in",
            "ease-out",
            "ease-in-out"
          ]
        },
        "from": {
          "$ref": "#/definitions/KineticTextTransform"
        },
        "overrideTextHash": {
          "type": "string",
          "description": "Hash of source text when overrides were authored; later edits retain global intent but suspend stale overrides."
        },
        "runOverrides": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/definitions/Record11"
              }
            }
          ]
        }
      },
      "required": [
        "version",
        "mode",
        "startMs",
        "durationMs",
        "staggerMs",
        "easing",
        "from",
        "overrideTextHash"
      ],
      "additionalProperties": false
    },
    "KineticTextTransform": {
      "type": "object",
      "properties": {
        "offsetX": {
          "type": "number"
        },
        "offsetY": {
          "type": "number"
        },
        "scale": {
          "type": "number"
        },
        "rotation": {
          "type": "number"
        },
        "opacity": {
          "type": "number"
        }
      },
      "required": [
        "offsetX",
        "offsetY",
        "scale",
        "rotation",
        "opacity"
      ],
      "additionalProperties": false
    },
    "Record11": {
      "type": "object",
      "properties": {
        "runIndex": {
          "type": "number"
        },
        "rotationFrom": {
          "anyOf": [
            {
              "type": "number"
            }
          ]
        },
        "delayMs": {
          "anyOf": [
            {
              "type": "number"
            }
          ]
        }
      },
      "required": [
        "runIndex"
      ],
      "additionalProperties": false
    },
    "PathMorphBinding": {
      "type": "object",
      "properties": {
        "version": {
          "type": "number",
          "const": 1
        },
        "startMs": {
          "type": "number"
        },
        "durationMs": {
          "type": "number"
        },
        "easing": {
          "enum": [
            "linear",
            "ease-in",
            "ease-out",
            "ease-in-out"
          ]
        },
        "source": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/MorphCommand"
            }
          }
        },
        "target": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/MorphCommand"
            }
          }
        }
      },
      "required": [
        "version",
        "startMs",
        "durationMs",
        "easing",
        "source",
        "target"
      ],
      "additionalProperties": false
    },
    "MorphCommand": {
      "type": "object",
      "properties": {
        "op": {
          "enum": [
            "M",
            "L",
            "C",
            "Q",
            "Z"
          ]
        },
        "values": {
          "type": "array",
          "items": {
            "type": "number"
          }
        }
      },
      "required": [
        "op",
        "values"
      ],
      "additionalProperties": false
    },
    "ObjectStyleRefs": {
      "type": "object",
      "properties": {
        "typographyId": {
          "anyOf": [
            {
              "type": "string"
            }
          ]
        },
        "handPresetId": {
          "anyOf": [
            {
              "type": "string"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "SceneObjectVisibleRangeTiming": {
      "type": "object",
      "properties": {
        "startMs": {
          "type": "number",
          "description": "Scene-local visible range start, in milliseconds."
        },
        "endMs": {
          "type": "number",
          "description": "Scene-local visible range end, in milliseconds."
        },
        "mode": {
          "enum": [
            "visible-range"
          ]
        },
        "endBehavior": {
          "enum": [
            "hold",
            "hide"
          ],
          "description": "Ordinary content holds its final frame. Temporary authored content may opt into hiding at endMs."
        }
      },
      "required": [
        "startMs",
        "endMs"
      ],
      "additionalProperties": false
    }
  },
  "x-opaque-contracts": [
    "ObjectDTO.props.*"
  ]
}
