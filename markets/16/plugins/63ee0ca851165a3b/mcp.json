{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "hemmingway": {
      "type": "streamable-http",
      "url": "https://hemmingway.io/api/chatgpt/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "hemmingway-chatgpt",
              "tokenEndpointAuthMethod": "none"
            },
            "authorizationUrl": "https://hemmingway.io/api/chatgpt/authorize",
            "tokenUrl": "https://hemmingway.io/api/chatgpt/token",
            "baseScopes": ["writing:run"]
          }
        }
      }
    }
  }
}
