{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "datadog-chatgpt": {
      "type": "streamable-http",
      "url": "https://mcp.datadoghq.com/v1/mcp?toolsets=chatgpt",
      "extensions": {
        "com.openai": {
          "urlTemplates": [
            "https://mcp.datadoghq.{tld}/v1/mcp?toolsets=chatgpt",
            "https://mcp.{site}.datadoghq.com/v1/mcp?toolsets=chatgpt"
          ],
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            }
          }
        }
      }
    }
  }
}
