{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "author": {"name": "AI EmpowerHub"},
  "description": "Structured mentoring guidance",
  "extensions": {
    "com.openai": {
      "interface": {
        "capabilities": ["Interactive"],
        "category": "Business & Operations",
