{
  "mcpServers": {
    "ideatomade": {
      "type": "streamable-http",
      "url": "https://plugin.ideatomade.com/mcp/",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "cimd"
            },
            "baseScopes": [
              "openid",
              "profile",
              "email",
              "offline_access",
              "runtime"
            ],
            "defaultScopes": [
              "openid",
              "profile",
              "email",
              "offline_access",
              "runtime"
            ],
            "oidcEnabled": true,
            "resource": "https://plugin.ideatomade.com/mcp/",
            "authorizationUrl": "https://auth.ideatomade.com/oidc/auth?prompt=consent",
            "oidcConfigurationUrl": "https://auth.ideatomade.com/oidc/.well-known/openid-configuration",
            "oidcScopesSupported": [
              "openid",
              "profile",
              "email"
            ]
          }
        }
      },
      "headers": {}
    }
  }
}
