{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "abalmon": {
      "type": "streamable-http",
      "url": "https://abalmon.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "cimd"
            },
            "baseScopes": [
              "account:read",
              "sessions:read",
              "transcripts:read",
              "notes:read",
              "memory:read"
            ]
          }
        }
      }
    }
  }
}
