{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "ventrata": {
      "type": "streamable-http",
      "url": "https://api.ventrata.com/mcp?toolsets=all",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "client_01M780M6S0D9EWS1B0PTF0ZRYW",
              "tokenEndpointAuthMethod": "none"
            },
            "resource": "https://api.ventrata.com/mcp",
            "baseScopes": [
              "openid",
              "offline_access"
            ],
            "defaultScopes": [
              "mcp:read",
              "mcp:write"
            ]
          }
        }
      }
    }
  }
}
