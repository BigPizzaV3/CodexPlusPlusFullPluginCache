{
  "mcpServers": {
    "statista": {
      "type": "streamable-http",
      "url": "https://api.statista.ai/v1/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "YOUR_CLIENT_ID",
              "tokenEndpointAuthMethod": "client_secret_basic"
            },
            "authorizationUrl": "https://YOUR_AUTH_SERVER/authorize",
            "tokenUrl": "https://YOUR_AUTH_SERVER/token",
            "baseScopes": [
              "YOUR_REQUIRED_SCOPE"
            ]
          }
        }
      }
    }
  }
}
