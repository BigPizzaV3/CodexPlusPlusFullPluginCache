{
  "plugin": "thread-composer",
  "version": "0.1.0",
  "operation": "thread_audit",
  "input": {
    "posts": [
      "Hello",
      "A longer post"
    ],
    "limit": 10
  },
  "metrics": {
    "over_budget": 1,
    "note": "Code-point audit only; platform weighted rules may differ"
  },
  "rows": [
    {
      "post": 1,
      "code_points": 5,
      "over_budget": false
    },
    {
      "post": 2,
      "code_points": 13,
      "over_budget": true
    }
  ],
  "artifacts": [
    {
      "filename": "thread-composer-thread_audit.csv",
      "mimeType": "text/csv",
      "text": "\"post\",\"code_points\",\"over_budget\"\r\n\"1\",\"5\",\"false\"\r\n\"2\",\"13\",\"true\""
    }
  ]
}