{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "inminutes": {
      "type": "streamable-http",
      "url": "https://inminutes.app/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "defaultScopes": ["sites.read", "sites.write"]
          }
        }
      }
    }
  }
}
