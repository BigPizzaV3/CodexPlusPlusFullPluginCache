{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "modernizers": {
      "type": "streamable-http",
      "url": "https://api.modernizers.io/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": { "mode": "dcr" },
            "baseScopes": ["modernizers:read"],
            "oidcEnabled": false
          }
        }
      }
    }
  }
}
