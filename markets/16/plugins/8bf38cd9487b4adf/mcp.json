{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "Motion": {
      "type": "streamable-http",
      "url": "https://mcp.motion.so/mcp/openai",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "resource": "https://mcp.motion.so/mcp/openai",
            "oidcEnabled": true,
            "baseScopes": [
              "openid",
              "email",
              "mcp",
              "motion:sessions:read",
              "motion:sessions:write",
              "motion:automations:read",
              "motion:automations:write"
            ],
            "defaultScopes": [
              "openid",
              "email",
              "mcp",
              "motion:sessions:read",
              "motion:sessions:write",
              "motion:automations:read",
              "motion:automations:write"
            ],
            "client": {
              "mode": "dcr"
            }
          }
        }
      }
    }
  }
}