{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "busibee": {
      "type": "streamable-http",
      "url": "https://api.busibee.be/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": ["mcp"],
            "authorizationUrl": "https://busibee.be/oauth/authorize",
            "tokenUrl": "https://api.busibee.be/oauth/token",
            "registrationUrl": "https://api.busibee.be/oauth/register",
            "authorizationServerBase": "https://api.busibee.be",
            "resource": "https://api.busibee.be/mcp"
          }
        }
      }
    }
  }
}
