{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "openigloo": {
      "type": "streamable-http",
      "url": "https://chatgpt.openigloo.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "mixed",
            "client": {
              "mode": "dcr"
            },
            "authorizationServerBase": "https://chatgpt.openigloo.com/",
            "authorizationUrl": "https://chatgpt.openigloo.com/authorize",
            "tokenUrl": "https://chatgpt.openigloo.com/token",
            "registrationUrl": "https://chatgpt.openigloo.com/register",
            "resource": "https://chatgpt.openigloo.com/mcp",
            "defaultScopes": [
              "profile.read",
              "favorites.read",
              "favorites.write",
              "tours.write"
            ],
            "oidcEnabled": false
          }
        }
      }
    }
  }
}
