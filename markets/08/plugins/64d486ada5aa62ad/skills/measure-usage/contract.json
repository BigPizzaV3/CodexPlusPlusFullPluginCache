{
  "policyVersion": "remnant.usage-consent/1",
  "schemaVersion": "remnant.usage-tools/1",
  "evidenceTrust": "HOST_ASSERTED_NOT_INDEPENDENTLY_VERIFIED",
  "tools": {
    "record_task_usage": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "projectKey": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "schemaVersion": {
          "type": "string",
          "const": "remnant.task-usage/1"
        },
        "consentGeneration": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "runId": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "pairId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{32}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "condition": {
          "type": "string",
          "enum": [
            "ordinary",
            "baseline",
            "memory_available"
          ]
        },
        "modelKey": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9.-]{0,79}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "parametersSha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "family": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "architecture",
                "incident",
                "review",
                "other"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "difficulty": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "taskDefinitionSha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "qualityRubricSha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "startedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "endedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "elapsedMs": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "completed",
            "failed",
            "refused",
            "interrupted"
          ]
        },
        "tokens": {
          "type": "object",
          "properties": {
            "source": {
              "type": "string",
              "enum": [
                "provider_reported_by_host",
                "unavailable",
                "estimated_visible"
              ]
            },
            "total": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000000
                },
                {
                  "type": "null"
                }
              ]
            },
            "input": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000000
                },
                {
                  "type": "null"
                }
              ]
            },
            "output": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000000
                },
                {
                  "type": "null"
                }
              ]
            },
            "cachedInputSubset": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000000
                },
                {
                  "type": "null"
                }
              ]
            },
            "reasoningOutputSubset": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000000
                },
                {
                  "type": "null"
                }
              ]
            },
            "estimatedVisible": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000000
                },
                {
                  "type": "null"
                }
              ]
            },
            "responseDigests": {
              "maxItems": 64,
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          "required": [
            "source",
            "total",
            "input",
            "output",
            "cachedInputSubset",
            "reasoningOutputSubset",
            "estimatedVisible",
            "responseDigests"
          ],
          "additionalProperties": false
        },
        "memoryServiceTokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000
            },
            {
              "type": "null"
            }
          ]
        },
        "memoryServiceIncludedInTotal": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "assistanceTokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000
            },
            {
              "type": "null"
            }
          ]
        },
        "assistanceIncludedInTotal": {
          "default": null,
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "assistanceHumanMs": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000
            },
            {
              "type": "null"
            }
          ]
        },
        "assistanceHumanCostMicros": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000
            },
            {
              "type": "null"
            }
          ]
        },
        "memory": {
          "type": "object",
          "properties": {
            "discovered": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000000
                },
                {
                  "type": "null"
                }
              ]
            },
            "inspected": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000000
                },
                {
                  "type": "null"
                }
              ]
            },
            "requested": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000000
                },
                {
                  "type": "null"
                }
              ]
            },
            "retrieved": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000000
                },
                {
                  "type": "null"
                }
              ]
            },
            "applied": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000000
                },
                {
                  "type": "null"
                }
              ]
            },
            "outcome": {
              "type": "string",
              "enum": [
                "hit",
                "absence",
                "error",
                "irrelevant",
                "stale",
                "abstained",
                "not_applicable",
                "unknown"
              ]
            }
          },
          "required": [
            "discovered",
            "inspected",
            "requested",
            "retrieved",
            "applied",
            "outcome"
          ],
          "additionalProperties": false
        },
        "quality": {
          "type": "object",
          "properties": {
            "acceptancePassed": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            },
            "factualScore": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                {
                  "type": "null"
                }
              ]
            },
            "semanticScore": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "acceptancePassed",
            "factualScore",
            "semanticScore"
          ],
          "additionalProperties": false
        },
        "quota": {
          "type": "object",
          "properties": {
            "before": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "usedPercent": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 100
                    },
                    "windowDurationMins": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "resetsAt": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "capturedAt": {
                      "type": "string",
                      "format": "date-time",
                      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
                    }
                  },
                  "required": [
                    "usedPercent",
                    "windowDurationMins",
                    "resetsAt",
                    "capturedAt"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            },
            "after": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "usedPercent": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 100
                    },
                    "windowDurationMins": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "resetsAt": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "capturedAt": {
                      "type": "string",
                      "format": "date-time",
                      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
                    }
                  },
                  "required": [
                    "usedPercent",
                    "windowDurationMins",
                    "resetsAt",
                    "capturedAt"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "before",
            "after"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "projectKey",
        "schemaVersion",
        "consentGeneration",
        "runId",
        "pairId",
        "condition",
        "modelKey",
        "parametersSha256",
        "family",
        "difficulty",
        "taskDefinitionSha256",
        "qualityRubricSha256",
        "startedAt",
        "endedAt",
        "elapsedMs",
        "status",
        "tokens",
        "memoryServiceTokens",
        "memoryServiceIncludedInTotal",
        "assistanceTokens",
        "assistanceIncludedInTotal",
        "assistanceHumanMs",
        "assistanceHumanCostMicros",
        "memory",
        "quality",
        "quota"
      ],
      "additionalProperties": false
    },
    "preregister_usage_pair": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "projectKey": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "consentGeneration": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "pairId": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "modelKey": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]{0,79}$"
        },
        "parametersSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "family": {
          "type": "string",
          "enum": [
            "architecture",
            "incident",
            "review",
            "other"
          ]
        },
        "difficulty": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "taskDefinitionSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "qualityRubricSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "order": {
          "type": "string",
          "enum": [
            "baseline_first",
            "memory_first"
          ]
        },
        "qualityTolerance": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        },
        "amortizedPreparationTokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000
            },
            {
              "type": "null"
            }
          ]
        },
        "preparationHumanMs": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000
            },
            {
              "type": "null"
            }
          ]
        },
        "preparationHumanCostMicros": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "projectKey",
        "consentGeneration",
        "pairId",
        "modelKey",
        "parametersSha256",
        "family",
        "difficulty",
        "taskDefinitionSha256",
        "qualityRubricSha256",
        "order",
        "qualityTolerance",
        "amortizedPreparationTokens",
        "preparationHumanMs",
        "preparationHumanCostMicros"
      ],
      "additionalProperties": false
    },
    "get_my_usage_measurements": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "projectKey": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "limit": {
          "default": 50,
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "offset": {
          "default": 0,
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        }
      },
      "required": [
        "projectKey",
        "limit",
        "offset"
      ],
      "additionalProperties": false
    },
    "withdraw_task_usage": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "projectKey": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "consentGeneration": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "runId": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        }
      },
      "required": [
        "projectKey",
        "consentGeneration",
        "runId"
      ],
      "additionalProperties": false
    }
  },
  "runtimeInvariants": [
    "Separate human consent and matching consent generation",
    "Prospective pair registration, fixed metadata, order and non-overlapping intervals",
    "Provider total = input + output when both known; cached/reasoning are subsets",
    "Included memory-service cost is not added twice",
    "Strict schema; no prompts, raw logs, provider account IDs or content",
    "Live OAuth scopes and identity; stable IDs and response deduplication",
    "Reported counters are not independently verified; causal/economic savings remain null"
  ]
}
