{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Custom source package (data only)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "executionPermission",
    "sourceText",
    "manifest",
    "files"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "executionPermission": {
      "const": "none"
    },
    "sourceText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100000
    },
    "manifest": {
      "type": "object",
      "required": [
        "files"
      ],
      "additionalProperties": false,
      "properties": {
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "required": [
              "path",
              "bytes",
              "sha256"
            ],
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              },
              "bytes": {
                "type": "integer",
                "minimum": 0
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": [
          "path",
          "kind",
          "text"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "kind": {
            "const": "text"
          },
          "text": {
            "type": "string"
          }
        }
      }
    }
  }
}
