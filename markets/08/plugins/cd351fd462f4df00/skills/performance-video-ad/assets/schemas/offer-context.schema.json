{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mymarketer.example/schemas/offer-context.schema.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "sourceAssemblyVersion",
    "jobId",
    "status",
    "offerId",
    "offerName",
    "primaryOutcome",
    "sourcePrecedence",
    "canonicalSourceIds",
    "globalProjectStrategy",
    "conflicts"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "sourceAssemblyVersion": { "const": 1 },
    "jobId": { "type": "string", "minLength": 1 },
    "status": { "enum": ["DRAFT", "OFFER_SOURCE_LOCKED"] },
    "offerId": { "type": "string", "minLength": 1 },
    "offerName": { "type": "string", "minLength": 1 },
    "primaryOutcome": {
      "type": "object",
      "required": ["status", "statement", "sourceRefs"],
      "properties": {
        "status": { "const": "grounded" },
        "statement": { "type": "string", "minLength": 1 },
        "sourceRefs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "sourcePrecedence": {
      "type": "array",
      "prefixItems": [
        { "const": "user_designated_canonical" },
        { "const": "approved_offer_decision" },
        { "const": "offer_current_lp_or_spec" },
        { "const": "offer_voc_research_or_interview" },
        { "const": "global_project_strategy" },
        { "const": "general_method_or_trend" }
      ],
      "minItems": 6,
      "maxItems": 6
    },
    "canonicalSourceIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "globalProjectStrategy": {
      "type": "object",
      "required": ["sourceId", "role"],
      "properties": {
        "sourceId": { "type": "string", "minLength": 1 },
        "role": { "const": "background_only" }
      },
      "additionalProperties": true
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["conflictId", "higherPrioritySourceIds", "lowerPrioritySourceIds", "resolution", "status"],
        "properties": {
          "conflictId": { "type": "string", "minLength": 1 },
          "higherPrioritySourceIds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "lowerPrioritySourceIds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "resolution": { "type": "string", "minLength": 1 },
          "status": { "enum": ["resolved_by_precedence", "unresolved"] }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
