{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mymarketer.example/schemas/funnel-role-contract.schema.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "funnelRoleContractVersion",
    "jobId",
    "status",
    "source_refs",
    "traffic_temperature",
    "awareness_stage",
    "funnel_stage",
    "next_destination",
    "primary_conversion",
    "final_conversion",
    "ad_cta_action",
    "stage_role",
    "message_budget",
    "curiosity_handoff",
    "downstream_continuity",
    "stage_metrics",
    "duration_strategy"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "funnelRoleContractVersion": { "const": 1 },
    "jobId": { "type": "string", "minLength": 1 },
    "status": { "enum": ["DRAFT", "NEEDS_USER_INPUT", "ROLE_RESOLVED"] },
    "source_refs": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "traffic_temperature": { "type": ["string", "null"], "enum": ["cold", "warm", "hot", "mixed", null] },
    "awareness_stage": { "type": ["string", "null"], "enum": ["unaware", "problem_aware", "solution_aware", "product_aware", "most_aware", null] },
    "funnel_stage": { "type": ["string", "null"], "enum": ["awareness_ad", "cold_clickthrough_ad", "warm_clickthrough_ad", "retargeting_explainer", "direct_response_ad", "other", null] },
    "next_destination": {
      "type": "object",
      "required": ["type", "ref", "role"],
      "properties": {
        "type": { "type": ["string", "null"], "enum": ["landing_page", "lead_form", "store", "product_page", "booking_page", "content", "other", null] },
        "ref": { "type": ["string", "null"] },
        "role": { "type": ["string", "null"], "enum": ["full_persuasion", "consideration", "proof", "education", "direct_conversion", "other", null] }
      },
      "additionalProperties": true
    },
    "primary_conversion": { "$ref": "#/$defs/conversion" },
    "final_conversion": {
      "allOf": [
        { "$ref": "#/$defs/conversion" },
        {
          "type": "object",
          "required": ["occurs_after"],
          "properties": {
            "occurs_after": { "type": "array", "items": { "type": "string", "minLength": 1 } }
          }
        }
      ]
    },
    "ad_cta_action": { "type": ["string", "null"] },
    "stage_role": {
      "type": "object",
      "required": ["primary_jobs", "secondary_jobs", "not_responsible_for"],
      "properties": {
        "primary_jobs": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/stageJob" } },
        "secondary_jobs": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/stageJob" } },
        "not_responsible_for": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/deferredResponsibility" } }
      },
      "additionalProperties": true
    },
    "message_budget": {
      "type": "object",
      "required": ["max_total_core_messages", "max_mechanism_steps", "max_proof_items", "core_messages"],
      "properties": {
        "max_total_core_messages": { "type": ["integer", "null"], "minimum": 1 },
        "max_mechanism_steps": { "type": ["integer", "null"], "minimum": 0 },
        "max_proof_items": { "type": ["integer", "null"], "minimum": 0 },
        "core_messages": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["message_id", "role", "text", "source_refs"],
            "properties": {
              "message_id": { "type": "string", "minLength": 1 },
              "role": { "$ref": "#/$defs/messageRole" },
              "text": { "type": "string", "minLength": 1 },
              "source_refs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "curiosity_handoff": {
      "type": "object",
      "required": ["question_created_by_ad", "answered_in_ad", "intentionally_left_for_destination"],
      "properties": {
        "question_created_by_ad": { "type": ["string", "null"] },
        "answered_in_ad": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "intentionally_left_for_destination": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": true
    },
    "downstream_continuity": {
      "type": "object",
      "required": ["ad_expectation", "destination_entry_answer", "status"],
      "properties": {
        "ad_expectation": { "type": ["string", "null"] },
        "destination_entry_answer": { "type": ["string", "null"] },
        "status": { "enum": ["pending", "aligned", "mismatch"] }
      },
      "additionalProperties": true
    },
    "stage_metrics": {
      "type": "object",
      "required": ["primary", "guardrails", "downstream"],
      "properties": {
        "primary": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/metric" } },
        "guardrails": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/metric" } },
        "downstream": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/metric" } }
      },
      "additionalProperties": true
    },
    "duration_strategy": {
      "type": "object",
      "required": ["mode", "target_seconds", "rationale"],
      "properties": {
        "mode": { "type": ["string", "null"], "enum": ["concise_clickthrough", "comprehension_first", "proof_explainer", "custom", null] },
        "target_seconds": {
          "type": "object",
          "required": ["min", "max"],
          "properties": {
            "min": { "type": ["number", "null"], "exclusiveMinimum": 0 },
            "max": { "type": ["number", "null"], "exclusiveMinimum": 0 }
          },
          "additionalProperties": false
        },
        "rationale": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "conversion": {
      "type": "object",
      "required": ["type", "occurs_on"],
      "properties": {
        "type": { "type": ["string", "null"] },
        "occurs_on": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "stageJob": {
      "enum": ["create_relevant_curiosity", "earn_qualified_click", "signal_audience_fit", "make_pain_self_relevant", "establish_minimum_credibility", "prequalify_problem", "build_trust", "explain_mechanism", "prove_claim", "drive_direct_conversion", "introduce_category"]
    },
    "deferredResponsibility": {
      "enum": ["full_mechanism_explanation", "full_objection_handling", "detailed_deliverables", "pricing_explanation", "contract_persuasion", "full_risk_resolution", "full_proof_case"]
    },
    "messageRole": {
      "enum": ["pain", "tension", "surprising_reframe", "product_category", "mechanism", "proof", "payoff", "cta", "objection", "deliverable", "pricing", "trust"]
    },
    "metric": {
      "enum": ["one_second_view", "three_second_view", "six_second_view", "fifty_percent_view", "qualified_outbound_ctr", "landing_page_view_rate", "landing_page_engagement", "consultation_cvr", "qualified_lead_rate", "opportunity_rate", "contract_rate", "cac", "revenue"]
    }
  },
  "additionalProperties": true
}
