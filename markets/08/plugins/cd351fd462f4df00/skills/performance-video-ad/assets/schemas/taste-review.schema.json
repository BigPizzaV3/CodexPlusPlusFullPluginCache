{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mymarketer.example/schemas/taste-review.schema.json",
  "type": "object",
  "required": ["schemaVersion","discoveryContractVersion","jobId","status","approvalScope","decision","reviewedTerritoryIds","selectedTerritoryId","reviews","approvedBy","approvedAt","performanceEvidenceStatus","approvalDoesNotProvePerformance"],
  "properties": {
    "schemaVersion": {"const":1},
    "discoveryContractVersion": {"const":1},
    "jobId": {"type":"string","minLength":1},
    "status": {"enum":["AWAITING_HUMAN_REVIEW","RECORDED"]},
    "approvalScope": {"const":"CREATIVE_TERRITORY_TASTE_GATE"},
    "decision": {"enum":["pending","approved","revise"]},
    "reviewedTerritoryIds": {"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
    "selectedTerritoryId": {"type":["string","null"]},
    "reviews": {"type":"array","uniqueItems":true,"items":{"type":"object","required":["territory_id","felt_like_my_case","emotion_moved","wanted_to_continue","wanted_to_click","felt_excessively_ad_like","notes"],"additionalProperties":false,"properties":{"territory_id":{"type":"string","minLength":1},"felt_like_my_case":{"type":"boolean"},"emotion_moved":{"type":"boolean"},"wanted_to_continue":{"type":"boolean"},"wanted_to_click":{"type":"boolean"},"felt_excessively_ad_like":{"type":"boolean"},"notes":{"type":["string","null"]}}}},
    "agentDelegation": {"type":"object","required":["receipt","snapshot"],"additionalProperties":false,"properties":{"receipt":{"type":"object"},"snapshot":{"type":"object"}}},
    "approvedBy": {"type":["string","null"]},
    "approvedAt": {"type":["string","null"],"format":"date-time"},
    "performanceEvidenceStatus": {"const":"not_measured"},
    "approvalDoesNotProvePerformance": {"const":true}
  },
  "additionalProperties": false
}
