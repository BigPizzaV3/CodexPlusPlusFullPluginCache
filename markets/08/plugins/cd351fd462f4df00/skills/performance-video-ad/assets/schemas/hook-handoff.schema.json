{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mymarketer.example/schemas/hook-handoff.schema.json",
  "type": "object",
  "required": ["schemaVersion", "handoffContractVersion", "jobId", "status", "scope", "common_core_start_seconds", "entries"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "handoffContractVersion": { "const": 1 },
    "jobId": { "type": "string", "minLength": 1 },
    "status": { "enum": ["DRAFT", "READY_FOR_HUMAN_REVIEW", "LOCKED"] },
    "scope": { "enum": ["CONTROLLED_BATCH", "SINGLE_MASTER_EXPLORATION"] },
    "common_core_start_seconds": { "type": "number", "exclusiveMinimum": 0 },
    "entries": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["hook_id", "hook_end_seconds", "handoff_end_seconds", "emotional_state", "question_to_carry", "handoff_lines", "common_core_entry_state", "source_refs"],
        "properties": {
          "hook_id": { "type": "string", "minLength": 1 },
          "hook_end_seconds": { "type": "number", "minimum": 0 },
          "handoff_end_seconds": { "type": "number", "exclusiveMinimum": 0 },
          "emotional_state": { "type": "string", "minLength": 1 },
          "question_to_carry": { "type": "string", "minLength": 1 },
          "handoff_lines": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "common_core_entry_state": { "type": "string", "minLength": 1 },
          "source_refs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
        },
        "additionalProperties": false
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "enum": ["READY_FOR_HUMAN_REVIEW", "LOCKED"] } }, "required": ["status"] },
      "then": { "properties": { "entries": { "minItems": 1 } } }
    }
  ],
  "additionalProperties": false
}
