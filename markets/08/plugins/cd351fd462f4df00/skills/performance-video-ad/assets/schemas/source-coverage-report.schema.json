{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mymarketer.example/schemas/source-coverage-report.schema.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "sourceAssemblyVersion",
    "jobId",
    "offerId",
    "required_sources_found",
    "required_sources_read",
    "required_sources_with_evidence",
    "missing_sources",
    "unread_sources",
    "read_but_unused_sources",
    "offer_global_strategy_conflicts",
    "gate_status"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "sourceAssemblyVersion": { "const": 1 },
    "jobId": { "type": "string", "minLength": 1 },
    "offerId": { "type": "string", "minLength": 1 },
    "required_sources_found": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "required_sources_read": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "required_sources_with_evidence": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "missing_sources": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "unread_sources": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "read_but_unused_sources": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "offer_global_strategy_conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["conflictId", "status", "winnerSourceIds", "backgroundSourceIds", "resolution"],
        "properties": {
          "conflictId": { "type": "string", "minLength": 1 },
          "status": { "enum": ["resolved_by_precedence", "unresolved"] },
          "winnerSourceIds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "backgroundSourceIds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "resolution": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": true
      }
    },
    "warnings": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "gate_status": { "enum": ["PASS", "WARNING", "FAIL"] }
  },
  "additionalProperties": true
}
