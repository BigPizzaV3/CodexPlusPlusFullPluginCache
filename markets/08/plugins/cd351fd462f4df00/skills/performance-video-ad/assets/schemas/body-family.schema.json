{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mymarketer.example/schemas/body-family.schema.json",
  "type": "object",
  "required": ["schemaVersion", "jobId", "status", "bodyFamilyId", "modules", "lockedVariables"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "jobId": { "type": "string", "minLength": 1 },
    "status": { "enum": ["DRAFT_NOT_LOCKED", "LOCKED"] },
    "bodyFamilyId": { "type": ["string", "null"] },
    "modules": { "type": "array" },
    "lockedVariables": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "LOCKED" } } },
      "then": {
        "properties": {
          "bodyFamilyId": { "type": "string", "minLength": 1 },
          "modules": { "type": "array", "minItems": 1 }
        }
      }
    }
  ],
  "additionalProperties": true
}
