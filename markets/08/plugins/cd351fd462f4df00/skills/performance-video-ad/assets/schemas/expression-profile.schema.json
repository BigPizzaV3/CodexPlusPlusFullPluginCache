{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mymarketer.example/schemas/expression-profile.schema.json",
  "type": "object",
  "required": ["schemaVersion", "id", "status", "description", "priorities", "workSurfaces", "motionRules", "soundDesignRules", "creativeChecks", "portfolioPolicy"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "enum": ["restrained_b2b_social", "balanced_social_brand", "spectacle_experiment"] },
    "status": { "const": "active" },
    "description": { "type": "string", "minLength": 1 },
    "priorities": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "workSurfaces": { "type": "array", "uniqueItems": true, "items": { "enum": ["pc_ui", "smartphone_ui", "document", "chat", "calendar", "screen_recording", "meeting"] } },
    "motionRules": {
      "type": "object",
      "required": ["maxSceneActions", "allowedCameraGrammar", "allowedSoundIntensity", "brandTreatment", "prohibitedPatterns"],
      "properties": {
        "maxSceneActions": { "type": "integer", "minimum": 1 },
        "allowedCameraGrammar": { "type": "array", "minItems": 1, "items": { "enum": ["locked", "simple_push", "hard_cut", "screen_recording", "moderate_brand_transition", "cinematic_transform"] } },
        "allowedSoundIntensity": { "type": "array", "minItems": 1, "items": { "enum": ["low", "moderate", "high"] } },
        "brandTreatment": { "enum": ["end_card_primary", "restrained_throughout", "experiment_defined"] },
        "prohibitedPatterns": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "soundDesignRules": {
      "type": "object",
      "required": ["densityMode", "maxOnsetsPerSecond", "maxSimultaneousUnderNarration", "maxSimultaneousWithoutNarration", "maxEditorialAccentsPerBeat", "allowedCueRoles", "highDensityClusterRequiresPurpose", "narrationPriority", "muteLegibilityRequired"],
      "properties": {
        "densityMode": { "enum": ["restrained", "balanced", "entertainment_high"] },
        "maxOnsetsPerSecond": { "type": "integer", "minimum": 1, "maximum": 6 },
        "maxSimultaneousUnderNarration": { "type": "integer", "minimum": 1, "maximum": 2 },
        "maxSimultaneousWithoutNarration": { "type": "integer", "minimum": 1, "maximum": 4 },
        "maxEditorialAccentsPerBeat": { "type": "integer", "minimum": 0, "maximum": 2 },
        "allowedCueRoles": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["causal", "informational", "structural", "rhythmic", "emotional", "brand", "ambience"] } },
        "highDensityClusterRequiresPurpose": { "const": true },
        "narrationPriority": { "const": true },
        "muteLegibilityRequired": { "const": true }
      },
      "additionalProperties": false
    },
    "creativeChecks": {
      "type": "object",
      "required": ["vfxIndependentRequired", "problemUnderstoodBySeconds", "painBeforeSpectacle", "realisticWorkSurfaceRequired"],
      "properties": {
        "vfxIndependentRequired": { "type": "boolean" },
        "problemUnderstoodBySeconds": { "type": "number", "exclusiveMinimum": 0 },
        "painBeforeSpectacle": { "type": "boolean" },
        "realisticWorkSurfaceRequired": { "type": "boolean" }
      }
    },
    "portfolioPolicy": {
      "type": "object",
      "required": ["default", "minimumPerEight", "maximumPerEight", "requiresPermissionOrPurpose"],
      "properties": {
        "default": { "type": "boolean" },
        "minimumPerEight": { "type": "integer", "minimum": 0, "maximum": 8 },
        "maximumPerEight": { "type": "integer", "minimum": 0, "maximum": 8 },
        "requiresPermissionOrPurpose": { "type": "boolean" }
      }
    }
  },
  "additionalProperties": false
}
