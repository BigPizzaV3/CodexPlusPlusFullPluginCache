{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mymarketer.example/schemas/first-pass-baseline.schema.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "jobId",
    "status",
    "productionMode",
    "targetCompletionPercent",
    "selectedTerritoryId",
    "prerequisites",
    "locks",
    "timeline",
    "generatedHero",
    "proof",
    "deterministicFinish",
    "review",
    "learningBoundary",
    "distribution"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "jobId": { "type": "string", "minLength": 1 },
    "status": { "enum": ["DRAFT", "READY_FOR_HUMAN_LAST_MILE_REVIEW", "REVISE"] },
    "productionMode": { "const": "first_pass_85_baseline" },
    "targetCompletionPercent": { "const": 85 },
    "selectedTerritoryId": { "type": "string", "minLength": 1 },
    "prerequisites": {
      "type": "object",
      "required": ["sourceCoveragePass", "creativePremiseApproved", "tasteGateApproved", "animaticApproved"],
      "properties": {
        "sourceCoveragePass": { "type": "boolean" },
        "creativePremiseApproved": { "type": "boolean" },
        "tasteGateApproved": { "type": "boolean" },
        "animaticApproved": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "locks": {
      "type": "object",
      "required": ["offer", "audience", "funnelRole", "hookBodyArc", "destinationCta", "expressionProfile", "tempoProfile"],
      "properties": {
        "offer": { "type": "boolean" },
        "audience": { "type": "boolean" },
        "funnelRole": { "type": "boolean" },
        "hookBodyArc": { "type": "boolean" },
        "destinationCta": { "type": "boolean" },
        "expressionProfile": { "type": "string", "minLength": 1 },
        "tempoProfile": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "timeline": {
      "type": "object",
      "required": ["durationSeconds", "incidentBySeconds", "whoAndProblemBySeconds", "endCardSeconds", "oneSemanticActionPerCut", "beats"],
      "properties": {
        "durationSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "incidentBySeconds": { "type": "number", "minimum": 0, "maximum": 0.5 },
        "whoAndProblemBySeconds": { "type": "number", "minimum": 0, "maximum": 2 },
        "endCardSeconds": { "type": "number", "minimum": 3.5 },
        "oneSemanticActionPerCut": { "type": "boolean" },
        "beats": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "object",
            "required": ["beatId", "role", "startSeconds", "endSeconds", "semanticJob"],
            "properties": {
              "beatId": { "type": "string", "minLength": 1 },
              "role": { "enum": ["comprehension_anchor", "action_compression", "quantity_montage", "payoff_anchor", "end_card"] },
              "startSeconds": { "type": "number", "minimum": 0 },
              "endSeconds": { "type": "number", "exclusiveMinimum": 0 },
              "semanticJob": { "type": "string", "minLength": 1 },
              "introducesNewClaim": { "type": "boolean" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "generatedHero": {
      "type": "object",
      "required": ["used", "rawReviewedAtNaturalSpeed", "humanRawApproval", "deadAirDecision", "motionInterpolationApplied", "speedSegments"],
      "properties": {
        "used": { "type": "boolean" },
        "rawAssetRef": { "type": ["string", "null"] },
        "rawSha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
        "rawReviewedAtNaturalSpeed": { "type": "boolean" },
        "humanRawApproval": { "enum": ["approved", "not_applicable", "pending", "rejected"] },
        "deadAirDecision": { "enum": ["trimmed", "none_detected", "not_applicable"] },
        "sourceFrameRate": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "deliveryFrameRate": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "motionInterpolationApplied": { "type": "boolean" },
        "speedSegments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["sourceStartSeconds", "sourceEndSeconds", "rate", "purpose"],
            "properties": {
              "sourceStartSeconds": { "type": "number", "minimum": 0 },
              "sourceEndSeconds": { "type": "number", "exclusiveMinimum": 0 },
              "rate": { "type": "number", "exclusiveMinimum": 0 },
              "purpose": { "enum": ["compress_action", "preserve_readable_endpoint"] }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "proof": {
      "type": "object",
      "required": ["mode", "presentationStrategy", "sourceAuditStatus", "sourceRefs", "sourceClassification", "mosaicApplied", "readableAnchorCount", "quantityAssetCount", "sequence", "claimBoundary", "resultsClaimUsed"],
      "properties": {
        "mode": { "enum": ["none", "offer_artifact"] },
        "presentationStrategy": { "enum": ["none", "readable_anchor_then_quantity", "single_artifact_demo"] },
        "sourceAuditStatus": { "enum": ["not_applicable", "pass", "fail"] },
        "sourceRefs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["assetRef", "sha256"],
            "properties": {
              "assetRef": { "type": "string", "minLength": 1 },
              "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
            },
            "additionalProperties": false
          }
        },
        "sourceClassification": { "type": ["string", "null"] },
        "mosaicApplied": { "type": "boolean" },
        "readableAnchorCount": { "type": "integer", "minimum": 0 },
        "quantityAssetCount": { "type": "integer", "minimum": 0 },
        "sequence": {
          "type": "array",
          "items": { "enum": ["large_readable_proof", "rapid_quantity_cascade", "quantity_wall", "large_payoff_proof"] }
        },
        "claimBoundary": { "type": "string", "minLength": 1 },
        "resultsClaimUsed": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "deterministicFinish": {
      "type": "object",
      "required": ["exactJapanese", "brand", "offerTerms", "cta", "width", "height", "fps", "constantFrameRate", "videoTimeBase", "pixelFormat", "startAtZero", "fullDecodePass", "targetPlayerBoundaryPass"],
      "properties": {
        "exactJapanese": { "type": "boolean" },
        "brand": { "type": "boolean" },
        "offerTerms": { "type": "boolean" },
        "cta": { "type": "boolean" },
        "width": { "const": 1080 },
        "height": { "const": 1920 },
        "fps": { "type": "number", "exclusiveMinimum": 0 },
        "constantFrameRate": { "type": "boolean" },
        "videoTimeBase": { "type": "string", "minLength": 1 },
        "pixelFormat": { "const": "yuv420p" },
        "startAtZero": { "type": "boolean" },
        "fullDecodePass": { "type": "boolean" },
        "targetPlayerBoundaryPass": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "required": ["machineCreativeGate", "technicalGate", "lastMileHumanReviewRequired", "humanAssessment"],
      "properties": {
        "machineCreativeGate": { "enum": ["PASS", "REVISE", "NOT_RUN"] },
        "technicalGate": { "enum": ["PASS", "REVISE", "NOT_RUN"] },
        "lastMileHumanReviewRequired": { "const": true },
        "humanAssessment": { "enum": ["pending", "approximately_85_percent", "revise"] }
      },
      "additionalProperties": false
    },
    "learningBoundary": {
      "type": "object",
      "required": ["completionPercentIsPerformanceEvidence", "campaignPerformanceObserved"],
      "properties": {
        "completionPercentIsPerformanceEvidence": { "const": false },
        "campaignPerformanceObserved": { "const": false }
      },
      "additionalProperties": false
    },
    "distribution": {
      "type": "object",
      "required": ["publishAllowed", "activateAdsAllowed", "publicSkillDistributionAllowed"],
      "properties": {
        "publishAllowed": { "const": false },
        "activateAdsAllowed": { "const": false },
        "publicSkillDistributionAllowed": { "const": false }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
