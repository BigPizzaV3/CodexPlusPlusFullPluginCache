{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mymarketer.example/schemas/pacing-review.schema.json",
  "type": "object",
  "required": ["schemaVersion", "jobId", "status", "mode", "duration_seconds", "compression_allowed", "end_card_seconds", "limits", "beats", "human_review_required"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "pacingContractVersion": { "enum": [1, 2] },
    "jobId": { "type": "string", "minLength": 1 },
    "status": { "enum": ["DRAFT", "READY_FOR_HUMAN_REVIEW", "APPROVED", "REVISE"] },
    "mode": { "enum": ["FINAL_LENGTH", "COMPREHENSION_FIRST_MASTER"] },
    "duration_seconds": { "type": "number", "exclusiveMinimum": 0 },
    "compression_allowed": { "type": "boolean" },
    "end_card_seconds": { "type": "number", "minimum": 0 },
    "limits": {
      "type": "object",
      "required": ["max_new_concepts_per_beat", "max_simultaneous_reading_layers"],
      "properties": {
        "max_new_concepts_per_beat": { "type": "integer", "minimum": 1 },
        "max_simultaneous_reading_layers": { "type": "integer", "minimum": 1 },
        "minimum_single_layer_read_seconds": { "type": "number", "minimum": 1 },
        "minimum_two_layer_read_seconds": { "type": "number", "minimum": 1 },
        "minimum_post_read_hold_seconds": { "type": "number", "minimum": 0.5 }
      },
      "additionalProperties": false
    },
    "beats": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["beat_id", "start_seconds", "end_seconds", "new_concepts", "simultaneous_reading_layers", "status"],
        "properties": {
          "beat_id": { "type": "string", "minLength": 1 },
          "start_seconds": { "type": "number", "minimum": 0 },
          "end_seconds": { "type": "number", "exclusiveMinimum": 0 },
          "new_concepts": { "type": "integer", "minimum": 0 },
          "simultaneous_reading_layers": { "type": "integer", "minimum": 0 },
          "minimum_read_seconds": { "type": "number", "minimum": 0 },
          "post_read_hold_seconds": { "type": "number", "minimum": 0 },
          "status": { "enum": ["PASS", "REVISE", "NOT_RUN"] }
        },
        "additionalProperties": false
      }
    },
    "human_review_required": { "const": true }
  },
  "allOf": [
    {
      "if": {
        "properties": { "pacingContractVersion": { "const": 2 } },
        "required": ["pacingContractVersion"]
      },
      "then": {
        "properties": {
          "limits": {
            "required": [
              "max_new_concepts_per_beat",
              "max_simultaneous_reading_layers",
              "minimum_single_layer_read_seconds",
              "minimum_two_layer_read_seconds",
              "minimum_post_read_hold_seconds"
            ]
          },
          "beats": {
            "items": {
              "required": [
                "beat_id",
                "start_seconds",
                "end_seconds",
                "new_concepts",
                "simultaneous_reading_layers",
                "minimum_read_seconds",
                "post_read_hold_seconds",
                "status"
              ]
            }
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
