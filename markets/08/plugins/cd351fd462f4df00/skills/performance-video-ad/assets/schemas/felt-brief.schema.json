{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mymarketer.example/schemas/felt-brief.schema.json",
  "type": "object",
  "required": ["schemaVersion","discoveryContractVersion","jobId","status","private_thought","feared_next_moment","emotional_tension","identity_to_preserve","false_reflex","surprising_possibility","desired_relief","desired_click_thought","dignity_rule","source_refs","unresolved_fields","questions_to_user"],
  "properties": {
    "schemaVersion": {"const":1},
    "discoveryContractVersion": {"const":1},
    "jobId": {"type":"string","minLength":1},
    "status": {"enum":["DRAFT","NEEDS_USER_INPUT","READY_FOR_DISCOVERY"]},
    "private_thought": {"type":["string","null"]},
    "feared_next_moment": {"type":["string","null"]},
    "emotional_tension": {"type":["string","null"]},
    "identity_to_preserve": {"type":["string","null"]},
    "false_reflex": {"type":["string","null"]},
    "surprising_possibility": {"type":["string","null"]},
    "desired_relief": {"type":["string","null"]},
    "desired_click_thought": {"type":["string","null"]},
    "dignity_rule": {"type":["string","null"]},
    "source_refs": {"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
    "unresolved_fields": {"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
    "questions_to_user": {"type":"array","maxItems":3,"items":{"type":"object","required":["question_id","field_ids","question","decision_impact"],"additionalProperties":true}}
  },
  "additionalProperties": false
}
