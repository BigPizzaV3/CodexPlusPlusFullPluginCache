{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mymarketer.example/schemas/keyframe-production-plan.schema.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "jobId",
    "status",
    "productionMode",
    "paidVideoGenerationAllowed",
    "maximumExploratoryVideoAttemptsPerApprovedShot",
    "scenes",
    "distribution"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "planVersion": { "enum": [1, 2] },
    "jobId": { "type": "string", "minLength": 1 },
    "status": { "enum": ["AWAITING_STATIC_KEYFRAME_APPROVAL", "READY_FOR_PAID_MOTION_ROUTING", "MOTION_GENERATED_PENDING_QC", "REJECTED"] },
    "productionMode": { "enum": ["keyframe_first_hybrid", "adaptive_hybrid"] },
    "paidVideoGenerationAllowed": { "type": "boolean" },
    "maximumExploratoryVideoAttemptsPerApprovedShot": { "const": 1 },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["sceneId", "generationMode", "exactTextRequirement", "paidVideoAllowed"],
        "properties": {
          "sceneId": { "type": "string", "minLength": 1 },
          "generationMode": { "enum": ["remotion_only", "ai_image_to_video", "ai_video", "remotion_composite"] },
          "exactTextRequirement": { "type": "boolean" },
          "coherentEvent": { "type": ["string", "null"] },
          "durationSeconds": { "type": ["number", "null"], "exclusiveMinimum": 0, "maximum": 8 },
          "keyframes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["role", "assetRef", "status"],
              "properties": {
                "role": { "enum": ["start_frame", "peak_action", "endpoint"] },
                "assetRef": { "type": ["string", "null"] },
                "status": { "enum": ["not_created", "candidate", "approved", "rejected"] }
              },
              "additionalProperties": false
            }
          },
          "continuityContract": {
            "type": ["object", "null"],
            "properties": {
              "previousSceneId": { "type": ["string", "null"] },
              "requiredSurface": { "type": "string", "minLength": 1 },
              "startFrameMustMatchPreviousEnd": { "type": "boolean" },
              "status": { "enum": ["pending", "approved", "rejected", "not_applicable"] }
            },
            "required": ["previousSceneId", "requiredSurface", "startFrameMustMatchPreviousEnd", "status"],
            "additionalProperties": false
          },
          "keyframeApproval": {
            "type": ["object", "null"],
            "properties": { "decision": { "enum": ["pending", "approved", "rejected", "not_applicable"] } },
            "required": ["decision"],
            "additionalProperties": false
          },
          "transitionPreviewApproval": {
            "type": ["object", "null"],
            "properties": { "decision": { "enum": ["pending", "approved", "rejected", "not_applicable"] } },
            "required": ["decision"],
            "additionalProperties": false
          },
          "paidVideoAllowed": { "type": "boolean" },
          "exactContentAuthority": { "enum": ["deterministic", "generative", "not_applicable"] },
          "bindingMode": { "enum": ["screen_native", "planar_track", "corner_pin", "uv_texture_3d", "final_frame_repair", "motion_scaffold_v2v", "not_applicable"] },
          "compositingFeasibilityStatus": { "enum": ["PENDING", "PASS", "FAIL", "NOT_REQUIRED"] },
          "controlBudget": {
            "type": "object",
            "required": ["keyframePolicy", "controlSources", "controlReason"],
            "properties": {
              "keyframePolicy": { "enum": ["none", "first_only", "first_last", "start_peak_end"] },
              "controlSources": { "type": "array", "minItems": 1, "items": { "type": "string" } },
              "controlReason": { "type": ["string", "null"] }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": false
      }
    },
    "distribution": {
      "type": "object",
      "required": ["publishAllowed", "activateAdsAllowed"],
      "properties": {
        "publishAllowed": { "const": false },
        "activateAdsAllowed": { "const": false }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
