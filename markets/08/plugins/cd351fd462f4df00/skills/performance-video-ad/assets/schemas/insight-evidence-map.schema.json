{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mymarketer.example/schemas/insight-evidence-map.schema.json",
  "type": "object",
  "required": ["schemaVersion", "sourceAssemblyVersion", "jobId", "offerId", "minimumInsightDepth", "insights"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "sourceAssemblyVersion": { "const": 1 },
    "jobId": { "type": "string", "minLength": 1 },
    "offerId": { "type": "string", "minLength": 1 },
    "minimumInsightDepth": { "type": "integer", "minimum": 1, "maximum": 6 },
    "insights": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "insight_id",
          "raw_observation",
          "source_refs",
          "surface_pain",
          "functional_tension",
          "social_stake",
          "emotional_or_identity_stake",
          "existing_workaround",
          "why_workaround_fails",
          "hidden_contradiction",
          "desired_progress",
          "product_mechanism",
          "proof_or_limit",
          "confidence",
          "insight_depth_level"
        ],
        "properties": {
          "insight_id": { "type": "string", "minLength": 1 },
          "raw_observation": { "type": "string", "minLength": 1 },
          "source_refs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "surface_pain": { "type": "string", "minLength": 1 },
          "functional_tension": { "type": "string", "minLength": 1 },
          "social_stake": { "type": "string", "minLength": 1 },
          "emotional_or_identity_stake": { "type": "string", "minLength": 1 },
          "existing_workaround": { "type": "string", "minLength": 1 },
          "why_workaround_fails": { "type": "string", "minLength": 1 },
          "hidden_contradiction": { "type": "string", "minLength": 1 },
          "desired_progress": { "type": "string", "minLength": 1 },
          "product_mechanism": { "type": "string", "minLength": 1 },
          "proof_or_limit": { "type": "string", "minLength": 1 },
          "confidence": { "enum": ["source_direct", "multi_source_synthesis", "voc_supported_hypothesis", "creative_hypothesis"] },
          "insight_depth_level": { "type": "integer", "minimum": 1, "maximum": 6 }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
