{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mymarketer.example/schemas/destination-contract.schema.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "destinationContractVersion",
    "jobId",
    "status",
    "destinationId",
    "url",
    "checkedAt",
    "pageTitle",
    "audience",
    "entryPromise",
    "freeConsult",
    "paidOffer",
    "proofBoundary",
    "trustSignals",
    "adContinuity",
    "sourceEvidence"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "destinationContractVersion": { "const": 1 },
    "jobId": { "type": "string", "minLength": 1 },
    "status": { "enum": ["DRAFT", "DESTINATION_REVIEWED", "STALE_RECHECK_REQUIRED"] },
    "destinationId": { "type": "string", "minLength": 1 },
    "url": { "type": "string", "format": "uri", "pattern": "^https://" },
    "checkedAt": { "type": "string", "format": "date-time" },
    "pageTitle": { "type": "string", "minLength": 1 },
    "audience": { "type": "string", "minLength": 1 },
    "entryPromise": { "type": "string", "minLength": 1 },
    "freeConsult": {
      "type": "object",
      "required": ["durationMinutes", "outcome", "ctaCopies", "semanticAction"],
      "properties": {
        "durationMinutes": { "type": "number", "exclusiveMinimum": 0 },
        "outcome": { "type": "string", "minLength": 1 },
        "ctaCopies": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "semanticAction": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "paidOffer": {
      "type": "object",
      "required": ["name", "outcome", "included", "excluded"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "priceCopy": { "type": ["string", "null"] },
        "deliveryCopy": { "type": ["string", "null"] },
        "outcome": { "type": "string", "minLength": 1 },
        "included": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "excluded": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": true
    },
    "proofBoundary": { "type": "string", "minLength": 1 },
    "trustSignals": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "adContinuity": {
      "type": "object",
      "required": [
        "adCtaCopy",
        "adCtaSemanticAction",
        "destinationCtaSemanticAction",
        "promiseRelation",
        "adClaims",
        "unsupportedClaims",
        "freePaidBoundaryPreserved"
      ],
      "properties": {
        "adCtaCopy": { "type": "string", "minLength": 1 },
        "adCtaSemanticAction": { "type": "string", "minLength": 1 },
        "destinationCtaSemanticAction": { "type": "string", "minLength": 1 },
        "promiseRelation": { "enum": ["equal_or_narrower", "stronger_than_destination", "unknown"] },
        "adClaims": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "unsupportedClaims": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "freePaidBoundaryPreserved": { "type": "boolean" },
        "visualContinuity": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": true
    },
    "sourceEvidence": {
      "type": "object",
      "required": ["type", "ref"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "ref": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
