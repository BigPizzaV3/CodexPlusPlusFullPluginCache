{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion", "jobId", "status", "options"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "jobId": { "type": "string", "minLength": 1 },
    "status": { "enum": ["DRAFT", "AWAITING_STRUCTURE_CONSULTATION", "REVISED", "APPROVED", "OPTIONAL_INTERNAL_EXPLORATION"] },
    "nonGating": { "type": "boolean" },
    "options": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "mechanism", "incident", "openingEvent0_2s", "hookCopy", "visualArc", "aiMotionValue", "deterministicFinish", "risk", "learningQuestion", "recommended"]
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "OPTIONAL_INTERNAL_EXPLORATION" } } },
      "then": {
        "required": ["nonGating"],
        "properties": { "nonGating": { "const": true } }
      }
    }
  ],
  "additionalProperties": true
}
