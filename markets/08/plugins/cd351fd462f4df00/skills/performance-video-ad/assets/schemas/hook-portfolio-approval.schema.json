{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mymarketer.example/schemas/hook-portfolio-approval.schema.json",
  "type": "object",
  "required": ["schemaVersion", "jobId", "decision", "approvalScope", "approvedPackageIds"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "jobId": { "type": "string", "minLength": 1 },
    "decision": { "enum": ["pending", "approved", "revisions_requested"] },
    "approvalScope": { "const": "HOOK_PORTFOLIO_AND_BODY_FAMILY" },
    "approvedPackageIds": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
  },
  "allOf": [
    {
      "if": { "properties": { "decision": { "const": "approved" } } },
      "then": {
        "required": ["portfolioId", "bodyFamilyId", "approvedBy", "approvedAt"],
        "properties": {
          "portfolioId": { "type": "string", "minLength": 1 },
          "bodyFamilyId": { "type": "string", "minLength": 1 },
          "approvedPackageIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } }
        }
      }
    }
  ],
  "additionalProperties": true
}
