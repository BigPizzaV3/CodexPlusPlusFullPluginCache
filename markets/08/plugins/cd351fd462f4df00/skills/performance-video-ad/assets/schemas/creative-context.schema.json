{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mymarketer.example/schemas/creative-context.schema.json",
  "type": "object",
  "required": ["schemaVersion", "jobId", "status", "market_type", "audience_temperature", "awareness_stage", "decision_stakes", "trust_requirement", "brand_familiarity", "audience_sophistication", "evidence_maturity", "platform", "historical_creative_signals", "sources"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "expressionPolicyVersion": { "type": "integer", "enum": [1, 2] },
    "jobId": { "type": "string", "minLength": 1 },
    "status": { "enum": ["DRAFT", "CONTEXT_CLASSIFIED"] },
    "market_type": { "type": ["string", "null"], "enum": ["b2b", "b2c", "b2b2c", null] },
    "audience_temperature": { "type": ["string", "null"], "enum": ["cold", "warm", "retargeting", "existing_customer", null] },
    "awareness_stage": { "type": ["string", "null"], "enum": ["unaware", "problem_aware", "solution_aware", "product_aware", "most_aware", null] },
    "decision_stakes": { "type": ["string", "null"], "enum": ["low", "medium", "high", null] },
    "trust_requirement": { "type": ["string", "null"], "enum": ["low", "medium", "high", null] },
    "brand_familiarity": { "type": ["string", "null"], "enum": ["unknown", "partially_known", "known", null] },
    "audience_sophistication": { "type": ["string", "null"], "enum": ["general", "informed", "expert", null] },
    "evidence_maturity": { "type": ["string", "null"], "enum": ["no_evidence", "mechanism_only", "qualitative_proof", "quantified_case_studies", "replicated_results", null] },
    "platform": { "type": ["string", "null"], "minLength": 1 },
    "campaign_objective": { "type": ["string", "null"] },
    "historical_creative_signals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "signal_type", "observation", "result", "confidence", "scope", "source"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "signal_type": { "enum": ["strong_visual_expression", "product_demonstration", "trend_wrapper", "other"] },
          "observation": { "type": "string", "minLength": 1 },
          "result": { "enum": ["underperformed", "outperformed", "mixed", "inconclusive"] },
          "confidence": { "enum": ["low", "medium", "high"] },
          "scope": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "sources": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "string", "minLength": 1 }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "expressionPolicyVersion": { "const": 2 } }, "required": ["expressionPolicyVersion"] },
      "then": { "required": ["expressionPolicyVersion"] }
    },
    {
      "if": { "properties": { "status": { "const": "CONTEXT_CLASSIFIED" } }, "required": ["status"] },
      "then": {
        "properties": {
          "market_type": { "enum": ["b2b", "b2c", "b2b2c"] },
          "audience_temperature": { "enum": ["cold", "warm", "retargeting", "existing_customer"] },
          "awareness_stage": { "enum": ["unaware", "problem_aware", "solution_aware", "product_aware", "most_aware"] },
          "decision_stakes": { "enum": ["low", "medium", "high"] },
          "trust_requirement": { "enum": ["low", "medium", "high"] },
          "brand_familiarity": { "enum": ["unknown", "partially_known", "known"] },
          "audience_sophistication": { "enum": ["general", "informed", "expert"] },
          "evidence_maturity": { "enum": ["no_evidence", "mechanism_only", "qualitative_proof", "quantified_case_studies", "replicated_results"] },
          "platform": { "type": "string", "minLength": 1 }
        }
      }
    }
  ],
  "additionalProperties": false
}
