{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mymarketer.jp/schemas/performance-video-sound-intent-map-v1.json",
  "title": "Performance video sound intent map",
  "type": "object",
  "required": ["schemaVersion", "jobId", "status", "platform", "expressionProfile", "fps", "durationFrames", "soundOnStrategy", "densityPolicy", "narrationWindows", "cueIntents", "silenceWindows", "motifs", "rightsPolicy", "checks"],
  "properties": {
    "schemaVersion": {"const": 1},
    "jobId": {"type": "string", "minLength": 1},
    "status": {"enum": ["DRAFT", "READY_FOR_PRODUCTION", "REVISE"]},
    "platform": {"type": "string", "minLength": 1},
    "expressionProfile": {"enum": ["restrained_b2b_social", "balanced_social_brand", "spectacle_experiment"]},
    "fps": {"type": "number", "exclusiveMinimum": 0},
    "durationFrames": {"type": "integer", "minimum": 1},
    "soundOnStrategy": {
      "type": "object",
      "required": ["assumption", "firstSoundByFrame", "firstSoundJob", "narrationPriority", "muteLegibilityRequired"],
      "properties": {
        "assumption": {"enum": ["sound_on_primary_mute_safe", "mixed_sound_state"]},
        "firstSoundByFrame": {"type": "integer", "minimum": 0},
        "firstSoundJob": {"type": "string", "minLength": 1},
        "narrationPriority": {"const": true},
        "muteLegibilityRequired": {"const": true}
      },
      "additionalProperties": false
    },
    "densityPolicy": {
      "type": "object",
      "required": ["mode", "selectionReason", "maxOnsetsPerSecond", "maxSimultaneousUnderNarration", "maxSimultaneousWithoutNarration", "maxEditorialAccentsPerBeat", "highDensityClusters"],
      "properties": {
        "mode": {"enum": ["restrained", "balanced", "entertainment_high"]},
        "selectionReason": {"type": "string", "minLength": 1},
        "maxOnsetsPerSecond": {"type": "integer", "minimum": 1, "maximum": 6},
        "maxSimultaneousUnderNarration": {"type": "integer", "minimum": 1, "maximum": 2},
        "maxSimultaneousWithoutNarration": {"type": "integer", "minimum": 1, "maximum": 4},
        "maxEditorialAccentsPerBeat": {"type": "integer", "minimum": 0, "maximum": 2},
        "highDensityClusters": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["clusterId", "startFrame", "endFrame", "purpose", "maximumOnsets"],
            "properties": {
              "clusterId": {"type": "string", "minLength": 1},
              "startFrame": {"type": "integer", "minimum": 0},
              "endFrame": {"type": "integer", "minimum": 1},
              "purpose": {"type": "string", "minLength": 1},
              "maximumOnsets": {"type": "integer", "minimum": 1, "maximum": 8}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "narrationWindows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["windowId", "beatId", "startFrame", "endFrame"],
        "properties": {
          "windowId": {"type": "string", "minLength": 1},
          "beatId": {"type": "string", "minLength": 1},
          "startFrame": {"type": "integer", "minimum": 0},
          "endFrame": {"type": "integer", "minimum": 1}
        },
        "additionalProperties": false
      }
    },
    "cueIntents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["intentId", "beatId", "role", "necessity", "triggerFrame", "visualCause", "viewerJob", "soundFamily", "desiredCharacter", "narrationOverlap", "maxOffsetFrames", "layerGroupId", "clusterId", "tags"],
        "properties": {
          "intentId": {"type": "string", "minLength": 1},
          "beatId": {"type": "string", "minLength": 1},
          "role": {"enum": ["causal", "informational", "structural", "rhythmic", "emotional", "brand", "ambience"]},
          "necessity": {"enum": ["required", "recommended", "optional"]},
          "triggerFrame": {"type": "integer", "minimum": 0},
          "visualCause": {"type": "string", "minLength": 1},
          "viewerJob": {"type": "string", "minLength": 1},
          "soundFamily": {"type": "string", "minLength": 1},
          "desiredCharacter": {"type": "string", "minLength": 1},
          "narrationOverlap": {"enum": ["none", "duck_required", "prohibited"]},
          "maxOffsetFrames": {"type": "integer", "minimum": 0, "maximum": 6},
          "layerGroupId": {"type": ["string", "null"]},
          "clusterId": {"type": ["string", "null"]},
          "tags": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        },
        "additionalProperties": false
      }
    },
    "silenceWindows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["windowId", "startFrame", "endFrame", "purpose", "absoluteForSfx"],
        "properties": {
          "windowId": {"type": "string", "minLength": 1},
          "startFrame": {"type": "integer", "minimum": 0},
          "endFrame": {"type": "integer", "minimum": 1},
          "purpose": {"type": "string", "minLength": 1},
          "absoluteForSfx": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    },
    "motifs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["motifId", "role", "soundFamily", "reusePolicy", "pitchVariationAllowed"],
        "properties": {
          "motifId": {"type": "string", "minLength": 1},
          "role": {"enum": ["repetition", "brand", "progression"]},
          "soundFamily": {"type": "string", "minLength": 1},
          "reusePolicy": {"type": "string", "minLength": 1},
          "pitchVariationAllowed": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    },
    "rightsPolicy": {
      "type": "object",
      "required": ["allowedSourceKinds", "commercialUseRequired", "licenseManifestRequired", "platformScopeVerificationRequired", "trademarkNotificationImitationProhibited", "randomWebDownloadProhibited"],
      "properties": {
        "allowedSourceKinds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["owned", "original_recording", "procedural", "licensed_library", "platform_library"]}},
        "commercialUseRequired": {"const": true},
        "licenseManifestRequired": {"const": true},
        "platformScopeVerificationRequired": {"const": true},
        "trademarkNotificationImitationProhibited": {"const": true},
        "randomWebDownloadProhibited": {"const": true}
      },
      "additionalProperties": false
    },
    "checks": {
      "type": "object",
      "required": ["everyCausalEventCovered", "everyCueHasViewerJob", "semanticCongruenceReviewed", "speechMaskingRiskReviewed", "silenceUsedIntentionally", "muteComprehensionPass"],
      "properties": {
        "everyCausalEventCovered": {"type": "boolean"},
        "everyCueHasViewerJob": {"type": "boolean"},
        "semanticCongruenceReviewed": {"type": "boolean"},
        "speechMaskingRiskReviewed": {"type": "boolean"},
        "silenceUsedIntentionally": {"type": "boolean"},
        "muteComprehensionPass": {"type": "boolean"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
