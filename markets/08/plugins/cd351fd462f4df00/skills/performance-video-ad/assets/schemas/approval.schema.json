{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion", "jobId", "decision", "paidRunAllowed", "maximumApprovedCostUsd", "maximumAttempts"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "jobId": { "type": "string", "minLength": 1 },
    "decision": { "enum": ["pending", "approved", "rejected"] },
    "paidRunAllowed": { "type": "boolean" },
    "maximumApprovedCostUsd": { "type": "number", "minimum": 0 },
    "maximumAttempts": { "type": "integer", "minimum": 1 }
  }
}
