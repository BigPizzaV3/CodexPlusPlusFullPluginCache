{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mymarketer.example/schemas/message-inheritance-contract.schema.json",
  "type": "object",
  "required": ["schemaVersion", "sourceAssemblyVersion", "jobId", "offerId", "categories"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "sourceAssemblyVersion": { "const": 1 },
    "messageInheritanceVersion": { "enum": [1, 2] },
    "jobId": { "type": "string", "minLength": 1 },
    "offerId": { "type": "string", "minLength": 1 },
    "stage_selection": {
      "type": "object",
      "required": ["funnel_role_contract_ref", "required_in_ad_categories", "optional_in_ad_categories", "intentionally_deferred_categories"],
      "properties": {
        "funnel_role_contract_ref": { "type": "string", "minLength": 1 },
        "required_in_ad_categories": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "optional_in_ad_categories": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "intentionally_deferred_categories": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": true
    },
    "categories": {
      "type": "object",
      "required": ["pain", "stakes", "failed_approach", "new_belief", "mechanism", "payoff", "cta_deliverable"],
      "additionalProperties": {
        "type": "object",
        "required": ["canonical_messages", "inherited_message_ids"],
        "properties": {
          "canonical_messages": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["message_id", "text", "source_refs"],
              "properties": {
                "message_id": { "type": "string", "minLength": 1 },
                "text": { "type": "string", "minLength": 1 },
                "source_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
              },
              "additionalProperties": true
            }
          },
          "inherited_message_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
