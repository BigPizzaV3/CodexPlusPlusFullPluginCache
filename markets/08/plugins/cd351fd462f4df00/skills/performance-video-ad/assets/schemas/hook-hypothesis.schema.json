{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mymarketer.example/schemas/hook-hypothesis.schema.json",
  "type": "object",
  "required": ["id", "family", "workIncident", "pain", "contradiction", "unresolvedQuestion", "productLinkage", "sourceEvidence"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "family": { "type": "string", "minLength": 1 },
    "workIncident": { "type": "string", "minLength": 1 },
    "pain": { "type": "string", "minLength": 1 },
    "contradiction": { "type": ["string", "null"] },
    "unresolvedQuestion": { "type": "string", "minLength": 1 },
    "productLinkage": { "type": "string", "minLength": 1 },
    "sourceEvidence": {
      "type": "object",
      "required": ["type", "ref"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "ref": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
