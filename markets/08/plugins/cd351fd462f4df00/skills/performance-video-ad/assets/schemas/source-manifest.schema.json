{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mymarketer.example/schemas/source-manifest.schema.json",
  "type": "object",
  "required": ["schemaVersion", "sourceAssemblyVersion", "jobId", "offerId", "sources"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "sourceAssemblyVersion": { "const": 1 },
    "jobId": { "type": "string", "minLength": 1 },
    "offerId": { "type": "string", "minLength": 1 },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "source_id",
          "source_type",
          "role",
          "canonical_level",
          "outcome_eligibility",
          "offer_id",
          "required",
          "path_or_ref",
          "version_or_hash",
          "read_status",
          "evidence_count",
          "used_in_insight_ids",
          "unused_reason"
        ],
        "properties": {
          "source_id": { "type": "string", "minLength": 1 },
          "source_type": { "type": "string", "minLength": 1 },
          "role": { "enum": ["canonical_offer", "market_voc", "field_validation", "background_only", "pipeline_requirement"] },
          "canonical_level": { "enum": ["user_designated_canonical", "approved_offer_decision", "offer_current_lp_or_spec", "offer_voc_research_or_interview", "global_project_strategy", "general_method_or_trend"] },
          "outcome_eligibility": { "enum": ["request_origin", "same_offer_authoritative", "ineligible"] },
          "offer_id": { "type": ["string", "null"] },
          "required": { "type": "boolean" },
          "path_or_ref": { "type": "string", "minLength": 1 },
          "version_or_hash": { "type": "string", "minLength": 1 },
          "read_status": { "enum": ["not_found", "not_read", "read", "read_but_no_evidence_extracted"] },
          "evidence_count": { "type": "integer", "minimum": 0 },
          "used_in_insight_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "unused_reason": { "type": ["string", "null"] }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
