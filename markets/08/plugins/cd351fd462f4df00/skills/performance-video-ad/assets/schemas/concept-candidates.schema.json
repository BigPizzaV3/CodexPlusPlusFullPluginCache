{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Performance Video Concept Candidates",
  "type": "object",
  "required": [
    "schemaVersion",
    "contractType",
    "jobId",
    "offerId",
    "salesThesisId",
    "status",
    "performanceClaim",
    "sourceContext",
    "candidatePolicy",
    "candidates",
    "decision",
    "distribution"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contractType": { "const": "performance_video_concept_candidates" },
    "jobId": { "type": "string", "minLength": 1 },
    "offerId": { "type": "string", "minLength": 1 },
    "salesThesisId": { "type": "string", "minLength": 1 },
    "status": { "enum": ["DRAFT", "AWAITING_TASTE", "SELECTED", "RETURN_TO_CONCEPT"] },
    "performanceClaim": { "const": false },
    "sourceContext": {
      "type": "object",
      "required": ["mode", "sourceJobRef", "canonicalSourceRefs", "checkedAt", "materialChangeStatus", "reuseReason"],
      "properties": {
        "mode": { "enum": ["fresh_lock", "verified_reuse"] },
        "sourceJobRef": { "type": ["string", "null"] },
        "canonicalSourceRefs": { "type": "array", "items": { "type": "string" } },
        "checkedAt": { "type": ["string", "null"] },
        "materialChangeStatus": { "enum": ["none", "resolved", "unresolved"] },
        "reuseReason": { "type": ["string", "null"] }
      }
    },
    "candidatePolicy": {
      "type": "object",
      "required": ["mode", "minimumCandidateCount", "userRequestedConceptComparison"],
      "properties": {
        "mode": { "enum": ["comparison", "user_supplied_preference"] },
        "minimumCandidateCount": { "type": "integer", "minimum": 1 },
        "userRequestedConceptComparison": { "type": "boolean" }
      }
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "conceptId",
          "title",
          "oneSentence",
          "openingEvent0_2s",
          "painfulSituation",
          "falseResponse",
          "surprisingReframe",
          "offerRole",
          "visibleCausalEvent",
          "requiredEndState",
          "motionCarriesMeaning",
          "mustReadCopy",
          "commercialStrength",
          "generationSolvability",
          "riskProfile",
          "routeRecommendation",
          "eligibility",
          "sourceRefs"
        ],
        "properties": {
          "conceptId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$" },
          "mustReadCopy": { "type": "array", "maxItems": 5 },
          "routeRecommendation": { "enum": ["one_shot_first", "one_shot_plus_finish", "controlled_sequence", "deterministic_demo", "blocked"] },
          "eligibility": { "enum": ["eligible_for_generation", "controlled_only", "blocked"] },
          "sourceRefs": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        }
      }
    },
    "decision": {
      "type": "object",
      "required": ["recommendedConceptId", "recommendationReason", "selectedConceptId", "selectionMode", "selectionReason", "humanTasteEvidence", "decidedAt"],
      "properties": {
        "selectionMode": { "enum": ["pending", "agent_selected", "human_selected", "user_supplied"] }
      }
    },
    "distribution": {
      "type": "object",
      "required": ["publishAllowed", "activateAdsAllowed"],
      "properties": {
        "publishAllowed": { "const": false },
        "activateAdsAllowed": { "const": false }
      }
    }
  },
  "additionalProperties": true
}
