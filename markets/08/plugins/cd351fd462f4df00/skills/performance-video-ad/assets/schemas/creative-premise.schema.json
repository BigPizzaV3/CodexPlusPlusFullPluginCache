{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mymarketer.example/schemas/creative-premise.schema.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "sourceAssemblyVersion",
    "jobId",
    "offerId",
    "status",
    "audience",
    "moment",
    "felt_problem",
    "feared_consequence",
    "false_solution",
    "surprising_truth",
    "product_revelation",
    "single_message",
    "source_refs",
    "insight_depth_level",
    "approval"
  ],
  "properties": {
    "schemaVersion": { "enum": [1, 2] },
    "sourceAssemblyVersion": { "const": 1 },
    "jobId": { "type": "string", "minLength": 1 },
    "offerId": { "type": "string", "minLength": 1 },
    "sales_thesis_id": { "type": "string", "minLength": 1 },
    "status": { "enum": ["DRAFT", "AWAITING_HUMAN_APPROVAL", "APPROVED", "REJECTED"] },
    "audience": { "type": "string", "minLength": 1 },
    "moment": { "type": "string", "minLength": 1 },
    "felt_problem": { "type": "string", "minLength": 1 },
    "feared_consequence": { "type": "string", "minLength": 1 },
    "false_solution": { "type": "string", "minLength": 1 },
    "surprising_truth": { "type": "string", "minLength": 1 },
    "product_revelation": { "type": "string", "minLength": 1 },
    "single_message": { "type": "string", "minLength": 1 },
    "source_refs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "insight_depth_level": { "type": "integer", "minimum": 1, "maximum": 6 },
    "approval": {
      "type": "object",
      "required": ["scope", "decision", "approvedBy", "approvedAt", "notes"],
      "properties": {
        "scope": { "const": "CREATIVE_PREMISE" },
        "decision": { "enum": ["pending", "approved", "rejected"] },
        "approvedBy": { "type": ["string", "null"] },
        "approvedAt": { "type": ["string", "null"], "format": "date-time" },
        "notes": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": {"properties": {"schemaVersion": {"const": 2}}},
      "then": {"required": ["sales_thesis_id"]}
    }
  ],
  "additionalProperties": true
}
