{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Performance Video One-shot Brief",
  "type": "object",
  "required": [
    "schemaVersion",
    "contractType",
    "jobId",
    "offerId",
    "salesThesisId",
    "conceptId",
    "primaryOutcome",
    "status",
    "routeDecision",
    "audience",
    "moment",
    "singleSellReason",
    "stopReason",
    "continueReason",
    "falseResponse",
    "surprisingReframe",
    "offerRole",
    "cta",
    "visualConcept",
    "semanticMotionArc",
    "mustReadCopy",
    "typographyPlan",
    "suitability",
    "modelFreedom",
    "exactnessFallback",
    "noGos",
    "sourceRefs",
    "distribution"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "contractType": { "const": "performance_video_one_shot_brief" },
    "jobId": { "type": "string", "minLength": 1 },
    "offerId": { "type": "string", "minLength": 1 },
    "salesThesisId": { "type": "string", "minLength": 1 },
    "conceptId": { "type": "string", "minLength": 1 },
    "primaryOutcome": {
      "type": "object",
      "required": ["status", "statement", "sourceRefs"],
      "properties": {
        "status": { "const": "grounded" },
        "statement": { "type": "string", "minLength": 1 },
        "sourceRefs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "status": { "enum": ["DRAFT", "NEEDS_SOURCE_INPUT", "READY_FOR_GENERATION"] },
    "routeDecision": { "enum": ["one_shot_first", "one_shot_plus_finish", "controlled_sequence", "deterministic_demo", "blocked"] },
    "semanticMotionArc": { "type": "array", "minItems": 4, "maxItems": 8 },
    "mustReadCopy": { "type": "array", "minItems": 1, "maxItems": 5 },
    "typographyPlan": {
      "type": "object",
      "required": ["strategy", "integratedKeywords", "exactSurfaces", "captionPolicy", "captionReason", "fallback"],
      "properties": {
        "strategy": { "enum": ["integrated_keyword_first", "exact_finish_first", "no_on_screen_text"] },
        "integratedKeywords": { "type": "array", "maxItems": 3 },
        "exactSurfaces": { "type": "array" },
        "captionPolicy": { "enum": ["none", "selective", "full_accessibility"] },
        "captionReason": { "type": "string", "minLength": 1 },
        "fallback": { "type": "string", "minLength": 1 }
      }
    },
    "distribution": {
      "type": "object",
      "required": ["publishAllowed", "activateAdsAllowed"],
      "properties": {
        "publishAllowed": { "const": false },
        "activateAdsAllowed": { "const": false }
      }
    }
  },
  "additionalProperties": true
}
