{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mymarketer.example/schemas/intended-reaction-map.schema.json",
  "type": "object",
  "required": ["schemaVersion","discoveryContractVersion","jobId","status","evidence_state","performance_claim","approval_does_not_prove_performance","reactions"],
  "properties": {
    "schemaVersion": {"const":1},
    "discoveryContractVersion": {"const":1},
    "jobId": {"type":"string","minLength":1},
    "status": {"enum":["DRAFT","HYPOTHESES_READY"]},
    "evidence_state": {"const":"planning_hypothesis"},
    "performance_claim": {"const":false},
    "approval_does_not_prove_performance": {"const":true},
    "reactions": {"type":"array","uniqueItems":true,"items":{"type":"object","required":["territory_id","reaction_at_0_5_sec","reaction_at_3_sec","reaction_at_end","reason_to_click","intentionally_unanswered_question"],"additionalProperties":false,"properties":{"territory_id":{"type":"string","minLength":1},"reaction_at_0_5_sec":{"type":"string","minLength":1},"reaction_at_3_sec":{"type":"string","minLength":1},"reaction_at_end":{"type":"string","minLength":1},"reason_to_click":{"type":"string","minLength":1},"intentionally_unanswered_question":{"type":"string","minLength":1}}}}
  },
  "additionalProperties": false
}
