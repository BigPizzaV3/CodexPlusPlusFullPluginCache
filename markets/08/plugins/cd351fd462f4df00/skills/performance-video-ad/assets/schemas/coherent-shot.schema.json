{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mymarketer.example/schemas/coherent-shot.schema.json",
  "type": "object",
  "required": [
    "schemaVersion", "jobId", "shotId", "status", "generationUnit",
    "durationSeconds", "aspectRatio", "oneSentenceIntent", "cameraSetup",
    "dominantEvent", "causalArc", "expressionControl", "controlBudget", "referencePack",
    "humanAnimatic", "aiResponsibilities", "deterministicResponsibilities",
    "promptKernel", "rawHeroQc", "paidExecution", "distribution"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "jobId": { "type": "string", "minLength": 1 },
    "shotId": { "type": "string", "minLength": 1 },
    "status": { "enum": ["AWAITING_HUMAN_PREPRODUCTION_REVIEW", "READY_FOR_PROVIDER_ROUTING", "GENERATED_AWAITING_RAW_REVIEW", "RAW_APPROVED", "REJECTED"] },
    "generationUnit": { "const": "coherent_shot" },
    "durationSeconds": { "type": "number", "exclusiveMinimum": 0, "maximum": 12 },
    "aspectRatio": { "enum": ["9:16", "1:1", "16:9"] },
    "oneSentenceIntent": { "type": "string", "minLength": 1 },
    "cameraSetup": { "type": "string", "minLength": 1 },
    "dominantEvent": { "type": "string", "minLength": 1 },
    "expressionControl": {
      "type": "object", "required": ["profile", "explicitUserPermission", "experimentPurpose"],
      "properties": {
        "profile": { "enum": ["restrained_b2b_social", "balanced_social_brand", "spectacle_experiment"] },
        "explicitUserPermission": { "type": "boolean" },
        "experimentPurpose": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "causalArc": {
      "type": "array", "minItems": 3, "maxItems": 5,
      "items": {
        "type": "object", "required": ["order", "timeWindow", "action"],
        "properties": {
          "order": { "type": "integer", "minimum": 1, "maximum": 5 },
          "timeWindow": { "type": "string", "minLength": 1 },
          "action": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "controlBudget": {
      "type": "object", "required": ["highRiskFactors", "exactUiInAi", "exactTextInAi", "decision"],
      "properties": {
        "highRiskFactors": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "exactUiInAi": { "const": false },
        "exactTextInAi": { "const": false },
        "decision": { "enum": ["reference_to_video_identity_only", "reference_to_video_with_frame_anchors", "reference_to_video_with_motion_driver", "image_to_video_with_motion_driver", "video_to_video_with_identity_references", "simplify_before_routing"] }
      },
      "additionalProperties": false
    },
    "referencePack": {
      "type": "array", "minItems": 2, "maxItems": 5,
      "items": {
        "type": "object", "required": ["role", "path", "conditioning"],
        "properties": {
          "role": { "enum": ["identity_front", "identity_three_quarter", "motion_driver", "first_frame", "last_frame", "scene_style"] },
          "path": { "type": "string", "minLength": 1 },
          "conditioning": { "type": "boolean" },
          "semantics": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "humanAnimatic": {
      "type": "object", "required": ["path", "conditioning", "role"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "conditioning": { "const": false },
        "role": { "const": "human_comprehension_and_timing_only" }
      },
      "additionalProperties": false
    },
    "aiResponsibilities": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "deterministicResponsibilities": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "promptKernel": {
      "type": "object", "required": ["subject", "event", "camera", "motionReferenceRule", "avoid"],
      "properties": {
        "subject": { "type": "string", "minLength": 1 },
        "event": { "type": "string", "minLength": 1 },
        "camera": { "type": "string", "minLength": 1 },
        "motionReferenceRule": { "enum": ["not_used", "motion_only"] },
        "avoid": { "type": "array", "minItems": 1, "maxItems": 12, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": false
    },
    "rawHeroQc": {
      "type": "object", "required": ["centralCausalEvent", "impactEnergy", "identityFidelity", "naturalSpeedReadability", "adjacentSurfaceContinuity", "humanDecision", "deviationPolicy"],
      "properties": {
        "centralCausalEvent": { "$ref": "#/$defs/qcState" },
        "impactEnergy": { "$ref": "#/$defs/qcState" },
        "identityFidelity": { "$ref": "#/$defs/qcState" },
        "naturalSpeedReadability": { "$ref": "#/$defs/qcState" },
        "adjacentSurfaceContinuity": { "$ref": "#/$defs/qcState" },
        "humanDecision": { "enum": ["pending", "approved", "rejected"] },
        "deviationPolicy": { "const": "fail_on_intent_loss" },
        "reviewedAt": { "type": "string", "minLength": 1 },
        "evidence": { "type": "string", "minLength": 1 },
        "rejectionReason": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": false
    },
    "paidExecution": {
      "type": "object", "required": ["allowed", "requiresFreshApproval"],
      "properties": {
        "allowed": { "type": "boolean" },
        "requiresFreshApproval": { "const": true },
        "maximumCostUsd": { "type": ["number", "null"], "minimum": 0 }
      },
      "additionalProperties": false
    },
    "distribution": {
      "type": "object", "required": ["publishAllowed", "activateAdsAllowed"],
      "properties": {
        "publishAllowed": { "const": false },
        "activateAdsAllowed": { "const": false }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "qcState": { "enum": ["NOT_RUN", "PASS", "FAIL"] }
  },
  "additionalProperties": false
}
