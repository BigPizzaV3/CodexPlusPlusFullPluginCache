{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mymarketer.jp/schemas/performance-video-visual-treatment-v1.json",
  "title": "Performance video visual treatment contract",
  "type": "object",
  "required": ["schemaVersion", "contractVersion", "contractType", "jobId", "status", "riskProfile", "treatments", "approval", "distribution"],
  "properties": {
    "schemaVersion": {"const": 1},
    "contractVersion": {"const": 1},
    "contractType": {"const": "performance_video_visual_treatment"},
    "jobId": {"type": "string", "minLength": 1},
    "status": {"enum": ["DRAFT", "AWAITING_TASTE", "APPROVED_FOR_FEASIBILITY", "REJECTED"]},
    "riskProfile": {
      "type": "object",
      "required": ["visualGrammarNovelty", "exactSurfaceSemanticLoad", "worldBindingRisk", "movingProofRequired", "reasons"],
      "properties": {
        "visualGrammarNovelty": {"enum": ["known", "new"]},
        "exactSurfaceSemanticLoad": {"enum": ["none", "supporting", "primary"]},
        "worldBindingRisk": {"enum": ["low", "medium", "high"]},
        "movingProofRequired": {"type": "boolean"},
        "reasons": {"type": "array", "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "treatments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["treatmentId", "title", "lookTarget", "motionGrammar", "semanticCarrierObjects", "finalLookFrames", "fallbackRoute"],
        "properties": {
          "treatmentId": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "lookTarget": {"type": "string", "minLength": 1},
          "motionGrammar": {
            "type": "object",
            "required": ["description", "chronologicalArc", "delegatedMotion"],
            "properties": {
              "description": {"type": "string", "minLength": 1},
              "chronologicalArc": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
              "delegatedMotion": {"type": "array", "items": {"type": "string", "minLength": 1}}
            },
            "additionalProperties": false
          },
          "semanticCarrierObjects": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "#/$defs/semanticCarrierObject"}
          },
          "finalLookFrames": {
            "type": "array",
            "items": {"$ref": "#/$defs/artifactRef"}
          },
          "fallbackRoute": {
            "type": "object",
            "required": ["description", "preservesViewerJob"],
            "properties": {
              "description": {"type": "string", "minLength": 1},
              "preservesViewerJob": {"const": true}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "approval": {
      "type": "object",
      "required": ["decision", "selectedTreatmentId", "approvedBy", "approvedAt"],
      "properties": {
        "decision": {"enum": ["pending", "approved", "rejected"]},
        "selectedTreatmentId": {"type": ["string", "null"]},
        "approvedBy": {"type": ["string", "null"]},
        "approvedAt": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "distribution": {"type": "object"}
  },
  "$defs": {
    "artifactRef": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      },
      "additionalProperties": false
    },
    "semanticCarrierObject": {
      "type": "object",
      "required": ["objectId", "viewerMeaning", "semanticCarrierType", "semanticSurfaceLoad", "surfacePersistence", "worldRelation", "contentAuthority", "geometryOwner", "motionOwner", "bindingMode", "exactnessWindows"],
      "properties": {
        "objectId": {"type": "string", "minLength": 1},
        "viewerMeaning": {"type": "string", "minLength": 1},
        "semanticCarrierType": {"enum": ["motion", "exact_surface", "character", "environment", "editing", "mixed"]},
        "semanticSurfaceLoad": {"enum": ["none", "supporting", "primary"]},
        "surfacePersistence": {"enum": ["transitional", "readable_anchor", "persistent", "background"]},
        "worldRelation": {"enum": ["screen_native", "world_bound"]},
        "contentAuthority": {"enum": ["deterministic", "generative", "not_applicable"]},
        "geometryOwner": {"enum": ["generated_object", "deterministic_surface", "deterministic_3d"]},
        "motionOwner": {"enum": ["generative", "deterministic", "tracked"]},
        "bindingMode": {"enum": ["screen_native", "planar_track", "corner_pin", "uv_texture_3d", "final_frame_repair", "motion_scaffold_v2v", "not_applicable"]},
        "exactnessWindows": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["startFrame", "endFrame", "readabilityRequired"],
            "properties": {
              "startFrame": {"type": "integer", "minimum": 0},
              "endFrame": {"type": "integer", "minimum": 1},
              "readabilityRequired": {"type": "boolean"}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
