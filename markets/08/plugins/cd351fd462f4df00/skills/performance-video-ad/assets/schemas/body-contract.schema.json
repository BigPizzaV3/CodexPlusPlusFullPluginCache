{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mymarketer.example/schemas/body-contract.schema.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "bodyContractVersion",
    "jobId",
    "status",
    "body_family_id",
    "promise_family",
    "hook_question_to_resolve",
    "belief_to_break",
    "new_belief",
    "mechanism",
    "visible_transformation",
    "concrete_payoff",
    "cta_deliverable",
    "max_concepts_per_beat",
    "matched_hook_ids",
    "comparison_boundary",
    "target_duration_seconds",
    "modules",
    "cta"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "bodyContractVersion": { "const": 1 },
    "hookBodyReuseVersion": { "type": ["integer", "null"], "enum": [1, null] },
    "semanticStrengthVersion": { "const": 1 },
    "funnelRoleBodyVersion": { "const": 1 },
    "desireArcVersion": { "const": 1 },
    "stage_role_mode": { "type": ["string", "null"], "enum": ["qualified_curiosity", "full_explainer", "proof_explainer", null] },
    "jobId": { "type": "string", "minLength": 1 },
    "status": { "enum": ["DRAFT_NOT_LOCKED", "READY_FOR_HUMAN_REVIEW", "LOCKED"] },
    "body_family_id": { "type": "string", "minLength": 1 },
    "promise_family": { "type": "string", "minLength": 1 },
    "hook_question_to_resolve": { "type": "string", "minLength": 1 },
    "hook_entry_contract": {
      "type": "object",
      "required": ["signature", "required_viewer_state", "required_open_question", "expected_body_answer", "allowed_variation", "new_body_triggers"],
      "properties": {
        "signature": { "type": "string", "minLength": 1 },
        "required_viewer_state": { "type": "string", "minLength": 1 },
        "required_open_question": { "type": "string", "minLength": 1 },
        "expected_body_answer": { "type": "string", "minLength": 1 },
        "allowed_variation": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["hook_copy", "opening_composition", "opening_event", "first_sound", "first_cut", "ui_surface", "incident_framing", "format_wrapper"] } },
        "new_body_triggers": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["promise", "open_question", "expected_body_answer", "proof_level", "cta", "desired_relief"] } }
      },
      "additionalProperties": false
    },
    "belief_to_break": { "type": "string", "minLength": 1 },
    "new_belief": { "type": "string", "minLength": 1 },
    "mechanism": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "visible_transformation": {
      "type": "object",
      "required": ["before", "after"],
      "properties": {
        "before": { "type": "string", "minLength": 1 },
        "after": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "concrete_payoff": { "type": "string", "minLength": 1 },
    "cta_deliverable": { "type": "string", "minLength": 1 },
    "max_concepts_per_beat": { "type": "integer", "minimum": 1, "maximum": 3 },
    "matched_hook_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "comparison_boundary": { "const": "WITHIN_BODY_FAMILY_ONLY" },
    "target_duration_seconds": { "type": "number", "exclusiveMinimum": 0 },
    "shared_end_card_id": { "type": ["string", "null"] },
    "semantic_arc": {
      "type": "object",
      "required": ["human_pain", "failed_response", "surprising_truth", "product_mechanism", "concrete_progress"],
      "properties": {
        "human_pain": { "type": "string", "minLength": 1 },
        "failed_response": { "type": "string", "minLength": 1 },
        "surprising_truth": { "type": "string", "minLength": 1 },
        "product_mechanism": { "type": "string", "minLength": 1 },
        "concrete_progress": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "claim_ladder": {
      "type": "object",
      "required": ["proven_deliverables", "mechanism_supported_possibilities", "prohibited_guarantees"],
      "properties": {
        "proven_deliverables": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "mechanism_supported_possibilities": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "prohibited_guarantees": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": false
    },
    "aha_contract": {
      "type": "object",
      "required": ["why_current_workaround_can_fail", "why_offer_changes_view", "aha_line", "open_loop", "source_refs"],
      "properties": {
        "why_current_workaround_can_fail": { "type": "string", "minLength": 1 },
        "why_offer_changes_view": { "type": "string", "minLength": 1 },
        "aha_line": { "type": "string", "minLength": 1 },
        "open_loop": { "type": "string", "minLength": 1 },
        "source_refs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": false
    },
    "over_safety_policy": {
      "type": "object",
      "required": ["language", "minimum_progress_phrases", "progress_phrases"],
      "properties": {
        "language": { "enum": ["ja", "en", "other"] },
        "minimum_progress_phrases": { "type": "integer", "minimum": 1 },
        "progress_phrases": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": false
    },
    "hope_contract": {
      "type": "object",
      "required": ["desired_relief", "rendered_hope_line", "intentionally_unanswered_question"],
      "properties": {
        "desired_relief": { "type": "string", "minLength": 1 },
        "rendered_hope_line": { "type": "string", "minLength": 1 },
        "intentionally_unanswered_question": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "comprehension_master": {
      "type": "object",
      "required": ["enabled", "target_duration_min_seconds", "target_duration_max_seconds", "compression_blocked_until_approved", "minimum_end_card_seconds"],
      "properties": {
        "enabled": { "type": "boolean" },
        "target_duration_min_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "target_duration_max_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "compression_blocked_until_approved": { "type": "boolean" },
        "minimum_end_card_seconds": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "diagnostic_demo": {
      "type": "object",
      "required": ["observations", "unknowns", "selected_next_check", "cause_conclusion", "cause_evidence_refs", "cause_assertion_requires_evidence"],
      "properties": {
        "observations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["stage", "status", "evidence_state"],
            "properties": {
              "stage": { "type": "string", "minLength": 1 },
              "status": { "type": "string", "minLength": 1 },
              "evidence_state": { "enum": ["observed", "unknown"] }
            },
            "additionalProperties": false
          }
        },
        "unknowns": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "selected_next_check": { "type": "string", "minLength": 1 },
        "cause_conclusion": { "type": ["string", "null"] },
        "cause_evidence_refs": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "cause_assertion_requires_evidence": { "const": true }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "cause_conclusion": { "type": "string" } }, "required": ["cause_conclusion"] },
          "then": { "properties": { "cause_evidence_refs": { "minItems": 1 } } }
        }
      ]
    },
    "modules": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": ["id", "role", "start_seconds", "end_seconds", "screen", "spoken_copy", "visual_action", "concept_count"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "role": { "enum": ["HOOK", "BRIDGE", "TENSION", "REFRAME", "HOPE", "INSIGHT", "PRODUCT_CATEGORY", "MECHANISM", "PAYOFF", "CTA"] },
          "start_seconds": { "type": "number", "minimum": 0 },
          "end_seconds": { "type": "number", "exclusiveMinimum": 0 },
          "screen": {
            "type": "object",
            "required": ["surface", "ui_labels"],
            "properties": {
              "surface": { "type": "string", "minLength": 1 },
              "ui_labels": {
                "type": "array",
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 }
              }
            },
            "additionalProperties": false
          },
          "spoken_copy": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "visual_action": { "type": "string", "minLength": 1 },
          "concept_count": { "type": "integer", "minimum": 1, "maximum": 3 }
        },
        "additionalProperties": false
      }
    },
    "cta": {
      "type": "object",
      "required": ["headline", "brand", "eyebrow", "button", "supporting_line", "trust_note"],
      "properties": {
        "headline": { "type": "string", "minLength": 1 },
        "brand": { "type": "string", "minLength": 1 },
        "eyebrow": { "type": "string", "minLength": 1 },
        "button": { "type": "string", "minLength": 1 },
        "supporting_line": { "type": "string", "minLength": 1 },
        "trust_note": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": { "properties": { "hookBodyReuseVersion": { "const": 1 } }, "required": ["hookBodyReuseVersion"] },
      "then": { "required": ["hook_entry_contract"] }
    },
    {
      "if": { "properties": { "funnelRoleBodyVersion": { "const": 1 } }, "required": ["funnelRoleBodyVersion"] },
      "then": { "required": ["stage_role_mode"] }
    },
    {
      "if": { "properties": { "semanticStrengthVersion": { "const": 1 } }, "required": ["semanticStrengthVersion"] },
      "then": { "required": ["semantic_arc", "claim_ladder", "aha_contract", "over_safety_policy", "comprehension_master"] }
    },
    {
      "if": { "properties": { "desireArcVersion": { "const": 1 } }, "required": ["desireArcVersion"] },
      "then": { "required": ["hope_contract"] }
    }
  ],
  "additionalProperties": false
}
