{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mymarketer.example/schemas/creative-tension-map.schema.json",
  "type": "object",
  "required": ["schemaVersion","discoveryContractVersion","jobId","status","tensions"],
  "properties": {
    "schemaVersion": {"const":1},
    "discoveryContractVersion": {"const":1},
    "jobId": {"type":"string","minLength":1},
    "status": {"enum":["DRAFT","READY_FOR_TERRITORIES"]},
    "tensions": {"type":"array","uniqueItems":true,"items":{"type":"object","required":["id","left_state","right_state","emotional_charge","unresolved_question","source_refs"],"properties":{"id":{"type":"string","minLength":1},"left_state":{"type":"string","minLength":1},"right_state":{"type":"string","minLength":1},"emotional_charge":{"type":"string","minLength":1},"unresolved_question":{"type":"string","minLength":1},"source_refs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}}},"additionalProperties":false}}
  },
  "additionalProperties": false
}
