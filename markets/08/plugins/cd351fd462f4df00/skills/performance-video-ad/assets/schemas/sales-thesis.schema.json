{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mymarketer.example/schemas/sales-thesis.schema.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "contractType",
    "salesThesisVersion",
    "jobId",
    "offerId",
    "salesThesisId",
    "status",
    "raw_moments",
    "product_concept",
    "communication_concept",
    "single_sell_reason",
    "attention_hypothesis",
    "sales_question_chain",
    "certainty",
    "performance_claim",
    "source_refs"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "contractType": {"const": "performance_video_sales_thesis"},
    "salesThesisVersion": {"const": 1},
    "jobId": {"type": "string", "minLength": 1},
    "offerId": {"type": "string", "minLength": 1},
    "salesThesisId": {"type": "string", "minLength": 1},
    "status": {"enum": ["DRAFT", "NEEDS_SOURCE_INPUT", "READY_FOR_PREMISE_APPROVAL"]},
    "raw_moments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "situation", "source_language", "derivation_type", "observable_behavior", "felt_stake", "source_refs"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "situation": {"type": "string", "minLength": 1},
          "source_language": {"type": "string", "minLength": 1},
          "derivation_type": {"enum": ["verbatim_quote", "paraphrase", "multi_source_synthesis"]},
          "observable_behavior": {"type": "string", "minLength": 1},
          "felt_stake": {"type": "string", "minLength": 1},
          "source_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        },
        "additionalProperties": true
      }
    },
    "product_concept": {
      "type": "object",
      "required": ["shorthand", "what_it_is", "customer_future", "reason_to_believe"],
      "properties": {
        "shorthand": {"type": "string", "minLength": 1},
        "what_it_is": {"type": "string", "minLength": 1},
        "customer_future": {"type": "string", "minLength": 1},
        "reason_to_believe": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "communication_concept": {"type": "string", "minLength": 1},
    "single_sell_reason": {"type": "string", "minLength": 1},
    "attention_hypothesis": {
      "type": "object",
      "required": ["stop_reason", "continue_reason"],
      "properties": {
        "stop_reason": {"type": "string", "minLength": 1},
        "continue_reason": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "sales_question_chain": {
      "type": "array",
      "minItems": 3,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["order", "viewer_question", "answer_job", "source_refs"],
        "properties": {
          "order": {"type": "integer", "minimum": 1},
          "viewer_question": {"type": "string", "minLength": 1},
          "answer_job": {"type": "string", "minLength": 1},
          "source_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        },
        "additionalProperties": true
      }
    },
    "certainty": {"const": "planning_hypothesis"},
    "performance_claim": {"const": false},
    "source_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  },
  "additionalProperties": true
}
