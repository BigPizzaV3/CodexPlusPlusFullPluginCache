{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mymarketer.example/schemas/structure-approval.schema.json",
  "type": "object",
  "required": ["schemaVersion", "jobId", "decision", "approvalScope", "selectedOptionId"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "jobId": { "type": "string", "minLength": 1 },
    "decision": { "enum": ["not_required", "pending", "approved", "revisions_requested"] },
    "approvalScope": { "const": "BATCH_DIRECTION_ONLY" },
    "nonGating": { "type": "boolean" },
    "selectedOptionId": { "type": ["string", "null"] }
  },
  "allOf": [
    {
      "if": { "properties": { "decision": { "const": "approved" } } },
      "then": { "properties": { "selectedOptionId": { "type": "string", "minLength": 1 } } }
    },
    {
      "if": { "properties": { "decision": { "const": "not_required" } } },
      "then": {
        "required": ["nonGating"],
        "properties": { "nonGating": { "const": true } }
      }
    }
  ],
  "additionalProperties": true
}
