{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mymarketer.example/schemas/insight-render-map.schema.json",
  "type": "object",
  "required": ["schemaVersion", "renderMapVersion", "jobId", "status", "scope", "body_family_id", "insights", "gate_status"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "renderMapVersion": { "const": 1 },
    "jobId": { "type": "string", "minLength": 1 },
    "status": { "enum": ["DRAFT", "READY_FOR_HUMAN_REVIEW", "VERIFIED"] },
    "scope": { "enum": ["CONTROLLED_BATCH", "SINGLE_MASTER_EXPLORATION"] },
    "body_family_id": { "type": "string", "minLength": 1 },
    "insights": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["insight_id", "insight", "importance", "source_refs", "rendered_at"],
        "properties": {
          "insight_id": { "type": "string", "minLength": 1 },
          "insight": { "type": "string", "minLength": 1 },
          "importance": { "enum": ["critical", "supporting"] },
          "source_refs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "rendered_at": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["beat_id", "mode", "evidence"],
              "properties": {
                "beat_id": { "type": "string", "minLength": 1 },
                "mode": { "enum": ["visual", "spoken", "ui", "sound"] },
                "evidence": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "gate_status": { "enum": ["PENDING", "PASS", "FAIL"] }
  },
  "additionalProperties": false
}
