{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mymarketer.example/schemas/copy-lineage.schema.json",
  "type": "object",
  "required": ["schemaVersion", "sourceAssemblyVersion", "jobId", "offerId", "status", "entries"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "sourceAssemblyVersion": { "const": 1 },
    "jobId": { "type": "string", "minLength": 1 },
    "offerId": { "type": "string", "minLength": 1 },
    "status": { "enum": ["BLOCKED_BY_PREMISE_APPROVAL", "READY", "VERIFIED"] },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["copy_id", "location", "text", "derivation_type", "source_refs", "evidence_strength"],
        "properties": {
          "copy_id": { "type": "string", "minLength": 1 },
          "location": { "type": "string", "minLength": 1 },
          "text": { "type": "string", "minLength": 1 },
          "derivation_type": { "enum": ["verbatim_quote", "paraphrase", "synthesized_copy", "creative_hypothesis"] },
          "source_refs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "evidence_strength": { "enum": ["source_direct", "multi_source_supported", "voc_supported_not_verbatim", "untested_creative_hypothesis"] },
          "delivery_scope": { "enum": ["planning_only", "ad", "destination"] },
          "stage_message_id": { "type": ["string", "null"] }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
