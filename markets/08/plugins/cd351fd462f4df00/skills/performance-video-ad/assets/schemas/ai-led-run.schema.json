{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mymarketer.example/schemas/ai-led-run.schema.json",
  "type": "object",
  "required": ["schemaVersion", "jobId", "status", "mode", "objective", "authority", "decisionLog", "internalReview", "performanceContract", "baseline", "distribution"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "jobId": { "type": "string", "minLength": 1 },
    "status": { "enum": ["DRAFT", "READY_FOR_HUMAN_LAST_MILE_REVIEW", "REVISE"] },
    "mode": { "const": "ai_led_creative_director" },
    "objective": { "const": "performance_ready_short_form_ad" },
    "authority": {
      "type": "object",
      "required": ["aiOwnedDecisions", "humanGates", "craftMicroDirectionsRequiredFromUser", "continueAutonomouslyWhenNonBlocking", "maximumQuestionsPerBlockingGate"],
      "properties": {
        "aiOwnedDecisions": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "humanGates": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "craftMicroDirectionsRequiredFromUser": { "const": false },
        "continueAutonomouslyWhenNonBlocking": { "const": true },
        "maximumQuestionsPerBlockingGate": { "type": "integer", "minimum": 1, "maximum": 3 }
      },
      "additionalProperties": false
    },
    "decisionLog": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["decisionId", "choice", "rationale", "sourceRefs", "confidence", "humanDirectionRequired"],
        "properties": {
          "decisionId": { "type": "string", "minLength": 1 },
          "choice": { "type": "string", "minLength": 1 },
          "rationale": { "type": "string", "minLength": 1 },
          "sourceRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "confidence": { "enum": ["high", "medium", "low"] },
          "humanDirectionRequired": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "internalReview": {
      "type": "object",
      "required": ["presentOnlyAfterInternalPass", "cycles"],
      "properties": {
        "presentOnlyAfterInternalPass": { "const": true },
        "cycles": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["reviewId", "result", "issuesFound", "issuesFixedBeforePresentation"],
            "properties": {
              "reviewId": { "enum": ["creative_performance_pass", "natural_speed_master_pass", "additional_pass"] },
              "result": { "enum": ["PASS", "REVISE"] },
              "issuesFound": { "type": "array", "items": { "type": "string" } },
              "issuesFixedBeforePresentation": { "type": "array", "items": { "type": "string" } }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "performanceContract": {
      "type": "object",
      "required": ["hypothesisId", "responseHypothesis", "primaryMetric", "guardrailMetrics", "variableModule", "fixedModules", "destinationContinuity", "campaignEvidenceStatus", "guaranteeMade"],
      "properties": {
        "hypothesisId": { "type": "string", "minLength": 1 },
        "responseHypothesis": { "type": "string", "minLength": 1 },
        "primaryMetric": { "type": "string", "minLength": 1 },
        "guardrailMetrics": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "variableModule": { "type": "string", "minLength": 1 },
        "fixedModules": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "destinationContinuity": { "enum": ["PASS", "REVISE", "NOT_RUN"] },
        "campaignEvidenceStatus": { "const": "NOT_RUN" },
        "guaranteeMade": { "const": false }
      },
      "additionalProperties": false
    },
    "baseline": {
      "type": "object",
      "required": ["artifactRef", "validation"],
      "properties": {
        "artifactRef": { "type": "string", "minLength": 1 },
        "validation": { "enum": ["PASS", "REVISE", "NOT_RUN"] }
      },
      "additionalProperties": false
    },
    "distribution": {
      "type": "object",
      "required": ["paidCallsRequireApproval", "publishAllowed", "activateAdsAllowed", "publicSkillDistributionAllowed"],
      "properties": {
        "paidCallsRequireApproval": { "const": true },
        "publishAllowed": { "const": false },
        "activateAdsAllowed": { "const": false },
        "publicSkillDistributionAllowed": { "const": false }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
