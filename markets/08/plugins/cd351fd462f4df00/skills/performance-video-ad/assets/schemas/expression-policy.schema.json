{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mymarketer.example/schemas/expression-policy.schema.json",
  "type": "object",
  "required": ["schemaVersion", "jobId", "status", "selected_expression_profile", "primary_attention_sources", "secondary_attention_sources", "prohibited_primary_attention_sources", "visual_intensity", "motion_density", "cognitive_load_limit", "work_native_priority", "trend_wrapper_policy", "spectacle_policy", "reasoning", "confidence", "source_fields"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "expressionPolicyVersion": { "type": "integer", "enum": [1, 2] },
    "jobId": { "type": "string", "minLength": 1 },
    "status": { "enum": ["DRAFT", "POLICY_RESOLVED"] },
    "selected_expression_profile": { "type": ["string", "null"], "enum": ["restrained_b2b_social", "balanced_social_brand", "spectacle_experiment", null] },
    "primary_attention_sources": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/attentionSource" } },
    "secondary_attention_sources": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/attentionSource" } },
    "prohibited_primary_attention_sources": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/attentionSource" } },
    "visual_intensity": { "$ref": "#/$defs/intensityOrNull" },
    "motion_density": { "$ref": "#/$defs/intensityOrNull" },
    "cognitive_load_limit": {
      "type": "object",
      "required": ["max_simultaneous_elements", "max_decisions_per_scene"],
      "properties": {
        "max_simultaneous_elements": { "type": ["integer", "null"], "minimum": 1 },
        "max_decisions_per_scene": { "type": ["integer", "null"], "minimum": 1 }
      },
      "additionalProperties": false
    },
    "work_native_priority": { "type": ["string", "null"], "enum": ["low", "medium", "high", null] },
    "trend_wrapper_policy": { "type": ["string", "null"], "enum": ["prohibited", "optional", "allowed", "preferred", null] },
    "spectacle_policy": { "type": ["string", "null"], "enum": ["prohibited", "experimental_only", "allowed", null] },
    "reasoning": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "confidence": { "type": ["string", "null"], "enum": ["low", "medium", "high", null] },
    "source_fields": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "resolution_rule": { "type": ["string", "null"] }
    ,
    "message_policy": {
      "type": ["object", "null"],
      "required": ["semantic_tension", "insight_strength", "surprise_required", "emotional_specificity", "claim_certainty"],
      "properties": {
        "semantic_tension": { "$ref": "#/$defs/intensityOrNull" },
        "insight_strength": { "$ref": "#/$defs/intensityOrNull" },
        "surprise_required": { "type": ["boolean", "null"] },
        "emotional_specificity": { "$ref": "#/$defs/intensityOrNull" },
        "claim_certainty": { "type": ["string", "null"], "enum": ["conservative", "calibrated", "assertive_evidence_backed", null] }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "attentionSource": {
      "enum": ["workplace_contradiction", "social_tension", "semantic_tension", "imminent_consequence", "product_demonstration", "proof_demonstration", "native_format", "restrained_visual_change", "visual_novelty", "spectacle", "cinematic_vfx", "destruction_metaphor"]
    },
    "intensityOrNull": { "type": ["string", "null"], "enum": ["low", "low_to_medium", "medium", "medium_to_high", "high", null] }
  },
  "allOf": [
    {
      "if": { "properties": { "expressionPolicyVersion": { "const": 2 } }, "required": ["expressionPolicyVersion"] },
      "then": {
        "required": ["message_policy"],
        "properties": {
          "message_policy": {
            "type": "object",
            "properties": {
              "semantic_tension": { "enum": ["low", "low_to_medium", "medium", "medium_to_high", "high"] },
              "insight_strength": { "enum": ["low", "low_to_medium", "medium", "medium_to_high", "high"] },
              "surprise_required": { "type": "boolean" },
              "emotional_specificity": { "enum": ["low", "low_to_medium", "medium", "medium_to_high", "high"] },
              "claim_certainty": { "enum": ["conservative", "calibrated", "assertive_evidence_backed"] }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "POLICY_RESOLVED" } }, "required": ["status"] },
      "then": {
        "properties": {
          "selected_expression_profile": { "enum": ["restrained_b2b_social", "balanced_social_brand", "spectacle_experiment"] },
          "primary_attention_sources": { "minItems": 1 },
          "visual_intensity": { "enum": ["low", "low_to_medium", "medium", "medium_to_high", "high"] },
          "motion_density": { "enum": ["low", "low_to_medium", "medium", "medium_to_high", "high"] },
          "work_native_priority": { "enum": ["low", "medium", "high"] },
          "trend_wrapper_policy": { "enum": ["prohibited", "optional", "allowed", "preferred"] },
          "spectacle_policy": { "enum": ["prohibited", "experimental_only", "allowed"] },
          "reasoning": { "minItems": 1 },
          "confidence": { "enum": ["low", "medium", "high"] },
          "source_fields": { "minItems": 1 },
          "resolution_rule": { "type": "string", "minLength": 1 },
          "cognitive_load_limit": {
            "properties": {
              "max_simultaneous_elements": { "type": "integer", "minimum": 1 },
              "max_decisions_per_scene": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
