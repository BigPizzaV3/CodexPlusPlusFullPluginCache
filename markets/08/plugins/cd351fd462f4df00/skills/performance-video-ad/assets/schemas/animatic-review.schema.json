{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mymarketer.example/schemas/animatic-review.schema.json",
  "type": "object",
  "required": ["schemaVersion", "jobId", "decision", "approvalScope", "portfolioId", "bodyFamilyId", "reviewedPackageIds", "animaticArtifacts", "checks", "reviewedBy", "reviewedAt"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "reviewContractVersion": { "type": "integer", "enum": [1, 2] },
    "jobId": { "type": "string", "minLength": 1 },
    "decision": { "enum": ["pending", "approved", "revisions_requested", "rejected"] },
    "approvalScope": { "const": "ANIMATIC_AND_PREPRODUCTION" },
    "portfolioId": { "type": ["string", "null"] },
    "bodyFamilyId": { "type": ["string", "null"] },
    "reviewedPackageIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "animaticArtifacts": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "candidateStatus": { "type": "string", "minLength": 1 },
    "renderedCandidatePackageIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "candidateManifest": { "type": "string", "minLength": 1 },
    "preHumanQc": { "type": "string", "minLength": 1 },
    "checks": {
      "type": "object",
      "required": ["businessTensionAt0_5s", "whoAndSituationBy2s", "vfxIndependentOrExperimental", "promiseContinuity", "muteLegibility", "cognitiveLoadWithinPolicy", "ctaDestinationContinuity", "trustPreserved"],
      "properties": {
        "businessTensionAt0_5s": { "$ref": "#/$defs/checkResult" },
        "whoAndSituationBy2s": { "$ref": "#/$defs/checkResult" },
        "vfxIndependentOrExperimental": { "$ref": "#/$defs/checkResult" },
        "promiseContinuity": { "$ref": "#/$defs/checkResult" },
        "muteLegibility": { "$ref": "#/$defs/checkResult" },
        "cognitiveLoadWithinPolicy": { "$ref": "#/$defs/checkResult" },
        "ctaDestinationContinuity": { "$ref": "#/$defs/checkResult" },
        "trustPreserved": { "$ref": "#/$defs/checkResult" }
        ,
        "ahaClarity": { "$ref": "#/$defs/checkResult" },
        "semanticExpectationCalibrated": { "$ref": "#/$defs/checkResult" },
        "insightRenderCoverage": { "$ref": "#/$defs/checkResult" },
        "pacingComprehension": { "$ref": "#/$defs/checkResult" }
      },
      "additionalProperties": false
    },
    "notes": { "type": "array", "items": { "type": "string" } },
    "approvalGranularity": {
      "type": "object",
      "required": ["approvedElements", "pendingElements", "revisionScope"],
      "properties": {
        "approvedElements": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "pendingElements": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "revisionScope": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "reviewedBy": { "type": ["string", "null"] },
    "reviewedAt": { "type": ["string", "null"], "format": "date-time" }
  },
  "$defs": {
    "checkResult": { "enum": ["PASS", "REVISE", "REJECT", "NOT_RUN"] }
  },
  "allOf": [
    {
      "if": { "properties": { "reviewContractVersion": { "const": 2 } }, "required": ["reviewContractVersion"] },
      "then": {
        "required": ["approvalGranularity"],
        "properties": {
          "checks": { "required": ["ahaClarity", "semanticExpectationCalibrated", "insightRenderCoverage", "pacingComprehension"] }
        }
      }
    },
    {
      "if": { "properties": { "decision": { "const": "approved" } }, "required": ["decision"] },
      "then": {
        "properties": {
          "portfolioId": { "type": "string", "minLength": 1 },
          "bodyFamilyId": { "type": "string", "minLength": 1 },
          "reviewedPackageIds": { "minItems": 1 },
          "animaticArtifacts": { "minItems": 1 },
          "checks": {
            "properties": {
              "businessTensionAt0_5s": { "const": "PASS" },
              "whoAndSituationBy2s": { "const": "PASS" },
              "vfxIndependentOrExperimental": { "const": "PASS" },
              "promiseContinuity": { "const": "PASS" },
              "muteLegibility": { "const": "PASS" },
              "cognitiveLoadWithinPolicy": { "const": "PASS" },
              "ctaDestinationContinuity": { "const": "PASS" },
              "trustPreserved": { "const": "PASS" }
              ,
              "ahaClarity": { "const": "PASS" },
              "semanticExpectationCalibrated": { "const": "PASS" },
              "insightRenderCoverage": { "const": "PASS" },
              "pacingComprehension": { "const": "PASS" }
            }
          },
          "reviewedBy": { "type": "string", "minLength": 1 },
          "reviewedAt": { "type": "string", "format": "date-time" }
        }
      }
    }
  ],
  "additionalProperties": false
}
