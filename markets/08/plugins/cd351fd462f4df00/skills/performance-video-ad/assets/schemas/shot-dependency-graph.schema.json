{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mymarketer.example/schemas/shot-dependency-graph.schema.json",
  "type": "object",
  "required": ["schemaVersion", "jobId", "status", "nodes", "edges", "distribution"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "jobId": { "type": "string", "minLength": 1 },
    "status": {
      "enum": [
        "DRAFT",
        "BLOCKED_BY_UPSTREAM_ACTUAL",
        "READY_FOR_ORDERED_GENERATION",
        "GENERATION_IN_PROGRESS",
        "ALL_RAW_SHOTS_APPROVED",
        "REJECTED"
      ]
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["shotId", "order", "executionMode", "executionStatus", "paidExecutionRequested", "dependsOnShotIds"],
        "properties": {
          "shotId": { "type": "string", "minLength": 1 },
          "order": { "type": "integer", "minimum": 0 },
          "executionMode": { "enum": ["deterministic", "paid_ai", "remotion_composite"] },
          "executionStatus": {
            "enum": [
              "not_started",
              "deterministic_approved",
              "paid_ready",
              "generated_pending_qc",
              "raw_approved",
              "raw_rejected"
            ]
          },
          "paidExecutionRequested": { "type": "boolean" },
          "dependsOnShotIds": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "actualOutputRef": { "type": ["string", "null"] },
          "actualFirstFrameRef": { "type": ["string", "null"] },
          "actualFirstFrameSha256": { "type": ["string", "null"] },
          "actualLastFrameRef": { "type": ["string", "null"] },
          "actualLastFrameSha256": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "fromShotId",
          "toShotId",
          "transitionMode",
          "continuityRequired",
          "upstreamFrame",
          "downstreamFrame",
          "actualFrameMatch",
          "transitionPreviewApproval"
        ],
        "properties": {
          "fromShotId": { "type": "string", "minLength": 1 },
          "toShotId": { "type": "string", "minLength": 1 },
          "transitionMode": { "enum": ["continuous", "match_cut", "hard_cut", "independent"] },
          "continuityRequired": { "type": "boolean" },
          "upstreamFrame": { "$ref": "#/$defs/frameEvidence" },
          "downstreamFrame": { "$ref": "#/$defs/frameEvidence" },
          "actualFrameMatch": { "enum": ["pending", "pass", "fail", "not_applicable"] },
          "transitionPreviewApproval": { "enum": ["pending", "approved", "rejected", "not_applicable"] }
        },
        "additionalProperties": false
      }
    },
    "distribution": {
      "type": "object",
      "required": ["publishAllowed", "activateAdsAllowed"],
      "properties": {
        "publishAllowed": { "const": false },
        "activateAdsAllowed": { "const": false }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "frameEvidence": {
      "type": "object",
      "required": ["source", "assetRef", "sha256", "status"],
      "properties": {
        "source": {
          "enum": [
            "actual_output_frame",
            "deterministic_actual_frame",
            "approved_input_frame",
            "candidate_still",
            "not_applicable"
          ]
        },
        "assetRef": { "type": ["string", "null"] },
        "sha256": { "type": ["string", "null"] },
        "status": { "enum": ["pending", "approved", "rejected", "not_applicable"] }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
