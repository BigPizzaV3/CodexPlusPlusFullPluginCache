{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mymarketer.example/schemas/context-resolution.schema.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "contextResolutionVersion",
    "jobId",
    "status",
    "required_fields",
    "source_attempts",
    "field_resolutions",
    "unresolved_blocking_fields",
    "questions_to_user"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contextResolutionVersion": { "const": 1 },
    "jobId": { "type": "string", "minLength": 1 },
    "status": { "enum": ["DRAFT", "READY", "NEEDS_USER_INPUT"] },
    "required_fields": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "source_attempts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_type", "ref", "retrieval_status", "authority_role"],
        "properties": {
          "source_type": {
            "enum": [
              "current_user_request",
              "user_designated_canonical",
              "approved_offer_decision",
              "offer_destination",
              "offer_research",
              "mymarketer_strategy",
              "conversation_memory",
              "general_method"
            ]
          },
          "ref": { "type": "string", "minLength": 1 },
          "retrieval_status": { "enum": ["read", "unavailable", "not_configured"] },
          "authority_role": { "enum": ["canonical", "approved_offer", "supporting", "background_only", "general_only"] },
          "staleness_checked": { "type": "boolean" },
          "notes": { "type": ["string", "null"] }
        },
        "additionalProperties": true
      }
    },
    "field_resolutions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["field_id", "blocking", "state", "value", "source_refs", "confidence", "question_id"],
        "properties": {
          "field_id": { "type": "string", "minLength": 1 },
          "blocking": { "type": "boolean" },
          "state": { "enum": ["resolved", "missing", "conflict", "low_confidence"] },
          "value": {},
          "source_refs": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "confidence": { "enum": ["source_confirmed", "user_confirmed", "multi_source_supported", "inferred", "unknown"] },
          "question_id": { "type": ["string", "null"] },
          "fallback_if_nonblocking": { "type": ["string", "number", "boolean", "object", "array", "null"] }
        },
        "additionalProperties": true
      }
    },
    "unresolved_blocking_fields": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "questions_to_user": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["question_id", "field_ids", "question", "decision_impact"],
        "properties": {
          "question_id": { "type": "string", "minLength": 1 },
          "field_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "question": { "type": "string", "minLength": 1 },
          "decision_impact": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
