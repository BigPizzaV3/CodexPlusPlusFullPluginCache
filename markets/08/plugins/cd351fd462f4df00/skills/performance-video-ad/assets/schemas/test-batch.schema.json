{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mymarketer.example/schemas/test-batch.schema.json",
  "type": "object",
  "required": ["schemaVersion", "jobId", "status", "batchId", "batchType", "minimumHookPackages", "fixedVariables", "testVariables"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "testSemanticsVersion": { "type": ["integer", "null"], "enum": [1, null] },
    "jobId": { "type": "string", "minLength": 1 },
    "batchId": { "type": "string", "minLength": 1 },
    "batchType": { "enum": ["baseline_build", "initial_hook_test", "single_revision", "production_pick"] },
    "minimumHookPackages": { "type": "integer", "minimum": 1 },
    "targetHookPackages": { "type": "integer", "minimum": 1 },
    "testType": {
      "enum": ["territory_baseline", "hook_package_discovery", "angle_discovery", "hook_execution_test", "trend_wrapper_test"]
    },
    "causalClaimScope": {
      "enum": ["baseline_only", "package_level_only", "angle_level", "execution_level", "wrapper_level"]
    },
    "layerContract": {
      "type": "object",
      "required": ["angleFixed", "executionFixed", "trendWrapperFixed"],
      "properties": {
        "angleFixed": { "type": "boolean" },
        "executionFixed": { "type": "boolean" },
        "trendWrapperFixed": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "shortlistPolicy": {
      "type": ["object", "null"],
      "required": ["gating", "learningUse", "maximumPackages"],
      "properties": {
        "gating": { "const": false },
        "learningUse": { "const": "EXPLORATION_ONLY" },
        "maximumPackages": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "selectedTerritoryId": { "type": ["string", "null"] },
    "fixedVariables": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "testVariables": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
  },
  "allOf": [
    {
      "if": { "properties": { "testSemanticsVersion": { "const": 1 } }, "required": ["testSemanticsVersion"] },
      "then": { "required": ["testType", "causalClaimScope", "layerContract"] }
    },
    {
      "if": { "properties": { "batchType": { "const": "baseline_build" } } },
      "then": {
        "required": ["targetHookPackages"],
        "properties": {
          "minimumHookPackages": { "const": 1 },
          "targetHookPackages": { "const": 1 }
        }
      }
    },
    {
      "if": { "properties": { "batchType": { "const": "initial_hook_test" } } },
      "then": {
        "required": ["targetHookPackages"],
        "properties": {
          "minimumHookPackages": { "minimum": 6 },
          "targetHookPackages": { "minimum": 8 }
        }
      }
    },
    {
      "if": { "properties": { "batchType": { "enum": ["single_revision", "production_pick"] } } },
      "then": {
        "required": ["sourcePortfolioId", "sourceHookPackageId"],
        "properties": {
          "sourcePortfolioId": { "type": "string", "minLength": 1 },
          "sourceHookPackageId": { "type": "string", "minLength": 1 }
        }
      }
    }
  ],
  "additionalProperties": true
}
