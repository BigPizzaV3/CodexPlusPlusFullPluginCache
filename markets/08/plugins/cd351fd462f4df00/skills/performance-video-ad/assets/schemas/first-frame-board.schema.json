{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mymarketer.example/schemas/first-frame-board.schema.json",
  "type": "object",
  "required": ["schemaVersion","discoveryContractVersion","jobId","status","targetFrames","displayTimeSeconds","frames"],
  "properties": {
    "schemaVersion": {"const":1},
    "discoveryContractVersion": {"const":1},
    "jobId": {"type":"string","minLength":1},
    "status": {"enum":["DRAFT","READY_FOR_TASTE_REVIEW"]},
    "targetFrames": {"type":"integer","minimum":12},
    "displayTimeSeconds": {"const":0.5},
    "frames": {"type":"array","uniqueItems":true,"items":{"type":"object","required":["id","territory_id","work_surface","dominant_visual","overlay_copy","opening_event","source_refs"],"additionalProperties":false,"properties":{"id":{"type":"string","minLength":1},"territory_id":{"type":"string","minLength":1},"work_surface":{"type":"string","minLength":1},"dominant_visual":{"type":"string","minLength":1},"overlay_copy":{"type":"string","minLength":1,"maxLength":32},"opening_event":{"type":"string","minLength":1},"source_refs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}}}}}
  },
  "additionalProperties": false
}
