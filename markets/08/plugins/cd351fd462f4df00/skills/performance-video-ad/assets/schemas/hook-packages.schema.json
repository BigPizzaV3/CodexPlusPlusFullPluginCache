{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mymarketer.example/schemas/hook-packages.schema.json",
  "type": "object",
  "required": ["schemaVersion", "jobId", "status", "portfolioId", "batchType", "bodyFamilyId", "minimumPackages", "portfolioMode", "fixedVariables", "testVariables", "learningQuestion", "packages"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "expressionContractVersion": { "type": ["integer", "null"], "enum": [2, null] },
    "hookModelVersion": { "const": 2 },
    "bodyContractVersion": { "type": ["integer", "null"], "enum": [1, null] },
    "hookBodyReuseVersion": { "type": ["integer", "null"], "enum": [1, null] },
    "testSemanticsVersion": { "type": ["integer", "null"], "enum": [1, null] },
    "testType": { "enum": ["territory_baseline", "hook_package_discovery", "angle_discovery", "hook_execution_test", "trend_wrapper_test"] },
    "causalClaimScope": { "enum": ["baseline_only", "package_level_only", "angle_level", "execution_level", "wrapper_level"] },
    "jobId": { "type": "string", "minLength": 1 },
    "portfolioId": { "type": "string", "minLength": 1 },
    "batchType": { "enum": ["baseline_build", "initial_hook_test", "single_revision", "production_pick"] },
    "creativeTerritoryId": { "type": ["string", "null"] },
    "bodyFamilyId": { "type": ["string", "null"] },
    "bodyFamilyMode": { "type": ["string", "null"], "enum": ["single_fixed", "consultation_cohorts", null] },
    "bodyFamilyIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "bodyContractFiles": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["bodyFamilyId", "file"],
        "properties": {
          "bodyFamilyId": { "type": "string", "minLength": 1 },
          "file": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "comparisonPolicy": { "type": ["string", "null"], "enum": ["WITHIN_BODY_FAMILY_ONLY", null] },
    "minimumPackages": { "type": "integer", "minimum": 1 },
    "targetPackages": { "type": "integer", "minimum": 1 },
    "portfolioMode": { "enum": ["grounded_only", "balanced_default", "trend_exploration"] },
    "expression_profile": { "type": ["string", "null"], "enum": ["restrained_b2b_social", "balanced_social_brand", "spectacle_experiment", null] },
    "selectionCriteria": {
      "const": ["who_relevance", "problem_understanding_within_2s", "unresolved_question", "offer_connection", "trust", "compatible_body_connection", "production_ease", "visual_novelty"]
    },
    "diversityPolicy": {
      "type": "object",
      "required": ["maxSameHypothesisFamily", "maxSameVisualGrammar", "minWorkNativeHooks", "maxTrendWrappedShare", "maxSpectacleShare", "spectacleRequiresExplicitExperiment"],
      "properties": {
        "maxSameHypothesisFamily": { "type": "integer", "minimum": 1 },
        "maxSameVisualGrammar": { "type": "integer", "minimum": 1 },
        "minWorkNativeHooks": { "type": "integer", "minimum": 0 },
        "maxTrendWrappedShare": { "type": "number", "minimum": 0, "maximum": 1 },
        "maxSpectacleShare": { "type": "number", "minimum": 0, "maximum": 1 },
        "spectacleRequiresExplicitExperiment": { "const": true }
      },
      "additionalProperties": false
    },
    "fixedVariables": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "testVariables": { "const": ["hook_package"] },
    "learningQuestion": { "type": ["string", "null"] },
    "packages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "mechanism", "incidentId", "formatOrigin", "hookCopy", "openingComposition", "openingEvent", "firstSound", "firstCutSeconds", "sourceEvidence", "learningRationale"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "mechanism": { "type": "string", "minLength": 1 },
          "incidentId": { "type": "string", "minLength": 1 },
          "formatOrigin": { "enum": ["grounded_evergreen", "trend_adapted", "experimental"] },
          "hookCopy": { "type": "string", "minLength": 1 },
          "openingComposition": { "type": "string", "minLength": 1 },
          "openingEvent": { "type": "string", "minLength": 1 },
          "firstSound": { "type": "string", "minLength": 1 },
          "firstCutSeconds": { "type": "number", "exclusiveMinimum": 0 },
          "sourceEvidence": {
            "type": "object",
            "required": ["type", "ref"],
            "properties": {
              "type": { "type": "string", "minLength": 1 },
              "ref": { "type": "string", "minLength": 1 }
            }
          },
          "learningRationale": { "type": "string", "minLength": 1 },
          "hypothesisId": { "type": "string", "minLength": 1 },
          "hypothesisFamily": { "type": "string", "minLength": 1 },
          "promiseFamily": { "type": "string", "minLength": 1 },
          "matchedBodyFamilyId": { "type": "string", "minLength": 1 },
          "bodyEntryCompatibility": {
            "type": "object",
            "required": ["signature", "viewerState", "openQuestion", "expectedBodyAnswer", "decision", "reason"],
            "properties": {
              "signature": { "type": "string", "minLength": 1 },
              "viewerState": { "type": "string", "minLength": 1 },
              "openQuestion": { "type": "string", "minLength": 1 },
              "expectedBodyAnswer": { "type": "string", "minLength": 1 },
              "decision": { "enum": ["PASS", "NEW_BODY_REQUIRED"] },
              "reason": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          },
          "testSignatures": {
            "type": "object",
            "required": ["angle", "execution", "trendWrapper"],
            "properties": {
              "angle": { "type": "string", "minLength": 1 },
              "execution": { "type": "string", "minLength": 1 },
              "trendWrapper": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          },
          "audiencePreconditions": {
            "type": "object",
            "required": ["applicability", "requiredDataVisibility", "interpretationRisk"],
            "properties": {
              "applicability": { "enum": ["broad", "conditional"] },
              "requiredDataVisibility": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "enum": ["none", "ad_platform", "analytics", "crm", "sales_outcome", "measurement_change_log", "client_feedback", "proposal_history"]
                }
              },
              "interpretationRisk": { "type": ["string", "null"] }
            },
            "additionalProperties": true
          },
          "expression_profile": { "enum": ["restrained_b2b_social", "balanced_social_brand", "spectacle_experiment"] },
          "candidateStatus": { "enum": ["lead_candidate", "candidate", "conditional_candidate", "experimental_only"] },
          "primaryRecommendationReason": { "enum": ["who_relevance", "problem_understanding_within_2s", "unresolved_question", "offer_connection", "trust", "compatible_body_connection"] },
          "expressionControl": {
            "type": "object",
            "required": ["vfxIndependent", "problemUnderstoodBySeconds", "painBeforeSpectacle", "realisticWorkSurface", "workSurface", "sceneActions", "cameraGrammar", "soundIntensity", "brandTreatment", "explicitUserPermission", "experimentPurpose"],
            "properties": {
              "vfxIndependent": { "type": "boolean" },
              "problemUnderstoodBySeconds": { "type": "number", "minimum": 0, "maximum": 2 },
              "painBeforeSpectacle": { "type": "boolean" },
              "realisticWorkSurface": { "type": "boolean" },
              "workSurface": { "enum": ["pc_ui", "smartphone_ui", "document", "chat", "calendar", "screen_recording", "meeting"] },
              "sceneActions": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "type": "string", "minLength": 1 } },
              "cameraGrammar": { "enum": ["locked", "simple_push", "hard_cut", "screen_recording", "moderate_brand_transition", "cinematic_transform"] },
              "soundIntensity": { "enum": ["low", "moderate", "high"] },
              "brandTreatment": { "enum": ["end_card_primary", "restrained_throughout", "experiment_defined"] },
              "explicitUserPermission": { "type": "boolean" },
              "experimentPurpose": { "type": ["string", "null"] }
            },
            "additionalProperties": false
          },
          "execution": {
            "type": "object",
            "required": ["id", "visualGrammar", "openingEvent", "sound", "transition", "format", "workSurface", "primaryAttentionSource", "secondaryAttentionSources", "visualIntensity", "motionDensity", "simultaneousElements", "decisionsPerScene", "vfxIndependent", "trendWrapper"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "visualGrammar": { "type": "string", "minLength": 1 },
              "openingEvent": { "type": "string", "minLength": 1 },
              "sound": { "type": "string", "minLength": 1 },
              "transition": { "type": "string", "minLength": 1 },
              "format": { "type": "string", "minLength": 1 },
              "workSurface": { "enum": ["pc_ui", "smartphone_ui", "document", "chat", "calendar", "screen_recording", "meeting"] },
              "primaryAttentionSource": { "type": "string", "minLength": 1 },
              "secondaryAttentionSources": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
              "visualIntensity": { "enum": ["low", "low_to_medium", "medium", "medium_to_high", "high"] },
              "motionDensity": { "enum": ["low", "low_to_medium", "medium", "medium_to_high", "high"] },
              "simultaneousElements": { "type": "integer", "minimum": 1 },
              "decisionsPerScene": { "type": "integer", "minimum": 1 },
              "vfxIndependent": { "type": "boolean" },
              "trendWrapper": {
                "type": "object",
                "required": ["applied", "type"],
                "properties": {
                  "applied": { "type": "boolean" },
                  "type": { "type": ["string", "null"] }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": true
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "hookBodyReuseVersion": { "const": 1 } },
        "required": ["hookBodyReuseVersion"]
      },
      "then": {
        "properties": {
          "packages": {
            "items": {
              "required": ["bodyEntryCompatibility"]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "testSemanticsVersion": { "const": 1 } },
        "required": ["testSemanticsVersion"]
      },
      "then": {
        "required": ["testType", "causalClaimScope"],
        "properties": {
          "packages": {
            "items": {
              "required": ["testSignatures", "audiencePreconditions"]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "hookModelVersion": { "const": 2 } },
        "required": ["hookModelVersion"]
      },
      "then": {
        "required": ["diversityPolicy"],
        "properties": {
          "packages": {
            "items": {
              "required": ["hypothesisId", "hypothesisFamily", "execution"]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "bodyContractVersion": { "const": 1 } },
        "required": ["bodyContractVersion"]
      },
      "then": {
        "required": ["bodyFamilyMode", "bodyFamilyIds", "bodyContractFiles", "comparisonPolicy"],
        "properties": {
          "comparisonPolicy": { "const": "WITHIN_BODY_FAMILY_ONLY" },
          "bodyFamilyIds": { "minItems": 1 },
          "bodyContractFiles": { "minItems": 1 },
          "packages": {
            "items": {
              "required": ["promiseFamily", "matchedBodyFamilyId"]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "bodyFamilyMode": { "const": "consultation_cohorts" } },
        "required": ["bodyFamilyMode"]
      },
      "then": {
        "properties": {
          "bodyFamilyId": { "type": "null" },
          "bodyFamilyIds": { "minItems": 2 }
        }
      }
    },
    {
      "if": {
        "properties": { "bodyFamilyMode": { "const": "single_fixed" } },
        "required": ["bodyFamilyMode"]
      },
      "then": {
        "properties": {
          "bodyFamilyId": { "type": "string", "minLength": 1 },
          "bodyFamilyIds": { "minItems": 1, "maxItems": 1 }
        }
      }
    },
    {
      "if": {
        "properties": { "batchType": { "const": "baseline_build" } },
        "required": ["batchType"]
      },
      "then": {
        "required": ["targetPackages"],
        "properties": {
          "minimumPackages": { "const": 1 },
          "targetPackages": { "const": 1 },
          "packages": { "maxItems": 1 }
        }
      }
    },
    {
      "if": {
        "properties": { "batchType": { "const": "initial_hook_test" } },
        "required": ["batchType"]
      },
      "then": {
        "required": ["targetPackages"],
        "properties": {
          "minimumPackages": { "minimum": 6 },
          "targetPackages": { "minimum": 8 }
        }
      }
    },
    {
      "if": {
        "properties": { "expressionContractVersion": { "const": 2 } },
        "required": ["expressionContractVersion"]
      },
      "then": {
        "required": ["expression_profile", "selectionCriteria"],
        "properties": {
          "expression_profile": { "enum": ["restrained_b2b_social", "balanced_social_brand", "spectacle_experiment"] },
          "packages": {
            "items": {
              "required": ["expression_profile", "candidateStatus", "primaryRecommendationReason", "expressionControl"]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "batchType": { "const": "initial_hook_test" },
          "status": { "enum": ["HOOK_PORTFOLIO_READY", "AWAITING_HOOK_PORTFOLIO_APPROVAL", "APPROVED"] }
        },
        "required": ["batchType", "status"]
      },
      "then": {
        "properties": {
          "bodyFamilyId": { "type": "string", "minLength": 1 },
          "packages": { "minItems": 6 }
        }
      }
    }
  ],
  "additionalProperties": true
}
