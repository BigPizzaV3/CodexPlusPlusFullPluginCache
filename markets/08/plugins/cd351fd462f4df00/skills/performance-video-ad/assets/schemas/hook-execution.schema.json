{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mymarketer.example/schemas/hook-execution.schema.json",
  "type": "object",
  "required": ["id", "visualGrammar", "openingEvent", "sound", "transition", "format", "workSurface", "primaryAttentionSource", "secondaryAttentionSources", "visualIntensity", "motionDensity", "simultaneousElements", "decisionsPerScene", "vfxIndependent", "trendWrapper"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "visualGrammar": { "type": "string", "minLength": 1 },
    "openingEvent": { "type": "string", "minLength": 1 },
    "sound": { "type": "string", "minLength": 1 },
    "transition": { "type": "string", "minLength": 1 },
    "format": { "type": "string", "minLength": 1 },
    "workSurface": { "enum": ["pc_ui", "smartphone_ui", "document", "chat", "calendar", "screen_recording", "meeting"] },
    "primaryAttentionSource": { "enum": ["workplace_contradiction", "social_tension", "semantic_tension", "imminent_consequence", "product_demonstration", "proof_demonstration", "native_format", "restrained_visual_change", "visual_novelty", "spectacle", "cinematic_vfx", "destruction_metaphor"] },
    "secondaryAttentionSources": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "visualIntensity": { "enum": ["low", "low_to_medium", "medium", "medium_to_high", "high"] },
    "motionDensity": { "enum": ["low", "low_to_medium", "medium", "medium_to_high", "high"] },
    "simultaneousElements": { "type": "integer", "minimum": 1 },
    "decisionsPerScene": { "type": "integer", "minimum": 1 },
    "vfxIndependent": { "type": "boolean" },
    "trendWrapper": {
      "type": "object",
      "required": ["applied", "type"],
      "properties": {
        "applied": { "type": "boolean" },
        "type": { "type": ["string", "null"] }
      },
      "allOf": [
        {
          "if": { "properties": { "applied": { "const": true } }, "required": ["applied"] },
          "then": { "properties": { "type": { "type": "string", "minLength": 1 } } },
          "else": { "properties": { "type": { "type": "null" } } }
        }
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
