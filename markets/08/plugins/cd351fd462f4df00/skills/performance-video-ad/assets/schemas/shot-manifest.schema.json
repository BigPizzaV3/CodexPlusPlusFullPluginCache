{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion", "jobId", "status", "shots"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "jobId": { "type": "string", "minLength": 1 },
    "shots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "generationMode", "duration", "exactTextRequirement", "privacyLevel", "fallback"]
      }
    }
  }
}
