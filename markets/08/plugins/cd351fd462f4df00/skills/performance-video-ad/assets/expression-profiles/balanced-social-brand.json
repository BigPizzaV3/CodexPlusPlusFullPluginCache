{
  "schemaVersion": 1,
  "id": "balanced_social_brand",
  "status": "active",
  "description": "実務画面を中心に保ちながら、1つだけ節度あるブランドトランジションや色面を加える表現。",
  "priorities": [
    "WHOへの関連性",
    "2秒以内の問題理解",
    "実務画面とブランドの両立",
    "単一のブランドモーション",
    "信頼感"
  ],
  "workSurfaces": ["pc_ui", "smartphone_ui", "document", "chat", "calendar", "screen_recording", "meeting"],
  "motionRules": {
    "maxSceneActions": 2,
    "allowedCameraGrammar": ["locked", "simple_push", "hard_cut", "screen_recording", "moderate_brand_transition"],
    "allowedSoundIntensity": ["low", "moderate"],
    "brandTreatment": "restrained_throughout",
    "prohibitedPatterns": ["画面破壊", "モニターへの激突", "モニターへ激突", "激突", "巨大空間への落下", "継続的なカメラワープ", "複数の高速アニメーション", "strong flare", "camera warp"]
  },
  "soundDesignRules": {
    "densityMode": "balanced",
    "maxOnsetsPerSecond": 4,
    "maxSimultaneousUnderNarration": 2,
    "maxSimultaneousWithoutNarration": 3,
    "maxEditorialAccentsPerBeat": 1,
    "allowedCueRoles": ["causal", "informational", "structural", "rhythmic", "emotional", "brand", "ambience"],
    "highDensityClusterRequiresPurpose": true,
    "narrationPriority": true,
    "muteLegibilityRequired": true
  },
  "creativeChecks": {
    "vfxIndependentRequired": true,
    "problemUnderstoodBySeconds": 2,
    "painBeforeSpectacle": true,
    "realisticWorkSurfaceRequired": true
  },
  "portfolioPolicy": {
    "default": false,
    "minimumPerEight": 0,
    "maximumPerEight": 8,
    "requiresPermissionOrPurpose": false
  }
}
