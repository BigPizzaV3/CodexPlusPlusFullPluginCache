{
  "schemaVersion": 2,
  "policyId": "mymarketer.optional-connected-quality.v2",
  "resource": "/mcp/quality",
  "accessModel": "read_only_by_default_explicit_save_only",
  "unconnectedMode": {
    "behavior": "complete_with_user_input_general_knowledge_and_local_skills",
    "authenticationRequired": false,
    "probeUnavailableTools": false,
    "showConnectionFailure": false
  },
  "connectedMode": {
    "requiredCapability": "quality_preview",
    "requiredReadTools": [
      "listProjects",
      "prepareMarketingJobPreview",
      "getProductionGuidanceInputs",
      "getDeliverableReviewRubric"
    ],
    "requireSameActiveMyMarketerConnection": true,
    "neverGuessToolAvailability": true,
    "ambiguousProject": "ask_one_focused_project_question",
    "previewContract": {
      "protocolVersion": "preview-v1",
      "directionCount": 3,
      "reviewAuthority": "host",
      "maxAutomaticRevisions": 1,
      "persistence": "none"
    },
    "contextFingerprint": {
      "passUnchangedTo": ["getProductionGuidanceInputs", "getDeliverableReviewRubric"],
      "onContextChanged": "restart_from_prepareMarketingJobPreview"
    },
    "contextDelivery": {
      "sourceTool": "prepareMarketingJobPreview",
      "referenceTools": ["getProductionGuidanceInputs", "getDeliverableReviewRubric"],
      "optionalArgument": {"contextMode": "reference"},
      "requireAdvertisedSchemaSupport": true,
      "requireCompletePreviewInCurrentRun": true,
      "requireSameConnectionProjectAndFingerprint": true,
      "resolveReferenceFieldsFromPreviewContext": true,
      "missingPreviewAction": "reacquire_preview_once_or_free_fallback",
      "unsupportedSchemaAction": "omit_contextMode_use_legacy_inline",
      "neverInterpretReferenceAsEmptyConstraints": true
    },
    "hostWorkflow": [
      "create_three_grounded_directions",
      "obtain_one_user_selection",
      "create_deliverable_in_host",
      "self_review_with_returned_rubric",
      "revise_at_most_once_only_if_needed",
      "re_review_before_completion"
    ],
    "backendAiGeneration": "forbidden",
    "backendPreviewPersistence": "forbidden"
  },
  "handoff": {
    "preserveAcrossSkills": ["grounded_original_outcome", "approved_decisions", "claim_boundaries", "cta", "project_identity", "context_fingerprint", "selected_direction"],
    "neverReinterpretWithoutUserApproval": true
  },
  "writeSafety": {
    "initialOauthScope": "mcp:read",
    "explicitConfirmationRequiredBefore": ["saveDeliverableV1", "saveTacticArtifact", "create_or_propose_tactic", "recordDecision", "recordLearning", "evaluateExperiment", "publish", "activate_ads", "external_paid_action"],
    "saveTool": "saveDeliverableV1",
    "saveRequiresAdditionalScope": "mcp:write",
    "saveRequiresCapability": "deliverable_save",
    "oauthWriteScopeIsNotActionApproval": true,
    "humanApprovalRequiredForVerifiedLearning": true,
    "legacyMixedPreviewPersistTools": "do_not_use_for_automatic_quality_work"
  },
  "learning": {
    "requireActualPerformanceData": true,
    "forbidInventedResults": true,
    "orderAfterConfirmedResults": ["recordLearning", "evaluateExperiment", "human_approval"]
  },
  "failureFallback": {
    "triggers": ["connection_failure", "GATE_FORBIDDEN_PLAN", "GATE_PLAN_CHECK_FAILED", "permission_denied", "project_denied", "oauth_expired", "CONTEXT_CHANGED", "CONTEXT_TOO_LARGE"],
    "contextTooLargeAction": "no_retry_no_legacy_bypass_discard_context_and_free_fallback",
    "contextTooLargeNotice": "有料品質ループ未適用：案件情報が安全な返却量を超えたため、MyMarketerの案件情報を使わず、無料モードで続行します。",
    "contextChangedAction": "retry_read_only_preview_once_with_fresh_context",
    "discardPaidContextForCurrentRun": true,
    "reusePaidCache": false,
    "continueInUnconnectedMode": true,
    "userVisibleLine": "有料品質ループ未適用：MyMarketerの案件情報を使わず、無料モードで続行します。",
    "neverGuessMyMarketerData": true
  }
}
