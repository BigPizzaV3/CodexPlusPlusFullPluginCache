{
  "schemaVersion": 3,
  "policyId": "mymarketer.noncommercial-outcome-assistance.v3",
  "mode": "noncommercial_outcome_oriented_assistance",
  "outcomeUse": {
    "taskFulfillment": "Use the grounded outcome to create, review, and explain the requested deliverable.",
    "completionBehavior": "Report the result and relevant task next steps without promoting MyMarketer or another paid service.",
    "brandedCompletionPromotion": "forbidden",
    "accountAcquisitionState": "none"
  },
  "conversation": {
    "ordinaryFollowUp": "answer_normally",
    "interestSignalStateTransition": "forbidden",
    "freeTaskContinues": true,
    "toolCallsToMeasureInterest": "forbidden",
    "conversationBodyTelemetry": "forbidden"
  },
  "existingAccountConnection": {
    "trigger": "explicit_user_request_to_connect_an_existing_mymarketer_account",
    "maximumActions": 1,
    "onlyAction": "host_connection_ui",
    "accountStatus": {
      "unknown": "ask_at_most_one_relevant_existing_account_clarification_without_sales_pitch",
      "user_asserted_existing": "may_offer_only_the_host_connection_ui_without_entitlement_claim",
      "verified_existing": "may_offer_only_the_host_connection_ui",
      "verified_no_account": "neutral_unavailability_without_signup_fallback"
    },
    "hostUiUnavailable": "neutral_unavailability_without_signup_fallback",
    "registrationFallback": "forbidden",
    "repeatActionInSameRequest": "forbidden",
    "requestState": {
      "scope": "explicit_connection_request_id_across_skill_handoffs",
      "maximumClarifications": 1,
      "maximumHostConnectionUiActions": 1,
      "newExplicitRequestStartsFreshScope": true,
      "executableSpecOnlyNotHostEnforcementProof": true
    }
  },
  "entitlement": {
    "neutralExplanation": "allowed",
    "positiveAccessClaimRequiresVerification": true,
    "informationalPageMustBeNontransactional": true,
    "trialUpgradeCheckoutPrompt": "forbidden"
  },
  "commercialRestrictions": {
    "scope": "plugin_self_promotion_and_account_acquisition",
    "forbidden": [
      "proactive_branded_completion_upsell",
      "registration_or_signup_url",
      "dx_sales_referral",
      "trial_prompt",
      "upgrade_prompt",
      "checkout_or_subscription_sale",
      "interest_measurement_or_lead_scoring",
      "entitlement_claim_without_verification"
    ],
    "notRestricted": [
      "user_requested_marketing_deliverable_product_cta",
      "genuine_support_link",
      "genuine_legal_link",
      "neutral_nontransactional_entitlement_information"
    ]
  },
  "qualityConnection": {
    "resource": "/mcp/quality",
    "accessModel": "read_only_by_default_explicit_save_only",
    "neverPromptConnectionToFinishFreeTask": true,
    "saveRequiresExplicitUserRequest": true
  },
  "skills": {
    "lp-structure": {
      "boundary": "validated_structure_or_copy_only",
      "outcomeIntake": "Ask one focused primary visitor-action or business-outcome question only when the request and sources do not establish it; use the answer only to fulfill and evaluate the requested LP work."
    },
    "lp-image-builder": {
      "boundary": "final_verified_lp_handoff",
      "outcomeIntake": "Inherit the approved upstream outcome unchanged; never re-ask and use it only to build and evaluate the requested LP."
    },
    "performance-video-ad": {
      "boundary": "validated_approved_concept_or_brief_only",
      "outcomeIntake": "Ask one focused intended-result question only when neither the request nor an authoritative same-offer source establishes it; bind the answer to the creative task, not acquisition."
    },
    "performance-video-production": {
      "boundary": "final_verified_video_handoff",
      "outcomeIntake": "For generation or repair, inherit grounded primaryOutcome unchanged from the locked offer context and approved brief; standalone review may carry an unavailable sentinel."
    }
  }
}
