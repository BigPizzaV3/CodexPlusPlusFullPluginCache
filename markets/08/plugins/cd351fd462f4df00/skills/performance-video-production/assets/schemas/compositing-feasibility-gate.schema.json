{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mymarketer.jp/schemas/performance-video-compositing-feasibility-v1.json",
  "title": "Performance video compositing feasibility gate",
  "type": "object",
  "required": ["schemaVersion", "contractVersion", "contractType", "jobId", "status", "diagnosticOnly", "selectedTreatmentId", "treatmentContract", "proof", "surfaceResults", "machineChecks", "machineGate", "humanTaste", "paidExecutionAllowed", "distribution"],
  "properties": {
    "schemaVersion": {"const": 1},
    "contractVersion": {"const": 1},
    "contractType": {"const": "performance_video_compositing_feasibility"},
    "jobId": {"type": "string", "minLength": 1},
    "status": {"enum": ["DRAFT", "PROOF_READY", "PASS", "FAIL"]},
    "diagnosticOnly": {"type": "boolean"},
    "selectedTreatmentId": {"type": ["string", "null"]},
    "treatmentContract": {"$ref": "#/$defs/nullableArtifactRef"},
    "proof": {
      "type": "object",
      "required": ["proofType", "path", "sha256", "frameCount", "durationSeconds", "finalFidelityElements"],
      "properties": {
        "proofType": {"enum": ["styleframe_only", "moving_binding_proof"]},
        "path": {"type": ["string", "null"]},
        "sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "frameCount": {"type": "integer", "minimum": 1},
        "durationSeconds": {"type": "number", "minimum": 0},
        "finalFidelityElements": {"type": "array", "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "surfaceResults": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["objectId", "bindingMode", "trackability", "relativeMotion", "perspective", "occlusion", "lookMatching", "readability", "evidenceRefs"],
        "properties": {
          "objectId": {"type": "string", "minLength": 1},
          "bindingMode": {"type": "string", "minLength": 1},
          "trackability": {"$ref": "#/$defs/checkStatus"},
          "relativeMotion": {"$ref": "#/$defs/checkStatus"},
          "perspective": {"$ref": "#/$defs/checkStatus"},
          "occlusion": {"$ref": "#/$defs/checkStatus"},
          "lookMatching": {"$ref": "#/$defs/checkStatus"},
          "readability": {"$ref": "#/$defs/checkStatus"},
          "evidenceRefs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        },
        "additionalProperties": false
      }
    },
    "machineChecks": {"type": "object"},
    "machineGate": {
      "type": "object",
      "required": ["status"],
      "properties": {"status": {"enum": ["PENDING", "PASS", "FAIL"]}},
      "additionalProperties": false
    },
    "humanTaste": {"type": "object"},
    "paidExecutionAllowed": {"const": false},
    "distribution": {"type": "object"}
  },
  "$defs": {
    "nullableArtifactRef": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": ["string", "null"]},
        "sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}
      },
      "additionalProperties": false
    },
    "checkStatus": {"enum": ["NOT_RUN", "PASS", "FAIL", "NOT_APPLICABLE"]}
  },
  "additionalProperties": false
}
