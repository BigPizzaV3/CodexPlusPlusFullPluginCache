{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mymarketer.jp/schemas/performance-video-sfx-asset-registry-v1.json",
  "title": "Performance video SFX asset registry",
  "type": "object",
  "required": ["schemaVersion", "jobId", "status", "platform", "assets"],
  "properties": {
    "schemaVersion": {"const": 1},
    "jobId": {"type": "string", "minLength": 1},
    "status": {"enum": ["DRAFT", "VERIFIED"]},
    "platform": {"type": "string", "minLength": 1},
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["assetId", "path", "sha256", "sourceKind", "licenseStatus", "licenseRef", "commercialUseAllowed", "platformScopes", "attributionRequired", "attributionText", "trademarkImitation", "durationSeconds", "soundFamilies", "tags"],
        "properties": {
          "assetId": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "sourceKind": {"enum": ["owned", "original_recording", "procedural", "licensed_library", "platform_library"]},
          "licenseStatus": {"enum": ["VERIFIED", "PENDING", "REJECTED"]},
          "licenseRef": {"type": "string", "minLength": 1},
          "commercialUseAllowed": {"type": "boolean"},
          "platformScopes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "attributionRequired": {"type": "boolean"},
          "attributionText": {"type": ["string", "null"]},
          "trademarkImitation": {"type": "boolean"},
          "durationSeconds": {"type": "number", "exclusiveMinimum": 0},
          "soundFamilies": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "tags": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
