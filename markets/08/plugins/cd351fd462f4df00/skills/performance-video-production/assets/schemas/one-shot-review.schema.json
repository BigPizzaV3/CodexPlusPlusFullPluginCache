{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Performance Video One-shot Review",
  "type": "object",
  "required": [
    "schemaVersion",
    "contractType",
    "jobId",
    "conceptId",
    "primaryOutcome",
    "assetRef",
    "assetSha256",
    "status",
    "decision",
    "earliestFailureStage",
    "checks",
    "typographyReview",
    "issues",
    "repairScope",
    "sameConceptRetryAllowed",
    "paidRetryAuthorized",
    "distribution"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "contractType": { "const": "performance_video_one_shot_review" },
    "primaryOutcome": {
      "oneOf": [
        {
          "type": "object",
          "required": ["status", "statement", "sourceRefs"],
          "properties": {
            "status": { "const": "grounded" },
            "statement": { "type": "string", "minLength": 1 },
            "sourceRefs": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["status", "statement", "sourceRefs", "reason"],
          "properties": {
            "status": { "const": "unavailable" },
            "statement": { "type": "null" },
            "sourceRefs": { "type": "array", "maxItems": 0 },
            "reason": { "const": "standalone_review_without_trustworthy_upstream" }
          },
          "additionalProperties": false
        }
      ]
    },
    "status": { "enum": ["DRAFT", "REVIEWED"] },
    "decision": { "enum": ["ACCEPT_PICTURE", "SURGICAL_FINISH", "REGENERATE_SAME_CONCEPT", "RETURN_TO_CONCEPT"] },
    "earliestFailureStage": { "enum": ["none", "source", "concept", "prompt", "generation", "finish", "technical"] },
    "paidRetryAuthorized": { "const": false },
    "typographyReview": {
      "type": "object",
      "required": ["integratedKeywords", "exactSurfaces", "captionTaste", "cheapOverlayRisk", "selectedRepairMode", "notes"],
      "properties": {
        "integratedKeywords": { "enum": ["PASS", "REPAIRABLE", "FAIL", "NOT_APPLICABLE"] },
        "exactSurfaces": { "enum": ["PASS", "REPAIRABLE", "FAIL", "NOT_APPLICABLE"] },
        "captionTaste": { "enum": ["PASS", "REPAIRABLE", "FAIL", "NOT_APPLICABLE"] },
        "cheapOverlayRisk": { "type": "boolean" },
        "selectedRepairMode": { "enum": ["none", "provider_edit", "tracked_in_world", "native_end_card", "selective_caption", "regenerate"] },
        "notes": { "type": "string", "minLength": 1 }
      }
    },
    "distribution": {
      "type": "object",
      "required": ["publishAllowed", "activateAdsAllowed"],
      "properties": {
        "publishAllowed": { "const": false },
        "activateAdsAllowed": { "const": false }
      }
    }
  },
  "additionalProperties": true
}
