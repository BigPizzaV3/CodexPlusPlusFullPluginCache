{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mymarketer.jp/schemas/performance-video-route-plan-v3.json",
  "title": "Performance video adaptive route plan",
  "type": "object",
  "required": ["schemaVersion", "routePlanVersion", "contractType", "jobId", "status", "pictureStrategy", "compositionPolicy", "scenes", "distribution"],
  "properties": {
    "schemaVersion": {"const": 1},
    "routePlanVersion": {"enum": [2, 3]},
    "contractType": {"const": "performance_video_route_plan"},
    "jobId": {"type": "string", "minLength": 1},
    "status": {"enum": ["DRAFT", "ROUTE_SELECTED", "HUMAN_TASTE_PASS", "HUMAN_TASTE_FAIL"]},
    "pictureStrategy": {"enum": ["ai_native_motion_deterministic_finish", "deterministic_first", "mixed_by_viewer_job"]},
    "compositionPolicy": {
      "type": "object",
      "required": ["remotionRole"],
      "properties": {
        "remotionRole": {"enum": ["compositor_and_finisher", "primary_motion_engine", "adaptive_by_scene"]},
        "exactSurfacesDeterministic": {"const": true},
        "exactContentAuthority": {"enum": ["deterministic"]}
      },
      "additionalProperties": true
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["shotId", "viewerJob", "exactSurfaces", "motionQualityNeeds", "routePressureScore", "selectedRoute", "primaryMotionOwner", "controlMode", "generationUnit", "controlBudget", "deterministicResponsibilities", "generativeResponsibilities", "zeroCostPreview", "humanTasteOverride", "rationale"],
        "properties": {
          "shotId": {"type": "string", "minLength": 1},
          "viewerJob": {"type": "string", "minLength": 1},
          "selectedRoute": {"enum": ["deterministic", "generative", "hybrid"]},
          "primaryMotionOwner": {"enum": ["deterministic", "generative"]},
          "controlMode": {"enum": ["directed_generation", "controlled_generation", "deterministic_composition"]},
          "generationUnit": {"enum": ["contiguous_sequence", "bounded_shot", "not_applicable"]},
          "exactSurfaces": {
            "type": "object",
            "properties": {
              "japaneseOrUiRequired": {"type": "boolean"},
              "deterministicOverlayPlanned": {"type": "boolean"},
              "semanticSurfaceLoad": {"enum": ["none", "supporting", "primary"]},
              "semanticCarrierType": {"enum": ["motion", "exact_surface", "character", "environment", "editing", "mixed"]},
              "surfaceObjects": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["objectId", "worldRelation", "contentAuthority", "geometryOwner", "motionOwner", "bindingMode", "trackSource", "occlusionPlan", "lookMatchPlan", "repairPlan", "readableWindows"],
                  "properties": {
                    "objectId": {"type": "string", "minLength": 1},
                    "worldRelation": {"enum": ["screen_native", "world_bound"]},
                    "contentAuthority": {"enum": ["deterministic", "generative", "not_applicable"]},
                    "geometryOwner": {"enum": ["generated_object", "deterministic_surface", "deterministic_3d"]},
                    "motionOwner": {"enum": ["generative", "deterministic", "tracked"]},
                    "bindingMode": {"enum": ["screen_native", "planar_track", "corner_pin", "uv_texture_3d", "final_frame_repair", "motion_scaffold_v2v", "not_applicable"]},
                    "trackSource": {"enum": ["not_required", "generated_plane_track", "post_generation_feature_track", "deterministic_camera", "uv_coordinates"]},
                    "occlusionPlan": {"type": "string", "minLength": 1},
                    "lookMatchPlan": {"type": "string", "minLength": 1},
                    "repairPlan": {"type": "string", "minLength": 1},
                    "readableWindows": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": ["startFrame", "endFrame"],
                        "properties": {
                          "startFrame": {"type": "integer", "minimum": 0},
                          "endFrame": {"type": "integer", "minimum": 1}
                        },
                        "additionalProperties": false
                      }
                    }
                  },
                  "additionalProperties": false
                }
              },
              "fallbackRoute": {"type": "string", "minLength": 1}
            },
            "additionalProperties": true
          },
          "controlBudget": {
            "type": "object",
            "required": ["keyframePolicy", "controlSources", "controlReason", "macroLocks", "delegatedToModel"],
            "properties": {
              "keyframePolicy": {"enum": ["none", "first_only", "first_last", "start_peak_end"]},
              "controlSources": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"enum": ["none", "first_frame", "last_frame", "identity_reference", "motion_reference", "intermediate_frame"]}
              },
              "controlReason": {"type": ["string", "null"]},
              "macroLocks": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
              "delegatedToModel": {"type": "array", "items": {"type": "string", "minLength": 1}}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": true
      }
    },
    "distribution": {"type": "object"}
  },
  "allOf": [
    {
      "if": {"properties": {"routePlanVersion": {"const": 2}}, "required": ["routePlanVersion"]},
      "then": {
        "properties": {
          "compositionPolicy": {"required": ["remotionRole", "exactSurfacesDeterministic"]}
        }
      }
    },
    {
      "if": {"properties": {"routePlanVersion": {"const": 3}}, "required": ["routePlanVersion"]},
      "then": {
        "properties": {
          "compositionPolicy": {"required": ["remotionRole", "exactContentAuthority"]},
          "scenes": {
            "items": {
              "properties": {
                "exactSurfaces": {"required": ["japaneseOrUiRequired", "semanticSurfaceLoad", "semanticCarrierType", "surfaceObjects", "fallbackRoute"]}
              }
            }
          }
        }
      }
    }
  ],
  "additionalProperties": true
}
