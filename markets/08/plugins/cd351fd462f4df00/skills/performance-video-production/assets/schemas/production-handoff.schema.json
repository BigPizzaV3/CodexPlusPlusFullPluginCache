{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mymarketer.jp/schemas/performance-video-production-handoff-v4.json",
  "title": "Performance video production handoff",
  "type": "object",
  "required": ["schemaVersion", "contractType", "handoffStatus", "jobId", "offerId", "strategySnapshotId", "selectedTerritoryId", "hookPackageId", "bodyFamilyId", "approvedArtifacts", "immutableCreative", "finalDelivery", "scenes", "approvals"],
  "properties": {
    "schemaVersion": {"const": 1},
    "contractVersion": {"enum": [1, 2, 3, 4]},
    "contractType": {"const": "performance_video_production_handoff"},
    "handoffStatus": {"enum": ["DRAFT", "PENDING_HUMAN_APPROVAL", "APPROVED_FOR_PRODUCTION", "PRODUCTION_BLOCKED"]},
    "jobId": {"type": "string", "minLength": 1},
    "lineage": {
      "type": "object",
      "required": ["jobDirectoryId", "parentJobId", "derivedFromJobId"],
      "properties": {
        "jobDirectoryId": {"type": "string", "minLength": 1},
        "parentJobId": {"type": ["string", "null"]},
        "derivedFromJobId": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "offerId": {"type": "string", "minLength": 1},
    "strategySnapshotId": {"type": "string", "minLength": 1},
    "selectedTerritoryId": {"type": "string", "minLength": 1},
    "hookPackageId": {"type": "string", "minLength": 1},
    "bodyFamilyId": {"type": "string", "minLength": 1},
    "approvedArtifacts": {
      "type": "object",
      "required": ["animaticReview", "timelineAudioIntent"],
      "properties": {
        "animaticReview": {"type": "object"},
        "timelineAudioIntent": {
          "type": "object",
          "required": ["status", "path", "sha256"],
          "properties": {
            "status": {"enum": ["READY_FOR_PRODUCTION", "PASS_LOCAL_REVIEW"]},
            "path": {"type": "string", "minLength": 1},
            "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
          },
          "additionalProperties": false
        },
        "visualTreatment": {"$ref": "#/$defs/approvedVisualTreatment"},
        "compositingFeasibility": {"$ref": "#/$defs/approvedCompositeFeasibility"}
      },
      "additionalProperties": true
    },
    "immutableCreative": {
      "type": "object",
      "properties": {
        "salesThesisId": {"type": "string", "minLength": 1},
        "singleSellReason": {"type": "string", "minLength": 1},
        "stopReason": {"type": "string", "minLength": 1},
        "continueReason": {"type": "string", "minLength": 1},
        "salesQuestionChain": {
          "type": "array",
          "minItems": 3,
          "maxItems": 6,
          "items": {
            "type": "object",
            "required": ["order", "viewerQuestion", "answerJob"],
            "properties": {
              "order": {"type": "integer", "minimum": 1},
              "viewerQuestion": {"type": "string", "minLength": 1},
              "answerJob": {"type": "string", "minLength": 1}
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "productionIntent": {
      "type": "object",
      "required": ["pictureStrategy", "heroVisualConcept", "mustFeel", "mustSee", "macroLocks", "delegatedMotion", "exactSurfaceResponsibilities", "allowedUnitBoundaryReasons", "remotionRole"],
      "properties": {
        "pictureStrategy": {"enum": ["ai_native_motion_deterministic_finish", "deterministic_first", "mixed_by_viewer_job"]},
        "heroVisualConcept": {"type": "string", "minLength": 1},
        "mustFeel": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "mustSee": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "macroLocks": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "delegatedMotion": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "exactSurfaceResponsibilities": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "allowedUnitBoundaryReasons": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["semantic_change", "camera_reset", "identity_risk", "exact_surface_boundary", "privacy_boundary", "verified_model_limit", "accepted_hard_cut"]}
        },
        "remotionRole": {"enum": ["compositor_and_finisher", "primary_motion_engine", "adaptive_by_scene"]}
      },
      "additionalProperties": false
    },
    "finalDelivery": {"type": "object"},
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "surfaceOwnership": {
            "type": "array",
            "items": {"$ref": "#/$defs/surfaceOwnership"}
          }
        },
        "additionalProperties": true
      }
    },
    "approvals": {"type": "object"}
  },
  "allOf": [
    {
      "if": {"properties": {"contractVersion": {"enum": [2, 3, 4]}}, "required": ["contractVersion"]},
      "then": {
        "properties": {
          "immutableCreative": {
            "required": ["salesThesisId", "singleSellReason", "stopReason", "continueReason", "salesQuestionChain"]
          }
        }
      }
    },
    {
      "if": {"properties": {"contractVersion": {"enum": [3, 4]}}, "required": ["contractVersion"]},
      "then": {"required": ["productionIntent"]}
    },
    {
      "if": {"properties": {"contractVersion": {"const": 4}}, "required": ["contractVersion"]},
      "then": {
        "required": ["lineage", "productionIntent"],
        "properties": {
          "approvedArtifacts": {"required": ["animaticReview", "timelineAudioIntent", "visualTreatment", "compositingFeasibility"]},
          "scenes": {"items": {"required": ["surfaceOwnership"]}}
        }
      }
    }
  ],
  "$defs": {
    "approvedVisualTreatment": {
      "type": "object",
      "required": ["status", "path", "sha256"],
      "properties": {
        "status": {"enum": ["PENDING", "APPROVED"]},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      },
      "additionalProperties": false
    },
    "approvedCompositeFeasibility": {
      "type": "object",
      "required": ["status", "path", "sha256"],
      "properties": {
        "status": {"enum": ["PENDING", "PASS"]},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      },
      "additionalProperties": false
    },
    "surfaceOwnership": {
      "type": "object",
      "required": ["objectId", "contentAuthority", "geometryOwner", "motionOwner", "bindingMode", "exactnessWindows"],
      "properties": {
        "objectId": {"type": "string", "minLength": 1},
        "contentAuthority": {"enum": ["deterministic", "generative", "not_applicable"]},
        "geometryOwner": {"enum": ["generated_object", "deterministic_surface", "deterministic_3d"]},
        "motionOwner": {"enum": ["generative", "deterministic", "tracked"]},
        "bindingMode": {"enum": ["screen_native", "planar_track", "corner_pin", "uv_texture_3d", "final_frame_repair", "motion_scaffold_v2v", "not_applicable"]},
        "exactnessWindows": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["startFrame", "endFrame"],
            "properties": {
              "startFrame": {"type": "integer", "minimum": 0},
              "endFrame": {"type": "integer", "minimum": 1}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
