{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mymarketer.jp/schemas/performance-video-audio-cue-sheet-v1.json",
  "title": "Performance video audio cue sheet",
  "type": "object",
  "required": ["schemaVersion", "jobId", "status", "platform", "fps", "durationFrames", "soundIntentMap", "assetRegistry", "cues", "omittedIntents", "mixPolicy", "qc", "distribution"],
  "properties": {
    "schemaVersion": {"const": 1},
    "jobId": {"type": "string", "minLength": 1},
    "status": {"enum": ["DRAFT", "READY_FOR_MIX", "MIXED_QC_PASS", "REVISE"]},
    "platform": {"type": "string", "minLength": 1},
    "fps": {"type": "number", "exclusiveMinimum": 0},
    "durationFrames": {"type": "integer", "minimum": 1},
    "soundIntentMap": {"$ref": "#/$defs/artifactRef"},
    "assetRegistry": {"$ref": "#/$defs/artifactRef"},
    "cues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["cueId", "intentId", "assetId", "startFrame", "endFrame", "visualTriggerFrame", "syncOffsetFrames", "category", "bus", "gainDb", "pitchSemitones", "eqProfile", "speechOverlap", "ducking", "fadeInMs", "fadeOutMs", "status"],
        "properties": {
          "cueId": {"type": "string", "minLength": 1},
          "intentId": {"type": "string", "minLength": 1},
          "assetId": {"type": "string", "minLength": 1},
          "startFrame": {"type": "integer", "minimum": 0},
          "endFrame": {"type": "integer", "minimum": 1},
          "visualTriggerFrame": {"type": "integer", "minimum": 0},
          "syncOffsetFrames": {"type": "integer"},
          "category": {"enum": ["causal", "informational", "structural", "rhythmic", "emotional", "brand", "ambience"]},
          "bus": {"enum": ["sfx_causal", "sfx_editorial", "sfx_brand", "ambience"]},
          "gainDb": {"type": "number", "minimum": -60, "maximum": 6},
          "pitchSemitones": {"type": "number", "minimum": -3, "maximum": 3},
          "eqProfile": {"type": "string", "minLength": 1},
          "speechOverlap": {"type": "boolean"},
          "ducking": {"enum": ["not_applicable", "planned", "applied"]},
          "fadeInMs": {"type": "number", "minimum": 0, "maximum": 500},
          "fadeOutMs": {"type": "number", "minimum": 0, "maximum": 1000},
          "status": {"enum": ["SELECTED", "MIXED", "QC_PASS"]}
        },
        "additionalProperties": false
      }
    },
    "omittedIntents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["intentId", "reason"],
        "properties": {
          "intentId": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "mixPolicy": {
      "type": "object",
      "required": ["narrationPriority", "sidechainOrAutomationRequiredForSpeechOverlap", "targetIntegratedLufs", "loudnessToleranceLu", "maximumTruePeakDbtp", "loudnessTargetRationale", "maximumOnsetsPerSecond", "maximumSimultaneousUnderNarration", "maximumSimultaneousWithoutNarration"],
      "properties": {
        "narrationPriority": {"const": true},
        "sidechainOrAutomationRequiredForSpeechOverlap": {"const": true},
        "targetIntegratedLufs": {"type": "number", "minimum": -24, "maximum": -10},
        "loudnessToleranceLu": {"type": "number", "exclusiveMinimum": 0, "maximum": 2},
        "maximumTruePeakDbtp": {"type": "number", "minimum": -3, "maximum": -0.1},
        "loudnessTargetRationale": {"type": "string", "minLength": 1},
        "maximumOnsetsPerSecond": {"type": "integer", "minimum": 1, "maximum": 6},
        "maximumSimultaneousUnderNarration": {"type": "integer", "minimum": 1, "maximum": 2},
        "maximumSimultaneousWithoutNarration": {"type": "integer", "minimum": 1, "maximum": 4}
      },
      "additionalProperties": false
    },
    "qc": {
      "type": "object",
      "required": ["fullDecodePass", "licenseCoverageStatus", "observedIntegratedLufs", "observedTruePeakDbtp", "noClipping", "narrationIntelligibility", "phoneSpeakerPass", "headphonesPass", "targetPlayerPass", "highFrequencyFatiguePass", "humanTasteStatus"],
      "properties": {
        "fullDecodePass": {"type": "boolean"},
        "licenseCoverageStatus": {"enum": ["PASS", "PENDING", "FAIL"]},
        "observedIntegratedLufs": {"type": ["number", "null"]},
        "observedTruePeakDbtp": {"type": ["number", "null"]},
        "noClipping": {"type": "boolean"},
        "narrationIntelligibility": {"enum": ["PASS", "PENDING", "FAIL"]},
        "phoneSpeakerPass": {"type": "boolean"},
        "headphonesPass": {"type": "boolean"},
        "targetPlayerPass": {"type": "boolean"},
        "highFrequencyFatiguePass": {"type": "boolean"},
        "humanTasteStatus": {"enum": ["PASS", "PENDING", "FAIL"]}
      },
      "additionalProperties": false
    },
    "distribution": {
      "type": "object",
      "required": ["publishAllowed", "activateAdsAllowed", "publicSkillDistributionAllowed"],
      "properties": {
        "publishAllowed": {"const": false},
        "activateAdsAllowed": {"const": false},
        "publicSkillDistributionAllowed": {"const": false}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "artifactRef": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
