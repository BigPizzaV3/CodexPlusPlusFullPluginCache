{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schemaVersion",
    "status",
    "jobId",
    "conceptId",
    "assetRef",
    "assetSha256",
    "reviewSha256",
    "checks",
    "taste",
    "distribution"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "status": {
      "const": "DELIVERED_LOCAL_QC"
    },
    "jobId": {
      "type": "string",
      "minLength": 1
    },
    "conceptId": {
      "type": "string",
      "minLength": 1
    },
    "assetRef": {
      "type": "string",
      "minLength": 1
    },
    "assetSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "reviewSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "checks": {
      "type": "object",
      "required": [
        "twoSecondComprehension",
        "stopAndContinueReason",
        "salesThesis",
        "semanticMotionEnding",
        "brandCtaPriceLegalClaims",
        "typographyAtSpeed",
        "privacyIdentity",
        "decodeDimensionsCodec",
        "timestampsCadence",
        "intendedAudioWindows",
        "providerSpeech",
        "voiceIsolation"
      ],
      "additionalProperties": false,
      "properties": {
        "twoSecondComprehension": {
          "type": "object",
          "required": [
            "status",
            "evidence"
          ],
          "additionalProperties": false,
          "properties": {
            "status": {
              "const": "PASS"
            },
            "evidence": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "stopAndContinueReason": {
          "type": "object",
          "required": [
            "status",
            "evidence"
          ],
          "additionalProperties": false,
          "properties": {
            "status": {
              "const": "PASS"
            },
            "evidence": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "salesThesis": {
          "type": "object",
          "required": [
            "status",
            "evidence"
          ],
          "additionalProperties": false,
          "properties": {
            "status": {
              "const": "PASS"
            },
            "evidence": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "semanticMotionEnding": {
          "type": "object",
          "required": [
            "status",
            "evidence"
          ],
          "additionalProperties": false,
          "properties": {
            "status": {
              "const": "PASS"
            },
            "evidence": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "brandCtaPriceLegalClaims": {
          "type": "object",
          "required": [
            "status",
            "evidence"
          ],
          "additionalProperties": false,
          "properties": {
            "status": {
              "const": "PASS"
            },
            "evidence": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "typographyAtSpeed": {
          "type": "object",
          "required": [
            "status",
            "evidence"
          ],
          "additionalProperties": false,
          "properties": {
            "status": {
              "const": "PASS"
            },
            "evidence": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "privacyIdentity": {
          "type": "object",
          "required": [
            "status",
            "evidence"
          ],
          "additionalProperties": false,
          "properties": {
            "status": {
              "const": "PASS"
            },
            "evidence": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "decodeDimensionsCodec": {
          "type": "object",
          "required": [
            "status",
            "evidence"
          ],
          "additionalProperties": false,
          "properties": {
            "status": {
              "const": "PASS"
            },
            "evidence": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "timestampsCadence": {
          "type": "object",
          "required": [
            "status",
            "evidence"
          ],
          "additionalProperties": false,
          "properties": {
            "status": {
              "const": "PASS"
            },
            "evidence": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "intendedAudioWindows": {
          "type": "object",
          "required": [
            "status",
            "evidence"
          ],
          "additionalProperties": false,
          "properties": {
            "status": {
              "const": "PASS"
            },
            "evidence": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "providerSpeech": {
          "type": "object",
          "required": [
            "status",
            "evidence"
          ],
          "additionalProperties": false,
          "properties": {
            "status": {
              "const": "PASS"
            },
            "evidence": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "voiceIsolation": {
          "type": "object",
          "required": [
            "status",
            "evidence"
          ],
          "additionalProperties": false,
          "properties": {
            "status": {
              "const": "PASS"
            },
            "evidence": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "taste": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "providedBy",
            "recordedAt",
            "statement"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "human_conversation"
            },
            "providedBy": {
              "enum": [
                "user",
                "controller"
              ]
            },
            "recordedAt": {
              "type": "string",
              "format": "date-time"
            },
            "statement": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "agentDelegation"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "agent_delegation"
            },
            "agentDelegation": {
              "type": "object",
              "required": [
                "receipt",
                "snapshot"
              ],
              "additionalProperties": false,
              "properties": {
                "receipt": {
                  "type": "object"
                },
                "snapshot": {
                  "type": "object"
                }
              }
            }
          }
        }
      ]
    },
    "distribution": {
      "type": "object",
      "required": [
        "publishAllowed",
        "activateAdsAllowed"
      ],
      "additionalProperties": false,
      "properties": {
        "publishAllowed": {
          "const": false
        },
        "activateAdsAllowed": {
          "const": false
        }
      }
    }
  }
}
