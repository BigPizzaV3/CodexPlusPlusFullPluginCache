{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mymarketer.jp/schemas/performance-video-timeline-audio-contract-v1.json",
  "title": "Performance video timeline and audio contract",
  "type": "object",
  "required": [
    "schemaVersion",
    "jobId",
    "status",
    "fps",
    "durationFrames",
    "slotDesign",
    "messageBeats",
    "narrationCues",
    "sfxCues",
    "sfxCoverageReviewed",
    "proofPresentation",
    "ttsRecoveryPolicy",
    "finalTimingQc",
    "distribution"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "jobId": {"type": "string", "minLength": 1},
    "status": {"enum": ["DRAFT", "READY_FOR_PRODUCTION", "PASS_LOCAL_REVIEW", "REVISE"]},
    "fps": {"type": "number", "exclusiveMinimum": 0},
    "durationFrames": {"type": "integer", "minimum": 1},
    "slotDesign": {
      "type": "object",
      "required": ["provisionalVoiceUsed", "targetOccupancyMin", "targetOccupancyMax", "oversizedBufferProhibited"],
      "properties": {
        "provisionalVoiceUsed": {"type": "boolean"},
        "targetOccupancyMin": {"const": 0.88},
        "targetOccupancyMax": {"const": 0.92},
        "oversizedBufferProhibited": {"const": true}
      },
      "additionalProperties": false
    },
    "messageBeats": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "required": ["beatId", "role", "importance", "startFrame", "endFrame", "primaryMessage", "messageKey", "delivery", "spokenText", "progression", "repeatsBeatId", "repeatRationale"],
        "properties": {
          "beatId": {"type": "string", "minLength": 1},
          "role": {"enum": ["recognition", "tension", "failed_workaround", "hope", "mechanism", "proof", "payoff", "cta"]},
          "importance": {"enum": ["major", "supporting"]},
          "startFrame": {"type": "integer", "minimum": 0},
          "endFrame": {"type": "integer", "minimum": 1},
          "primaryMessage": {"type": "string", "minLength": 1},
          "messageKey": {"type": "string", "minLength": 1},
          "delivery": {"enum": ["spoken_and_visual", "spoken_only", "visual_only"]},
          "spokenText": {"type": ["string", "null"]},
          "progression": {"enum": ["new_information", "intentional_recap"]},
          "repeatsBeatId": {"type": ["string", "null"]},
          "repeatRationale": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    },
    "narrationCues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["clipId", "beatId", "exactText", "startFrame", "nextCueFrame", "plannedSpeechSeconds", "slotSeconds", "plannedOccupancyRatio", "tempoRatio", "paceApprovalStatus", "copyVerificationStatus"],
        "properties": {
          "clipId": {"type": "string", "minLength": 1},
          "beatId": {"type": "string", "minLength": 1},
          "exactText": {"type": "string", "minLength": 1},
          "startFrame": {"type": "integer", "minimum": 0},
          "nextCueFrame": {"type": "integer", "minimum": 1},
          "plannedSpeechSeconds": {"type": "number", "exclusiveMinimum": 0},
          "slotSeconds": {"type": "number", "exclusiveMinimum": 0},
          "plannedOccupancyRatio": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
          "tempoRatio": {"type": "number", "exclusiveMinimum": 0},
          "paceApprovalStatus": {"enum": ["not_required", "ab_review_pass", "human_approved", "pending", "rejected"]},
          "copyVerificationStatus": {"enum": ["PASS", "PENDING", "FAIL"]}
        },
        "additionalProperties": false
      }
    },
    "sfxCues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["eventId", "beatId", "eventType", "visualEventFrame", "cueType", "cueStartFrame", "maxOffsetFrames"],
        "properties": {
          "eventId": {"type": "string", "minLength": 1},
          "beatId": {"type": "string", "minLength": 1},
          "eventType": {"enum": ["impact", "rupture", "passage", "landing", "transition", "notification"]},
          "visualEventFrame": {"type": "integer", "minimum": 0},
          "cueType": {"enum": ["impact", "rupture", "whoosh", "landing", "transition", "notification"]},
          "cueStartFrame": {"type": "integer", "minimum": 0},
          "maxOffsetFrames": {"type": "integer", "minimum": 0}
        },
        "additionalProperties": false
      }
    },
    "sfxCoverageReviewed": {"const": true},
    "proofPresentation": {
      "type": "object",
      "required": ["beatId", "primaryHeadline", "administrativeCopyIsPrimary", "headlineScale", "proofOverlap", "sourceAuditStatus", "mosaicApplied", "readableAnchorCount", "quantityAssetCount"],
      "properties": {
        "beatId": {"type": "string", "minLength": 1},
        "primaryHeadline": {"type": "string", "minLength": 1},
        "administrativeCopyIsPrimary": {"const": false},
        "headlineScale": {"const": "dominant"},
        "proofOverlap": {"enum": ["none", "allowed_intentional"]},
        "sourceAuditStatus": {"enum": ["PASS", "NOT_APPLICABLE", "FAIL"]},
        "mosaicApplied": {"type": "boolean"},
        "readableAnchorCount": {"type": "integer", "minimum": 0},
        "quantityAssetCount": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "ttsRecoveryPolicy": {
      "type": "object",
      "required": ["slotEvaluationBasis", "preserveProviderOutputBeforePaceGate", "retainRequestIdBeforePaceGate", "automaticRetryAllowed", "paidRetryRequiresFreshApproval", "recoveryOrder"],
      "properties": {
        "slotEvaluationBasis": {"const": "maximum_available_slot"},
        "preserveProviderOutputBeforePaceGate": {"const": true},
        "retainRequestIdBeforePaceGate": {"const": true},
        "automaticRetryAllowed": {"const": false},
        "paidRetryRequiresFreshApproval": {"const": true},
        "recoveryOrder": {
          "const": ["trim_verified_edges", "fit_within_approved_tempo", "bounded_timeline_extension", "resynthesize_with_fresh_approval"]
        }
      },
      "additionalProperties": false
    },
    "finalTimingQc": {
      "type": "object",
      "required": ["expectedDurationSource", "expectedVideoDurationSeconds", "observedVideoDurationSeconds", "observedContainerDurationSeconds", "allowedContainerTailMilliseconds", "fullDecodePass", "targetPlayerPass"],
      "properties": {
        "expectedDurationSource": {"const": "video_stream"},
        "expectedVideoDurationSeconds": {"type": "number", "exclusiveMinimum": 0},
        "observedVideoDurationSeconds": {"type": "number", "exclusiveMinimum": 0},
        "observedContainerDurationSeconds": {"type": "number", "exclusiveMinimum": 0},
        "allowedContainerTailMilliseconds": {"type": "number", "minimum": 0, "maximum": 100},
        "fullDecodePass": {"type": "boolean"},
        "targetPlayerPass": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "distribution": {
      "type": "object",
      "required": ["publishAllowed", "activateAdsAllowed", "publicSkillDistributionAllowed"],
      "properties": {
        "publishAllowed": {"const": false},
        "activateAdsAllowed": {"const": false},
        "publicSkillDistributionAllowed": {"const": false}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
