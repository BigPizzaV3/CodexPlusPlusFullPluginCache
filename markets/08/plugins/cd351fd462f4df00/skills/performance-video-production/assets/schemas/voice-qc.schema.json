{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mymarketer.jp/schemas/performance-video-voice-qc-v1.json",
  "title": "Performance video voice QC",
  "type": "object",
  "required": ["schemaVersion", "status", "mode", "expectedClipIds", "clips", "humanTasteStatus", "distribution"],
  "properties": {
    "schemaVersion": {"const": 1},
    "status": {"enum": ["PENDING_HUMAN_REVIEW", "FAIL", "PASS"]},
    "mode": {"enum": ["new_narration", "replacement_only"]},
    "expectedClipIds": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "clips": {"type": "array", "minItems": 1},
    "humanTasteStatus": {"enum": ["PENDING", "FAIL", "PASS"]},
    "distribution": {
      "type": "object",
      "required": ["publishAllowed", "activateAdsAllowed"],
      "properties": {
        "publishAllowed": {"type": "boolean"},
        "activateAdsAllowed": {"type": "boolean"}
      }
    }
  },
  "additionalProperties": true
}
