PORT=8787
HOST=127.0.0.1
KNOWLEDGE_DIR=./knowledge
MAX_RESULTS=6

# --- access layer ---
# Public HTTPS origin of this server (used as OAuth issuer; no trailing slash)
PUBLIC_URL=https://mcp.mikeauton.com
# 0 = open /mcp (pre-GHL behavior). 1 = require OAuth license when GHL is live.
ENFORCE_OAUTH=0
# openssl rand -hex 32  (signs access tokens; rotate = all tokens invalidated)
OAUTH_SECRET=change-me
# openssl rand -hex 32  (shared secret for GHL webhook header X-GHL-Secret)
ENTITLEMENT_SECRET=change-me
# SQLite file for entitlements + OAuth state
DB_PATH=./data/ad-machine.db

# Portal domain-verification token (rotate per challenge from the OpenAI portal)
OPENAI_APPS_CHALLENGE=Noy3_hf71A6M_nIotajciRpusTIZfQxyppI6R93usfs
