[Unit]
Description=Drop-Dead Simple Ad Machine MCP server
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/drop-dead-simple-ad-machine
EnvironmentFile=/opt/drop-dead-simple-ad-machine/.env
ExecStart=/usr/bin/node /opt/drop-dead-simple-ad-machine/server.mjs
Restart=always
RestartSec=3

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/drop-dead-simple-ad-machine

[Install]
WantedBy=multi-user.target
