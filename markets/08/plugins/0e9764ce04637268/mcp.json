{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "ad-machine": {
      "type": "streamable-http",
      "url": "https://mcp.mikeauton.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": { "mode": "dcr" },
            "registrationUrl": "https://mcp.mikeauton.com/register",
            "authorizationUrl": "https://mcp.mikeauton.com/authorize",
            "tokenUrl": "https://mcp.mikeauton.com/token"
          }
        }
      }
    }
  }
}
