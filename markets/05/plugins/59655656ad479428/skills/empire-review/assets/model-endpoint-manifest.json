      "status": "documented_sdk_example"
    }
  ],
  "selection_policy": {
    "openai_in_catalog": false,
    "openai_excluded_from_partner_review": true,
    "reason": "Codex remains the OpenAI lead; external lineups contain only non-OpenAI API routes."
  },
  "security": {
    "contains_credentials": false,
    "credentials_from_system_keyring": true,
    "atomic_write": true
  }
}
