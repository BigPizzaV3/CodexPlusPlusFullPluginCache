{
  "schema_version": "1.9.0",
  "endpoint": "empire-review://models/proposed",
  "storage": "platform_user_cache/empire-codex-router/proposed-models.json",
  "refresh_command": "python3 ~/.agents/skills/empire-review/scripts/empire_router.py refresh-models",
  "read_command": "python3 ~/.agents/skills/empire-review/scripts/empire_router.py models --cost-mode auto",
  "refresh_schedule": "on_first_use_then_soft_ttl",
  "background_scheduler_required": false,
  "catalog_ttl_minutes": 20,
  "benchmark_ttl_hours": 6,
  "route_health_ttl_minutes": 45,
  "maximum_stale_fallback_hours": 24,
  "discovery_contract": {
    "trigger": "empire_invocation",
    "catalog_authority": "authenticated_openrouter_user_catalog",
    "cron_required": false,
    "exact_model_cache_miss": "force_live_refresh_before_not_found",
    "explicit_live_switch": "--require-live-catalog",
    "freshness_intent_triggers": ["latest model", "newest model", "newly released", "currently available", "current model lineup"],
    "availability_basis": [
      "authenticated_user_catalog_membership",
      "text_output_and_request_parameter_compatibility",
      "local_recent_route_health",
      "provider_dispatch_validation"
    ],
    "refresh_receipt": ["raw_model_count", "eligible_model_count", "excluded_model_count", "added", "removed", "retained_count"]
  },
  "request_compatibility_required": ["json_response", "output_token_limit"],
  "sources": [
    "https://openrouter.ai/api/v1/models/user",
    "https://artificialanalysis.ai/api/v2/language/models"
  ],
  "profiles": ["quality", "balanced", "fast", "cheap"],
  "cost_modes": ["auto", "free", "value", "frontier"],
  "selection_strengths": ["hard_lock", "prefer", "try_first"],
  "cost_lanes": ["adaptive", "absolute_zero", "value_paid", "frontier_quality"],
  "openai_excluded": true,
  "remote_api_routes_only": true,
  "absolute_zero_policy": {
    "required_zero_components": ["prompt", "completion", "request"],
    "planned_billable_components": ["image", "audio", "video", "web_search", "other"],
    "missing_request_price_allowed_for": ["explicit_:free_variant", "openrouter/free"],
    "paid_cross_lane_fallback": false,
    "unknown_planned_component_price": "fail_closed"
  },
  "value_policy": {
    "maximum_input_per_million_usd": 2.0,
    "maximum_output_per_million_usd": 8.0,
    "maximum_estimated_request_usd": 0.25,
    "minimum_task_quality_percentile": 50,
    "pareto_frontier_required": true
  },
  "frontier_policy": {
    "minimum_task_quality_percentile": 80,
    "price_is_not_a_quality_proxy": true
  },
  "policy_commands": ["mode", "models", "budget", "language", "route", "explain"],
  "model_identity_fields": [
    "id",
    "api_model_id",
    "model_name",
    "display_name",
    "publisher",
    "model_family",
    "model_version",
    "model_edition",
    "model_snapshot",
    "model_kind",
    "modalities",
    "supported_languages"
  ],
  "supported_filters": [
    "publisher",
    "model_family",
    "model_version",
    "model_edition",
    "model_snapshot",
    "model_kind",
    "modalities",
    "supported_languages",
    "endpoint_providers",
    "endpoints.api"
  ],
  "provider_endpoints": {
    "openrouter": {
      "models": "https://openrouter.ai/api/v1/models/user",
      "chat_completions": "https://openrouter.ai/api/v1/chat/completions"
    },
    "anthropic": {
      "models": "https://api.anthropic.com/v1/models",
      "messages": "https://api.anthropic.com/v1/messages",
      "count_tokens": "https://api.anthropic.com/v1/messages/count_tokens",
      "message_batch": "https://api.anthropic.com/v1/messages/batches"
    },
    "google_gemini": {
      "provider_kind": "multimodal_model_api",
      "base_url": "https://generativelanguage.googleapis.com/v1beta",
      "models": "https://generativelanguage.googleapis.com/v1beta/models",
      "interactions": "https://generativelanguage.googleapis.com/v1beta/interactions",
      "generate_content": "https://generativelanguage.googleapis.com/v1beta/models/{model}:generateContent",
      "stream_generate_content": "https://generativelanguage.googleapis.com/v1beta/models/{model}:streamGenerateContent",
      "count_tokens": "https://generativelanguage.googleapis.com/v1beta/models/{model}:countTokens",
      "authentication": "x-goog-api-key: {api_key}"
    },
    "xai": {
      "provider_kind": "multimodal_model_api",
      "base_url": "https://api.x.ai/v1",
      "models": "https://api.x.ai/v1/models",
      "language_models": "https://api.x.ai/v1/language-models",
      "model": "https://api.x.ai/v1/models/{model_id}",
      "responses": "https://api.x.ai/v1/responses",
      "chat_completions": "https://api.x.ai/v1/chat/completions",
      "authentication": "Authorization: Bearer {api_key}"
    },
    "deepseek": {
      "provider_kind": "language_model_api",
      "base_url": "https://api.deepseek.com",
      "models": "https://api.deepseek.com/models",
      "chat_completions": "https://api.deepseek.com/chat/completions",
      "beta_base_url": "https://api.deepseek.com/beta",
      "anthropic_compatible_base_url": "https://api.deepseek.com/anthropic",
      "authentication": "Authorization: Bearer {api_key}"
    },
    "higgsfield": {
      "provider_kind": "generative_media_gateway",
      "base_url": "https://platform.higgsfield.ai",
      "generation": "https://platform.higgsfield.ai/{endpoint_path}",
      "request_status": "https://platform.higgsfield.ai/requests/{request_id}/status",
      "request_cancel": "https://platform.higgsfield.ai/requests/{request_id}/cancel",
      "authentication": "Authorization: Key {key_id}:{key_secret}",
      "catalog_discovery": {
        "kind": "cli",
        "command": "higgsfield model list",
        "reason": "The official CLI is the supported live catalog; no stable public HTTP catalog endpoint is documented."
      }
    }
  },
  "anthropic_models": [
