{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://empire-llm.local/schemas/discovered-provider-catalog.schema.json",
  "title": "Empire local discovered provider catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "provider_instance_id", "generated_at", "expires_at", "catalog_source", "models"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "provider_instance_id": { "type": "string" },
    "generated_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "catalog_source": { "enum": ["authenticated_provider_api", "curated", "manual"] },
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["route_id", "model_id", "family", "endpoint_ref", "availability"],
        "properties": {
          "route_id": { "type": "string" },
          "model_id": { "type": "string" },
          "family": { "type": "string" },
          "endpoint_ref": { "type": "string" },
          "availability": { "enum": ["available", "retired", "unavailable"] },
          "capabilities": { "type": "object" },
          "pricing": { "type": "object" },
          "pricing_status": { "enum": ["verified", "unknown"] }
        }
      }
    }
  }
}
