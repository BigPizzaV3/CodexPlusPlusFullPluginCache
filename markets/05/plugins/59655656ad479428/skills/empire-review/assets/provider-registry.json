{
  "schema_version": "1.0.0",
  "providers": [
    {
      "provider_id": "xai-direct",
      "family": "xai",
      "allowed_hosts": ["api.x.ai"],
      "base_url": "https://api.x.ai/v1",
      "authentication": "bearer",
      "credential_env": ["XAI_API_KEY"],
      "model_id_pattern": "^grok-[A-Za-z0-9._:-]+$",
      "discovery": {
        "mode": "api",
        "path": "/language-models",
        "ttl_minutes": 20
      },
      "inference_endpoints": [
        {
          "id": "responses",
          "path": "/responses",
          "protocol": "openai_responses",
          "preferred": true
        },
        {
          "id": "chat-completions",
          "path": "/chat/completions",
          "protocol": "openai_chat_completions",
          "legacy": true
        }
      ],
      "documentation_url": "https://docs.x.ai/developers/rest-api-reference/inference/models"
    },
    {
      "provider_id": "deepseek-direct",
      "family": "deepseek",
      "allowed_hosts": ["api.deepseek.com"],
      "base_url": "https://api.deepseek.com",
      "authentication": "bearer",
      "credential_env": ["DEEPSEEK_API_KEY"],
      "model_id_pattern": "^deepseek-[A-Za-z0-9._:-]+$",
      "discovery": {
        "mode": "api",
        "path": "/models",
        "ttl_minutes": 20
      },
      "inference_endpoints": [
        {
          "id": "chat-completions",
          "path": "/chat/completions",
          "protocol": "openai_chat_completions",
          "preferred": true
        }
      ],
      "documentation_url": "https://api-docs.deepseek.com/api/list-models"
    }
  ]
}
