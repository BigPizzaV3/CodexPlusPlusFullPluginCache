{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://empire-llm.local/schemas/routing-policy.schema.json",
  "title": "Empire provider routing policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["mode", "enabled_providers", "priority", "allowed_families", "fallback"],
  "properties": {
    "mode": { "enum": ["direct_only", "prefer_direct", "openrouter_only", "custom"] },
    "enabled_providers": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "priority": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "allowed_families": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "fallback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["openrouter"],
      "properties": {
        "openrouter": {
          "enum": ["disabled", "same_model_only", "same_family_only", "any_eligible"]
        },
        "require_confirmation": { "type": "boolean" }
      }
    }
  }
}
