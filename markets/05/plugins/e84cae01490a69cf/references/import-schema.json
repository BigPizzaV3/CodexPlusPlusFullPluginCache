{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Onboarding Wins import payload",
  "type": "object",
  "required": ["client", "sessions", "milestones", "steps", "timeline"],
  "properties": {
    "client": {
      "type": "object",
      "required": ["accountName", "owner", "arr", "agents", "subscription", "calls", "emails"],
      "properties": {
        "clientId": {"type": "string"},
        "accountName": {"type": "string", "minLength": 1},
        "owner": {"type": "string", "minLength": 1},
        "arr": {"type": ["number", "null"]},
        "agents": {"type": ["integer", "null"]},
        "subscription": {"type": ["string", "null"]},
        "calls": {"type": ["integer", "null"]},
        "emails": {"type": ["integer", "null"]},
        "expansion": {"type": "object"}
      },
      "additionalProperties": true
    },
    "sessions": {"type": "array"},
    "milestones": {"type": "array"},
    "steps": {"type": "array"},
    "timeline": {"type": "array"}
  },
  "additionalProperties": true
}
