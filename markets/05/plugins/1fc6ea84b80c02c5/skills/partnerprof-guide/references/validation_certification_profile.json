{
  "model": "EvO_PartnerProf",
  "validation": {
    "public_compute_entry": "core.CML",
    "vector_only_beyond_public_transform": true,
    "json_or_dict_allowed_in_CML_A": false,
    "public_CML_A_forbidden": true,
    "dimension_policy_enforced": true,
    "matrix_role": "reality_field",
    "matrix_optimization_enabled": false,
    "matrix_approximation_enabled": false,
    "matrix_jitter_enabled": false,
    "sole_evolutionary_operator": "CML_A",
    "zero_state_valid": true,
    "zero_state_semantics": "no_realization_in_field_under_declared_conditions_and_constraints",
    "singularity_public_result": false,
    "continuation_guard": "apply_only_if_declared_goal_reached_or_at_least_one_admissible_follow_up_exists_otherwise_noop",
    "determinism_origin": "returned_state",
    "pre_realization_determinism_forbidden": true,
    "substitute_compute_path_forbidden": true,
    "mock_result_forbidden": true,
    "operator_semantic": "evolutionary_operator_of_admissible_states_over_current_reality",
    "rules_mutated": false,
    "goal_terminal_exception": true,
    "declared_goal_is_rule_change": false
  },
  "certification": {
    "mode": "EXISTING_RESULT_EVIDENCE",
    "source": "stored_returned_cml_state",
    "compute_reexecution": false,
    "hash_algorithm": "sha3_512",
    "report_location": "storage/cert_reports/<run_id>.json",
    "report_hash_location": "storage/cert_reports/<run_id>.sha3"
  },
  "source_of_truth": {
    "runtime_profile": "config/runtime_profile.json",
    "constraints": "src/evo_runtime/constraints.py",
    "engine": "src/evo_runtime/engine.py",
    "public_compute_router": "core/CML.py",
    "cert_writer": "src/evo_runtime/certification.py"
  }
}
