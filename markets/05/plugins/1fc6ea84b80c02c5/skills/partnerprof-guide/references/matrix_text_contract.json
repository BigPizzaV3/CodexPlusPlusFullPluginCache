{
  "commands": {
    "CONSTRAINT": "CONSTRAINT <variable> <>=|<=|=|range> <value> <unit> [value2]",
    "GOAL": "GOAL <variable> <op> <value> <unit> [value2] <confirmed>",
    "INVARIANT": "INVARIANT <left> <op> <ratio> <right> <tolerance> <origin> <confirmed> <scope>",
    "LAYER": "LAYER <key> <order> <role> <confirmed>",
    "OPTIMIZE": "OPTIMIZE <none|time|energy|cost|risk|distance|custom> [custom_expression]",
    "QUESTION": "QUESTION <ADMISSIBILITY|REALIZATION|CONFLICT_DIAGNOSTIC|NEAREST_ADMISSIBLE_GOAL|FULL_CYCLE>",
    "REALITY": "REALITY <key> <order> <role> <spatial_scale> <length_m> <resolution_m> <temporal_scale> <horizon_s> <qchronon_s> <time_frame> <interaction> <dominance> <metric> <ontology> <confirmed>",
    "RELATION": "RELATION <source> <relation> <target> <weight> <both|oneway> <origin> <confirmed>",
    "SLICE": "SLICE <extent> <resolution> <max_steps> <timeout_s> <initial_perturbation> <direction_label>"
  },
  "confirmation_tokens": {
    "false": [
      "unconfirmed",
      "false",
      "confirmed=false"
    ],
    "rule": "Unknown confirmation spellings are rejected at the parser boundary and are never silently converted to false.",
    "true": [
      "confirmed",
      "true",
      "confirmed=true"
    ]
  },
  "ok": true,
  "required": [
    "FAMILY <catalog_problem_family>",
    "GEOMETRY <catalog_geometry>",
    "DIMENSION <integer>",
    "STATE <key> <state> <value|?> <unit> <min> <max> <origin> <confirmed> [layer]"
  ],
  "schema": "PartnerProf-RealityMatrixText/1.0",
  "transport": "UTF-8 line-oriented text; comments begin with #; one command per line",
  "unsupported": [
    "DIMACS-CNF",
    "NPZ"
  ],
  "workflow": {
    "prepare": "/api/v3/matrix-tasks/prepare",
    "rule": "Use the returned prepared_task_id; do not resend or alter matrix text when running.",
    "run": "/api/v3/tasks/start"
  }
}
