{
  "project": "EvO_PartnerProf",
  "mode": "SCIENTIFIC_CML_GATEWAY",
  "role": "scientific_hybrid_compute",
  "default_port": 19130,
  "dimension_policy": {
    "mode": "range",
    "fixed_dimension": 64,
    "min": 64,
    "max": 65539,
    "default": 64
  },
  "topology_policy": {
    "minimum_reality_dimensions": 4,
    "field_is_unbounded": true,
    "compute_frame_max_dimension": 65539,
    "numerical_transport_min_dimension": 64,
    "numerical_transport_max_dimension": 65536,
    "note": "Topology is not truncated by the compute frame. The current dense CML_A transport remains 64..65536 until its operator is converted to a lazy or sparse representation."
  },
  "demo_limits": {
    "max_dimension": 65539,
    "max_steps": 100000,
    "max_runtime_s": 600,
    "max_variables": 24,
    "max_constraints": 48,
    "max_mesh_points": 100000,
    "max_request_bytes": 1048576,
    "max_concurrent_runs": 24,
    "max_auto_clones": 14,
    "cml_q_gain_max": 0.25
  },
  "clone_policy": {
    "mode": "auto",
    "max_auto_clones": 14,
    "audit_fixed_options": [4, 9, 14],
    "note": "AUTO chooses workers from available capacity. For a deterministic audit, set an explicit fixed count of 4, 9, or 14 workers plus the shared pattern/leader."
  },
  "architecture_contract": {
    "public_compute_entry": "core.CML",
    "public_CML_A_forbidden": true,
    "json_beyond_cml_boundary": false,
    "numeric_transport": [
      "numpy",
      "scipy",
      "torch",
      "python_numeric_vector"
    ],
    "matrix_role": "reality_field",
    "matrix_optimization": false,
    "matrix_approximation": false,
    "sole_evolutionary_operator": "CML_A",
    "zero_state_valid": true,
    "zero_state_semantic": "no_realization_in_field",
    "singularity_public_result": false,
    "continuation_guard": "apply_only_if_declared_goal_reached_or_at_least_one_admissible_follow_up_exists_otherwise_noop",
    "determinism_origin": "returned_admissible_state",
    "operator_semantic": "evolutionary_operator_of_admissible_states_over_current_reality",
    "rules_mutated": false,
    "goal_terminal_exception": true,
    "declared_goal_is_rule_change": false
  },
  "task_types": [
    "QUANTUM_SIMULATION",
    "MATERIAL_DISCOVERY",
    "SEQUENCE_ANALYSIS",
    "PHASE_TRANSITION_MAP",
    "PARAMETER_INFERENCE",
    "COSMOLOGY_FIT",
    "NUCLEAR_REACTION_MODEL",
    "FUSION_PLASMA_MODEL",
    "QUANTUM_TUNNELING",
    "QUANTUM_MATERIAL_MODEL",
    "METROLOGY_CALIBRATION",
    "CHESS_LOCAL_REALITY",
    "CUSTOM_SCIENTIFIC_MODEL"
  ]
}
