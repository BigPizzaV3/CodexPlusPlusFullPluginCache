{
  "mcpServers": {
    "bits-and-bolts": {
      "type": "http",
      "url": "https://mcp-extensions-examples.vercel.app/bits-and-bolts/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "authorizationUrl": "https://mcp-extensions-examples.vercel.app/bits-and-bolts/oauth/authorize",
            "tokenUrl": "https://mcp-extensions-examples.vercel.app/bits-and-bolts/oauth/token",
            "registrationUrl": "https://mcp-extensions-examples.vercel.app/bits-and-bolts/oauth/register",
            "authorizationServerBase": "https://mcp-extensions-examples.vercel.app",
            "resource": "https://mcp-extensions-examples.vercel.app/bits-and-bolts/mcp",
            "defaultScopes": [
              "cad"
            ]
          }
        }
      }
    }
  }
}
