{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tokenx:schema:delegation-plan:v2",
  "title": "TokenX delegation plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "source", "decisionId", "parentRoute", "assignments"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "source": { "const": "classifier" },
    "decisionId": { "type": "string", "pattern": "^tx_[a-f0-9]{24}$" },
    "parentRoute": { "enum": ["economy", "standard", "deep"] },
    "assignments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": { "$ref": "urn:tokenx:schema:agent-assignment:v2" }
    }
  }
}
