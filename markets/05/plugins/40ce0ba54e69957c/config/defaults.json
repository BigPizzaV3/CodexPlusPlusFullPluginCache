{
  "schemaVersion": 3,
  "provider": "codex",
  "routes": {
    "economy": {
      "model": "gpt-5.6-luna",
      "reasoningEffort": "low"
    },
    "standard": {
      "model": "gpt-5.6-terra",
      "reasoningEffort": "medium"
    },
    "deep": {
      "model": "gpt-5.6-sol",
      "reasoningEffort": "xhigh"
    }
  },
  "routing": {
    "structuralScoreEconomyMax": 24,
    "structuralScoreStandardMax": 77,
    "escalationReasoningEffort": "ultra",
    "decisionMaxAgeMs": 3600000,
    "maxAutomaticAgents": 4,
    "denyNestedAutomaticDelegation": true,
    "taskProfiles": {
      "read": { "route": "economy", "reasoningEffort": "low" },
      "file_edit": { "route": "economy", "reasoningEffort": "medium" },
      "implementation": { "route": "standard", "reasoningEffort": "medium" },
      "complex_implementation": { "route": "standard", "reasoningEffort": "high" },
      "analysis": { "route": "deep", "reasoningEffort": "high" },
      "architecture": { "route": "deep", "reasoningEffort": "xhigh" },
      "retry": { "route": "deep", "reasoningEffort": "max" }
    },
    "dynamicAgents": {
      "enabled": true,
      "maxAssignmentsPerDecision": 4,
      "profiles": {
        "repoReader": "economy",
        "repoReviewer": "standard",
        "testRunner": "economy",
        "fileEditor": "economy",
        "implementer": "standard"
      }
    },
    "smartClassifier": {
      "enabled": true,
      "model": "gpt-5.6-luna",
      "reasoningEffort": "low",
      "timeoutMs": 20000
    }
  },
  "telemetry": {
    "enabled": false
  }
}
