{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tokenx:schema:config:v3",
  "title": "TokenX configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "provider",
    "routes",
    "routing",
    "telemetry"
  ],
  "properties": {
    "schemaVersion": {
      "const": 3
    },
    "provider": {
      "const": "codex"
    },
    "routes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "economy",
        "standard",
        "deep"
      ],
      "properties": {
        "economy": {
          "$ref": "#/$defs/route"
        },
        "standard": {
          "$ref": "#/$defs/route"
        },
        "deep": {
          "$ref": "#/$defs/route"
        }
      }
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "structuralScoreEconomyMax",
        "structuralScoreStandardMax",
        "escalationReasoningEffort",
        "decisionMaxAgeMs",
        "maxAutomaticAgents",
        "denyNestedAutomaticDelegation",
        "taskProfiles",
        "dynamicAgents",
        "smartClassifier"
      ],
      "properties": {
        "structuralScoreEconomyMax": {
          "type": "integer",
          "minimum": 0
        },
        "structuralScoreStandardMax": {
          "type": "integer",
          "minimum": 1
        },
        "escalationReasoningEffort": {
          "enum": [
            "low",
            "medium",
            "high",
            "xhigh",
            "max",
            "ultra"
          ]
        },
        "decisionMaxAgeMs": {
          "type": "integer",
          "minimum": 1
        },
        "maxAutomaticAgents": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "denyNestedAutomaticDelegation": {
          "const": true
        },
        "taskProfiles": {
          "type": "object",
          "additionalProperties": false,
          "required": ["read", "file_edit", "implementation", "complex_implementation", "analysis", "architecture", "retry"],
          "properties": {
            "read": { "$ref": "#/$defs/taskProfile" },
            "file_edit": { "$ref": "#/$defs/taskProfile" },
            "implementation": { "$ref": "#/$defs/taskProfile" },
            "complex_implementation": { "$ref": "#/$defs/taskProfile" },
            "analysis": { "$ref": "#/$defs/taskProfile" },
            "architecture": { "$ref": "#/$defs/taskProfile" },
            "retry": { "$ref": "#/$defs/taskProfile" }
          }
        },
        "dynamicAgents": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "maxAssignmentsPerDecision", "profiles"],
          "properties": {
            "enabled": { "type": "boolean" },
            "maxAssignmentsPerDecision": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4
            },
            "profiles": {
              "type": "object",
              "additionalProperties": false,
              "required": ["repoReader", "repoReviewer", "testRunner", "fileEditor", "implementer"],
              "properties": {
                "repoReader": { "enum": ["economy"] },
                "repoReviewer": { "enum": ["economy", "standard", "deep"] },
                "testRunner": { "enum": ["economy"] },
                "fileEditor": { "enum": ["economy"] },
                "implementer": { "enum": ["economy", "standard"] }
              }
            }
          }
        },
        "smartClassifier": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "model",
            "reasoningEffort",
            "timeoutMs"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "model": {
              "enum": [
                "gpt-5.6-luna",
                "gpt-5.6-terra",
                "gpt-5.6-sol"
              ]
            },
            "reasoningEffort": {
              "enum": [
                "low",
                "medium",
                "high",
                "xhigh",
                "max",
                "ultra"
              ]
            },
            "timeoutMs": {
              "type": "integer",
              "minimum": 1000,
              "maximum": 25000
            }
          }
        }
      }
    },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "const": false
        }
      }
    }
  },
  "$defs": {
    "taskProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route", "reasoningEffort"],
      "properties": {
        "route": { "enum": ["economy", "standard", "deep"] },
        "reasoningEffort": { "enum": ["low", "medium", "high", "xhigh", "max", "ultra"] }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "reasoningEffort"
      ],
      "properties": {
        "model": {
          "enum": [
            "gpt-5.6-luna",
            "gpt-5.6-terra",
            "gpt-5.6-sol"
          ]
        },
        "reasoningEffort": {
          "enum": [
            "low",
            "medium",
            "high",
            "xhigh",
            "max",
            "ultra"
          ]
        }
      }
    }
  }
}
