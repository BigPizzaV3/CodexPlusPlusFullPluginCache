{
  "description": "Cost-aware native Codex agent routing.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/session-start.mjs\"",
            "commandWindows": "node \"%PLUGIN_ROOT%\\scripts\\session-start.mjs\"",
            "timeout": 5,
            "additionalContextLimit": 512
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/user-prompt-submit.mjs\"",
            "commandWindows": "node \"%PLUGIN_ROOT%\\scripts\\user-prompt-submit.mjs\"",
            "timeout": 30,
            "additionalContextLimit": 512
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(?:Agent|spawn_agent)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/agent-guard.mjs\"",
            "commandWindows": "node \"%PLUGIN_ROOT%\\scripts\\agent-guard.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "other",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/session-end.mjs\"",
            "commandWindows": "node \"%PLUGIN_ROOT%\\scripts\\session-end.mjs\"",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
