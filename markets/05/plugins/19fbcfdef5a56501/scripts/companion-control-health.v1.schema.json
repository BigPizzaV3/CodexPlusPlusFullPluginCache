{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "chatgpt-meetings.companion-control-health.v1",
  "description": "On-demand local control health check. This surface carries no recording commands or recording content.",
  "x-version": 1,
  "x-max-bytes": 2048,
  "x-max-ttl-millis": 5000,
  "$defs": {
    "HealthSupport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "ownerEpoch", "pid"],
      "properties": {
        "version": {"type": "integer", "const": 1},
        "ownerEpoch": {"type": "string", "pattern": "^[A-Za-z0-9_-]{8,128}$"},
        "pid": {"type": "integer", "minimum": 1, "maximum": 4294967295}
      }
    },
    "HealthRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "ownerEpoch", "requestId", "deadlineUnixMillis"],
      "properties": {
        "version": {"type": "integer", "const": 1},
        "ownerEpoch": {"type": "string", "pattern": "^[A-Za-z0-9_-]{8,128}$"},
        "requestId": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
        "deadlineUnixMillis": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}
      }
    },
    "HealthResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "ownerEpoch", "requestId", "endpoint"],
      "properties": {
        "version": {"type": "integer", "const": 1},
        "ownerEpoch": {"type": "string", "pattern": "^[A-Za-z0-9_-]{8,128}$"},
        "requestId": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
        "endpoint": {"type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^[^\\u0000\\r\\n]+$"}
      }
    }
  }
}
