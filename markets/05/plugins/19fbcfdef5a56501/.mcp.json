{
  "mcpServers": {
    "chatgpt-meetings": {
      "title": "Meetings (Beta)",
      "description": "Local runtime for the Meetings UI, recording controls, and authenticated meeting-data access.",
      "command": "./scripts/launch_meetings_mcp",
      "args": [
        "./scripts/start_bundled_meetings_mcp.mjs",
        "--profile",
        "production"
      ],
      "cwd": ".",
      "startup_timeout_sec": 35,
      "env_vars": [
        "CHATGPT_MEETINGS_APPLICATIONS_ROOTS",
        "CHATGPT_MEETINGS_NODE_PATH",
        "CHATGPT_MEETINGS_NATIVE_ALLOW_UNSIGNED",
        "CODEX_BROWSER_USE_NODE_PATH",
        "CODEX_CA_CERTIFICATE",
        "CODEX_CLI_PATH",
        "CODEX_ELECTRON_RESOURCES_PATH",
        "CODEX_HOME",
        "CODEX_MCP_NODE_PATH",
        "SSL_CERT_FILE",
        "XDG_CACHE_HOME"
      ]
    }
  }
}
