"storage_recovery.cache_message" = "Meetings‌ಗೆ ತನ್ನ ಸ್ಥಳೀಯ ಕ್ಯಾಶ್ ತೆರೆಯಲು ಸಾಧ್ಯವಾಗುತ್ತಿಲ್ಲ. ಮರುಹೊಂದಿಸುವುದರಿಂದ ಈ ಕಂಪ್ಯೂಟರ್‌ನ ಸಭೆಗಳ ಕ್ಯಾಶ್ ತೆರವುಗೊಳ್ಳುತ್ತದೆ ಮತ್ತು ಸ್ಥಳೀಯ ಸೆಟ್ಟಿಂಗ್‌ಗಳು ಡೀಫಾಲ್ಟ್ ಮೌಲ್ಯಗಳಿಗೆ ಮರಳುತ್ತವೆ. ನಿಮ್ಮ ಖಾತೆಯಲ್ಲಿ ಉಳಿಸಿರುವ ಸಭೆಗಳು ಲಭ್ಯವಾಗಿಯೇ ಇರುತ್ತವೆ. Meetings ಮುಚ್ಚುತ್ತದೆ. ನೀವು ಮುಂದಿನ ಬಾರಿ Meetings ಪ್ರಾರಂಭಿಸಿದಾಗ ಮರುಹೊಂದಿಕೆ ಪೂರ್ಣಗೊಳ್ಳುತ್ತದೆ.";
"storage_recovery.cache_reset" = "ಕ್ಯಾಶ್ ಮರುಹೊಂದಿಸಿ ಮತ್ತು ಮುಚ್ಚಿ";
"storage_recovery.cache_title" = "Meetings‌ನ ಸ್ಥಳೀಯ ಕ್ಯಾಶ್ ಅನ್ನು ಮರುಹೊಂದಿಸುವುದೇ?";
"storage_recovery.failed" = "ಮರುಹೊಂದಿಕೆಗೆ ಸಿದ್ಧಪಡಿಸಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ. ನಿಮ್ಮ ಅಸ್ತಿತ್ವದಲ್ಲಿರುವ ಸ್ಥಳೀಯ ಡೇಟಾವನ್ನು ಅಳಿಸಲಾಗಿಲ್ಲ. ಪ್ರಯತ್ನಿಸುತ್ತಿರಿ, ನಂತರ ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಲು Meetings ಅನ್ನು ಪುನಃ ತೆರೆಯಿರಿ.";
"storage_recovery.incomplete" = "ಸ್ಥಳೀಯ ಮರುಹೊಂದಿಕೆಯನ್ನು ಪೂರ್ಣಗೊಳಿಸಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ. ಮರುಹೊಂದಿಕೆ ಪೂರ್ಣಗೊಳ್ಳುವವರೆಗೆ ರೆಕಾರ್ಡಿಂಗ್ ಲಭ್ಯವಿರುವುದಿಲ್ಲ. ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಲು Meetings ಅನ್ನು ಪುನಃ ತೆರೆಯಿರಿ.";
"storage_recovery.interrupted_audio_message" = "ಹಿಂದಿನ ಮರುಹೊಂದಿಕೆ ಪೂರ್ಣಗೊಂಡಿಲ್ಲ ಮತ್ತು ಸ್ಥಳೀಯ ಫೈಲ್‌ಗಳು ಬದಲಾಗಿವೆ. ಕೆಲವು ಸ್ಥಳೀಯ ಡೇಟಾ ಈಗಾಗಲೇ ಅಳಿಸಲ್ಪಟ್ಟಿರಬಹುದು. ಮತ್ತೆ ಮರುಹೊಂದಿಸಿದರೆ ಈ ಕಂಪ್ಯೂಟರ್‌ನ ಕ್ಯಾಶ್‌ನಲ್ಲಿ ಉಳಿದಿರುವ ಸಭೆಗಳು ಮತ್ತು ರೆಕಾರ್ಡಿಂಗ್‌ಗಳು ಶಾಶ್ವತವಾಗಿ ಅಳಿಸಲ್ಪಡುತ್ತವೆ. ಇನ್ನೂ ಅಪ್‌ಲೋಡ್ ಆಗದ ರೆಕಾರ್ಡಿಂಗ್‌ಗಳೂ ಇದರಲ್ಲಿ ಸೇರಿವೆ. ಸ್ಥಳೀಯ ಸೆಟ್ಟಿಂಗ್‌ಗಳು ಡೀಫಾಲ್ಟ್ ಮೌಲ್ಯಗಳಿಗೆ ಮರಳುತ್ತವೆ. ನಿಮ್ಮ ಖಾತೆಯಲ್ಲಿ ಉಳಿಸಿರುವ ಸಭೆಗಳು ಲಭ್ಯವಾಗಿಯೇ ಇರುತ್ತವೆ. Meetings ಮುಚ್ಚುತ್ತದೆ ಮತ್ತು ಮುಂದಿನ ಬಾರಿ ಪ್ರಾರಂಭವಾದಾಗ ಮರುಹೊಂದಿಕೆಯನ್ನು ಮತ್ತೆ ಪ್ರಯತ್ನಿಸುತ್ತದೆ.";
"storage_recovery.interrupted_cache_message" = "ಹಿಂದಿನ ಮರುಹೊಂದಿಕೆ ಪೂರ್ಣಗೊಂಡಿಲ್ಲ ಮತ್ತು ಸ್ಥಳೀಯ ಫೈಲ್‌ಗಳು ಬದಲಾಗಿವೆ. ಕೆಲವು ಸ್ಥಳೀಯ ಡೇಟಾ ಈಗಾಗಲೇ ಅಳಿಸಲ್ಪಟ್ಟಿರಬಹುದು. ಮತ್ತೆ ಮರುಹೊಂದಿಸಿದರೆ ಈ ಕಂಪ್ಯೂಟರ್‌ನ ಸಭೆಗಳ ಕ್ಯಾಶ್‌ನಲ್ಲಿ ಉಳಿದಿರುವ ಡೇಟಾ ತೆರವುಗೊಳ್ಳುತ್ತದೆ ಮತ್ತು ಸ್ಥಳೀಯ ಸೆಟ್ಟಿಂಗ್‌ಗಳು ಡೀಫಾಲ್ಟ್ ಮೌಲ್ಯಗಳಿಗೆ ಮರಳುತ್ತವೆ. ನಿಮ್ಮ ಖಾತೆಯಲ್ಲಿ ಉಳಿಸಿರುವ ಸಭೆಗಳು ಲಭ್ಯವಾಗಿಯೇ ಇರುತ್ತವೆ. Meetings ಮುಚ್ಚುತ್ತದೆ ಮತ್ತು ಮುಂದಿನ ಬಾರಿ ಪ್ರಾರಂಭವಾದಾಗ ಮರುಹೊಂದಿಕೆಯನ್ನು ಮತ್ತೆ ಪ್ರಯತ್ನಿಸುತ್ತದೆ.";
