"storage_recovery.cache_message" = "Meetings அதன் உள்ளூர் தற்காலிகச் சேமிப்பைத் திறக்க முடியவில்லை. மீட்டமைத்தால் இந்தக் கணினியின் கூட்டங்களுக்கான தற்காலிகச் சேமிப்பு அழிக்கப்படும்; உள்ளூர் அமைப்புகள் இயல்புநிலை மதிப்புகளுக்குத் திரும்பும். உங்கள் கணக்கில் சேமிக்கப்பட்ட கூட்டங்கள் தொடர்ந்து கிடைக்கும். Meetings மூடப்படும். அடுத்த முறை Meetings-ஐத் தொடங்கும்போது மீட்டமைப்பு நிறைவடையும்.";
"storage_recovery.cache_reset" = "தற்காலிகச் சேமிப்பை மீட்டமைத்து மூடவும்";
"storage_recovery.cache_title" = "Meetings உள்ளூர் தற்காலிகச் சேமிப்பை மீட்டமைக்கவா?";
"storage_recovery.failed" = "மீட்டமைப்பைத் தயார்செய்ய முடியவில்லை. ஏற்கெனவே உள்ள உங்கள் உள்ளூர் தரவு நீக்கப்படவில்லை. தொடர்ந்து முயற்சிக்கவும், பிறகு மீண்டும் முயற்சிக்க Meetings-ஐ மீண்டும் திறக்கவும்.";
"storage_recovery.incomplete" = "உள்ளூர் மீட்டமைப்பை முடிக்க முடியவில்லை. மீட்டமைப்பு முடியும் வரை பதிவு செய்ய முடியாது. மீண்டும் முயற்சிக்க Meetings-ஐ மீண்டும் திறக்கவும்.";
"storage_recovery.interrupted_audio_message" = "முந்தைய மீட்டமைப்பு முடிவடையவில்லை; உள்ளூர் கோப்புகளும் மாறியுள்ளன. சில உள்ளூர் தரவு ஏற்கெனவே நீக்கப்பட்டிருக்கலாம். மீண்டும் மீட்டமைத்தால், இந்தக் கணினியில் தற்காலிகச் சேமிப்பில் மீதமுள்ள கூட்டங்களும் பதிவுகளும் நிரந்தரமாக நீக்கப்படும். இன்னும் பதிவேற்றப்படாத பதிவுகளும் இதில் அடங்கும். உள்ளூர் அமைப்புகள் இயல்புநிலை மதிப்புகளுக்குத் திரும்பும். உங்கள் கணக்கில் சேமிக்கப்பட்ட கூட்டங்கள் தொடர்ந்து கிடைக்கும். Meetings மூடப்படும்; அடுத்த முறை தொடங்கும்போது மீட்டமைப்பை மீண்டும் முயற்சிக்கும்.";
"storage_recovery.interrupted_cache_message" = "முந்தைய மீட்டமைப்பு முடிவடையவில்லை; உள்ளூர் கோப்புகளும் மாறியுள்ளன. சில உள்ளூர் தரவு ஏற்கெனவே நீக்கப்பட்டிருக்கலாம். மீண்டும் மீட்டமைத்தால், இந்தக் கணினியில் மீதமுள்ள கூட்டங்களுக்கான தற்காலிகச் சேமிப்பு அழிக்கப்படும்; உள்ளூர் அமைப்புகள் இயல்புநிலை மதிப்புகளுக்குத் திரும்பும். உங்கள் கணக்கில் சேமிக்கப்பட்ட கூட்டங்கள் தொடர்ந்து கிடைக்கும். Meetings மூடப்படும்; அடுத்த முறை தொடங்கும்போது மீட்டமைப்பை மீண்டும் முயற்சிக்கும்.";
