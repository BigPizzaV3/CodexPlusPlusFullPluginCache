"storage_recovery.incomplete" = "লোকাল রিসেট সম্পূর্ণ করা যায়নি। রিসেট সম্পূর্ণ না হওয়া পর্যন্ত রেকর্ড করা যাবে না। আবার চেষ্টা করতে Meetings পুনরায় খুলুন।";
"storage_recovery.interrupted_audio_message" = "আগের একটি রিসেট শেষ হয়নি এবং লোকাল ফাইলগুলো পরিবর্তিত হয়েছে। কিছু লোকাল ডেটা ইতিমধ্যে মুছে গিয়ে থাকতে পারে। আবার রিসেট করলে এই কম্পিউটারের ক্যাশে অবশিষ্ট থাকা মিটিং ও রেকর্ডিং স্থায়ীভাবে মুছে যাবে, এমনকি যেসব রেকর্ডিং এখনো আপলোড হয়নি সেগুলোও। লোকাল সেটিংস ডিফল্ট অবস্থায় ফিরে যাবে। আপনার অ্যাকাউন্টে সংরক্ষিত মিটিংগুলো পাওয়া যাবে। Meetings বন্ধ হবে এবং পরের বার চালু হলে আবার রিসেট করার চেষ্টা করবে।";
