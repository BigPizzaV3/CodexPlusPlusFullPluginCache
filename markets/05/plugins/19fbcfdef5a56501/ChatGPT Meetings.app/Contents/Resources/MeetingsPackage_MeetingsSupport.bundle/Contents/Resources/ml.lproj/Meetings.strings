"storage_recovery.cache_message" = "Meetings-ന് അതിന്റെ ലോക്കൽ കാഷെ തുറക്കാൻ കഴിയുന്നില്ല. പുനഃസജ്ജമാക്കുന്നത് ഈ കമ്പ്യൂട്ടറിലെ മീറ്റിംഗ് കാഷെ മായ്‌ക്കുകയും ലോക്കൽ ക്രമീകരണങ്ങൾ ഡിഫോൾട്ട് മൂല്യങ്ങളിലേക്ക് തിരികെ കൊണ്ടുവരുകയും ചെയ്യും. നിങ്ങളുടെ അക്കൗണ്ടിൽ സംരക്ഷിച്ച മീറ്റിംഗുകൾ തുടർന്നും ലഭ്യമാകും. Meetings അടയ്ക്കും. അടുത്ത തവണ Meetings തുറക്കുമ്പോൾ പുനഃസജ്ജമാക്കൽ പൂർത്തിയാകും.";
"storage_recovery.cache_reset" = "കാഷെ പുനഃസജ്ജമാക്കി അടയ്ക്കുക";
"storage_recovery.cache_title" = "Meetings-ന്റെ ലോക്കൽ കാഷെ പുനഃസജ്ജമാക്കണോ?";
"storage_recovery.failed" = "പുനഃസജ്ജമാക്കലിനുള്ള തയ്യാറെടുപ്പ് പൂർത്തിയാക്കാനായില്ല. നിലവിലുള്ള ലോക്കൽ ഡാറ്റ ഇല്ലാതാക്കിയിട്ടില്ല. ശ്രമം തുടരുക, തുടർന്ന് വീണ്ടും ശ്രമിക്കാൻ Meetings വീണ്ടും തുറക്കുക.";
"storage_recovery.incomplete" = "ലോക്കൽ പുനഃസജ്ജമാക്കൽ പൂർത്തിയാക്കാനായില്ല. പുനഃസജ്ജമാക്കൽ പൂർത്തിയാകുന്നതുവരെ റെക്കോർഡിംഗ് ലഭ്യമല്ല. വീണ്ടും ശ്രമിക്കാൻ Meetings വീണ്ടും തുറക്കുക.";
"storage_recovery.interrupted_audio_message" = "മുമ്പത്തെ പുനഃസജ്ജമാക്കൽ പൂർത്തിയായില്ല; ലോക്കൽ ഫയലുകൾ മാറിയിട്ടുണ്ട്. ചില ലോക്കൽ ഡാറ്റ ഇതിനകം ഇല്ലാതാക്കിയിട്ടുണ്ടാകാം. വീണ്ടും പുനഃസജ്ജമാക്കുമ്പോൾ ഈ കമ്പ്യൂട്ടറിൽ കാഷെ ചെയ്തിട്ടുള്ള ശേഷിക്കുന്ന മീറ്റിംഗുകളും റെക്കോർഡിംഗുകളും ശാശ്വതമായി ഇല്ലാതാകും. അപ്‌ലോഡ് ചെയ്യാത്ത റെക്കോർഡിംഗുകളും ഇതിൽ ഉൾപ്പെടും. ലോക്കൽ ക്രമീകരണങ്ങൾ ഡിഫോൾട്ട് മൂല്യങ്ങളിലേക്ക് മടങ്ങും. നിങ്ങളുടെ അക്കൗണ്ടിൽ സംരക്ഷിച്ച മീറ്റിംഗുകൾ തുടർന്നും ലഭ്യമാകും. Meetings അടയ്ക്കും; അടുത്ത തവണ തുറക്കുമ്പോൾ പുനഃസജ്ജമാക്കാൻ വീണ്ടും ശ്രമിക്കും.";
