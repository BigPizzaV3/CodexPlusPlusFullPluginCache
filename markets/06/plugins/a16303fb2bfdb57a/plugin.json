        "privacyPolicyURL": "https://juliens-managerial-accounting-tutor.frederico-smith.chatgpt.site/privacy.html",
        "shortDescription": "Managerial accounting help",
        "supportURL": "https://juliens-managerial-accounting-tutor.frederico-smith.chatgpt.site/support.html",
        "termsOfServiceURL": "https://juliens-managerial-accounting-tutor.frederico-smith.chatgpt.site/terms.html",
        "websiteURL": "https://juliens-managerial-accounting-tutor.frederico-smith.chatgpt.site"
      }
    }
  },
  "name": "juliens-managerial-accounting-tutor",
  "version": "1.0.0"
}
