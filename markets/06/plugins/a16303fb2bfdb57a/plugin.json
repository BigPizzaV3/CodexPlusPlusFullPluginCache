{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "author": {
    "name": "Rico"
  },
  "description": "A study tutor for managerial accounting concepts, practice, quizzes, study guides, and feedback.",
  "extensions": {
    "com.openai": {
      "interface": {
        "capabilities": [
          "Interactive"
        ],
        "category": "Education & Research",
        "composerIcon": "./.codex-plugin/assets/composer-icon.png",
        "defaultPrompt": [
          "Teach me a managerial accounting concept."
        ],
        "developerName": "Frederico Amilio Smith",
        "displayName": "Julien's Accounting Tutor",
        "logo": "./.codex-plugin/assets/logo.png",
