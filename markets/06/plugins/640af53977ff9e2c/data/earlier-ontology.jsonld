      "targetModel": "urn:business-engineer:model:0001",
      "mappingKind": "canonicalization",
      "definition": "Retains the source mechanism under a stable identity; the current definition and boundaries govern use."
    },
    {
      "@id": "urn:business-engineer:mapping:base:2",
