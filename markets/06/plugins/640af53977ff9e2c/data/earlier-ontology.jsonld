    {
      "@id": "urn:business-engineer:concept:residual-value",
      "@type": "Concept",
      "id": "residual-value",
      "name": "Residual Value",
      "definition": "Value expected to persist after an explicit decay or substitution scenario, distinct from an unexplained valuation remainder."
