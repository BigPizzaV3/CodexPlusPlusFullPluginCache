#!/bin/sh
# Starts the server binary built for this OS and CPU.
case "$(uname -s)" in
  Darwin) os=darwin ;;
  Linux) os=linux ;;
  *) echo "pen.dev doesn't support $(uname -s)." >&2; exit 1 ;;
esac
case "$(uname -m)" in
  arm64 | aarch64) arch=arm64 ;;
  x86_64 | amd64) arch=x64 ;;
  *) echo "pen.dev doesn't support $(uname -m)." >&2; exit 1 ;;
esac

exec "$(dirname "$0")/pen-mcp-$os-$arch" "$@"
