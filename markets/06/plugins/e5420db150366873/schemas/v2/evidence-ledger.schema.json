{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence Ledger",
  "type": "object",
  "required": [
    "research_cutoff",
    "evidence"
  ],
  "properties": {
    "research_cutoff": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "evidence_id",
          "source_tier",
          "source_type",
          "title",
          "publisher",
          "source_date",
          "retrieved_at",
          "locator",
          "classification"
        ],
        "properties": {
          "evidence_id": {
            "type": "string",
            "pattern": "^EVID-[0-9]{4,}$"
          },
          "source_tier": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "source_type": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "publisher": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string"
          },
          "source_date": {
            "type": "string",
            "minLength": 1
          },
          "retrieved_at": {
            "type": "string",
            "minLength": 1
          },
          "period_covered": {
            "type": "string"
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "classification": {
            "enum": [
              "reported_fact",
              "management_claim",
              "external_estimate",
              "analyst_calculation",
              "analyst_judgment"
            ]
          },
          "lineage_id": {
            "type": "string",
            "minLength": 1
          },
          "content_hash": {
            "type": "string"
          },
          "access_status": {
            "enum": [
              "accessible",
              "partial",
              "unavailable"
            ]
          }
        }
      }
    }
  },
  "additionalProperties": true
}
