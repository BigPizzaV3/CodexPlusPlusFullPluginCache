{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Research Audit Result",
  "type": "object",
  "required": [
    "status",
    "passes",
    "failures",
    "warnings"
  ],
  "properties": {
    "status": {
      "enum": [
        "PASS",
        "RESEARCH_INCOMPLETE"
      ]
    },
    "passes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "failures": {
      "type": "array"
    },
    "warnings": {
      "type": "array"
    }
  },
  "additionalProperties": true
}
