{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Forecast Error Attribution",
  "type": "object",
  "required": [
    "forecast_date",
    "actual_period",
    "metrics"
  ],
  "properties": {
    "forecast_date": {
      "type": "string",
      "minLength": 1
    },
    "actual_period": {
      "type": "string",
      "minLength": 1
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "metric",
          "forecast",
          "actual",
          "error",
          "attribution"
        ],
        "properties": {
          "metric": {
            "type": "string",
            "minLength": 1
          },
          "forecast": {
            "type": "number"
          },
          "actual": {
            "type": "number"
          },
          "error": {
            "type": "number"
          },
          "attribution": {
            "type": "object",
            "properties": {
              "volume": {
                "type": "number"
              },
              "price": {
                "type": "number"
              },
              "mix": {
                "type": "number"
              },
              "fx": {
                "type": "number"
              },
              "margin": {
                "type": "number"
              },
              "working_capital": {
                "type": "number"
              },
              "capex": {
                "type": "number"
              },
              "tax": {
                "type": "number"
              },
              "share_count": {
                "type": "number"
              },
              "other": {
                "type": "number"
              }
            }
          }
        }
      }
    }
  },
  "additionalProperties": true
}
