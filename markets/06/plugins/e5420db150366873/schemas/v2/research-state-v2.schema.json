{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Research State V2",
  "type": "object",
  "required": [
    "company",
    "research_cutoff",
    "valuation_date",
    "workflow",
    "modules",
    "dependencies",
    "completion_status"
  ],
  "properties": {
    "company": {
      "type": "string",
      "minLength": 1
    },
    "research_cutoff": {
      "type": "string",
      "minLength": 1
    },
    "valuation_date": {
      "type": "string",
      "minLength": 1
    },
    "workflow": {
      "type": "string",
      "minLength": 1
    },
    "modules": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "enum": [
              "not_started",
              "in_progress",
              "blocked",
              "pass",
              "fail",
              "not_applicable"
            ]
          },
          "reason": {
            "type": "string"
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "gate_id",
          "requires",
          "status"
        ],
        "properties": {
          "gate_id": {
            "type": "string",
            "minLength": 1
          },
          "requires": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "status": {
            "enum": [
              "open",
              "pass",
              "blocked",
              "fail"
            ]
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "completion_status": {
      "enum": [
        "IN_PROGRESS",
        "RESEARCH_INCOMPLETE",
        "PASS"
      ]
    },
    "open_questions": {
      "type": "array"
    },
    "stale_evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": true
}
