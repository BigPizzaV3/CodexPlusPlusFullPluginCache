{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Management Prediction and Credibility Scorecard",
  "type": "object",
  "required": [
    "company",
    "predictions"
  ],
  "properties": {
    "company": {
      "type": "string",
      "minLength": 1
    },
    "predictions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "prediction_id",
          "statement_date",
          "statement",
          "target",
          "deadline",
          "actual",
          "outcome",
          "evidence_ids"
        ],
        "properties": {
          "prediction_id": {
            "type": "string",
            "minLength": 1
          },
          "statement_date": {
            "type": "string",
            "minLength": 1
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "deadline": {
            "type": "string",
            "minLength": 1
          },
          "actual": {
            "type": "string",
            "minLength": 1
          },
          "outcome": {
            "enum": [
              "met",
              "partially_met",
              "missed",
              "withdrawn",
              "not_yet_due",
              "not_verifiable"
            ]
          },
          "magnitude_of_miss": {
            "type": [
              "number",
              "null"
            ]
          },
          "explanation": {
            "type": "string"
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  },
  "additionalProperties": true
}
