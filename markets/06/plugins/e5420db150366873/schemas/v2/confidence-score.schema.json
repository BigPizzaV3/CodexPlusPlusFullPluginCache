{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Research Confidence Score",
  "type": "object",
  "required": [
    "components",
    "weighted_score",
    "deductions",
    "gate_cap_applied"
  ],
  "properties": {
    "components": {
      "type": "object"
    },
    "weighted_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "deductions": {
      "type": "array"
    },
    "gate_cap_applied": {
      "type": "boolean"
    }
  },
  "additionalProperties": true
}
