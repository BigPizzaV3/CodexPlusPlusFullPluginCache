{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Definition Register",
  "type": "object",
  "required": [
    "definitions"
  ],
  "properties": {
    "definitions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "metric",
          "entity",
          "definition",
          "period",
          "units",
          "evidence_id"
        ],
        "properties": {
          "metric": {
            "type": "string",
            "minLength": 1
          },
          "entity": {
            "type": "string",
            "minLength": 1
          },
          "definition": {
            "type": "string",
            "minLength": 1
          },
          "period": {
            "type": "string",
            "minLength": 1
          },
          "units": {
            "type": "string",
            "minLength": 1
          },
          "evidence_id": {
            "type": "string",
            "minLength": 1
          },
          "comparable_group": {
            "type": "string"
          },
          "change_flag": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "additionalProperties": true
}
