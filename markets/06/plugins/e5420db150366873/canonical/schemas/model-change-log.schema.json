{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Model Change Log",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "timestamp",
      "field",
      "prior_value",
      "new_value",
      "reason",
      "source_ids",
      "affected_outputs"
    ],
    "properties": {
      "timestamp": {
        "type": "string"
      },
      "field": {
        "type": "string"
      },
      "prior_value": {},
      "new_value": {},
      "reason": {
        "type": "string"
      },
      "source_ids": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "affected_outputs": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "reviewer": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "additionalProperties": false
  }
}
