{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Decision Journal",
  "type": "object",
  "required": [
    "as_of",
    "decision_question",
    "conclusion",
    "expected_path",
    "key_uncertainties",
    "disconfirming_evidence",
    "thesis_breaks",
    "next_update_rules"
  ],
  "properties": {
    "as_of": {
      "type": "string"
    },
    "decision_question": {
      "type": "string"
    },
    "conclusion": {
      "type": "string"
    },
    "expected_path": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "key_uncertainties": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "disconfirming_evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "thesis_breaks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_update_rules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
