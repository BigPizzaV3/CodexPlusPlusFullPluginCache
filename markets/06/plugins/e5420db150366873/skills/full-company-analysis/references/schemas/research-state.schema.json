{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Research State",
  "type": "object",
  "required": [
    "decision_question",
    "scope",
    "sources",
    "assumptions",
    "contrary_evidence",
    "risks",
    "scenarios",
    "valuation",
    "thesis_breaks",
    "completion_gates"
  ],
  "properties": {
    "decision_question": {
      "type": "string"
    },
    "scope": {
      "type": "object"
    },
    "sources": {
      "type": "array"
    },
    "assumptions": {
      "type": "array"
    },
    "contrary_evidence": {
      "type": "array"
    },
    "risks": {
      "type": "array"
    },
    "scenarios": {
      "type": "array"
    },
    "valuation": {
      "type": "object"
    },
    "thesis_breaks": {
      "type": "array"
    },
    "completion_gates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "gate",
          "status",
          "mandatory"
        ],
        "properties": {
          "gate": {
            "type": "string"
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "not-applicable",
              "open"
            ]
          },
          "mandatory": {
            "type": "boolean"
          },
          "evidence": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}
