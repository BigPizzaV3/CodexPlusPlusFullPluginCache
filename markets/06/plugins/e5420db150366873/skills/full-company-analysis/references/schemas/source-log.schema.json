{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Source Log",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "source_id",
      "source_type",
      "title",
      "publisher",
      "publication_date",
      "retrieved_at",
      "location",
      "claim_class"
    ],
    "properties": {
      "source_id": {
        "type": "string"
      },
      "source_type": {
        "enum": [
          "primary",
          "secondary",
          "alternative-data",
          "analyst-generated"
        ]
      },
      "title": {
        "type": "string"
      },
      "publisher": {
        "type": "string"
      },
      "publication_date": {
        "type": [
          "string",
          "null"
        ]
      },
      "period_covered": {
        "type": [
          "string",
          "null"
        ]
      },
      "retrieved_at": {
        "type": "string"
      },
      "url_or_accession": {
        "type": [
          "string",
          "null"
        ]
      },
      "location": {
        "type": "string"
      },
      "version_or_hash": {
        "type": [
          "string",
          "null"
        ]
      },
      "claim_class": {
        "enum": [
          "reported-fact",
          "management-claim",
          "external-estimate",
          "analyst-calculation",
          "analyst-judgment"
        ]
      },
      "notes": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "additionalProperties": false
  }
}
